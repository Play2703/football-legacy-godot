var _pl_lp: float = 0.0
var _pa_ph: float = 0.0
var _pa_inc: float = 0.0
var _pa_env: float = 0.0
var _pa_dec: float = 1.0
var _pa_amp: float = 0.0
var _pa_hb: float = 0.0
var _pa_lp: float = 0.0
var _pb_ph: float = 0.0
var _pb_inc: float = 0.0
var _pb_env: float = 0.0
var _pb_dec: float = 1.0
var _pb_amp: float = 0.0
var _pb_hb: float = 0.0
var _pb_lp: float = 0.0
var _turno: int = 0

var _hb_dec: float = 1.0



var _cb0: PackedFloat32Array = PackedFloat32Array()
var _cb1: PackedFloat32Array = PackedFloat32Array()
var _cb2: PackedFloat32Array = PackedFloat32Array()
var _cb3: PackedFloat32Array = PackedFloat32Array()
var _cp0: int = 0
var _cp1: int = 0
var _cp2: int = 0
var _cp3: int = 0
var _cn0: int = 1
var _cn1: int = 1
var _cn2: int = 1
var _cn3: int = 1
var _cl0: float = 0.0
var _cl1: float = 0.0
var _cl2: float = 0.0
var _cl3: float = 0.0


var _pump: float = 1.0

var _kick_ph: float = 0.0
var _kick_inc: float = 0.0
var _kick_env: float = 0.0
var _kick_dec: float = 1.0
var _snare_env: float = 0.0
var _snare_dec: float = 1.0
var _snare_lp: float = 0.0
var _hat_env: float = 0.0
var _hat_dec: float = 1.0
var _hat_lp: float = 0.0


var _dl: PackedFloat32Array = PackedFloat32Array()
var _dr: PackedFloat32Array = PackedFloat32Array()
var _dpos: int = 0
var _dlen: int = 1
var _dfb: float = 0.3
var _dmix: float = 0.3



var _noise: int = 987654321







func _init(id: String, rate: int = RATE, propia: Dictionary = {}) -> void:
	var a_medida: bool = not propia.is_empty()
	track_id = id if (a_medida or TRACKS.has(id)) else "menu"
	_rate = float(rate)
	var cfg: Dictionary = propia if a_medida else TRACKS[track_id]
	_prog = cfg["prog"]
	_bars = _prog.size()
	_sections = cfg["sections"]
	_total_bars = _bars * _sections.size()
	for bar in _total_bars:
		_sec_of_bar.append(_idiv(bar, _bars) % _sections.size())
	for row in cfg["lead"]:
		_lead16.append(_expand(row))
	_bass16 = _expand(cfg["bass"])
	_arp16 = _expand(cfg["arp"])
	_kick16 = _expand(cfg["kick"])
	_snare16 = _expand(cfg["snare"])
	_hat16 = _expand(cfg["hat"])
	_varia = TRACKS.has(id)
	_build_vuelta_b()
	_int_gain = cfg.get("int_gain", {})
	_lead_duty = float(cfg["lead_duty"])
	_lead_decay = float(cfg["lead_decay"])
	_arp_decay = float(cfg.get("arp_decay", 0.16))
	_bass_decay = float(cfg.get("bass_decay", 0.42))
	_piano = String(cfg.get("timbre", "")) == "piano"
	_hb_dec = _decay(PIANO_MARTILLO_S)
	_sala = float(cfg.get("sala", 0.0))
	if _sala > 0.0:
		_cn0 = maxi(int(_rate * SALA_MS[0] * 0.001), 1)
		_cn1 = maxi(int(_rate * SALA_MS[1] * 0.001), 1)
		_cn2 = maxi(int(_rate * SALA_MS[2] * 0.001), 1)
		_cn3 = maxi(int(_rate * SALA_MS[3] * 0.001), 1)
		_cb0.resize(_cn0)
		_cb1.resize(_cn1)
		_cb2.resize(_cn2)
		_cb3.resize(_cn3)
	_hat_off = int(cfg.get("hat_off", 0))
	_pump_depth = float(cfg.get("pump", 0.0))
	_master = MASTER * float(cfg.get("gain", 1.0))
	_spstep = _rate * 60.0 / float(cfg["bpm"]) / 4.0



	_pump_rate = 1.0 - exp(-1.0 / maxf(_spstep * 1.1, 1.0))
	_loop_steps = _total_bars * STEPS_BAR
	_dlen = maxi(int(_rate * float(cfg["delay_ms"]) * 0.001), 1)
	_dl.resize(_dlen)
	_dr.resize(_dlen)
	_dfb = float(cfg["delay_fb"])
	_dmix = float(cfg["delay_mix"])
	reset()




func _expand(pat: Array) -> Array[int]:
	var out: Array[int] = []
	if pat.size() >= STEPS_BAR:
		for v in pat:
			out.append(int(v))
		return out
	for v in pat:
		out.append(int(v))
		out.append(-1)
	return out







func _build_vuelta_b() -> void:
	var lo: int = 999
	var hi: int = 0
	for row in _lead16:
		for n in row:
			if int(n) > 0:
				lo = mini(lo, int(n))
				hi = maxi(hi, int(n))
	var shift: int = 0
	if hi > 0 and hi + 12 <= 88:
		shift = 12
	elif hi > 0 and lo - 12 >= 52:
		shift = -12
	for row in _lead16:
		var r: Array[int] = []
		for n in row:
			r.append(int(n) + shift if int(n) > 0 else int(n))
		_lead16_b.append(r)
	for d in _arp16:
		_arp16_b.append(mini(d + 1, TONE_OCT.size() - 1) if d >= 0 else d)



func vueltas() -> int:
	return _pase




func empieza_en_vuelta(n: int) -> void:
	_pase = maxi(n, 0)



func reset() -> void:
	_step = 0
	_pase = 0
	_step_acc = 0.0
	_dpos = 0
	_noise = 987654321
	for i in _dlen:
		_dl[i] = 0.0
		_dr[i] = 0.0
	_bass_env = 0.0
	_arp_env = 0.0
	_lead_env = 0.0
	_pad_env = 0.0
	_kick_env = 0.0
	_snare_env = 0.0
	_hat_env = 0.0
	_bass_amp = 0.0
	_arp_amp = 0.0
	_lead_amp = 0.0
	_pad_amp = 0.0
	_lead_lp = 0.0
	_pad_lp = 0.0
	_snare_lp = 0.0
	_hat_lp = 0.0
	_pump = 1.0
	_pl_env = 0.0
	_pl_amp = 0.0
	_pl_hb = 0.0
	_pl_lp = 0.0
	_pa_env = 0.0
	_pa_amp = 0.0
	_pa_hb = 0.0
	_pa_lp = 0.0
	_pb_env = 0.0
	_pb_amp = 0.0
	_pb_hb = 0.0
	_pb_lp = 0.0
	_turno = 0
	_cb0.fill(0.0)
	_cb1.fill(0.0)
	_cb2.fill(0.0)
	_cb3.fill(0.0)
	_cp0 = 0
	_cp1 = 0
	_cp2 = 0
	_cp3 = 0
	_cl0 = 0.0
	_cl1 = 0.0
	_cl2 = 0.0
	_cl3 = 0.0
	_intensity = _int_target
	_g_pad = 0.0
	_apply_step_gains(0)





func set_intensity(value: float) -> void:
	_int_target = clampf(value, 0.0, 1.0)


func intensity() -> float:
	return _intensity



func loop_seconds() -> float:
	return float(_loop_steps) * _spstep / _rate








func render(out: PackedVector2Array) -> void:
	var n: int = out.size()
	if n <= 0:
		return


	var duty: float = _lead_duty
	var dfb: float = _dfb
	var dmix: float = _dmix
	var dlen: int = _dlen
	var dpos: int = _dpos
	var noise: int = _noise
	var pdepth: float = _pump_depth
	var master: float = _master
	var hbd: float = _hb_dec
	var sala: float = _sala

	for i in n:

		_step_acc += 1.0
		if _step_acc >= _spstep:
			_step_acc -= _spstep
			_advance_step()

		var mid: float = 0.0
		var l: float = 0.0
		var r: float = 0.0
		var wet: float = 0.0






		_pump +=(1.0 - _pump) * _pump_rate
		var pg: float = 1.0 - pdepth *(1.0 - _pump)


		if _bass_env > 0.0001 or _bass_amp > 0.0001:
			_bass_ph += _bass_inc
			if _bass_ph >= 1.0:
				_bass_ph -= 1.0

			var tri: float = _bass_ph + _bass_ph - 1.0
			if tri < 0.0:
				tri = - tri
			tri = tri + tri - 1.0
			_bass_env *= _bass_dec
			_bass_amp +=(_bass_env - _bass_amp) * 0.02
			mid += tri * _bass_amp * pg


		if _arp_env > 0.0001 or _arp_amp > 0.0001:
			_arp_ph += _arp_inc
			if _arp_ph >= 1.0:
				_arp_ph -= 1.0
			var sq: float = 0.7 if _arp_ph < 0.25 else -0.7
			_arp_env *= _arp_dec
			_arp_amp +=(_arp_env - _arp_amp) * 0.05
			var v: float = sq * _arp_amp * pg


			l += v * 0.55
			r += v * 0.95
			wet += v * 0.7


		if _lead_env > 0.0001 or _lead_amp > 0.0001:
			_lead_ph += _lead_inc
			if _lead_ph >= 1.0:
				_lead_ph -= 1.0
			var sq2: float = 1.0 if _lead_ph < duty else -1.0
			_lead_lp +=(sq2 - _lead_lp) * 0.45
			_lead_env *= _lead_dec
			_lead_amp +=(_lead_env - _lead_amp) * 0.04
			var vl: float = _lead_lp * _lead_amp
			mid += vl * 0.85
			l += vl * 0.15
			wet += vl * 0.9







		if _pl_env > 0.0001 or _pl_amp > 0.0001:
			_pl_ph += _pl_inc
			if _pl_ph >= 1.0:
				_pl_ph -= 1.0
			var t0: float = _pl_ph + _pl_ph - 1.0
			if t0 < 0.0:
				t0 = - t0
			t0 = t0 + t0 - 1.0
			var q0: float = 1.0 if _pl_ph < 0.5 else -1.0
			_pl_lp +=(t0 +(q0 - t0) * _pl_hb - _pl_lp) * 0.5
			_pl_hb *= hbd
			_pl_env *= _pl_dec
			_pl_amp +=(_pl_env - _pl_amp) * 0.05
			var vp0: float = _pl_lp * _pl_amp
			mid += vp0 * 0.8
			r += vp0 * 0.15
			wet += vp0 * 0.9


		if _pa_env > 0.0001 or _pa_amp > 0.0001:
			_pa_ph += _pa_inc
			if _pa_ph >= 1.0:
				_pa_ph -= 1.0
			var t1: float = _pa_ph + _pa_ph - 1.0
			if t1 < 0.0:
				t1 = - t1
			t1 = t1 + t1 - 1.0
			var q1: float = 1.0 if _pa_ph < 0.5 else -1.0
			_pa_lp +=(t1 +(q1 - t1) * _pa_hb - _pa_lp) * 0.5
			_pa_hb *= hbd
			_pa_env *= _pa_dec
			_pa_amp +=(_pa_env - _pa_amp) * 0.05
			var vp1: float = _pa_lp * _pa_amp
			l += vp1 * 0.9
			r += vp1 * 0.55
			wet += vp1 * 0.7
		if _pb_env > 0.0001 or _pb_amp > 0.0001:
			_pb_ph += _pb_inc
			if _pb_ph >= 1.0:
				_pb_ph -= 1.0
			var t2: float = _pb_ph + _pb_ph - 1.0
			if t2 < 0.0:
				t2 = - t2
			t2 = t2 + t2 - 1.0
			var q2: float = 1.0 if _pb_ph < 0.5 else -1.0
			_pb_lp +=(t2 +(q2 - t2) * _pb_hb - _pb_lp) * 0.5
			_pb_hb *= hbd
			_pb_env *= _pb_dec
			_pb_amp +=(_pb_env - _pb_amp) * 0.05
			var vp2: float = _pb_lp * _pb_amp
			l += vp2 * 0.55
			r += vp2 * 0.9
			wet += vp2 * 0.7


		_g_pad +=(_g_pad_t - _g_pad) * 0.00025
		if _pad_env > 0.0001 or _pad_amp > 0.0001:
			_pad_ph0 += _pad_in0
			if _pad_ph0 >= 1.0:
				_pad_ph0 -= 1.0
			_pad_ph1 += _pad_in1
			if _pad_ph1 >= 1.0:
				_pad_ph1 -= 1.0
			_pad_ph2 += _pad_in2
			if _pad_ph2 >= 1.0:
				_pad_ph2 -= 1.0
			_pad_env *= _pad_dec
			_pad_amp +=(_pad_env - _pad_amp) * 0.0015
			var pa: float = _pad_amp * _g_pad * pg
			var s0: float = _pad_ph0 + _pad_ph0 - 1.0
			var s2: float = _pad_ph2 + _pad_ph2 - 1.0

			_pad_lp +=((s0 +(_pad_ph1 + _pad_ph1 - 1.0) + s2) * 0.333 - _pad_lp) * 0.1
			var body: float = _pad_lp * pa
			mid += body * 0.4
			l +=(s0 * 0.42 + _pad_lp * 0.6) * pa * 0.5
			r +=(s2 * 0.42 + _pad_lp * 0.6) * pa * 0.5


		if _kick_env > 0.0005:
			_kick_ph += _kick_inc
			if _kick_ph >= 1.0:
				_kick_ph -= 1.0
			_kick_inc *= 0.99988
			var kt: float = _kick_ph + _kick_ph - 1.0
			if kt < 0.0:
				kt = - kt
			kt = kt + kt - 1.0
			kt = kt *(1.5 - 0.5 * kt * kt)
			_kick_env *= _kick_dec
			mid += kt * _kick_env * 1.15


		if _snare_env > 0.0005:
			noise =(noise * 1103515245 + 12345)&1073741823
			var w: float = float(noise) * 1.86264514923e-09 - 1.0
			_snare_lp +=(w - _snare_lp) * 0.35
			_snare_env *= _snare_dec
			var sn: float =(w - _snare_lp * 0.6) * _snare_env
			mid += sn * 0.55
			l += sn * 0.2
			r += sn * 0.2


		if _hat_env > 0.0005:
			noise =(noise * 1103515245 + 12345)&1073741823
			var w2: float = float(noise) * 1.86264514923e-09 - 1.0
			_hat_lp +=(w2 - _hat_lp) * 0.7
			_hat_env *= _hat_dec
			var hh: float =(w2 - _hat_lp) * _hat_env
			l += hh * 0.85
			r += hh * 0.45


		var el: float = _dl[dpos]
		var er: float = _dr[dpos]
		_dl[dpos] = wet + er * dfb
		_dr[dpos] = el * dfb
		dpos += 1
		if dpos >= dlen:
			dpos = 0

		l += mid + el * dmix
		r += mid + er * dmix





		if sala > 0.0:
			var ent: float = wet * SALA_IN
			var c0: float = _cb0[_cp0]
			_cl0 +=(c0 - _cl0) * SALA_DAMP
			_cb0[_cp0] = ent + _cl0 * SALA_FB
			_cp0 += 1
			if _cp0 >= _cn0:
				_cp0 = 0
			var c1: float = _cb1[_cp1]
			_cl1 +=(c1 - _cl1) * SALA_DAMP
			_cb1[_cp1] = ent + _cl1 * SALA_FB
			_cp1 += 1
			if _cp1 >= _cn1:
				_cp1 = 0
			var c2: float = _cb2[_cp2]
			_cl2 +=(c2 - _cl2) * SALA_DAMP
			_cb2[_cp2] = ent + _cl2 * SALA_FB
			_cp2 += 1
			if _cp2 >= _cn2:
				_cp2 = 0
			var c3: float = _cb3[_cp3]
			_cl3 +=(c3 - _cl3) * SALA_DAMP
			_cb3[_cp3] = ent + _cl3 * SALA_FB
			_cp3 += 1
			if _cp3 >= _cn3:
				_cp3 = 0
			l +=(c0 + c1) * sala
			r +=(c2 + c3) * sala


		l *= master
		r *= master
		if l > 1.0:
			l = 1.0
		elif l < -1.0:
			l = -1.0
		else:
			l = l *(1.5 - 0.5 * l * l)
		if r > 1.0:
			r = 1.0
		elif r < -1.0:
			r = -1.0
		else:
			r = r *(1.5 - 0.5 * r * r)
		out[i] = Vector2(l, r)

	_dpos = dpos
	_noise = noise






func _advance_step() -> void:
	var step: int = _step
	_step += 1
	if _step >= _loop_steps:
		_step = 0
		_pase += 1
	_intensity +=(_int_target - _intensity) * 0.05
	_apply_step_gains(step)

	var bar: int =(step>>BAR_SHIFT) % _total_bars
	var s16: int = step&(STEPS_BAR - 1)
	var chord: Array = _prog[bar % _bars]
	var sec: Dictionary = _sections[_sec_of_bar[bar]]
	var vuelta_b: bool = _varia and (_pase&1) == 1

	var fin_sec: bool = _varia and bar % _bars == _bars - 1




	if s16 == 0:
		var g0: int = 0 if int(chord[1]) <= MAJOR else 1
		_pad_in0 = _hz(_chord_tone(chord, g0) + 12) * 0.9962 / _rate
		_pad_in1 = _hz(_chord_tone(chord, g0 + 1) + 12) / _rate
		_pad_in2 = _hz(_chord_tone(chord, g0 + 2) + 12) * 1.0038 / _rate
		_pad_env = 0.5
		_pad_dec = _decay(2.6)


	var bd: int = _bass16[s16]
	if bd >= 0 and _g_bass > 0.001:
		_bass_inc = _hz(_chord_tone(chord, bd) - 12) / _rate
		_bass_env = 0.85 * _g_bass
		_bass_dec = _decay(_bass_decay)



	var ad: int = _arp16_b[s16] if vuelta_b else _arp16[s16]
	if ad >= 0 and _g_arp > 0.001:
		if _piano:
			if _turno == 0:
				_pa_inc = _hz(_chord_tone(chord, ad) + 12) / _rate
				_pa_env = 0.42 * _g_arp
				_pa_dec = _decay(_arp_decay)
				_pa_hb = PIANO_MARTILLO
			else:
				_pb_inc = _hz(_chord_tone(chord, ad) + 12) / _rate
				_pb_env = 0.42 * _g_arp
				_pb_dec = _decay(_arp_decay)
				_pb_hb = PIANO_MARTILLO
			_turno = 1 - _turno
		else:
			_arp_inc = _hz(_chord_tone(chord, ad) + 12) / _rate
			_arp_env = 0.42 * _g_arp
			_arp_dec = _decay(_arp_decay)


	var note: int = int((_lead16_b if vuelta_b else _lead16)[bar % _bars][s16])
	if note > 0 and _g_lead > 0.001:
		if _piano:
			_pl_inc = _hz(note) / _rate
			_pl_env = 0.55 * _g_lead
			_pl_dec = _decay(_lead_decay)
			_pl_hb = PIANO_MARTILLO
		else:
			_lead_inc = _hz(note) / _rate
			_lead_env = 0.55 * _g_lead
			_lead_dec = _decay(_lead_decay)
	elif note == 0:
		_lead_env = 0.0
		_pl_env = 0.0


	if _kick16[s16] == 1:
		var gk: float = _layer(sec, "kick")
		if gk > 0.001:
			_kick_inc = 130.0 / _rate
			_kick_env = 0.95 * gk
			_kick_dec = _decay(0.13)



			_pump = 0.0
	if fin_sec and s16 >= 12:





		var sig: Dictionary = _sections[_sec_of_bar[(bar + 1) % _total_bars]]
		var gf: float = maxf(_layer(sec, "snare"), _layer(sig, "snare"))
		if gf > 0.001:
			_snare_env = 0.75 * gf *(0.45 + 0.17 * float(s16 - 12))
			_snare_dec = _decay(0.07)
	elif _snare16[s16] == 1:
		var gs: float = _layer(sec, "snare")
		if gs > 0.001:
			_snare_env = 0.75 * gs
			_snare_dec = _decay(0.1)
	if _varia and s16 == 0 and bar % _bars == 0 and (bar > 0 or _pase > 0):



		var gc: float = _layer(sec, "kick")
		if gc > 0.001:
			_hat_env = 0.4 * gc
			_hat_dec = _decay(0.32)
	elif _hat16[s16] == 1:
		var gh: float = _layer(sec, "hat")
		if gh > 0.001:



			_hat_env =(0.3 if (s16 - _hat_off) % 4 == 0 else 0.17) * gh
			_hat_dec = _decay(0.045)



func _apply_step_gains(step: int) -> void:
	var sec: Dictionary = _sections[_sec_of_bar[(step>>BAR_SHIFT) % _total_bars]]
	_g_bass = _layer(sec, "bass")
	_g_arp = _layer(sec, "arp")
	_g_lead = _layer(sec, "lead")
	_g_pad_t = _layer(sec, "pad")




func _layer(sec: Dictionary, voice: String) -> float:
	var g: float = float(sec.get(voice, 0.0))
	if g <= 0.0:
		return 0.0
	if not _int_gain.has(voice):
		return g
	var v2: Vector2 = _int_gain[voice]
	return g *(v2.x +(v2.y - v2.x) * _intensity)






func _chord_tone(chord: Array, i: int) -> int:
	var q: int = int(chord[1])
	if q <= MAJOR:
		var k: int = clampi(i, 0, TONE_OCT.size() - 1)
		var tri: Array[int] = MIN_TRI if q == MINOR else MAJ_TRI
		return int(chord[0]) + tri[TONE_DEG[k]] + 12 * TONE_OCT[k]
	var k4: int = clampi(i, 0, TONE_OCT4.size() - 1)
	var cua: Array[int] = MAJ7_T if q == MAJ7 else (MIN7_T if q == MIN7 else ADD9_T)
	return int(chord[0]) + cua[TONE_DEG4[k4]] + 12 * TONE_OCT4[k4]


func _hz(midi: int) -> float:
	return 440.0 * pow(2.0,(float(midi) - 69.0) / 12.0)




func _decay(seconds: float) -> float:
	return exp(-1.0 /(_rate * maxf(seconds, 0.001)))




@warning_ignore("integer_division")
func _idiv(a: int, b: int) -> int:
	return a / b
