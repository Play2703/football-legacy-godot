static var _carreras: Dictionary = {}



static func caras() -> Dictionary:
	var out: Dictionary = {}
	for club in CLUBES:
		out[Coach.face_seed(String(club), Coaches.TERM_BASE)] = CLUBES[club]
	for pais in SELECCIONES:
		var canon: String = Nations.canon_id(String(pais))
		if not canon.is_empty():
			out[Coach.nat_face_seed(canon, Coaches.TERM_BASE)] = SELECCIONES[pais]
	return out



static func carrera_de(id: String) -> Array:
	if _carreras.is_empty():
		for club in CARRERAS:
			_carreras[Coach.face_seed(String(club), Coaches.TERM_BASE)] = CARRERAS[club]
		for pais in SELECCIONES_CARRERAS:
			var canon: String = Nations.canon_id(String(pais))
			if not canon.is_empty():
				_carreras[Coach.nat_face_seed(canon, Coaches.TERM_BASE)] = SELECCIONES_CARRERAS[pais]
	return CoachEdits.sanea_carrera(_carreras.get(id, []))




static var por_nombre: Dictionary = {}



static func carreras_por_nombre(nombre: String) -> Array:
	var out: Array = []
	if nombre.is_empty():
		return out
	var tabla: Dictionary = por_nombre if not por_nombre.is_empty() else CARRERAS_POR_NOMBRE
	for c in tabla.get(nombre.hash(), []):
		var car: Array = CoachEdits.sanea_carrera(c)
		if not car.is_empty():
			out.append(car)
	return out
