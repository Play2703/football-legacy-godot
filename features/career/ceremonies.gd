static func sort_queue(queue: Array) -> Array:
	var indexed: Array = []
	for i in queue.size():





		var row: Dictionary = queue[i]
		var ord: int = int(row.get("order", order_of(String(row.get("kind", "")))))
		indexed.append([tramo_de(row), ord, i, queue[i]])
	indexed.sort_custom(func(a: Array, b: Array) -> bool:
		if a[0] != b[0]:
			return a[0] < b[0]
		return a[1] < b[1] if a[1] != b[1] else a[2] < b[2])
	var out: Array = []
	for row in indexed:
		out.append(row[3])
	return out








static func tramo_de(row: Dictionary) -> int:
	var kind: String = String(row.get("kind", ""))
	if kind == INJURY or DEL_PITIDO.has(kind):
		return 1
	return 0 if int(row.get("order", order_of(kind))) < -1 else 2





static func aplaza_ficha(queue: Array) -> bool:
	for row in queue:
		if DEL_PITIDO.has(String((row as Dictionary).get("kind", ""))):
			return true
	return false




static func antes_de_la_ficha(row: Dictionary) -> bool:
	return not row.is_empty() and tramo_de(row) <= 1




