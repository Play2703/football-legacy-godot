static func es_titulo_de_club(award: String) -> bool:
	return TROPHIES.has(award) and not bool(TROPHIES[award].get("nation", false))


























static func titulos_en_ventana(registro: Array, ahora: float, club: String = "") -> Array[String]:
	var out: Array[String] = []
	var vistos: Dictionary = {}
	for e in registro:
		if not (e is Dictionary):
			continue
		var a: float = float(e.get("a", -99.0))
		if a > ahora + 1e-06 or a <= ahora - 1.0 + 0.001:
			continue
		if not club.is_empty() and str(e.get("c", "")) != club:
			continue
		var t: String = str(e.get("t", ""))
		var clave: String = "%s|%d" % [t, int(e.get("k", -1))]
		if vistos.has(clave) or not es_titulo_de_club(t):
			continue
		vistos[clave] = true
		out.append(t)
	return out



const SEXTETE_MIN: int = 6





const HAZANAS: Dictionary = {6: "¡SEXTETE!", 7: "¡SEPTETE!", 8: "¡OCTETE!"}





static func hazana_de(n: int) -> String:
	if n < SEXTETE_MIN:
		return ""
	return String(HAZANAS.get(mini(n, 8), ""))








const COLD_OPEN_SCENE: String = "res://ui/ceremonies/cold_open.tscn"







































static func cold_open_for(is_nat: bool, nat_caps: int, derby: bool,
		comp: String, gala: bool = false,
		final: bool = false, nat_stage: String = "",
		starter: bool = true, sombra: bool = false, pases: bool = false,
		pronostico: bool = false) -> String:
	if is_nat:


		if nat_caps <= 0:
			return "anthem"
		if final:
			return "tunel"



		if not starter and not protocol_previa(true, "", nat_stage):
			return "banquillo"
		return ""
	if final:
		return "tunel"










	if gala:
		return "vitrina"







	if protocol_previa(false, comp, ""):
		return ""
	if derby:
		return "tifo"
	if not starter:
		return "banquillo"






	if sombra:
		return "sombra"





	if pases:
		return "pases"




	if pronostico:
		return "pronostico"
	return ""






















static func protocol_previa(is_nat: bool, comp: String,
		nat_stage: String) -> bool:
	if is_nat:
		return nat_stage == "mundial"
	return comp == "champions" or comp == "europa" or comp == "conference"















