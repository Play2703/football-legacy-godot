static func veterano(club_id: String) -> Dictionary:
	if club_id.is_empty() or Teams.by_id(club_id).is_empty() or not WorldAging.is_enabled():
		return {}
	var squad: Array = Squad.of_nominal(club_id)
	var meta: Array = Career.squad_meta_of(club_id)
	if squad.is_empty() or meta.size() != squad.size():
		return {}
	var tu: int = Squad.user_index(squad) if club_id == GameState.player_team_id else -1
	var mejor: Dictionary = {}
	for i in squad.size():
		if i == tu:
			continue
		var p: Dictionary = squad[i]
		var nombre: String = String(p.get("name", ""))
		var edad: int = int((meta[i] as Dictionary).get("age", 0))
		if nombre.is_empty() or edad <= 0 or edad <= int(mejor.get("age", 0)):
			continue
		if WorldAging.retires_in_casa(club_id, i, String(p.get("pos", "MC")), edad) != 0:
			continue
		mejor = {"name": nombre, "number": int(p.get("number", 0)), "age": edad}
	return mejor



static func vuelta_payload(award: String, div: int, club_id: String) -> Dictionary:
	var out: Dictionary = {"award": award, "div": div, "club": club_id}
	var vet: Dictionary = veterano(club_id)
	if not vet.is_empty():
		out["veterano"] = vet
	return out















const FAREWELL_MIN: float = 0.05
const FAREWELL_MAX: float = 0.48
const FAREWELL_AVG_LO: float = 5.8
const FAREWELL_AVG_HI: float = 8.0
const FAREWELL_GOALS_FULL: int = 20

static func farewell_attendance(avg: float, goals: int, pos: int, teams: int) -> float:
	var note: float = clampf((avg - FAREWELL_AVG_LO)
		/(FAREWELL_AVG_HI - FAREWELL_AVG_LO), 0.0, 1.0)
	var scored: float = clampf(float(goals) / float(FAREWELL_GOALS_FULL), 0.0, 1.0)


	var table: float = 0.5
	if pos > 0 and teams > 1:
		table = clampf(1.0 - float(pos - 1) / float(teams - 1), 0.0, 1.0)
	var k: float = note * 0.45 + scored * 0.35 + table * 0.2
	return clampf(FAREWELL_MIN +(FAREWELL_MAX - FAREWELL_MIN) * k,
		FAREWELL_MIN, FAREWELL_MAX)
