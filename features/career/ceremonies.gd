static func best_season_mvp(season_awards: Array) -> String:
	var best: String = ""
	var best_rank: int = -1
	for a in season_awards:
		var key: String = String(a)
		if not SEASON_MVP.has(key):
			continue
		var rank: int = int((SEASON_MVP[key] as Dictionary)["rank"])
		if rank > best_rank:
			best_rank = rank
			best = key
	return best





