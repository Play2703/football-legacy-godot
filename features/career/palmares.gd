	"bih_tro": [0, 0, 0], "bih_kra": [0, 0, 0],



}



static func historic(club_id: String) -> Dictionary:
	var r: Array = REAL.get(club_id, [0, 0, 0])
	return {"liga": int(r[0]), "copa": int(r[1]), "champions": int(r[2])}








static func live(club_id: String) -> Dictionary:
	var l: Dictionary = Career.club_titles.get(club_id, {})
	var out: Dictionary = {}
	for k in KINDS:
		out[k] = int(l.get(k, 0))
	return out



static func of(club_id: String) -> Dictionary:
	var h: Dictionary = historic(club_id)
	var l: Dictionary = live(club_id)
	var out: Dictionary = {}
	for k in KINDS:
		out[k] = int(h.get(k, 0)) + int(l.get(k, 0))
	return out



static func total(club_id: String) -> int:
	var t: Dictionary = of(club_id)


	var n: int = 0
	for k in KINDS:
		n += int(t.get(k, 0))
	return n



static func most_decorated(count: int = 10) -> Array:
	var rows: Array = []
	for team in Teams.all():
		var id: String = String(team["id"])
		rows.append({"id": id, "total": total(id)})
	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a["total"]) > int(b["total"]))
	return rows.slice(0, count)










static func ranking_kind(kind: String, count: int = -1, pais: String = "") -> Array[String]:
	var rows: Array = []
	var i: int = 0
	for team in (Teams.all() if pais.is_empty() else Teams.teams_of_country(pais)):
		var id: String = String(team["id"])
		rows.append({"id": id, "n": int(of(id).get(kind, 0)), "total": total(id), "i": i})
		i += 1
	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if int(a["n"]) != int(b["n"]):
			return int(a["n"]) > int(b["n"])
		if int(a["total"]) != int(b["total"]):
			return int(a["total"]) > int(b["total"])
		return int(a["i"]) < int(b["i"]))
	var out: Array[String] = []
	for r in rows:
		if count >= 0 and out.size() >= count:
			break
		out.append(String((r as Dictionary)["id"]))
	return out














const ERA_VENTANA: int = 6
const ERA_MIN: int = 3





static func league_rows(pais: String, hist: Array) -> Array:
	var out: Array = []
	for f in hist:
		if f is Dictionary and String((f as Dictionary).get("country", "")) == pais:
			out.append((f as Dictionary).duplicate())
	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a.get("season", 0)) > int(b.get("season", 0)))
	return out








static func era_of(club_id: String, hist: Array) -> Dictionary:
	var pais: String = Teams.country_of(club_id)
	if pais.is_empty():
		return {}
	var rows: Array = league_rows(pais, hist)
	var w: int = mini(ERA_VENTANA, rows.size())
	var n: int = 0
	for i in w:
		if _campeones_fila(rows[i]).has(club_id):
			n += 1
	if n >= ERA_MIN:
		return {"n": n, "w": w}
	return {}






static func _campeones_fila(fila: Dictionary) -> Array:
	var out: Array = []
	for k in ["champion_ap", "champion"]:
		var c: String = String(fila.get(k, ""))
		if not c.is_empty() and not out.has(c):
			out.append(c)
	return out






static func era_of_country(pais: String, hist: Array) -> Dictionary:
	var rows: Array = league_rows(pais, hist)
	var w: int = mini(ERA_VENTANA, rows.size())
	var cuenta: Dictionary = {}
	var primero: Dictionary = {}
	for i in w:
		for c in _campeones_fila(rows[i]):
			cuenta[c] = int(cuenta.get(c, 0)) + 1
			if not primero.has(c):
				primero[c] = i
	var mejor: String = ""
	for c in cuenta:
		var id: String = str(c)
		if mejor.is_empty() or int(cuenta[id]) > int(cuenta[mejor]) \
				or (int(cuenta[id]) == int(cuenta[mejor]) and int(primero[id]) < int(primero[mejor])):
			mejor = id
	if mejor.is_empty() or int(cuenta[mejor]) < ERA_MIN:
		return {}
	return {"club": mejor, "n": int(cuenta[mejor]), "w": w}







static func historic_league_top(pais: String, k: int = 3) -> Array:
	var rows: Array = []
	for t in Teams.teams_of_country(pais):
		var id: String = String((t as Dictionary).get("id", ""))
		var n: int = int(historic(id).get("liga", 0))
		if n > 0:
			rows.append({"id": id, "n": n})
	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if int(a["n"]) != int(b["n"]):
			return int(a["n"]) > int(b["n"])
		return String(a["id"]) < String(b["id"]))
	return rows.slice(0, k)
