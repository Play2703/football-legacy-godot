		return 0.0
	return Tactics.urgencia(match_minute, _dif_rival(), _sit_desde())


func _rival_volcado() -> bool:
	return _rival_urgencia_volcado() >= CONTRA_VOLCADO_U




static func contra_p_de(u_volcado: float, suyos_fuera: int, mios_fuera: int) -> float:
	var p: float = CONTRA_P
	var d: int = clampi(mios_fuera - suyos_fuera, - Tactics.NUM_CAP, Tactics.NUM_CAP)
	if d > 0:
		p += CONTRA_P_DIEZ * d
	elif d < 0:
		p *= CONTRA_P_SUYO_DIEZ


	if u_volcado >= CONTRA_VOLCADO_U:
		p += CONTRA_P_VOLCADO * u_volcado
	return clampf(p, 0.0, CONTRA_P_TOPE)







func _contra_cabe(c: int) -> bool:
	if not contragolpe_en_partido or not Practice.salida_jugada_on:
		return false
	if not _practice_kind.is_empty() or _tutorial_active or _shootout_active:
		return false
	if not _contra_hay_rival():
		return false
	if _chances_this_match < CONTRA_MIN_CHANCES or _contra_played >= CONTRA_PER_MATCH:
		return false
	if c < DUEL_FIRST_CHANCE or c > _chances_this_match:
		return false
	if c == _chances_this_match and not _rival_volcado():
		return false
	for otras in [_contra_chances, _meta_chances, _press_chances, _recu_chances,
			_servicio_chances]:
		if (otras as Array).has(c) or (otras as Array).has(c - 1) \
				or (otras as Array).has(c + 1):
			return false
	return true





func _contra_rng(c: int, sal: String) -> RandomNumberGenerator:
	var r: RandomNumberGenerator = RandomNumberGenerator.new()
	r.seed = hash([_chance_minutes, c, team_goals, rival_goals, sal])
	return r


func _contra_toca(c: int) -> bool:
	if not _contra_cabe(c):
		return false
	return _contra_rng(c, CONTRA_KIND).randf() < contra_p_de(_rival_urgencia_volcado(),
		_rival_expulsados, _expulsados_mios.size())






