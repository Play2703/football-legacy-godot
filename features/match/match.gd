func _self_cfg() -> Dictionary:
	var base: Dictionary = GameState.player_look()
	if _am_captain():
		base = base.duplicate()
		base["banda_capitan"] = true



		base["cinta_lamina"] = true
	else:
		base = base.duplicate()

	base.merge(KitRecolor.clima_tela)
	base["apellido"] = Career.nombre_espalda()































	if not _practice_kind.is_empty() and not _festejo_revivido \
			and not Practice.es_servicio(_practice_kind) \
			and _practice_kind != Practice.RECEPCION \
			and not _encargo.has("reto"):
		base["bib"] = CASACA_COLOR



	if not Career.boots_edicion.is_empty():
