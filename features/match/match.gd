const COBRO_CORRE_HINT: float = 2.2



const COBRO_CORRO_R: float = 5.0







const COBRO_AREA_MARGEN: float = 0.5










const COBRO_FRENA_M: float = 0.12


func _cobro_frena(pos: Vector2, vel: Vector2) -> Vector2:
	if vel.length_squared() < 0.0001:
		return vel
	if not _cedida_libre and not _corner_cedido:


		var v: Vector2 = vel
		var dentro_x: bool = absf(pos.x) <= Stadium.PA_HALF_W + COBRO_AREA_MARGEN
		var dentro_z: bool = pos.y <= Stadium.PA_DEPTH + COBRO_AREA_MARGEN

		if dentro_x and v.y < 0.0 \
				and pos.y <= Stadium.PA_DEPTH + COBRO_AREA_MARGEN + COBRO_FRENA_M:
			v.y = 0.0

		if dentro_z and not is_zero_approx(pos.x) \
				and absf(pos.x) <= Stadium.PA_HALF_W + COBRO_AREA_MARGEN + COBRO_FRENA_M \
				and signf(v.x) == - signf(pos.x):
			v.x = 0.0
		return v



	var fuera: Vector2 = pos - _ball_field
	var d: float = fuera.length()
	if d > COBRO_CORRO_R + COBRO_FRENA_M or d < 0.01:
		return vel
	var n: Vector2 = fuera / d
	var radial: float = vel.dot(n)
	if radial >= 0.0:
		return vel
	return vel - n * radial






func _cobro_sitio_legal(p: Vector2) -> Vector2:



	if not _cedida_libre and not _corner_cedido:
		if not _in_penalty_box(p):
			return p
		var d_frente: float = Stadium.PA_DEPTH + COBRO_AREA_MARGEN - p.y
		var d_lado: float = Stadium.PA_HALF_W + COBRO_AREA_MARGEN - absf(p.x)
		if d_frente <= d_lado:
			return Vector2(p.x, Stadium.PA_DEPTH + COBRO_AREA_MARGEN)
		return Vector2(signf(p.x) *(Stadium.PA_HALF_W + COBRO_AREA_MARGEN)
			if not is_zero_approx(p.x) else Stadium.PA_HALF_W + COBRO_AREA_MARGEN, p.y)

	var fuera: Vector2 = p - _ball_field
	var d: float = fuera.length()
	if d >= COBRO_CORRO_R:
		return p
	if d < 0.01:
		fuera = Vector2(0.0, 1.0)
	return _ball_field + fuera.normalized() * COBRO_CORRO_R

















const COBRO_CUERPO_R: float = 1.05






const COBRO_DISPUTA_R: float = 2.4


func _cobro_cuerpos() -> Array:
	var out: Array = []
	for a in (_cedida_mates + _cedida_rivals + _teammate_actors + _rival_actors):
		if a != null and is_instance_valid(a) and a != _cedida_yo:
			out.append(a)
	for a in [_self_actor, _keeper]:
		if a != null and is_instance_valid(a) and a != _cedida_yo:
			out.append(a)
	return out




func _cobro_esquiva(p: Vector2, vel: Vector2) -> Vector2:
	if vel.length_squared() < 1e-06:
		return vel










	var puntos: Array = [_ball_field]
	if _ball != null and is_instance_valid(_ball) and _ball.visible:
		puntos.append(Vector2(_ball.position.x, _ball.position.z))
	for a in _cobro_cuerpos():
		var ap: Vector2 = Vector2(a.position.x, a.position.z)
		var disputa: bool = false
		for q in puntos:
			if ap.distance_to(q) < COBRO_DISPUTA_R:
				disputa = true
				break
		if disputa:
			continue
		var d: Vector2 = p - Vector2(a.position.x, a.position.z)
		var dist: float = d.length()
		if dist >= COBRO_CUERPO_R:
			continue



		if dist < 0.01:
			continue
		var n: Vector2 = d / dist
		var radial: float = vel.dot(n)


		if radial < 0.0:
			vel -= n * radial
	return vel


