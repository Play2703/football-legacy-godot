func _recu_input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed:
			if _duel_finger != -1:





				_recu_barre()
				return
			_duel_finger = event.index
			_duel_start = event.position
			_duel_steer = Vector2.ZERO
		elif event.index == _duel_finger:
			_duel_finger = -1
			_recu_arrastre_heredado = false
			_duel_steer = Vector2.ZERO
		return
	if not (event is InputEventScreenDrag):
		return




	if _duel_finger == -1:
		_duel_finger = event.index


		_duel_start = event.position
	elif event.index != _duel_finger:
		return
	var pull: Vector2 = _duel_start - event.position
	if pull.length() < DUEL_STEER_DEADZONE:
		_duel_steer = Vector2.ZERO
		return
	var d3: Vector3 = _world_aim_dir(pull.normalized())
	_duel_steer = Vector2(d3.x, d3.z).normalized()




















func _recu_portador_paso(e: Dictionary, defs: Array, mi_spd: float, delta: float) -> void:
	var pos: Vector2 = e["p"]
	var vel: Vector2 = e["v"]
	var armed: bool = e["armed"]
	var recov: bool = e["recov"]
	var arr_t: float = e["arr_t"]
	var dir: Vector2 = Recupera.carry_steer(pos, defs, Recupera.TARGET_Z,
		vel,
		float(_recu_receta.get("w_avance", Recupera.REGATE_W_AVANCE)),
		float(_recu_receta.get("w_peligro", Recupera.REGATE_W_PELIGRO)),
		float(_recu_receta.get("w_inercia", Recupera.REGATE_W_INERCIA)))





	var cerca: float = Recupera.cerca_d(pos, defs)
	var cruza: bool = float(e["cerca_prev"]) <= Recupera.ARRANCA_D \
			and cerca > Recupera.ARRANCA_D
	if cruza:
		arr_t = Recupera.ARRANCA_T
	arr_t = maxf(arr_t - delta, 0.0)
	var su_spd: float = Recupera.carry_speed(mi_spd, _duel_run_spd_norm(), cerca) \
			* _puddle_slow(pos)
	if arr_t > 0.0:
		su_spd = maxf(su_spd, mi_spd * Recupera.PACE_LIBRE.y * Recupera.ARRANCA_MULT
			* _puddle_slow(pos))



	if dir.length_squared() > 0.0001:
		var outc: Array = Duel.step_sprint_cut(vel, dir, su_spd, _recu_car_accel,
			_recu_car_ctrl, armed, recov, delta)
		vel = outc[0]
		armed = outc[1]
		recov = outc[2]
	pos = _recu_corral(pos + vel * delta)






	var pie: Vector2 = vel.normalized() if vel.length() > 0.2 else dir
	var ritmo: float = clampf(vel.length() / maxf(su_spd, 0.01), 0.0, 1.0)






































	var toque_f: float = clampf(1.0 -(_recu_car_toque - 0.61) * 1.2, 0.7,
		Recupera.TOQUE_F_MAX)
	var lead: float =(Duel.BALL_LEAD * maxf(ritmo, 0.95) \
			if arr_t > Recupera.ARRANCA_T * 0.4 \
			else Duel.BALL_LEAD * 0.66 * ritmo) * toque_f
	var bola: Vector2 = pos + pie *(Duel.BALL_FOOT + lead)
	e["p"] = pos
	e["v"] = vel
	e["armed"] = armed
	e["recov"] = recov
	e["arr_t"] = arr_t
	e["cerca"] = cerca
	e["cerca_prev"] = cerca
	e["cruza"] = cruza
	e["ritmo"] = ritmo
	e["lead"] = lead
	e["bola"] = bola






