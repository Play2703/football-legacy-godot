func _salida_falta(penal: bool, dura: bool = false,
		culpable: AnimatedSprite3D = null) -> bool:
	if not _salida_viva:
		return false



	_salida_viva = false
	if _ball_field.y > Stadium.HALF_LINE:
		var beat: float = _ref_amonesta(dura, culpable)
		if beat > DUEL_FOUL_BEAT:
			_salida_falta_compas(beat)
		else:
			_salida_cierra("falta")
		return true
	if penal:
		return false
	_cobro_cedido(false, {}, _cedida_beat(_ref_amonesta(dura, culpable)))
	return true









func _salida_falta_compas(beat: float) -> void:
	var seq: int = _chance_seq
	_drive_beat = true
	await SceneFade.timer(beat, false).timeout
	_drive_beat = false
	if not is_inside_tree() or seq != _chance_seq or state != State.AIMING:
		return
	_salida_cierra("falta")








































