func _es_banda_baja(chance: Dictionary) -> bool:
	var b: Vector2 = chance.get("ball", Vector2.ZERO)
	return absf(b.x) >= BAJA_X and b.y <= BAJA_Z






































const WING_X: float = Stadium.PA_HALF_W
const WING_PATIENCE: Vector2i = Vector2i(2, 4)





const WING_PATIENCE_CAL: Vector2i = Vector2i(1, 2)
const PUESTOS_CAL: Array[String] = ["EI", "ED"]
var _wing_drought: int = 0
var _wing_patience: int = 3
var _force_wing: bool = false




func _lado_of(chance: Dictionary) -> int:
	var x: float =(chance.get("ball", Vector2.ZERO) as Vector2).x
	if absf(x) <= LADO_WIDE_X:
		return 0
	return -1 if x < 0.0 else 1


func _repeats_lado(chance: Dictionary) -> bool:


	if not BAJA_EXENTOS.has(String(chance.get("kind", ""))):
		if _last_baja and _es_banda_baja(chance):
			return true
	var lado: int = _lado_of(chance)
	if lado == 0:
		return _centre_run >= LADO_CENTRE_RUN




	if lado == _last_lado and lado == _banda_propia():
		return false
	return lado == _last_lado


func _remember_lado(chance: Dictionary) -> void:
	var lado: int = _lado_of(chance)
	_centre_run = _centre_run + 1 if lado == 0 else 0
	_last_lado = lado
	_last_baja = _es_banda_baja(chance)



	_fotos_partido[_foto_de(chance)] = true
	var x: float =(chance.get("ball", Vector2.ZERO) as Vector2).x
	if absf(x) > WING_X:
		_wing_drought = 0
		var pac: Vector2i = WING_PATIENCE_CAL if PUESTOS_CAL.has(_puesto_juego) \
				else WING_PATIENCE
		_wing_patience = randi_range(pac.x, pac.y)
	else:
		_wing_drought += 1













































const FOTO_REPITE_P: float = 1.0
const FOTO_TRIES: int = 4
const FOTO_TRIES_BANDA: int = 5


var foto_repite_p: float = FOTO_REPITE_P


const FOTO_FRANJAS: Array[float] = [8.0, 16.0, 24.0, 34.0, 46.0]
const FOTO_AREA: int = 2
var _fotos_partido: Dictionary = {}



func _franja_de(chance: Dictionary) -> int:
	var d: float =(chance.get("ball", Vector2.ZERO) as Vector2).length()
	var i: int = 0
	while i < FOTO_FRANJAS.size() and d >= FOTO_FRANJAS[i]:
		i += 1
	return i



func _foto_de(chance: Dictionary) -> String:
	return "%d|%d" % [_franja_de(chance), _lado_of(chance)]


func _repite_foto(chance: Dictionary, tries: int) -> bool:
	if foto_repite_p <= 0.0 \
			or tries >=(FOTO_TRIES_BANDA if _banda_propia() != 0 else FOTO_TRIES) \
			or BAJA_EXENTOS.has(String(chance.get("kind", ""))):
		return false
	if _puesto_juego == "DC" and _franja_de(chance) < FOTO_AREA:
		return false
	if not _fotos_partido.has(_foto_de(chance)):
		return false
	return randf() < foto_repite_p




const FOTO_PARADO: Array[String] = ["libre", "corner", "penal", "indirecta", "banda"]


const FOTO_ABIERTO_TRIES: int = 8
















func _roll_abierto() -> Dictionary:
	var otra: int = - _banda_propia()
	var spared: bool = _deep_spared
	var o: Dictionary = _pick_origin()
	var n: int = 0
	while n < FOTO_ABIERTO_TRIES and (FOTO_PARADO.has(String(o.get("kind", "")))
			or bool(o.get("saque_banda", false))
			or (otra != 0 and _lado_of(o) == otra)):
		_deep_spared = spared
		o = _pick_origin()
		n += 1
	return _chance_from_origin(o)








func _skips_dead_ball(chance: Dictionary) -> bool:
	if GameState.readonly_save:
		return false
	var kind: String = String(chance.get("kind", ""))
	if kind == "penal":
		return randf() >= Career.set_piece_share("penal")
	if kind == "corner":
















		if randf() < Career.set_piece_share("parado"):
			return false











		if not CORNER_CEDIDO_ON or not _cobro_cedido_visible():
			return true





		if not MatchPlan.puede_evaporar_ocasion(_chances_reales,
				_chance_minutes.size() - chance_index):
			return true
		chance["cedido"] = true
		return false
	if kind == "libre" or kind == "indirecta":
		return randf() >= Career.set_piece_share("parado")
	return false























const AREA_KINDS: Array[String] = ["solo", "aereo", "centro", "angulo", "bounce", "lob"]












const AREA_KEEP: Dictionary = {
	"DC": 1.0, "CAM": 0.85, "EI": 0.8, "ED": 0.8,
	"MI": 0.6, "MD": 0.6, "MC": 0.45, "MCD": 0.3,
}






static func salta_por_puesto(kind: String, pos: String, roll: float,
		generica: bool = false) -> bool:
	if generica or not AREA_KINDS.has(kind):
		return false
	return roll >= float(AREA_KEEP.get(pos, 1.0))


func _skips_by_pos(chance: Dictionary) -> bool:



	if not _practice_kind.is_empty() or GameState.readonly_save:
		return false


	var roll: float = randf()
	return salta_por_puesto(String(chance.get("kind", "")), Squad.USER_POS, roll,
		bool(chance.get("generica", false)))


func _roll_chance() -> Dictionary:
	return _chance_from_origin(_pick_origin())


































