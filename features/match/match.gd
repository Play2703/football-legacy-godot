static func servicio_p_de(base: float, mult: float) -> float:
	if base <= 0.0:
		return 0.0
	return clampf(base * maxf(mult, 0.0), 0.0, SERVICIO_P_TOPE)







static func servicio_base_de(puesto: String, escenario: String) -> float:
	if puesto == "POR":
		return 0.0
	var mult: float = float((SERVICIO_MULT_POR_PUESTO.get(puesto, {}) as Dictionary) \
			.get(escenario, 1.0))
	return float(SERVICIO_P.get(escenario, 0.0)) * mult



func _servicio_p(escenario: String) -> float:
	return servicio_p_de(servicio_base_de(Squad.USER_POS, escenario),
		float(_rasgos.get("servicio", 1.0)))






func _servicio_cupo(escenario: String) -> int:
	if _servicio_cupos.is_empty():
		var ps: Dictionary = {}
		for e in SERVICIO_ORDEN:
			ps[e] = _servicio_p(e)
		_servicio_cupos = servicio_cupos_de(ps)
	return int(_servicio_cupos.get(escenario, 0))







static func servicio_cupos_de(ps: Dictionary) -> Dictionary:
	var cupos: Dictionary = {}
	for e in SERVICIO_ORDEN:
		cupos[e] = SERVICIO_PER_MATCH if randf() < float(ps.get(e, 0.0)) else 0
	var orden: Array[String] = SERVICIO_ORDEN.duplicate()
	var iv: int = orden.find("volea")
	var ic: int = orden.find("cabeza")
	if iv >= 0 and ic >= 0 and randf() < 0.5:
		orden[iv] = "cabeza"
		orden[ic] = "volea"
	var quedan: int = SERVICIO_TOPE_PARTIDO
	for e in orden:
		var n: int = mini(int(cupos[e]), quedan)
		cupos[e] = n
		quedan -= n
	return cupos






func _schedule_servicio(desde: int = 0, ya_jugadas: Array[int] = []) -> void:
	_servicio_chances = []


	var jugado: Dictionary = {}
	for c in ya_jugadas:
		if _servicio_hueco.has(c):
			jugado[c] = _servicio_hueco[c]
	_servicio_hueco = jugado.duplicate()
	if not servicio_en_carrera or not _practice_kind.is_empty():
		return
	if _chances_this_match < SERVICIO_MIN_CHANCES:
		return


	var pool: Array[int] = []
	for i in range(maxi(1, desde), _chances_this_match + 1):
		pool.append(i)
	pool.shuffle()
	var cupos: Dictionary = {}
	for escenario in SERVICIO_ORDEN:
		cupos[escenario] = _servicio_cupo(escenario) - jugado.values().count(escenario)












	for pasada in 4:
		for escenario in SERVICIO_ORDEN:
			for c in pool:
				if int(cupos[escenario]) <= 0:
					break
				if _servicio_hueco_libre(c, ya_jugadas, pasada):
					_servicio_chances.append(c)
					_servicio_hueco[c] = escenario
					cupos[escenario] = int(cupos[escenario]) - 1





func _servicio_hueco_libre(c: int, ya_jugadas: Array[int], pasada: int) -> bool:
	if c < DUEL_FIRST_CHANCE and pasada < 3:
		return false
	for otras in [_servicio_chances, ya_jugadas, _press_chances, _recu_chances, _meta_chances]:
		if (otras as Array).has(c):
			return false
	var lejos_de: Array = []
	if pasada < 2:
		lejos_de += [_servicio_chances, ya_jugadas]
	if pasada < 1:
		lejos_de += [_press_chances, _recu_chances, _meta_chances]
	for otras in lejos_de:
		if (otras as Array).has(c - 1) or (otras as Array).has(c + 1):
			return false
	return true




