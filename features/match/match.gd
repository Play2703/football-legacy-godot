			int(_recu_tally.get("parada", 0)), int(_recu_tally.get("fuera", 0))])

























	if why == "gol":
		if not gol_cantado:
			_recu_gol_canta()
			_recu_gol_cantado = false






		_home_crowd_trouble()





	if _practice_kind.is_empty() and not _tutorial_active and not _shootout_active:




		if why == "gol":
			rival_goals += 1
			_sync_score()





			_celebrate_goal(true)
		_recu_gol_grada = why == "gol"
		_resolve_chance("recu_out" if why == "fuera" or why == "parada"
			else "recu_lost")
