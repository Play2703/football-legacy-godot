func _foul_chance() -> Dictionary:





	if _in_penalty_box(_ball_field):
		return _chance_from_origin({"kind": "penal", "name": "Penal",
			"ball": Vector2(0.0, 11.0), "mates": [0, 0], "rivals": [0, 0],
			"set_piece": true})



	var spot: Vector2 = Vector2(
		clampf(_ball_field.x, -(Stadium.FIELD_HALF_W - 1.5), Stadium.FIELD_HALF_W - 1.5),
		maxf(_ball_field.y, Stadium.PA_DEPTH + 0.8))
	var dist: float = spot.length()









	var wall: int = ChanceArchetypes.wall_for(spot)
	var chance: Dictionary = _chance_from_origin({
		"kind": "libre",





		"name": "Falta a %d m" % int(roundf(dist)),
		"name_key": "Falta a {0} m",
		"name_args": [int(roundf(dist))],
		"name_final": true,
		"ball": spot,
		"mates": [2, 4], "rivals": [1, 3],
		"wall": wall, "set_piece": true,
	})









	chance["name_key"] = "Falta a {0} m"
	chance["name_args"] = [int(roundf(dist))]
	return chance


