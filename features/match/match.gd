func _saque_mano(srv: AnimatedSprite3D, anim: String, i: int, oeste: bool,
		der: Vector3 = Vector3.ZERO) -> Vector3:
	var px: Vector2 = SAQUE_MANOS_ESTE[clampi(i, 0, SAQUE_MANOS_ESTE.size() - 1)]
	if oeste:
		px.x = 91.0 - px.x
	var tex: Texture2D = srv.sprite_frames.get_frame_texture(anim, i) \
			if srv.sprite_frames.has_animation(anim) else null
	var sz: Vector2 = Vector2(92.0, 92.0) if tex == null else Vector2(tex.get_size())
	var k: float = srv.pixel_size * srv.global_transform.basis.get_scale().y
	var c: Vector2 = sz * 0.5 if srv.centered else Vector2.ZERO
	if der == Vector3.ZERO:
		der = _saque_der()
	var p: Vector3 = srv.global_position + der *((px.x - c.x + srv.offset.x) * k) \
			+ Vector3.UP *((c.y - px.y + srv.offset.y) * k)

	var padre: Node3D = _ball.get_parent() as Node3D
	return p if padre == null else padre.to_local(p)



func _saque_der() -> Vector3:
	var cam: Camera3D = SceneFade.camara_de(self)
	var der: Vector3 = Vector3.RIGHT if cam == null else cam.global_transform.basis.x
	der.y = 0.0
	return Vector3.RIGHT if der.length() < 0.01 else der.normalized()






func _saque_dt_z(lado: float) -> float:
	if _stadium == null or not is_instance_valid(_stadium):
		return NAN
	if _stadium.coach_balon_nodo(_home_match) == null:
		return NAN
	var f: Vector3 = _stadium.dugout_focus(_home_match)
	var padre: Node3D = _ball.get_parent() as Node3D if is_instance_valid(_ball) else null
	if padre != null:
		f = padre.to_local(f)
	if signf(f.x) != signf(lado):
		return NAN
	return f.z








func _saque_dt_prologo(srv: AnimatedSprite3D, anim: String, oeste: bool, gen: int,
		corre: String, yo: AnimatedSprite3D, recibe: String) -> bool:
	var dt_c: AnimatedSprite3D = _saque_dt
	if dt_c == null or not is_instance_valid(dt_c) or _stadium == null:
		return true
	var padre: Node3D = _ball.get_parent() as Node3D
	var r: float = BALL_VISUAL_D * 0.5
	var fps: float = dt_c.sprite_frames.get_animation_speed("balon_toque")
	var n_toque: int = dt_c.sprite_frames.get_frame_count("balon_toque")
	var n_pecho: int = dt_c.sprite_frames.get_frame_count("balon_pecho")
	var n_pase: int = dt_c.sprite_frames.get_frame_count("balon_pase")

	var t_toque0: float = float(n_pecho) / fps
	var golpes: Array[float] = []
	for j in SAQUE_DT_TOQUES:
		golpes.append(t_toque0 +(float(j * n_toque) + SAQUE_DT_TOQUE_I) / fps)
	var t_pase0: float = t_toque0 + float(SAQUE_DT_TOQUES * n_toque) / fps
	var t_golpe: float = t_pase0 + float(SAQUE_DT_PASE_I) / fps
	var t_fin: float = t_golpe + SAQUE_DT_PASE_S

	var c_loc: Vector3 = padre.to_local(dt_c.global_position) if padre != null \
			else dt_c.global_position
	var lado: float = signf(c_loc.x) if absf(c_loc.x) > 0.01 else -1.0
	var desde: Vector3 = Vector3(lado *(SAQUE_CAL_X - SAQUE_DT_DESDE.x), r,
		c_loc.z + SAQUE_DT_DESDE.y)
	var manos: Vector3 = _saque_mano(srv, anim, 0, oeste)

	var cam: Camera3D = SceneFade.camara_de(self)
	var cam0: Transform3D = cam.global_transform if cam != null else Transform3D.IDENTITY
	var fov0: float = cam.fov if cam != null else SAQUE_DT_CAM_FOV
	var sujeto: Vector3 =(dt_c.global_position + srv.global_position) * 0.5
	sujeto.y = dt_c.global_position.y
	var dentro: float = - signf(dt_c.global_position.x) if absf(dt_c.global_position.x) > 0.01 \
			else 1.0
	var plano: Transform3D = Transform3D(Basis(), sujeto + Vector3(dentro * SAQUE_DT_CAM_OFF.x,
		SAQUE_DT_CAM_OFF.y, SAQUE_DT_CAM_OFF.z)).looking_at(sujeto, Vector3.UP)
	var t: float = - SAQUE_DT_VUELO_S
	var pie_salida: Vector3 = Vector3.ZERO
	var aplaudido: bool = false
	while true:
		var punto: Callable = func(px: Vector2) -> Vector3:
			return _saque_dt_punto(dt_c, px, padre)
		if cam != null and is_instance_valid(cam):
			cam.global_transform = plano
			cam.fov = SAQUE_DT_CAM_FOV


		if t < t_fin - SAQUE_DT_COGE_S:
			var mira: String = _dir_name(dt_c.global_position - srv.global_position)
			var quieto: String = "idle" if mira == "south" else \
					("idle_back" if mira == "north" else "idle_" + mira)
			if srv.animation != quieto and _anim_usable(srv, quieto):
				srv.flip_h = false
				srv.play(quieto)
		elif srv.animation != anim and srv.sprite_frames.has_animation(anim):
			srv.play(anim)
			srv.pause()
			srv.frame = 0
		if t >= t_toque0 and not aplaudido:
			aplaudido = true
			_stadium.crowd_react("home", "close")
			_stadium.crowd_zone(dt_c.global_position, SAQUE_DT_APLAUSO_S)
		var bp: Vector3
		if t < 0.0:

			_stadium.coach_balon_cuadro(dt_c, "pecho", 0)
			var u: float = 1.0 + t / SAQUE_DT_VUELO_S
			bp = desde.lerp(punto.call(SAQUE_DT_PECHO_PX), u) \
					+ Vector3.UP * SAQUE_DT_VUELO_H * 4.0 * u *(1.0 - u)
		elif t < t_pase0:

			if t < t_toque0:
				_stadium.coach_balon_cuadro(dt_c, "pecho", int(t * fps))
			else:
				_stadium.coach_balon_cuadro(dt_c, "toque", int((t - t_toque0) * fps) % n_toque)
			var muslo: Vector3 = punto.call(SAQUE_DT_TOQUE_PX)
			if t < golpes[0]:


				var t_suelta: float = 1.0 / fps
				if t < t_suelta:
					bp = punto.call(SAQUE_DT_PECHO_PX)
				else:
					var u2: float =(t - t_suelta) /(golpes[0] - t_suelta)
					bp = punto.call(SAQUE_DT_PECHO_PX).lerp(muslo, u2) \
							+ Vector3.UP * SAQUE_DT_CAE_H * 4.0 * u2 *(1.0 - u2)
			else:
				var j2: int = 0
				while j2 + 1 < golpes.size() and t >= golpes[j2 + 1]:
					j2 += 1
				if j2 + 1 < golpes.size():
					var u3: float =(t - golpes[j2]) /(golpes[j2 + 1] - golpes[j2])
					bp = muslo + Vector3.UP * SAQUE_DT_TOQUE_H * 4.0 * u3 *(1.0 - u3)
				else:

					var pie: Vector3 = punto.call(SAQUE_DT_PIE_PX)
					var u4: float =(t - golpes[j2]) /(t_golpe - golpes[j2])
					bp = muslo.lerp(pie, u4) + Vector3.UP * SAQUE_DT_TOQUE_H * 4.0 * u4 *(1.0 - u4)
		elif t < t_golpe:
			_stadium.coach_balon_cuadro(dt_c, "pase", int((t - t_pase0) * fps))
			var pie2: Vector3 = punto.call(SAQUE_DT_PIE_PX)
			var muslo2: Vector3 = punto.call(SAQUE_DT_TOQUE_PX)
			var u5: float =(t - golpes[golpes.size() - 1]) /(t_golpe - golpes[golpes.size() - 1])
			bp = muslo2.lerp(pie2, u5) + Vector3.UP * SAQUE_DT_TOQUE_H * 4.0 * u5 *(1.0 - u5)
		else:

			_stadium.coach_balon_cuadro(dt_c, "pase",
				mini(int((t - t_pase0) * fps), n_pase - 1))
			if pie_salida == Vector3.ZERO:
				pie_salida = punto.call(SAQUE_DT_PIE_PX)
			var u6: float = clampf((t - t_golpe) / SAQUE_DT_PASE_S, 0.0, 1.0)
			bp = pie_salida.lerp(manos, u6) + Vector3.UP * SAQUE_DT_PASE_H * 4.0 * u6 *(1.0 - u6)
		_ball.position = Vector3(bp.x, maxf(bp.y, r), bp.z)
		_ball.visible = true
		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
		_anim_usable(srv, corre)
		_anim_usable(yo, recibe)
		if t >= t_fin:
			break
		await get_tree().physics_frame
		if not _saque_sigue(gen):
			if cam != null and is_instance_valid(cam):
				cam.global_transform = cam0
				cam.fov = fov0
			return false


		if can_process():
			t += get_physics_process_delta_time()
	if cam != null and is_instance_valid(cam):
		cam.global_transform = cam0
		cam.fov = fov0
	_stadium.coach_balon_suelta(dt_c)
	_saque_dt = null


	Achievements.ingest_dt_pecho()
	return true




func _saque_dt_punto(dt_c: AnimatedSprite3D, px: Vector2, padre: Node3D) -> Vector3:
	var ps: float = dt_c.pixel_size
	var cam: Camera3D = SceneFade.camara_de(self)
	var der: Vector3 = Vector3.RIGHT
	var hacia: Vector3 = Vector3.BACK
	if cam != null:
		der = cam.global_transform.basis.x
		der.y = 0.0
		der = der.normalized() if der.length() > 0.01 else Vector3.RIGHT
		hacia = cam.global_position - dt_c.global_position
		hacia.y = 0.0
		hacia = hacia.normalized() if hacia.length() > 0.01 else Vector3.BACK
	var g: Vector3 = dt_c.global_position + der *(px.x - 46.0) * ps \
			+ Vector3.UP *(46.0 - px.y) * ps + hacia * SAQUE_DT_DELANTE_M
	return padre.to_local(g) if padre != null else g




func _saque_dt_aro_vuelve(estaba: bool) -> void:
	if estaba and is_instance_valid(_drive_ring):
		_drive_ring.visible = true


func _play_saque() -> void:
	var srv: AnimatedSprite3D = _saque_srv
	var yo: AnimatedSprite3D = _self_actor
	if srv == null or not is_instance_valid(srv) or yo == null or not is_instance_valid(yo) \
			or not is_instance_valid(_ball):
		return
	var gen: int = _saque_gen
	state = State.SETUP



	_saque_orientado = _saque_orienta_va()
	_saque_mando = _saque_orientado
	_saque_dedo = -1
	if _saque_orientado:
		_saque_corre_arma(yo)


	_ball.visible = false
	var oeste: bool = srv.position.x > 0.0
	var anim: String = "saque_banda_" +("west" if oeste else "east")



	var listo: bool = false
	for _i in 30:
		_ondemand_deadline_us = Time.get_ticks_usec() + 20000
		if _gesto_listo(srv, anim):
			listo = true
			break
		await get_tree().process_frame
		if not _saque_sigue(gen):
			return
	var fps: float = srv.sprite_frames.get_animation_speed(anim) if listo else SAQUE_FPS






	var venia: Vector2 = Vector2(srv.position.x - yo.position.x, srv.position.z - yo.position.z)
	var pecho: bool = _saque_pecho
	var recibe: String =("chest_" if pecho else "control_") \
			+ _dir_name(Vector3(venia.x, 0.0, venia.y))





	var corre: String = "run_" + _dir_name_move(srv, Vector3(- signf(srv.position.x), 0.0, 0.0))
	if listo:
		srv.play(anim)
		srv.pause()
		srv.frame = 0
		srv.flip_h = false
		_anim_lock[srv] = Time.get_ticks_msec() + 60000







	var aro_dt: bool = false
	var t: float = 0.0
	if _saque_dt != null:
		aro_dt = _drive_ring != null and is_instance_valid(_drive_ring) and _drive_ring.visible
		if aro_dt:
			_drive_ring.visible = false
		if not await _saque_dt_prologo(srv, anim, oeste, gen, corre, yo, recibe):
			_saque_dt_aro_vuelve(aro_dt)
			return
		t = SAQUE_ANTES_S
	var fin_gesto: float = SAQUE_ANTES_S + float(SAQUE_SUELTA_I) / fps
	while true:
		var i: int = clampi(int(maxf(t - SAQUE_ANTES_S, 0.0) * fps), 0, SAQUE_SUELTA_I)
		if listo:
			srv.frame = i
		_ball.position = _saque_mano(srv, anim, i if listo else SAQUE_SUELTA_I, oeste)
		_ball.visible = true
		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
		_anim_usable(srv, corre)
		_anim_usable(yo, recibe)
		if t >= fin_gesto:
			break
		await get_tree().physics_frame
		if not _saque_sigue(gen):
			_saque_dt_aro_vuelve(aro_dt)
			return
		if can_process():
			t += get_physics_process_delta_time()
			_saque_vive(get_physics_process_delta_time(), _ball_field)


	var r: float = BALL_VISUAL_D * 0.5
	_saque_suelta = _ball.position
	var desde: Vector3 = _ball.position - Vector3(0.0, r, 0.0)
	var pies: Vector2 = Vector2(yo.position.x, yo.position.z)
	var frente: Vector2 = _ball_field - pies
	frente = Vector2(0.0, -1.0) if frente.length() < 0.05 else frente.normalized()
	var vn: Vector2 = venia.normalized() if venia.length() > 0.01 else Vector2(0.0, -1.0)




	var sitio: Vector2 = pies + vn * Duel.BALL_FOOT if _saque_orientado \
			else _ball_field + frente * Drive.trap_slop(Career.control_norm())
	var reposo: Vector3 = Vector3(sitio.x, r, sitio.y)


	var pecho_c: Vector3 = Vector3(lerpf(sitio.x, yo.position.x + vn.x * 0.22, 0.5),
		CHEST_TRAP_H, lerpf(sitio.y, yo.position.z + vn.y * 0.22, 0.5))
	var meta: Vector3 = Vector3(pecho_c.x, 0.0, pecho_c.z) if pecho \
			else Vector3(sitio.x, 0.0, sitio.y)
	var largo: float = Vector2(meta.x - desde.x, meta.z - desde.z).length()
	var res: Dictionary
	if pecho:

		res = _servicio_resuelve(desde, meta, "aire", clampf(largo / SAQUE_VH, 0.7, 1.4),
			CHEST_TRAP_H - r, 0.0, _cesped_bote, _cesped_drag)
	else:
		res = _servicio_resuelve(desde, meta, "bote",
			clampf((largo - SAQUE_PICA_M) / SAQUE_VH, 0.5, 1.4), SAQUE_PICA_M, 0.0,
			_cesped_bote, _cesped_drag)
	var ruta: Array = res.get("ruta", [])
	var k: int = int(res.get("k", -1))
	var cruce: Vector3 = res.get("cruce", meta)




	var viaje: PackedVector3Array = PackedVector3Array()
	var t_toca: float = 0.0
	var i_pecho: int = 0
	if pecho and k > 0 and k < ruta.size():
		while k > 1 and ((ruta[k - 1] as Vector3) + Vector3(0.0, r, 0.0)).distance_to(pecho_c) \
				< SAQUE_PECHO_CONTACTO_M:
			k -= 1
		cruce = ruta[k]
		var v_in: float = float(res.get("vh", SAQUE_VH))
		viaje = _pecho_trayectoria(cruce + Vector3(0.0, r, 0.0), pecho_c, reposo, vn, v_in,
			_recep_escape(v_in, Career.control_norm()))
		i_pecho = maxi(viaje.find(pecho_c), 0)
		t_toca = float(i_pecho) / 60.0
		_saque_pecho_c = pecho_c
	var gesto: bool = false
	var entra: bool = false
	var tv: float = 0.0
	var dt: float = 0.0
	var llega: float = float(k) * SIM_DT + t_toca
	var toca_i: int = CHEST_CUADRO_TOCA if pecho else CONTROL_CUADRO_TOCA
	var ctl_fps: float = 7.0 if pecho else 8.0




	var sitio0: Vector2 = sitio
	var off: Vector2 = Vector2.ZERO
	var muevo: bool = _saque_orientado
	var movido: bool = false
	while k > 0 and k < ruta.size():



		var fu: float = minf(tv / SIM_DT, float(k))
		var idx: int = mini(int(fu), k)
		var u: float = fu / float(k)
		var p_v: Vector3 = cruce if idx >= k else (ruta[idx] as Vector3).lerp(
			cruce if idx + 1 >= k else (ruta[idx + 1] as Vector3), fu - float(idx))
		_ball.position = p_v + Vector3(off.x * u, r, off.y * u)


		if not entra and tv >= 1.0 / fps:
			entra = true
			_anim_lock.erase(srv)
		if entra:

			_ondemand_deadline_us = maxi(_ondemand_deadline_us,
				Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
			_saque_trota(srv, dt)






		var lead: float = float(toca_i) / ctl_fps
		if muevo and _drive_vel.length() > SAQUE_CORRE_V:
			lead = 1.0 / ctl_fps
		if muevo and llega - tv <= lead:
			muevo = false

			_saque_v_llega = _drive_vel
			_saque_planta_yo(yo)
			if movido:
				venia = Vector2(_saque_suelta.x - yo.position.x, _saque_suelta.z - yo.position.z)
		if not gesto and not muevo and llega - tv <= lead:
			gesto = _saque_recibe(yo, venia, pecho,(llega - tv) if _saque_orientado else -1.0)
			if gesto:
				ctl_fps = maxf(yo.sprite_frames.get_animation_speed(yo.animation), 1.0)
		if idx >= k:
			break
		await get_tree().physics_frame
		if not _saque_sigue(gen):
			_saque_dt_aro_vuelve(aro_dt)
			return
		dt = get_physics_process_delta_time() if can_process() else 0.0
		tv += dt
		if muevo:
			_saque_corre(yo, dt)
			var yo2: Vector2 = Vector2(yo.position.x, yo.position.z)
			if yo2.distance_to(pies) > 0.01:
				movido = true

			var vn2: Vector2 = Vector2(_saque_suelta.x - yo2.x, _saque_suelta.z - yo2.y)
			vn2 = vn2.normalized() if vn2.length() > 0.01 else vn
			off = yo2 + vn2 * Duel.BALL_FOOT - sitio0
		_saque_vive(dt, sitio0 + off)
		if _saque_orientado:
			_saque_cam_sigue(dt, sitio0 + off)

	sitio = sitio0 + off
	reposo = Vector3(sitio.x, r, sitio.y)
	_saque_ultimo = _ball.position
	var tc: float = 0.0



	var arranca: bool = false
	if pecho and viaje.size() > 1:
		if off.length_squared() > 0.0:
			var o3: Vector3 = Vector3(off.x, 0.0, off.y)
			for j in viaje.size():
				viaje[j] = viaje[j] + o3
			pecho_c += o3
			_saque_pecho_c = pecho_c


		var dur: float = float(viaje.size() - 1) / 60.0
		while true:
			_pecho_muestra(tc / dur, viaje)
			if tc >= dur:
				break
			await get_tree().physics_frame
			if not _saque_sigue(gen):
				_saque_dt_aro_vuelve(aro_dt)
				return
			dt = get_physics_process_delta_time() if can_process() else 0.0
			tc += dt
			if entra:
				_saque_trota(srv, dt)
			if not gesto:
				gesto = _saque_recibe(yo, venia, pecho,
					maxf(t_toca - tc, 0.0) if _saque_orientado else -1.0)
			_saque_vive(dt, sitio)
			if _saque_orientado:
				_saque_cam_sigue(dt, sitio)


			if _saque_orientado and _saque_dedo != -1 and tc >= t_toca:
				arranca = true
				var jc: int = clampi(int(tc * 60.0), 0, viaje.size() - 2)
				_saque_caida_vy =(viaje[jc + 1].y - viaje[jc].y) * 60.0
				break
		_saque_ultimo = viaje[viaje.size() - 2]
	elif not _saque_orientado:


		var rapidez: float = maxf(float(res.get("vh", SAQUE_VH)), 4.0)
		var t_pie: float = clampf(4.0 * _ball.position.distance_to(reposo) / rapidez, 0.12, 0.4)
		var tw: Tween = create_tween()
		tw.tween_property(_ball, "position", reposo, t_pie) \
				.set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_OUT)
		while tc < t_pie:
			await get_tree().physics_frame
			if not _saque_sigue(gen):
				tw.kill()
				_saque_dt_aro_vuelve(aro_dt)
				return
			dt = get_physics_process_delta_time() if can_process() else 0.0
			tc += dt
			if entra:
				_saque_trota(srv, dt)
			if not gesto:
				gesto = _saque_recibe(yo, venia, pecho)
			_saque_vive(dt, sitio)
		tw.kill()
	elif _saque_dedo != -1:
		arranca = true


	if arranca:
		sitio = Vector2(_ball.position.x, _ball.position.z)
		reposo = Vector3(sitio.x, r, sitio.y)
	elif not gesto and _saque_orientado:


		gesto = _saque_recibe(yo, venia, pecho, 0.0)
	_ball_field = sitio
	_saque_control = reposo




	if _saque_orientado:
		_saque_caida_h = maxf(_ball.position.y - r, 0.0)
		if not (arranca and pecho):
			_saque_caida_vy = 0.0
		reposo.y = r + _saque_caida_h
	_ball.position = reposo


	_trap_enabled = false
	_trap_active = false
	_strike_motion = {}
	_header_chance = false
	if _saque_orientado:



		_drive_lock_t = 0.0
		_saque_respiro_t = SAQUE_RESPIRO_S
		_saque_mando = false
		if arranca:
			_saque_arranca(yo)
		else:
			_saque_lenta_off = true
			_drive_steer = Vector2.ZERO
			_drive_vel = Vector2.ZERO
		_saque_dedo = -1
	else:
		_drive_lock_t = Drive.trap_lock(Career.control_norm())
	_saque_dt_aro_vuelve(aro_dt)

	_anim_lock.erase(srv)
	_pasador_arranca(srv, yo, Offer.APOYO)



	var dice: String = "saque_pecho" if pecho else "saque_corto"
	if _saque_orientado:
		SceneFade.timer(SAQUE_DICE_S, false).timeout.connect(
			_saque_dice.bind(dice, _saque_gen))
	else:
		_say(dice)




