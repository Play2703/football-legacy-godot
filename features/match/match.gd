func _keeper_dive_arc(anim: String, duration: float, paint: String = "") -> void:
	if paint.is_empty():
		paint = anim


	var base_y: float = _keeper_base_y
	_keeper.position.y = base_y
	_keeper_sunk_anim = ""
	if _keeper_arc_tw and _keeper_arc_tw.is_valid():
		_keeper_arc_tw.kill()


	var hop: float = SAVE_HOP_HIGH if (anim == "dive_high" or anim == "jump") \
			else SAVE_HOP_LOW


	if paint.begins_with("pie_"):
		hop = 0.0


	elif paint == "parada_caida":
		hop *= 0.5
	hop *= lerpf(0.75, 1.15, clampf(duration / 0.8, 0.0, 1.0))
	var t_up: float = duration * SAVE_HOP_UP_F
	var t_down: float = duration *(1.0 - SAVE_HOP_UP_F) + SAVE_LAND_EXTRA




	var floor_y: float = base_y - _save_land_air(_save_land_key(paint))
	var arc: Tween = create_tween()
	_keeper_arc_tw = arc
	arc.tween_property(_keeper, "position:y", base_y + hop, t_up) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	arc.tween_property(_keeper, "position:y", floor_y, t_down) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)



	arc.tween_callback(_keeper_land.bind(paint))





