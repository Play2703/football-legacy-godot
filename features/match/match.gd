func _keeper_return_step(delta: float) -> void:




	if _keeper_down_left() > 0.0:
		return




	if _keeper_lancing():
		return
	var want_kx: float = _keeper_spot(_ball_field).x
	var kh: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)
	if absf(kh.y - _keeper_home_z()) > 0.35:
		var back: Array = Duel.step_defender(kh, _keeper_out_vel,
			Vector2(want_kx, _keeper_home_z()), KEEPER_OUT_SPD_MIN, delta)
		_keeper_out_vel = back[1]
		kh = back[0]
		_keeper.position = Vector3(kh.x, _keeper.position.y, kh.y)
		_play_keeper_out(Vector3(_keeper_out_vel.x, 0.0, _keeper_out_vel.y))
		return
	_keeper_out_vel = Vector2.ZERO
	var antes: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)
	_keeper.position.x = lerpf(_keeper.position.x, want_kx, 1.0 - exp(-3.0 * delta))
	_keeper.position.z = lerpf(_keeper.position.z, _keeper_home_z(),
		1.0 - exp(-3.0 * delta))





























	var mov: Vector2 = Vector2(_keeper.position.x, _keeper.position.z) - antes
	var vel: float = mov.length() / delta if delta > 0.0 else 0.0
	if vel >= KEEPER_HOME_STEP_SLOW_MPS:
		_keeper_home_step_t = KEEPER_HOME_STEP_HOLD_S
	else:
		_keeper_home_step_t = maxf(0.0, _keeper_home_step_t - delta)
	if _keeper_home_step_t > 0.0:



		if vel >= KEEPER_HOME_STEP_SLOW_MPS:
			_keeper_home_step_dir = mov



		_play_keeper_out(Vector3(_keeper_home_step_dir.x, 0.0, _keeper_home_step_dir.y),
			true, true)
		return
	if _keeper.animation != "idle" and _keeper.sprite_frames.has_animation("idle"):
		_keeper.speed_scale = 1.0
		_keeper.play(_keeper_anim("idle"))










const KEEPER_OUT_CLOSE: float = 6.0



































































const KEEPER_LANCE_R: float = 1.9



const KEEPER_LANCE_T: float = 0.38




const KEEPER_LANCE_LEAD_MIN: float = 0.06
const KEEPER_LANCE_LEAD_MAX: float = 0.2







const KEEPER_LANCE_LEAD_MAX_M: float = 0.4














const KEEPER_LANCE_TRAVEL_MIN: float = 0.95
const KEEPER_LANCE_TRAVEL_MAX: float = 1.4





const KEEPER_LANCE_HOPE: float = 1.15



















const KEEPER_LANCE_REACH: float = 0.34




const KEEPER_LANCE_REACH_FROM: float = 0.35




const KEEPER_LANCE_CD: float = 2.2



const KEEPER_LANCE_MIN_PACE: float = 0.35






























const KEEPER_LANCE_NEAR_ME: float = 3.4



















const KEEPER_LANCE_FOUL_R: float = 0.62








































const KEEPER_DUEL_SPD_K: float = 1.25











const KEEPER_DUEL_LANCE_HOPE: float = 1.4




const KEEPER_DUEL_LANCE_MIN_PACE: float = 0.2




const KEEPER_DUEL_LANCE_CD: float = 1.3






























var _keeper_boost_off: bool = false

func _keeper_duel_boost() -> bool:
	return not _keeper_boost_off \
			and (_duel_active or _drive_active) and not _recu and not _duel_open





const KL_NADA: int = 0
const KL_VOLANDO: int = 1
const KL_LIMPIO: int = 2
const KL_FALTA: int = 3




var _klance_t: float = 0.0
var _klance_from: Vector2 = Vector2.ZERO
var _klance_to: Vector2 = Vector2.ZERO
var _klance_cd: float = 0.0




var _klance_manos: bool = true



var _klance_falta_ok: bool = false



var _klance_min_body: float = 99.0
var _klance_min_ball: float = 99.0





func _keeper_lance_reset() -> void:
	_klance_t = 0.0
	_klance_cd = 0.0
	_klance_from = Vector2.ZERO
	_klance_to = Vector2.ZERO
	_klance_manos = true
	_klance_falta_ok = false
	_klance_min_body = 99.0
	_klance_min_ball = 99.0




func _keeper_lancing() -> bool:
	return _klance_t > 0.0








func _keeper_lance_cancel() -> void:
	if _klance_t <= 0.0:
		return
	_klance_t = 0.0
	_klance_cd = KEEPER_DUEL_LANCE_CD if _keeper_duel_boost() else KEEPER_LANCE_CD






func _keeper_lance_bonus() -> float:
	if _klance_t <= 0.0:
		return 0.0
	if (1.0 - _klance_t / KEEPER_LANCE_T) < KEEPER_LANCE_REACH_FROM:
		return 0.0




	return KEEPER_LANCE_REACH if _klance_manos else LANCE_REACH





func _keeper_robo(kp: Vector2, control: float) -> bool:
	return kp.distance_to(_ball_field) \
			<= Duel.steal_radius(control, _keeper_skill) + _keeper_lance_bonus()





func _keeper_lance_point(kp: Vector2, mi_vel: Vector2, pace: float,
		mi_pos: Vector2 = Vector2.INF) -> Vector2:


	if not Settings.dif_steal_on():
		return Vector2.INF
	if _klance_t > 0.0 or _klance_cd > 0.0 or _keeper_down_left() > 0.0:
		return Vector2.INF
	if not is_instance_valid(_keeper) or _keeper.sprite_frames == null:
		return Vector2.INF




	if not _keeper_lance_art_ok(_in_penalty_box(kp, _keeper_goal_z)):
		return Vector2.INF
	var duelo_k: float = KEEPER_DUEL_SPD_K if _keeper_duel_boost() else 1.0
	if pace <(KEEPER_DUEL_LANCE_MIN_PACE if _keeper_duel_boost()
			else KEEPER_LANCE_MIN_PACE):
		return Vector2.INF


	if mi_pos != Vector2.INF and kp.distance_to(mi_pos) > KEEPER_LANCE_NEAR_ME:
		return Vector2.INF
	var d: float = kp.distance_to(_ball_field)




	if d > KEEPER_LANCE_R or d < Duel.STEAL_R_MAX:
		return Vector2.INF
	var q: float = clampf(_keeper_skill, 0.0, 1.0)


	var adelanto: Vector2 = mi_vel * lerpf(KEEPER_LANCE_LEAD_MIN, KEEPER_LANCE_LEAD_MAX, q)
	if adelanto.length() > KEEPER_LANCE_LEAD_MAX_M:
		adelanto = adelanto.normalized() * KEEPER_LANCE_LEAD_MAX_M
	var to: Vector2 = _ball_field + adelanto



	var travel: float = lerpf(KEEPER_LANCE_TRAVEL_MIN, KEEPER_LANCE_TRAVEL_MAX, q) * duelo_k
	var largo: float = kp.distance_to(to)
	if largo > travel *(KEEPER_DUEL_LANCE_HOPE if _keeper_duel_boost()
			else KEEPER_LANCE_HOPE):
		return Vector2.INF
	if largo > travel and largo > 0.001:


		to = kp +(to - kp) / largo * travel




	var fuera: Vector2 = to - _ball_field
	if fuera.length() > KEEPER_LANCE_LEAD_MAX_M:
		to = _ball_field + fuera.normalized() * KEEPER_LANCE_LEAD_MAX_M
	return to




func _keeper_lance_begin(kp: Vector2, to: Vector2, mi_pos: Vector2) -> void:
	_klance_t = KEEPER_LANCE_T
	_klance_from = kp
	_klance_to = to

	_klance_manos = _in_penalty_box(kp, _keeper_goal_z)


	_klance_falta_ok = kp.distance_to(mi_pos) > KEEPER_LANCE_FOUL_R
	_klance_min_body = 99.0
	_klance_min_ball = 99.0



	_keeper_out_vel = Vector2.ZERO
	_play_keeper_lance(to)






func _keeper_lance_step(delta: float, mi_pos: Vector2,
		control_ball: float = Duel.NEUTRAL_CONTROL) -> int:
	_klance_cd = maxf(_klance_cd - delta, 0.0)
	if _klance_t <= 0.0:
		return KL_NADA
	if not is_instance_valid(_keeper):
		_keeper_lance_reset()
		return KL_NADA
	var t: float = _klance_t - delta
	var u: float = clampf(1.0 - maxf(t, 0.0) / KEEPER_LANCE_T, 0.0, 1.0)
	var np: Vector2 = _inside_field(_klance_from.lerp(_klance_to, u))
	_keeper.position = Vector3(np.x, _keeper.position.y, np.y)




	_klance_min_body = minf(_klance_min_body, np.distance_to(mi_pos))
	_klance_min_ball = minf(_klance_min_ball, np.distance_to(_ball_field))
	if t > 0.0:
		_klance_t = t
		return KL_VOLANDO



	_klance_t = 0.0
	_klance_cd = KEEPER_DUEL_LANCE_CD if _keeper_duel_boost() else KEEPER_LANCE_CD



	if not _klance_manos:
		_slide_dir = Vector2.ZERO
	_keeper_knock_down(_klance_from.distance_to(_klance_to))





	if _klance_falta_ok and _klance_min_body <= KEEPER_LANCE_FOUL_R \
			and _klance_min_ball > Duel.steal_radius(control_ball, _keeper_skill) \
			+ KEEPER_LANCE_REACH:
		return KL_FALTA



	_haptic(20)
	return KL_LIMPIO






func _keeper_lance_art_ok(manos: bool) -> bool:
	if _keeper.sprite_frames == null:
		return false
	if manos:
		return _keeper.sprite_frames.has_animation("dive")
	for d in ANIM_DIRS:
		if not _keeper.sprite_frames.has_animation("slide_" + d):
			return false
	return true
















func _play_keeper_lance(to: Vector2) -> void:
	if not is_instance_valid(_keeper) or _keeper.sprite_frames == null:
		return
	if _keeper_tween and _keeper_tween.is_valid():
		_keeper_tween.kill()
	var kp: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)
	var hacia: Vector2 = to - kp
	if not _klance_manos:






		_slide_dir = Vector2.ZERO



		if not _play_dir_gesture(_keeper, "slide", hacia, int(KEEPER_LANCE_T * 1000.0)):
			return
		if hacia.length() > 0.001:
			_slide_dir = hacia.normalized()



		if _fx != null and _stadium != null:
			var meta: Vector2 = _inside_field(to)
			_fx.slide_scar(_keeper.position,
				Vector3(meta.x, _keeper.position.y, meta.y), SLIDE_SCAR_W,
				WeatherWear.scar_color(_stadium.weather_id()), KEEPER_LANCE_T)
		_splash_at(kp, Vector3(hacia.x, 0.0, hacia.y), 20.0)
		_keeper_triggered = true
		return

	_keeper.flip_h = to.x < _keeper.position.x
	_keeper.speed_scale = clampf(_anim_secs("dive") / KEEPER_LANCE_T, 0.6, 2.0)
	_keeper.play(_keeper_anim("dive"))
	_ensucia(_keeper)


	_keeper_dive_arc("dive", KEEPER_LANCE_T)


	_keeper_triggered = true










func _keeper_lance_foul(duelo: bool) -> void:
