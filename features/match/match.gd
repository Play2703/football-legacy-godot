func _shootout_hero(won: bool, last_mine: bool, last_scored: bool,
		scorer: Dictionary, was_you: bool, a: int, b: int) -> Dictionary:
	var winner_id: String = _my_side_id() if won \
			else String(GameState.current_rival().get("id", ""))
	var hero: Dictionary = {
		"kind": "taker", "name": "", "number": 0,


		"mine": won, "you": false, "save": false,





		"score": "%d-%d" % [a, b],
		"for": a, "against": b,
	}



	if last_mine != won and not last_scored:
		var k: Dictionary = Squad.keeper(winner_id)
		hero["kind"] = "keeper"
		hero["name"] = String(k.get("name", ""))
		hero["number"] = int(k.get("number", 1))
		hero["save"] = _shootout_last_outcome == "save"
		return hero



	if scorer.is_empty():
		var kk: Dictionary = Squad.keeper(winner_id)
		hero["kind"] = "keeper"
		hero["name"] = String(kk.get("name", ""))
		hero["number"] = int(kk.get("number", 1))
		return hero
