func _robo_area_conduce(barrio: int) -> AnimatedSprite3D:
	if not _robo_area_abierto():
		return null
	if not _in_penalty_box(_ball_field, OWN_GOAL_Z):
		return null
	var ladron: AnimatedSprite3D = _rival_actors[barrio] if barrio >= 0 \
			and barrio < _rival_actors.size() else null
	var ahora: int = Time.get_ticks_msec()
	var mejor: AnimatedSprite3D = null
	var mejor_d: float = ROBO_AREA_TIRADOR_R
	for r in _rival_actors:
		if r == ladron or not _robo_area_de_campo(r):
			continue

		if int(r.get_meta("caido_t", 0)) > ahora:
			continue
		var d: float = Vector2(r.position.x, r.position.z).distance_to(_ball_field)
		if d <= mejor_d:
			mejor_d = d
			mejor = r
	if mejor == null and _robo_area_de_campo(ladron):
		return ladron
	return mejor











func _robo_area_compas(tirador: AnimatedSprite3D) -> void:
	_robo_area_tok += 1
	state = State.PASSING
	var espera: float = 0.0
	if _anim_lock.has(tirador):
		espera = clampf(float(int(_anim_lock[tirador]) - Time.get_ticks_msec()) / 1000.0,
			0.0, ROBO_AREA_LEVANTA_MAX)
	if espera > 0.0:
		SceneFade.timer(espera, false).timeout.connect(
			_robo_area_carrera.bind(_robo_area_tok, tirador))
	else:
		_robo_area_carrera(_robo_area_tok, tirador)




func _robo_area_carrera(tok: int, tirador) -> void:
	if tok != _robo_area_tok or state != State.PASSING:
		return
	if not is_instance_valid(tirador):
		_resolve_chance("dribble_lost")
		return
	var bal: Vector2 = _ball_field

	var al_arco: Vector2 = Vector2(0.0, OWN_GOAL_Z) - bal
	var sitio: Vector2 = bal - al_arco.normalized() * 0.6 if al_arco.length() > 0.01 else bal
	var desde: Vector2 = Vector2(tirador.position.x, tirador.position.z)
	var t: float = clampf(desde.distance_to(sitio) / ROBO_AREA_CARRERA_V,
		ROBO_AREA_COMPAS_MIN, ROBO_AREA_COMPAS_MAX)
	if desde.distance_to(sitio) > 0.05:
		_play_run(tirador, Vector3(sitio.x - desde.x, 0.0, sitio.y - desde.y))
		create_tween().tween_property(tirador, "position",
			Vector3(sitio.x, tirador.position.y, sitio.y), t)
	SceneFade.timer(t, false).timeout.connect(
		_robo_area_compas_fin.bind(tok, tirador))




func _robo_area_compas_fin(tok: int, tirador) -> void:
	if tok != _robo_area_tok or state != State.PASSING:
		return
	if not is_instance_valid(tirador):
		_resolve_chance("dribble_lost")
		return

	if _despeje_tw != null and _despeje_tw.is_valid():
		_despeje_tw.kill()
	var bp: Vector3 = _ball.position
	_robo_area_dispara(Vector3(bp.x, 0.0, bp.z), tirador)




