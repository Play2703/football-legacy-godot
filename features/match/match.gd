func _parado_servido(chance: Dictionary) -> Dictionary:
	if not parado_servido_en_carrera or not _practice_kind.is_empty():
		return {}
	var tipo: String = _parado_tipo(String(chance.get("kind", "")))
	if tipo.is_empty() or _parado_played >= PARADO_TOPE_PARTIDO:
		return {}
	if randf() >= PARADO_SERVIDO_P:
		return {}
	var b: Vector2 = chance.get("ball", Vector2.ZERO)
	var side: float = signf(b.x) if absf(b.x) > 1.0 else (1.0 if randf() < 0.5 else -1.0)
	var gesto: String = _parado_gesto()
	var arma: Dictionary = _parado_arma(tipo, side, gesto, b)
	if arma.is_empty():
		return {}
	var sc: Dictionary = _servicio_chance("", false, false, arma)
	if _repeats_lado(sc):
		return {}
	_parado_played += 1
	_servicio_played += 1
	_last_chance_name = String(SERVICIO_KIND_DE.get(gesto, Practice.SERVICIO))
	_remember_lado(sc)
	return sc



static func _parado_tipo(kind: String) -> String:
	if kind == "corner":
		return "corner"
	if kind == "libre" or kind == "indirecta":
		return "libre"
	return ""



func _parado_gesto() -> String:
	var mult: Dictionary = SERVICIO_MULT_POR_PUESTO.get(_puesto_juego, {})
	var total: float = 0.0
	for g in PARADO_GESTO_P:
		total += float(PARADO_GESTO_P[g]) * float(mult.get(g, 1.0))
	var r: float = randf() * total
	for g in PARADO_GESTO_P:
		r -= float(PARADO_GESTO_P[g]) * float(mult.get(g, 1.0))
		if r <= 0.0:
			return String(g)
	return "cabeza"






func _parado_arma(tipo: String, side: float, gesto: String, spot: Vector2 = Vector2.ZERO) -> Dictionary:
	var filas: Array = PARADO_FILAS.filter(func(f: Dictionary) -> bool:
		return String(f["parado"]) == tipo and _servicio_gesto_fila(f) == gesto)
	if filas.is_empty():
		return {}
	var fila: Dictionary = filas[randi() % filas.size()]
	var srv: Vector2
	if tipo == "corner":
		srv = spot if absf(spot.x) > Stadium.FIELD_HALF_W - 2.0 and spot.y < 2.0 \
				else Vector2(side * PARADO_CORNER.x, PARADO_CORNER.y)
	else:
		srv = Vector2(side * randf_range(PARADO_LIBRE_X.x, PARADO_LIBRE_X.y),
			randf_range(PARADO_LIBRE_Z.x, PARADO_LIBRE_Z.y))
	var lado: float = signf(srv.x)
	var zonas: Array = SERVICIO_ZONAS.filter(func(z: Dictionary) -> bool:
		return (fila["zonas"] as Array).has(String(z["id"])))
	for _i in PARADO_INTENTOS:
		var z: Dictionary = _weighted_row(zonas)
		var zx: Vector2 = z["x"]
		var zz: Vector2 = z["z"]
		var s_x: float = lado if randf() < PARADO_CERCA_P else - lado
		var ball := Vector2(randf_range(zx.x, zx.y) * s_x, randf_range(zz.x, zz.y))
		if _parado_cabe(srv, ball):
			return {"tipo": tipo, "srv": srv, "ball": ball, "fila": fila, "zona": z}
	return {}



static func _parado_cabe(srv: Vector2, ball: Vector2) -> bool:
	var d: float = srv.distance_to(ball)
	return d >= PARADO_D.x and d <= PARADO_D.y \
			and srv.y - ball.y <= SERVICIO_SRV_BACK_MAX \
			and absf(srv.x - ball.x) >= PARADO_LADO_MIN









static func _parado_g(srv: Vector2, ball: Vector2, corte: float) -> Dictionary:
	var eje: Vector2 = ball - srv
	eje = eje.normalized() if eje.length() > 0.01 else Vector2(- signf(srv.x), 0.0)
	var mejor: Vector2 = Vector2.ZERO
	var peor: float = INF
	for signo in [corte, - corte]:
		var e: Vector2 = eje.rotated(deg_to_rad(PARADO_CARRERA_ANG) * float(signo))
		var arranque: Vector2 = srv - e * PARADO_CARRERA
		var fuera: float = maxf(absf(arranque.x) - Stadium.FIELD_HALF_W - PARADO_CARRERA_FUERA,
			0.0) + maxf(- PARADO_CARRERA_FUERA - arranque.y, 0.0)
		if fuera < peor - 0.01:
			peor = fuera
			mejor = e
	var inicio: Vector2 = srv - mejor * PARADO_CARRERA
	var hasta: Vector2 = srv - mejor * SERVICIO_DRIB_CERCA
	var tramos: Array = [[inicio, inicio, PARADO_QUIETO_T, 0.0, "quieto"],
		[inicio, hasta, PARADO_CARRERA_T, 0.0, "run"]]
	var puntos: Array[Vector2] = [inicio, hasta]
	return {
		"inicio": inicio, "giro": inicio, "hasta": hasta, "e1": mejor, "e2": mejor, "eje": eje,
		"pie": srv, "tipo": "parado", "tramos": tramos, "puntos": puntos,
		"dura": PARADO_QUIETO_T + PARADO_CARRERA_T,
		"lance": {}, "suelo": [], "sale2": Vector2.INF,
	}




func _parado_lanzador(fichas: Array) -> int:
	var quien: String = Career.set_piece_taker()
	for i in fichas.size():
		if String((fichas[i] as Dictionary).get("name", "")) == quien:
			_serve_srv_prev = quien
			return i
	return -1
















func _servicio_chance(gesto_baldosa: String = "", sortea: bool = false,
		saque: bool = false, parado: Dictionary = {}) -> Dictionary:


	var v: Dictionary = _servicio_variante(GameState.servicio_var)
	var z: Dictionary = _servicio_zona(GameState.servicio_zona)


	if saque:
		v = SAQUE_LARGO_FILA
		z = SAQUE_LARGO_ZONA


	if not parado.is_empty():
		v = parado["fila"]
		z = parado["zona"]




	if v.is_empty():












		var gesto: String = _servicio_gesto_pedido(GameState.servicio_var)
		var a_mano: bool = not gesto.is_empty()
		if gesto.is_empty():
			gesto = gesto_baldosa
		var del_gesto: Array = SERVICIO_VARIANTES.filter(func(f: Dictionary) -> bool:
			return gesto.is_empty() or _servicio_casa_gesto(f, gesto))
		if del_gesto.is_empty():
			del_gesto = SERVICIO_VARIANTES
		var aptas: Array = del_gesto.filter(func(f: Dictionary) -> bool:
			return z.is_empty() or _servicio_cabe(f, String(z["id"])))
		if aptas.is_empty() and not gesto.is_empty():
			z = {}
		var bombo: Array = aptas if not aptas.is_empty() else del_gesto




		if gesto.is_empty() or (sortea and not a_mano):
			v = _weighted_row(bombo)
		else:






			v = bombo[_serve_gesto_ronda % bombo.size()]
			_serve_gesto_ronda += 1
	if z.is_empty():
		var sitios: Array = SERVICIO_ZONAS.filter(func(f: Dictionary) -> bool:
			return _servicio_cabe(v, String(f["id"])))
		z = _weighted_row(sitios if not sitios.is_empty() else SERVICIO_ZONAS)
	var rango: Vector2 = v["speed"]
	var speed: float = randf_range(rango.x, rango.y)
	var lado_x: float = 1.0 if randf() < 0.5 else -1.0
	var zx: Vector2 = z["x"]
	var zz: Vector2 = z["z"]
	var ball := Vector2(randf_range(zx.x, zx.y) * lado_x, randf_range(zz.x, zz.y))
	if not parado.is_empty():
		ball = parado["ball"]

	var fuera: float = signf(ball.x) if absf(ball.x) > 0.01 else lado_x
	var s_srv: float = 1.0 if randf() < 0.5 else -1.0


	var hacia: int = int(v.get("hacia", z.get("hacia", 0)))
	match hacia:
		1:
			s_srv = fuera
		-1:
			s_srv = - fuera
	var ang: Vector2 = v.get("angulo", z["angulo"])

	var dd := Vector2(float(v.get("dmin", SERVICIO_SRV_D.x)), float(v.get("dmax", SERVICIO_SRV_D.y)))
	var d: float = randf_range(dd.x, dd.y)
	var a: float = deg_to_rad(randf_range(ang.x, ang.y))
	var srv := _servicio_srv_pos(ball, s_srv, d, a)





	if not v.has("srv_zona") and not saque and parado.is_empty():
		var mejor: Array = [srv, ball]
		var intentos: int = 0
		while _servicio_pase_absurdo(srv, ball) and intentos < SERVICIO_TIRO_INTENTOS:
			if _servicio_angulo_tiro(srv) - _servicio_angulo_tiro(ball) \
					< _servicio_angulo_tiro(mejor[0]) - _servicio_angulo_tiro(mejor[1]):
				mejor = [srv, ball]
			intentos += 1
			if srv.y < ball.y:
				a = PI - a
			else:
				if intentos > SERVICIO_TIRO_INTENTOS / 2:
					ball = Vector2(randf_range(zx.x, zx.y) * lado_x, randf_range(zz.x, zz.y))
					fuera = signf(ball.x) if absf(ball.x) > 0.01 else lado_x
					s_srv = fuera * float(hacia) if hacia != 0 else s_srv
				if hacia == 0:
					s_srv = 1.0 if randf() < 0.5 else -1.0
				d = randf_range(dd.x, dd.y)
				a = deg_to_rad(randf_range(ang.x, ang.y))
			srv = _servicio_srv_pos(ball, s_srv, d, a)
		if _servicio_pase_absurdo(srv, ball):
			srv = mejor[0]
			ball = mejor[1]






	if v.has("srv_zona"):
		var sz: Dictionary = v["srv_zona"]
		var sx: Vector2 = sz["x"]
		var szz: Vector2 = sz["z"]




		var lado: int = int(sz.get("lado", 1))
		var x_abs: float = randf_range(sx.x, sx.y)
		var s_x: float = fuera
		if lado < 0 or (lado == 0 and randf() < 0.5):
			var tope: float = d - absf(ball.x)
			if lado < 0 or tope >= sx.x:
				s_x = - fuera
				x_abs = minf(x_abs, maxf(tope, sx.x))


		var tu_x: float = ball.x * s_x
		if absf(x_abs - tu_x) < SERVICIO_CAL_LADO_MIN:
			var afuera: float = clampf(tu_x + SERVICIO_CAL_LADO_MIN, sx.x, sx.y)
			var adentro: float = clampf(tu_x - SERVICIO_CAL_LADO_MIN, sx.x, sx.y)
			x_abs = afuera if absf(afuera - tu_x) >= absf(adentro - tu_x) else adentro
		var x_srv: float = clampf(s_x * x_abs, - FIELD_EDGE, FIELD_EDGE)
		var dx: float = x_srv - ball.x
		var dz: float = sqrt(maxf(d * d - dx * dx, 0.0))
		srv = Vector2(x_srv, clampf(ball.y - dz, szz.x, minf(szz.y, FIELD_BACK)))



		if _servicio_pase_absurdo(srv, ball):
			x_srv = clampf(s_x * sx.y, - FIELD_EDGE, FIELD_EDGE)
			dx = x_srv - ball.x
			dz = sqrt(maxf(d * d - dx * dx, 0.0))
			srv = Vector2(x_srv, clampf(ball.y - dz, szz.x, minf(szz.y, FIELD_BACK)))


	if saque:
		srv = Vector2(fuera * SAQUE_CAL_X, clampf(ball.y
			+ randf_range(SAQUE_LARGO_DZ.x, SAQUE_LARGO_DZ.y), 3.0, FIELD_BACK))

	if not parado.is_empty():
		srv = parado["srv"]



	var dir: float = 1.0 if srv.x >= ball.x else -1.0
	var plan: Dictionary = _servicio_sortea_pase(v)
	plan["variante"] = String(v["name"])
	plan["zona"] = String(z["id"])
	plan["cabeza"] = bool(v.get("cabeza", false))
	plan["pecho"] = bool(v.get("pecho", false))
	plan["chilena"] = bool(v.get("chilena", false))









	plan["palomita"] = bool(plan["cabeza"]) and not bool(plan["chilena"]) and not saque \
			and randf() < SERVICIO_PALOMITA_P
	if bool(plan["palomita"]):
		plan["extra"] = randf_range(SERVICIO_PALOMITA_APOYO.x, SERVICIO_PALOMITA_APOYO.y)
	plan["srv"] = srv
	plan["ball"] = ball
	plan["speed"] = speed


	plan["saque"] = saque
	if saque:
		plan["objetivo"] = clampf(srv.distance_to(ball)
			/ randf_range(SAQUE_LARGO_VH.x, SAQUE_LARGO_VH.y),
			SAQUE_LARGO_VUELO.x, SAQUE_LARGO_VUELO.y)


	plan["parado"] = String(parado.get("tipo", ""))
	if not parado.is_empty():
		plan["objetivo"] = clampf(srv.distance_to(ball)
			/ randf_range(PARADO_VH.x, PARADO_VH.y), PARADO_VUELO.x, PARADO_VUELO.y)

	plan["corte"] = 1.0 if randf() < 0.5 else -1.0


	plan["regate"] = _servicio_sortea_regate()








	var reg: Dictionary = {}
	var sale: Vector2 = Vector2.ZERO
	var presion: bool = false

	if saque:
		plan["regate"] = "saque"
		reg = _saque_largo_g(srv, ball)


	elif not parado.is_empty():
		plan["regate"] = "parado"
		reg = _parado_g(srv, ball, float(plan["corte"]))
	else:
		for _lado in 2:
			reg = _servicio_regate(srv, ball, float(plan["corte"]), String(plan["regate"]))
			sale = Vector2(reg["giro"]) + Vector2(reg["e1"]) * SERVICIO_SALE_D
			sale = Vector2(clampf(sale.x, - FIELD_EDGE, FIELD_EDGE), clampf(sale.y, 3.0, FIELD_BACK))
			presion = _servicio_lejos_del_pase(sale, reg["pie"], ball) \
					and _servicio_lance_libre(reg, sale, ball)
			if presion or Dictionary(reg["lance"]).is_empty():
				break
			plan["corte"] = - float(plan["corte"])





		if not presion or String(plan["regate"]) == "avance":
			presion = false
			plan["regate"] = "avance"
			reg = _servicio_regate(srv, ball, float(plan["corte"]), "avance")
	var rivales: Array = _servicio_rivals(ball, reg["pie"])




	if v.has("pasillo"):
		rivales = rivales.slice(0, 1) + _servicio_pasillo(srv, ball, v["pasillo"])
	plan["presion"] = presion



	plan["dos"] = presion and String(plan["regate"]) == "a_dos"
	if presion:
		rivales.push_front(sale)
		if bool(plan["dos"]):
			rivales.insert(1, Vector2(reg["sale2"]))
	var mates: Array = _servicio_mates(ball, srv, rivales)



	plan["n_mates"] = 1 + mates.size()
	plan["n_rivales"] = rivales.size()
	var fichas: Array = _finishers_hoy()


	var k_srv: int = _parado_lanzador(fichas) if not parado.is_empty() else -1
	if k_srv < 0:
		k_srv = _servicio_elige_servidor(v, srv, fichas)
	var chance: Dictionary = {
		"kind": Practice.SERVICIO,
		"name": String(v["name"]),
		"ball": ball,


		"teammates": [srv] + mates,



		"mate_players": [],




		"defenders": rivales,
		"extras_rivals": [],
		"extras_rival_players": [],
		"extras_mates": [],




		"moving": {"kind": String(v["id"]), "dir": dir, "speed": speed},

		"servicio_var": String(v["id"]),
		"servicio_zona": String(z["id"]),
		"servicio": plan,

		"parado": String(parado.get("tipo", "")),
	}
	_servicio_rellena(chance, reg, presion)
	if k_srv >= 0:



		_recorta_cancha_mia(chance, fichas.size())
		var resto: Array = fichas.duplicate()
		resto.remove_at(k_srv)
		chance["mate_players"] = [fichas[k_srv]] + _recu_empareja(
			mates +(chance["extras_mates"] as Array), _recu_por_avance(resto), true)
	return chance















func _servicio_rellena(chance: Dictionary, reg: Dictionary, presion: bool) -> void:




	_last_press_roles.clear()
	if presion:
		_last_press_roles.append(0)
	_add_formation_extras(chance, chance["ball"], chance["teammates"], chance["defenders"])
	_servicio_despeja(chance, reg)
	_tutorial_despeja(chance)





const SERVICIO_FONDO_YO: float = 6.0



const SERVICIO_FONDO_PASES: int = 6








func _servicio_despeja(chance: Dictionary, reg: Dictionary) -> void:
	var ball: Vector2 = chance["ball"]
	var pie: Vector2 = reg["pie"]
	var tramos: Array = [[pie, ball]]
	var camino: Array = []
	for q in reg.get("puntos", []):
		camino.append(q as Vector2)
	camino.append(pie)
	for i in range(1, camino.size()):
		tramos.append([camino[i - 1], camino[i]])
	var fijos: Array =(chance["teammates"] as Array) +(chance["defenders"] as Array)
	var xr: Array = _servicio_aparta(chance["extras_rivals"], tramos, ball, fijos, - INF)
	chance["extras_rivals"] = xr
	var zs: Array[float] = [0.0]
	for r in (chance["defenders"] as Array) + xr:
		zs.append((r as Vector2).y)
	var linea: float = minf(_servicio_orsay_z(zs), ball.y) + ScenarioStore.ONSIDE_MARGIN
	chance["extras_mates"] = _servicio_aparta(chance["extras_mates"], tramos, ball,
		fijos + xr, linea)





func _servicio_aparta(ps: Array, tramos: Array, ball: Vector2, fijos: Array,
		suelo: float) -> Array:
	var fwd: Vector2 =(- ball).normalized() if ball.length() > 0.01 else Vector2(0.0, -1.0)
	var perp := Vector2(- fwd.y, fwd.x)
	var out: Array = []
	for p0 in ps:
		var p: Vector2 = p0
		for _k in SERVICIO_FONDO_PASES:
			var antes: Vector2 = p
			for tr in tramos:
				p = _servicio_fuera_del_tramo(p, tr[0], tr[1], SERVICIO_PASE_LIBRE)
			if p.distance_to(ball) < SERVICIO_FONDO_YO:
				var sale: Vector2 =(p - ball).normalized() if p.distance_to(ball) > 0.01 else - fwd
				p = ball + sale * SERVICIO_FONDO_YO
			var rel: Vector2 = p - ball
			var a: float = rel.dot(fwd)
			var l: float = rel.dot(perp)
			if a > 0.0 and a < ball.length() and absf(l) < EXTRA_LANE_HALF:
				p = ball + fwd * a + perp *(EXTRA_LANE_HALF *(1.0 if l >= 0.0 else -1.0))
			for q in fijos + out:
				p = _push_out(p, q, EXTRA_SEP)
			if suelo > - INF:
				p.y = maxf(p.y, suelo)
			p = Vector2(clampf(p.x, - FIELD_EDGE, FIELD_EDGE), clampf(p.y, 1.5, EXTRA_BACK))
			if p.distance_to(antes) < 0.01:
				break
		out.append(p)
	return out





static func _servicio_fuera_del_tramo(p: Vector2, a: Vector2, b: Vector2, r: float) -> Vector2:
	var seg: Vector2 = b - a
	var largo: float = seg.length_squared()
	var u: float = clampf((p - a).dot(seg) / largo, 0.0, 1.0) if largo > 0.0001 else 0.0
	var q: Vector2 = a + seg * u
	var d: Vector2 = p - q
	if d.length() >= r:
		return p
	var lejos: Vector2
	if d.length() > 0.01:
		lejos = d.normalized()
	else:
		lejos = Vector2(- seg.y, seg.x).normalized() if largo > 0.0001 else Vector2(0.0, 1.0)
		if lejos.y < 0.0:
			lejos = - lejos
	return q + lejos *(r + 0.05)





static func _servicio_sortea_pase(v: Dictionary) -> Dictionary:
	var perfil: String = String(v.get("perfil", "raso"))
	var objetivo: float = 0.0
	var extra: float = 0.0
	var pendiente: float = -1.0
	match perfil:
		"aire":
			var h: Vector2 = v["alto"]
			extra = randf_range(h.x, h.y)
			if v.has("pendiente"):
				var pd: Vector2 = v["pendiente"]
				pendiente = randf_range(pd.x, pd.y)
			else:
				var t: Vector2 = v["vuelo"]
				objetivo = randf_range(t.x, t.y)
		"bote":
			var t: Vector2 = v["vuelo"]
			var b: Vector2 = v["antes"]
			objetivo = randf_range(t.x, t.y)
			extra = randf_range(b.x, b.y)
		_:
			var l: Vector2 = v["vuelo"]
			objetivo = randf_range(l.x, l.y)
	var rosca: float = 0.0
	if v.has("rosca"):
		var r: Vector2 = v["rosca"]
		rosca = randf_range(r.x, r.y) *(1.0 if randf() < 0.5 else -1.0)
	var plan: Dictionary = {"perfil": perfil, "objetivo": objetivo, "extra": extra,
		"rosca": rosca}
	if pendiente >= 0.0:
		plan["pendiente"] = pendiente
	return plan


























const SERVICIO_SRV_PESO: Dictionary = {
	"EI": Vector2(5.0, 3.0), "ED": Vector2(5.0, 3.0),
	"LTI": Vector2(4.0, 1.0), "LTD": Vector2(4.0, 1.0),
	"MI": Vector2(4.0, 3.0), "MD": Vector2(4.0, 3.0),
	"CAM": Vector2(1.0, 5.0), "MC": Vector2(0.5, 4.0), "MCD": Vector2(0.2, 1.5),
	"DC": Vector2(0.5, 2.0), "DFC": Vector2(0.0, 0.2),
}

const SERVICIO_SRV_BANDA_X: float = 10.0
const SERVICIO_SRV_BANDA: float = 1.8


const SERVICIO_SRV_CALIDAD: Vector2 = Vector2(0.4, 2.0)
static var _serve_srv_prev: String = ""





func _servicio_elige_servidor(v: Dictionary, srv: Vector2, fichas: Array) -> int:
	if fichas.is_empty():
		return -1
	var centro: bool = v.has("srv_zona")
	var banda: int = 0
	if absf(srv.x) >= SERVICIO_SRV_BANDA_X:
		banda = 1 if srv.x > 0.0 else -1


	if is_same(v, SAQUE_LARGO_FILA):
		var puestos: Array = fichas.map(func(f: Dictionary) -> String:
			return String(f.get("pos", "")))
		var k_saque: int = saque_srv_de(puestos, banda)
		if k_saque >= 0:
			_serve_srv_prev = String((fichas[k_saque] as Dictionary).get("name", ""))
			return k_saque
	var pesos: Array[float] = []
	var total: float = 0.0
	for i in fichas.size():
		var f: Dictionary = fichas[i]
		var oficio: Vector2 = SERVICIO_SRV_PESO.get(String(f.get("pos", "")), Vector2(1.0, 1.0))
		var w: float = oficio.x if centro else oficio.y
		var q: float = float(f.get("rosca", 70)) / 70.0 if centro \
				else (float(f.get("punteria", 70)) + float(f.get("regate", 70))) / 140.0
		w *= clampf(q * q, SERVICIO_SRV_CALIDAD.x, SERVICIO_SRV_CALIDAD.y)


		var fl: int = _flanco(i, fichas)
		if banda != 0 and fl != 0:
			w *= SERVICIO_SRV_BANDA if fl == banda else 0.5
		if fichas.size() > 1 and String(f.get("name", "")) == _serve_srv_prev:
			w = 0.0
		pesos.append(w)
		total += w
	var elegido: int = 0
	if total > 0.0:
		var r: float = randf() * total
		for i in pesos.size():
			if pesos[i] <= 0.0:
				continue
			elegido = i
			r -= pesos[i]
			if r <= 0.0:
				break
	_serve_srv_prev = String((fichas[elegido] as Dictionary).get("name", ""))
	return elegido








func _servicio_mates(ball: Vector2, srv: Vector2, rivales: Array) -> Array:
	var s: float = signf(srv.x - ball.x) if absf(srv.x - ball.x) > 0.01 else 1.0
	if absf(ball.x) > 12.0:
		s = signf(ball.x)




	var zs: Array[float] = [0.0]
	for r in rivales:
		zs.append((r as Vector2).y)
	var linea: float = _servicio_orsay_z(zs)
	return [
		_servicio_onside(Vector2(clampf(ball.x - s * randf_range(9.0, 14.0), - FIELD_EDGE, FIELD_EDGE),
			clampf(ball.y + randf_range(-2.0, 3.0), 6.0, FIELD_BACK)), linea),
		_servicio_onside(Vector2(clampf(ball.x * 0.6 + randf_range(-5.0, 5.0), - FIELD_EDGE, FIELD_EDGE),
			clampf(ball.y - randf_range(5.0, 9.0), 5.0, FIELD_BACK)), linea),
	]




















const SERVICIO_RIVAL_FALLOS: int = 6


func _servicio_rivals(ball: Vector2, srv: Vector2) -> Array:
	var hondo: float = clampf((ball.y - 3.0) / 13.0, 0.35, 1.0)
	var fuera: Array = []
	var fallos: int = 0
	for _i in 72:
		if fuera.size() >= 3:
			break
		var n: int =(fuera.size() + floori(float(fallos) / SERVICIO_RIVAL_FALLOS)) % 3
		var cand: Vector2
		if n == 0:
			cand = Vector2(ball.x + randf_range(-5.0, 5.0), ball.y - randf_range(4.0, 7.0) * hondo)
		elif n == 1:
			cand = Vector2(ball.x + randf_range(-8.0, 8.0), ball.y - randf_range(8.0, 12.0) * hondo)
		else:
			cand = Vector2(ball.x + randf_range(5.0, 10.0) *(1.0 if randf() < 0.5 else -1.0),
				ball.y + randf_range(1.0, 4.0))
		var p := Vector2(clampf(cand.x, - FIELD_EDGE, FIELD_EDGE),
			clampf(cand.y, 3.0, FIELD_BACK))
		if _servicio_lejos_del_pase(p, srv, ball):
			fuera.append(p)
			fallos = 0
		else:
			fallos += 1
	return fuera






static func _servicio_pasillo(srv: Vector2, ball: Vector2, hueco: Vector2) -> Array:
	var eje: Vector2 = ball - srv
	var largo: float = eje.length()
	if largo < 0.01:
		return []
	eje /= largo
	var lado := Vector2(- eje.y, eje.x)
	var medio: Vector2 = srv + eje *(randf_range(0.45, 0.65) * largo)
	var h: float = randf_range(hueco.x, hueco.y) * 0.5
	var sesgo: float = randf_range(-0.3, 0.3)
	var uno: Vector2 = medio + lado *(h + sesgo)
	var otro: Vector2 = medio - lado *(h - sesgo)
	return [
		Vector2(clampf(uno.x, - FIELD_EDGE, FIELD_EDGE), clampf(uno.y, 3.0, FIELD_BACK)),
		Vector2(clampf(otro.x, - FIELD_EDGE, FIELD_EDGE), clampf(otro.y, 3.0, FIELD_BACK)),
	]









const SERVICIO_PASE_LIBRE: float = 2.5


func _servicio_lejos_del_pase(p: Vector2, srv: Vector2, ball: Vector2) -> bool:
	return _servicio_libre(p, srv, ball, SERVICIO_PASE_LIBRE)


static func _servicio_libre(p: Vector2, a: Vector2, b: Vector2, holgura: float) -> bool:
	var seg: Vector2 = b - a
	var largo: float = seg.length_squared()
	if largo < 0.01:
		return p.distance_to(a) >= holgura
	var u: float = clampf((p - a).dot(seg) / largo, 0.0, 1.0)
	return (a + seg * u).distance_to(p) >= holgura






