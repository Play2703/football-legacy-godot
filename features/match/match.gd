func _last_defender_z() -> float:
	var last_def_z: float = INF
	for r in _rival_actors:
		if is_instance_valid(r) and not r.has_meta("hold_wall") \
				and not r.has_meta("press_role"):
			last_def_z = minf(last_def_z, r.position.z)
