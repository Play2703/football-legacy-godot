func _recu_aparta_companeros(delta: float) -> void:
	if _recu_yo_suelo > 0.0:
		return
	var suavidad: float = 1.0 - pow(1.0 - Crowding.EASE, maxf(delta, 0.0) * 60.0)
	for a in _teammate_actors:
		if not is_instance_valid(a) or a == _self_actor or not a.visible:
			continue
		var i: int = _recu_def_act.find(a)
		if i >= 0 and i < _recu_def_suelo.size() and float(_recu_def_suelo[i]) > 0.0:
			continue
		var pos: Vector2 = Vector2(a.position.x, a.position.z)
		if pos.distance_squared_to(_recu_yo) >= Crowding.SEP * Crowding.SEP:
			continue
		var separado: Array = Crowding.relax([_recu_yo, pos], Crowding.SEP,
			suavidad, {0: true})
		var nuevo: Vector2 = _recu_corral(separado[1])
		a.position = Vector3(nuevo.x, a.position.y, nuevo.y)
		if i >= 0 and i < _recu_def_pos.size():
			_recu_def_pos[i] = nuevo


func _recu_refresca_presion() -> void:
	_recu_defs = []
	_recu_defs_vel = []
	if _recu_yo_suelo <= 0.0:
		_recu_defs.append(_recu_yo)
		_recu_defs_vel.append(_recu_yo_vel)
	for i in _recu_def_pos.size():
		if i < _recu_def_suelo.size() and float(_recu_def_suelo[i]) > 0.0:
			continue
		_recu_defs.append(_recu_def_pos[i])
		_recu_defs_vel.append(_recu_def_vel[i] if i < _recu_def_vel.size()
			else Vector2.ZERO)



func _update_recu(delta: float) -> void:
	if _recu_over:




		_recu_camera(delta)
		return
	_recu_t += delta















	if _recu_zanc_t > 0.0:
		_recu_zanc_t -= delta
		_recu_world_step(delta)
		_recu_camera(delta)
		if _recu_zanc_t <= 0.0:
			_recu_gira_ataque()
		return
	if not _recu_montado:
		return

















	_recu_refresca_presion()



	_recu_world_step(delta)


























	_recu_def_step(delta)













	var mi_spd: float = Duel.run_speed(_ctrl_speed_norm()) * _puddle_slow(_recu_yo)

	_recu_yo_bcd = maxf(_recu_yo_bcd - delta, 0.0)
	_recu_barrida_buena_t = maxf(_recu_barrida_buena_t - delta, 0.0)
	_recu_rival_suelo = maxf(_recu_rival_suelo - delta, 0.0)










	if _recu_rival_suelo > 0.0 and is_instance_valid(_recu_actor) \
			and not String(_recu_actor.animation).begins_with("fall"):
		_recu_tumba_portador(_recu_suelo_dir)
	if _recu_yo_suelo > 0.0:


		_recu_yo_suelo = maxf(_recu_yo_suelo - delta, 0.0)
		_recu_yo_vel = Vector2.ZERO
	elif _recu_yo_barr > 0.0:



		_recu_yo_barr = maxf(_recu_yo_barr - delta, 0.0)
		_recu_yo_vel = _recu_yo_bdir *(mi_spd * Recupera.BARRIDA_SPD
			* clampf(_recu_yo_barr / Recupera.BARRIDA_T, 0.0, 1.0))
		_recu_barre_resuelve()
		if _recu_over:
			return
		if _recu_yo_barr <= 0.0:
			_recu_yo_suelo = Recupera.BARRIDA_SUELO
	elif _duel_steer.length_squared() > 0.0001:
		var out: Array = Duel.step_sprint_cut(_recu_yo_vel, _duel_steer.normalized(),
			mi_spd, _ctrl_accel_norm(), _ctrl_control_norm(),
			_recu_armed, _recu_recov, delta)
		_recu_yo_vel = out[0]
		_recu_armed = out[1]
		_recu_recov = out[2]
	else:


		_recu_yo_vel = Vector2.ZERO
		_recu_armed = true
		_recu_recov = false
	_recu_yo = _recu_corral(_recu_yo + _recu_yo_vel * delta)



	if _recu_yo_vel.length() > 0.2:
		_duel_facing = _recu_yo_vel.normalized()
	if is_instance_valid(_self_actor):
		_self_actor.position = Vector3(_recu_yo.x, _self_actor.position.y, _recu_yo.y)
		if _recu_yo_barr > 0.0 or _recu_yo_suelo > 0.0:




















			if not String(_self_actor.animation).begins_with("slide"):
				_ondemand_deadline_us = maxi(_ondemand_deadline_us,
					Time.get_ticks_usec() + RECU_BARRIDA_BUDGET_US)
				_play_dir_gesture(_self_actor, "slide", _recu_yo_bdir,
					int((_recu_yo_barr + _recu_yo_suelo) * 1000.0))
		elif _recu_yo_vel.length() > 0.1:
			_self_actor.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
			_play_run(_self_actor, Vector3(_recu_yo_vel.x, 0.0, _recu_yo_vel.y))
		else:
			_face_ball(_self_actor)




	_recu_aparta_companeros(delta)
	_recu_refresca_presion()
	_recu_apoyo_step(delta)




	if not _recu_tiro and not _recu_pase and not _recu_suelta:













		if Recupera.quiere_tirar(_recu_pos, _recu_defs, Recupera.TARGET_Z,
				_keeper.position.x if is_instance_valid(_keeper) else 0.0,
				float(_recu_receta.get("tiro_umbral", Recupera.TIRO_UMBRAL)),
				float(_recu_receta.get("tiro_umbral_presion",
					Recupera.TIRO_UMBRAL_PRESION)),
				float(_recu_receta.get("tiro_r", Recupera.TIRO_R))
					*(1.0 +(_recu_car_pegada - 0.61) * 0.6)):
			_recu_dispara()
		else:
			_recu_decide_t -= delta




			if _recu_decide_t > 0.18 and Recupera.presionado(_recu_pos, _recu_defs):
				_recu_decide_t = 0.18
			if _recu_decide_t <= 0.0:
				_recu_decide_t = Recupera.PASE_RETHINK
				var i: int = Recupera.mejor_pase(_ball_field, _recu_ap_pos, _recu_defs,
					Recupera.TARGET_Z, _recu_ap_vel,
					float(_recu_receta.get("pase_umbral", Recupera.PASE_UMBRAL)),
					float(_recu_receta.get("pase_umbral_presion",
						Recupera.PASE_UMBRAL_PRESION)),
					float(_recu_receta.get("pase_gana_min", Recupera.PASE_GANA_MIN)),
					_keeper.position.x if is_instance_valid(_keeper) else 0.0,
					_recu_defs_vel, _recu_linea_fdj())
				if i >= 0:
					_recu_pasa(i)



	_recu_aviso_step()



	if _recu_tiro:
		var vuelo: Array = Recupera.rueda_golpe(_ball_field, _ball_vel, delta,
			_recu_spin)
		_ball_field = vuelo[0]
		_ball_vel = vuelo[1]


		_recu_red_contiene()
		_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)
		_ball_roll(_ball_vel)
		_recu_keeper_frame(delta)




		_recu_camera(delta)
		_recu_tiro_step()
		return


	if _recu_saque_vel != Vector2.ZERO:
		_recu_saque_step(delta)
		_recu_camera(delta)
		_move_drive_ring()
		_pulse_drive_ring()
		return
	if _recu_pase or _recu_suelta:


		_recu_suelto_step(delta)
		_recu_bola_step(delta)
		_recu_keeper_frame(delta)
		_recu_camera(delta)
		_move_drive_ring()
		_pulse_drive_ring()
		return








	var paso: Dictionary = {"p": _recu_pos, "v": _recu_vel, "armed": _recu_car_armed,
		"recov": _recu_car_recov, "arr_t": _recu_arranca_t, "cerca_prev": _recu_cerca_prev}
	_recu_portador_paso(paso, _recu_defs, mi_spd, delta)
	_recu_pos = paso["p"]
	_recu_vel = paso["v"]
	_recu_car_armed = paso["armed"]
	_recu_car_recov = paso["recov"]
	_recu_arranca_t = paso["arr_t"]
	_recu_cerca_prev = paso["cerca_prev"]
	_recu_ritmo = paso["ritmo"]
	_recu_lead = paso["lead"]
	if paso["cruza"]:




		if _recu_arranca_armada:
			_recu_arranca_armada = false
			_audio.toque(0.5)
	elif float(paso["cerca"]) < Recupera.ARRANCA_D - RECU_ARRANCA_REARMA:
		_recu_arranca_armada = true







	_recu_car_spd = mi_spd * Recupera.PACE_LIBRE.y * 1.15
	_ball_field = paso["bola"]
	_ball_vel = _recu_vel
	_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)
	if _ball_vel.length() > 0.05:
		_ball_roll(_ball_vel)
	if is_instance_valid(_recu_actor):
		_recu_actor.position = Vector3(_recu_pos.x, _recu_actor.position.y, _recu_pos.y)
		if _recu_vel.length() > 0.1:
			_recu_actor.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
			_play_run(_recu_actor, Vector3(_recu_vel.x, 0.0, _recu_vel.y))

	_move_drive_ring()
	_pulse_drive_ring()





	_recu_camera(delta)




	_recu_keeper_frame(delta)








	_recu_choque()








	if _recu_yo_barr <= 0.0 and _recu_yo_suelo <= 0.0 \
			and Recupera.roba(_recu_yo, _ball_field, Recupera.TARGET_Z, _recu_car_ctrl,
				Duel.NEUTRAL_TACKLE, _recu_pos):

		_recu_zancada_arranca()
		return
	if Recupera.llego(_ball_field.y, Recupera.TARGET_Z):





		if Recupera.es_gol(_ball_field.x):
			_recu_gol_canta()
			_recu_finish("gol")
		else:
			_recu_finish("llego")
		return







func _recu_dispara() -> void:
	if _recu_tiro or _recu_over:
		return
	_recu_tiro = true
	_recu_tirador = String((_recu_actor.get_meta("player", {}) as Dictionary)
		.get("name", "")) if is_instance_valid(_recu_actor) else ""

	_recu_por_tfly = -1.0





	_recu_net_hit = false



	var pt: float = 0.5
	if is_instance_valid(_recu_actor) and _recu_actor.has_meta("player"):
		pt = Squad.norm(_recu_actor.get_meta("player", {}), "punteria")
	var por_x: float = _keeper.position.x if is_instance_valid(_keeper) else 0.0


	var presion: bool = Recupera.presionado(_ball_field, _recu_defs)
	var destino: Vector2 = Recupera.tiro_destino(_ball_field, Recupera.TARGET_Z,
		por_x, pt, randf(), presion)






	var rosca: float = 0.0
	if is_instance_valid(_recu_actor) and _recu_actor.has_meta("player"):
		rosca = Squad.norm(_recu_actor.get_meta("player", {}), "rosca")
	_recu_spin = Recupera.tiro_comba(_ball_field, rosca, presion, randf(),
		randf_range(0.75, 1.0))


	_ball_vel = Recupera.tiro_vel(_ball_field, destino, presion, _recu_spin)




	_shot_drive = true
	_anticip_s = KEEPER_ANTICIP_DRIVE_S


	_shot_dist_m = Vector2(_ball_field.x, Recupera.TARGET_Z - _ball_field.y).length()
	_recu_vel = Vector2.ZERO
	if is_instance_valid(_recu_actor):






		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + RECU_BARRIDA_BUDGET_US)
		_play_dir_gesture(_recu_actor, "kick",
			_ball_vel.normalized(), ZANCADA_HOLD_MS)
	_audio.kick()
	_stadium.crowd_excite(0.8)



















func _recu_red_contiene() -> bool:
	if _ball_field.y <= Recupera.TARGET_Z:
		return false
	if absf(_ball_field.x) > Recupera.ARCO_HALF_W:
		return false
	var lim_x: float = maxf(Recupera.ARCO_HALF_W - BALL_R, 0.1)
	var fondo: float = Recupera.TARGET_Z + maxf(Stadium.NET_DEPTH - BALL_R, 0.2)





	var toca: bool = false
	if absf(_ball_field.x) > lim_x:
		_ball_field.x = clampf(_ball_field.x, - lim_x, lim_x)
		_ball_vel.x = 0.0
		toca = true
	if _ball_field.y > fondo:
		_ball_field.y = fondo
		_ball_vel.y = minf(_ball_vel.y, 0.0)
		toca = true
	if toca:
		_ball_vel *= RECU_RED_FRENO
		if not _recu_net_hit:
			_recu_net_hit = true
			_stadium.net_impact(Vector3(_ball_field.x, BALL_VISUAL_D * 0.5,
				_ball_field.y))
			_audio.net()
	return true




func _recu_tiro_step() -> void:

	if not _recu_tiro_fin.is_empty():
		_recu_tiro_espera -= get_process_delta_time()
		if _recu_tiro_espera <= 0.0:
			var por_que: String = _recu_tiro_fin
			_recu_tiro_fin = ""
			_recu_finish(por_que)
		return


	_recu_portero_vuela()
	if _ball_field.y >= Recupera.TARGET_Z:
		if not Recupera.es_gol(_ball_field.x):
			_recu_cobra_tiro("wide")
			_recu_tiro_cierra("fuera")
			return







		var t_fly: float = _recu_por_tfly if _recu_por_tfly >= 0.0 else RECU_POR_LEAD
		var alcance: float = _keeper_reach_left(_keeper.position.z, t_fly,
			Recupera.TARGET_Z - KEEPER_LINE_Z, -1.0)
		var dx: float = absf(_ball_field.x - _keeper.position.x)
		var tope: float = alcance * _pose_scale(t_fly)
		if alcance > 0.0 and dx <= tope:
			_recu_cobra_tiro("save")







			var holgura: float = 1.0 - dx / maxf(tope, 0.01)






			if holgura >= RECU_ATRAPA_HOLGURA:





				_recu_portero_devuelve(true)
			else:
				_recu_rechace(true)
			return
		_recu_tiro_cierra("gol")
		return


	if absf(_ball_field.x) > Recupera.EDGE_X:
		_recu_cobra_tiro("wide")
		_recu_tiro_cierra("fuera")
		return



	if _ball_vel.length() < 0.6:
		_recu_rechace()






func _recu_portero_vuela() -> void:
	if not is_instance_valid(_keeper) or not _recu_tiro_fin.is_empty():
		return
	if _keeper_down_until > Time.get_ticks_msec():
		return
	var falta: float = Recupera.TARGET_Z - _ball_field.y
	if falta <= 0.0 or _ball_vel.y <= 0.05:
		return
	var t_fly: float = falta / _ball_vel.y
	if t_fly > RECU_POR_LEAD:
		return

	_recu_por_tfly = t_fly







	var cruce_x: float = _ball_field.x + _ball_vel.x * t_fly
	var dx: float = cruce_x - _keeper.position.x
	if absf(dx) < 0.05:
		return


	var alcance: float = _keeper_reach_left(_keeper.position.z, t_fly,
		Recupera.TARGET_Z - KEEPER_LINE_Z, -1.0) * _pose_scale(t_fly)
	var destino_x: float = _keeper.position.x \
			+ signf(dx) * minf(absf(dx), maxf(alcance, 0.0))
	if _keeper_tween and _keeper_tween.is_valid():
		_keeper_tween.kill()


	_keeper.flip_h = dx < 0.0
	_keeper.play(_keeper_anim("dive"))
	_ensucia(_keeper)
	_keeper_tween = create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	_keeper_tween.tween_property(_keeper, "position:x", destino_x,
		clampf(t_fly, 0.12, 0.5))
	_keeper_down_until = Time.get_ticks_msec() + RECU_POR_MS
	_anim_lock[_keeper] = Time.get_ticks_msec() + RECU_POR_MS






func _recu_rechace(parada: bool = false) -> void:


	if _recu_tiro_fin == "gol":
		return
	_recu_tiro = false
	_recu_tiro_fin = ""
	_recu_suelta = true
	_recu_pase = false
	var v: float = maxf(_ball_vel.length() * 0.45, 4.0)
	var hacia: Vector2 = Vector2(signf(_ball_vel.x if absf(_ball_vel.x) > 0.2 else 1.0) * 0.55,
		- Recupera.DIR).normalized()
	_ball_vel = hacia * v


	_recu_pase_desde = _ball_field
	_recu_ultimo_toque = -1
	if parada:
		_audio.save(false)
	else:
		_audio.kick()
	_stadium.crowd_excite(0.6)



const RECU_SAQUE_V: float = 11.0







const SAQUE_MANO_FPS: float = 10.0


const SAQUE_MANO_CUADRO_SUELTA: int = 2




const RECU_SAQUE_TOPE: float = 1.6


const RECU_SAQUE_H_SUELO: float = 0.3
const RECU_SAQUE_H_MANO: float = 0.75


var _recu_saque_vel: Vector2 = Vector2.ZERO
var _recu_saque_t: float = 0.0
var _recu_saque_brazo: bool = false
var _recu_saque_brazo_t: float = 0.0










func _recu_portero_devuelve(parada: bool = false) -> void:



	if _recu_tiro_fin == "gol":
		return
	_recu_tiro = false
	_recu_tiro_fin = ""
	_recu_suelta = true
	_recu_pase = false



	if not parada:
		_play_keeper_smother()
	if is_instance_valid(_keeper):
		_ball_field = Vector2(_keeper.position.x, _keeper.position.z)
	var lado: float = - signf(_ball_field.x) if absf(_ball_field.x) > 0.5 \
			else (1.0 if randf() >= 0.5 else -1.0)



	_recu_saque_vel = Vector2(lado * 0.6, - Recupera.DIR).normalized() * RECU_SAQUE_V
	_recu_saque_t = 0.0
	_recu_saque_brazo = false
	_recu_saque_brazo_t = 0.0
	_ball_vel = Vector2.ZERO
	_recu_pase_desde = _ball_field
	_recu_ultimo_toque = -1









	if parada:
		_audio.save(true)
	_stadium.crowd_excite(0.5)







func _recu_saque_step(delta: float) -> void:
	_recu_saque_t += delta
	if not is_instance_valid(_keeper):
		_recu_saque_suelta()
		return
	var tirado: bool = Time.get_ticks_msec() < _keeper_down_until \
			or ((String(_keeper.animation).begins_with("dive")
			or String(_keeper.animation).begins_with("parada_")) and _keeper.is_playing())
	if not _recu_saque_brazo and (not tirado or _recu_saque_t >= RECU_SAQUE_TOPE * 0.5):
		_recu_saque_brazo = true
		if _keeper_tween and _keeper_tween.is_valid():
			_keeper_tween.kill()

		_keeper.flip_h = _recu_saque_vel.x < 0.0
		_keeper.speed_scale = 1.0
		_keeper.play(_keeper_anim("saque_mano"))



		_anim_lock[_keeper] = Time.get_ticks_msec() + int(5.0 / SAQUE_MANO_FPS * 1000.0)
	var brazo_listo: bool = false
	if _recu_saque_brazo:
		_recu_saque_brazo_t += delta
		brazo_listo =(String(_keeper.animation).begins_with("saque_mano")
				and _keeper.frame >= SAQUE_MANO_CUADRO_SUELTA) \
						or _recu_saque_brazo_t >=(SAQUE_MANO_CUADRO_SUELTA + 1) / SAQUE_MANO_FPS
	if brazo_listo or _recu_saque_t >= RECU_SAQUE_TOPE:
		_recu_saque_suelta()
		return


	var dir_sale: Vector2 = _recu_saque_vel.normalized()
	_ball_field = Vector2(_keeper.position.x, _keeper.position.z)
	_ball_vel = Vector2.ZERO
	_ball.position = Vector3(_ball_field.x + dir_sale.x * 0.3,
		RECU_SAQUE_H_MANO if _recu_saque_brazo else RECU_SAQUE_H_SUELO,
		_ball_field.y + dir_sale.y * 0.3)



func _recu_saque_suelta() -> void:
	if is_instance_valid(_keeper):
		_ball_field = Vector2(_keeper.position.x, _keeper.position.z)
	_ball_vel = _recu_saque_vel
	_recu_saque_vel = Vector2.ZERO
	_recu_pase_desde = _ball_field
	_recu_ultimo_toque = -1
	_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)





	if is_instance_valid(_keeper):
		_keeper_down_until = maxi(_keeper_down_until, Time.get_ticks_msec()
			+ int((5 - SAQUE_MANO_CUADRO_SUELTA) / SAQUE_MANO_FPS * 1000.0) + 100)
	_audio.kick()







func _recu_cobra_tiro(accion: String) -> void:
	if _recu_tirador.is_empty():
