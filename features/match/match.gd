const CEDIDA_MUERTA: Array[String] = ["goal", "own_goal", "wide", "over", "offside"]


func _cedida_rechace(out: String = "") -> bool:
	if _ball == null or not is_instance_valid(_ball) or not _ball.visible:
		return false














	if not out.is_empty() and CEDIDA_MUERTA.has(out):
		return false
	var meta: Vector2 = Vector2(_ball.position.x, _ball.position.z)
	if absf(meta.x) > Stadium.FIELD_HALF_W - 0.5 \
			or meta.y < 0.3 or meta.y > Stadium.FIELD_DEPTH - 1.0:
		return false



	var van: Array[AnimatedSprite3D] = []
	if _self_actor != null and is_instance_valid(_self_actor):
		_anim_lock.erase(_self_actor)
		van.append(_self_actor)





	van.append_array(_cedida_cercanos(_cedida_rivals, meta, CEDIDA_RECHACE_N))
	van.append_array(_cedida_cercanos(_cedida_mates, meta, CEDIDA_RECHACE_N))







	if _cedida_yo != null and is_instance_valid(_cedida_yo) and not _cobro_corre:
		van.append(_cedida_yo)
	for i in van.size():
		var a: AnimatedSprite3D = van[i]
		if not is_instance_valid(a):
			continue









		var ang: float = TAU * float(i) / float(maxi(van.size(), 1)) + randf() * 0.25
		var radio: float = CEDIDA_RECHACE_R * sqrt(maxf(float(van.size()), 4.0) / 4.0)
		var to: Vector3 = Vector3(
			clampf(meta.x + cos(ang) * radio, - Stadium.FIELD_HALF_W + 1.0,
				Stadium.FIELD_HALF_W - 1.0),
			a.position.y,
			maxf(meta.y + sin(ang) * radio, 0.6))
		_run_target[a] = to
		var dur: float = maxf(_flat_dist(a.position, to) / _cedida_spd(a), 0.35)
		_celeb_seal_run(a, dur)
		_play_run(a, to - a.position)
		var tw: Tween = create_tween()
		tw.tween_property(a, "position", to, dur)




		tw.tween_callback(_celeb_still.bind(a))
		_celeb_runs.append(tw)





	if not _cobro_corre:
		_look_target = _ball
	return true



