			par.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
			_actors.add_child(par)
			fila["par"] = par
			actor.set_meta("lam_par", par_tex)



	var marca: Texture2D = SponsorLogos.for_team(
		String(_club_de(is_rival).get("id", "")), epoca)









	if marca != null and not cfg.has("bib") and not cfg.has("crest_flag"):
		var tenida: Texture2D = Pecho.marca_para(marca, cfg, "pat")
		var pat: Sprite3D = Pecho.nodo(tenida)
		_actors.add_child(pat)
		fila["pat"] = pat

		actor.set_meta("lam_pat", tenida)




	var fab_tex: Texture2D = KitBrands.for_team(
		String(_club_de(is_rival).get("id", "")), epoca, int(cfg.get("kit_slot", 0)))
	if fab_tex != null:
		var fab_tenida: Texture2D = Pecho.marca_para(fab_tex, cfg, "fab")
		var fab: Sprite3D = Pecho.nodo(fab_tenida)
		_actors.add_child(fab)
		fila["fab"] = fab
		actor.set_meta("lam_fab", fab_tenida)



	var cmp_tex: Texture2D = Pecho.campeon_textura(cfg,
		String(_club_de(is_rival).get("id", "")))
	if cmp_tex != null:
		var cmp: Sprite3D = Pecho.nodo(cmp_tex)
		cmp.alpha_scissor_threshold = 0.12
		_actors.add_child(cmp)
		fila["cmp"] = cmp
		actor.set_meta("lam_cmp", cmp_tex)




	var man_tex: Texture2D = SleevePatch.textura(cfg)
	if man_tex != null:
		var man: Sprite3D = Pecho.nodo(man_tex)




		man.alpha_scissor_threshold = 0.12
		_actors.add_child(man)
		fila["man"] = man
		actor.set_meta("lam_man", man_tex)


		SleevePatch.calienta(actor.sprite_frames)




	if fila.is_empty():
		return
	_pecho[actor] = fila





















func _revestir_actor(actor: AnimatedSprite3D, tex: Texture2D, cfg: Dictionary,
		is_rival: bool = false) -> void:
