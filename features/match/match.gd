static func fan_photo_ok(kind: String, minuto: int, fixture: Dictionary,
		div: int, ya_visto: bool, practica: String, readonly: bool) -> bool:

	if not practica.is_empty() or readonly:
		return false
	if not FAN_PHOTO_KINDS.has(kind):
		return false
	if minuto < FAN_PHOTO_MIN_MINUTE or minuto > FAN_PHOTO_MAX_MINUTE:
		return false
	if String(fixture.get("round", "")) != FAN_PHOTO_ROUND:
		return false
	if not FAN_PHOTO_COMPS.has(String(fixture.get("comp", ""))):
		return false



	if div != 1:
		return false
	return not ya_visto




func _fan_photo_gate(chance: Dictionary) -> bool:
	if _stadium == null or _self_actor == null or not is_instance_valid(_self_actor):
		return false



	if _force_fan_photo:
		return true
	if _tutorial_active:
		return false





	if String(chance.get("kind", "")) == META_KIND:
		return false



	if not fan_photo_ok(_kind_juego(String(chance.get("kind", ""))), match_minute,
			GameState.current_fixture(), GameState.player_div(),
			Career.fan_photo_seen, _practice_kind, GameState.readonly_save):
		return false
	if _fan_photo_rng == null:
		_fan_photo_rng = RandomNumberGenerator.new()
		_fan_photo_rng.randomize()
	return _fan_photo_rng.randf() < FAN_PHOTO_P




























func _fan_frames(cfg: Dictionary) -> SpriteFrames:
	var frames: SpriteFrames = SpriteFrames.new()
	var falto: bool = false
	for d in ["south", "west", "east"]:
		var anim: String = "idle" if d == "south" else "idle_" + d
		frames.add_animation(anim)
		frames.set_animation_loop(anim, true)
		var t: Texture2D = load("res://assets/sprites/anim/afi_idle_%s.png" % d) as Texture2D
		if t == null:
			falto = true
		else:
			frames.add_frame(anim, KitRecolor.apply(t, cfg))
	for d in ["west", "east"]:
		var anim2: String = "walk_" + d
		frames.add_animation(anim2)
		frames.set_animation_speed(anim2, 9.0)
		frames.set_animation_loop(anim2, true)


		var anim3: String = "run_" + d
		frames.add_animation(anim3)
		frames.set_animation_speed(anim3, 13.0)
		frames.set_animation_loop(anim3, true)
		for i in range(1, 9):
			var tw2: Texture2D = load("res://assets/sprites/anim/afi_walk_%s_%02d.png"
				% [d, i]) as Texture2D
			if tw2 == null:
				falto = true
				continue
			var pintada: Texture2D = KitRecolor.apply(tw2, cfg)
			frames.add_frame(anim2, pintada)
			frames.add_frame(anim3, pintada)


	frames.add_animation("derribado")
	frames.set_animation_speed("derribado", 12.0)
	frames.set_animation_loop("derribado", false)
	for i in range(1, 9):
		var td: Texture2D = load("res://assets/sprites/anim/afi_derribado_south_%02d.png"
			% i) as Texture2D
		if td == null:
			break
		frames.add_frame("derribado", KitRecolor.apply(td, cfg))
	frames.add_animation("celular")
	frames.set_animation_speed("celular", FAN_CEL_FPS)
	frames.set_animation_loop("celular", false)
	for i in range(1, FAN_CEL_MAX + 1):


		var ruta_c: String = "res://assets/sprites/anim/afi_celular_south_%02d.png" % i
		if not ResourceLoader.exists(ruta_c):
			break
		var tc: Texture2D = load(ruta_c) as Texture2D
		if tc == null:
			break
		frames.add_frame("celular", KitRecolor.apply(tc, cfg))
	if falto or frames.get_frame_count("celular") == 0:
		return null
	return frames




