	if _beer_fan == null:
		return














	SceneFade.timer(float(BEER_LEAD) * SIM_DT + BEER_LIFE_S + BEER_SAFETY_PAD,
		false).timeout.connect(_end_beer_gag.bind(_beer_fan))





func _spill_the_beer() -> void:
	if not is_instance_valid(_beer_fan):
		return



	Achievements.ingest_beer_spill()



	var fan: AnimatedSprite3D = SceneFade.vivo(_beer_fan.get_meta("fan", null)) as AnimatedSprite3D



	var bot: Node3D = SceneFade.vivo(_beer_fan.get_meta("botella", null)) as Node3D


	if is_instance_valid(fan) and fan.sprite_frames != null \
			and fan.sprite_frames.has_animation("sad"):
		fan.play("sad")





	var mano: Vector3 = _beer_fan.global_position
	if is_instance_valid(bot):
		mano = bot.global_position



	var fuera: Vector3 = Vector3(- mano.x, 0.0, - mano.z)
	fuera = fuera.normalized() if fuera.length() > 0.01 else Vector3(0.0, 0.0, 1.0)
	if _fx != null:
		_fx.spill_burst(mano, fuera, 1.0, true)









	if is_instance_valid(bot):
		var desde: Vector3 = bot.position
		var hasta: Vector3 = desde + fuera * BEER_TOSS_OUT \
				+ Vector3(0.0, - BEER_TOSS_DROP, 0.0)




		var eje: Vector3 = Vector3(randf_range(-1.0, 1.0), randf_range(-0.2, 0.2),
			randf_range(-1.0, 1.0)).normalized()
		var giro: float = randf_range(7.0, 13.0)
		var tw: Tween = create_tween()
		tw.tween_method(func(t: float) -> void:
				if not is_instance_valid(bot):
					return
				bot.position = desde.lerp(hasta, t) \
						+ Vector3(0.0, sin(t * PI) * BEER_TOSS_ARC, 0.0)
				bot.basis = Basis(eje, t * BEER_FALL_S * giro),
			0.0, 1.0, BEER_FALL_S)



	if _audio != null:
		_audio.ooh()




	if _hud != null and is_instance_valid(_hud):
		_hud.show_message(I18n.t("¡LE TIRASTE LA BEBIDA A UN AFICIONADO!"),
			Color("f2b23e"), 1.2)





	SceneFade.timer(BEER_LIFE_S, false).timeout \
			.connect(_end_beer_gag.bind(_beer_fan))





func _end_beer_gag(quien: Node3D) -> void:
	if is_instance_valid(quien):
		quien.queue_free()


	if _beer_fan == quien:
		_beer_fan = null








func _heckler_stands_up(mio: String) -> void:



	if _stadium == null or _hud == null or Settings.reduce_motion \
			or not _practice_kind.is_empty() or _shootout_active:
		return


	if mio != "wide" and mio != "over":
		return

	if _heckler_shown >= HECKLER_MAX or misses < HECKLER_AT \
			or misses - _heckler_last_miss < HECKLER_GAP:
		return




	var frames: SpriteFrames = _stadium.fan_frames(true)
	if frames == null or not frames.has_animation("boo"):
		return




	var cam: Camera3D = SceneFade.camara_de(self)
	if cam == null or _traj.is_empty():
		return





	var desde: Vector3 = _traj[_traj.size() - 1]






	if not _stadium.stand_seat_exists(desde):
		return










	var sitio: Vector3 = Vector3.INF
	for row in range(HECKLER_ROW, -1, -1):
		var p: Vector3 = _stadium.heckler_spot(desde, row)
		if p == Vector3.INF:
			continue








		if _stadium.seat_behind_cloth(p):
			continue
		var testa: Vector3 = p + Vector3.UP * HECKLER_BODY_M
		if not cam.is_position_in_frustum(p) or not cam.is_position_in_frustum(testa):
			continue
		if absf(cam.unproject_position(p).y - cam.unproject_position(testa).y) \
				< HECKLER_MIN_PX:
			continue
		sitio = p
		break



	if sitio == Vector3.INF:
		return
	if is_instance_valid(_heckler):
		_heckler.queue_free()
	_heckler = AnimatedSprite3D.new()
	_heckler.sprite_frames = frames
	_heckler.pixel_size = HECKLER_PIXEL





	_heckler.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	_heckler.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_heckler.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	_heckler.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
















	var salida: Vector3 = _stadium.heckler_spot(desde, 1) - _stadium.heckler_spot(desde, 0)
	salida.y = 0.0
	var adentro: Vector3 = - salida.normalized() if salida.length() > 0.01 else Vector3.ZERO


	var suelo: Vector3 = sitio + adentro * HECKLER_AHEAD_M - Vector3.UP * HECKLER_RISE_M
	_heckler.position = suelo
	add_child(_heckler)
	_heckler.play("boo")
	var t: Tween = create_tween()
	t.tween_property(_heckler, "position", suelo + Vector3.UP * HECKLER_RISE_M,
		HECKLER_RISE_T).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)



	_audio.heckle()
	_say("abucheo", HECKLER_TALK_DELAY)
	_heckler_shown += 1



	_heckle_goals = match_goals
	_heckler_last_miss = misses




	SceneFade.timer(HECKLER_DUR, false).timeout.connect(
		_heckler_sits_down.bind(_heckler))





func _heckler_sits_down(quien: AnimatedSprite3D) -> void:
	if quien == null or not is_instance_valid(quien):
		return
	if _heckler == quien:
		_heckler = null
	var t: Tween = create_tween()
	t.tween_property(quien, "position", quien.position - Vector3.UP * HECKLER_RISE_M,
		HECKLER_SIT_T).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	t.tween_callback(quien.queue_free)






