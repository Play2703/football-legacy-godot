func _fan_add_sonrisa(fan: AnimatedSprite3D) -> bool:
	if fan == null or fan.sprite_frames == null:
		return false
	var frames: SpriteFrames = fan.sprite_frames
	if frames.has_animation("sonrisa"):
		return true
	var cfg: Dictionary = fan.get_meta("anim_cfg", {}).duplicate()




	if not cfg.is_empty():
		cfg["expresion"] = Expresiones.estado_en("reir", 0.0)
	frames.add_animation("sonrisa")
	frames.set_animation_speed("sonrisa", 5.0)
	frames.set_animation_loop("sonrisa", true)
	var n: int = 0
	for i in range(1, 5):
		var t: Texture2D = load("res://assets/sprites/anim/afi_sonrisa_south_%02d.png"
			% i) as Texture2D
		if t == null:
			break
		frames.add_frame("sonrisa", KitRecolor.apply(t, cfg))
		n += 1
	if n == 0:
		frames.remove_animation("sonrisa")
		return false
	return true








