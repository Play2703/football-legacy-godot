func _recep_pinta() -> void:
	if not is_instance_valid(_recep_aro) or _recep_plan.is_empty():
		return
	var cam: Camera3D = SceneFade.camara_de(self)
	if cam != null and not cam.is_position_behind(_recep_contacto):
