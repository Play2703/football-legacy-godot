func _schedule_press_out(evita: Array[int] = []) -> void:
	_press_chances = []
	if not _practice_kind.is_empty():
		return
	var cupo_press: int = _press_out_cupo()



	if cupo_press <= 0:
		return


	var pool: Array[int] = []
	for i in range(DUEL_FIRST_CHANCE, _chances_this_match):
		pool.append(i)
	if pool.is_empty():
		return
	pool.shuffle()
	for c in pool:
		if _press_chances.size() >= cupo_press:
			break


		if _press_chances.has(c - 1) or _press_chances.has(c + 1):
			continue
		if evita.has(c) or evita.has(c - 1) or evita.has(c + 1):
			continue
		_press_chances.append(c)
	_saque_reparte()





func _saque_reparte() -> void:
	var jugado: Dictionary = {}
	for c in _saque_huecos:
		if int(c) <= chance_index:
			jugado[c] = _saque_huecos[c]
	_saque_huecos = jugado

	if not jugado.is_empty() or _press_chances.is_empty() or _saque_played > 0:
		return
	var forma: int = _saque_hoy_forma()
	if forma == SAQUE_HUECO_NO:
		return
	for c in _press_chances:
		if int(c) > chance_index:
			_saque_huecos[int(c)] = forma
			return




func _saque_hoy_forma() -> int:
	if _saque_hoy < 0:
		if not saque_en_carrera:
			return SAQUE_HUECO_NO
		_saque_hoy = saque_hueco_de(randf(), randf())
	return _saque_hoy





static func saque_hueco_de(r1: float, r2: float) -> int:
	if r1 >= SAQUE_EN_SALIDA_P:
		return SAQUE_HUECO_NO
	return SAQUE_HUECO_LARGO if r2 < SAQUE_LARGO_EN_SALIDA_P else SAQUE_HUECO_CORTO
















func _saque_generador_cabe() -> bool:
	if not saque_en_carrera or not _practice_kind.is_empty() or _saque_played > 0:
		return false
	for c in _saque_huecos:
		if int(c) >= chance_index:
			return false
	return true







const RECU_PER_MATCH: int = 1


const RECU_MIN_CHANCES: int = 5

















var recu_en_carrera: bool = false























func _schedule_recu(desde: int = 0, ya_jugadas: Array[int] = []) -> void:
	_recu_chances = []


	if not recu_en_carrera:
		return
	if not _practice_kind.is_empty():
		return
	if RECU_PER_MATCH <= 0 or _chances_this_match < RECU_MIN_CHANCES:
		return


	var cupo: int = RECU_PER_MATCH - ya_jugadas.size()
	if cupo <= 0:
		return
	var pool: Array[int] = []
	for i in range(maxi(DUEL_FIRST_CHANCE, desde), _chances_this_match):
		pool.append(i)
	if pool.is_empty():
		return
	pool.shuffle()
	for c in pool:
		if _recu_chances.size() >= cupo:
			break
		if _recu_chances.has(c - 1) or _recu_chances.has(c + 1):
			continue


		if ya_jugadas.has(c) or ya_jugadas.has(c - 1) or ya_jugadas.has(c + 1):
			continue
		if _press_chances.has(c) or _press_chances.has(c - 1) \
				or _press_chances.has(c + 1):
			continue


		if _servicio_chances.has(c) or _servicio_chances.has(c - 1) \
				or _servicio_chances.has(c + 1):
			continue
		_recu_chances.append(c)




























func _make_duel_chance(forzado: String = "") -> Dictionary:
	var arq: Dictionary = DuelArchetypes.by_id(forzado) if not forzado.is_empty() \
			else DuelArchetypes.pick(randf(), _duel_arq_prev)





	if forzado.is_empty():
		_duel_arq_prev = String(arq.get("id", ""))
	var shape: String = String(arq.get("shape", "escalonado"))


	var x: float
	if arq.has("x_abs"):
		var xa: Vector2 = arq["x_abs"]
		x = randf_range(xa.x, xa.y) *(1.0 if randf() < 0.5 else -1.0)
		x = clampf(x, - Stadium.FIELD_HALF_W + 1.5, Stadium.FIELD_HALF_W - 1.5)
	else:
		x = randf_range(- DUEL_X_MAX, DUEL_X_MAX)
	var zb: Vector2 = arq.get("z", DUEL_Z)
	var z: float = randf_range(zb.x, zb.y)
	var ball: Vector2 = Vector2(x, z)


	var run: float = float(arq.get("run", DUEL_RUN_LEN))
	var target_z: float = maxf(z - run, DUEL_TARGET_MIN_Z)



	var mates: Array = []
	var cupo_m: Vector2i = arq.get("mates", DUEL_MATES)
	var n_mates: int = randi_range(cupo_m.x, cupo_m.y)


	var mside: float = - signf(x) if shape != "escalonado" or arq.has("x_abs") \
			else (1.0 if randf() < 0.5 else -1.0)
	if mside == 0.0:
		mside = 1.0
	for i in n_mates:




		var mx: float = clampf(x + mside * randf_range(6.0, 10.0),
			- Stadium.FIELD_HALF_W + 3.0, Stadium.FIELD_HALF_W - 3.0)
		var mz: float = clampf(z - randf_range(1.0, 9.0), target_z - 4.0, z + 2.0)
		mates.append(Vector2(mx, mz))

		if not arq.has("x_abs"):
			mside = - mside
	var defs: Array = _duel_defenders_for(arq, ball, target_z)
	return {
		"kind": "regate",
		"name": String(arq.get("name", "Uno contra uno")),
		"duel_arq": String(arq.get("id", "medio")),
		"ball": ball,
		"target_z": target_z,
		"teammates": mates,
		"defenders": defs,
	}





func _duel_defenders_for(arq: Dictionary, ball: Vector2, target_z: float) -> Array:
	var shape: String = String(arq.get("shape", "escalonado"))
	var cupo: Vector2i = arq.get("defs", DUEL_DEFS)
	var n: int = randi_range(cupo.x, cupo.y)
	var defs: Array = []
	var x: float = ball.x
	var z: float = ball.y
	match shape:
		"unico":



			for i in n:
				defs.append(Vector2(
					clampf(x + randf_range(-1.8, 1.8),
						- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
					lerpf(z, target_z, 0.55) + randf_range(-1.0, 1.0)))
		"persecucion":














			var lado: float = 1.0 if randf() < 0.5 else -1.0
			for i in n:
				if i == n - 1:

					defs.append(Vector2(
						clampf(x + randf_range(-1.5, 1.5),
							- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
						lerpf(z, target_z, 0.6) + randf_range(-1.0, 1.0)))
					continue
				defs.append(Vector2(
					clampf(x + lado * randf_range(0.3, 2.0),
						- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
					z + randf_range(0.5, 2.5)))
				lado = - lado
		"pinza":










			var s: float = 1.0 if randf() < 0.5 else -1.0
			for i in n:
				if i >= 2:



					defs.append(Vector2(
						clampf(x + randf_range(-2.0, 2.0),
							- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
						target_z + randf_range(0.5, 2.5)))
					continue
				var adelanto: float = 1.6 if i == 0 else 0.0
				defs.append(Vector2(
					clampf(x + s * randf_range(0.9, 2.0),
						- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
					z - adelanto - randf_range(0.4, 2.2)))
				s = - s
		_:











			var side: float = 1.0 if randf() < 0.5 else -1.0
			for i in n:
				var frac: float = float(i) / maxf(float(n - 1), 1.0)
				var dz: float = lerpf(z - 3.5, target_z + 1.5, frac) + randf_range(-1.5, 1.5)
				var off: float = randf_range(0.0, 1.6) if i == 0 else randf_range(2.5, 7.0)




				var techo: float = maxf(DUEL_X_MAX + 5.0, absf(x) + 3.0)
				var dx: float = clampf(x + side * off, - techo, techo)
				dx = clampf(dx, - Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0)
				defs.append(Vector2(dx, dz))
				side = - side






	for i in defs.size():
		var d: Vector2 = defs[i]
		var off: Vector2 = d - ball
		if off.length() < DUEL_DEF_CLEAR:
			if off.length() < 0.01:
				off = Vector2(0.0, -1.0)
			defs[i] = ball + off.normalized() * DUEL_DEF_CLEAR
	return defs













func _reparte_marcas() -> void:
	_duel_def_marks = []
	for i in _duel_defs.size():
		_duel_def_marks.append(-1)
	var libres: int = _duel_defs.size()
	for mi in _duel_mates.size():


		if libres <= 1 or mi >= _tac_markers:
			break
		var best: int = -1
		var best_d: float = INF
		for di in _duel_defs.size():
			if _duel_def_marks[di] != -1:
				continue
			var d: float = _duel_defs[di].distance_to(_duel_mates[mi])
			if d < best_d:
				best_d = d
				best = di
