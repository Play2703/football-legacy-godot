	var ball: Vector2 = Vector2(side * rng.randf_range(SUPER_X.x, SUPER_X.y),
		rng.randf_range(SUPER_Z.x, SUPER_Z.y))
	var origin: Dictionary = {
		"kind": "frontal",
		"name": "El hombre de más",
