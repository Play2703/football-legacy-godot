func _balon_al_brazo(actor: AnimatedSprite3D) -> bool:
	var frames: SpriteFrames = actor.sprite_frames
	if frames == null:
		return false
	if frames.has_animation(CESION_BALON_ANIM):
		actor.play(CESION_BALON_ANIM)
		return true
	var cfg: Dictionary = actor.get_meta("anim_cfg", {})
	var puestos: int = 0







	var bases: PackedStringArray = PackedStringArray()
	for i in range(1, 9):
		var path: String = "%s%02d.png" % [CESION_BALON_HOJA, i]
		if not ResourceLoader.exists(path):
			continue
		if puestos == 0:
			frames.add_animation(CESION_BALON_ANIM)
			frames.set_animation_loop(CESION_BALON_ANIM, true)
			frames.set_animation_speed(CESION_BALON_ANIM, CESION_BALON_FPS)
		frames.add_frame(CESION_BALON_ANIM, KitRecolor.apply(load(path), cfg))
		bases.append(path.get_file().get_basename())
		puestos += 1
	if puestos == 0:
		return false
	PechoRig.apunta(frames, bases, CESION_BALON_ANIM)
	actor.play(CESION_BALON_ANIM)
	return true


















