func _puddle_dive(actor: AnimatedSprite3D, anchor: Vector3, lider: bool) -> void:

	var hacia: Vector2 = Vector2(anchor.x - actor.position.x, anchor.z - actor.position.z)
	if hacia.length() < 0.5:
		hacia = Vector2(0.0, 1.0)
	hacia = hacia.normalized()












	var pud: Dictionary = _puddle_near(anchor)
	var radio: float = float(pud.get("r", PUDDLE_MIN_R)) if not pud.is_empty() \
			else PUDDLE_MIN_R
	var slide: float = clampf(radio * 1.35, 2.2, PUDDLE_SLIDE_M)
	var borde: Vector3 = Vector3(
		clampf(anchor.x - hacia.x * slide,
			- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
		actor.position.y,
		maxf(anchor.z - hacia.y * slide, -1.5))



	var perp: Vector2 = Vector2(- hacia.y, hacia.x) *(0.0 if lider else randf_range(0.7, 1.1)) \
			*(1.0 if randf() < 0.5 else -1.0)
	var fin: Vector3 = Vector3(
		clampf(anchor.x + perp.x, - Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
		actor.position.y, maxf(anchor.z + perp.y, -1.5))
	var speed: float = _celeb_run_speed(actor, _flat_dist(actor.position, borde))
	_run_target[actor] = borde
	_celeb_seal_run(actor, CELEB_RUN_MAX_S)
	_play_run(actor, borde - actor.position)
	if lider:


		_celeb_focus_pos = fin
	var tw: Tween = create_tween()
	tw.tween_property(actor, "position", borde,
		maxf(_flat_dist(actor.position, borde) / speed, 0.3))
	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return


		_run_target.erase(actor)






		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + CELEB_GESTO_BUDGET_US)
		if _gesto_listo(actor, "panzazo"):
			_hold_celebration(actor)
			actor.play("panzazo")
		if _fx != null:
			_fx.splash_dir(Vector3(hacia.x, 0.0, hacia.y))
			_fx.splash_burst(Vector3(borde.x, 0.06, borde.z), PUDDLE_SPLASH_HIT,
				PUDDLE_SPLASH_SCALE)
		if lider:
			_audio.splash(PUDDLE_SPLASH_HIT))
	tw.tween_property(actor, "position", fin, PUDDLE_SLIDE_S) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)





	for k in PUDDLE_SPLASH_N:
		var t: float = float(k + 1) / float(PUDDLE_SPLASH_N + 1)
		tw.parallel().tween_callback(func() -> void:
			if _fx == null or not is_instance_valid(actor):
				return
			_fx.splash_dir(Vector3(hacia.x, 0.0, hacia.y))
			_fx.splash_burst(Vector3(actor.position.x, 0.06, actor.position.z),
				lerpf(PUDDLE_SPLASH_HIT * 0.8, PUDDLE_SPLASH_HIT * 0.25, t),
				lerpf(PUDDLE_SPLASH_SCALE, PUDDLE_SPLASH_SCALE * 0.6, t))
			).set_delay(PUDDLE_SLIDE_S * t)




	tw.tween_interval(PUDDLE_UP_S)
	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return
		if _fx != null:
			_fx.splash_burst(Vector3(actor.position.x, 0.06, actor.position.z),
				PUDDLE_SPLASH_HIT * 0.5, PUDDLE_SPLASH_SCALE * 0.9)
		_start_celebration(actor))
	_celeb_runs.append(tw)















