func _paint_ring_word(img: Image, text: String, col: Color) -> void:
	var size: int = img.get_width()
	var c: float = float(size - 1) * 0.5
	var chars: String = text.to_upper()
	var n: int = chars.length()
	if n <= 0:
		return
	var arc: float = deg_to_rad(minf(
		RING_LABEL_DEG_PER_CHAR * float(n), RING_LABEL_ARC_MAX_DEG))
	var step: float = arc / float(n)
	var start: float = - arc * 0.5 + step * 0.5
	var r_uv: float = RING_LABEL_R_UV
	var scale_i: int = RING_LABEL_SCALE
	var gw_half: float =(float(PixelText.GLYPH_W) - 1.0) * 0.5
	var gh_half: float =(float(PixelText.GLYPH_H) - 1.0) * 0.5
	var half_px: float =(float(scale_i) - 1.0) * 0.5
	for i in n:
		var th: float = start + step * float(i)
		var cs: float = cos(th)
		var sn: float = sin(th)
		var gcx: float = c + sn * r_uv * c
		var gcy: float = c + cs * r_uv * c

		var tx: float = cs
		var ty: float = - sn





		var rx: float = - ty
		var ry: float = tx
		var glyph: Array = PixelText.FONT.get(chars[i], [])
		if glyph.is_empty():
			continue
		for row in PixelText.GLYPH_H:
			var bits: int = glyph[row]
			for col_i in PixelText.GLYPH_W:
				if not (bits&(4>>col_i)):
					continue
				var lx0: float =(float(col_i) - gw_half) * float(scale_i)
				var ly0: float =(float(row) - gh_half) * float(scale_i)
				for ry_i in scale_i:
					for rx_i in scale_i:
						var lx: float = lx0 + float(rx_i) - half_px
						var ly: float = ly0 + float(ry_i) - half_px
						var wx: int = int(round(gcx + lx * tx + ly * rx))
						var wy: int = int(round(gcy + lx * ty + ly * ry))
						if wx >= 0 and wx < size and wy >= 0 and wy < size:
							img.set_pixel(wx, wy, col)


const NEAR_BIAS_STEPS: int = 3
func _make_bracket_texture(r_in: float, r_out: float, gap: float,
		near_bias: float = 0.0) -> ImageTexture:



	var size: int = 256
	var img: Image = Image.create(size, size, false, Image.FORMAT_RGBA8)
	var c: float =(size - 1) * 0.5
	for y in size:
		for x in size:
			var dx: float =(x - c) / c
			var dy: float =(y - c) / c
			var d: float = sqrt(dx * dx + dy * dy)
			var a: float = 0.0
			if d >= r_in and d <= r_out:

				var seg: float = fposmod(atan2(dy, dx) + PI, PI * 0.5)
				if seg > gap and seg < PI * 0.5 - gap:
					a = 1.0
			if a > 0.0 and near_bias > 0.0:

				var f: float = lerpf(1.0 - clampf(near_bias, 0.0, 1.0), 1.0,
					(dy + 1.0) * 0.5)
				a = snappedf(f, 1.0 / float(NEAR_BIAS_STEPS))
			img.set_pixel(x, y, Color(1.0, 1.0, 1.0, a))
	return ImageTexture.create_from_image(img)

















