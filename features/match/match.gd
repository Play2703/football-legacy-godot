	if why != "gol" and not _shootout_active and _audio \
			and _ooh_lock <= 0.0 and _danger_peak >= OOH_FROM:
		_ooh_lock = OOH_LOCK
		_audio.ooh()



	_danger_peak = 0.0
	_recu_replay()













