func _cedida_espera_step(delta: float) -> void:
	var volando: bool = state == State.FLIGHT or state == State.PASSING
	for a in _cedida_mates + _cedida_rivals + _teammate_actors + _rival_actors:
		if a == null or not is_instance_valid(a) or not a.has_meta("cedida_espera"):
			continue





		var amp: float = float(a.get_meta("cedida_amp", CEDIDA_ESPERA_A))
		if amp <= 0.001:
			continue


		if volando and (_teammate_actors.has(a) or _rival_actors.has(a)):
			continue







		if _cedida_disputa():
			continue








		var pausa: float = float(a.get_meta("cedida_pausa", 0.0))
		if pausa > 0.0:
			pausa -= delta
			a.set_meta("cedida_pausa", pausa)
			if pausa > 0.0:
				continue
			a.set_meta("cedida_dest", _cedida_espera_dest(a, amp))
		var pos: Vector2 = Vector2(a.position.x, a.position.z)
		var dest: Vector2 = a.get_meta("cedida_dest", pos)


		if pos.distance_to(dest) <= CEDIDA_ESPERA_PASO * delta:
			a.set_meta("cedida_pausa",
				randf_range(CEDIDA_ESPERA_PAUSA.x, CEDIDA_ESPERA_PAUSA.y))
			continue
		var paso: Vector2 = pos +(dest - pos).limit_length(CEDIDA_ESPERA_PASO * delta)
		a.position = Vector3(paso.x, a.position.y, paso.y)



		var d: Vector2 = paso - pos
		if d.length() > 0.0005:
			_play_run(a, Vector3(d.x, 0.0, d.y))






func _cedida_espera_dest(a: AnimatedSprite3D, amp: float) -> Vector2:
	var base: Vector2 = a.get_meta("cedida_espera")
	var ang: float = randf() * TAU
	var r: float = randf_range(minf(CEDIDA_ESPERA_MIN, amp), amp)
	return _clamp_field(_cobro_sitio_legal(base + Vector2(cos(ang), sin(ang)) * r))

















