const GestoMister := preload("res://features/match/gesto_mister.gd")



const GestoSocio := preload("res://features/match/gesto_socio.gd")















const COACH_CUT_DIST: float = 5.2
const COACH_CUT_SIDE: float = 1.4
const COACH_CUT_Y: float = 1.55
const COACH_CUT_AIM: float = 1.15
const COACH_CUT_FOV: float = 38.0


const COACH_CUT_PUSH: float = 0.8








static func coach_cut_cam_x(base_x: float, coach_x: float, push: float) -> float:
	return maxf(base_x, coach_x + COACH_CUT_DIST) - push


var _coach_cuts: int = 0
var _coach_last_gesto: String = ""




var _coach_cuts_on: bool = not GameState.readonly_save



var _ex_goles: int = 0
var _ex_gol_visto: bool = false





func _coach_ctx() -> Dictionary:
	var fx: Dictionary = GameState.current_fixture()
	var nat: bool = String(fx.get("comp", "")) == "nat"
	return {"minuto": match_minute, "nos": team_goals, "ellos": rival_goals,
		"rel": 50 if nat else Career.rel_eff("tecnico"),
		"caracter": "neutral" if nat else Career.coach_char,
		"ultimo": _coach_last_gesto, "cortes": _coach_cuts, "racha": _wasted_run,
		"ex": {} if nat else Career.ex_tecnico_en(String(fx.get("opp", "")))}






var _coach_pendiente: String = ""
func _coach_event_of_outcome(outcome: String) -> String:
	if _shootout_active or not _practice_kind.is_empty():
		return ""






	if outcome == "goal":
		if not (_coach_ctx().get("ex", {}) as Dictionary).is_empty():
			_ex_goles += 1
			if not _ex_gol_visto:
				return GestoMister.EV_GOL_MIO_VS_EX
		return ""
	if _chance_kind == "penal":
		return ""
	match outcome:
		"wide", "over", "blocked":
			return GestoMister.EV_FALLO
		"post":
			return GestoMister.EV_PALO
		"save":
			return GestoMister.EV_PARADA
		"offside":



			if _offside_tuyo:
				return GestoMister.EV_OFFSIDE
			if _rebound_mate and not _pass_done and not _rebound_cause.is_empty() \
					and _rebound_cause != "offside":
				return _coach_event_of_outcome(_rebound_cause)
			return GestoMister.EV_OFFSIDE_COMPA
	return ""




func _coach_event_of(line: Dictionary) -> String:
	match String(line.get("kind", "")):
		"goal_rival":
			return GestoMister.EV_GOL_RIVAL
		"goal_team":
			return GestoMister.EV_GOL_EQUIPO
		"red_you":
			if String(line.get("team", "")) == "you":
				return GestoMister.EV_ROJA_MIA
	return ""





func _play_coach_cut(ev: String, deja_velo: bool = false) -> void:
	if not _coach_cuts_on or _stadium == null or not is_instance_valid(_stadium) \
			or _practice_kind != "" or _shootout_active or state != State.SIM:
		return
	var ctx: Dictionary = _coach_ctx()



	if ev == GestoMister.EV_FINAL and not GameState.readonly_save:
		var ida: Array = GameState.your_first_leg(GameState.current_fixture())
		if ida.size() == 2:
			ctx["nos"] = int(ctx["nos"]) + int(ida[0])
			ctx["ellos"] = int(ctx["ellos"]) + int(ida[1])
	var r: Dictionary = GestoMister.elegir(ev, ctx)
	if r.is_empty() or not bool(r["corte"]):
		return

	var bench_home: bool = _home_match if bool(r["mio"]) else not _home_match
	var gesto: String = String(r["gesto"])
	var secs: float = float(r["secs"])


	var dur: float = 60.0 if gesto == Stadium.GESTO_SE_VA else secs + 0.3
	var anchor: Vector3 = _stadium.coach_gesture(bench_home, gesto, dur,
		bool(r["espaldas"]))


	_stadium.coach_placa(bench_home, true)


	if ev != GestoMister.EV_FINAL and ev != GestoMister.EV_GOL_MIO_VS_EX:
		_coach_cuts += 1
	if ev == GestoMister.EV_GOL_MIO_VS_EX:
		_ex_gol_visto = true
	_coach_last_gesto = gesto
	var prev_cam: Camera3D = SceneFade.camara_de(self)
	var cam: Camera3D = Camera3D.new()
	cam.fov = COACH_CUT_FOV
	add_child(cam)
	cam.current = true

	var lado: float = signf(Stadium.HALF_LINE - anchor.z)
	if is_zero_approx(lado):
		lado = 1.0

	var base: Vector3 = Vector3(anchor.x + COACH_CUT_DIST, COACH_CUT_Y,
		anchor.z + lado * COACH_CUT_SIDE)
	cam.position = base
	cam.look_at(Vector3(anchor.x, COACH_CUT_AIM, anchor.z))
	_stadium.keep_view_clear(cam.global_position, PackedVector3Array(), cam)
	_sim_screen.veil(true)


	if r.has("rotulo"):
		_hud.show_message(I18n.t(String(r["rotulo"])), CareerTheme.INK_LIGHT, secs)

	_sim_skip = false
	var t: float = 0.0
	while t < secs:


		if _sim_skip or state != State.SIM or not is_inside_tree():
			break
		await get_tree().process_frame
		if not is_inside_tree():
			break

		if get_tree().paused:
			continue
		t += get_process_delta_time()
		var k: float = clampf(t / secs, 0.0, 1.0)
		var push: float = COACH_CUT_PUSH *(1.0 - pow(1.0 - k, 2.0))
		cam.position = base - Vector3(push, 0.0, 0.0)



		if is_instance_valid(_stadium):
			var ahora: Vector3 = _stadium.coach_spot(bench_home)
			cam.position.x = coach_cut_cam_x(base.x, ahora.x, push)
			cam.look_at(Vector3(ahora.x, COACH_CUT_AIM, ahora.z))
	if is_instance_valid(prev_cam) and prev_cam.is_inside_tree():
		prev_cam.current = true
	cam.queue_free()
	if is_instance_valid(_stadium):
		_stadium.coach_placa(bench_home, false)




	if not deja_velo:
		_sim_screen.veil(false)







var _coach_cierra_tramo: bool = false
func _coach_final_cut() -> void:
	await _play_coach_cut(GestoMister.EV_FINAL, true)



























const PITIDO_RUGE_S: float = 1.1

const PITIDO_RUGE_VISITA_DB: float = -6.0
var _pitido_sonado: bool = false
var _pitido_grada: int = 0


var _pitido_forzado: Dictionary = {}




func _pitido_ctx() -> Dictionary:
	if not _practice_kind.is_empty() or _festejo_revivido or _tutorial_active:
		return {}
	var f: Dictionary = GameState.current_fixture()
	var cierra: Dictionary = _jornada_decisiva()
	return {
		"dif": team_goals - rival_goals,
		"carry": _tie_carry(),
		"final": String(f.get("round", "")) == FAN_PHOTO_ROUND \
				and GameState.fixture_is_knockout(f),
		"basta": int(cierra.get("basta", 0)),
		"tipo": String(cierra.get("tipo", "")),
		"condena": Career.jornada_condena(),
		"tanda": _tanda_dif != 0,
	}




func _pitido_gradas() -> void:
	if _stadium == null or not is_instance_valid(_stadium) or _shootout_active \
			or not _practice_kind.is_empty():
		return
	var r: Dictionary = _pitido_forzado
	if r.is_empty():
		if not _coach_cuts_on:
			return
		var ctx: Dictionary = _pitido_ctx()
		if ctx.is_empty():
			return
		r = LecturaGol.pitido(ctx)
		if r.is_empty():
			return
	var festeja: int = int(r.get("festeja", 0))
	_pitido_sonado = true
	_pitido_grada = LecturaGol.grada_del_pitido(r, team_goals - rival_goals, _tie_carry())
	_audio.whistle_end()
	_stadium.crowd_final_tuyo(_pitido_grada)


