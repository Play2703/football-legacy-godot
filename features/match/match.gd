func _dron_maybe_spawn() -> void:


	_dron = null
	if _dron_caido:
		return

	if _shootout_active or _tutorial_active or not _practice_kind.is_empty():
		return
	if not _dron_rolled:
		_dron_rolled = true


		if not _dron_force:
			_dron_rng.randomize()
		_dron_on = _dron_force or _dron_sale()
		_dron_wait = 0 if _dron_force else _dron_rng.randi_range(0, DRON_WAIT_MAX)
		_dron_chances_left = DRON_CHANCES
	if not _dron_on or _dron_chances_left <= 0:
		return
	if _dron_wait > 0:
		_dron_wait -= 1
		return
	var sitio: Vector3 = _dron_punto()
	if sitio == Vector3.INF:


		return
	_dron_chances_left -= 1
	_dron = Dron.new()


	_actors.add_child(_dron)
	_dron.colocar(sitio, Vector3(_ball_field.x, 0.0, _ball_field.y))
	_dron.aterrizo.connect(_on_dron_aterriza)



func _dron_sale() -> bool:





	if GameState.readonly_save:
		return false
	var div: int = _stadium.div if _stadium != null else GameState.home_div()
	if div > DRON_DIV_MAX:
		return false


	if _stadium != null and (bool(_stadium.weather.get("rain", false))
			or bool(_stadium.weather.get("snow", false))):
		return false
	return _dron_rng.randf() < DRON_MATCH_P




func _dron_punto() -> Vector3:
	if _aim_cam == null or not is_instance_valid(_aim_cam):
		return Vector3.INF

	var vista: Vector2 = SceneFade.rect_visible(_aim_cam).size



	var z_max: float = minf(DRON_Z_MAX, _ball_field.y)
	if z_max <= DRON_Z_MIN:
		return Vector3.INF
	for i in DRON_INTENTOS:
		var p: Vector3 = Vector3(
			_dron_rng.randf_range(- DRON_X_MAX, DRON_X_MAX),
			_dron_rng.randf_range(DRON_Y_MIN, DRON_Y_MAX),
			_dron_rng.randf_range(DRON_Z_MIN, z_max))
		var suelo: float = Vector2(p.x - _ball_field.x, p.z - _ball_field.y).length()
		if p.y + DRON_MARGEN > _dron_alcance(suelo):
			continue
		if _aim_cam.is_position_behind(p):
			continue
		var s: Vector2 = _aim_cam.unproject_position(p)
		if s.x < vista.x * DRON_PANT_X or s.x > vista.x *(1.0 - DRON_PANT_X) \
				or s.y < vista.y * DRON_PANT_Y0 or s.y > vista.y * DRON_PANT_Y1:
			continue
		return p
	return Vector3.INF






func _dron_alcance(d: float) -> float:
	var n: int = DRON_ALCANCE.size()
	if d < 0.0 or d > float(n - 1):
		return 0.0
	var k: int = mini(int(d), n - 2)
	return lerpf(DRON_ALCANCE[k], DRON_ALCANCE[k + 1], d - float(k))


func _dron_vivo() -> bool:
	return _dron != null and is_instance_valid(_dron) and _dron.vivo()





func _hit_dron() -> void:
	if not _dron_vivo():
		return
	_dron.derribar(_dron_v)
	_dron_caido = true
	if _audio != null and is_instance_valid(_audio):
		_audio.dron_golpe()
	_fx.shake(0.16)
