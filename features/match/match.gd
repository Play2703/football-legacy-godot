const CARGA_CANDADO_MS: int = 250

func _carga_sostiene() -> void:
	if not _carga_viva:
		return
	if not is_instance_valid(_self_actor) \
			or String(_self_actor.animation) != _carga_anim \
			or not (_open_ring_gold or state == State.RUNUP):
		_carga_viva = false
		return
	_anim_lock[_self_actor] = maxi(int(_anim_lock.get(_self_actor, 0)),
		Time.get_ticks_msec() + CARGA_CANDADO_MS)




func _carga_suelta() -> void:
	if not _carga_viva:
		return
	_carga_viva = false
	_carga_soltada = true
	_carga_gen += 1
	if not is_instance_valid(_self_actor) or _self_actor.sprite_frames == null:
		return

	if int(_anim_lock.get(_self_actor, 0)) <= Time.get_ticks_msec() + CARGA_CANDADO_MS:
		_anim_lock.erase(_self_actor)

	if String(_self_actor.animation) != _carga_anim or _carga_prev.size() < 3:
		return
	var prev: StringName = _carga_prev[0]
	if not _self_actor.sprite_frames.has_animation(prev):
		return
	_self_actor.play(prev)
	_self_actor.set_frame_and_progress(int(_carga_prev[1]), float(_carga_prev[2]))
	_self_actor.pause()


