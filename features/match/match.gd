func _def_mas_cerca() -> float:
	var d: float = INF
	for i in _duel_defs.size():
		var p: Vector2 = _duel_defs[i]






		if i < _duel_def_vels.size():
			p +=(_duel_def_vels[i] as Vector2) * Duel.TOQUE_T
		d = minf(d, p.distance_to(_ball_field))
	return d










func _def_mas_cerca_drive() -> float:
	var d: float = INF
	for i in _drive_press_active():
		if i >= _defender_pos.size():
			continue
		var p: Vector2 = _defender_pos[i]
		if i < _press_vels.size():
			p +=(_press_vels[i] as Vector2) * Duel.TOQUE_T
		d = minf(d, p.distance_to(_ball_field))
	return d


func _duel_corral(p: Vector2) -> Vector2:









	var libre: bool = _duel_open or _duel_press or _duel_broke
	var x_max: float = Stadium.FIELD_HALF_W + 2.5 if libre else Stadium.FIELD_HALF_W - 0.5
	var z_min: float = -2.5 if libre else DUEL_TARGET_MIN_Z - 1.0
	var z_max: float = Stadium.FIELD_DEPTH + 2.5 if libre else _duel_z_max
	return Vector2(clampf(p.x, - x_max, x_max), clampf(p.y, z_min, z_max))










func _duel_corral_balon(p: Vector2) -> Vector2:
	if _duel_open or _duel_press or _duel_broke:
