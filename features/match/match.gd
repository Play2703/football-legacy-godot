	var parte: String = "pie" if y + BALL_R < DESV_H_PIE else "pierna"
	return [parte,
		lerpf(float(DESV_PARTES["pie"][0]), float(DESV_PARTES["pierna"][0]), hb),
		lerpf(BARRIDA_TIRO_NY_RASO, BARRIDA_TIRO_NY_ALTO, hb)]






static func _barrida_cuerpo(h: float, y: float) -> float:
	var n: int = BARRIDA_TIRO_CUERPO.size()
	if h < 0.0 or h > float(BARRIDA_TIRO_CUERPO[n - 1][0]):
		return 0.0
	var k: int = 1
	while k < n - 1 and h > float(BARRIDA_TIRO_CUERPO[k][0]):
		k += 1
	var a: Array = BARRIDA_TIRO_CUERPO[k - 1]
	var c: Array = BARRIDA_TIRO_CUERPO[k]
	var f: float = clampf((h - float(a[0])) / maxf(float(c[0]) - float(a[0]), 0.001),
		0.0, 1.0)
	var lleno: float = lerpf(float(a[1]), float(c[1]), f)
	var techo: float = lerpf(float(a[2]), float(c[2]), f)
	if y >= techo:
		return 0.0
	return 1.0 - smoothstep(minf(lleno, techo - 0.01), techo, y)






static func _barrida_parte(h: float, y: float) -> Array:
	if h < BARRIDA_TIRO_H_CADERA:
		return _barrida_pierna(y)
	var e: float = float(DESV_PARTES["muslo"][0])
	if h < BARRIDA_TIRO_H_PECHO:
		return ["cadera", e, BARRIDA_TIRO_NY_ALTO]
	return ["pecho", e, BARRIDA_TIRO_NY_PECHO]













static func _barrida_lee(v: float, d0: float) -> float:
	var a: float = BARRIDA_TIRO_LEE_S * clampf((v - BARRIDA_TIRO_LEE_V0)
		/(BARRIDA_TIRO_LEE_V1 - BARRIDA_TIRO_LEE_V0), 0.0, 1.0)
	var f: float =(d0 - FALTA_PIERNA_M) / SLIDE_MAX_M
	if f < 1.0:
		var llega: float = BARRIDA_TIRO_T *(1.0 - pow(1.0 - f, 1.0 / 3.0))
		a = clampf(llega - BARRIDA_TIRO_PRE, 0.0, a)
	return a








static func _desv_normal(vel: Vector3, lado: Vector2, b: float, ny: float,
		k: float = DESV_NORMAL_K) -> Vector3:
	var f: Vector2 = - Vector2(vel.x, vel.z)
	f = f.normalized() if f.length() > 0.001 else Vector2(0.0, 1.0)
	var sd: Vector2 = lado - f * lado.dot(f)

	sd = sd.normalized() if sd.length() > 0.001 else Vector2(f.y, - f.x)
	var th: float = asin(clampf(b * k, 0.0, 1.0))
	var h: Vector2 = f * cos(th) + sd * sin(th)
	return Vector3(h.x, ny, h.y).normalized()
























static func _barrida_techo(out: Vector3, v_in: Vector3) -> Vector3:
	var h: Vector2 = Vector2(out.x, out.z)
	if out.y <= BARRIDA_TIRO_VY_MAX or out.y <= h.length():
		return out
	var dir: Vector2 = h.normalized() if h.length() > 0.3 \
			else - Vector2(v_in.x, v_in.z).normalized()
	h += dir *(out.y - BARRIDA_TIRO_VY_MAX) * BARRIDA_TIRO_VY_PASA
	return Vector3(h.x, BARRIDA_TIRO_VY_MAX, h.y)


static func _desv_rasante(n: Vector3, rasa: float) -> Vector3:
	var h: Vector2 = Vector2(n.x, n.z)
	var hl: float = h.length()
	if hl < 0.001:
		return n
	var a: float = maxf(atan2(n.y, hl), asin(clampf(rasa * DESV_RASA_K, 0.0, 1.0)))
	h /= hl
	return Vector3(h.x * cos(a), sin(a), h.y * cos(a))

















static func _desv_respuesta(vel: Vector3, spin: float, back: float, n: Vector3,
		e_p: float, seco_gate: bool, q: float) -> Dictionary:
	var v_in: float = vel.length()
	var pw: float = clampf((v_in - 10.0) / 18.0, 0.0, 1.0)
	if seco_gate and q < 1.0 - smoothstep(DESV_CTRL_PW_LO, DESV_CTRL_PW_HI, pw):
		return {"tipo": "seco", "vel": Vector3.ZERO, "spin": spin, "back": back}
	var ang: float = randf_range(- DESV_RUIDO_ANG, DESV_RUIDO_ANG)
	var nn: Vector3 = n.rotated(Vector3.UP, ang)
	var e: float = lerpf(DESV_E_AMORT, e_p, pw)
	var vn: float = vel.dot(nn)
	var piel: Vector3 = _desv_piel(vel, spin, back)
	var out: Vector3
	if vn >= 0.0:


		out = vel.rotated(Vector3.UP, ang) * DESV_ROCE_KEEP
	else:






		var jn: float = -(1.0 + e) * vn
		var ut: Vector3 = vel - nn * vn - piel.cross(nn)
		var ut_len: float = ut.length()
		var jt: Vector3 = Vector3.ZERO
		if ut_len > 0.0001:
			jt = - ut / ut_len * minf(DESV_INERCIA /(1.0 + DESV_INERCIA) * ut_len,
				DESV_MU * jn)
		out = vel + nn * jn + jt
		piel -= nn.cross(jt) / DESV_INERCIA
	out *= randf_range(0.92, 1.08)

	if out.length() > 0.98 * v_in:
		out = out.normalized() * 0.98 * v_in
	var tipo: String = "desvio"
	if out.length() < DESV_V_MUERTO:
		tipo = "seco" if seco_gate else "rechace"
	elif out.z > 0.0:
		tipo = "rechace"
	var ef: Vector2 = _desv_efecto(out, piel)
	return {"tipo": tipo, "vel": out, "spin": ef.x, "back": ef.y}






static func _desv_piel(vel: Vector3, spin: float, back: float) -> Vector3:
	var d: Vector2 = Vector2(vel.x, vel.z)
	var eje: Vector3 = Vector3.ZERO
	if d.length() > 0.001:
		d = d.normalized()
		eje = Vector3(- d.y, 0.0, d.x)
	return (Vector3.UP * spin + eje * back) * DESV_PIEL







static func _desv_efecto(vel: Vector3, piel: Vector3) -> Vector2:
	var d: Vector2 = Vector2(vel.x, vel.z)
	var back: float = 0.0
	if d.length() > 0.001:
		d = d.normalized()
		back = piel.dot(Vector3(- d.y, 0.0, d.x)) / DESV_PIEL
	return Vector2(clampf(piel.y / DESV_PIEL, - DESV_EFECTO_MAX, DESV_EFECTO_MAX),
		clampf(back, - DESV_EFECTO_MAX, DESV_EFECTO_MAX))










