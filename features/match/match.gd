	if _stadium != null and is_instance_valid(_stadium):
		_stadium.crowd_lectura(tuyo, marca, encaja, minuto)


	_tramo_final()














func _tramo_final() -> void:
	var r: Dictionary = {"tuya": "", "rival": "", "avance": 0.0}
	if state != State.ENDED and _practice_kind.is_empty() and not _festejo_revivido \
