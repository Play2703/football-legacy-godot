func _fit_drive_ring() -> void:
	_ring_world_r = Drive.RING_R

















	if not (_drive_enabled or _trap_enabled or _duel_open or _ring_gauge
			or _cobro_corre or state == State.DUEL):
		return
	var px: float = _ring_radius_px()
	if px > 1.0:
		_ring_world_r = clampf(Drive.RING_R *(RING_TARGET_PX * _pull_scale()) / px,
			RING_WORLD_MIN, RING_WORLD_MAX)






	_ring_world_r *= OPEN_RING_SCALE






func _ring_radius_px() -> float:
	var fallback: float = RING_TARGET_PX * _pull_scale()
	if not is_instance_valid(_self_actor) or _aim_cam == null:
		return fallback
	var feet: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
	var right: Vector3 = _aim_cam.global_transform.basis.x
	right.y = 0.0
	right = right.normalized() if right.length() > 0.001 else Vector3.RIGHT
	var edge: Vector3 = feet + right * _ring_world_r
	if _aim_cam.is_position_behind(feet) or _aim_cam.is_position_behind(edge):
		return fallback
	return maxf(_aim_cam.unproject_position(feet)
		.distance_to(_aim_cam.unproject_position(edge)), 1.0)




