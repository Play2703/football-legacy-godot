const CELEB_CLEAR_R: float = 1.5


func _celeb_detour(from: Vector3, to: Vector3) -> Vector3:
	var a: Vector2 = Vector2(from.x, from.z)
	var b: Vector2 = Vector2(to.x, to.z)
	var seg: Vector2 = b - a
	var largo: float = seg.length()
	if largo < 0.5:
		return to
	var dir: Vector2 = seg / largo
	var peor: float = CELEB_CLEAR_R
	var peor_t: float = 0.0
	var peor_lado: float = 0.0
	for r in _rival_actors:
		if not is_instance_valid(r):
			continue
		var p: Vector2 = Vector2(r.position.x, r.position.z) - a
		var t: float = p.dot(dir)
		if t <= 0.0 or t >= largo:
			continue
		var lado: float = p.cross(dir)
		if absf(lado) < peor:
			peor = absf(lado)
			peor_t = t
			peor_lado = lado
	if peor >= CELEB_CLEAR_R:
		return to


	var normal: Vector2 = Vector2(- dir.y, dir.x)
	var signo: float = - signf(peor_lado) if not is_zero_approx(peor_lado) else 1.0
	var via: Vector2 = a + dir * peor_t + normal * signo *(CELEB_CLEAR_R + 0.4)
	via.x = clampf(via.x, - Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0)
	return Vector3(via.x, to.y, via.y)






func _stop_celebration_runs() -> void:

	_celeb_coro.clear()



	if _stadium != null and is_instance_valid(_stadium):
		_stadium.crowd_hold(false)


		_stadium.crowd_zone_off()

		_stadium.coach_celebrate_end()






		_stadium.confetti_cannons_clear()



	if _fx != null and is_instance_valid(_fx):
		_fx.confetti_clear()


	if _audio != null and is_instance_valid(_audio):
		_audio.fiesta_hold(false)
	for tw in _celeb_runs:
		if tw and tw.is_valid():
			tw.kill()
	_celeb_runs.clear()


	for p in _celeb_props:
		if is_instance_valid(p):
			p.queue_free()
	_celeb_props.clear()


	_chin_token += 1
	_chin_socio = null
	_chin_llegados.clear()









