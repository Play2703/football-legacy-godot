	var f: float = clampf(u, 0.0, 1.0) * float(pts.size() - 1)
	var i: int = int(floorf(f))
	var j: int = mini(i + 1, pts.size() - 1)
	_ball.position = pts[i].lerp(pts[j], f - float(i))


