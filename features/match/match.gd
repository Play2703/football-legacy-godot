			ya = true
			break
	if not ya:
		campo.append([TEAM_TEX, fan, fan])
		_fan_calentado = fan
	for look in campo:
		if look[0] == KEEPER_TEX or _frames_cache.has(_frames_key(look[0], look[1])):
			continue
		var pares_campo: Array = []
