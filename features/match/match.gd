func _duel_steal_step() -> bool:



	_avisa_robo(_margen_robo(_duel_defs, _duel_def_tackles, _duel_control))





	if not Settings.dif_steal_on():
		return false



	var pace_robo: float = clampf(
		_duel_vel.length() / maxf(_duel_run_spd, 0.01), 0.0, 1.0)
	var thief: int = Duel.stealer(_duel_defs, _ball_field, _duel_control,
		_duel_def_tackles, _lance_bonus(_duel_defs), _duel_pos, pace_robo)
	if thief < 0:
		return false








	var t_edge: float = _duel_def_tackles[thief] if thief < _duel_def_tackles.size() \
			else Duel.NEUTRAL_TACKLE



	var t_read: float = _duel_def_leads[thief] if thief < _duel_def_leads.size() else 0.0




	var dado: float = _duel_dado_forzado if _duel_dado_forzado >= 0.0 else randf()






	var tactica: bool = Duel.pro_foul(_duel_defs[thief], _ball_field, t_read,
		_duel_defs, thief)






	var es_falta: bool = not _eslalon and (Duel.steal_is_foul(_duel_defs[thief],
		_ball_field, t_edge, _duel_control, dado) or tactica)





	if not _eslalon and _pique_dispara(thief):
		_bump(BUMP_ROBO)
		_finish_duel_foul(false, true, _duel_def_actors[thief])
		return true
	if thief < _duel_def_actors.size():
		_play_slide_gesture(_duel_def_actors[thief],
			_duel_pos if es_falta else Vector2.INF)



	_bump(BUMP_ROBO)







	if _eslalon:
		_despeje_barrida(thief)
		_eslalon_pierde()
		return true
	if es_falta:




		_finish_duel_foul(false, tactica, _duel_def_actors[thief]
			if thief < _duel_def_actors.size() else null)
	else:





		_despeje_barrida(thief)
		_dado_robo()
		_finish_duel(false)
	return true














func _dado_robo() -> void:
	if not _practice_kind.is_empty() or _shootout_active or _extra_time \
			or GameState.readonly_save or not Career.live_match_open() \
			or _injured_out or _hooked or _sub_done \
			or Career.pending_injury_weeks > 0:
		return
	if randf() >= Career.live_injury_steal_p():
		return
	_injury_strike(match_minute, true)


	_audio.dolor(true)






























const BARRIDA_DESPEJE_S: float = 0.95
const BARRIDA_DESPEJE_MIN: float = 2.0
const BARRIDA_DESPEJE_MAX: float = 5.5
const BARRIDA_DESPEJE_T: float = 0.75






var _despeje_tw: Tween


func _despeje_barrida(thief: int) -> void:
	_despedir_balon(_duel_def_vels[thief] if thief < _duel_def_vels.size()
		else Vector2.ZERO, _duel_facing, true)














func _despedir_balon(v: Vector2, respaldo: Vector2, corral_regate: bool) -> void:
	if _ball == null or not is_instance_valid(_ball):
		return











	var dir: Vector2 = _slide_dir
	if dir.length_squared() < 0.0001:
		dir = v.normalized() if v.length() > 0.15 else respaldo
	if dir.length_squared() < 0.0001:
		return
	var largo: float = clampf(v.length() * BARRIDA_DESPEJE_S,
		BARRIDA_DESPEJE_MIN, BARRIDA_DESPEJE_MAX)
	var suelto: Vector2 = _ball_field + dir * largo
	var destino: Vector2 = _duel_corral(suelto) if corral_regate else Vector2(
		clampf(suelto.x, - Stadium.FIELD_HALF_W - 2.5, Stadium.FIELD_HALF_W + 2.5),
		clampf(suelto.y, -2.5, Stadium.FIELD_DEPTH + 2.5))
	_ball_field = destino


	_ball.play("roll")
	_ball.speed_scale = 1.6
	if _despeje_tw != null and _despeje_tw.is_valid():
		_despeje_tw.kill()
	_despeje_tw = create_tween()
	_despeje_tw.set_parallel(true)
	_despeje_tw.tween_property(_ball, "position",
		Vector3(destino.x, BALL_VISUAL_D * 0.5, destino.y), BARRIDA_DESPEJE_T) \
				.set_trans(Tween.TRANS_QUINT).set_ease(Tween.EASE_OUT)
	_despeje_tw.tween_property(_ball, "speed_scale", 0.2, BARRIDA_DESPEJE_T) \
			.set_trans(Tween.TRANS_QUINT).set_ease(Tween.EASE_OUT)
























































func _press_recluta_cercanos(solo_atras: bool = false) -> void:
	if _press_sin_guardias:
		return






	var cuenta: int = 0
	for d in _duel_defs:
		if float((d as Vector2).y) < _ball_field.y + PRESS_REZAGADO_M:
			cuenta += 1
	for i in range(_duel_world_rivals.size() - 1, -1, -1):
		if cuenta >= PRESS_OUT_MAX_DEFS:
			return
		var a: AnimatedSprite3D = _duel_world_rivals[i]
		if not is_instance_valid(a):
			continue
		var p: Vector2 = Vector2(a.position.x, a.position.z)
		if p.distance_to(_ball_field) > PRESS_WORLD_CLEAR:
			continue


		if solo_atras and p.y <= _ball_field.y + 2.0:
			continue


		if _press_promote_guard(p, false, i):
			cuenta += 1


func _press_out_step(delta: float) -> void:





	if _eslalon:
		_eslalon_step(delta)
		return




	_press_recluta_cercanos()








