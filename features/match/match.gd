		/ maxf(CEDIDA_LIBRE_D_LEJOS - CEDIDA_LIBRE_D_DULCE, 0.001), 0.0, 1.0)
	return lerpf(1.0, CEDIDA_LIBRE_D_SUELO, t)







func _cobro_cedido_entra(penal: bool, ficha: Dictionary = {}) -> bool:
	return randf() < _cobro_cedido_p(penal, ficha)





func _cobro_cedido_p(penal: bool, ficha: Dictionary = {}) -> float:
	var key: String = "penal" if penal else "parado"




	var tirador: float = Squad.norm(ficha if not ficha.is_empty()
		else Squad.best_specialist(_my_side_id(), key), key)
	var portero: float = Squad.keeper_skill(
		Squad.keeper(String(GameState.current_rival().get("id", ""))))
	if penal:
		return clampf(
			CEDIDA_PENAL_BASE + tirador * CEDIDA_PENAL_TIRADOR
				- portero * CEDIDA_PENAL_PORTERO,
			CEDIDA_PENAL_TOPES.x, CEDIDA_PENAL_TOPES.y)
	return clampf(
		CEDIDA_LIBRE_BASE + tirador * CEDIDA_LIBRE_TIRADOR
			- portero * CEDIDA_LIBRE_PORTERO,
		CEDIDA_LIBRE_TOPES.x, CEDIDA_LIBRE_TOPES.y) * _cedida_libre_dist_f()






