func _barrida_candidato(pos: Vector3, vel: Vector3, tuyo: bool, libre_npc: int) -> Dictionary:
	if not (tuyo and _desv_on and _barrida_on and libre_npc == LibreNpc.NO) \
			or vel.z >= 0.0 or _chance_kind in AimPress.SET_KINDS \
			or not Settings.dif_steal_on() or _tutorial_active \
			or not _practice_kind.is_empty() or _header_chance or _serve_primera:
		return {}
	var mejor: int = -1
	var mejor_d: float = BARRIDA_TIRO_R
	var b: Vector2 = Vector2(pos.x, pos.z)
	var ahora: int = Time.get_ticks_msec()
	for d_i in mini(_defender_pos.size(), _rival_actors.size()):
		var a = _rival_actors[d_i]
		if not is_instance_valid(a) or a.has_meta("hold_wall") or _order_owned(a):
			continue



		if int(a.get_meta("caido_t", 0)) > ahora:
			continue
		var dd: float = _defender_pos[d_i].distance_to(b)
		if dd < mejor_d and _barrida_pintable(a):
			mejor_d = dd
			mejor = d_i
	if mejor < 0:
		return {}
	return {"i": mejor, "d": _defender_pos[mejor], "a": _rival_actors[mejor]}












