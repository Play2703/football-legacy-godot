	if _goal_guardados.has(gol_id):

		_album_vuelve(String(_goal_guardados[gol_id]), "", gol_id)
		return
	_goal_guardando[gol_id] = true
	guarda_repe(gol_id, miniatura, _album_vuelve.bind(gol_id))


