func _relax_defenders() -> void:
	var mates: Array[AnimatedSprite3D] = []
	for t in _teammate_actors:
		if is_instance_valid(t):
			mates.append(t)
	if _defender_pos.size() + mates.size() < 2:
		return
	var frozen: Dictionary = {}








	var last_i: int = _last_defender_index()
	if last_i >= 0:
		frozen[last_i] = true
	for i in _defender_pos.size():
		var a: AnimatedSprite3D = _rival_actors[i] if i < _rival_actors.size() else null
		if is_instance_valid(a) and a.has_meta("hold_wall"):
			frozen[i] = true




	var pts: PackedVector2Array = PackedVector2Array(_defender_pos)
	var off: int = pts.size()
	for m in mates:
		pts.append(Vector2(m.position.x, m.position.z))


		if _anim_lock.get(m, 0) > Time.get_ticks_msec():
			frozen[pts.size() - 1] = true
	var out: PackedVector2Array = Crowding.relax_packed(pts, Crowding.SEP, Crowding.EASE,
		Crowding.marcas(frozen, pts.size()))
	for i in _defender_pos.size():
		if out[i] == _defender_pos[i]:
			continue
		_defender_pos[i] = _inside_field(out[i])
		var a: AnimatedSprite3D = _rival_actors[i] if i < _rival_actors.size() else null
		if is_instance_valid(a):
			a.position = Vector3(_defender_pos[i].x, a.position.y, _defender_pos[i].y)












	for i in mates.size():
		if out[off + i] == pts[off + i]:
			continue
		var m: AnimatedSprite3D = mates[i]
		var p: Vector2 = _inside_field(Vector2(out[off + i].x, pts[off + i].y))
		m.position = Vector3(p.x, m.position.y, p.y)














func _drive_stolen(i: int, limpio: bool = false) -> void:
	if i < 0 or i >= _defender_pos.size():
		return
	var pace: float = clampf(_drive_vel.length() / maxf(_drive_run_spd, 0.01), 0.0, 1.0)
	var foul: bool = not limpio \
			and Drive.is_foul(_defender_pos[i], _ball_field, _drive_facing, pace)




	if foul and _choque_lo_pierdes(i):
		foul = false



	if i < _rival_actors.size():

		_play_slide_gesture(_rival_actors[i], _drive_pos if foul else Vector2.INF)

		_cara(_rival_actors[i], "alegria" if not foul else "muerde", 2.5)
	_cara(_self_actor, "dolor" if foul else "rabia", 2.5)
	_stop_drive()
	_haptic(50 if foul else 30)





	_bump(BUMP_FALTA if foul else BUMP_ROBO)
	if not foul:


		_al_contacto(_play_self_fall.bind(_drive_facing, DUEL_LOST_HOLD_MS))



		var tirador: AnimatedSprite3D = _robo_area_conduce(i)





		_despedir_balon(_press_vels[i] if i < _press_vels.size() else Vector2.ZERO,
			_drive_facing, false)
		if tirador != null:
			_robo_area_compas(tirador)
			return
		_resolve_chance("dribble_lost")
		return



	var rumbo_caida: Vector2 = _drive_facing
	_al_contacto(func() -> void:
		_play_self_fall(rumbo_caida, DUEL_FOUL_HOLD_MS)
		_audio.dolor())


	_al_contacto_siempre(_falta_grada.bind(_in_penalty_box(_ball_field)))
	_momentum.register("dribble_foul")
	_push_momentum()


	if not _practice_kind.is_empty():
		_resolve_chance("dribble_lost")
		return


	var penal_drive: bool = _in_penalty_box(_ball_field)

	if _salida_falta(penal_drive):
		return

	if _falta_la_cobra_otro(penal_drive):
		_cobro_cedido(penal_drive)
		return
	_drive_beat = true
	_chain_after_duel(_foul_chance(), I18n.t("¡PENAL! Se cobra en los once metros")
		if penal_drive else I18n.t("¡FALTA! Se cobra aquí mismo"),
		DUEL_FOUL_BEAT, State.AIMING)





var _choque_dado: float = -1.0












func _choque_lo_pierdes(i: int) -> bool:
	if not _practice_kind.is_empty():
		return false
	if _in_penalty_box(_ball_field, OWN_GOAL_Z):
		return false
	var a: AnimatedSprite3D = _rival_actors[i] \
			if i >= 0 and i < _rival_actors.size() else null
	var dado: float = _choque_dado if _choque_dado >= 0.0 else randf()


	return Drive.falta_es_tuya(_drive_control_base, _rival_lead(a), _carry_fisico,
		_rival_peso(a), _carry_fatigue, dado)











































