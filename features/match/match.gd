func _drop_nearest(pos: Array, ball: Vector2, n: int) -> Array:
	if n <= 0:
		return pos.duplicate()
	var idx: Array = range(pos.size())
	idx.sort_custom(func(a, b): return \
			(pos[a] as Vector2).distance_squared_to(ball) \
			<(pos[b] as Vector2).distance_squared_to(ball))
	var drop: Dictionary = {}
	for i in mini(n, idx.size()):
		drop[idx[i]] = true
	var out: Array = []
	for i in pos.size():
		if not drop.has(i):
			out.append(pos[i])
	return out






































