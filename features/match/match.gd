func _paso_balon(delta: float, spd_now: float) -> void:




	_paso_balon_carry(_duel_steer, _duel_pos, _duel_vel, _duel_facing, spd_now,
		_duel_control, _duel_accel, _def_mas_cerca(),
		Callable(self, "_duel_corral_balon"), delta)






var _carry_facing_prev: Vector2 = Vector2.ZERO
var _carry_omega: float = 0.0



var _carry_perdido_t: float = 0.0






















func _carry_foto(facing: Vector2) -> void:
	_carry_omega = 0.0
	_carry_facing_prev = facing
	_carry_perdido_t = 0.0











func _paso_balon_carry(steer: Vector2, pos: Vector2, vel: Vector2, facing: Vector2,
		spd_now: float, control: float, accel: float, def_d: float, corral: Callable,
		delta: float) -> void:
	if steer.length_squared() < 0.0001:



		_carry_omega = 0.0
		_carry_facing_prev = facing
		_carry_perdido_t = 0.0
		_ball_vel = Vector2.ZERO
		_toque_t = Duel.TOQUE_CD
		_toque_dir = facing
		var quieto: Vector2 = Duel.step_ball(_ball_field, pos, vel, facing, spd_now, delta)
		_ball_field = corral.call(quieto) if corral.is_valid() else quieto
		return




	_carry_omega = Duel.omega_carrera(_carry_omega, _carry_facing_prev, facing, delta)
	_carry_facing_prev = facing
	var paso: Dictionary = Duel.paso_toque(
		{"ball": _ball_field, "bvel": _ball_vel, "toque_t": _toque_t,
			"toque_dir": _toque_dir, "perdido_t": _carry_perdido_t},
		pos, vel, facing, spd_now, control, def_d, delta, accel, _carry_omega)
	_toque_t = paso["toque_t"]
	_toque_dir = paso["toque_dir"]
	_carry_perdido_t = paso["perdido_t"]
	if paso["toque"]:


		_audio.toque(paso["fuerza"])





		_haptic(int(roundf(lerpf(6.0, 12.0, clampf(paso["fuerza"], 0.0, 1.0)))))
	var libre: Vector2 = paso["ball"]
	_ball_field = corral.call(libre) if corral.is_valid() else libre
	_ball_vel = paso["bvel"]



	if not _ball_field.is_equal_approx(libre):
		_ball_vel = Vector2.ZERO













