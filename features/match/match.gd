func _registra_baja_ajena(line: Dictionary) -> Dictionary:
	var lado: String = String(line.get("team", ""))
	var nombre: String = String(line.get("name", ""))


	if lado == "rival":
		_anota_baja_rival(nombre, "les")
	elif lado == "you":
		_anota_baja_propia(nombre, "les")
	if nombre.is_empty() or lado.is_empty() or _baja_ajena.has(lado) \
			or not _practice_kind.is_empty() or _tutorial_active:
		return {}
	var team_id: String = _my_side_id() if lado == "you" \
			else String(GameState.current_rival().get("id", ""))
	if team_id.is_empty():
		return {}



	var minuto: int = int(line.get("minute", match_minute))
	var asiento_caido: int = _asiento_de_nombre(team_id, nombre)
	if not quedan_cambios(team_id):
		_apunta_cambio_club(team_id, asiento_caido, -1, minuto)





		_baja_ajena[lado] = {"fuera": nombre, "ficha": {}}
		if lado == "rival":
			_rival_con_uno_menos(nombre)
		else:
			_mio_con_uno_menos(nombre)
		return {}


	var excluye: Dictionary =(_salieron.get(team_id, {}) as Dictionary).duplicate()
	excluye.merge(_ausentes(team_id))
	var sub: Dictionary = Squad.suplente_para(team_id, nombre, lado == "you",
		excluye, _fundidos(team_id))
	if sub.is_empty():
		_apunta_cambio_club(team_id, asiento_caido, -1, minuto)
		return {}
	var efectivo: Array = Squad.of(team_id)
	var sale: int = int((efectivo[int(sub["fuera"])] as Dictionary).get(Squad.SEAT_KEY,
		int(sub["fuera"])))
	var entra: int = int((efectivo[int(sub["entra"])] as Dictionary).get(Squad.SEAT_KEY,
		int(sub["entra"])))
	var orden: Array = Squad.orden_con_cambio(efectivo, sale, entra)
	if orden.is_empty():
		_apunta_cambio_club(team_id, asiento_caido, -1, minuto)
		return {}
	Squad.set_match_lineup(team_id, orden)
	gasta_cambio(team_id)
	_anota_salida(team_id, nombre)
	_apunta_cambio_club(team_id, sale, entra, minuto)
	_baja_ajena[lado] = {"fuera": nombre, "ficha": sub["ficha"]}
	return sub["ficha"]









func _fundidos(team_id: String) -> Dictionary:
	var out: Dictionary = {}
	var nominal: Array = Squad.of_nominal(team_id)
	var meta: Array = Career.squad_meta_of(team_id)
	if nominal.is_empty() or meta.size() != nominal.size():
		return out
	for i in nominal.size():
		if float(Rotation.energia(meta[i])) < Standing.UNFIT_ENERGY:
			out[String((nominal[i] as Dictionary).get("name", ""))] = true
	return out








