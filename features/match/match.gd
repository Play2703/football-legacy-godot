func _reschedule_chances() -> void:


	if chance_index > _chance_minutes.size():
		return

	var kept: int = clampi(chance_index, 0, _chance_minutes.size())
	var head: Array[int] = _chance_minutes.slice(0, kept)

	var tail_base: int = maxi(0, _base_chances - kept)
	var tail_n: int = 0
	if tail_base > 0:










		var suelo: int = 1 if kept == 0 else 1 + Settings.dif_ocasiones_add()
		tail_n = clampi(MatchPlan.chances_for(tail_base, Career.intensity, _chem_cap, suelo),
			0, mini(MAX_CHANCES_PER_MATCH, _chem_cap) - kept)
	if tail_n > 0:


		var after: int = _chance_minutes[kept - 1] if kept > 0 else match_minute








		var tail_first: int = maxi(maxi(after, match_minute) + 2, _chance_lo)


		var room: int = 0 if tail_first > _chance_hi \
				else 1 +(_chance_hi - tail_first) / 2
		tail_n = mini(tail_n, room)
		if tail_n > 0:
			head.append_array(_build_chance_minutes(tail_n, tail_first, _chance_hi))









	if tail_n == 0 and _chance_minutes.size() > kept:
		head.append_array(_chance_minutes.slice(kept))



	if tail_n > 0 and _prisa_extra_idx > kept:
		var m: int = maxi(_prisa_extra_min, int(head.back()) + 2) if not head.is_empty() \
				else _prisa_extra_min
		var tope: int = mini(PRISA_EXTRA_TOPE_PRORROGA if _extra_time \
				else PRISA_EXTRA_TOPE, _play_to - 1)
		if m <= tope:
			head.append(m)
			_prisa_extra_min = m
			_prisa_extra_idx = head.size()
		else:
			_prisa_extra_idx = -1
	var new_total: int = head.size()
	_chance_minutes = head
	_chances_this_match = maxi(new_total, kept)





	var jugadas: Array[int] = []
	for c in _press_chances:
		if int(c) <= chance_index:
			jugadas.append(int(c))





	var meta_jugadas: Array[int] = []
	for c in _meta_chances:
		if int(c) <= chance_index:
			meta_jugadas.append(int(c))



	var serv_jugadas: Array[int] = []
	for c in _servicio_chances:
		if int(c) <= chance_index:
			serv_jugadas.append(int(c))
	_servicio_chances = serv_jugadas.duplicate()
	var evita_press: Array[int] = meta_jugadas.duplicate()
	evita_press.append_array(serv_jugadas)
	_schedule_press_out(evita_press)

	for c in jugadas:
		if not _press_chances.has(c):
			_press_chances.append(c)

	var limpio: Array[int] = []
	for c in _press_chances:
		if int(c) > chance_index or jugadas.has(int(c)):
			limpio.append(int(c))
	_press_chances = limpio



	var recu_jugadas: Array[int] = []
	for c in _recu_chances:
		if int(c) <= chance_index:
			recu_jugadas.append(int(c))












	_schedule_recu(chance_index + 1, recu_jugadas)
	for c in recu_jugadas:
		if not _recu_chances.has(c):
			_recu_chances.append(c)
	var recu_limpio: Array[int] = []
	for c in _recu_chances:
		if int(c) > chance_index or recu_jugadas.has(int(c)):
			recu_limpio.append(int(c))
	_recu_chances = recu_limpio




	_schedule_servicio(chance_index + 1, serv_jugadas)
	for c in serv_jugadas:
		if not _servicio_chances.has(c):
			_servicio_chances.append(c)














