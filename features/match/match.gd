func _servicio_aviso_tick() -> void:
	var toca: bool = _serve_vivo and state == State.STRIKING and not _strike_locked \
			and _serve_i < _serve_k and _hud != null and _serve_ruta.size() > _serve_k
	var rect := Rect2(Vector2.ZERO, SceneFade.rect_visible(self).size)
	var mitad: float = BALL_VISUAL_D * 0.5
	if toca and _servicio_en_plano(_ball.position, rect):
		toca = false
	if not toca:
		if _serve_aviso != null:
			_serve_aviso.apaga()
		return
	var centro: Vector2 = rect.get_center()
	var borde: Vector2 = Vector2.INF
	for j in range(_serve_i + 1, _serve_k + 1):
		var q: Vector3 = _serve_ruta[j] + Vector3(0.0, mitad, 0.0)
		if not _servicio_en_plano(q, rect):
			continue
		var dentro: Vector2 = _shot_cam.unproject_position(q)
		var antes: Vector3 = _serve_ruta[j - 1] + Vector3(0.0, mitad, 0.0)
		var fuera: Vector2 = centro +(dentro - centro) * 8.0
		if not _shot_cam.is_position_behind(antes):
			fuera = _shot_cam.unproject_position(antes)
		borde = _servicio_cruce_borde(fuera, dentro, rect)
		break
	if borde == Vector2.INF:


		var b: Vector3 = _ball.position
		var hacia: Vector2 = Vector2(0.0, 1.0)
		if not _shot_cam.is_position_behind(b):
			hacia = _shot_cam.unproject_position(b) - centro
		borde = _servicio_cruce_borde(centro + hacia.normalized() * rect.size.length(),
			centro, rect)
	if _serve_aviso == null:
		_serve_aviso = SERVICIO_AVISO.new()
		_hud.attach_under_text(_serve_aviso)
	var falta: float = float(_serve_k - _serve_i) * SIM_DT
	_serve_aviso.muestra(borde, centro - borde, 1.0 - falta / SERVICIO_MANDO_ANTES,
		_servicio_cita_abierta())



func _servicio_en_plano(p: Vector3, rect: Rect2) -> bool:
	if _shot_cam.is_position_behind(p):
		return false
	return rect.has_point(_shot_cam.unproject_position(p))




static func _servicio_cruce_borde(fuera: Vector2, dentro: Vector2, rect: Rect2) -> Vector2:
	var a: Vector2 = fuera
	var b: Vector2 = dentro
	for _i in 14:
		var m: Vector2 =(a + b) * 0.5
		if rect.has_point(m):
			b = m
		else:
			a = m
	return b




