]









const SWITCH_CROSS: float = 10.0






const SWITCH_ADV: Vector2 = Vector2(0.0, 18.0)
const SWITCH_X_MAX: float = 28.0
const SWITCH_Z_MIN: float = 16.0
const SWITCH_RIVALS: Vector2i = Vector2i(3, 5)



const SWITCH_HELPERS: Vector2i = Vector2i(1, 2)






