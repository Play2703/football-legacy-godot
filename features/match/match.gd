	card["pegada"] = int(round(Career.skills.get("potencia", 70)))
	card["punteria"] = int(round(Career.skills.get("precision", 70)))
	card["rosca"] = int(round(Career.skills.get("efecto", 70)))
	card["cabeza"] = int(round(Career.skills.get("fisico", 70)))
	card["velocidad"] = int(round(Career.skills.get("velocidad", 70)))
	card["aceleracion"] = int(round(Career.skills.get("aceleracion", 70)))
	card["is_you"] = true
	return card




































func _pick_finish(dist: float, lateral: float, header: bool, p: Dictionary,
		keeper_out: float = 0.0) -> String:
	var w: Dictionary = {}
	if header:


		var head: float = Squad.norm(p, "cabeza")
		var ang: float = clampf(absf(lateral) / 3.5, 0.0, 1.0)
		w["peinado"] = 0.2 + 1.7 * head * ang *(1.0 if dist < 9.0 else 0.35)
		w["picado"] = 1.0 + 0.7 *(1.0 - ang)






		w["colgado"] = 2.0 * head * head * clampf((dist - 5.0) / 6.0, 0.0, 1.0)
		return _weighted_pick(w)
	var curl: float = Squad.norm(p, "rosca")
	var aim: float = Squad.norm(p, "punteria")
	var power: float = Squad.norm(p, "pegada")

	var near: float = clampf(1.0 - dist / 14.0, 0.0, 1.0)
	var far: float = clampf((dist - 10.0) / 12.0, 0.0, 1.0)
	var side: float = clampf((absf(lateral) - 3.0) / 6.0, 0.0, 1.0)





	w["colocado"] = 0.3 + 1.05 * aim *(0.35 + near)
	w["potente"] = 0.45 + 1.7 * power * far



	w["rosca"] = 1.9 * curl *(0.25 + side) * clampf((dist - 3.5) / 8.0, 0.12, 1.0)





	w["escuadra"] = 0.85 * aim * aim * clampf((dist - 3.0) / 5.0, 0.0, 1.0) \
			* clampf(1.0 -(dist - 13.0) / 12.0, 0.35, 1.0)




	w["vaselina"] = aim * near *(0.35 + 2.2 * clampf(keeper_out, 0.0, 1.0))
	return _weighted_pick(w)





func _weighted_pick(w: Dictionary) -> String:
	var total: float = 0.0
	for k in w:
		total += maxf(float(w[k]), 0.0)
	if total <= 0.0:
		return String(w.keys()[0])
	var r: float = randf() * total
	for k in w:
		r -= maxf(float(w[k]), 0.0)
		if r <= 0.0:
			return String(k)
	return String(w.keys()[w.size() - 1])




