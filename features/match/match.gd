func _rival_by_advance(con_fuera: bool = false) -> Array:



	var out: Array = []




	for p in _squad_hoy(String(GameState.current_rival().get("id", ""))) \
			.slice(0, Squad.STARTING_XI):
		if String(p.get("pos", "")) == "POR":
			continue
		if not con_fuera and MatchSim.esta_fuera(false, String(p.get("name", ""))):
			continue
		out.append(p)
	out.sort_custom(func(a, b): return \
			int(POS_ADVANCE.get(String(a.get("pos", "")), 2)) \
			> int(POS_ADVANCE.get(String(b.get("pos", "")), 2)))
	return out


































