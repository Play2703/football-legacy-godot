func _recu_mando_puede(c: int) -> bool:



	if not _recu or _recu_over or _recu_tiro:
		return false













	if _recu_mando_hecho:
		return false






	if _recu_yo_barr > 0.0:
		return false
	if c < 0 or c >= _recu_def_pos.size() or c >= _recu_def_act.size():
		return false
	var quien: AnimatedSprite3D = _recu_def_act[c]



	return is_instance_valid(quien) and is_instance_valid(_self_actor) \
			and quien != _self_actor









































