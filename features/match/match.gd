}







const AI_SPIN_SCALE: float = 0.75






const AI_BEND_COMP: float = 0.7
















const AI_AIM_NEAR_M: float = 13.0
const AI_AIM_FAR_DIV: float = 34.0
const AI_AIM_FAR_MIN: float = 0.55








const AI_AIM_CONE: float = 58.0







const AI_AIM_MAX_OFF: float = 3.6









const AI_AIM_TIGHT_FRAC: float = 0.84











const AI_AIM_CORNER: float = 0.92












const AI_PLACE_POST_MIN: float = 0.88



const AI_PLACE_READ_MIN: float = 0.68





const AI_PLACE_OUT_MIN: float = 0.45
const AI_PLACE_OUT_MAX: float = 0.9
const AI_PLACE_IN_MIN: float = 0.35
const AI_PLACE_IN_MAX: float = 0.9





func _finisher_place(p: Dictionary, header: bool) -> float:
	return Squad.norm(p, "cabeza" if header else "punteria")






const TOUCH_SHOT_POWER_MIN: float = 0.86
const TOUCH_SHOT_ERR_MAX: float = 1.7
const TOUCH_MISHIT_MAX: float = 1.9






const AI_ERR_FRAME_FRAC: float = 0.85





const AI_VERT_ERR: float = 0.4







const AI_DRAG_T: float = 1.08













func _bend_comp(spin: float, speed: float, dist: float, comp: float) -> float:
	if absf(spin) < 0.01:
		return 0.0
	var t_fly: float = maxf(dist / maxf(speed, 1.0), 0.05)
	var drift: float = 0.5 * absf(spin) * CURL_ACCEL \
			* minf(speed / CURL_REF_SPEED, 1.0) * t_fly * t_fly * comp
	return - signf(spin) * atan2(drift, maxf(dist, 0.5))






func _shoot_as(arch: String, p: Dictionary, bp: Vector3, dir_h: Vector3,
		dist: float, header: bool, chilena: bool = false) -> void:
	var k: Array = FINISH_KIND[arch]
	var power: float = Squad.norm(p, "pegada")
	var aim: float = Squad.norm(p, "punteria")
	var curl: float = Squad.norm(p, "rosca")
	var head: float = Squad.norm(p, "cabeza")
	if header:
		power = head



	var precision: float = head if header else aim
	if chilena:


		power = Squad.norm(p, "pegada")
		precision = aim









	var touch: float = clampf(_touch_q, 0.0, 1.0)
	var speed: float = lerpf(11.5, 24.0, clampf(dist / 26.0, 0.0, 1.0)) \
			* float(k[0]) *(0.72 + 0.55 * power) * randf_range(0.92, 1.08) \
			* lerpf(TOUCH_SHOT_POWER_MIN, 1.0, touch)



	var err: float = float(k[4]) *(0.55 + dist / 20.0) \
			*(1.0 + absf(bp.x) / 18.0) *(1.55 - 1.25 * precision) \
			* lerpf(TOUCH_SHOT_ERR_MAX, 1.0, touch)
	if chilena:


		err *= CHILENA_ERR













	var a_izq: float = atan2(- GOAL_AIM_INNER_X - bp.x, maxf(bp.z, 0.5))
	var a_der: float = atan2(GOAL_AIM_INNER_X - bp.x, maxf(bp.z, 0.5))
	err = minf(err, rad_to_deg(absf(a_der - a_izq)) * 0.5 * AI_ERR_FRAME_FRAC)






	if randf() < 0.3 *(1.0 - precision) * lerpf(TOUCH_MISHIT_MAX, 1.0, touch):
		speed *= 0.62
		err *= 2.2
	var shot_dir: Vector3 = dir_h.rotated(Vector3.UP,
		deg_to_rad(randf_range(- err, err)))





















	var start_y: float = clampf(bp.y - BALL_VISUAL_D * 0.5, 0.8, 2.1) if header \
			else clampf(bp.y - BALL_VISUAL_D * 0.5, 0.0, 2.1)
	var flight: float = maxf(dist / maxf(speed, 1.0), 0.05)
	var flight_eff: float = flight * AI_DRAG_T
	var vy: float =(float(k[1]) - start_y) / flight_eff + 0.5 * 9.8 * flight_eff












	vy += tan(deg_to_rad(clampf(randf_range(- err, err) * AI_VERT_ERR, -35.0, 35.0))) \
			* speed

	vy = clampf(vy, -2.2 if header or start_y > 0.3 else 0.2, 9.5)






	var bend: float = head if header else curl
	var spin: float = randf_range(float(k[2]), float(k[3])) \
			*(0.2 + 0.7 * bend) * AI_SPIN_SCALE
	spin *= 1.0 if bp.x >= 0.0 else -1.0
	if arch == "potente" or arch == "picado" or arch == "vaselina":
		spin *= 1.0 if randf() < 0.5 else -1.0




	shot_dir = shot_dir.rotated(Vector3.UP,
		_bend_comp(spin, speed, dist, AI_BEND_COMP))



	_shot_pace = clampf((speed - 10.0) / 18.0, 0.0, 1.0)
	_power_ratio = _shot_pace



	_last_finish = arch
	_simulate_flight(Vector3(bp.x, start_y, bp.z), shot_dir * speed + Vector3(0.0, vy, 0.0), spin)




func _blocked_to_clear() -> void:
	_hud.show_message(I18n.t("¡Bloqueado!"), Color("ffb0b0"), 0.8)
	var blocker: AnimatedSprite3D = null
	var best: float = 999.0
	for r in _rival_actors:
		if is_instance_valid(r):
			var d: float = _flat_dist(r.position, _ball.position)
			if d < best:
				best = d
				blocker = r
	_last_toucher = blocker

	_olympic_live = false
	state = State.PASSING
	_rival_clear()














func _keeper_claim_ball() -> void:
