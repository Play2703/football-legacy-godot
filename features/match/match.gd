static var _frames_live: Dictionary = {}



static func _frames_hit(key: String) -> SpriteFrames:



	KitRecolor.candado_toma()
	var v: Variant = _frames_cache.get(key)
	if v is SpriteFrames:
		_frames_live[key] = true
		_frames_cache.erase(key)
		_frames_cache[key] = v
	KitRecolor.candado_suelta()
	return v if v is SpriteFrames else null










static func _frames_put(key: String, frames: SpriteFrames) -> void:




	frames.set_meta("frames_key", key)
	KitRecolor.candado_toma()
	_frames_cache.erase(key)
	_frames_live[key] = true
	while _frames_cache.size() >= FRAMES_CACHE_MAX:
		var viejo: String = ""
		for k in _frames_cache:
			if not _frames_live.has(k):
				viejo = String(k)
				break
		if viejo.is_empty():
			break
		_frames_cache.erase(viejo)
		_frames_full.erase(viejo)
	_frames_cache[key] = frames
	KitRecolor.candado_suelta()





