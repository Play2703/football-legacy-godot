func _rival_eleven_at(ball: Vector2, con_fuera: bool = false) -> Dictionary:
	_ensure_shapes()
	var riv: Dictionary = GameState.current_rival()
	var line_k: float = 1.0
	if not riv.is_empty():
		line_k = lerpf(PRESS_LINE_K.x, PRESS_LINE_K.y,
			float(Tactics.profile(String(riv.get("id", "")),
				int(riv.get("rating", 62))).get("bloque", 0.5)))
	var pos: Array = ScenarioStore.formation_positions(
		_rival_shape, true, ball, "AUTO", {"line_k": line_k})
	var fichas: Array = _rival_by_advance(true)
	var idx: Array = range(pos.size())
	idx.sort_custom(func(a, b): return (pos[a] as Vector2).y >(pos[b] as Vector2).y)
	var players: Array = []
	players.resize(pos.size())
	for k in idx.size():
		players[idx[k]] = {} if fichas.is_empty() else fichas[k % fichas.size()]
	if con_fuera or MatchSim._fuera.is_empty():
		return {"pos": pos, "players": players}
	var pos_hoy: Array = []
	var players_hoy: Array = []
	for i in pos.size():
		if MatchSim.esta_fuera(false, String((players[i] as Dictionary).get("name", ""))):
			continue
		pos_hoy.append(pos[i])
		players_hoy.append(players[i])
	if pos_hoy.is_empty():
		return {"pos": pos, "players": players}
	return {"pos": pos_hoy, "players": players_hoy}


















const PRESS_WORLD_CLEAR: float = 7.0


func _settle_world(pts: Array, actives: Array, ball: Vector2,
		r_balon: float = EXTRA_SEP) -> Array:
	var kept: Array = []
	for p0 in pts:
		var p: Vector2 = p0



		for _pass in 3:
			for q in actives:
				p = _push_out(p, q, EXTRA_SEP)
			for q in kept:
				p = _push_out(p, q, EXTRA_SEP)
			p = _push_out(p, ball, r_balon)
		kept.append(Vector2(clampf(p.x, - FIELD_EDGE, FIELD_EDGE),
			clampf(p.y, 1.5, EXTRA_BACK)))
	return kept












func _press_world(ball: Vector2, once: Dictionary, defs: Array) -> Dictionary:
	var riv_pos: Array = once["pos"]
	var riv_pl: Array = once["players"]
	var idx: Array = range(riv_pos.size())
	idx.sort_custom(func(a, b): return \
			(riv_pos[a] as Vector2).distance_squared_to(ball) \
			<(riv_pos[b] as Vector2).distance_squared_to(ball))
	var salio: Dictionary = {}
	var press_pl: Array = []
	for k in mini(defs.size(), idx.size()):
		salio[idx[k]] = true
		press_pl.append(riv_pl[idx[k]])



	while press_pl.size() < defs.size():
		press_pl.append({})
	var resto: Array = []
	var resto_pl: Array = []
	for i in riv_pos.size():
		if salio.has(i):
			continue










		var rp: Vector2 = riv_pos[i]
		rp.y = minf(rp.y, ball.y - WORLD_COVER_GAP)
		resto.append(rp)
		resto_pl.append(riv_pl[i])
	var rivals: Array = _settle_world(resto, defs, ball, PRESS_WORLD_CLEAR)









	if _tutorial_active:
		rivals = rivals.slice(0, maxi(0, TUTORIAL_RIVALES_MAX - defs.size()))
		resto_pl = resto_pl.slice(0, rivals.size())


















	var mates: Array = ScenarioStore.formation_positions(
		_my_shape, false, ball, "AUTO", {"others": rivals})
	return {
		"rivals": rivals,
		"rival_players": resto_pl,
		"mates": _settle_world(mates, defs + rivals, ball, PRESS_WORLD_CLEAR),
		"press_players": press_pl,
	}



func _press_carril(x: float) -> int:
	if absf(x) < PRESS_OUT_CARRIL:
		return 0
	return 1 if x > 0.0 else -1








func _press_x_nueva(arq: Dictionary) -> float:
	if arq.has("x_abs"):
		var xa: Vector2 = arq["x_abs"]
		var lado: float = 1.0 if randf() < 0.5 else -1.0
		if absi(_press_carril_prev) == 1:
			lado = - float(_press_carril_prev)
		return clampf(randf_range(xa.x, xa.y) * lado, - FIELD_EDGE + 1.0, FIELD_EDGE - 1.0)
	var carriles: Array[int] = [-1, 0, 1]
	carriles.erase(_press_carril_prev)
	var c: int = carriles[randi() % carriles.size()]
	if c == 0:
		return randf_range(- PRESS_OUT_CARRIL, PRESS_OUT_CARRIL)
	return float(c) * randf_range(PRESS_OUT_CARRIL, PRESS_OUT_X)






func _press_z_nueva(zb: Vector2) -> float:
	if _press_z_prev < 0.0:
		return randf_range(zb.x, zb.y)
	var tramos: Array[Vector2] = []
	var bajo: float = minf(_press_z_prev - PRESS_OUT_ALTURA_DIF, zb.y)
	if bajo > zb.x:
		tramos.append(Vector2(zb.x, bajo))
	var alto: float = maxf(_press_z_prev + PRESS_OUT_ALTURA_DIF, zb.x)
	if alto < zb.y:
		tramos.append(Vector2(alto, zb.y))
	if tramos.is_empty():
		return zb.x if absf(zb.x - _press_z_prev) >= absf(zb.y - _press_z_prev) else zb.y
	var total: float = 0.0
	for t in tramos:
		total += t.y - t.x
	var r: float = randf() * total
	for t in tramos:
		if r <= t.y - t.x:
			return t.x + r
		r -= t.y - t.x
	return tramos[tramos.size() - 1].y

















