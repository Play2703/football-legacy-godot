	var s: Dictionary = _serve_salto
	if s.is_empty():
		s = _servicio_salto_arma(_ball.position, 0)
		_servicio_salto_pose(s, 0.0)
	_serve_salto = {}
	if is_instance_valid(_self_actor):
		_self_actor.visible = true
		var cae: Tween = create_tween()
		if String(s.get("anim", "")).begins_with("palomita_"):
			var d: Vector3 = Vector3(s["dir"])
			cae.set_parallel(true)
			cae.tween_property(_self_actor, "position:x",
				_self_actor.position.x + d.x * ACRO_LUNGE, ACRO_T) \
						.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
			cae.tween_property(_self_actor, "position:z",
				_self_actor.position.z + d.z * ACRO_LUNGE, ACRO_T) \
						.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
			cae.tween_property(_self_actor, "position:y", float(s["y0"]), ACRO_T * 0.78) \
					.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
		else:
			cae.tween_property(_self_actor, "position:y", float(s["y0"]), HEADER_JUMP_DOWN) \
					.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	_do_kick(Vector3(s["dir"]), u, v, 0.0)







