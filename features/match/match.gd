func _recep_planta(chance: Dictionary) -> void:
	_recep_parte = String(chance.get("recep_parte", ""))
	if not RecepcionAerea.PARTES.has(_recep_parte):
		_recep_parte = RecepcionAerea.parte(_recep_rng)
	_recep_lado = -1.0 if _recep_rng.randf() < 0.5 else 1.0
	var yo: AnimatedSprite3D = _self_actor
	if yo == null or not is_instance_valid(yo):
		return
	var pie: Vector2 = RecepcionAerea.pasador(_recep_rng, Vector2(yo.position.x, yo.position.z),
		FIELD_EDGE)
	var mejor: AnimatedSprite3D = null
	var mejor_d: float = INF
	for t in _teammate_actors:
		if not is_instance_valid(t) or t == yo:
			continue
		var d: float = Vector2(t.position.x, t.position.z).distance_to(pie)
		if d < mejor_d:
			mejor_d = d
			mejor = t
	if mejor == null:
		return
	mejor.position.x = pie.x
	mejor.position.z = pie.y
	_face_ball(mejor)
	_recep_srv = mejor
	_teammate_actors.erase(mejor)
	_todos_nm = -1



