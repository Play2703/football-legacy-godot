const BENCH_N: int = 4
const BENCH_SPEED: float = 4.2
const BENCH_START_D: float = 13.0



const CELEB_COACH_HOLD: float = 30.0



const CELEB_COACH_SIDE_M: float = 1.2



const CELEB_COACH_TEAM_IN: Vector2 = Vector2(3.0, 6.0)
const CELEB_COACH_TEAM_SIDE: Vector2 = Vector2(2.2, 6.0)





const CELEB_DUENDE_FRENTE_M: float = 1.0
