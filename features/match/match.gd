	_aim_cam.global_position = guarda_pos
	_aim_cam.fov = guarda_fov


func _cobro_cam_off_abierto() -> Vector3:


	if _cobro_cam_off.length() < 0.01:
		return _aim_cam_off
	return _cobro_cam_off


func _cobro_cam_step(delta: float) -> void:
	if _cedida_yo == null or not is_instance_valid(_cedida_yo) or _aim_cam == null:
		return
	var yo: Vector3 = _cedida_yo.position





	var off: Vector3 = _cobro_cam_off_abierto().rotated(Vector3.UP, _cobro_cam_yaw)




	_aim_cam.fov = float(CAM_PROFILES["regate"][2])







	off *= _cobro_cam_fit
	var quiero: Vector3 = yo + _bowl_off(yo, off)
	var k: float = 1.0 - exp(- COBRO_CAM_STIFF * delta)
	_aim_cam.position = _aim_cam.position.lerp(quiero, k)








	var d_bola: float = Vector2(yo.x - _ball.position.x,
		yo.z - _ball.position.z).length()
	var k_mira: float = lerpf(COBRO_CAM_MIRA_K.x, COBRO_CAM_MIRA_K.y,
		clampf((d_bola - COBRO_CAM_MIRA_D.x)
			/ maxf(COBRO_CAM_MIRA_D.y - COBRO_CAM_MIRA_D.x, 0.01), 0.0, 1.0))







	var mira: Vector3 = Vector3(yo.x, COBRO_CAM_MIRA_Y, yo.z).lerp(
		Vector3(_ball.position.x, COBRO_CAM_MIRA_Y, _ball.position.z), k_mira)






	_aim_cam.look_at(_lift_aim(mira))
	_aim_fov_base = _aim_cam.fov


	_cobro_cam_fit_step(yo, delta)




func _cobro_cam_fit_step(yo: Vector3, delta: float) -> void:
	if _ball == null or not is_instance_valid(_ball):
		return
	var vp: Vector2 = SceneFade.rect_visible(self).size * 0.5
	if vp.x <= 0.0 or vp.y <= 0.0:
		return

























	var sujetos: Array = [Vector3(yo.x, COBRO_CAM_MIRA_Y, yo.z)]
	if state != State.FLIGHT:
		sujetos.append(_ball.position)
	var peor: float = 0.0
	for p in sujetos:
		if _aim_cam.is_position_behind(p):


			peor = COBRO_CAM_FIT_MAX
			break
		var n: Vector2 =(_aim_cam.unproject_position(p) - vp) / vp
		peor = maxf(peor, maxf(absf(n.x), absf(n.y)))
	var meta: float = _cobro_cam_fit
	if peor > COBRO_CAM_FIT_MARGEN:
		meta = _cobro_cam_fit * peor / COBRO_CAM_FIT_MARGEN
	elif peor < COBRO_CAM_FIT_COMODO:
		meta = _cobro_cam_fit * maxf(peor, 0.05) / COBRO_CAM_FIT_COMODO
	_cobro_cam_fit = lerpf(_cobro_cam_fit,
		clampf(meta, 1.0, COBRO_CAM_FIT_MAX),
		1.0 - exp(- COBRO_CAM_FIT_K * delta))


func _cobro_corre_fin() -> void:
	if not _cobro_corre:
		return
	_cobro_corre = false
	_hide_drive_ring()
	_drive_active = false
	_drive_steer = Vector2.ZERO
	_drive_vel = Vector2.ZERO
	_drive_finger = -1
	_cobro_finger = -1







func _cobro_corre_step(delta: float) -> void:
	if not _cobro_corre:
		return
	if _cedida_yo == null or not is_instance_valid(_cedida_yo):
		_cobro_corre_fin()
		return
	var spd: float = _drive_run_spd * _puddle_slow(_drive_pos)
	if _drive_steer.length_squared() > 0.0001:
		_drive_facing = _drive_steer.normalized()
		var paso: Array = Duel.step_sprint_cut(_drive_vel, _drive_facing, spd,
			_drive_accel, _drive_control, _drive_cut_armed, _drive_cut_recov, delta)
		_drive_vel = paso[0]
		_drive_cut_armed = bool(paso[1])
		_drive_cut_recov = bool(paso[2])
	else:
		_drive_vel = Vector2.ZERO
		_drive_cut_armed = true
		_drive_cut_recov = false





















	if not _cedida_cobrado and state != State.FLIGHT and state != State.PASSING:
		_drive_vel = _cobro_frena(_drive_pos, _drive_vel)












	if not _cedida_cobrado and state != State.FLIGHT and state != State.PASSING:
		_drive_vel = _cobro_esquiva(_drive_pos, _drive_vel)
	_drive_pos = _clamp_field(_drive_pos + _drive_vel * delta)
	if not _cedida_cobrado and state != State.FLIGHT and state != State.PASSING:



		_drive_pos = _cobro_sitio_legal(_drive_pos)
	_cedida_yo.position = Vector3(_drive_pos.x, _cedida_yo.position.y, _drive_pos.y)



















	if _drive_vel.length_squared() > 0.0001:
		var fam: String = "run_" if _drive_vel.length() > WALK_EXIT * _pace_world_k() \
				else "walk_"
		_play_run(_cedida_yo, Vector3(_drive_facing.x, 0.0, _drive_facing.y), fam)
	elif _cedida_yo.sprite_frames.has_animation("idle_back"):
		_cedida_yo.play("idle_back")
	_puddle_wake(_drive_vel, delta)

	_move_drive_ring()







	_pulse_drive_ring()





	_cobro_cam_step(delta)







