const MEDALLA_EN_CANCHA: bool = true



const PLACA_EN_CANCHA: bool = true
const MEDAL_W: int = 40
const MEDAL_H: int = 44





static var _medal_cache: Dictionary = {}










const MEDAL_FASES: int = 8





const MEDAL_HORNEOS_FRAME: int = 2
var _medal_horneos: int = 0




static func _medal_amp(ovr: int) -> float:
	if ovr >= 86:
		return 0.85
	if ovr >= 75:
		return 0.55
	if ovr >= 65:
		return 0.22
	return 0.16


static func _medal_vel(ovr: int) -> float:
	if ovr >= 86:
		return 2.0
	if ovr >= 75:
		return 1.1
	if ovr >= 65:
		return 0.7
	return 0.6


func _make_ovr_medal_texture(ovr: int, fase: int = 0) -> ImageTexture:
	var clave: int = ovr * 100 + fase
	if _medal_cache.has(clave):
		return _medal_cache[clave]
	var giro: float = TAU * float(fase) / float(MEDAL_FASES)
	var amp: float = _medal_amp(ovr)
	var tier: Color = OvrBadge.tier_color(ovr)
	var img: Image = Image.create(MEDAL_W, MEDAL_H, false, Image.FORMAT_RGBA8)
	var cx: float = MEDAL_W * 0.5
	var cy: float = MEDAL_H * 0.5
	var rx: float = cx - 1.0
	var ry: float = cy - 1.0





	var nucleo: Color = CareerTheme.SURFACE.lerp(Color(tier.r, tier.g, tier.b), 0.1)
	nucleo.a = 0.94
	var aro_alto: Color = CareerTheme.SURFACE.lerp(Color(tier.r, tier.g, tier.b), 0.72)
	var aro_bajo: Color = CareerTheme.SURFACE.lerp(Color(tier.r, tier.g, tier.b), 0.26)
	for y in MEDAL_H:
		for x in MEDAL_W:
			var dx: float = absf(x + 0.5 - cx)
			var dy: float = absf(y + 0.5 - cy)
			if dx > rx:
				continue

			var edge: float = ry *(1.0 - 0.5 * dx / rx)
			if dy > edge:
				continue

			if dy > edge - 2.4 or dx > rx - 2.0:
				img.set_pixel(x, y, tier)
				continue

			var nrx: float = rx * 0.72
			var nry: float = ry * 0.72
			if dx <= nrx and dy <= nry *(1.0 - 0.5 * dx / nrx):
				img.set_pixel(x, y, nucleo)
				continue




			var ang: float = atan2(y + 0.5 - cy, x + 0.5 - cx)
			var luz: float = maxf(cos(ang - giro), 0.0)
			var px: Color = aro_bajo.lerp(aro_alto, clampf(luz * amp * 1.6, 0.0, 1.0))
			px.a = 0.94
			img.set_pixel(x, y, px)
	if ovr >= 86:

		var frx: float = rx * 0.62
		var fry: float = ry * 0.62
		var glint: Color = Color(tier.r, tier.g, tier.b, 0.45)
		for y in MEDAL_H:
			for x in MEDAL_W:
				var dx: float = absf(x + 0.5 - cx)
				var dy: float = absf(y + 0.5 - cy)
				if dx > frx:
					continue
				var edge: float = fry *(1.0 - 0.5 * dx / frx)
				if dy <= edge and dy > edge - 1.4:
					img.set_pixel(x, y, glint)
	var txt: String = str(ovr)
	var tw: int = PixelText.text_width(txt, 2)
	PixelText.draw_text(img, int(cx - tw * 0.5), int(cy - PixelText.GLYPH_H * 1.0),
		txt, tier, 2)
	var tex: ImageTexture = ImageTexture.create_from_image(img)
	_medal_cache[clave] = tex
	return tex






func _attach_self_medal(actor: AnimatedSprite3D) -> void:
	if actor == null or not is_instance_valid(actor):
