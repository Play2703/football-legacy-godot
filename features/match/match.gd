const REBOTE_MATE_REMATE_K: float = 0.25







const REBOTE_MATE_AMORT_TORPE: float = 1.0
const REBOTE_MATE_AMORT_CRACK: float = 0.55
const REBOTE_MATE_NORMAL_K: float = 1.0




