func _servicio_vista(dir: Vector3, base: Basis) -> String:
	var flat: Vector2 = Vector2(dir.x, dir.z)
	if flat.length_squared() < DIR_DEGENERADO:
		return "south"
	var right: Vector2 = Vector2(base.x.x, base.x.z)
	var into: Vector2 = Vector2(- base.z.x, - base.z.z)
	if right.length_squared() < 0.0001 or into.length_squared() < 0.0001:
		return _dir_name(dir)
	var lateral: float = flat.dot(right.normalized())
	var depth: float = flat.dot(into.normalized())
	if absf(depth) * DIR_DEPTH_BIAS >= absf(lateral):
		return "north" if depth > 0.0 else "south"
	return "east" if lateral > 0.0 else "west"









