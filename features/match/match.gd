func _keeper_inventario(frames: SpriteFrames) -> void:
	if not atlas_cuadros:
		return
	var a: CuadroAtlasScr = CuadroAtlasScr.de(frames)
	for anim in frames.get_animation_names():
		if anim == &"idle" or anim == &"idle_back":
			continue
		for i in frames.get_frame_count(anim):
			a.ofrece(anim, i, frames.get_frame_texture(anim, i))
	a.cierra()





















func _keeper_set_tex(tex: Texture2D, sway: int, split: bool, src_img: Image = null) -> Texture2D:


	var src: Image = src_img if src_img != null else KitRecolor.lee_imagen(tex)
	var w: int = src.get_width()
	var h: int = src.get_height()
	var waist: int = int(h * KEEPER_OUT_WAIST)
	var knee: int = int(h * KEEPER_OUT_KNEE)
	var out: Image = Image.create(w, h, false, Image.FORMAT_RGBA8)

	if split:
		var cut: int = _legs_split(src, knee)
		out.blend_rect(src, Rect2i(0, knee, cut, h - knee),
			Vector2i(- KEEPER_SET_SPREAD, knee))
		out.blend_rect(src, Rect2i(cut, knee, w - cut, h - knee),
			Vector2i(cut + KEEPER_SET_SPREAD, knee))
	else:
		out.blend_rect(src, Rect2i(0, knee, w, h - knee), Vector2i(0, knee))

	out.blend_rect(src, Rect2i(0, waist, w, knee - waist),
		Vector2i(0, waist + KEEPER_SET_CROUCH / 2))
	out.blend_rect(src, Rect2i(0, 0, w, waist), Vector2i(sway, KEEPER_SET_CROUCH))
	return _tex_compuesta(out)


























func _shuffle_tex(tex: Texture2D, off: Vector4i, split: bool, src_img: Image = null) -> Texture2D:
	if off == Vector4i.ZERO:
		return tex
	var src: Image = src_img if src_img != null else KitRecolor.lee_imagen(tex)
	var w: int = src.get_width()
	var h: int = src.get_height()
	var waist: int = int(h * KEEPER_OUT_WAIST)
	var knee: int = int(h * KEEPER_OUT_KNEE)
	var out: Image = Image.create(w, h, false, Image.FORMAT_RGBA8)

	out.blit_rect(src, Rect2i(0, 0, w, waist), Vector2i(off.x + off.z, off.y))
	out.blit_rect(src, Rect2i(0, waist, w, knee - waist),
		Vector2i(off.x, waist + off.y))
	if off.w == 0:
		out.blit_rect(src, Rect2i(0, knee, w, h - knee), Vector2i(off.x, knee + off.y))
		return _tex_compuesta(out)
	if split:
		var cut: int = _legs_split(src, knee)
		var lift_l: int = -1 if off.w > 0 else 0
		var lift_r: int = -1 if off.w < 0 else 0
		out.blit_rect(src, Rect2i(0, knee, cut, h - knee),
			Vector2i(off.x + off.w, knee + off.y + lift_l))
		out.blit_rect(src, Rect2i(cut, knee, w - cut, h - knee),
			Vector2i(cut + off.x - off.w, knee + off.y + lift_r))
		return _tex_compuesta(out)

	var span: float = maxf(float(h - 1 - knee), 1.0)
	for y in range(knee, h):
		var s: int = int(round(float(off.w) * float(y - knee) / span))
		out.blit_rect(src, Rect2i(0, y, w, 1), Vector2i(off.x + s, y + off.y))
	return _tex_compuesta(out)






func _tex_compuesta(out: Image) -> ImageTexture:
	var t: ImageTexture = ImageTexture.create_from_image(out)
	if KitRecolor.en_meta():
		t.set_meta(KitRecolor.META_IMG_ATLAS, out)
	return t

















func _legs_split(src: Image, knee: int) -> int:
	var w: int = src.get_width()
	var h: int = src.get_height()

	var lo: int = -1
	var hi: int = -1
	for x in w:
		for y in range(knee, h):
			if src.get_pixel(x, y).a > 0.5:
				if lo < 0:
					lo = x
				hi = x
				break
	if lo < 0 or hi - lo < 3:
		return w / 2
	var mid: int =(lo + hi) / 2
	var margen: int = int(float(hi - lo) * 0.25)
	var best: int = mid
	var best_n: int = 1<<30
	for x in range(lo + margen, hi - margen + 1):
		var n: int = 0
		for y in range(knee, h):
			if src.get_pixel(x, y).a > 0.5:
				n += 1
		if n < best_n or (n == best_n and absi(x - mid) < absi(best - mid)):
			best_n = n
			best = x
	return best


func _add_keeper_anim(frames: SpriteFrames, anim: String, prefix: String, fps: float,
		look: Dictionary = {}) -> void:
	var added: bool = false




	var bases: PackedStringArray = PackedStringArray()

	for i in range(1, 13):
		var path: String = "%s%02d.png" % [prefix, i]
		if not ResourceLoader.exists(path):
			continue
		if not added:
			frames.add_animation(anim)
			frames.set_animation_loop(anim, false)
			frames.set_animation_speed(anim, fps)
			added = true
		frames.add_frame(anim, KitRecolor.apply(load(path), look))
		bases.append(path.get_file().get_basename())
	if added:
		PechoRig.apunta(frames, bases, anim)











func _make_wall(ball: Vector2, count: int) -> Array:
	var to_goal: Vector2 =(Vector2.ZERO - ball).normalized()
	var perp: Vector2 = Vector2(- to_goal.y, to_goal.x)
	var base: Vector2 = ball + to_goal *(9.15 + randf_range(- WALL_JIT_A, WALL_JIT_A))
	var shift: float = randf_range(- WALL_JIT_L, WALL_JIT_L)
	var step: float = WALL_STEP + randf_range(- WALL_JIT_STEP, WALL_JIT_STEP)
	var wall: Array = []
	for i in count:
		var off: float =(float(i) - float(count - 1) * 0.5) * step + shift
		wall.append(base + perp * off)
	return wall










