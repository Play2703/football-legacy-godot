static func _celeb_fov_sigue(base: float, d: float,
		enc: float = CELEB_SIGUE_ENC) -> float:
	var pide: float = rad_to_deg(2.0 * atan(CELEB_SIGUE_SUJETO_M
		/(2.0 * enc * maxf(d, 0.5))))
	return clampf(pide, minf(CELEB_SIGUE_FOV_MIN, base), base)



func _celeb_orbit_fuera(ang: float) -> bool:
	var eje: Vector2 = - _celeb_afuera(Vector2(_celeb_focus_pos.x, _celeb_focus_pos.z))
	return Vector2(sin(ang), cos(ang)).dot(eje) < cos(CELEB_CAMPO_CONO)




func _celeb_orbit_choca(ang: float, f: Vector3) -> bool:
	var cam: Vector3 = _celeb_cam_pos(_celeb_focus_pos, _celeb_dentro(_celeb_focus_pos,
		Vector3(sin(ang) * _celeb_orbit_r, CELEB_ORBIT_H, cos(ang) * _celeb_orbit_r)))
	var c2: Vector2 = Vector2(cam.x, cam.z)
	var s2: Vector2 = Vector2(f.x, f.z)
	return _celeb_por_la_red(c2, s2) \
			or _celeb_tapa(cam, s2, _celeb_otros(true)) >= CELEB_ORBIT_TAPA_MAX

