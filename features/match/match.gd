func _lectura_ctx(rival: bool, f: Dictionary, carry: int, basta: int) -> Dictionary:
	var tuya: int = team_goals - rival_goals
	var antes: int = - tuya - 1 if rival else tuya - 1
	return {
		"nuestro": not rival,
		"minuto": match_minute,
		"prorroga": _extra_time,
		"antes": antes,
		"global_antes": antes - carry if rival else antes + carry,
		"estuvo_abajo": carry + _max_lead > 0 if rival else carry - _max_deficit < 0,


		"final": String(f.get("round", "")) == FAN_PHOTO_ROUND \
				and GameState.fixture_is_knockout(f),
		"eliminatoria": GameState.fixture_is_knockout(f),

		"sembrado": - _ko_sembrado(f) if rival else _ko_sembrado(f),
		"basta": basta,
	}


