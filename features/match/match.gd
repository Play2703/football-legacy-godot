func _cedida_cercanos(pool: Array[AnimatedSprite3D], meta: Vector2,
		n: int) -> Array[AnimatedSprite3D]:
	var vivos: Array[AnimatedSprite3D] = []
	for a in pool:
		if is_instance_valid(a):
			vivos.append(a)
	vivos.sort_custom(func(x, y): return \
			Vector2(x.position.x, x.position.z).distance_to(meta) \
			< Vector2(y.position.x, y.position.z).distance_to(meta))
	return vivos.slice(0, mini(n, vivos.size()))












