func _keeper_knock_down(stretch: float) -> void:
	var up: float = lerpf(KEEPER_UP_SLOW, KEEPER_UP_FAST,
		clampf(_keeper_skill * 0.6 + _keeper_accel * 0.4, 0.0, 1.0))
	up *= lerpf(1.0, KEEPER_UP_STRETCH,
		clampf(stretch / maxf(KEEPER_MAX_TRAVEL, 0.5), 0.0, 1.0))
	_keeper_down_until = Time.get_ticks_msec() + int(up * 1000.0)



func _keeper_down_left() -> float:
