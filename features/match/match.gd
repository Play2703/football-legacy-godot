func _handoff_trap_spot(feet: Vector2, ctrl: float,
		venida: Vector2 = Vector2.ZERO, rapidez: float = 0.0) -> Vector2:

















	if venida.length_squared() > 0.0001:
		var llega: Vector2 = - venida.normalized()
		var c: float = clampf(ctrl, 0.0, 1.0)
		var d: float = lerpf(- Duel.BALL_FOOT, TRAP_OVERRUN_MAX, 1.0 - c)





		var dur: float = _recep_dureza(rapidez)
		if dur > 0.0:
			var d_rebote: float = - Duel.BALL_FOOT \
					- RECEP_REBOTE_MAX * lerpf(RECEP_CTRL_MIN, 1.0, 1.0 - c)
			d = lerpf(d, d_rebote, dur)
		var spot_eje: Vector2 = feet + llega * d
		var fwd_v: Vector2 = _view_fwd(feet)
		var perp_v: Vector2 = Vector2(- fwd_v.y, fwd_v.x)
		var rel: Vector2 = spot_eje - feet
		if rel.dot(fwd_v) > 0.0 and absf(rel.dot(perp_v)) < Drive.STANCE_SIDE_MIN:
			var sgn_v: float = signf(feet.x)
			if sgn_v == 0.0:
				sgn_v = 1.0
			var empuje: Vector2 = perp_v *(sgn_v * Drive.STANCE_SIDE_MIN)
			if absf((spot_eje + empuje).x) > Stadium.FIELD_HALF_W - 0.5:
				empuje = - empuje
			spot_eje += empuje
		return spot_eje















	var fondo: float = Duel.BALL_FOOT + Drive.trap_slop(ctrl)




















	var fwd: Vector2 = _view_fwd(feet)
	var perp: Vector2 = Vector2(- fwd.y, fwd.x)







	var sgn: float = signf(feet.x)
	if sgn == 0.0:
		sgn = 1.0
	var lado: Vector2 = perp *(sgn * Drive.STANCE_SIDE_MIN)
	var spot: Vector2 = feet + fwd * fondo + lado



	if absf(spot.x) > Stadium.FIELD_HALF_W - 0.5:
		spot = feet + fwd * fondo - lado
	return spot


func _handoff_ok(actor: AnimatedSprite3D, ball_h: float) -> bool:
	if not handoff_enabled:
		return false














	var servicio: bool = not _tutorial_active and Practice.es_servicio(_practice_kind) \
			and DisplayServer.get_name() != "headless"

















	var salida: bool =(Practice.salida_jugada_on and _practice_kind == Practice.SALIDA) \
			or (Practice.salida_meta_on and _practice_kind == Practice.SALIDA_META) \
			or _practice_kind == Practice.SAQUE_BANDA
	var salida_abre: bool = salida and (_tutorial_con_dedos() if _tutorial_active
		else DisplayServer.get_name() != "headless")






	var leccion: bool = _tutorial_active and _practice_kind == Practice.RELEVO
	var leccion_abre: bool = leccion and _tutorial_con_dedos()
	if GameState.readonly_save and not handoff_override and not servicio \
			and not salida_abre and not leccion_abre:
		return false










	if not leccion and not servicio and not salida and (_tutorial_active
			or _practice_kind != "" or _open_resume or _shootout_active):
		return false
	if actor == null or not is_instance_valid(actor):
		return false
























	if ball_h > HEADER_MAX_H:
		return false
















	var regreso_area: bool = _es_regreso(actor) \
			and not _balon_suelto()
	if not regreso_area and _in_penalty_box(Vector2(_ball.position.x, _ball.position.z)):
		return false








	var feet: Vector2 = Vector2(actor.position.x, actor.position.z)


	var venida: Vector2 = _pase_venida()
	var domado: Vector2 = _handoff_trap_spot(feet,
		pow(Squad.control(_finisher_of(actor)), Career.REGATE_GAMMA),
		venida, venida.length() * 60.0)
	if regreso_area:
		return domado.y >= ScenarioStore.BALL_MIN_Z \
				and domado.length() >= ScenarioStore.BALL_MIN_DIST
	if _in_penalty_box(domado):
		return false
	return true


















const CONTROL_HOLD_MS: int = 820




const CHEST_HOLD_MS: int = 1400


const CHEST_TRAP_H: float = 1.15







const CONTROL_PIVOT_MS: int = 68







































const PECHO_VY_SUAVE: float = 1.55
const PECHO_VY_DURO: float = 4.2
const PECHO_BOTE_SUAVE: float = 0.07
const PECHO_BOTE_DURO: float = 0.15














const PECHO_FRANJA_M: float = 0.25
const PECHO_LLEGA_TICKS: int = 45
var _pecho_toca_i: int = 0
func _pecho_trayectoria(desde: Vector3, pecho: Vector3, domado: Vector3,
		_vn: Vector2, v_in: float, escape: float = 0.0,
		vel_in: Vector3 = Vector3.ZERO) -> PackedVector3Array:
	var pts: PackedVector3Array = PackedVector3Array()
	var dt: float = 1.0 / 60.0
	var v_salida: float = 1.55
	if vel_in.length_squared() > 0.0001:



		var g: float = 9.8
		var mejor_n: int = 1
		var mejor_err: float = INF
		var mejor_v: Vector3 = Vector3.ZERO
		var mejor_y: float = pecho.y
		for n in range(1, PECHO_LLEGA_TICKS + 1):
			var t: float = float(n) * dt
			var y_nat: float = desde.y + vel_in.y * t - 0.5 * g * t * t
			var y_fin: float = clampf(y_nat, pecho.y, pecho.y + PECHO_FRANJA_M)
			var v0: Vector3 = Vector3((pecho.x - desde.x) / t,
				(y_fin - desde.y) / t + 0.5 * g * t,(pecho.z - desde.z) / t)
			var err: float =(v0 - vel_in).length_squared()
			if err < mejor_err:
				mejor_err = err
				mejor_n = n
				mejor_v = v0
				mejor_y = y_fin
		for k in mejor_n:
			var tk: float = float(k) * dt
			pts.append(desde + mejor_v * tk + Vector3(0.0, -0.5 * g * tk * tk, 0.0))
		pecho = Vector3(pecho.x, mejor_y, pecho.z)
	else:

		var p: Vector3 = desde
		var v: float = clampf(v_in, 4.0, 12.0)
		var rumbo: Vector3 =(pecho - desde).normalized()
		var seguridad: int = 0
		while p.distance_to(pecho) > v * dt and seguridad < 60:
			pts.append(p)
			p += rumbo * v * dt
			v = maxf(v_salida, v * 0.82)
			seguridad += 1


	_pecho_toca_i = pts.size()
	var e: float = clampf(escape, 0.0, 1.0)
	_rebote_trayectoria(pts, pecho, domado, lerpf(PECHO_VY_SUAVE, PECHO_VY_DURO, e),
		lerpf(PECHO_BOTE_SUAVE, PECHO_BOTE_DURO, e))
	return pts



















const REBOTE_KB: float = 0.6
const REBOTE_KR: float = 0.8
const RODADA_FRENO: float = 3.0
func _rebote_trayectoria(pts: PackedVector3Array, desde: Vector3, domado: Vector3,
		vy0: float, h_bote: float) -> void:
	var dt: float = 1.0 / 60.0
	var g: float = 9.8
	var suelo: float = domado.y
	var plano: Vector3 = Vector3(domado.x - desde.x, 0.0, domado.z - desde.z)
	var largo: float = plano.length()
	var dir: Vector3 = plano / largo if largo > 0.001 else Vector3.ZERO
	var vb: float = sqrt(2.0 * g * maxf(h_bote, 0.0))
	var t1: float = float(_ticks_en_el_aire(desde.y, vy0, suelo, false)) * dt
	var t2: float = float(_ticks_en_el_aire(suelo, vb, suelo, true)) * dt \
			if vb > 0.01 else 0.0
	var qa: float = pow(REBOTE_KB * REBOTE_KR, 2.0) /(2.0 * RODADA_FRENO)
	var qb: float = t1 + REBOTE_KB * t2
	var v: float =(- qb + sqrt(qb * qb + 4.0 * qa * largo)) /(2.0 * qa)

	var p: Vector3 = desde
	var vel: Vector3 = dir * v + Vector3(0.0, vy0, 0.0)
	var seguridad: int = 0
	while (p.y > suelo or vel.y > 0.0) and seguridad < 240:
		pts.append(p)
		p += vel * dt
		vel.y -= g * dt
		seguridad += 1
	p.y = suelo

	if vb > 0.01:
		vel = dir * v * REBOTE_KB + Vector3(0.0, vb, 0.0)
		seguridad = 0
		pts.append(p)
		p += vel * dt
		vel.y -= g * dt
		while p.y > suelo and seguridad < 120:
			pts.append(p)
			p += vel * dt
			vel.y -= g * dt
			seguridad += 1
		p.y = suelo


	var falta: float =(Vector3(domado.x - p.x, 0.0, domado.z - p.z)).dot(dir)
	var vr: float = v * REBOTE_KB * REBOTE_KR
	if falta > 0.005 and vr > 0.05:
		var freno: float = vr * vr /(2.0 * falta)
		var hecho: float = 0.0
		seguridad = 0
		while hecho < falta and vr > 0.0 and seguridad < 240:
			pts.append(p)
			var paso: float = minf(vr * dt, falta - hecho)
			p += dir * paso
			hecho += paso
			vr -= freno * dt
			seguridad += 1
	pts.append(domado)




func _ticks_en_el_aire(y0: float, vy0: float, suelo: float, bote: bool) -> int:
	var dt: float = 1.0 / 60.0
	var g: float = 9.8
	var y: float = y0
	var vy: float = vy0
	var n: int = 0
	if bote:
		y += vy * dt
		vy -= g * dt
		n = 1
		while y > suelo and n < 121:
			y += vy * dt
			vy -= g * dt
			n += 1
	else:
		while (y > suelo or vy > 0.0) and n < 240:
			y += vy * dt
			vy -= g * dt
			n += 1
	return n







func _pie_trayectoria(desde: Vector3, contacto: Vector3, domado: Vector3,
		v_in: float, escape: float) -> PackedVector3Array:
	var pts: PackedVector3Array = PackedVector3Array()
	var dt: float = 1.0 / 60.0
	var v: float = maxf(v_in, 4.0)
	var p: Vector3 = desde
	var seguridad: int = 0
	while p.distance_to(contacto) > v * dt and seguridad < 60:
		pts.append(p)
		p +=(contacto - p).normalized() * v * dt
		seguridad += 1
	var salto: float = RECEP_SALTO_PIE * clampf(escape, 0.0, 1.0)
	_rebote_trayectoria(pts, contacto, domado, sqrt(2.0 * 9.8 * salto), salto * 0.3)
	return pts





func _pie_contacto(desde: Vector3, pies: Vector3, vn: Vector2) -> Vector3:
	var c: Vector3 = Vector3(pies.x + vn.x * Duel.BALL_FOOT * 0.5,
		maxf(desde.y, BALL_VISUAL_D * 0.5), pies.z + vn.y * Duel.BALL_FOOT * 0.5)
	if (desde - c).dot(Vector3(vn.x, 0.0, vn.y)) < 0.02:
		return desde
	return c










