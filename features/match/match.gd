func _is_cross(kind: String) -> bool:
	return kind == "corner" or kind == "centro" or kind == "banda"











func _cross_block_dz(ball: Vector2, origin: Dictionary) -> float:
	if not bool(origin.get("cross", false)):
		return 0.0




	if _falta_plana(origin, ball):
		return _falta_plana_z(ball, origin) + FK_PLANA_HOMBRO - FK_LINE_HOMBRO






	var dl: String = String(origin.get("def_line", ""))
	if dl == DEF_LINE_ALTA and ball.length() < HIGH_D_MIN:
		dl = DEF_LINE_NORMAL
	var k: float = CROSS_BLOCK_K * float(CROSS_BLOCK_LINE.get(dl, 1.0))



	var linea: float = minf(k * ball.y, maxf(ball.y - CROSS_BLOCK_AHEAD, 0.0))
	return clampf(linea - CROSS_BLOCK_BASE, 0.0, CROSS_BLOCK_MAX)






func _falta_plana(origin: Dictionary, ball: Vector2) -> bool:
	return bool(origin.get("cross", false)) \
			and String(origin.get("kind", "")) in FK_LINE_KINDS \
			and ball.y >= FK_LINE_MIN_Z \
			and int(origin.get("wall", 0)) <= FK_PLANA_MURO \
			and ball.length() > FK_PLANA_D \
			and not bool(origin.get("mark_man", false))





func _falta_plana_z(ball: Vector2, origin: Dictionary) -> float:
	var t: float = clampf(inverse_lerp(FK_PLANA_Y.x, FK_PLANA_Y.y, ball.y), 0.0, 1.0)
	var z: float = lerpf(FK_PLANA_Z.x, FK_PLANA_Z.y, t)
	var dl: String = String(origin.get("def_line", ""))
	if dl == DEF_LINE_ALTA and ball.length() >= HIGH_D_MIN:
		z += FK_PLANA_ALTURA
	elif dl == DEF_LINE_BAJA:
		z -= FK_PLANA_ALTURA
	return clampf(z, FK_PLANA_TOPE.x, FK_PLANA_TOPE.y)




func _falta_plana_sitio(i: int, sb: float, zp: float) -> Vector2:
	var k: int = i % FK_PLANA_X.size()
	var fila: float = FK_PLANA_FILA * float(i / FK_PLANA_X.size())
	return Vector2(sb * FK_PLANA_X[k], zp + FK_PLANA_PICO[k] + fila)






const CROSS_LAG_MAX: float = 5.0



const CROSS_LIFT_TO: float = 3.2




func _lift_cross_stragglers(support: Array, defenders: Array, wall: int,
		ball: Vector2, dz: float) -> bool:
	var suelo: float = dz - CROSS_LAG_MAX
	if suelo <= 0.0:
		return false
	var meta: float = dz + CROSS_LIFT_TO
	var f: Dictionary = _shot_frame(ball)
	var keeper: Vector2 = _keeper_spot(ball)
	var movido: bool = false
	for lista in [support, defenders]:
		var desde: int = wall if lista == defenders else 0
		for i in range((lista as Array).size()):
			if i < desde:
				continue
			var p: Vector2 =(lista as Array)[i]



			if p.y >= suelo:
				continue

			var dir: Vector2 = p.normalized() if p.length() > 0.05 else Vector2(0.0, 1.0)
			var esc: float = meta / maxf(p.y, 0.6) * p.length() if p.y > 0.6 else meta
			var al: Vector2 = _frame_al(dir * esc, ball, f)
			(lista as Array)[i] = _place(al.x, al.y, ball, f, keeper)
			movido = true
	return movido





func _chance_from_origin(origin: Dictionary) -> Dictionary:
	var ball: Vector2 = origin["ball"]



	_set_gen_back(ball)





	if String(origin["kind"]) == "penal":
		return _penalty_chance(origin, ball)
	var motion: Dictionary = _pick_motion(origin)
	var wall: int = int(origin.get("wall", 0))





	if _tutorial_active and wall > 0:
		wall = mini(wall, 2)




		origin["wall"] = wall


	var mates_b: Array = origin.get("mates", [1, 2])
	var rivals_b: Array = origin.get("rivals", [1, 2])
	var n_mates: int = randi_range(int(mates_b[0]), int(mates_b[1]))
	var n_rivals: int = randi_range(int(rivals_b[0]), int(rivals_b[1]))





	if _tutorial_active:








		n_rivals = mini(n_rivals, maxi(0, TUTORIAL_RIVALES_MAX - wall))








	if _dieta != 0.0 and randf() < absf(_dieta) * MatchPlan.DIETA_DENS_P:
		n_rivals = clampi(n_rivals +(1 if _dieta < 0.0 else -1),
			int(rivals_b[0]), int(rivals_b[1]))












	if _rival_expulsados > 0 and not bool(origin.get("roja_fuera_del_plano", false)):
		n_rivals = maxi(1, n_rivals - _rival_expulsados)




	if not _expulsados_mios.is_empty():
		n_mates = maxi(int(mates_b[0]), n_mates - _expulsados_mios.size())




	var cap: int = int(origin.get("dens_cap", _density_cap(ball.length())))





	while n_mates + n_rivals + mini(wall, 1) > cap:
		var can_r: bool = n_rivals > int(rivals_b[0])
		var can_m: bool = n_mates > int(mates_b[0])
		if can_r and can_m:
			if randf() < 0.5:
				n_rivals -= 1
			else:
				n_mates -= 1
		elif can_r:
			n_rivals -= 1
		elif can_m:
			n_mates -= 1





		elif n_rivals > 1 and n_mates > 1:
			if randf() < 0.5:
				n_rivals -= 1
			else:
				n_mates -= 1
		elif n_rivals > 1:
			n_rivals -= 1
		elif n_mates > 1:
			n_mates -= 1
		else:
			break



	var kind0: String = String(origin["kind"])



	var cross: bool = _is_cross(kind0) or bool(origin.get("cross", false))


	origin = _encierro(origin, ball, kind0, cross, wall)
	var support: Array = _enforce_clearance(_build_support(ball, origin, n_mates), ball, 0, cross)
	var defenders: Array = _enforce_clearance(
		_build_defense(ball, origin, support, n_rivals), ball, wall, cross)







	_align_back_line(defenders, wall)


	_open_passing_lanes(support, defenders, wall, ball, cross)

	_separate_actors(support, defenders, wall, ball, cross)



	_spread_options(support, defenders, ball, cross)


	_ensure_straddle(support, defenders, wall, ball)





	for _k in 3:
		if not _pull_onside(support, defenders, wall, ball):
			break
		_separate_actors(support, defenders, wall, ball, cross)
	_pull_onside(support, defenders, wall, ball)







	if cross:
		_ensure_box_target(support, defenders, wall, ball, _cross_block_dz(ball, origin))



	if kind0 == "corner":
		_no_short_corner(support, defenders, wall, ball)



































	if wall == 0 and AimPress.allowed_kind(kind0):
		for _k in 3:
			if not _floor_defenders(defenders, ball):
				break
			defenders = _enforce_clearance(defenders, ball, wall, cross)
			_separate_actors(support, defenders, wall, ball, cross)
			_pull_onside(support, defenders, wall, ball)















	var dz_block: float = _cross_block_dz(ball, origin)
	if dz_block > 0.0:
		for _k in 3:
			if not _lift_cross_stragglers(support, defenders, wall, ball, dz_block):
				break
			defenders = _enforce_clearance(defenders, ball, wall, cross)
			_separate_actors(support, defenders, wall, ball, cross)
			_pull_onside(support, defenders, wall, ball)







	_tercer_carril_final(support, defenders, wall, ball)
	var chance: Dictionary = {
		"kind": String(origin["kind"]),
		"name": _compose_name(origin, support, defenders, motion),
		"ball": ball,
		"teammates": support,
		"defenders": defenders,





		"press_roles": _last_press_roles.duplicate(),





		"def_line": _last_def_line,
	}
	if wall > 0:
		chance["wall_count"] = wall



	if _falta_plana(origin, ball):
		chance["plana"] = _falta_plana_z(ball, origin)




	if String(origin["kind"]) == "corner":
		chance["marcaje"] = _last_mark





	if bool(origin.get("cross", false)):
		chance["cross"] = true
	if not motion.is_empty():
		chance["moving"] = motion





	if bool(origin.get("header", false)):
		if String(motion.get("kind", "")) != "aereo":
			motion = _pick_motion({"motion_chance": 1.0, "motion_style": "aereo",
				"motion_dir": origin.get("motion_dir", 1.0 if randf() < 0.5 else -1.0),
				"header_h": origin.get("header_h", HEADER_ENTRY_H)})
			chance["moving"] = motion
		chance["header"] = true

	if origin.has("generica"):
		chance["generica"] = true

	if origin.has("tras_balon"):
		chance["tras_balon"] = origin["tras_balon"]

	if origin.has("bascula"):
		chance["bascula"] = origin["bascula"]

	if bool(origin.get("encerrado", false)):
		chance["encerrado"] = true

	var presion_o: Array = origin.get("presion", [])
	if presion_o.size() >= 4 and int(presion_o[3]) > 0:
		chance["perseguidor"] = int(presion_o[3])

	_add_formation_extras(chance, ball, support, defenders)
	_tutorial_despeja(chance)


	if bool(origin.get("saque_banda", false)):
		_saque_viste(chance)
	return chance


































const PEN_RING_N: int = 6
const PEN_RING_HALF_W: float = 4.6

const PEN_ROW_GAP: float = 2.9




const PEN_FIT_HALF_W: float = 5.4


const PEN_GAP: Vector2 = Vector2(0.7, 1.6)
const PEN_JIT_X: float = 0.35




const PEN_SEP: float = 2.9








const PEN_SEP_PASSES: int = 12


const PEN_SEP_EXTRA: float = 0.05






func _penalty_ring(ball: Vector2) -> Array:
	var mine: Array = []
	var theirs: Array = []
	var puestos: Array = []


	var gaps: Array[float] = []







	var flip: int = randi() % 2









	for i in PEN_RING_N:
		var t: float =(float(i) + 0.5) / float(PEN_RING_N)
		var x: float = lerpf(- PEN_RING_HALF_W, PEN_RING_HALF_W, t) \
				+ randf_range(- PEN_JIT_X, PEN_JIT_X)
		var gap: float = randf_range(PEN_GAP.x, PEN_GAP.y)



		if i % 2 == 1:
			gap += PEN_ROW_GAP



		var p: Vector2 = _clamp_field(
			_penalty_legal_spot(Vector2(x, Stadium.PA_DEPTH), ball, gap))


























		for _pass in 3:
			for k in puestos:
				p = _push_out(p, k, PEN_SEP)
			p = _clamp_field(_penalty_legal_spot(p, ball, gap))
		puestos.append(p)
		gaps.append(gap)

	_separa_corro(puestos, gaps, ball)
	for i in puestos.size():
		if i % 2 == flip:
			mine.append(puestos[i])
		else:
			theirs.append(puestos[i])
	return [mine, theirs]



























func _separa_corro(puestos: Array, gaps: Array, ball: Vector2) -> void:
	for _ronda in PEN_SEP_PASSES:
		var peor: float = INF
		for i in puestos.size():
			var vecino: Vector2 = Vector2.ZERO
			var falta: float = PEN_SEP
			for j in puestos.size():
				if i == j:
					continue
				var dj: float =(puestos[i] as Vector2).distance_to(puestos[j])
				if dj < falta:
					falta = dj
					vecino = puestos[j]
			peor = minf(peor, falta)
			if falta >= PEN_SEP:
				continue
			var p: Vector2 = puestos[i]
			var fuera: Vector2 = p - vecino
			if fuera.length() < 0.01:
				fuera = Vector2(1.0, 0.0)
			var radio: Vector2 = p - ball
			radio = radio.normalized() if radio.length() > 0.01 else Vector2(0.0, 1.0)
			var tang: Vector2 = Vector2(- radio.y, radio.x)
			if tang.dot(fuera) < 0.0:
				tang = - tang



			puestos[i] = _clamp_field(_penalty_legal_spot(
				p + tang *((PEN_SEP - falta) * 0.5 + PEN_SEP_EXTRA), ball, gaps[i]))
		if peor >= PEN_SEP:
			return





func _penalty_legal_spot(p: Vector2, spot: Vector2, gap: float) -> Vector2:
	var q: Vector2 = p
	if absf(q.x) <= Stadium.PA_HALF_W and q.y < Stadium.PA_DEPTH + gap:
		q.y = Stadium.PA_DEPTH + gap
	var d: Vector2 = q - spot
	if d.length() < PEN_ARC_R + gap:
		var dir: Vector2 = d.normalized() if d.length() > 0.01 else Vector2(0.0, 1.0)
		q = spot + dir *(PEN_ARC_R + gap)
	return q







func _penalty_chance(origin: Dictionary, ball: Vector2) -> Dictionary:
	var ring: Array = _penalty_ring(ball)
	_last_scheme = ""
	_last_mark = "zonal"
	_last_def_line = DEF_LINE_NORMAL
	_last_press_roles.clear()
	var chance: Dictionary = {
		"kind": "penal",
		"name": String(origin["name"]),
		"ball": ball,
		"teammates": ring[0],
		"defenders": ring[1],
		"press_roles": _last_press_roles.duplicate(),
		"def_line": _last_def_line,
	}
	_add_formation_extras(chance, ball, ring[0], ring[1])
	_tutorial_despeja(chance)
	return chance














func _tutorial_despeja(chance: Dictionary) -> void:
	if not _tutorial_active:
		return
	chance["extras_rivals"] = []
	chance["extras_rival_players"] = []


































func _add_formation_extras(chance: Dictionary, ball: Vector2, support: Array,
		defenders: Array) -> void:
	_ensure_shapes()
	var rival_shape: String = _rival_shape
	var my_shape: String = _my_shape









	var dl: String = String(chance.get("def_line", DEF_LINE_NORMAL))
	var line_k: float = 1.0
	if dl == DEF_LINE_ALTA:
		line_k = LINE_K_ALTA
	elif dl == DEF_LINE_BAJA:
		line_k = LINE_K_BAJA





	var riv_all: Array = ScenarioStore.formation_positions(
		rival_shape, true, ball, "AUTO", {"line_k": line_k,
		"bascula": 0.0 if chance.has("tras_balon") else float(chance.get("bascula", 1.0))})











	var actives: Array = []
	actives.append_array(support)
	actives.append_array(defenders)














	var linea_act: float = INF
	for i in range(int(chance.get("wall_count", 0)), defenders.size()):
		linea_act = minf(linea_act,(defenders[i] as Vector2).y)
	var resto: Array = _drop_nearest(riv_all, ball, defenders.size())
	var suelo: float = linea_act - STRAGGLER_MAX if linea_act < INF else - INF












	var tras: Array = chance.get("tras_balon", [])
	if tras.size() == 2:
		resto = _bloque_pillado(resto, ball, float(tras[0]), float(tras[1]))
		suelo = maxf(suelo, ball.y + PILLADO_MIN_TRAS)


	resto = _punta_arriba(chance, resto, ball)


	if String(chance.get("kind", "")) == "corner":
		resto = _corner_resto_rival(resto, defenders, ball)


	if bool(chance.get("encerrado", false)) and tras.size() != 2:
		resto = _bloque_bajo(resto, riv_all, defenders.slice(
			int(chance.get("wall_count", 0))), ball, linea_act)





		if linea_act < INF:
			suelo = maxf(suelo, linea_act - BAJO_B1_JIT)
	chance["extras_rivals"] = _settle_extras(resto, actives, ball, suelo)
	if int(chance.get("perseguidor", 0)) > 0 and not tras.size() == 2:
		_perseguidor(chance["extras_rivals"], actives, ball, int(chance["perseguidor"]))







	if _is_cross(String(chance.get("kind", ""))) \
			and AimPress.allowed_kind(String(chance.get("kind", ""))):
		_ensure_cross_marker(chance["extras_rivals"], actives, ball)



	if chance.has("plana"):
		_falta_plana_resto(chance, ball, defenders, actives)
	actives.append_array(chance["extras_rivals"])






	var last_def: float = INF
	for p in chance["extras_rivals"]:
		last_def = minf(last_def,(p as Vector2).y)
	var wall_n: int = int(chance.get("wall_count", 0))
	for i in range(wall_n,(defenders as Array).size()):
		if _last_press_roles.has(i):
			continue
		last_def = minf(last_def,(defenders[i] as Vector2).y)


	var my_all: Array = ScenarioStore.formation_positions(
		my_shape, false, ball, _plan_height(),
		{"last_def": last_def, "others": chance["extras_rivals"], "bascula": 1.0})





	var punta_z: float = - INF
	for p in [] if chance.has("tras_balon") else chance["extras_rivals"]:
		if (p as Vector2).y > ball.y + RETA_UMBRAL:
			punta_z = maxf(punta_z,(p as Vector2).y)
	chance["extras_mates"] = _settle_extras(
		_corner_resto_mio(chance, _retaguardia(_al_hombro(chance,
			_drop_nearest(my_all, ball, support.size()), support, ball, last_def),
			support, ball, punta_z), defenders + chance["extras_rivals"], ball, punta_z),
		actives, ball,
		minf(last_def, ball.y) + ScenarioStore.ONSIDE_MARGIN if last_def < INF else - INF)







	if String(chance.get("name", "")) == "Penal":



		var corro: Array = support + defenders




		var sitio: Array = _penal_sitio_interior(chance["extras_rivals"],
			chance["extras_mates"], ball, "penal_sitio %.3f" %(
				(defenders[0] as Vector2).x if not defenders.is_empty() else 0.0))
		chance["extras_rivals"] = _legalize_penalty(sitio[0], ball, corro)
		chance["extras_mates"] = _legalize_penalty(
			sitio[1], ball, corro + chance["extras_rivals"])























const HOMBRO_N: int = 2
const HOMBRO_HUECO: float = 8.0


const HOMBRO_BANDA: float = 4.0
const HOMBRO_FONDO: float = 2.5
const HOMBRO_KINDS: Array[String] = ["frontal", "lejano", "angulo", "contra"]




const HOMBRO_LLEGADA: float = 12.0


func _al_hombro(chance: Dictionary, mates: Array, support: Array, ball: Vector2,
		last_def: float) -> Array:
	if last_def >= INF or ball.y - last_def < HOMBRO_HUECO or ball.y > ScenarioStore.HALF_LINE:
		return mates
	if not bool(chance.get("generica", false)) or chance.has("tras_balon") \
			or int(chance.get("wall_count", 0)) > 0 \
			or not HOMBRO_KINDS.has(String(chance.get("kind", ""))):
		return mates
	var techo: float = last_def + HOMBRO_BANDA
	var ya: int = 0
	for p in support + mates:
		var z: float =(p as Vector2).y
		if z >= last_def - 0.3 and z <= techo and z < ball.y - 3.0:
			ya += 1
	if ya >= HOMBRO_N:
		return mates



	var cand: Array = []
	for i in mates.size():
		var z2: float =(mates[i] as Vector2).y
		if z2 > techo and z2 < ball.y + HOMBRO_LLEGADA:
			cand.append(i)
	cand.sort_custom(func(a, b): return (mates[a] as Vector2).y <(mates[b] as Vector2).y)
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "hombro")
	var out: Array = mates.duplicate()
	for k in mini(HOMBRO_N - ya, cand.size()):
		var i: int = int(cand[k])
		out[i] = Vector2((out[i] as Vector2).x,
			last_def + ScenarioStore.ONSIDE_MARGIN + r.randf_range(0.0, HOMBRO_FONDO))
	return out


























const RETA_N: int = 2

const RETA_UMBRAL: float = 25.0


const RETA_TRAS: Vector2 = Vector2(27.0, 32.0)
const RETA_JIT: float = 1.2

const RETA_PISO: float = 0.8


const PUNTA_TRAS: Vector2 = Vector2(25.5, 31.0)
const RETA_TRAS_PUNTA: float = 1.0
const PUNTA_CIERRE: float = 0.5
const PUNTA_X_MAX: float = 12.0







func _retaguardia(mates: Array, support: Array, ball: Vector2,
		punta_z: float = - INF) -> Array:
	if mates.is_empty() or ball.y >= ScenarioStore.HALF_LINE:
		return mates
	var linea: float = maxf(ball.y + RETA_UMBRAL, punta_z)
	var ya: int = 0
	for p in support + mates:
		if (p as Vector2).y > linea:
			ya += 1
	if ya >= RETA_N:
		return mates
	var fondo: float = - INF
	for p in mates:
		fondo = maxf(fondo,(p as Vector2).y)
	var fila: Array = []
	var resto: Array = []
	for i in mates.size():
		var q: Vector2 = mates[i]
		if q.y > linea:
			continue
		if q.y >= fondo - 1.5:
			fila.append(i)
		else:
			resto.append(i)
	fila.sort_custom(func(a, b): return absf((mates[a] as Vector2).x) < absf((mates[b] as Vector2).x))
	resto.sort_custom(func(a, b): return (mates[a] as Vector2).y >(mates[b] as Vector2).y)
	var orden: Array = fila + resto
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "retaguardia")
	var z0: float = ball.y + r.randf_range(RETA_TRAS.x, RETA_TRAS.y)
	var out: Array = mates.duplicate()
	for k in mini(RETA_N - ya, orden.size()):
		var i: int = int(orden[k])
		var z: float = maxf(z0 + r.randf_range(- RETA_JIT, RETA_JIT),
			maxf(ball.y + RETA_UMBRAL + RETA_PISO, punta_z + RETA_TRAS_PUNTA))
		out[i] = Vector2((out[i] as Vector2).x, minf(z, EXTRA_BACK))
	return out







func _punta_arriba(chance: Dictionary, rivals: Array, ball: Vector2) -> Array:
	if rivals.is_empty() or ball.y >= ScenarioStore.HALF_LINE \
			or chance.has("tras_balon") or bool(chance.get("encerrado", false)):
		return rivals
	var quien: int = 0
	for i in rivals.size():
		var q: Vector2 = rivals[i]
		if q.y > ball.y + RETA_UMBRAL:
			return rivals
		if q.y >(rivals[quien] as Vector2).y:
			quien = i
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "punta")
	var p: Vector2 = rivals[quien]
	var out: Array = rivals.duplicate()
	out[quien] = Vector2(clampf(p.x * PUNTA_CIERRE, - PUNTA_X_MAX, PUNTA_X_MAX),
		minf(ball.y + r.randf_range(PUNTA_TRAS.x, PUNTA_TRAS.y), EXTRA_BACK))
	return out




























const CORNER_ARRIBA_N: int = 2


const CORNER_ARRIBA_Z: Vector2 = Vector2(26.5, 31.0)

const CORNER_RECHACE_Z: Vector2 = Vector2(17.2, 19.5)
const CORNER_RECHACE_X: float = 5.0


const CORNER_SEGUNDA_Z: Vector2 = Vector2(20.5, 23.5)
const CORNER_SEGUNDA_X: float = 9.0
const CORNER_SEGUNDA_SEP: float = 3.6

const CORNER_MEDIO_Z: Vector2 = Vector2(26.0, 30.0)


func _corner_resto_rival(resto: Array, defenders: Array, ball: Vector2) -> Array:
	if resto.is_empty():
		return resto
	var sb: float = 1.0 if absf(ball.x) < 2.0 else _side_of(ball.x)
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "corner_resto %.3f" %(
		(defenders[0] as Vector2).x if not defenders.is_empty() else 0.0))
	var out: Array = resto.duplicate()
	var orden: Array = range(out.size())
	orden.sort_custom(func(a, b): return (out[a] as Vector2).y >(out[b] as Vector2).y)
	var n_arriba: int = mini(CORNER_ARRIBA_N, out.size())
	for k in n_arriba:
		var p: Vector2 = out[int(orden[k])]
		out[int(orden[k])] = Vector2(p.x, minf(maxf(p.y,
			ball.y + r.randf_range(CORNER_ARRIBA_Z.x, CORNER_ARRIBA_Z.y)), EXTRA_BACK))
	var abajo: Array = orden.slice(n_arriba)
	if abajo.is_empty():
		return out

	var sitio: Vector2 = Vector2(r.randf_range(- CORNER_RECHACE_X, CORNER_RECHACE_X),
		r.randf_range(CORNER_RECHACE_Z.x, CORNER_RECHACE_Z.y))
	var quien: int = 0
	for k in abajo.size():
		if (out[int(abajo[k])] as Vector2).distance_to(sitio) \
				<(out[int(abajo[quien])] as Vector2).distance_to(sitio):
			quien = k
	out[int(abajo[quien])] = sitio
	abajo.remove_at(quien)


	var cubren: Array = defenders.duplicate()
	var keeper: Vector2 = _keeper_spot(ball)
	for i in abajo:
		var mejor: Vector2 = ZONA_D_CORNER[0]
		var mejor_d: float = -1.0
		for slot in ZONA_D_CORNER:
			var th: float = deg_to_rad(slot.y)
			var q: Vector2 = Vector2(sb * slot.x * sin(th), slot.x * cos(th))
			var d: float = INF
			for c in cubren:
				d = minf(d, q.distance_to(c))
			if d > mejor_d:
				mejor_d = d
				mejor = slot
		var rho: float = mejor.x * r.randf_range(ZONA_JIT_R.x, ZONA_JIT_R.y)
		var th2: float = deg_to_rad(mejor.y + r.randf_range(- ZONA_JIT_T, ZONA_JIT_T))
		var p2: Vector2 = _push_out(Vector2(sb * rho * sin(th2), rho * cos(th2)), keeper,
			KEEPER_CLEAR)
		out[int(i)] = p2
		cubren.append(p2)
	return out





func _corner_resto_mio(chance: Dictionary, mates: Array, rivales: Array, ball: Vector2,
		punta_z: float) -> Array:
	if mates.is_empty() or String(chance.get("kind", "")) != "corner":
		return mates
	var linea: float = maxf(ball.y + RETA_UMBRAL, punta_z)
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "corner_mio %.3f" %(
		(rivales[0] as Vector2).x if not rivales.is_empty() else 0.0))
	var out: Array = mates.duplicate()
	var cerca: Array = []
	for i in out.size():
		if (out[i] as Vector2).y <= linea:
			cerca.append(i)
	if cerca.is_empty():
		return out


	var sitio: Vector2 = Vector2.ZERO
	for _t in 16:
		sitio = Vector2(r.randf_range(- CORNER_SEGUNDA_X, CORNER_SEGUNDA_X),
			r.randf_range(CORNER_SEGUNDA_Z.x, CORNER_SEGUNDA_Z.y))
		var suelto: bool = true
		for q in rivales:
			if sitio.distance_to(q) < CORNER_SEGUNDA_SEP:
				suelto = false
				break
		if suelto:
			break
	var quien: int = 0
	for k in cerca.size():
		if (out[int(cerca[k])] as Vector2).distance_to(sitio) \
				<(out[int(cerca[quien])] as Vector2).distance_to(sitio):
			quien = k
	out[int(cerca[quien])] = sitio
	cerca.remove_at(quien)
	for i in cerca:
		var p: Vector2 = out[int(i)]
		out[int(i)] = Vector2(p.x, maxf(p.y,
			ball.y + r.randf_range(CORNER_MEDIO_Z.x, CORNER_MEDIO_Z.y)))
	return out

























const ENCIERRO_P_MAX: float = 0.5
const ENCIERRO_Z: Vector2 = Vector2(17.0, 32.0)
const ENCIERRO_KINDS: Array[String] = ["frontal", "lejano"]








func _nivel_encierro() -> float:
	if not _cerrojo_vivo:
		return _desnivel
	return maxf(_desnivel, Tactics.cerrojo(match_minute, _dif_rival(), _empate_rival,
		_sit_desde()))


func _encierro(origin: Dictionary, ball: Vector2, kind: String, cross: bool,
		wall: int) -> Dictionary:
	var nivel: float = _nivel_encierro()
	if nivel <= 0.0 or cross or wall > 0 or not ENCIERRO_KINDS.has(kind) \
			or bool(origin.get("set_piece", false)) or bool(origin.get("encerrado", false)) \
			or origin.has("def_shape") or origin.has("def_line") or origin.has("tras_balon"):
		return origin
	if ball.y < ENCIERRO_Z.x or ball.y > ENCIERRO_Z.y:
		return origin
	if _rng_de_jugada(ball, "encierro").randf() >= ENCIERRO_P_MAX * nivel:
		return origin

	var out: Dictionary = origin.duplicate()
	out["def_shape"] = "bajo"
	out["encerrado"] = true
	return out























const BAJO_B1_JIT: float = 0.4






const BAJO_B1_N: int = 5
const BAJO_B2: Vector2 = Vector2(6.5, 9.0)



const BAJO_B2_DELANTE: float = 3.0
const BAJO_B2_MIN: float = 4.5
const BAJO_B2_N: int = 4
const BAJO_TAPON: Vector2 = Vector2(12.0, 15.0)
const BAJO_JIT: float = 0.5
const BAJO_ANCHO: float = 0.8


func _bloque_bajo(resto: Array, riv_all: Array, activos: Array, ball: Vector2,
		linea: float) -> Array:
	if resto.is_empty() or linea == INF:
		return resto


	var filas: Array = []
	var suma_x: Dictionary = {}
	var n_fila: Dictionary = {}
	for p in riv_all:
		var z: float = snappedf((p as Vector2).y, 0.01)
		if not filas.has(z):
			filas.append(z)
		suma_x[z] = float(suma_x.get(z, 0.0)) +(p as Vector2).x
		n_fila[z] = int(n_fila.get(z, 0)) + 1
	filas.sort()
	var en_b1: int = 0
	var en_b2: int = 0
	for p in activos:
		var dz: float =(p as Vector2).y - linea
		if dz < BAJO_B2_MIN - BAJO_JIT:
			en_b1 += 1
		elif dz <= BAJO_B2.y + BAJO_JIT:
			en_b2 += 1
	var orden: Array = range(resto.size())
	orden.sort_custom(func(a, b):
		var pa: Vector2 = resto[a]
		var pb: Vector2 = resto[b]
		if not is_equal_approx(pa.y, pb.y):
			return pa.y < pb.y
		return absf(pa.x) < absf(pb.x))
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "bajo")
	var z_b2: float = maxf(minf(linea + r.randf_range(BAJO_B2.x, BAJO_B2.y),
		ball.y - BAJO_B2_DELANTE), linea + BAJO_B2_MIN)
	var z_tapon: float = linea + r.randf_range(BAJO_TAPON.x, BAJO_TAPON.y)
	var out: Array = resto.duplicate()
	for i in orden:
		var p: Vector2 = resto[i]
		var zr: float = snappedf(p.y, 0.01)
		var c: float = float(suma_x[zr]) / float(n_fila[zr]) if n_fila.has(zr) else p.x
		var z: float
		if not filas.is_empty() and zr == float(filas[0]) and en_b1 < BAJO_B1_N:
			z = linea + r.randf_range(- BAJO_B1_JIT, BAJO_B1_JIT)
			en_b1 += 1
		elif en_b2 < BAJO_B2_N:
			z = z_b2 + r.randf_range(- BAJO_JIT, BAJO_JIT)
			en_b2 += 1
		else:
			z = z_tapon + r.randf_range(- BAJO_JIT, BAJO_JIT)
		out[i] = Vector2(c +(p.x - c) * BAJO_ANCHO, minf(z, EXTRA_BACK))
	return out







const STRAGGLER_MAX: float = 2.0



const PEN_ARC_R: float = 9.15
const PEN_OUT_PAD: float = 0.8













func _legalize_penalty(pts: Array, spot: Vector2, fixed: Array = []) -> Array:
	var out: Array = fixed.duplicate()
	var n_fixed: int = out.size()
	for p in pts:
		var q: Vector2 = p







		for _pass in 3:


			if absf(q.x) <= Stadium.PA_HALF_W and q.y < Stadium.PA_DEPTH + PEN_OUT_PAD:
				q.y = Stadium.PA_DEPTH + PEN_OUT_PAD

			var d: Vector2 = q - spot
			if d.length() < PEN_ARC_R:
				var dir: Vector2 = d.normalized() if d.length() > 0.01 else Vector2(0.0, 1.0)
				q = spot + dir *(PEN_ARC_R + PEN_OUT_PAD)

			for k in out:
				q = _push_out(q, k, EXTRA_SEP)
		out.append(_inside_field(q))


	return out.slice(n_fixed)




































const PEN_SITIO_X: float = 8.0
const PEN_SITIO_PASO: float = 2.5
const PEN_SITIO_JIT: float = 0.25


const PEN_SITIO_TRAS: float = 0.5
const PEN_SITIO_ALCANCE: float = 16.0


func _penal_sitio_interior(rivals: Array, mates: Array, spot: Vector2, sal: String) -> Array:
	var r: RandomNumberGenerator = _rng_de_jugada(spot, sal)
	var z: float = Stadium.PA_DEPTH + PEN_OUT_PAD
	var suyos: Array = rivals.duplicate()
	var mios: Array = mates.duplicate()
	var tomados_r: Dictionary = {}
	var tomados_m: Dictionary = {}

	var hondos: Array = range(mios.size())
	hondos.sort_custom(func(a, b): return (mios[a] as Vector2).y >(mios[b] as Vector2).y)
	for k in mini(RETA_N, hondos.size()):
		tomados_m[hondos[k]] = true


	for k in [0, 2]:
		for s in [-1.0, 1.0]:
			var x: float = PEN_SITIO_X + k * PEN_SITIO_PASO + r.randf_range(- PEN_SITIO_JIT, PEN_SITIO_JIT)
			_penal_ocupa(suyos, tomados_r, Vector2(s * x, z), spot)
	for s in [-1.0, 1.0]:
		var x: float = PEN_SITIO_X + PEN_SITIO_PASO + r.randf_range(- PEN_SITIO_JIT, PEN_SITIO_JIT)
		_penal_ocupa(mios, tomados_m, Vector2(s * x, z + PEN_SITIO_TRAS), spot, INF)
	return [suyos, mios]




func _penal_ocupa(pts: Array, tomados: Dictionary, sitio: Vector2, spot: Vector2,
		alcance: float = PEN_SITIO_ALCANCE) -> void:
	var mejor: int = -1
	var dm: float = INF
	for i in pts.size():
		var p: Vector2 = pts[i]
		if tomados.has(i) or p.y > spot.y + alcance:
			continue
		var d: float = p.distance_to(sitio)
		if d < dm:
			dm = d
			mejor = i
	if mejor >= 0:
		pts[mejor] = sitio
		tomados[mejor] = true















func _falta_plana_resto(chance: Dictionary, ball: Vector2, defenders: Array, actives: Array) -> void:
	var extras: Array = chance.get("extras_rivals", [])
	if extras.is_empty():
		return
	var wall_n: int = int(chance.get("wall_count", 0))
	var zp: float = float(chance["plana"])
	var sb: float = 1.0 if absf(ball.x) < 2.0 else _side_of(ball.x)
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "plana")
	var fwd: Vector2 =(Vector2.ZERO - ball).normalized()
	var perp: Vector2 = Vector2(- fwd.y, fwd.x)
	var metas: Array = []
	for i in range(maxi(defenders.size() - wall_n, 0), FK_PLANA_N):
		var sp: Vector2 = _falta_plana_sitio(i, sb, zp)
		metas.append(Vector2(sp.x + r.randf_range(- FK_PLANA_JIT_X, FK_PLANA_JIT_X),
			sp.y + r.randf_range(- FK_PLANA_JIT_Z, FK_PLANA_JIT_Z)))


	if wall_n > 0:
		var muro: Vector2 = Vector2.ZERO
		for i in wall_n:
			muro +=(defenders[i] as Vector2) / float(wall_n)
		var p: Vector2 = muro.lerp(Vector2(0.0, zp), FK_PLANA_ENTRE + r.randf_range(-0.08, 0.08))
		var l: float =(p - ball).dot(perp)
		if absf(l) < FK_PLANA_ENTRE_LADO:
			var lado: float = signf(l) if absf(l) > 0.3 else (1.0 if r.randf() < 0.5 else -1.0)
			p += perp *(lado * FK_PLANA_ENTRE_LADO - l)
		metas.append(p)


	var xr: float = - sb * r.randf_range(FK_PLANA_RECHACE_X.x, FK_PLANA_RECHACE_X.y)
	var zr: float = zp + FK_PLANA_RECHACE
	var dx: float = absf(xr - ball.x)
	if Vector2(xr, zr).distance_to(ball) < FK_PLANA_BALON and dx < FK_PLANA_BALON:
		zr = ball.y - sqrt(FK_PLANA_BALON * FK_PLANA_BALON - dx * dx) - 0.1
	if zr >= zp + FK_PLANA_PICO[0] + ACTOR_SEP:
		metas.append(Vector2(xr, zr))
	var fin: Array = extras.duplicate()
	var tomados: Dictionary = {}
	for meta in metas:
		var mejor: int = -1
		var dm: float = INF
		for i in extras.size():
			var q: Vector2 = extras[i]
			if tomados.has(i) or q.y > ball.y + FK_PLANA_ALCANCE:
				continue
			var dd: float = q.distance_to(meta)
			if dd < dm:
				dm = dd
				mejor = i
		if mejor < 0:
			break
		tomados[mejor] = true
		var sitio: Vector2 = _falta_plana_hueco(meta, mejor, fin, actives, ball)
		if sitio != Vector2.INF:
			fin[mejor] = sitio
	chance["extras_rivals"] = fin





func _falta_plana_hueco(meta: Vector2, idx: int, pts: Array, actives: Array,
		ball: Vector2) -> Vector2:
	var otros: Array = []
	for j in pts.size():
		if j != idx:
			otros.append(pts[j])
	var fwd: Vector2 =(Vector2.ZERO - ball).normalized()
	var perp: Vector2 = Vector2(- fwd.y, fwd.x)
	var reach: float = ball.length()
	for k in FK_PLANA_HUECO_PASOS:
		var p: Vector2 = meta + Vector2(FK_PLANA_HUECO_PASO * float((k + 1) / 2)
			*(1.0 if k % 2 == 1 else -1.0), 0.0)
		if absf(p.x) > FIELD_EDGE or p.y < 1.5 or p.distance_to(ball) < FK_PLANA_BALON:
			continue
		var rel: Vector2 = p - ball
		var a: float = rel.dot(fwd)
		if a > 0.0 and a < reach and absf(rel.dot(perp)) < EXTRA_LANE_HALF:
			continue
		if _extra_conflict(p, actives, otros, ball) != Vector2.INF:
			continue
		return p
	return Vector2.INF





const EXTRA_SEP: float = 1.8
const EXTRA_LANE_HALF: float = 1.75



const EXTRA_BACK: float = 100.0


























const PILLADO_JIT_Z: float = 3.5
const PILLADO_JIT_X: float = 2.5
const PILLADO_MIN_TRAS: float = 2.0
const PILLADO_CIERRE: float = 0.5
const PILLADO_CARRIL: float = 0.65
const PILLADO_LARGO: float = 0.75


func _bloque_pillado(pos: Array, ball: Vector2, lo: float, hi: float) -> Array:
	if pos.is_empty():
		return pos
	var fondo: float = INF
	for p in pos:
		fondo = minf(fondo,(p as Vector2).y)
	var z0: float = ball.y + randf_range(lo, hi)


	var cx: float = ball.x * PILLADO_CARRIL
	var out: Array = []
	for p in pos:
		var v: Vector2 = p
		var q: Vector2 = Vector2(
			lerpf(v.x, cx, PILLADO_CIERRE) + randf_range(- PILLADO_JIT_X, PILLADO_JIT_X),
			z0 +(v.y - fondo) * PILLADO_LARGO + randf_range(- PILLADO_JIT_Z, PILLADO_JIT_Z))
		q.y = clampf(q.y, ball.y + PILLADO_MIN_TRAS, EXTRA_BACK)
		q.x = clampf(q.x, - FIELD_EDGE, FIELD_EDGE)
		out.append(q)
	return out


























const PERSE_R: Vector2 = Vector2(8.5, 10.5)
const PERSE_L: Vector2 = Vector2(1.5, 3.5)
const PERSE_SEP: float = 2.0


func _perseguidor(extras: Array, actives: Array, ball: Vector2, n: int) -> void:
	var fwd: Vector2 =(Vector2.ZERO - ball).normalized()
	var perp: Vector2 = Vector2(- fwd.y, fwd.x)
	for _k in n:
		var ultimo: int = -1
		for i in extras.size():
			if ultimo < 0 or (extras[i] as Vector2).y <(extras[ultimo] as Vector2).y:
				ultimo = i
		var quien: int = -1
		for i in extras.size():
			var q: Vector2 = extras[i]
			if i == ultimo:
				continue
			if quien < 0 or q.distance_to(ball) <(extras[quien] as Vector2).distance_to(ball):
				quien = i
		if quien < 0:
			return



		for t in 40:
			var abre: float = float(t) / 39.0
			var l: float =(1.0 if randf() < 0.5 else -1.0) \
					* randf_range(PERSE_L.x, PERSE_L.y + 1.5 * abre)
			var r: float = randf_range(PERSE_R.x, PERSE_R.y + 1.0 * abre)
			var cand: Vector2 = ball - fwd * sqrt(r * r - l * l) + perp * l
			if absf(cand.x) > FIELD_EDGE - 0.5:
				continue
			var libre: bool = true
			for o in actives + extras:
				if o != extras[quien] and cand.distance_to(o) < PERSE_SEP:
					libre = false
					break
			if libre:
				extras[quien] = cand
				break


func _settle_extras(extras: Array, actives: Array, ball: Vector2,
		floor_z: float = - INF) -> Array:
	var fwd: Vector2 =(Vector2.ZERO - ball).normalized()
	var perp: Vector2 = Vector2(- fwd.y, fwd.x)
	var reach: float = ball.length()
	var kept: Array = []
	for p0 in extras:
		var p: Vector2 = p0
		for _pass in 2:
			for q in actives:
				p = _push_out(p, q, EXTRA_SEP)
			for q in kept:
				p = _push_out(p, q, EXTRA_SEP)
			p = _push_out(p, ball, EXTRA_SEP)


			var rel: Vector2 = p - ball
			var a: float = rel.dot(fwd)
			var l: float = rel.dot(perp)
			if a > 0.0 and a < reach and absf(l) < EXTRA_LANE_HALF:
				p = ball + fwd * a + perp *(EXTRA_LANE_HALF *(1.0 if l >= 0.0 else -1.0))





		for _try in 6:
			var hit: Vector2 = _extra_conflict(p, actives, kept, ball)
			if hit == Vector2.INF:
				break
			p += fwd *(EXTRA_SEP *(1.0 if (p - hit).dot(fwd) >= 0.0 else -1.0))























		if floor_z > - INF:
			p.y = maxf(p.y, floor_z)










		p.x = clampf(p.x, - FIELD_EDGE, FIELD_EDGE)
		p.y = clampf(p.y, 1.5, EXTRA_BACK)
		var rel2: Vector2 = p - ball
		var a2: float = rel2.dot(fwd)
		if a2 > 0.0 and a2 < reach and absf(rel2.dot(perp)) < EXTRA_LANE_HALF:
			p = ball + fwd * a2 + perp *(EXTRA_LANE_HALF
				*(1.0 if rel2.dot(perp) >= 0.0 else -1.0))
			var back: int = 0
			while floor_z > - INF and p.y < floor_z - 0.001 and back < 60:
				p -= fwd
				back += 1
		for _escape in 24:
			if _extra_conflict(p, actives, kept, ball) == Vector2.INF:
				break
			p -= fwd * EXTRA_SEP
		kept.append(Vector2(clampf(p.x, - FIELD_EDGE, FIELD_EDGE),
			clampf(p.y, 1.5, EXTRA_BACK)))
	return kept



func _extra_conflict(p: Vector2, actives: Array, kept: Array, ball: Vector2) -> Vector2:
	if p.distance_to(ball) < EXTRA_SEP:
		return ball
	for q in actives:
		if p.distance_to(q) < EXTRA_SEP:
			return q
	for q in kept:
		if p.distance_to(q) < EXTRA_SEP:
			return q
	return Vector2.INF








