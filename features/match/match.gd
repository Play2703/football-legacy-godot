func _rival_clear() -> void:
	if state != State.PASSING:
		return

	if _bsube_vuelo:
		_bsube_congela()
	var bp: Vector3 = _ball.position



	if _robo_area_puede(bp):
		_robo_area_dispara(bp, _last_toucher)
		return


	if _meta_castiga(bp):
		return


	_play_clear_gesture(_last_toucher, bp.y > HEADER_MIN_H)






	_audio.kick()
	_ball_field = Vector2(bp.x, bp.z)
	_clear_phase = true

