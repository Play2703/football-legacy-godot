	var p: Vector3 = Vector3(yo.position.x, 0.0, yo.position.z)
	return [p - der, p + der, p + Vector3.UP * 2.3]



func _recep_ojo_pelotazo(srv2: Vector2, pase: Vector2) -> Vector3:
