	var last: int = _traj.size() - 1
	if _stop_i > 0:
		last = mini(last, _stop_i)
	var subio: bool = false
	for i in range(_traj_i, last + 1):
		var y: float =(_traj[i] as Vector3).y
		if y > HEADER_MAX_H:
			subio = true
		elif subio:
			return _traj[i]
		elif i > _traj_i and y <= 0.02:

			break
	return _ball.position




func _corro_radios(support: Dictionary, centro: Vector3) -> Dictionary:
	var out: Dictionary = {}
	for lista in _chase_pools():
		var rank: Array = []
		for a in lista:
			if support.has(a) and is_instance_valid(a):
				rank.append([_flat_dist(a.position, centro), a])
		rank.sort_custom(func(x: Array, y: Array) -> bool: return x[0] < y[0])
		for k in rank.size():
			out[rank[k][1]] = CORRO_R_DENTRO if k < SUPPORT_N else CORRO_R_FUERA
	return out

















func _onside_floor() -> float:
	var line_z: float = _onside_line_z()
	if line_z == INF:
		return - INF
	return line_z + Duel.ONSIDE_SLACK




































func _onside_line_z() -> float:
	var line_z: float = _last_defender_z()
	if line_z == INF:
		return INF
	return minf(minf(line_z, _ball.position.z), Stadium.HALF_LINE)




func _block_home(actor: AnimatedSprite3D, paseo: bool = true) -> Vector2:
	var home: Vector2 = _home_pos.get(actor, Vector2(actor.position.x, actor.position.z))
	var ball: Vector2 = Vector2(_ball.position.x, _ball.position.z)
	var d: Vector2 = ball - _home_ball0



	var sx: float = _tac_shift_x_rival if _rival_set.has(actor) else _tac_shift_x_mine
	var dz: float = d.y * HOME_SHIFT_Z




	var dx: float = d.x * sx

	if _bsube_dz > 0.0 and _rival_set.has(actor) and actor != _keeper:
		dz += _bsube_efectivo(dz, ball.y)
	var dz_bloque: float = dz
	if _rival_set.has(actor) and _repliegue_vivo():
		dz = _repliegue_z(home.y + dz, ball.y, dz) - home.y
		dx = _repliegue_x(home.x + dx, ball, dx, dz_bloque) - home.x
	elif _repliegue_vivo() and actor != _self_actor:
		dz = _sube_z(home.y + dz, ball.y, dz) - home.y
	return _inside_field(home + Vector2(dx, dz)
		+(_ambient_off(actor) if paseo else Vector2.ZERO))




func _repliegue_on() -> bool:
	return (_drive_active or _drive_coast) and state == State.AIMING and not _repliegue_off




func _repliegue_vivo() -> bool:
	return _repliegue_on() or (_repl_vivo and not _repliegue_off
		and state in [State.STRIKING, State.RUNUP, State.FLIGHT, State.PASSING, State.DUEL])





func _repliegue_z(home_z: float, ball_z: float, dz: float = 0.0) -> float:
	var zmin: float = INF
	var zmax: float = - INF
	for r in _rival_actors:
		if is_instance_valid(r) and r != _keeper and _home_pos.has(r):
			zmin = minf(zmin,(_home_pos[r] as Vector2).y + dz)
			zmax = maxf(zmax,(_home_pos[r] as Vector2).y + dz)
	if is_inf(zmin):
		return home_z
	var linea: float = minf(zmin, _repliegue_techo(ball_z))
	var aprieto: float = _repliegue_aprieto(zmin, ball_z)
	var largo: float = lerpf(REPL_LARGO_ALTO, REPL_LARGO_BAJO, _tac_bloque)
	var junta: float = lerpf(1.0, minf(1.0, largo / maxf(zmax - zmin, 0.01)), aprieto)
	return linea +(home_z - zmin) * junta




func _repliegue_aprieto(zmin: float, ball_z: float) -> float:
	var colchon: float = lerpf(REPL_COLCHON_ALTO, REPL_COLCHON_BAJO, _tac_bloque)
	return clampf((zmin + colchon + REPL_AVISO_M - ball_z) / REPL_AVISO_M, 0.0, 1.0)




func _repliegue_x(x: float, ball: Vector2, dx: float, dz: float) -> float:
	var xmin: float = INF
	var xmax: float = - INF
	var zmin: float = INF
	for r in _rival_actors:
		if is_instance_valid(r) and r != _keeper and _home_pos.has(r):
			var h: Vector2 = _home_pos[r]
			xmin = minf(xmin, h.x + dx)
			xmax = maxf(xmax, h.x + dx)
			zmin = minf(zmin, h.y + dz)
	var ancho: float = xmax - xmin
	var tope: float = lerpf(REPL_ANCHO_ALTO, REPL_ANCHO_BAJO, _tac_bloque)
	if is_inf(zmin) or ancho <= tope:
		return x
	var k: float = lerpf(1.0, tope / ancho, _repliegue_aprieto(zmin, ball.y))
	var cx: float = clampf(ball.x, - REPL_CENTRO_X, REPL_CENTRO_X)
	return cx +(x - cx) * k




func _sube_z(home_z: float, ball_z: float, dz: float) -> float:
	if home_z <= ball_z:
		return home_z
	var zmax: float = - INF
	for t in _teammate_actors:
		if is_instance_valid(t) and t != _self_actor and _home_pos.has(t):
			zmax = maxf(zmax,(_home_pos[t] as Vector2).y + dz)
	if zmax - ball_z <= SUBE_LARGO:
		return home_z
	return ball_z +(home_z - ball_z) * SUBE_LARGO /(zmax - ball_z)




func _repliegue_techo(ball_z: float) -> float:
	return maxf(lerpf(REPL_SUELO_ALTO, REPL_SUELO_BAJO, _tac_bloque),
		ball_z - lerpf(REPL_COLCHON_ALTO, REPL_COLCHON_BAJO, _tac_bloque))




func _bsube_efectivo(dz: float, ball_z: float) -> float:
	var zmin: float = INF
	for r in _rival_actors:
		if is_instance_valid(r) and r != _keeper and _home_pos.has(r):
			zmin = minf(zmin,(_home_pos[r] as Vector2).y + dz)
	if is_inf(zmin):
		return 0.0
	var techo: float = minf(_repliegue_techo(ball_z), Stadium.HALF_LINE)
	return clampf(_bsube_dz, 0.0, maxf(0.0, techo - zmin))




func _bsube_hueco() -> float:
	return _bsube_efectivo((_ball.position.z - _home_ball0.y) * HOME_SHIFT_Z, _ball.position.z)







func _bsube_zaga(a: AnimatedSprite3D) -> bool:
	if not _home_pos.has(a):
		return false
	var zmin: float = INF
	for r in _rival_actors:
		if is_instance_valid(r) and r != _keeper and _home_pos.has(r):
			zmin = minf(zmin,(_home_pos[r] as Vector2).y)
	return (_home_pos[a] as Vector2).y - zmin <= BSUBE_ZAGA_M




func _bsube_arma() -> void:
	_bsube_vuelo = false
	if _bsube_off or _rival_set.is_empty() or _servicio_por_rematar() or _traj.is_empty() \
			or not (_drive_enabled or _press_on):
		return


	if _traj[0].z < lerpf(REPL_SUELO_ALTO, REPL_SUELO_BAJO, _tac_bloque):
		return
	var m: Vector2 = _pase_atras_medida()
	if m.x >= BSUBE_RETRO_M and m.y >= BSUBE_LARGO_M and m.x >= BSUBE_ANGULO * m.y:
		_bsube_dz += lerpf(BSUBE_K_ALTO, BSUBE_K_BAJO, _tac_bloque) * m.x
		_bsube_vuelo = true









func _pase_atras_medida() -> Vector2:
	if _traj.size() < 2:
		return Vector2.ZERO
	var fin: int = _traj.size()
	if _rebound_i >= 0:
		fin = mini(fin, _rebound_i)
	for t in _desv_toques:
		fin = mini(fin, int((t as Dictionary).get("i", fin)))
	var apice: int = 0
	for j in fin:
		if _traj[j].y > _traj[apice].y:
			apice = j
	var desde_j: int = apice if _traj[apice].y > HEADER_MAX_H else 1
	var desde: Vector2 = Vector2(_traj[0].x, _traj[0].z)
	for j in range(desde_j, fin):
		var p: Vector3 = _traj[j]
		if p.y > HEADER_MAX_H:
			continue
		for t in _teammate_actors:
			if is_instance_valid(t) and t != _self_actor and t.visible \
					and Vector2(t.position.x - p.x, t.position.z - p.z).length() <= BSUBE_RECIBE_M:
				var hasta: Vector2 = Vector2(p.x, p.z)
				return Vector2(hasta.y - desde.y, desde.distance_to(hasta))
	return Vector2.ZERO



func _bsube_congela() -> void:
	_bsube_vuelo = false
	if _bsube_dz <= 0.0:
		return
	var casa: float = INF
	var real: float = INF
	for r in _rival_actors:
		if is_instance_valid(r) and r != _keeper and _home_pos.has(r) \
				and not r.has_meta("press_role") and not r.has_meta("hold_wall"):
			casa = minf(casa,(_home_pos[r] as Vector2).y)
			real = minf(real, r.position.z)
	if is_inf(casa):
		return
	var basc: float =(_ball.position.z - _home_ball0.y) * HOME_SHIFT_Z
	_bsube_dz = clampf(real -(casa + basc), 0.0, _bsube_dz)

















func _bsube_paso(a: AnimatedSprite3D, goal: Vector2, delta: float, sprint: float,
		empuja: bool) -> float:
	var base: float = sprint * TRAIL_MULT
	if _bsube_dz <= 0.0 or not _bsube_vuelo:
		return base
	var pos: Vector2 = Vector2(a.position.x, a.position.z)
	if _rival_set.has(a) and a != _keeper:
		var ancla: Vector2 = _block_home(a, false)

		if goal.y - pos.y <= absf(goal.x - pos.x) or ancla.y - pos.y <= REPL_TROTE_OFF \
				or _bsube_hueco() <= 0.0:
			return base
		return maxf(base, _repliegue_paso(a, pos, Vector2(pos.x, ancla.y), ancla, delta,
			maxf(SUBE_SPD * _puddle_slow(pos), sprint)))
	if empuja:
		_repliegue_paso(a, pos, goal, goal, delta, maxf(SUBE_SPD, sprint))
		return maxf(base, maxf(SUBE_SPD, sprint))
	return base






func _holder_repliega(r: AnimatedSprite3D, i: int, delta: float, moving: Dictionary) -> bool:
	if not _repliegue_on() or not _at_rest(r, moving) or r == _keeper \
			or r.has_meta("hold_wall") or _press_last.has(i) or _order_holds(r) \
			or _offtrap_t > 0.0 or _offtrap_up > 0.0:
		return false


	var meta_z: float = _repliegue_techo(_ball_field.y)
	var pos: Vector2 = Vector2(r.position.x, r.position.z)
	var falta: float = pos.y - meta_z
	if falta <= 0.05:


		r.set_meta("repl_ancla", Vector2(pos.x, meta_z))
		return false
	var spd: float = _repliegue_paso(r, pos, Vector2(pos.x, meta_z), Vector2(pos.x, meta_z),
		delta, REPL_SPD)
	var nz: float = pos.y - minf(falta, spd * delta)
	r.position = Vector3(pos.x, r.position.y, nz)
	if i < _defender_pos.size():
		_defender_pos[i] = Vector2(pos.x, nz)
	_play_run(r, Vector3(0.0, 0.0, nz - pos.y))
	return true





func _repliegue_paso(a: AnimatedSprite3D, pos: Vector2, goal: Vector2, ancla: Vector2,
		delta: float, tope: float) -> float:
	var d: float = pos.distance_to(goal)
	var antes: Vector2 = a.get_meta("repl_ancla", ancla)
	a.set_meta("repl_ancla", ancla)
	var v_ancla: float = antes.distance_to(ancla) / maxf(delta, 0.001)
	if d <= REPL_TROTE_ON and not (a.has_meta("repl_trote")
			and (d > REPL_TROTE_OFF or v_ancla > REPL_ANCLA_VIVA)):
		if a.has_meta("repl_trote"):
			a.remove_meta("repl_trote")
		return AMBIENT_SPD
	a.set_meta("repl_trote", true)
	a.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
	return clampf(REPL_TROTE +(d - REPL_TROTE_ON) * REPL_ACEL, REPL_TROTE, tope)


















const ORDER_BALL_YIELD_M: float = 7.0


func _orders_yield_to_ball() -> void:
	for a in _mate_orders.keys():
		if not _order_owned(a):
			continue






		if a.has_meta("order_paused"):
			continue
		var p: Vector2 = Vector2(a.position.x, a.position.z)
		if p.distance_to(_ball_field) > ORDER_BALL_YIELD_M:
			continue


		for tw in _order_tweens.get(a, []):
			if tw != null and tw.is_valid():
				tw.kill()
		_order_tweens.erase(a)
		_run_target.erase(a)
		_order_release(a)




		_play_run(a, Vector3(_ball_field.x, a.position.y, _ball_field.y) - a.position)








		for m in ["order_drag_rival", "order_drag_cover"]:
			var r: Variant =(a.get_meta(m) if a.has_meta(m) else null)
			if r != null and is_instance_valid(r):
				_run_target.erase(r)
				_order_release(r)






const CELEB_ARRANQUE_X: float = 34.0
const CELEB_ARRANQUE_Z: float = 1.0


const CELEB_ARRANQUE_MIN: float = 0.3
































func _arranque_festejo(actor: AnimatedSprite3D, delta: float) -> bool:
	if _outcome != "goal" or _own_goal_i >= 0 or not is_instance_valid(actor):
		return false








	if int(_anim_lock.get(actor, 0)) > Time.get_ticks_msec() and not _patada_acabada(actor):
		return true


	var anotador: Node3D = _last_toucher if (_pass_done and _last_toucher != null \
			and is_instance_valid(_last_toucher)) else _self_actor
	var destino: Vector3
	if actor == anotador:
		var cs: float = signf(actor.position.x) if absf(actor.position.x) > 0.01 else 1.0
		destino = Vector3(cs * CELEB_ARRANQUE_X, actor.position.y, CELEB_ARRANQUE_Z)
	elif actor == _self_actor or _teammate_actors.has(actor):
		if anotador == null or not is_instance_valid(anotador):
			return false
		destino = Vector3(anotador.position.x, actor.position.y, anotador.position.z)
	else:
		return false
	var hacia: Vector3 = destino - actor.position
	hacia.y = 0.0
	if hacia.length() < CELEB_ARRANQUE_MIN:
		return false


	var spd: float = _chaser_speed.get(actor, AimPress.SPEED_FALLBACK)
	actor.position += hacia.normalized() * minf(spd * delta, hacia.length())
	_play_run(actor, hacia)
	return true








func _patada_acabada(actor: AnimatedSprite3D) -> bool:


	if _carga_viva and actor == _self_actor:
		return false
	return _es_golpeo_pie(String(actor.animation)) and not actor.is_playing()




const GOLPEOS_PIE: Array[String] = ["kick_", "empeine_", "volea_", "despeje_", "bloqueo_"]


static func _es_golpeo_pie(anim: String) -> bool:
	for pre: String in GOLPEOS_PIE:
		if anim.begins_with(pre):
			return true
	return false


func _move_chasers(delta: float) -> void:




	_orders_yield_to_ball()













	var todos: Array = _teammate_actors + _rival_actors





	if _cedida_en_curso:
		todos.append_array(_cedida_mates)
		todos.append_array(_cedida_rivals)



		if _cedida_disputa() and is_instance_valid(_self_actor) \
				and not todos.has(_self_actor):
			todos.append(_self_actor)
			_self_actor.flip_h = false
	if _you_chasing():
		todos.append(_self_actor)



		_self_actor.flip_h = false
	if _clear_phase:
		_amb_t += delta
		for actor in todos:
			if not is_instance_valid(actor) or actor.has_meta("hold_wall"):
				continue



			if _robo_area_vivo and actor == _keeper:
				continue




			if _order_owned(actor):
				continue


			_run_target.erase(actor)














			if int(actor.get_meta("caido_t", 0)) > Time.get_ticks_msec():
				_chase_vels.erase(actor)
				_resbalon_slide(actor, delta)
				continue
			var en_gesto: bool = _anim_lock.get(actor, 0) > Time.get_ticks_msec() \
					and not _patada_acabada(actor)
			var home_c: Vector2 = _block_home(actor)
			var to_c: Vector3 = Vector3(home_c.x, actor.position.y, home_c.y) - actor.position
			to_c.y = 0.0
			var spd_c: float = _chaser_speed.get(actor, AimPress.SPEED_FALLBACK)
			var step_c: float = minf(_bsube_paso(actor, home_c, delta, spd_c, false) * delta,
				to_c.length())
			if step_c <= 0.0001:
				if not en_gesto:
					_face_ball(actor)
				continue
			actor.position += to_c.normalized() * step_c
			if not en_gesto:
				_play_run(actor, to_c)





		_relax_chasers(true, false)
		return




	_amb_t += delta

	var dead_ball: bool = _cross_i >= 0 and _traj_i >= _cross_i \
			and (_outcome == "goal" or _outcome == "wide" or _outcome == "over")
	var contenders: Dictionary = {} if dead_ball else _chase_contenders(delta)
	var support: Dictionary = {} if dead_ball else _support_picks(contenders)
	var corro_c: Vector3 = _corro_centro()
	var corro_r: Dictionary = _corro_radios(support, corro_c)


	var bloqueos: Dictionary = {} if dead_ball else _npc_bloqueos(contenders)
	var al_balon: Dictionary = {}
	_bloqueo_vivo.clear()
	for b in bloqueos:
		al_balon[bloqueos[b][1]] = true
		_bloqueo_vivo[bloqueos[b][0]] = b
	var libre_quietos: bool = _libre_npc_intocable()
	for actor in todos:
		if not is_instance_valid(actor):
			continue

		if _order_owned(actor):
			continue





























		if not actor.has_meta("hold_wall"):
			_run_target.erase(actor)
















		if int(actor.get_meta("caido_t", 0)) > Time.get_ticks_msec():
			_chase_vels.erase(actor)




			_resbalon_slide(actor, delta)
			continue
		if dead_ball:




			if not _arranque_festejo(actor, delta):

				_face_ball(actor)
			continue

		if actor.has_meta("hold_wall"):
			continue



		if libre_quietos and _rival_set.has(actor):
			_chase_vels.erase(actor)
			_face_ball(actor)
			continue




		if actor.has_meta("fk_run"):
			continue









		var gesto: bool = _anim_lock.get(actor, 0) > Time.get_ticks_msec() \
				and not _patada_acabada(actor)
		var to_ball: Vector3 = _ball.position - actor.position
		to_ball.y = 0.0
		var dist: float = to_ball.length()


		var stop_at: float = _touch_radius(_ball.position.y) * 0.85















		if dist < stop_at and not contenders.has(actor):


			_chase_vels.erase(actor)
			if not gesto:
				_face(actor, to_ball)
			continue




		var speed: float = _chaser_speed.get(actor, AimPress.SPEED_FALLBACK)



		speed *= _puddle_slow(Vector2(actor.position.x, actor.position.z))
		if contenders.has(actor):

			var aim: Vector3 = contenders[actor]
			var corte: Vector3 = aim
			var pos: Vector2 = Vector2(actor.position.x, actor.position.z)










			var hombro: Vector2 = Vector2.INF


			var bloquea: bool = bloqueos.has(actor)
			if bloquea:
				hombro = _bloqueo_cita(actor, pos, bloqueos[actor][0], contenders)
			elif not al_balon.has(actor) \
					and float(actor.get_meta("hombro_no", 0.0)) <= float(Time.get_ticks_msec()) / 1000.0:
				hombro = _npc_shoulder(actor, pos, dist, contenders)
			if hombro != Vector2.INF:
				aim = Vector3(hombro.x, aim.y, hombro.y)









			var spd_d: float = speed
			if _bsube_zaga(actor):
				spd_d = maxf(speed, _bsube_paso(actor, Vector2(aim.x, aim.z), delta, speed,
					false))
			var out: Array = Duel.step_defender(pos, _chase_vels.get(actor, Vector2.ZERO),
				Vector2(aim.x, aim.z), spd_d, delta, _rival_accel_k(actor))
			_chase_vels[actor] = out[1]
			var np: Vector2 = _inside_field(out[0])
			var moved: Vector3 = Vector3(np.x, actor.position.y, np.y) - actor.position
			actor.position = Vector3(np.x, actor.position.y, np.y)













			if not gesto:
				var mira: Vector3 = moved if moved.length() > 0.0001 else to_ball
				var ahora_s: float = float(Time.get_ticks_msec()) / 1000.0
				var a_corte: Vector3 = Vector3(corte.x - np.x, 0.0, corte.z - np.y)



				if a_corte.length() > CARGA_MIRA_CORTE_MIN and ((hombro != Vector2.INF and not bloquea) \
						or float(actor.get_meta("carga_t", 0.0)) > ahora_s \
						or float(actor.get_meta("carga_v_t", 0.0)) > ahora_s):
					mira = a_corte
				_play_run(actor, mira)
			continue
		_chase_vels.erase(actor)





		if actor == _meta_por and _meta_saca():
			if not gesto:
				_face_ball(actor)
			continue











		var hombre_m: AnimatedSprite3D = _meta_hombre(actor)
		if hombre_m != null:
			var cita_m: Vector2 = Duel.cover_point(
				Vector2(hombre_m.position.x, hombre_m.position.z), Vector2.ZERO)
			var to_m: Vector3 = Vector3(cita_m.x, actor.position.y, cita_m.y) - actor.position
			to_m.y = 0.0
			_mark_home[_rival_actors.find(actor)] = Vector2(actor.position.x, actor.position.z)
			var step_m: float = minf(speed * delta, to_m.length())
			if step_m <= 0.0001:
				if not gesto:
					_face_ball(actor)
				continue
			actor.position += to_m.normalized() * step_m
			if not gesto:
				_play_run(actor, to_m)
			continue
		if support.has(actor):



















			if _bsube_vuelo and _is_mine(actor):
				var suelo_s: float = _onside_floor()
				if suelo_s > actor.position.z:
					var spd_on: float = _bsube_paso(actor, Vector2(actor.position.x, suelo_s),
						delta, speed, true)
					actor.position.z += minf(spd_on * delta, suelo_s - actor.position.z)
					_corro_quieto.erase(actor)
					if not gesto:
						_play_run(actor, Vector3(0.0, 0.0, 1.0))
					continue
			var goal_p: Vector3 = corro_c
			var rest_p: Vector3 = _play_rest()
			if rest_p != Vector3.INF \
					and _flat_dist(actor.position, rest_p) < _flat_dist(actor.position, corro_c):
				goal_p = rest_p
			var to_play: Vector3 = goal_p - actor.position
			to_play.y = 0.0
			var d_play: float = to_play.length()
			var anillo: float = float(corro_r.get(actor, CORRO_R_DENTRO))
			if _corro_quieto.has(actor) and d_play <= anillo + CORRO_HOLGURA_M:
				if not gesto:
					_face_ball(actor)
				continue
			_corro_quieto.erase(actor)








			var spd_s: float = speed
			if _bsube_zaga(actor):
				spd_s = maxf(speed, _bsube_paso(actor, Vector2(goal_p.x, goal_p.z), delta,
					speed, false))
			var step_s: float = minf(spd_s * delta, maxf(d_play - anillo, 0.0))
			if step_s <= 0.0001:
				_corro_quieto[actor] = true
				if not gesto:
					_face_ball(actor)
				continue
			actor.position += to_play.normalized() * step_s
			if not gesto:
				_play_run(actor, to_play)
			continue



		var home2: Vector2 = _block_home(actor)













		var empuja: bool = false
		if _is_mine(actor):
			var suelo_on: float = _onside_floor()




			empuja = suelo_on > actor.position.z
			home2.y = maxf(home2.y, suelo_on)
		var to_home: Vector3 = Vector3(home2.x, actor.position.y, home2.y) - actor.position
		to_home.y = 0.0
		var step: float = minf(_bsube_paso(actor, home2, delta, speed, empuja) * delta,
			to_home.length())
		if step <= 0.0001:
			if not gesto:
				_face_ball(actor)
			continue
		actor.position += to_home.normalized() * step
		if not gesto:
			_play_run(actor, to_home)
	if not dead_ball:
		_relax_chasers(true)






















const FALL_NPC_MS: int = 700













const FALL_UP_MS: int = 320






const CARGA_EMPUJE_T: float = 0.22


















const CARGA_NPC_IMPULSO: float = 7.0










const CARGA_NPC_SEP: float = 1.3












const CARGA_NPC_TOQUE: float = 1.0








const CARGA_FORCEJEO_MEMORIA: float = 0.6







const CARGA_NPC_REHOMBRO: float = 1.5



const CARGA_MIRA_CORTE_MIN: float = 0.6














const CARGA_NPC_HOMBRO_CORTE: float = 3.0


const BLOQUEO_R: float = 8.0



const BLOQUEO_SOLO_S: float = 1.0


const BLOQUEO_PASOS: int = 10















const BLOQUEO_FRENO_GANA: float = 0.85
const BLOQUEO_FRENO_PIERDE: float = 0.1
const SEP_RIVAL_NPC: float = 0.85














func _carga_gesto_arranca(a: AnimatedSprite3D, ahora: float) -> void:
	if a.has_meta("carga_t0") \
			and ahora - float(a.get_meta("carga_t0")) >= CARGA_ANIM_MAX:
		return
	a.set_meta("carga_t", ahora + CARGA_ANIM_HOLD)
	if not a.has_meta("carga_t0"):
		a.set_meta("carga_t0", ahora)






















func _carga_gesto_sostiene(a: AnimatedSprite3D, tocando: bool, pace: float,
		ahora: float, olvida: bool = true) -> bool:
	if not a.has_meta("carga_t0"):
		return false
	if not tocando:
		if olvida:
			a.remove_meta("carga_t0")
		return false
	if ahora - float(a.get_meta("carga_t0")) >= CARGA_ANIM_MAX:
		return false
	if pace < CARGA_ANIM_PACE_MIN:
		return false
	a.set_meta("carga_t", ahora + CARGA_ANIM_HOLD)
	return true













func _carga_npc(actors: Array, pts: Array, frozen: Dictionary) -> Array:
	var pesos: Array = []
	var bandos: Array = []
	var vels: Array = []
	var elegibles: Dictionary = {}
	var presentes: Dictionary = {}
	for i in actors.size():
		var a: AnimatedSprite3D = actors[i]
		pesos.append(_rival_peso(a))
		bandos.append(1 if _rival_set.has(a) else 0)
		vels.append(_chase_vels.get(a, Vector2.ZERO))

























		if not frozen.has(i):
			presentes[i] = true
			if float(a.get_meta("carga_cd", 0.0)) <= float(Time.get_ticks_msec()) / 1000.0:
				elegibles[i] = true
	var ahora: float = float(Time.get_ticks_msec()) / 1000.0






	var forcejeo: Dictionary = {}
	for i in actors.size():
		var a: AnimatedSprite3D = actors[i]
		if is_instance_valid(a) and a.has_meta("carga_t0"):
			forcejeo[i] = ahora - float(a.get_meta("carga_t0"))
	var r: Dictionary = Crowding.choque(pts, vels, pesos, bandos, elegibles,
		CARGA_NPC_TOQUE, presentes, forcejeo)





	for i in (r["impulso"] as Dictionary).keys():
		var a: AnimatedSprite3D = actors[i]
		if not is_instance_valid(a):
			continue
		var fuera: Vector2 = r["impulso"][i]


		var escala: float = 1.0 if (r["pulso"] as Dictionary).has(i) \
				else CARGA_NPC_IMPULSO / Crowding.CARGA_IMPULSO
		a.set_meta("carga_v", fuera * escala)
		a.set_meta("carga_v_t", ahora + CARGA_EMPUJE_T)
		a.set_meta("carga_cd", ahora + Crowding.CARGA_COOLDOWN)


		if not (r["pulso"] as Dictionary).has(i):
			a.set_meta("hombro_no", ahora + CARGA_NPC_REHOMBRO)









		if _chase_vels.has(a) and fuera.length_squared() > 0.0001:
			var n: Vector2 = fuera.normalized()
			var cv: Vector2 = _chase_vels[a]
			var contra: float = - cv.dot(n)
			if contra > 0.0:
				_chase_vels[a] = cv + n * contra * float(r["cede"].get(i, 1.0))



		var bloq_de: Variant = _bloqueo_vivo.get(a)
		if bloq_de != null and is_instance_valid(bloq_de) and _chase_vels.has(a):
			var jb: int = actors.find(bloq_de)
			if jb >= 0 and (r["impulso"] as Dictionary).has(jb) \
					and (pts[jb] as Vector2).distance_to(pts[i] as Vector2) < CARGA_NPC_TOQUE * 1.25:
				var dado: float = _bloqueo_dado_forzado if _bloqueo_dado_forzado >= 0.0 else randf()
				var gana: bool = dado < Crowding.bloqueo_gana_p(float(pesos[jb]), float(pesos[i]))

				a.set_meta("bloqueo_gana", gana)
				_chase_vels[a] =(_chase_vels[a] as Vector2) \
						*(1.0 -(BLOQUEO_FRENO_GANA if gana else BLOQUEO_FRENO_PIERDE))
	for i in (r["carga"] as Dictionary).keys():
		var a: AnimatedSprite3D = actors[i]
		if is_instance_valid(a):
			_carga_gesto_arranca(a, ahora)












	for i in actors.size():
		var a: AnimatedSprite3D = actors[i]
		if not is_instance_valid(a):
			continue
		_carga_gesto_sostiene(a,(r["contacto"] as Dictionary).has(i),
			(vels[i] as Vector2).length(), ahora,
			float(a.get_meta("carga_cd", 0.0)) + CARGA_FORCEJEO_MEMORIA <= ahora)
	for i in (r["caen"] as Dictionary).keys():
		var a: AnimatedSprite3D = actors[i]
		if not is_instance_valid(a):
			continue






		if int(a.get_meta("caido_t", 0)) > Time.get_ticks_msec():
			continue
		var dn: String = String(a.get_meta("dir_last", "south"))




		if not _gesto_listo(a, "fall_" + dn):
			continue



		a.remove_meta("carga_t0")
		a.play("fall_" + dn)





		a.set_meta("carga_v",(r["caen"][i] as Vector2) * CARGA_DERRIBO_V)
		a.set_meta("carga_v_t", ahora + CARGA_EMPUJE_T)



		var hasta: int = Time.get_ticks_msec() + FALL_NPC_MS + FALL_UP_MS
		_anim_lock[a] = hasta
		a.set_meta("caido_t", hasta)


	return pts









func _carga_empuje_step(actors: Array, pts: Array) -> Array:
	var ahora: float = float(Time.get_ticks_msec()) / 1000.0
	var out: Array = pts.duplicate()
	for i in actors.size():
		var a: AnimatedSprite3D = actors[i]
		if not is_instance_valid(a) or not a.has_meta("carga_v_t"):
			continue
		var fin: float = float(a.get_meta("carga_v_t"))
		if fin <= ahora:
			a.remove_meta("carga_v_t")
			a.remove_meta("carga_v")
			continue
		var k: float = clampf((fin - ahora) / maxf(CARGA_EMPUJE_T, 0.0001), 0.0, 1.0)
		out[i] =(out[i] as Vector2) \
				+(a.get_meta("carga_v") as Vector2) * k * get_process_delta_time()
	return out

















func _relax_chasers(fijos: bool = false, carga: bool = true) -> void:
	var actors: Array[AnimatedSprite3D] = []
	for a in _todos_actores():
		if is_instance_valid(a):
			actors.append(a)
	var extra: Array[AnimatedSprite3D] = []
	if fijos:
		var sueltos: Array = []
		if _cedida_en_curso:
			sueltos = _cedida_mates + _cedida_rivals
		for e in [_self_actor, _keeper] + sueltos:
			if e != null and is_instance_valid(e) and e.visible \
					and not actors.has(e) and not extra.has(e):
				extra.append(e)
	if actors.size() + extra.size() < 2:
		return



	var last_i: int = -1
	var last_z: float = INF
	var pts: Array = []
	var frozen: Dictionary = {}
	for i in actors.size():
		var a: AnimatedSprite3D = actors[i]
		pts.append(Vector2(a.position.x, a.position.z))


		if a.has_meta("hold_wall") \
				or _anim_lock.get(a, 0) > Time.get_ticks_msec():
			frozen[i] = true
		if _rival_set.has(a) and not a.has_meta("hold_wall") and a.position.z < last_z:
			last_z = a.position.z
			last_i = i
	if last_i >= 0:
		frozen[last_i] = true





	var orig: Array = pts.duplicate()











	if carga:
		pts = _carga_npc(actors, pts, frozen)
		pts = _carga_empuje_step(actors, pts)


	var bandos: Array = []
	for a in actors:
		bandos.append(1 if _rival_set.has(a) else 0)


	var firmes: Dictionary = {}
	for i in actors.size():
		if actors[i].has_meta("hold_wall"):
			firmes[i] = true
	var cuerpos: Array = actors.duplicate()
	for e in extra:
		var k: int = pts.size()
		pts.append(Vector2(e.position.x, e.position.z))
		orig.append(pts[k])
		bandos.append(1 if _rival_set.has(e) or _cedida_rivals.has(e) else 0)
		cuerpos.append(e)
		if e == _self_actor or e == _keeper:
			frozen[k] = true
			firmes[k] = true



	var out: PackedVector2Array = Crowding.relax_packed(PackedVector2Array(pts),
		Crowding.SEP, Crowding.EASE, Crowding.marcas(frozen, pts.size()),
		PackedByteArray(bandos), SEP_RIVAL_NPC, Crowding.marcas(firmes, pts.size()))
	for i in cuerpos.size():
		if out[i] == orig[i]:
			continue
		var a: AnimatedSprite3D = cuerpos[i]
		var p: Vector2 = _inside_field(out[i])











		var shove: Vector3 = Vector3(p.x - a.position.x, 0.0, p.y - a.position.z)
		if a.has_meta("pace_p"):
			a.set_meta("pace_p",(a.get_meta("pace_p") as Vector3) + shove)
		if a.has_meta("loco_p"):
			a.set_meta("loco_p",(a.get_meta("loco_p") as Vector3) + shove)
		a.position = Vector3(p.x, a.position.y, p.y)
	if carga:
		_carga_step(actors)




























const CARGA_DIST: float = 0.8
const CARGA_CLOSING: float = 3.2
const CARGA_CD_MS: int = 2500
const CARGA_HOLD_MS: int = 700
const CARGA_KNOCK_M: float = 0.45




const CARGA_DERRIBO_V: float = 2.0 * CARGA_KNOCK_M / CARGA_EMPUJE_T


func _carga_step(actors: Array) -> void:
	var now: int = Time.get_ticks_msec()
	var movers: Array = []
	for a in actors:





		if _chase_vels.has(a) and a != _self_actor \
				and float(a.get_meta("carga_cd", 0.0)) <= float(now) / 1000.0 \
				and not _order_owned(a) and not a.has_meta("hold_wall") \
				and _anim_lock.get(a, 0) <= now:
			movers.append(a)
	for k in movers.size():
		for m in range(k + 1, movers.size()):
			var a: AnimatedSprite3D = movers[k]
			var b: AnimatedSprite3D = movers[m]
			var d: Vector2 = Vector2(b.position.x - a.position.x,
				b.position.z - a.position.z)
			var dist: float = d.length()
			if dist > CARGA_DIST or dist < 0.001:
				continue
			var va: Vector2 = _chase_vels.get(a, Vector2.ZERO)
			var vb: Vector2 = _chase_vels.get(b, Vector2.ZERO)
			var n: Vector2 = d / dist
			if (va - vb).dot(n) < CARGA_CLOSING:
				continue
			var pa: float = _rival_peso(a)
			var pb: float = _rival_peso(b)
			var cae_b: bool = pa >= pb
			var loser: AnimatedSprite3D = b if cae_b else a
			var dir_push: Vector2 = n if cae_b else - n



















			var ahora_s: float = float(now) / 1000.0
			var pesa: float = absf(pa - pb)
			var forcejeado: float = ahora_s - float(loser.get_meta("carga_t0", ahora_s))
			if pesa < Crowding.CARGA_DPESO_CAE \
					or forcejeado < Crowding.CARGA_FORCEJEO_CAE:





				_carga_gesto_arranca(a, ahora_s)
				_carga_gesto_arranca(b, ahora_s)
				_fx.dust_burst(Vector3(
					(a.position.x + b.position.x) * 0.5, 0.05,
					(a.position.z + b.position.z) * 0.5))
				return
			if _play_dir_gesture(loser, "fall", dir_push, CARGA_HOLD_MS):




				loser.set_meta("caido_t", now + CARGA_HOLD_MS + FALL_UP_MS)
				_anim_lock[loser] = now + CARGA_HOLD_MS + FALL_UP_MS

				_chase_vels.erase(loser)
				var np: Vector2 = _inside_field(Vector2(loser.position.x,
					loser.position.z) + dir_push * CARGA_KNOCK_M)




				var kb: Vector3 = Vector3(np.x - loser.position.x, 0.0,
					np.y - loser.position.z)
				if loser.has_meta("pace_p"):
					loser.set_meta("pace_p",(loser.get_meta("pace_p") as Vector3) + kb)
				if loser.has_meta("loco_p"):
					loser.set_meta("loco_p",(loser.get_meta("loco_p") as Vector3) + kb)
				loser.position = Vector3(np.x, loser.position.y, np.y)
				_fx.dust_burst(Vector3(
					(a.position.x + b.position.x) * 0.5, 0.05,
					(a.position.z + b.position.z) * 0.5))




			a.set_meta("carga_cd", float(now + CARGA_CD_MS) / 1000.0)
			b.set_meta("carga_cd", float(now + CARGA_CD_MS) / 1000.0)
			return





func _inside_field(p: Vector2) -> Vector2:
	return Vector2(
		clampf(p.x, - Stadium.FIELD_HALF_W - 0.5, Stadium.FIELD_HALF_W + 0.5),
		clampf(p.y, 0.3, Stadium.FIELD_DEPTH))




const BARRERA_SALTO_M: float = 0.35

const BARRERA_G: float = 9.8




const BARRERA_REACCION_S: Vector2 = Vector2(0.02, 0.1)


const BARRERA_AGACHE_S: float = 0.14
const BARRERA_ATERRIZA_S: float = 0.1

const BARRERA_OJOS_S: float = 1.4



const BARRERA_CUERPO_X: float = 0.32
const BARRERA_CUERPO_H: float = 1.78




const BARRERA_ANIMS: Array[String] = ["barrera", "barrera_agacha", "barrera_salto"]








func _arma_barrera(actor: AnimatedSprite3D) -> void:
	for anim in BARRERA_ANIMS:
		_ondemand_deadline_us = maxi(_ondemand_deadline_us, Time.get_ticks_usec() + 20000)
		_ensure_anim_now(actor, anim)









func _salta_barrera(retraso: float = 0.0) -> void:
	var t_sube: float = sqrt(2.0 * BARRERA_SALTO_M / BARRERA_G)
	for actor in _rival_actors:
		if not is_instance_valid(actor) or not actor.has_meta("hold_wall") \
				or not actor.sprite_frames.has_animation(&"barrera_salto") \
				or not actor.sprite_frames.has_animation(&"barrera_agacha"):
			continue
		var despega: float = retraso + float(actor.get_meta("barrera_reac",
			BARRERA_REACCION_S.x))

		var agache: float = minf(BARRERA_AGACHE_S, despega)
		var sf: SpriteFrames = actor.sprite_frames
		var n_vuelo: int = sf.get_frame_count(&"barrera_salto")
		var n_agacha: int = sf.get_frame_count(&"barrera_agacha")
		_anim_lock[actor] = Time.get_ticks_msec() + int((despega + 2.0 * t_sube
			+ BARRERA_ATERRIZA_S) * 1000.0) + 60
		var y0: float = actor.offset.y
		var alto_px: float = BARRERA_SALTO_M / maxf(actor.pixel_size, 0.0001)

		var tw: Tween = create_tween().bind_node(actor)
		tw.tween_interval(despega - agache)
		tw.tween_callback(func() -> void:
			if is_instance_valid(actor):
				sf.set_animation_speed(&"barrera_agacha", float(n_agacha) / maxf(agache, 0.02))
				actor.play(&"barrera_agacha"))
		tw.tween_interval(agache)
		tw.tween_callback(func() -> void:
			if is_instance_valid(actor):
				sf.set_animation_speed(&"barrera_salto", float(n_vuelo) / t_sube)
				actor.play(&"barrera_salto"))
		tw.tween_property(actor, "offset:y", y0 + alto_px, t_sube) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tw.tween_callback(func() -> void:
			if is_instance_valid(actor):
				actor.play_backwards(&"barrera_salto"))
		tw.tween_property(actor, "offset:y", y0, t_sube) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
		tw.tween_callback(func() -> void:
			if is_instance_valid(actor):
				sf.set_animation_speed(&"barrera_agacha",
					float(n_agacha) / BARRERA_ATERRIZA_S)
				actor.play_backwards(&"barrera_agacha"))
		tw.tween_interval(BARRERA_ATERRIZA_S)





		tw.tween_callback(func() -> void:
			if _wall_holding:
				_release_wall()
			_face_ball(actor))





func _barrera_pies(actor: Node, t: float) -> float:
	if not is_instance_valid(actor) or not actor.has_meta("hold_wall"):
		return 0.0
	var te: float = t - float(actor.get_meta("barrera_reac", BARRERA_REACCION_S.x))
	var v0: float = sqrt(2.0 * BARRERA_G * BARRERA_SALTO_M)
	if te <= 0.0 or te >= 2.0 * v0 / BARRERA_G:
		return 0.0
	return v0 * te - 0.5 * BARRERA_G * te * te



func _release_wall() -> void:
	_wall_holding = false
	for actor in _rival_actors:
		if is_instance_valid(actor) and actor.has_meta("hold_wall"):
			actor.remove_meta("hold_wall")







func _barrera_rompe() -> bool:
	for t in _desv_toques:
		if bool(t.get("barrera", false)):
			return _traj_i >= int(t["i"]) + DESV_MUDO_PASOS
	return false










const DIR_DEPTH_BIAS: float = 1.2





















const DIR_DEGENERADO: float = 1e-12

















const DIR_MOVE_DEPTH_BIAS: float = 0.8









const DIR_AXIS_HOLD: float = 1.2






func _dir_name_move(actor: AnimatedSprite3D, dir: Vector3) -> String:
	var flat: Vector2 = Vector2(dir.x, dir.z)
	if flat.length_squared() < DIR_DEGENERADO:
		if actor == null:
			return "south"
		return String(actor.get_meta("dir_show", actor.get_meta("dir_last", "south")))
	var lateral: float = 0.0
	var depth: float = 0.0
	_cam_base_refresh()
	if not _cam_present:

		lateral = dir.x
		depth = - dir.z
	elif not _cam_base_ok:
		return _dir_name(dir)
	else:
		lateral = flat.dot(_cam_right_flat)
		depth = flat.dot(_cam_into_flat)
	var pesa_depth: float = absf(depth) * DIR_MOVE_DEPTH_BIAS
	var pesa_lat: float = absf(lateral)
	var quiere_depth: bool = pesa_depth >= pesa_lat
	if actor != null:
		var prev: String = String(actor.get_meta("dir_show", ""))
		if prev != "":
			var prev_depth: bool = prev == "north" or prev == "south"
			if prev_depth != quiere_depth:
				var gana: float = pesa_depth if quiere_depth else pesa_lat
				var pierde: float = pesa_lat if quiere_depth else pesa_depth
				if gana < pierde * DIR_AXIS_HOLD:
					quiere_depth = prev_depth
	var dn: String
	if quiere_depth:
		dn = "north" if depth > 0.0 else "south"
	else:
		dn = "east" if lateral > 0.0 else "west"
	if actor != null:
		actor.set_meta("dir_show", dn)
	return dn









var _cam_base_frame: int = -1
var _cam_present: bool = false
var _cam_base_ok: bool = false
var _cam_right_flat: Vector2
var _cam_into_flat: Vector2



















var _celeb_base_pos: Vector3 = Vector3.ZERO
var _celeb_base_until_ms: int = 0


const CELEB_DIR_SETTLE_MS: int = 700


func _cam_base_refresh() -> void:
	var f: int = Engine.get_process_frames()
	if f == _cam_base_frame:
		return
	_cam_base_frame = f

	if Time.get_ticks_msec() < _celeb_base_until_ms \
			and _celeb_focus != null and is_instance_valid(_celeb_focus):
		var into_c: Vector2 = Vector2(_celeb_focus.position.x - _celeb_base_pos.x,
			_celeb_focus.position.z - _celeb_base_pos.z)
		if into_c.length_squared() > 0.0001:
			_cam_into_flat = into_c.normalized()


			_cam_right_flat = Vector2(- _cam_into_flat.y, _cam_into_flat.x)
			_cam_present = true
			_cam_base_ok = true
			return
	var cam: Camera3D = SceneFade.camara_de(self)
	_cam_present = cam != null
	_cam_base_ok = false
	if cam == null:
		return
	var basis: Basis = cam.global_transform.basis
	var right: Vector2 = Vector2(basis.x.x, basis.x.z)
	var into: Vector2 = Vector2(- basis.z.x, - basis.z.z)
	if right.length_squared() < 0.0001 or into.length_squared() < 0.0001:
		return
	_cam_right_flat = right.normalized()
	_cam_into_flat = into.normalized()
	_cam_base_ok = true


func _dir_name(dir: Vector3) -> String:
	var flat: Vector2 = Vector2(dir.x, dir.z)
	if flat.length_squared() < DIR_DEGENERADO:
		return "south"
	_cam_base_refresh()
	if not _cam_present:

		if absf(dir.x) > absf(dir.z):
			return "east" if dir.x > 0.0 else "west"
		return "north" if dir.z < 0.0 else "south"
	if not _cam_base_ok:
		return "south"
	var lateral: float = flat.dot(_cam_right_flat)
	var depth: float = flat.dot(_cam_into_flat)
	if absf(depth) * DIR_DEPTH_BIAS >= absf(lateral):

		return "north" if depth > 0.0 else "south"
	return "east" if lateral > 0.0 else "west"






















func _play_run(actor: AnimatedSprite3D, dir: Vector3, fam_force: String = "") -> void:






	var fam: String = _pace_family(actor)
	if fam_force != "":
		fam = fam_force

















	if fam_force.is_empty() and actor.has_meta("carga_t") \
			and float(actor.get_meta("carga_t")) > float(Time.get_ticks_msec()) / 1000.0:
		fam = "carga_"


	if fam_force.is_empty() and actor.has_meta("avion_t") \
			and float(actor.get_meta("avion_t")) > float(Time.get_ticks_msec()) / 1000.0:
		fam = "avion_"

	var dn: String = String(_dir_force.get(actor, ""))
	if dn.is_empty():





















		if actor.has_meta("de_frente_hasta") \
				and int(actor.get_meta("de_frente_hasta")) > Time.get_ticks_msec():
















			var rumbo: Vector3 = dir
			var vt: float = float(actor.get_meta("loco_vt", -1.0))
			if vt >= 0.0 and float(Time.get_ticks_msec()) / 1000.0 - vt <= LINEA_PASO_FRESCO_S:
				var v: Vector2 = actor.get_meta("loco_v", Vector2.ZERO)
				if v.length() >= LOCO_MIN_SPD:
					rumbo = Vector3(v.x, 0.0, v.y)
			if Vector2(rumbo.x, rumbo.z).length_squared() < DIR_DEGENERADO:
				dn = String(actor.get_meta("dir_last", "south"))
			else:
				dn = _dir_name_move(actor, rumbo)
			if dn == "north":
				dn = "south"
			actor.set_meta("dir_last", dn)
	if dn.is_empty():







		if Vector2(dir.x, dir.z).length_squared() < DIR_DEGENERADO:
			dn = String(actor.get_meta("dir_last", "south"))
		else:
			dn = _dir_name_move(actor, dir)
			actor.set_meta("dir_last", dn)
	var anim: String = fam + dn
	if not _anim_usable(actor, anim):




		if fam == "walk_" or fam == "avion_":
			anim = "run_" + dn
			if not _anim_usable(actor, anim):
				return


			fam = "run_"
		else:
			return
	if actor.animation != anim:
















		var f_prev: int = actor.frame
		var p_prev: float = actor.frame_progress
		var sigue_el_ciclo: bool = actor.is_playing() \
				and actor.sprite_frames.has_animation(actor.animation) \
				and actor.sprite_frames.get_frame_count(actor.animation) \
				== actor.sprite_frames.get_frame_count(anim)
		actor.play(anim)
		if sigue_el_ciclo:
			actor.set_frame_and_progress(f_prev, p_prev)

	actor.speed_scale = _stride_scale(actor, fam)





















const LOCO_MIN_SPD: float = 0.35
const LOCO_TELEPORT_M: float = 3.0

func _animate_movers() -> Dictionary:
	var out: Dictionary = {}

























	var solo_medir: bool = _open_shot_aim or _flip_freeze or _serve_quieto
	var now: float = float(Time.get_ticks_msec()) / 1000.0




	var k_mundo: float = _pace_world_k()
	var everyone: Array = _teammate_actors + _rival_actors





	everyone.append_array(_refs_vivos())










	if is_instance_valid(_self_actor):
		everyone.push_front(_self_actor)














	if is_instance_valid(_keeper):
		everyone.push_front(_keeper)














	var corner_guard: bool = _corner_move and state == State.AIMING
	var corner_markers: Array = _corner_marker.values() if corner_guard else []






	var suelo_vivo: bool = not solo_medir and _fx != null and _stadium != null \
			and (bool(_stadium.weather.get("rain", false))
			or bool(_stadium.weather.get("snow", false)))
	var pisadas: int = 0
	for actor in everyone:


		if not is_instance_valid(actor) \
				or not (actor.visible or actor.has_meta(ReplayRec.META_OCULTO_GOLPEO)):
			continue
		var es_portero: bool =(actor == _keeper)
		var here: Vector3 = actor.position
		var pt: float = float(actor.get_meta("loco_t", -1.0))
		var pp: Vector3 = actor.get_meta("loco_p", here)
		var dt: float = now - pt

















		if pt >= 0.0 and dt < PACE_DT_MIN:
			continue


		actor.set_meta("loco_t", now)
		actor.set_meta("loco_p", here)
		if pt < 0.0 or dt > PACE_DT_MAX:
			continue
		var moved: Vector3 = Vector3(here.x - pp.x, 0.0, here.z - pp.z)
		if moved.length() > LOCO_TELEPORT_M:
			continue





		actor.set_meta("loco_v", Vector2(moved.x, moved.z) / dt)
		actor.set_meta("loco_vt", now)
		if moved.length() < LOCO_MIN_SPD * k_mundo * dt:
			continue




		if not es_portero:
			out[actor] = true




		if suelo_vivo and pisadas < STEP_SPLASH_PER_FRAME \
				and _step_ground(actor, moved, dt):
			pisadas += 1





			_resbalon_step(actor, moved, dt)



		if es_portero:
			continue
		if _anim_lock.get(actor, 0) > Time.get_ticks_msec():
			continue
		if _run_target.has(actor):
			continue
		if corner_guard and (_corner_home.has(actor) or corner_markers.has(actor)):
			continue
		if _entrada_on and (actor == _entrada_rival or actor == _self_actor
				or actor == _ref_center or _entrada_mios.has(actor)
				or _entrada_suyos.has(actor)):





			continue
		if solo_medir:
			continue
		_play_run(actor, moved)
	return out

































const WALK_ENTER: float = 2.0
const WALK_EXIT: float = 2.3




const FAM_HOLD_MS: int = 450





const PACE_ACCEL_CAP: float = 12.0



const WALK_SUSTAIN_MS: int = 350








const PACE_SMOOTH: float = 0.25




const PACE_DT_MIN: float = 0.005






























const PACE_STILL_M: float = 0.001















const PACE_MAX_MPS: float = ENTRANCE_SPEED




const PACE_STILL_STEPS: float = 3.0

func _pace_still_dt() -> float:
	return PACE_STILL_STEPS / float(maxi(Engine.physics_ticks_per_second, 1))
const PACE_DT_MAX: float = 0.25









const RUN_STRIDE_MPS: float = 2.7
const WALK_STRIDE_MPS: float = 1.36


const STRIDE_SCALE_MIN: float = 0.6

























func _stride_scale(actor: AnimatedSprite3D, fam: String) -> float:
	if not actor.has_meta("pace_v"):
		return actor.speed_scale
	var ref: float = WALK_STRIDE_MPS if fam == "walk_" else RUN_STRIDE_MPS






	return clampf(float(actor.get_meta("pace_v")) / ref,
		STRIDE_SCALE_MIN * _pace_world_k(), ENTRANCE_ANIM_MAX)






























func _play_keeper_smother() -> void:
	if not is_instance_valid(_keeper):
		return
	if not _keeper.sprite_frames.has_animation("dive"):
		return
	if _keeper_tween and _keeper_tween.is_valid():
		_keeper_tween.kill()
	_keeper.flip_h = _ball_field.x < _keeper.position.x
	_keeper.speed_scale = 1.0
