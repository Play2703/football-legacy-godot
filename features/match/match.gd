func _play_firmas_grada(is_nat: bool, result: int, rival_id: String, tunel: bool) -> void:
	if GameState.readonly_save or not _practice_kind.is_empty() or is_nat \
			or _injured_out or _hooked or tunel:
		return





	for act in Career.pending_ceremonies:
		if String((act as Dictionary).get("kind", "")) \
				in [Ceremonies.TROPHY, Ceremonies.PROMOTION]:
			return
	if not Career.firmas_grada_toca(result, _my_minutes, _home_match):
		return
	var scn: PackedScene = load(FIRMAS_GRADA_SCENE) as PackedScene
	if scn == null:
		return
	var act: Ceremony = scn.instantiate() as Ceremony
	if act == null:
		return



	var hincha: Dictionary = Career.hincha_payload() if Career.hincha_en_muro() else {}
	var nino: bool = hincha.is_empty() and Career.nino_camiseta_toca(match_goals)
	act.embedded = true
	act.data_override = {
		"kind": Ceremonies.FIRMAS_GRADA,
		"div": GameState.player_div(),
		"club": GameState.player_team_id,
		"number": GameState.shirt_number_now(),
		"weather": _stadium.weather_id() if _stadium != null else "day",
		"gf": team_goals,
		"ga": rival_goals,
		"rival": rival_id,
		"n": Career.firmas_grada_sella(),


		"nino": nino,
		"hincha": hincha,
	}
	if nino:
		Career.nino_camiseta_sella()
	if _audio != null:
		_audio.hush()
	var layer: CanvasLayer = CanvasLayer.new()
	layer.layer = HOOK_ACT_LAYER
	layer.add_child(act)
	add_child(layer)
	await _esperar_acto(act, layer, FIRMAS_TOPE_S)
	if not is_inside_tree():
		return
	if _audio != null:
		_audio.unhush()






