func _cfg_de_cancha(cfg: Dictionary, is_rival: bool) -> Dictionary:
	if _chamarra_intro and not cfg.has("chamarra"):
		cfg = cfg.duplicate()
		cfg["chamarra"] = true
	var out: Dictionary = _con_escudo(cfg, is_rival)
	if _lleva_lamina(out):
		out = out.duplicate()
		out["num_lamina"] = true






	if not SleevePatch.tipo_de(out).is_empty():
		out = out.duplicate()
		out["parche_lamina"] = true



	return _con_barro(out)




func _con_barro(out: Dictionary) -> Dictionary:
	var extra: int = int(_barro_de.get(_barro_clave(out), 0))
	if extra > 0 and (out.has("barro") or not out.has("mojado")):
		out = out.duplicate()

		if out.has("barro"):
			out["barro"] = mini(int(out["barro"]) + extra, BARRO_MAX)
		else:
			out["pasto"] = mini(extra, PASTO_MAX)


		if not out.has("barro_sem"):
			out["barro_sem"] = posmod(hash(_barro_clave(out)), KitRecolor.BARRO_PLAYERA.size())
	return out






















const BARRO_MAX: int = 3
const PASTO_MAX: int = 2
var _barro_de: Dictionary = {}

func _barro_clave(cfg: Dictionary) -> String:
	var ap: String = String(cfg.get("apellido", ""))
	if ap.is_empty():
		return ""
	var kit: Variant = cfg.get("kit", null)
	return "%s|%d|%s" % [ap, int(cfg.get("number", 0)),
		kit.to_html(false) if kit is Color else ""]


func _ensucia(actor: AnimatedSprite3D) -> void:
	if actor == null or not is_instance_valid(actor):
		return

	var cfg: Dictionary = actor.get_meta("anim_cfg", actor.get_meta("cara_cfg", {}))
	if cfg.is_empty():
		return

	if not cfg.has("barro") and cfg.has("mojado"):
		return
	var clave: String = _barro_clave(cfg)
	if clave.is_empty():
		return


	var tope: int = BARRO_MAX - int(KitRecolor.clima_tela.get("barro", 0)) \
			if cfg.has("barro") else PASTO_MAX
	_barro_de[clave] = mini(int(_barro_de.get(clave, 0)) + 1, tope)














const TELA_LLAVES: Array[String] = ["mojado", "barro", "pasto", "barro_sem"]

func _tela_final() -> Dictionary:
	var dia: Dictionary = KitRecolor.clima_tela.duplicate()
	var mio: Dictionary = _self_cfg()
	var kit: Variant = mio.get("kit", null)
	var color: String = kit.to_html(false) if kit is Color else ""
	var compas: Dictionary = {}
	for clave in _barro_de.keys():
		var partes: PackedStringArray = String(clave).split("|")

		if partes.size() != 3 or partes[2] != color or clave == _barro_clave(mio):
			continue
		var c: Dictionary = dia.duplicate()
		c["apellido"] = partes[0]
		c["number"] = int(partes[1])
		c["kit"] = kit
		var t: Dictionary = _tela_de(_con_barro(c))
		if not t.is_empty():
			compas["%s|%s" % [partes[0], partes[1]]] = t
	var out: Dictionary = {}
	var yo: Dictionary = _tela_de(_con_barro(mio))
	if not dia.is_empty():
		out["dia"] = dia
	if not yo.is_empty():
		out["yo"] = yo
	if not compas.is_empty():
		out["compas"] = compas
	return out



func _tela_de(cfg: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for k in TELA_LLAVES:
		if cfg.has(k):
			out[k] = cfg[k]
	return out


func _spawn_actor(tex: Texture2D, x: float, z: float,
		metrics: Vector2 = PLAYER_METRICS, height_m: float = PLAYER_HEIGHT_M,
		look: Variant = null, is_rival: bool = false) -> AnimatedSprite3D:
	var s: AnimatedSprite3D = AnimatedSprite3D.new()





	var base: Dictionary = _rival_kit_cfg() if is_rival else GameState.player_look()
	var cfg: Dictionary
	if look is Dictionary:
		cfg = look
	elif look is bool and look:
		cfg = _self_cfg()
	else:
		cfg = KitRecolor.team_only(base)










	cfg = _cfg_de_cancha(cfg, is_rival)
	_dress_actor(s, tex, cfg)
	s.play("idle")
	s.pixel_size = height_m / metrics.x


	s.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	s.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	s.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	s.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	s.position = Vector3(x, metrics.y * s.pixel_size, z)
	_actors.add_child(s)
	_pecho_vestir(s, cfg, is_rival)
	_espalda_vestir(s, cfg)
	_short_vestir(s, cfg)
	return s















func _cinta_vestir(actor: AnimatedSprite3D, cfg: Dictionary) -> void:
	if _cinta.has(actor):
		var vieja: Variant =(_cinta[actor] as Dictionary).get("nodo")
		if is_instance_valid(vieja):
			(vieja as Node).queue_free()
		_cinta.erase(actor)
	if actor.has_meta("lam_cap"):
		actor.remove_meta("lam_cap")
	if not bool(cfg.get("banda_capitan", false)):
		return
	var banda: Color = ArmbandArt.band_color(cfg)
	var nodo: Sprite3D = CintaCapitan.nodo()
	_actors.add_child(nodo)
	_cinta[actor] = {"nodo": nodo, "color": banda}
	actor.set_meta("lam_cap", banda)




func _cinta_follow() -> void:
	if _cinta.is_empty():
		return
	var cam: Camera3D = SceneFade.camara_de(self)
	for a in sin_muertos(_cinta):

		if not is_instance_valid(a):
			continue
		var fila: Dictionary = _cinta[a]
		var nodo: Sprite3D = SceneFade.vivo(fila.get("nodo")) as Sprite3D
		if is_instance_valid(nodo):
			CintaCapitan.seguir(nodo, a as AnimatedSprite3D, fila["color"], cam)


func _pecho_vestir(actor: AnimatedSprite3D, cfg: Dictionary, is_rival: bool) -> void:
