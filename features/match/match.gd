func _run_sim_segment(to_min: int, allow_goals: bool, added: int = -1,
		montar: Dictionary = {}) -> void:
	state = State.SIM

	_hud.clear_message()
	var rival: Dictionary = GameState.current_rival()


	var tv_div: int = _stadium.div if _stadium != null and _stadium.div > 0 else GameState.player_div()



	_sim_screen.begin(GameState.you_of(GameState.current_fixture()), rival, tv_div,
		_sim_kept)
	_sim_kept = false













	if not montar.is_empty():


		_pe_espera_montaje = true
		if _pe_lote != null:
			_pe_lote.cancela = true
		await _sim_screen.telon_puesto()
		if state != State.SIM:
			_pe_espera_montaje = false
			return


		var b_t: int = Time.get_ticks_usec()
		var b_n: int = _frames_cache.size()
		var b_gpu: int = KitRecolor.lecturas_gpu_principal
		_setup_chance(montar)
		_pe_monta_fin()
		_huella_montada = _huella_campo()
		SceneFade.banco_ev({"ev": "monta", "ms":(Time.get_ticks_usec() - b_t) / 1000,
			"looks_nuevos": _frames_cache.size() - b_n,
			"gpu": KitRecolor.lecturas_gpu_principal - b_gpu, "cuadro": Engine.get_process_frames(),
			"gpu_de": KitRecolor.lecturas_gpu_principal_detalle})
	_sim_screen.set_score(team_goals, rival_goals)
	_sim_screen.set_minute(match_minute)






	var sim_diff: float = _difficulty * _momentum.rival_goal_mult() \
			* MatchPlan.style_rival_mult(_play_style)







	var sim_team: float = MatchPlan.style_team_mult(_play_style) \
			* _momentum.team_goal_mult()





	var lmin: float = 9.0 if tv_div >= 3 else MatchSim.SIM_LINE_MIN
	var lmax: int = 3 if tv_div >= 3 else 6
	var seg_ctx: Dictionary = _sim_ctx(rival, to_min)
	if tv_div >= 3:
		seg_ctx["terse"] = true


	if not _rasgos.is_empty():
		seg_ctx["rasgos"] = _rasgos


	var lines: Array[Dictionary] = MatchSim.build_segment(match_minute, to_min,
		_my_side_id(), String(rival.get("id", "")), allow_goals, sim_diff,
		sim_team, seg_ctx, lmin, lmax, added)
	_inject_sub_note(lines, match_minute, to_min)


	_inject_duel_note(lines, match_minute, to_min)


	_inject_goal_note(lines, match_minute, to_min)



	_inject_cesion_note(lines, match_minute, to_min)

	_inject_card_notes(lines, match_minute, to_min)

	_inject_dorsal_note(lines, match_minute, to_min)





	if not _pique_coach.is_empty():
		_coach_pendiente = _pique_coach
		_pique_coach = ""
	if not _coach_pendiente.is_empty():
		var ev_jugada: String = _coach_pendiente
		_coach_pendiente = ""
		if not _hooked:
			await _play_coach_cut(ev_jugada)
			if state != State.SIM:
				_sim_screen.hide_now()
				return
	for line in lines:
		if state != State.SIM:
			_sim_screen.hide_now()
			return
		var kind: String = String(line["kind"])





		match_minute = maxi(match_minute,
			int(line["minute"]) + int(line.get("extra", 0)))



		_aplica_cambios(match_minute)
		_hud.set_minute(match_minute)
		_refresh_ball_dirt()
		_sync_ends()
		_stadium.set_match_minute(match_minute)
		_tramo_final()
		_sim_screen.set_minute(match_minute)
		_update_sim_energy()











		_maybe_rest()
		if _sub_requested and not _hooked and not _sub_done \
				and chance_index > _chance_minutes.size() \
				and match_minute >= mini(_sub_ask_min + HOOK_DELAY_MIN, 89):
			_sub_done = true





			_pull_off_at(match_minute, mini(chance_index, _chance_minutes.size()))
			var exit_lines: Array[Dictionary] = []
			_inject_sub_note(exit_lines, match_minute - 1, match_minute)
			for ex in exit_lines:
				_sim_screen.add_line(int(ex["minute"]), String(ex["text"]),
					String(ex["kind"]), 0, String(ex.get("team", "")),
					String(ex.get("name", "")))








		if _injured_out and not _sub_done and not _hooked \
				and _practice_kind.is_empty():
			_sub_done = true


			await _play_injury_scene()
			if state != State.SIM:
				_sim_screen.hide_now()
				return
			var inj_out: int = mini(match_minute + HOOK_DELAY_MIN, 89)










