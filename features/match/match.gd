func _zancada_tapa() -> bool:
	var z: Dictionary = _zancadas[_zancadas_vistas]
	var i: int = int(z.get("i", -1))
	if bool(z.get("lanzada", false)) \
			or _zancada_en(z, maxf(float(i - _traj_i) * SIM_DT, SIM_DT)) \
			or _traj_i >= i:
		_zancadas_vistas += 1
		return true
	return false
















func _zancada_en(z: Dictionary, queda: float) -> bool:
	var a: AnimatedSprite3D = SceneFade.vivo(z.get("a")) as AnimatedSprite3D
	var i: int = int(z.get("i", -1))
	if a == null or not is_instance_valid(a) or i < 0 or i >= _traj.size():
		return true


	if a == _barr_arrastra and _barr_tw != null and _barr_tw.is_valid():
		return true
	var p: Vector3 = _traj[i]
	var lado: Vector2 = Vector2(p.x - a.position.x, p.z - a.position.z)
	var prisa: float = clampf(ZANCADA_CONTACTO_S / maxf(queda, SIM_DT), 1.0,
		ZANCADA_TAPA_PRISA_MAX)
	var llega: float = ZANCADA_CONTACTO_S / prisa
	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + RECU_BARRIDA_BUDGET_US)



	var hacia: Vector2 = Vector2(lado.x, ZANCADA_TAPA_FRENTE)
	var hold: int = int((llega + ZANCADA_TAPA_QUEDA_S) * 1000.0)
	if not _play_dir_gesture(a, "bloqueo", hacia, hold) \
			and not _play_dir_gesture(a, "kick", hacia, hold):
		return false
	z["lanzada"] = true
	a.speed_scale = ZANCADA_ANIM_SPEED * prisa


	var viejo: Tween = _zanc_tws.get(a) as Tween
	if viejo != null and viejo.is_valid():
		viejo.kill()
	var from: Vector3 = a.position
	var to: Vector3 = from
	var paso: float = clampf(lado.length() - ZANCADA_LLEGA_M, 0.0, ZANCADA_TAPA_PASO_MAX)
	if paso > 0.05:
		var m2: Vector2 = _inside_field(Vector2(from.x, from.z) + lado.normalized() * paso)
		to = Vector3(m2.x, from.y, m2.y)
	a.set_meta("order_run", true)
	_run_target.erase(a)
	var tw: Tween = create_tween()
	_zanc_tws[a] = tw
	tw.tween_method(_slide_step.bind(a, from, to, _rival_actors.find(a),
		_duel_def_actors.find(a)), 0.0, 1.0, llega) \
				.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.tween_interval(ZANCADA_TAPA_QUEDA_S)
	tw.tween_callback(_zancada_suelta.bind(a))
	return true



func _zancada_suelta(a: Object) -> void:
	_zanc_tws.erase(a)
	_order_release(a)









func _zancadas_antes_del_vuelo(espera: float) -> void:
	for z in _zancadas:
		var hasta: float = espera + float(int(z.get("i", 0))) * SIM_DT
		var falta: float = hasta - ZANCADA_CONTACTO_S

		if falta >= espera + SIM_DT:
			continue
		if falta <= 0.0:
			_zancada_previa(_chance_seq, z, hasta)
		else:
			SceneFade.timer(falta, false).timeout.connect(
				_zancada_previa.bind(_chance_seq, z, ZANCADA_CONTACTO_S))


func _zancada_previa(seq: int, z: Dictionary, queda: float) -> void:
	if seq != _chance_seq or not _zancadas.has(z) \
			or (state != State.RUNUP and state != State.FLIGHT):
		return
	if not bool(z.get("lanzada", false)):
		_zancada_en(z, queda)





func _desv_al_paso() -> void:



	while _zancadas_vistas < _zancadas.size() \
			and _traj_i >= int(_zancadas[_zancadas_vistas]["i"]) - _zancada_pasos():
		if not _zancada_tapa():
			break
	while _desv_vistos < _desv_toques.size() \
			and _traj_i >= int(_desv_toques[_desv_vistos]["i"]):
		_desv_contacto()



static func _zancada_pasos() -> int:
	return ceili(ZANCADA_CONTACTO_S / SIM_DT)






