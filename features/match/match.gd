func _recu_puebla_defensas() -> void:
	_recu_def_pos = []
	_recu_def_vel = []
	_recu_def_meta = []
	_recu_def_act = []
	_recu_def_spd = []
	_recu_def_k = []
	_recu_def_lead = []
	_recu_def_tackle = []
	_recu_def_armed = []
	_recu_def_recov = []
	_recu_def_cd = []
	_recu_def_barr = []
	_recu_def_suelo = []
	_recu_def_bdir = []
	_recu_def_bcd = []
	_recu_def_rol = []
	_recu_def_marca = []
	_recu_reparto_t = 0.0




	var q_club: float = 0.5
	var n: int = mini(_recu_n_mates, _teammate_actors.size())






	var cand: Array = []
	for i in range(1, n):
