				var fits2: bool = absf(i2.x) < GOAL_HALF_W - BALL_R * 0.5 \
						and cy2 < CROSSBAR_H + POST_R
				if in2 and carry2 and fits2:



					_outcome = "goal"
					_rebound_i = -1
