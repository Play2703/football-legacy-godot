func _setup_ball_sprite() -> void:



	var style: String = GameState.pick_ball_style()



	if style == BallDeco.BASE_STYLE:
		var comp_frames: SpriteFrames = BallDeco.frames_for(GameState.current_fixture())
		if comp_frames != null:
			_ball.sprite_frames = comp_frames
			_ball.play("idle")
			_finish_ball_sprite()
			return
	var base: String = "res://assets/sprites/objects/ball_%s_" % style
	var frames: SpriteFrames = SpriteFrames.new()
	frames.add_animation("idle")
	frames.set_animation_loop("idle", true)
	var idle_path: String = base + "idle.png"
	frames.add_frame("idle", load(idle_path) if ResourceLoader.exists(idle_path) else BALL_TEX)
	frames.add_animation("roll")
	frames.set_animation_loop("roll", true)
	frames.set_animation_speed("roll", 10.0)
	for i in 4:
		var path: String = "%s%d.png" % [base, i]
		if not ResourceLoader.exists(path):
			path = "res://assets/sprites/objects/ball_roll_%d.png" % i
		var tex: Texture2D = load(path)
		if tex:
			frames.add_frame("roll", tex)
	_ball_roll_ejes(frames)
	_ball.sprite_frames = frames
	_ball.play("idle")
	_finish_ball_sprite()




func _finish_ball_sprite() -> void:
	_ball.pixel_size = BALL_VISUAL_D / 32.0



	_ball.offset = Vector2(0.0, - BALL_PAD_PX)
	_ball.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	_ball.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_ball.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	_ball.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON








	_ball_tint_base = GameState.ball_tint_for_div(GameState.home_div())
	_ball.modulate = _ball_tint_base
	_refresh_ball_dirt()
















