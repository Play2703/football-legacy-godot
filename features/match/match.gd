	_gesto_listo(_self_actor, "chilena_" + _dir_name(- al_arco.normalized()))






func _servicio_chilena_pose(s: Dictionary, falta: float) -> void:
	if not is_instance_valid(_self_actor):
		return
	var n: int = int(s["n"])
	var w: float = clampf((float(n) - falta) / float(maxi(int(s["sube_n"]), 1)), 0.0, 1.0)
	var e: float = sin(w * PI * 0.5)
	var xz: Vector3 = Vector3(s["desde"]).lerp(Vector3(s["spot"]), e)
	_self_actor.position = Vector3(xz.x, float(s["y0"]) + float(s["alto"]) * e, xz.z)
	if bool(s.get("suelto", false)):
		return
	var anim: String = String(s["anim"])
	var fps: float = _self_actor.sprite_frames.get_animation_speed(anim) \
			if _self_actor.sprite_frames.has_animation(anim) else 12.0





	var reloj: float = maxf(_servicio_reloj_ruta(), 0.0001)
	var queda: float = maxf(falta, 0.0) * SIM_DT / reloj
	if queda > 1.0 / maxf(fps, 1.0):
		return
	s["suelto"] = true
	_self_actor.speed_scale = 1.0
	if not _self_actor.is_playing():
		_self_actor.play(anim)
	_self_actor.set_frame_and_progress(SERVICIO_CHILENA_FOTO_FRAME,
		clampf(1.0 - queda * fps, 0.0, 0.99))
	_anim_lock[_self_actor] = Time.get_ticks_msec() + int(CHILENA_T * 1000.0) + 600






func _servicio_tags() -> Array:
	var srv: AnimatedSprite3D = _servicio_server()
	var vivos: Array = []
	if _serve_corre and not _serve_vivo and state == State.SETUP and srv != null \
			and is_instance_valid(srv):
		vivos.append(srv)
		var sp := Vector2(srv.global_position.x, srv.global_position.z)
		for r in _rival_actors:
			if is_instance_valid(r) and Vector2(r.global_position.x, r.global_position.z) \
					.distance_to(sp) < SERVICIO_TAG_CERCA:
				vivos.append(r)
	for a in vivos:
		if a.get_node_or_null("NameTag") == null:
			_attach_name_tag(a, TagSide.MATE if a == srv else TagSide.RIVAL,
				String(_finisher_of(a).get("name", "")))
		var tag: Node3D = a.get_node_or_null("NameTag")
		if tag != null:
			tag.scale = Vector3.ONE * HERO_TAG_SCALE
			if not _serve_tags.has(a):
				_serve_tags.append(a)
	for a in _serve_tags.duplicate():
		if vivos.has(a):
			continue
		_serve_tags.erase(a)
		if is_instance_valid(a):
			var tag: Node3D = a.get_node_or_null("NameTag")
			if tag != null:
				tag.scale = Vector3.ONE
	return vivos
























func _tutorial_chip() -> void:
	if not _tutorial_active or _tutorial_j >= _tutorial_goals.size():
		return
	var tseg: Dictionary = Tutorial.seg(_tutorial_i, _tutorial_j)
	var tlabel: String = I18n.t(Practice.label_of(_practice_kind)) \
			if Tutorial.segments(_tutorial_i).size() > 1 \
			else I18n.t(String(Tutorial.drill(_tutorial_i)["title"]))



	var tneed: int = int(tseg["need"])
	var tgoals: int = int(_tutorial_goals[_tutorial_j])





	if String(tseg["kind"]) == Practice.ZONES:








		tgoals = _press_zone_i if _duel_press else 0
		tneed = ZONAS_ACADEMIA
	if tneed <= 0:
		tneed = Tutorial.need_total(_tutorial_i)
		tgoals = 0
		for g in _tutorial_goals:
			tgoals += int(g)





	var suffix: String = "%d/%d" % [tgoals, tneed] if tgoals < tneed \
			else "★%d" % tgoals
	_hud.set_practice("%s %s" % [tlabel, suffix],
		int(_tutorial_tries[_tutorial_j]) + 1)



func _tutorial_reset_drill() -> void:
	_tutorial_j = 0
	_tutorial_clears = 0
	_tutorial_rondas = 0
	_tutorial_goals = []
	_tutorial_tries = []
	for _k in Tutorial.segments(_tutorial_i).size():
		_tutorial_goals.append(0)
		_tutorial_tries.append(0)







func _tutorial_rewind() -> void:
	if _tutorial_i <= 0 or _tutorial_stars.is_empty():
		return
	_tutorial_stars.pop_back()
	_tutorial_i -= 1
	_tutorial_reset_drill()
	_practice_kind = String(Tutorial.seg(_tutorial_i, 0)["kind"])



func _tutorial_record(outcome: String) -> void:
	if _tutorial_j >= _tutorial_tries.size():
		return
	_tutorial_tries[_tutorial_j] = int(_tutorial_tries[_tutorial_j]) + 1








	if outcome == "goal" or (outcome == "press_out_win"
			and String(Tutorial.seg(_tutorial_i, _tutorial_j)["kind"]) == Practice.ZONES):
		_tutorial_goals[_tutorial_j] = int(_tutorial_goals[_tutorial_j]) + 1
