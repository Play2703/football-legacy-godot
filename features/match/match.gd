func _finish_duel_foul(por_carga: bool = false, dura: bool = false,
		culpable: AnimatedSprite3D = null) -> void:
	if not _duel_active:
		return




	var pique: bool = _pique_patada_viva
	_pique_patada_viva = false
	if not pique:
		if _pique_es(culpable):
			dura = true


		_pique_calienta(_pique_nombre(culpable))





	if not _shootout_active:
		_move_log.append(MoveBook.entry(_ball_field.x, _ball_field.y,
			"penal" if _in_penalty_box(_ball_field) and not _duel_press else "falta",
			"", _rival_key(), match_minute))
	_duel_last_outcome = "falta"
	_queue_rule("falta")
	_end_duel_common()














	if not pique:
		_al_contacto(func() -> void:
			_play_fall_gesture()
			_audio.dolor(dura)
			_audio.voz_tras("protesta", 0.5))


		_al_contacto_siempre(_falta_golpe.bind(
			not _duel_press and _in_penalty_box(_ball_field)))






















	if _duel_press:
		_duel_note = {
			"minute": match_minute,
			"win": true,
			"text": I18n.tf("CARGAN A {0} EN LA SALIDA: FALTA",
				[CareerTheme.caps(Career.player_name)]) if por_carga \
						else I18n.tf("FRENAN A {0} EN LA SALIDA: FALTA",
				[CareerTheme.caps(Career.player_name)]),
		}

		if pique:
			_ref_pita()






		_resolve_chance("press_out_foul")
		return


	var penal: bool = _in_penalty_box(_ball_field)
	var texto: String
	if por_carga:
		texto = I18n.tf("CARGAN A {0} POR LA ESPALDA EN EL ÁREA: ¡PENAL!",
			[CareerTheme.caps(Career.player_name)]) if penal \
					else I18n.tf("CARGAN A {0} POR LA ESPALDA: FALTA",
			[CareerTheme.caps(Career.player_name)])
	else:
		texto = I18n.tf("DERRIBAN A {0} EN EL ÁREA: ¡PENAL!",
			[CareerTheme.caps(Career.player_name)]) if penal \
					else I18n.tf("DERRIBAN A {0}: FALTA PELIGROSA",
			[CareerTheme.caps(Career.player_name)])
	_duel_note = {
		"minute": match_minute,
		"win": true,
		"text": texto,
	}
	_momentum.register("dribble_foul")
	_push_momentum()











	if not _practice_kind.is_empty():
		_resolve_chance("dribble_win")
		return





	var eleccion: String = ""
	if pique:
		eleccion = await _pique_acto(culpable)



		if not is_inside_tree() or state != State.DUEL or not is_instance_valid(culpable):
			return




		if not eleccion.is_empty() and not penal:
			_duel_note["text"] = _pique_texto(eleccion)








	if _practice_kind.is_empty() and not _shootout_active and not _extra_time \
			and not GameState.readonly_save and Career.live_match_open() \
			and not _injured_out and not _hooked and not _sub_done \
			and Career.pending_injury_weeks == 0 and culpable != _self_actor \
			and not pique and randf() < Career.live_injury_trauma_p():






		_injury_strike(match_minute, true)



		if not dura:
			_al_contacto(func() -> void: _audio.dolor(true))













	var beat_pique: float = _pique_tarjetas(culpable, eleccion) if pique else -1.0
	if _falta_la_cobra_otro(penal):
		if pique:
			await _shoot_wait(beat_pique)
			if not is_inside_tree() or state != State.DUEL:
				return
		_cobro_cedido(penal)
		return






























	if not penal and not _pedido.is_empty():
		_pedido["paga_falta"] = true
	elif not penal:
		_bump_rating("foul_won")









	_chain_after_duel(_foul_chance(), I18n.t("¡PENAL! Se cobra en los once metros")
		if penal else I18n.t("¡FALTA! Se cobra aquí mismo"),
		beat_pique if pique else _ref_amonesta(dura, culpable))


















