	_haptic(40)












func _recu_keeper_frame(delta: float) -> void:
	if not is_instance_valid(_keeper):
		return





	if _keeper_sale_o_vuelve(delta, true):
		return



	var kp: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)
	var caja: Vector2 = Vector2(clampf(kp.x, - Stadium.PA_HALF_W, Stadium.PA_HALF_W),
		_keeper_goal_z + clampf(_keeper_depth(kp.y), 0.0, Stadium.PA_DEPTH)
			* _keeper_dir())
	if not caja.is_equal_approx(kp):
		_keeper.position = Vector3(caja.x, _keeper.position.y, caja.y)














const RECU_BATIDO_T: float = 2.2

















