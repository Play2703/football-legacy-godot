func _pick_motion(origin: Dictionary) -> Dictionary:













	var kind: String = String(origin.get("kind", ""))
	var is_set: bool = bool(origin.get("set_piece", false)) \
			or AimPress.SET_KINDS.has(kind)
	var aerial: bool = kind == "volea" \
			or String(origin.get("motion_style", "")) == "aereo"










	if kind == "banda":
		return {}
	if not aerial and not is_set:
		return {}



	var chance: float = AimPress.motion_scale(
		float(origin.get("motion_chance", 0.0)), _match_w_hoy(), is_set)
	if chance <= 0.0 or randf() > chance:
		return {}
	var dir: float = float(origin.get("motion_dir", -1.0 if randf() < 0.5 else 1.0))


	var style: String = String(origin.get("motion_style", ""))
	if style == "":
		style = _roll_motion_style(origin)
	var m: Dictionary = _make_motion(style, dir)
	if origin.has("motion_speed"):
		var sp: Vector2 = origin["motion_speed"]
		m["speed"] = randf_range(sp.x, sp.y)


	if origin.has("header_h"):
		var hh: Vector2 = origin["header_h"]
		m["entry_h"] = randf_range(hh.x, hh.y)


		m["gravity"] = _aereo_gravity(float(m["entry_h"]))




	var air: bool = style == "aereo" or String(origin.get("kind", "")) == "volea"




	var pace: float = _motion_pace
	if air:
		pace = 1.0 +(_motion_pace - 1.0) * AIR_PACE_DAMP
	m["speed"] = float(m.get("speed", 0.5)) * pace
	if air:
		m = _air_slowmo(m)
	return m















func _air_slowmo(m: Dictionary) -> Dictionary:
	var f: float = AIR_SPEED_GAIN / STRIKE_SLOWMO
	m["air"] = true
	m["slowmo"] = STRIKE_SLOWMO
	m["vscale"] = f
	m["speed"] = float(m.get("speed", 0.5)) * f
	m["vy0"] = float(m.get("vy0", 0.0)) * f
	m["gravity"] = float(m.get("gravity", STRIKE_GRAVITY)) * f * f
	return m










func _roll_motion_style(origin: Dictionary) -> String:
	if randf() < float(origin.get("roll_bias", 0.75)):
		return "roll"
	var r: float = randf()
	match String(origin.get("kind", "")):
		"centro":
			return "lob" if r < 0.55 else "drive"
		"rebote":
			return "bounce" if r < 0.7 else "drive"
		"volea":





			if r < 0.35:
				return "bounce"
			return "drive" if r < 0.75 else "lob"
		_:
			return "bounce" if r < 0.6 else "lob"





func _make_motion(style: String, dir: float) -> Dictionary:
	match style:
		"bounce":

			return {"kind": "bounce", "dir": dir,
				"speed": randf_range(STRIKE_BOUNCE_SPEED.x, STRIKE_BOUNCE_SPEED.y),
				"entry_h": 0.0, "vy0": randf_range(1.9, 2.5)}
		"lob":

			return {"kind": "lob", "dir": dir,
				"speed": randf_range(STRIKE_LOB_SPEED.x, STRIKE_LOB_SPEED.y),
				"entry_h": randf_range(0.38, 0.46), "vy0": randf_range(0.9, 1.3)}
		"drive":

			return {"kind": "drive", "dir": dir,
				"speed": randf_range(STRIKE_DRIVE_SPEED.x, STRIKE_DRIVE_SPEED.y),
				"entry_h": randf_range(0.08, 0.16), "vy0": randf_range(1.3, 1.7)}
		"aereo":
















			var a_entry: float = randf_range(HEADER_ENTRY_H.x, HEADER_ENTRY_H.y)
			return {"kind": "aereo", "dir": dir, "airborne": true,
				"gravity": _aereo_gravity(a_entry),
				"speed": randf_range(HEADER_AIR_SPEED.x, HEADER_AIR_SPEED.y),
				"entry_h": a_entry, "vy0": 0.0}
		_:

			return {"kind": "roll", "dir": dir,
				"speed": randf_range(STRIKE_ROLL_SPEED.x, STRIKE_ROLL_SPEED.y),
				"entry_h": 0.0, "vy0": 0.0}






func _normalize_motion(m: Dictionary) -> Dictionary:
	if m.is_empty():
		return {}
	var kind: String = String(m.get("kind", ""))
	if kind == "":
		return {}
	if m.has("entry_h") and m.has("vy0"):
		return m
	var full: Dictionary = _make_motion(kind, float(m.get("dir", 1.0)))
	if float(m.get("speed", 0.0)) > 0.0:
		full["speed"] = float(m["speed"])





	if kind == "aereo" or bool(m.get("air", false)):
		var kept: float = float(full["speed"])
		full = _air_slowmo(full)
		if bool(m.get("air", false)):
			full["speed"] = kept
	return full

















const SET_PIECE_ROLL: int = 83
const SP_CORNER_ROLL: int = 89
const SP_PENAL_ROLL: int = 94
const SP_BANDA_ROLL: int = 96
const SP_INDIRECTA_ROLL: int = 98


const SP_ANCHOS: Array = [SP_CORNER_ROLL - SET_PIECE_ROLL, SP_PENAL_ROLL - SP_CORNER_ROLL,
	SP_BANDA_ROLL - SP_PENAL_ROLL, SP_INDIRECTA_ROLL - SP_BANDA_ROLL, 100 - SP_INDIRECTA_ROLL]





static func _sp_roll_base(off: int, anchos: Array) -> int:
	var arranques: Array = [SET_PIECE_ROLL, SP_CORNER_ROLL, SP_PENAL_ROLL,
		SP_BANDA_ROLL, SP_INDIRECTA_ROLL]
	var acc: int = 0
	for i in anchos.size():
		acc += int(anchos[i])
		if off < acc:
			return int(arranques[i])
	return SP_INDIRECTA_ROLL


static func _suma(xs: Array) -> int:
	var t: int = 0
	for x in xs:
		t += int(x)
	return t














const LADO_POR_PUESTO: Dictionary = {
	"EI": Vector2(-1.0, 0.95), "ED": Vector2(1.0, 0.95),
	"MI": Vector2(-1.0, 0.88), "MD": Vector2(1.0, 0.88),
}




func _banda_propia() -> int:
	return int((LADO_POR_PUESTO[_puesto_juego] as Vector2).x) \
			if LADO_POR_PUESTO.has(_puesto_juego) else 0
















const ALTURA_POR_PUESTO: Dictionary = {
	"EI": 2.0, "ED": 2.0,
	"MC": 0.8, "MCD": 0.65,
}



static func altura_z(pos: String, lo: float, hi: float, u: float) -> float:
	return lo +(hi - lo) * pow(u, float(ALTURA_POR_PUESTO.get(pos, 1.0)))


func _z_puesto(lo: float, hi: float) -> float:
	if not ALTURA_POR_PUESTO.has(_puesto_juego):
		return randf_range(lo, hi)
	return altura_z(_puesto_juego, lo, hi, randf())




static func lado_por_puesto(pos: String, roll: float) -> float:
	var fila: Vector2 = LADO_POR_PUESTO.get(pos, Vector2(-1.0, 0.5))
	return fila.x if roll < fila.y else - fila.x


func _pick_origin() -> Dictionary:
	var r_lado: float = randf()
	var side: float = lado_por_puesto(_puesto_juego, r_lado)
	var roll: int = randi() % 100


























	var sp: Array = _rasgos.get("parado", SP_ANCHOS) as Array
	var techo: int = 100 - _suma(sp)
	if roll >= techo:


		var lado_sp: float = -1.0 if r_lado < 0.5 else 1.0
		var roll_sp: int = roll if sp == SP_ANCHOS else _sp_roll_base(roll - techo, sp)




		if roll_sp >= SP_BANDA_ROLL and roll_sp < SP_INDIRECTA_ROLL:
			if _saque_generador_cabe():
				return _saque_origin(lado_sp)
			roll_sp = SP_INDIRECTA_ROLL
		return _draw_set_piece(lado_sp, roll_sp)





	var o: Dictionary = _draw_open_any(side)















	o = _deepen_by_matchup(o, side)
	if _play_style == MatchPlan.Style.BALANCEADO:
		return o
	var z: float =(o["ball"] as Vector2).y




	if _play_style == MatchPlan.Style.OFENSIVO and z >= 30.0 and randf() < 0.5:
		var alt: Dictionary = _draw_open_any(side)
		if (alt["ball"] as Vector2).y < z:
			return alt
	elif _play_style == MatchPlan.Style.DEFENSIVO and z < MatchPlan.SHALLOW_Z:
		var alt: Dictionary = _draw_open_any(side)
		if (alt["ball"] as Vector2).y > z:
			return alt
	return o






const DEEP_EDGE_MIN: float = 6.0
const DEEP_EDGE_FULL: float = 30.0



const DEEP_P_MAX: float = 0.62



const DEEP_TRIES: int = 2


func _deepen_by_matchup(o: Dictionary, side: float) -> Dictionary:
	if _matchup_edge >= - DEEP_EDGE_MIN:
		return o
	var t: float = clampf((- float(_matchup_edge) - DEEP_EDGE_MIN)
		/(DEEP_EDGE_FULL - DEEP_EDGE_MIN), 0.0, 1.0)
	if randf() >= t * DEEP_P_MAX:
		return o













	if not _deep_spared:
		_deep_spared = true
		return o
	var best: Dictionary = o
	var z: float =(o["ball"] as Vector2).y
	for _i in DEEP_TRIES:
		var alt: Dictionary = _draw_open_any(side)
		var az: float =(alt["ball"] as Vector2).y
		if az > z:
			best = alt
			z = az
	return best





















const FORCE_WING_TRIES: int = 6


func _draw_open_any(side: float) -> Dictionary:
	var o: Dictionary = _draw_open_once(side)
	if not _force_wing or absf((o["ball"] as Vector2).x) > WING_X:
		return o
	var z0: float =(o["ball"] as Vector2).y
	for i in FORCE_WING_TRIES:




		var alt: Dictionary = _draw_open_once(lado_por_puesto(_puesto_juego, randf()))
		var b: Vector2 = alt["ball"]
		if absf(b.x) > WING_X and b.y <= z0:
			return alt
	return o


func _draw_open_once(side: float) -> Dictionary:








	var arch: Dictionary = ChanceArchetypes.roll_open(side, _tac_hoy(), _dieta,
		float(ChanceArchetypes.PUESTO_CERCA_P.get(_puesto_juego, 0.0)))


	if not arch.is_empty():
		return arch




	var g: Dictionary = _draw_open_play(side)
	g["generica"] = true
	return _sazona_generica(g)



































const SABOR_GEN_P: float = 0.35
const SABOR_GEN_KINDS: Array[String] = ["frontal", "lejano", "angulo", "contra"]
const SABOR_SQUEEZE: Vector2 = Vector2(0.57, 0.64)
const SABOR_DRIFT: Vector2 = Vector2(0.33, 0.4)

var sabor_gen_p: float = SABOR_GEN_P


func _sazona_generica(o: Dictionary) -> Dictionary:
	if sabor_gen_p <= 0.0 or _force_wing \
			or not SABOR_GEN_KINDS.has(String(o.get("kind", ""))):
		return o
	var r: RandomNumberGenerator = _rng_de_jugada(o["ball"], "sabor")
	if r.randf() >= sabor_gen_p:
		return o
	if r.randf() < 0.5:
		o["def_flavor"] = {"def_squeeze": r.randf_range(SABOR_SQUEEZE.x, SABOR_SQUEEZE.y)}
	else:
		o["def_flavor"] = {"def_drift": r.randf_range(SABOR_DRIFT.x, SABOR_DRIFT.y)
			*(1.0 if r.randf() < 0.5 else -1.0)}
	return o









func _rng_de_jugada(ball: Vector2, sal: String) -> RandomNumberGenerator:
	var r: RandomNumberGenerator = RandomNumberGenerator.new()
	r.seed = hash([ball.x, ball.y, sal])
	return r



































































func _draw_open_play(side: float, forced_roll: int = -1) -> Dictionary:
	var roll: int = randi() % 72 if forced_roll < 0 else clampi(forced_roll, 0, 71)








































	var a: Array = MatchPlan.DIETA_BASE if forced_roll >= 0 \
			else MatchPlan.dieta_anchos(_dieta, _play_style, _puesto_juego,
			_rasgos.get("dieta", []) as Array)
	var corte: int = int(a[0])
	if roll < corte:

		var x: float = _lateral_x(side, 6.0, 8.0, 19.0, 0.34)
		return {"kind": "solo",
			"name": "Encarada por la banda" if absf(x) > 7.0 else "Mano a mano",
			"ball": Vector2(x, _z_puesto(7.0, 18.0)),
			"mates": [1, 2], "rivals": [1, 2]}
	corte += int(a[1])
	if roll < corte:
		var x2: float = _lateral_x(side, 11.0, 12.0, 24.0, 0.48)
		return {"kind": "frontal",
			"name": "Disparo escorado" if absf(x2) > 11.5 else "Disparo frontal",
			"ball": Vector2(x2, _z_puesto(17.0, 30.0)),
			"mates": [3, 5], "rivals": [3, 5]}
	corte += int(a[2])
	if roll < corte:


		var z3: float = _z_puesto(28.0, 50.0)
		var x3: float = _lateral_x(side, 13.0, 14.0, _wing_reach(28.0, z3), 0.52)
		return {"kind": "lejano",
			"name": "Desde la banda" if absf(x3) > 13.5 else "Desde lejos",
			"ball": Vector2(x3, z3),
			"mates": [2, 4], "rivals": [2, 4]}
	corte += int(a[3])
	if roll < corte:

		return {"kind": "angulo", "name": "Ángulo cerrado",
			"ball": Vector2(side * randf_range(11.0, 25.0), _z_puesto(10.0, 20.0)),
			"mates": [3, 4], "rivals": [3, 5]}
	corte += int(a[4])
	if roll < corte:

		var z5: float = _z_puesto(30.0, 46.0)
		var x5: float = _lateral_x(side, 9.0, 11.0, _wing_reach(26.0, z5), 0.56)



		return {"kind": "contra",
			"name": "Contra por la banda" if absf(x5) > 10.0 else "Contraataque",
			"ball": Vector2(x5, z5),
			"mates": [2, 4], "rivals": [2, 3], "tras_balon": [3.0, 9.0]}












	var x6: float = side * randf_range(17.0, 29.0)
	return {"kind": "centro",
		"name": "Centro desde el fondo" if absf(x6) > 24.0 else "Centro al área",
		"ball": Vector2(x6, randf_range(4.0, 9.0)),
		"mates": [3, 4], "rivals": [3, 5]}




























const WING_REACH_Z: Vector2 = Vector2(34.0, 52.0)
const WING_REACH_FAR: float = 17.0


func _wing_reach(near_hi: float, z: float) -> float:
	var t: float = clampf((z - WING_REACH_Z.x) /(WING_REACH_Z.y - WING_REACH_Z.x),
		0.0, 1.0)
	return lerpf(near_hi, WING_REACH_FAR, t)


func _lateral_x(side: float, central: float, wing_lo: float, wing_hi: float,
		wing_p: float) -> float:
	if _force_wing:
		return side * randf_range(lerpf(wing_lo, wing_hi, 0.55), wing_hi)
	if randf() < wing_p:
		return side * randf_range(wing_lo, wing_hi)
	var xc: float = randf_range(- central, central)




	if LADO_POR_PUESTO.has(_puesto_juego):
		var fila: Vector2 = LADO_POR_PUESTO[_puesto_juego]
		if randf() < fila.y:
			xc = absf(xc) * fila.x
	return xc


























func _draw_set_piece(side: float, roll: int) -> Dictionary:
	if roll < SP_CORNER_ROLL:
		var vl: Dictionary = ChanceArchetypes.libre_variant(side)
		if not vl.is_empty():
			return vl







		var spot: Vector2 = _free_kick_spot(side)
		return {"kind": "libre", "name": "Tiro libre",
			"ball": spot,
			"mates": [2, 4], "rivals": [2, 3],
			"wall": ChanceArchetypes.wall_for(spot), "set_piece": true}
	if roll < SP_PENAL_ROLL:




























		return {"kind": "corner", "name": "Tiro de esquina",
			"ball": Vector2(side *(Stadium.FIELD_HALF_W - randf_range(0.55, 0.95)),
				randf_range(0.55, 0.95)),
			"mates": [4, 6], "rivals": [4, 5], "set_piece": true,
			"dens_cap": 12, "cross_plan": randi() % CORNER_PLANS.size(),
			"def_plan": randi() % CORNER_DEF_PLANS.size(),
			"mark_man": randf() < lerpf(CORNER_MAN_P.x, CORNER_MAN_P.y, _tac_marcaje)}
	if roll < SP_BANDA_ROLL:
		return {"kind": "penal", "name": "Penal",
			"ball": Vector2(0.0, 11.0), "mates": [0, 0], "rivals": [0, 0],
			"set_piece": true}
	if roll < SP_INDIRECTA_ROLL:











		return {"kind": "banda", "name": "Saque de banda largo",
			"ball": Vector2(side * randf_range(12.0, 20.0), randf_range(6.0, 11.0)),
			"mates": [2, 4], "rivals": [2, 4], "set_piece": true}




	var vi: Dictionary = ChanceArchetypes.indirecta_variant(side)
	if not vi.is_empty():
		return vi

	var spot_i: Vector2 = Vector2(randf_range(-7.0, 7.0),
		randf_range(Stadium.PA_DEPTH + 0.5, Stadium.PA_DEPTH + 3.5))
	return {"kind": "indirecta", "name": "Falta al borde del área",
		"ball": spot_i, "mates": [2, 3], "rivals": [1, 2],
		"wall": ChanceArchetypes.wall_for(spot_i), "set_piece": true}







func _free_kick_spot(side: float) -> Vector2:
	if randf() < 0.72:
		return Vector2(randf_range(-13.0, 13.0),
			randf_range(Stadium.PA_DEPTH + 1.2, 27.0))
	return Vector2(
		side * randf_range(Stadium.PA_HALF_W + 1.0, Stadium.PA_HALF_W + 5.5),
		randf_range(7.0, 15.0))















const AXIS_MAX: float = 46.0
func _view_fwd(ball: Vector2) -> Vector2:






















	var meta: Vector2 = Vector2.ZERO
	var to_goal: Vector2 = meta - ball
	if to_goal.length() < 0.001:
		return Vector2(0.0, -1.0)
	var fwd: Vector2 = to_goal.normalized()
	var axis: Vector2 = Vector2(0.0, -1.0)
	var off: float = absf(fwd.angle_to(axis))
	var lim: float = deg_to_rad(AXIS_MAX)
	if off <= lim:
		return fwd


	return axis.rotated(lim * signf(axis.angle_to(fwd)))

















func _switch_axis() -> Vector2:
	if _switch_active and _switch_target_pos != Vector2.ZERO:
		var to_mate: Vector2 = _switch_target_pos - _ball_field
		if to_mate.length() > 0.001:
			return to_mate.normalized()
	var to_goal: Vector2 = Vector2.ZERO - _ball_field
	if to_goal.length() < 0.001:
		return Vector2(0.0, -1.0)
	return to_goal.normalized()




func _axis_bias(ball: Vector2) -> float:
	var to_goal: Vector2 = Vector2.ZERO - ball
	if to_goal.length() < 0.001:
		return 0.0
	var off: float = rad_to_deg(absf(to_goal.normalized().angle_to(Vector2(0.0, -1.0))))
	return clampf((off - AXIS_MAX) / 40.0, 0.0, 1.0)
















func _vis_half(d: float, a: float, kind: String = "") -> float:
	var dd: float = maxf(d, 4.0)
	var cam: Dictionary = _cam_params(kind, dd, false)
	var h: float = float(cam["h"])
	var back: float = float(cam["back"])
	var ax: float = float(cam["look"]) * dd + back




















	var k: float = tan(deg_to_rad(float(cam["fov"]) * 0.5)) * AIM_ASPECT
	return k *((a + back) * ax + h * h) / sqrt(ax * ax + h * h)


func _safe_half(d: float, a: float) -> float:
	return maxf(_vis_half(d, a) * VIS_FRAC - SPRITE_PAD, SAFE_MIN)





func _along_sep(a: float) -> float:
	return clampf(2.6 + 0.1 * a, 2.6, 4.4)




























func _keeper_spot(ball: Vector2) -> Vector2:






	var casa: float = _keeper_home_z(ball)



	return Vector2(ScenarioStore.keeper_spot_x(ball, _keeper_goal_z, _keeper_dir(),
		_keeper_depth(casa), keeper_near_post, keeper_near_post_near_m), casa)





func _frame_al(p: Vector2, ball: Vector2, f: Dictionary) -> Vector2:
	var rel: Vector2 = p - ball
	return Vector2(rel.dot(f["fwd"]), rel.dot(f["perp"]))






func _place(a: float, l: float, ball: Vector2, f: Dictionary, keeper: Vector2) -> Vector2:
	var d: float = ball.length()
	a = clampf(a, A_MIN, d + 8.0)
	var s: float = _safe_half(d, a)
	if a > 0.0 and a < f["lane"] and s < LANE_EDGE + 0.1:

		a = f["lane"] + 0.6
		s = _safe_half(d, a)
	l = clampf(l, - s, s)
	if a > 0.0 and a < f["lane"] and absf(l) < LANE_EDGE:
		l = LANE_EDGE *(1.0 if l >= 0.0 else -1.0)
	var p: Vector2 = ball + f["fwd"] * a + f["perp"] * l
	p = _push_out(p, ball, BALL_SAFE)
	p = _push_out(p, f["runup"], RUNUP_SAFE)
	p = _push_out(p, keeper, KEEPER_CLEAR)
	return _clamp_field(p)




func _density_cap(d: float) -> int:
	return clampi(roundi(DENS_B + DENS_K * d + randf_range(- DENS_JIT, DENS_JIT)),
		DENS_MIN, DENS_MAX)






func _build_support(ball: Vector2, origin: Dictionary, count: int) -> Array:
	var out: Array = []
	_last_support_roles = []
	if count <= 0:
		return out
	var f: Dictionary = _shot_frame(ball)
	var keeper: Vector2 = _keeper_spot(ball)
	var d: float = ball.length()
	var kind: String = String(origin["kind"])


	if _is_cross(kind) or bool(origin.get("cross", false)):








		var ladder: Array[Vector2] = ZONA_A_CORNER if kind == "corner" else ZONA_A




		if kind == "corner" and origin.has("cross_plan"):
			var plan: Array = CORNER_PLANS[int(origin["cross_plan"]) % CORNER_PLANS.size()]
			var reord: Array[Vector2] = []
			for idx in plan:
				reord.append(ladder[int(idx) % ladder.size()])
			ladder = reord
		var sb: float = 1.0 if absf(ball.x) < 2.0 else _side_of(ball.x)



		var dz: float = _cross_block_dz(ball, origin)




		if kind in FK_LINE_KINDS and ball.y >= FK_LINE_MIN_Z:
			var z_linea: float = maxf(dz + FK_LINE_HOMBRO, FK_LINE_SUELO)
			for i in count:
				var carril: float = FK_LINE_X[i % FK_LINE_X.size()]
				var fila: float = FK_LINE_FILA * float(i / FK_LINE_X.size())
				var wp: Vector2 = Vector2(
					carril + randf_range(- FK_LINE_JIT_X, FK_LINE_JIT_X),
					z_linea + fila + randf_range(- FK_LINE_JIT_Z, FK_LINE_JIT_Z))
				var al: Vector2 = _frame_al(wp, ball, f)
				out.append(_place(al.x, al.y, ball, f, keeper))
			return out
		for i in count:
			var slot: Vector2 = ladder[i % ladder.size()]
			var rho: float = slot.x * randf_range(0.93, 1.08) * pow(1.4, float(i / ladder.size()))
			var th: float = deg_to_rad(slot.y *(1.0 if (i / ladder.size()) % 2 == 0 else -1.0)
				+ randf_range(-7.0, 7.0))
			var wp: Vector2 = Vector2(sb * rho * sin(th), rho * cos(th) + dz)
			var al: Vector2 = _frame_al(wp, ball, f)
			out.append(_place(al.x, al.y, ball, f, keeper))
		return out
	var need: int = count




	var roles: Array = origin["support_roles"] if origin.has("support_roles") \
			else _support_guion(kind, d, ball, bool(origin.get("name_final", false)))
	_last_support_roles = roles
	var sd: float = -(1.0 if absf(ball.x) < 2.0 else _side_of(ball.x))
	for i in need:
		var role: String = String(roles[i % roles.size()])
		var wrap: float = pow(1.35, float(i / roles.size()))





		var use_sd: float = sd
		if role == "doblada" and absf(ball.x) >= 2.0:
			use_sd = _side_of(ball.x)
		var al: Vector2 = _support_al(role, d, use_sd, wrap,
			int(origin.get("wall", 0)))
		var p: Vector2 = _place(al.x, al.y, ball, f, keeper)






		if role == "tercer_hombre":
			var ta: float = al.x
			for _t in 8:
				if not (p.y < Stadium.PA_DEPTH + TERCER_AREA_HOLGURA
						and absf(p.x) < Stadium.PA_HALF_W + TERCER_AREA_HOLGURA):
					break
				ta -= 1.0
				p = _place(ta, al.y, ball, f, keeper)
		out.append(p)
		sd = - sd
	return out
























func _support_roles(kind: String, d: float) -> Array:
	if kind == "libre" or kind == "indirecta":
		return ["punta_barrera", "rechace", "carga_area", "segundo_lanzador"]
	if kind == "solo" or kind == "rebote" or (kind == "volea" and d < 16.0):
		return ["pared", "apoyo_lateral", "profundidad"]
	if kind == "lejano" or kind == "contra":
		return ["profundidad", "interior", "apoyo_lateral", "ancho"]
	return ["profundidad", "apoyo_lateral", "interior", "ancho"]

































const SUPPORT_PLAN_P: float = 0.5
const SUPPORT_PLANS: Dictionary = {
	"lejos": [["interior", "doblada", "profundidad", "apoyo_lateral"],
		["apoyo_lateral", "profundidad", "doblada", "interior"]],
	"frente": [["interior", "ancho", "profundidad", "apoyo_lateral"],
		["apoyo_lateral", "profundidad", "ancho", "interior"]],
}

var support_plan_p: float = SUPPORT_PLAN_P






const TERCER_A: Vector2 = Vector2(11.0, 16.0)
const TERCER_AREA_PAD: float = 3.5
const TERCER_TAG_PAD: float = 1.5


const TERCER_AREA_HOLGURA: float = 1.0


func _support_guion(kind: String, d: float, ball: Vector2, con_nombre: bool = false) -> Array:
	var clasico: Array = _support_roles(kind, d)
	var fam: String = ""
	if kind == "lejano" or kind == "contra":
		fam = "lejos"
	elif kind == "frontal" or kind == "angulo":


		fam = "frente"
	if fam == "" or con_nombre or support_plan_p <= 0.0:
		return clasico
	var r: RandomNumberGenerator = _rng_de_jugada(ball, "guion")
	if r.randf() >= support_plan_p:
		return clasico
	var alts: Array = SUPPORT_PLANS[fam]
	var plan: Array =(alts[r.randi() % alts.size()] as Array).duplicate()
	if absf(ball.x) < 2.0:
		for j in plan.size():
			if String(plan[j]) == "doblada":
				plan[j] = "ancho"
	return plan


func _support_al(role: String, d: float, sd: float, wrap: float,
		wall_n: int = 0) -> Vector2:







	if role == "punta_barrera":
		var aw: float = 9.15 + randf_range(-0.4, 0.5)
		var lw: float = float(maxi(wall_n, WALL_MIN_SHOULDER) - 1) * 0.5 * WALL_STEP \
				+ ACTOR_SEP * 1.05
		return Vector2(aw, sd * lw)
	var a: float = 0.0
	var frac: float = 0.0
	match role:
		"profundidad":
			a = clampf(0.34 * d, 4.0, 11.0) + randf_range(-0.8, 1.6)
			frac = randf_range(0.35, 0.75)
		"interior":
			a = clampf(0.2 * d, 2.5, 7.0) + randf_range(-0.6, 1.2)
			frac = randf_range(0.55, 0.95)
		"pared":
			a = randf_range(3.0, 5.5)
			frac = randf_range(0.4, 0.7)
		"ancho":
			a = clampf(0.12 * d, 1.0, 4.0)
			frac = 0.95
		"rechace":




			a = clampf(d - 17.0, 4.5, 8.4) + randf_range(-0.6, 0.9)
			frac = randf_range(0.3, 0.62)
		"carga_area":


			a = clampf(d - 8.0, 9.8, maxf(d - 4.5, 9.8)) + randf_range(-1.0, 1.0)
			frac = randf_range(0.45, 0.85)
		"segundo_lanzador":



			a = randf_range(0.3, 1.3)
			frac = randf_range(0.14, 0.26)
		"doblada":



			a = clampf(0.26 * d, 3.5, 8.0) + randf_range(-0.6, 1.2)
			frac = randf_range(0.85, 1.0)
		"tercer_hombre":








			a = minf(clampf(0.42 * d, TERCER_A.x, TERCER_A.y),
				d -(Stadium.PA_DEPTH + TERCER_AREA_PAD))
			frac = randf_range(0.45, 0.75)
		_:
			a = randf_range(0.8, 2.6)
			frac = randf_range(0.7, 0.95)
	a *= wrap
	var l: float = sd * frac * _safe_half(d, a)



	if role == "tercer_hombre":
		var l_max: float = sqrt(maxf(pow(TAG_MAX_M - TERCER_TAG_PAD, 2.0) - a * a, 0.0))
		l = clampf(l, - l_max, l_max)
	return Vector2(a, l)




const ESTRELLA_ENCIMA_M: float = 0.9







func _marca_estrella() -> bool:
	return Settings.dif_marca_estrella() and _practice_kind.is_empty() \
			and not _tutorial_active and Career.es_estrella()








func _build_defense(ball: Vector2, origin: Dictionary, support: Array, count: int) -> Array:
	var out: Array = []


	_last_press_roles = []



	_last_def_line = DEF_LINE_NORMAL
	_last_mark = "zonal"
	_last_def_flavor = ""
	var wall_n: int = int(origin.get("wall", 0))
	if wall_n > 0:


		out = _make_wall(ball, wall_n)
	if count <= 0:
		_last_scheme = ""
		return out
	var f: Dictionary = _shot_frame(ball)
	var keeper: Vector2 = _keeper_spot(ball)
	var d: float = ball.length()
	var shape: String = _pick_shape(String(origin["kind"]), wall_n, d)










	if origin.has("def_shape"):
		var want: String = String(origin["def_shape"])
		if want == "bajo" or want == "medio" or want == "repliegue" or want == "zonal":
			shape = want

	var s_mates: float = 0.0
	for m in support:
		s_mates += signf(_frame_al(m, ball, f).y)
	var s_press: float = 1.0 if s_mates > 0.0 else (-1.0 if s_mates < 0.0 else
		(1.0 if randf() < 0.5 else -1.0))

	if shape == "zonal":
		var sb: float = 1.0 if absf(ball.x) < 2.0 else _side_of(ball.x)










		var man: Array = []
		if bool(origin.get("mark_man", false)):
			man = _mark_targets(support, ball, f, out,
				mini(CORNER_MAN_MAX, count - 1))






		_last_scheme = "zonal"
		_last_mark = "hombre" if not man.is_empty() else "zonal"
		for i in man.size():
			var t: Vector2 = _frame_al(man[i], ball, f)
			var sm: float = signf(t.y) if absf(t.y) > 0.3 else (1.0 if randf() < 0.5 else -1.0)
			out.append(_place(t.x + randf_range(MARK_DA.x, MARK_DA.y),
				t.y + sm * randf_range(MARK_DL.x, MARK_DL.y), ball, f, keeper))




		var ladder_d: Array[Vector2] = ZONA_D
		if origin.has("def_plan"):
			var dplan: Array = CORNER_DEF_PLANS[int(origin["def_plan"]) % CORNER_DEF_PLANS.size()]
			var reord_d: Array[Vector2] = []
			for idx in dplan:
				reord_d.append(ZONA_D_CORNER[int(idx) % ZONA_D_CORNER.size()])
			ladder_d = reord_d


		var dz_d: float = _cross_block_dz(ball, origin)




		var plana: bool = man.is_empty() and _falta_plana(origin, ball)
		var z_plana: float = _falta_plana_z(ball, origin) if plana else 0.0
		for i in count - man.size():
			if plana:
				var sp: Vector2 = _falta_plana_sitio(i, sb, z_plana)
				var wq: Vector2 = Vector2(sp.x + randf_range(- FK_PLANA_JIT_X, FK_PLANA_JIT_X),
					sp.y + randf_range(- FK_PLANA_JIT_Z, FK_PLANA_JIT_Z))
				var aq: Vector2 = _frame_al(wq, ball, f)
				out.append(_place(aq.x, aq.y, ball, f, keeper))
				continue
			var slot: Vector2 = ladder_d[i % ladder_d.size()]
			var rho: float = slot.x * randf_range(ZONA_JIT_R.x, ZONA_JIT_R.y) \
					* pow(1.5, float(i / ladder_d.size()))
			var th: float = deg_to_rad(slot.y *(1.0 if (i / ladder_d.size()) % 2 == 0 else -1.0)
				+ randf_range(- ZONA_JIT_T, ZONA_JIT_T))
			var wp: Vector2 = Vector2(sb * rho * sin(th), rho * cos(th) + dz_d)
			var al: Vector2 = _frame_al(wp, ball, f)
			out.append(_place(al.x, al.y, ball, f, keeper))


















		if bool(origin.get("can_high", false)):
			_last_def_line = _roll_def_line(origin, d)
		return out


	var rl: Vector3 = RLINE_MEDIO
	match shape:
		"bajo":
			rl = RLINE_BAJO
		"repliegue":
			rl = RLINE_REPL
		"barrera":
			rl = RLINE_BARRERA



	var rk: float = rl.x * randf_range(1.0 - RLINE_JIT, 1.0 + RLINE_JIT)
	var r_line: float = clampf(rk * d -(13.6 if shape == "barrera" else 0.0), rl.y, rl.z)


	if shape == "bajo":
		r_line = clampf(maxf(rk * d, d - RLINE_BAJO_HUECO *(2.0 - rk / rl.x)), rl.y, rl.z)
















	_last_def_line = _roll_def_line(origin, d)



















	var can_high: bool = shape == "medio" or shape == "repliegue" \
			or (shape == "zonal" and bool(origin.get("can_high", false)))
	if _last_def_line == DEF_LINE_ALTA and not can_high:
		_last_def_line = DEF_LINE_NORMAL
	if _last_def_line == DEF_LINE_BAJA:

		if shape == "bajo":
			r_line = minf(r_line, maxf(RLINE_BAJA_SUELO, r_line - RLINE_BAJA_HONDO))
		else:
			r_line = minf(r_line, rl.y +(rl.z - rl.y) * 0.25)
	var high: bool = can_high \
			and d >= HIGH_D_MIN and support.size() >= 1 and randf() < HIGH_P
	if _last_def_line == DEF_LINE_ALTA:
		high = true
	elif _last_def_line == DEF_LINE_BAJA:
		high = false
	var a_ceil: float = d - LINE_A_CEIL
	if high:
		var hk: float = HIGH_K_FORCED if _last_def_line == DEF_LINE_ALTA else HIGH_K
		r_line = maxf(r_line, d - clampf(hk * d, f["lane"] + 1.4, maxf(a_ceil, f["lane"] + 1.5)))
	var a_floor: float = f["lane"] + LINE_A_FLOOR_K
	if shape == "barrera":
		a_floor = maxf(a_floor, 9.15 + WALL_GAP)
	var a_line: float = clampf(d - r_line, a_floor, a_ceil) if a_ceil >= a_floor else a_ceil













	var a_press_c: float = minf(PRESS_A_K * d + PRESS_A_B, PRESS_A_MAX - PRESS_A_JIT)
	var a_press: float = clampf(a_press_c + randf_range(- PRESS_A_JIT, PRESS_A_JIT),
		PRESS_A_MIN, PRESS_A_MAX)
	var use_press: bool = wall_n == 0 and count >= 2 \
			and a_line - a_press >= _along_sep(a_press)










	var presion: Array = origin.get("presion", []) if wall_n == 0 else []
	if not presion.is_empty() and count >= 1:
		use_press = true
		a_press = randf_range(float(presion[0]), float(presion[1]))
	var n_extra: int = mini(int(presion[2]), count - 1) if not presion.is_empty() else 0







	if wall_n == 0 and count >= 1 and _marca_estrella() \
			and AimPress.allowed_kind(String(origin["kind"])):
		use_press = true
		a_press = randf_range(AimPress.MIN_D0, AimPress.MIN_D0 + ESTRELLA_ENCIMA_M)
		n_extra = mini(maxi(n_extra, 1), count - 1)
	var use_cover: bool = use_press and count - n_extra >= 4 \
			and a_line - a_press >= 2.0 * _along_sep(a_press) + 0.6
	var m: int = count - int(use_press) - int(use_cover) - n_extra








	var press_floor: bool = wall_n == 0 and AimPress.allowed_kind(String(origin["kind"]))
	if use_press:


		var la: float = a_press + randf_range(-0.3, 0.3)
		var ll: float = s_press * clampf(randf_range(PRESS_L_FRAC.x, PRESS_L_FRAC.y)
			* _safe_half(d, la), PRESS_L_MIN, PRESS_L_MAX)



		if press_floor:
			la = AimPress.floor_al(la, ll)
		_last_press_roles.append(out.size())
		out.append(_place(la, ll, ball, f, keeper))
	if use_cover:

		var ca: float = a_press + _along_sep(a_press) + randf_range(COVER_DA_JIT.x, COVER_DA_JIT.y)
		var cl: float = - s_press * clampf(randf_range(COVER_L_FRAC.x, COVER_L_FRAC.y)
			* _safe_half(d, ca), COVER_L_MIN, COVER_L_MAX)
		if press_floor:
			ca = AimPress.floor_al(ca, cl)
		_last_press_roles.append(out.size())
		out.append(_place(ca, cl, ball, f, keeper))





	for k in n_extra:
		var lado: float = - s_press if k % 2 == 0 else s_press
		var ea: float = a_press + 1.6 * float(k + 1) + randf_range(0.0, 1.0)
		var el: float = lado * randf_range(2.5, 4.5)
		if press_floor:
			ea = AimPress.floor_al(ea, el)
		_last_press_roles.append(out.size())
		out.append(_place(ea, el, ball, f, keeper))














	if wall_n > 0 and m > WALL_LINE_KEEP:
		var lejos: Array = []
		for mate in support:
			if (mate as Vector2).distance_to(ball) >= WALL_MARK_MIN_D:
				lejos.append(mate)
		var man_w: Array = _mark_targets(lejos, ball, f, out,
			mini(WALL_MARK_MAX, m - WALL_LINE_KEEP))
		for t in man_w:
			var tw: Vector2 = _frame_al(t, ball, f)
			var sw: float = signf(tw.y) if absf(tw.y) > 0.3 \
					else (1.0 if randf() < 0.5 else -1.0)
			out.append(_place(tw.x + randf_range(MARK_DA.x, MARK_DA.y),
				tw.y + sw * randf_range(MARK_DL.x, MARK_DL.y), ball, f, keeper))
		m -= man_w.size()
		if not man_w.is_empty():
			_last_mark = "hombre"




	var line_slots: Array = []
	var half: float = _safe_half(d, a_line)
	if m == 1:
		var solo_side: float = - s_press if use_press else s_press
		line_slots.append(Vector2(a_line + randf_range(-0.45, 0.45),
			solo_side * clampf(LINE_SOLO_FRAC * half, LINE_SOLO_MIN, LINE_SOLO_MAX)))
	elif m > 1:
		var pref: float = clampf(LINE_PREF_B + LINE_PREF_K * d, LINE_PREF_B, LINE_PREF_MAX)
		var step: float = clampf(LINE_STEP_K * half / float(m - 1), LINE_STEP_MIN, pref)














		var sq_k: float = float(origin.get("def_squeeze", 1.0))
		var dr_k: float = float(origin.get("def_drift", 0.0))







		var sabor: Dictionary = origin.get("def_flavor", {})
		if not sabor.is_empty() and (shape == "medio" or shape == "repliegue") \
				and not origin.has("def_squeeze") and not origin.has("def_drift"):
			if sabor.has("def_squeeze"):
				sq_k = float(sabor["def_squeeze"])
				_last_def_flavor = "squeeze"
			elif sabor.has("def_drift"):
				dr_k = float(sabor["def_drift"])
				_last_def_flavor = "drift"
		step *= clampf(sq_k, 0.35, 1.0)
		var drift: float = clampf(dr_k, -0.5, 0.5) * half * s_press
		for i in m:
			var li: float =(float(i) - float(m - 1) * 0.5) * step + drift \
					+ randf_range(-0.3, 0.3)
			if a_line < f["lane"] and absf(li) < LANE_EDGE:
				li = LANE_EDGE *(1.0 if li >= 0.0 else -1.0)
			line_slots.append(Vector2(a_line + randf_range(-0.45, 0.45), li))







	var marks: Array = _mark_targets(support, ball, f, out, mini(line_slots.size() - 2, MARK_MAX))
	line_slots.sort_custom(func(x: Vector2, y: Vector2) -> bool: return absf(x.y) > absf(y.y))
	for i in line_slots.size():
		var slot: Vector2 = line_slots[i]
		if i < marks.size():
			var t: Vector2 = _frame_al(marks[i], ball, f)
			var sm: float = signf(t.y) if absf(t.y) > 0.3 else (1.0 if randf() < 0.5 else -1.0)
			out.append(_place(t.x + randf_range(MARK_DA.x, MARK_DA.y),
				t.y + sm * randf_range(MARK_DL.x, MARK_DL.y), ball, f, keeper))
		else:
			out.append(_place(slot.x, slot.y, ball, f, keeper))
	_last_scheme = "adelantada" if high else shape
	return out











func _floor_defenders(defenders: Array, ball: Vector2) -> bool:
	var f: Dictionary = _shot_frame(ball)
	var keeper: Vector2 = _keeper_spot(ball)
	var moved: bool = false
	for i in defenders.size():
		var al: Vector2 = _frame_al(defenders[i], ball, f)
		var fa: float = AimPress.floor_al(al.x, al.y)
		if fa <= al.x + 0.001:
			continue
		defenders[i] = _place(fa, al.y, ball, f, keeper)
		moved = true
	return moved




func _mark_targets(support: Array, ball: Vector2, f: Dictionary, placed: Array,
		room: int) -> Array:
	var out: Array = []
	if room <= 0:
		return out
	var cands: Array = []
	for mate in support:
		if (mate as Vector2).length() > MARK_BOX_R:
			continue
		var taken: bool = false
		for p in placed:
			if (mate as Vector2).distance_to(p) < MARK_SKIP_R:
				taken = true
				break
		if not taken:
			cands.append(mate)
	cands.sort_custom(func(x: Vector2, y: Vector2) -> bool: return x.length() < y.length())
	for i in mini(room, cands.size()):
		out.append(cands[i])
	return out


















func _roll_def_line(origin: Dictionary, d: float) -> String:
	var forced: String = String(origin.get("def_line", ""))
	if forced == DEF_LINE_ALTA or forced == DEF_LINE_BAJA or forced == DEF_LINE_NORMAL:


		if forced != DEF_LINE_ALTA or d >= HIGH_D_MIN:
			return forced
		return DEF_LINE_NORMAL



	var tac: float =(0.5 - _tac_bloque) * 2.0
	var p_alta: float = clampf(DEF_LINE_ALTA_P_FAR + tac * TAC_LINE_SPAN.x, 0.0, 1.0)
	var p_baja: float = clampf(DEF_LINE_BAJA_P_FAR - tac * TAC_LINE_SPAN.y, 0.0, 1.0)
	var r: float = randf()






	if d >= HIGH_D_MIN and (int(origin.get("wall", 0)) == 0
			or bool(origin.get("can_high", false))):
		if r < p_alta:
			return DEF_LINE_ALTA
		if r < p_alta + p_baja:
			return DEF_LINE_BAJA
		return DEF_LINE_NORMAL


	var p_baja_n: float = clampf(DEF_LINE_BAJA_P_NEAR - tac * TAC_LINE_SPAN.y, 0.0, 1.0)
	return DEF_LINE_BAJA if r < p_baja_n else DEF_LINE_NORMAL





