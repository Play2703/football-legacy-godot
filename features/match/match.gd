	if _keeper_goal_z == 0.0 or not is_instance_valid(_keeper) \
			or _keeper.sprite_frames == null:
		return nombre

	var atras: String = "idle_back" if nombre == "idle" else nombre + "_north"
	if _keeper.sprite_frames.has_animation(atras):
		return atras




	if _keeper.sprite_frames.has_animation("idle_back"):
		return "idle_back"
	return nombre


func _keeper_home_z(ball: Vector2 = Vector2(NAN, NAN)) -> float:





	if not keeper_home_curve:
		return _keeper_goal_z + KEEPER_HOME_Z * _keeper_dir()
	var b: Vector2 = _ball_field if is_nan(ball.x) else ball


	return _keeper_goal_z + ScenarioStore.keeper_home_depth(
		_keeper_depth(b.y), _keeper_skill) * _keeper_dir()



