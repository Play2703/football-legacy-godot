		return
	_clear_anims_prioritarias()
	_recu_over = true
	_recu_tally[why] = int(_recu_tally.get(why, 0)) + 1




	_recu_last_why = why
	_duel_steer = Vector2.ZERO
	_recu_yo_vel = Vector2.ZERO
	_recu_vel = Vector2.ZERO
	var color: Color = UiKit.GOLD if why == "robo" or why == "parada" \
			else Color("FF6B6B")
