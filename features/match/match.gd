func _tutorial_demo_vacio() -> Vector2:
	if _aim_cam == null or not is_instance_valid(_self_actor):
		return Vector2.INF
	var c: Vector2 = _ring_screen_center()
	var r: float = _ring_radius_px()
	var vp: Vector2 = SceneFade.rect_visible(self).size


	for paso in [1.7, 2.3, 3.0]:
		for ang in [0.0, 0.5, -0.5, 1.0, -1.0, 1.6, -1.6, 2.4, -2.4, PI]:
			var p: Vector2 = c + Vector2(0.0, - r * paso).rotated(ang)
			if p.x < 110.0 or p.x > vp.x - 110.0 or p.y < 260.0 or p.y > vp.y - 330.0:
				continue
			if p.distance_to(c) <= r * 1.35:
				continue
			if _actor_at(p) != null:
				continue
			return p
	return Vector2.INF









func _tutorial_demo_fase(nombre: String) -> void:
	match nombre:
		"palabra_apunta":
			_tutorial_ring_forzado = "apunta"
		"palabra_regate":
			_tutorial_ring_forzado = "regate"
		"palabra_nada":
			_tutorial_ring_forzado = ""
		"toque_modo":
			if _tutorial_demo_cross < 0:
				_tutorial_demo_cross = 1 if _cross_mode else 0
			_set_cross_mode(not _cross_mode)
		"toque_camara":
			if _tutorial_demo_view < 0:
				_tutorial_demo_view = 1 if _pass_view else 0
			_on_cam_focus_requested()
		"fin":
			_tutorial_ring_forzado = ""
			if _tutorial_demo_cross >= 0:
				_set_cross_mode(_tutorial_demo_cross == 1)
				_tutorial_demo_cross = -1
			if _tutorial_demo_view >= 0:
				if _pass_view !=(_tutorial_demo_view == 1):
					_on_cam_focus_requested()
				_tutorial_demo_view = -1










