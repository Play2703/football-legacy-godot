func _shootout_replay() -> void:
	if _replay != null and is_instance_valid(_replay):
		return
	if _cross == Vector3.ZERO:
		return
	var clip: ReplayRec.Clip = _rec.freeze("%d'" % match_minute)
	if clip == null:
		return
	var r: GoalReplay = GoalReplay.new()
	add_child(r)



	_audio_bajo_repeticion(r)



	var tapar: Array = [_ball, _actors, _sim_screen, _hud]
	if _fx != null:
		tapar.append_array(_fx.get_children())



	var red_p: Vector3 = _net_hit_p if _net_hit else Vector3.INF
	var tubo_p: Vector3 = _tube_hit_p if _tube_hit_p != Vector3.ZERO else Vector3.INF
	if not r.start_goal(clip, self, tapar, _cross, _stadium,
			float(maxi(_cross_i, 0)) * SIM_DT, red_p,
			tubo_p, _tube_hit_punch, _tube_hit_bar, _shootout_sub()):
		return






	await r.tree_exited





	if not is_inside_tree():
		await tree_entered









