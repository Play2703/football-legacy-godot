var _tag_allow_cache: Dictionary = {}
var _tag_allow_ms: int = -1
var _tag_allow_ball: Vector2 = Vector2(INF, INF)
const TAG_ALLOW_MS: int = 100
const TAG_ALLOW_BALL_M2: float = 1.5 * 1.5


func _drive_tag_allow() -> Dictionary:
	var ahora: int = Time.get_ticks_msec()
	if _tag_allow_ms >= 0 and ahora - _tag_allow_ms < TAG_ALLOW_MS \
			and _ball_field.distance_squared_to(_tag_allow_ball) < TAG_ALLOW_BALL_M2:
		return _tag_allow_cache
	_tag_allow_ms = ahora
	_tag_allow_ball = _ball_field
	var cand: Array = []
	for tag in _name_tags:
		var root = tag["root"]
		if not is_instance_valid(root):
			continue
		var owner_a = root.get_parent()
		if not is_instance_valid(owner_a):
			continue
		var p: Vector3 =(owner_a as Node3D).position
		cand.append({"id": root.get_instance_id(),
			"d": Vector2(p.x, p.z).distance_squared_to(_ball_field)})
	cand.sort_custom(func(a, b):
		if absf(float(a["d"]) - float(b["d"])) > 0.01:
			return float(a["d"]) < float(b["d"])
		return int(a["id"]) < int(b["id"]))
	var out: Dictionary = {}
	for i in mini(cand.size(), TAG_DRIVE_MAX):
		out[int(cand[i]["id"])] = true


	_tag_allow_cache = out
	return out




func _update_name_tags() -> void:
	if _name_tags.is_empty():
		return


























	if is_instance_valid(_hero_tag) \
			and (state == State.AIMING or state == State.STRIKING or _drive_active
				or (_hero_until_ms > 0 and Time.get_ticks_msec() >= _hero_until_ms)):
		_clear_hero_tag()
	var hero: bool = is_instance_valid(_hero_tag)





	var showing: bool =(hero or ((state == State.AIMING or state == State.STRIKING
		or _shootout_active or _corner_ced_live
		or not _entrants.is_empty() or _drive_active) \
				and not _drive_coast and not _trap_active)) and not _cesion_viva




















	var on_demand: bool =(state == State.AIMING or state == State.STRIKING) \
			and not _drive_active and not _shootout_active



	var allow: Dictionary = _drive_tag_allow() if _drive_active else {}






	var relevo_tags: Array = _relevo_tags()


	var servicio_tags: Array = _servicio_tags()
	if not servicio_tags.is_empty():
		showing = true
	var t: float = Time.get_ticks_msec() / 1000.0

	_medal_horneos = 0
	for tag in _name_tags:







		var root = tag["root"]
		if not is_instance_valid(root):
			continue










		var mine: bool = not on_demand \
				or (is_instance_valid(_tag_touched) and root.get_parent() == _tag_touched) \
				or (_switch_active and is_instance_valid(_switch_target)
				and root.get_parent() == _switch_target)
		if mine and not allow.is_empty():
			mine = allow.has(root.get_instance_id())
		if relevo_tags.has(root.get_parent()):
			mine = true
		if not servicio_tags.is_empty():
			mine = servicio_tags.has(root.get_parent())

		if hero:
			mine = root.get_parent() == _hero_tag
		root.visible = showing and mine
		if not (showing and mine):
			continue




		var pulse: float = 0.55 + 0.45 * sin(t * TAG_PULSE_SPEED + float(tag["phase"]))
		var cm: StandardMaterial3D = tag["chip_mat"]
		if cm != null:
			cm.albedo_color = Color(1.0, 1.0, 1.0, 0.8 + 0.2 * pulse)





		if tag.has("medal_mat"):
			var ovr_v: int = int(tag["ovr"])
			var mmat: StandardMaterial3D = tag["medal_mat"]
			var medal_n = tag["medal"]






			var fase: int = int(floor(t * _medal_vel(ovr_v) / TAU * MEDAL_FASES)) \
					% MEDAL_FASES
			if fase != int(tag.get("fase", 0)):
				var clave: int = ovr_v * 100 + fase
				if _medal_cache.has(clave) or _medal_horneos < MEDAL_HORNEOS_FRAME:
					if not _medal_cache.has(clave):
						_medal_horneos += 1
					mmat.albedo_texture = _make_ovr_medal_texture(ovr_v, fase)
					tag["fase"] = fase
			if ovr_v >= 86:
				var spark: float = pow(maxf(sin(t * 2.6 + float(tag["phase"])), 0.0), 6.0)
				mmat.albedo_color = Color(1.0 + spark * 0.9, 1.0 + spark * 0.9,
					1.0 + spark * 0.7, 1.0)
				if is_instance_valid(medal_n):
					(medal_n as MeshInstance3D).scale = Vector3.ONE *(1.0 + spark * 0.1)
			elif ovr_v >= 75:
				var gleam: float = 0.5 + 0.5 * sin(t * 1.1 + float(tag["phase"]))
				mmat.albedo_color = Color(1.0 + gleam * 0.25, 1.0 + gleam * 0.22,
					1.0 + gleam * 0.1, 1.0)
	if showing:
		_unstack_name_tags()


















const TAG_UNSTACK_STEP: float = 0.55
const TAG_UNSTACK_MAX: int = 3






const TAG_UNSTACK_HYST: float = 1.18




const TAG_UNSTACK_TAU: float = 0.12

func _unstack_name_tags() -> void:
	var cam: Camera3D = SceneFade.camara_de(self)
	if cam == null:
		return
	var vp: Vector2 = Vector2(SceneFade.rect_visible(self).size)









	var k_px: float =(vp.x if cam.keep_aspect == Camera3D.KEEP_WIDTH else vp.y) \
			/(2.0 * tan(deg_to_rad(cam.fov * 0.5)))
	var vis: Array = []
	for tag in _name_tags:
		var root = tag["root"]
		var chip = tag["chip"]
		if not is_instance_valid(root) or not root.visible \
				or not is_instance_valid(chip):
			continue








		var sc: float = maxf((root as Node3D).scale.y, 0.001)









		var lift_now: float =(chip as MeshInstance3D).position.y - float(tag["base_y"])
		var wp: Vector3 = chip.global_position - Vector3.UP *(lift_now * sc)
		if cam.is_position_behind(wp):
			continue
		var d: float = maxf(cam.global_position.distance_to(wp), 0.1)
		var sp: Vector2 = cam.unproject_position(wp)
		var half_w: float = float(tag["w"]) * sc * 0.5 / d * k_px





		if sp.x < half_w * 0.35 or sp.x > vp.x - half_w * 0.35:
			(chip as MeshInstance3D).visible = false
			tag["steps"] = 0
			tag["lift"] = 0.0
			(chip as MeshInstance3D).position.y = float(tag["base_y"])
			continue
		(chip as MeshInstance3D).visible = true







		vis.append({"tag": tag, "sp": sp, "hw": half_w, "d": d,
			"hh": float(tag["h"]) * sc * 0.5 / d * k_px,
			"step": TAG_UNSTACK_STEP * sc / d * k_px,
			"was": int(tag.get("steps", 0)), "steps": 0,
			"id": chip.get_instance_id()})






	vis.sort_custom(func(a, b):
		var da: float = float(a["d"])
		var db: float = float(b["d"])
		if absf(da - db) > minf(da, db) * 0.02:
			return da < db
		return int(a["id"]) < int(b["id"]))
	for i in vis.size():
		var lift_steps: int = 0
		for j in i:
			var dx: float = absf(float(vis[i]["sp"].x) - float(vis[j]["sp"].x))




			var y_j: float = float(vis[j]["sp"].y) \
					- float(vis[j]["step"]) * float(vis[j]["steps"])


			var hy: float = TAG_UNSTACK_HYST if vis[i]["was"] > 0 else 1.0






			while lift_steps < TAG_UNSTACK_MAX:
				var y_i: float = float(vis[i]["sp"].y) \
						- float(vis[i]["step"]) * float(lift_steps)
				if dx <(float(vis[i]["hw"]) + float(vis[j]["hw"])) * hy \
						and absf(y_i - y_j) <(float(vis[i]["hh"]) + float(vis[j]["hh"])) * hy:
					lift_steps += 1
				else:
					break
		vis[i]["steps"] = lift_steps
		var tag = vis[i]["tag"]
		tag["steps"] = lift_steps
		var want: float = float(lift_steps) * TAG_UNSTACK_STEP




		var k: float = 1.0 - exp(- get_process_delta_time() / TAG_UNSTACK_TAU)
		tag["lift"] = lerpf(float(tag["lift"]), want, clampf(k, 0.0, 1.0))
		var chip = tag["chip"]
		if is_instance_valid(chip):
			(chip as MeshInstance3D).position.y = float(tag["base_y"]) + float(tag["lift"])




