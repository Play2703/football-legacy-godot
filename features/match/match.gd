func _corner_cedido_centro(row: Dictionary) -> void:
	var pegada: float = 0.5 if row.is_empty() else Squad.norm(row, "pegada")
	var punteria: float = 0.5 if row.is_empty() else Squad.norm(row, "punteria")
	var rosca: float = 0.5 if row.is_empty() else Squad.norm(row, "rosca")
	var lado: float = 1.0 if _ball_field.x >= 0.0 else -1.0


	var cerrado: bool = randf() < clampf(0.42 +(rosca - pegada) * 0.85, 0.05, 0.88)
	var tenso: bool = not cerrado and randf() < clampf(0.3 + pegada * 0.55, 0.1, 0.9)
	var objetivo: AnimatedSprite3D = _corner_cedido_objetivo()
	var meta: Vector2 = Vector2(- lado * 1.6, 5.2) if objetivo == null \
			else Vector2(objetivo.position.x, objetivo.position.z)
























	var err: float = lerpf(CORNER_CED_ERR_BURDO, CORNER_CED_ERR_FINO, punteria)



	var desvio: Vector2 = Vector2(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)) \
			.normalized() * randf_range(0.0, err)
	meta += desvio





	meta.y = maxf(meta.y, CORNER_CED_Z_MIN)
	meta = _clamp_field(meta)





	var alt: float = 1.3 if tenso else randf_range(1.55, 1.95)
	var flat: Vector2 = meta - _ball_field
	var speed: float = lerpf(CORNER_CED_V.x, CORNER_CED_V.y,
		clampf((0.75 if tenso else 0.25) + pegada * 0.3, 0.0, 1.0))







	speed *= CORNER_CED_DRAG_K
	var t_fly: float = maxf(flat.length() / speed, 0.05)














	var vy: float = alt / t_fly + 0.5 * 9.8 * t_fly
	var dir3: Vector3 = Vector3(flat.x, 0.0, flat.y).normalized()




	var spin: float = 0.0
	if cerrado:
		spin = CORNER_CED_SPIN *(0.35 + 0.65 * rosca) * lado
		dir3 = dir3.rotated(Vector3.UP, _bend_comp(spin, speed, flat.length(), 1.0))





	await _cobro_carrerilla(dir3)
	if state == State.ENDED:
		_cedida_en_curso = false
		return
	var ahora: AnimatedSprite3D = _corner_cedido_objetivo()
	if ahora != null and objetivo != null and ahora == objetivo:


		var meta2: Vector2 = _clamp_field(
			Vector2(ahora.position.x, ahora.position.z) + desvio)
		flat = meta2 - _ball_field
		t_fly = maxf(flat.length() / speed, 0.05)
		vy = alt / t_fly + 0.5 * 9.8 * t_fly
		dir3 = Vector3(flat.x, 0.0, flat.y).normalized()
		if cerrado:
			dir3 = dir3.rotated(Vector3.UP,
				_bend_comp(spin, speed, flat.length(), 1.0))



	_shot_pending = false
	_corner_ced_live = true
	_cedida_en_curso = false
	_net_hit = false
	_impact_sfx = false
	_post_i = -1
	_post_ix = []
	_net_out_ix = -1
	_post_bar = false
	_post_out = false
	_bar_in_out = false
	_bar_bounce_p = Vector3.ZERO
	_post_out_p = Vector3.ZERO
	_bar_under = false
	_post_sfx = 0
	_graze_ix = []
	_graze_sfx = 0
	_simulate_flight(Vector3(_ball_field.x, 0.0, _ball_field.y),
		dir3 * speed + Vector3(0.0, vy, 0.0), spin)























	_cross_drop = {}



	_corner_ced_meta = _ball_field + flat


	_ball.flip_h = false
	_ball.play("roll", 1.0)
	state = State.FLIGHT
	_traj_i = 0
	_falta_cedida_vista = true




























const CEDIDA_LIBRE_WALL_H: float = 2.35
const CEDIDA_LIBRE_VY_K: float = 1.08
const CEDIDA_LIBRE_V_MIN: float = 15.0
const CEDIDA_LIBRE_V_MAX: float = 30.0






const CEDIDA_LIBRE_MURO_V: float = 26.0
const CEDIDA_LIBRE_P_MURO: float = 0.4
const CEDIDA_LIBRE_MURO_PARADO: float = 0.55


const CEDIDA_LIBRE_MURO_H: Vector2 = Vector2(0.95, 1.35)




































const LIBRE_ROSCADO_P_SPAN: float = 0.9




const LIBRE_MURO_H_FUERTE: float = 2.05
const LIBRE_MURO_H_FLOJO: float = 2.8
const LIBRE_SPIN_MAX: float = 1.15


const LIBRE_MARGEN_FINO: float = 0.34
const LIBRE_MARGEN_BURDO: float = 1.3


func _cedida_libre_tiro(want_goal: bool, side: float,
		ficha: Dictionary = {}) -> Dictionary:


	var pegada: float = 0.5 if ficha.is_empty() else Squad.norm(ficha, "pegada")
	var punteria: float = 0.5 if ficha.is_empty() else Squad.norm(ficha, "punteria")
	var rosca: float = 0.5 if ficha.is_empty() else Squad.norm(ficha, "rosca")
	var roscado: bool = randf() < clampf(
		0.5 +(rosca - pegada) * LIBRE_ROSCADO_P_SPAN, 0.08, 0.92)
	var target: Vector3
	if want_goal:


		var margen: float = lerpf(LIBRE_MARGEN_BURDO, LIBRE_MARGEN_FINO, punteria)
		var alto: Vector2 = Vector2(1.72, 2.04) if roscado else Vector2(1.82, 2.14)
		target = Vector3(side * maxf(GOAL_HALF_W - margen - randf_range(0.0, 0.18), 0.2),
			randf_range(alto.x, alto.y), 0.0)
		return _libre_paquete(target, pegada, roscado, rosca, side)















	var parado: float = 0.5 if ficha.is_empty() else Squad.norm(ficha, "parado")
	var muerto: float = lerpf(0.54, 0.24, rosca)
	var r0: float = randf()
	if r0 < muerto:
		if r0 < _cedida_libre_p_muro(parado):
			var al_muro: Dictionary = _libre_al_muro()
			if not al_muro.is_empty():
				return al_muro
		return _libre_paquete(_libre_esquina_destino(side), pegada, false, rosca, side)
	var v_k: float = pegada


	var r: float = randf()
	var cerca: float = lerpf(0.42, 0.86, punteria)
	if r < cerca * 0.76:
		target = _libre_esquina_destino(side)
	elif r < cerca:
		target = Vector3(side *(GOAL_HALF_W - 0.03), randf_range(1.3, 1.9), 0.0)
	elif r < cerca +(1.0 - cerca) * 0.55:

		target = Vector3(side * randf_range(1.9, 3.4),
			CROSSBAR_H + randf_range(0.3, 0.9), 0.0)
	else:
		target = Vector3(side *(GOAL_HALF_W + randf_range(0.5, 1.4)),
			randf_range(1.0, 1.8), 0.0)





	return _libre_paquete(target, v_k, false, rosca, side)







func _libre_paquete(target: Vector3, pegada: float, roscado: bool, rosca: float,
		side: float) -> Dictionary:





	var v: float = _cedida_libre_speed(target, lerpf(LIBRE_MURO_H_FLOJO,
		LIBRE_MURO_H_FUERTE, clampf(maxf(pegada, rosca), 0.0, 1.0)))





	var spin: float = 0.0
	if roscado:
		spin = LIBRE_SPIN_MAX *(0.3 + 0.7 * rosca) * side
	return {"target": target, "speed": v, "spin": spin}





func _cedida_libre_p_muro(parado: float) -> float:
	return CEDIDA_LIBRE_P_MURO * clampf((CEDIDA_LIBRE_MURO_PARADO - parado)
		/ CEDIDA_LIBRE_MURO_PARADO, 0.0, 1.0)




func _es_barrera(i: int) -> bool:
	return i >= 0 and i < _rival_actors.size() and is_instance_valid(_rival_actors[i]) \
			and _rival_actors[i].has_meta("hold_wall")









func _libre_al_muro() -> Dictionary:
	var hombres: Array[Vector2] = []
	for i in _defender_pos.size():
		if _es_barrera(i) and _defender_pos[i].y < _ball_field.y - 1.0:
			hombres.append(_defender_pos[i])
	if hombres.is_empty():
		return {}
	var w: Vector2 = hombres[randi() % hombres.size()]
	var s: float = _ball_field.y / maxf(_ball_field.y - w.y, 0.01)
	var tx: float = _ball_field.x +(w.x - _ball_field.x) * s
	var v: float = CEDIDA_LIBRE_MURO_V
	var t_w: float = maxf((w - _ball_field).length() / v, 0.01)
	var t_fly: float = maxf(Vector2(tx - _ball_field.x, - _ball_field.y).length() / v, 0.05)
	var h: float = randf_range(CEDIDA_LIBRE_MURO_H.x, CEDIDA_LIBRE_MURO_H.y)
	var vy: float =(h + 4.9 * t_w * t_w) / t_w
	var ty: float =(vy / CEDIDA_LIBRE_VY_K - 4.9 * t_fly) * t_fly
	return {"target": Vector3(tx, ty, 0.0), "speed": v, "spin": 0.0, "muro": true}








const LIBRE_ESQUINA_PALO: Vector2 = Vector2(0.45, 1.5)
const LIBRE_ESQUINA_ALTO: Vector2 = Vector2(0.45, 2.05)


func _libre_esquina_destino(side: float) -> Vector3:
	return Vector3(side *(GOAL_HALF_W - randf_range(LIBRE_ESQUINA_PALO.x,
		LIBRE_ESQUINA_PALO.y)), randf_range(LIBRE_ESQUINA_ALTO.x, LIBRE_ESQUINA_ALTO.y), 0.0)



























const PENAL_MARGEN_FINO: float = 0.28
const PENAL_MARGEN_BURDO: float = 1.55
const PENAL_ALTO_ANGULO: Vector2 = Vector2(1.72, 2.02)
const PENAL_ALTO_RASO: Vector2 = Vector2(0.2, 0.42)
const PENAL_ALTO_MEDIO: Vector2 = Vector2(0.95, 1.35)
const PENAL_RASO_P: float = 0.45
const PENAL_V_FLOJO: float = 15.5
const PENAL_V_FUERTE: float = 23.0


func _cedida_penal_tiro(want_goal: bool, side: float,
		ficha: Dictionary = {}) -> Dictionary:

	var penal: float = 0.5 if ficha.is_empty() else Squad.norm(ficha, "penal")
	var pegada: float = 0.5 if ficha.is_empty() else Squad.norm(ficha, "pegada")
	var rosca: float = 0.5 if ficha.is_empty() else Squad.norm(ficha, "rosca")
	var v: float = lerpf(PENAL_V_FLOJO, PENAL_V_FUERTE, pegada)
	if want_goal:
		var margen: float = lerpf(PENAL_MARGEN_BURDO, PENAL_MARGEN_FINO, penal)




		var rincon: Vector2 = PENAL_ALTO_RASO if randf() < PENAL_RASO_P \
				else PENAL_ALTO_ANGULO
		var alto: float = lerpf(randf_range(PENAL_ALTO_MEDIO.x, PENAL_ALTO_MEDIO.y),
			randf_range(rincon.x, rincon.y), penal)
		var spin: float = 0.0
		if randf() < PENAL_COMBA_P * rosca:
			spin = PENAL_SPIN_MAX *(0.25 + 0.75 * rosca) * side
		return {
			"target": Vector3(
				side * maxf(GOAL_HALF_W - margen - randf_range(0.0, 0.12), 0.15),
				alto, 0.0),
			"speed": v, "spin": spin}


	var target: Vector3
	var r: float = randf()
	var cerca: float = lerpf(0.38, 0.88, penal)
	if r < cerca * 0.78:










		var mano_x: float = side * randf_range(0.15, 0.9)
		if not is_nan(_pen_guess_x):
			mano_x = clampf(_pen_guess_x + randf_range(-0.3, 0.3),
				-(GOAL_HALF_W - 0.25), GOAL_HALF_W - 0.25)
		target = Vector3(mano_x, randf_range(0.7, 1.35), 0.0)
	elif r < cerca:




		target = Vector3(side *(GOAL_HALF_W + randf_range(-0.02, 0.05)),
			randf_range(0.8, 1.7), 0.0)
	elif r < cerca +(1.0 - cerca) * 0.5:
		target = Vector3(side * randf_range(0.4, 1.6),
			CROSSBAR_H + randf_range(-0.04, 0.9), 0.0)
	else:
		target = Vector3(side *(GOAL_HALF_W + randf_range(0.4, 1.2)),
			randf_range(0.9, 1.8), 0.0)
	return {"target": target, "speed": v, "spin": 0.0}


func _cedida_libre_speed(target: Vector3, h: float = CEDIDA_LIBRE_WALL_H) -> float:
	var d: float = Vector2(target.x - _ball_field.x, - _ball_field.y).length()
	var w: float = ScenarioStore.WALL_DIST
	var num: float = 4.9 * w * maxf(CEDIDA_LIBRE_VY_K * d - w, 1.0)
	var den: float = maxf(h - CEDIDA_LIBRE_VY_K * target.y * w / maxf(d, 0.01), 0.15)
	return clampf(sqrt(num / den), CEDIDA_LIBRE_V_MIN, CEDIDA_LIBRE_V_MAX)

















const COBRO_FALLO_INTENTOS: int = 8




func _cobro_vuela(tiro: Dictionary, want_goal: bool, side: float, ficha: Dictionary,
		libre: bool) -> Dictionary:
	for _intento in COBRO_FALLO_INTENTOS:
		_cobro_simula(tiro, libre)
		if want_goal or not (_outcome in ["goal", "own_goal"]):
			return tiro
		tiro = _cedida_libre_tiro(false, side, ficha) if libre \
				else _cedida_penal_tiro(false, side, ficha)


	var fuera: Vector3 = Vector3(side *(GOAL_HALF_W + 0.9), 1.3, 0.0)
	tiro = {"target": fuera, "spin": 0.0,
		"speed": _cedida_libre_speed(fuera) if libre else float(tiro["speed"])}
	_cobro_simula(tiro, libre)
	return tiro






func _cobro_simula(tiro: Dictionary, libre: bool) -> void:
	var target: Vector3 = tiro["target"]
	var speed: float = float(tiro["speed"])
	var flat: Vector2 = Vector2(target.x - _ball_field.x, - _ball_field.y)
	var t_fly: float = maxf(flat.length() / speed, 0.05)
	var vy: float =(target.y / t_fly + 0.5 * 9.8 * t_fly) * 1.08
	var dir3: Vector3 = Vector3(flat.x, 0.0, flat.y).normalized()
	var spin: float = float(tiro.get("spin", 0.0))
	if not is_zero_approx(spin):
		dir3 = dir3.rotated(Vector3.UP, _bend_comp(spin, speed, flat.length(), 1.0))
	_shot_pace = clampf((speed - 10.0) / 18.0, 0.0, 1.0)
	_power_ratio = _shot_pace
	var libre_npc: int = LibreNpc.NO
	if libre:
		libre_npc = LibreNpc.MURO if bool(tiro.get("muro", false)) else LibreNpc.LIMPIO
	_simulate_flight(Vector3(_ball_field.x, 0.0, _ball_field.y),
		dir3 * speed + Vector3(0.0, vy, 0.0), spin, 0.0, false, libre_npc)




















