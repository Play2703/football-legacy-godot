			var cara: Dictionary = Coach.look_de(semilla)
			var pares_p: Array = []
			for a in grupo[1]:
				for ruta in a[3]:
					pares_p.append([ruta, cara, false])
			trabajo.append({"key": "", "pares": pares_p, "personal": true})
	return trabajo




const PARQUE_PRINCIPAL_US: int = 100000



func porteros_en_hilo(trabajo: Array) -> int:
	var hechos: int = 0
	var t0: int = Time.get_ticks_usec()
	var gpu0: int = KitRecolor.lecturas_gpu_en_hilo
	for tarea in trabajo:
		if hilo_cancela:
			break
		var look: Dictionary = tarea.get("look", {})

		if look.is_empty() and hilo_solo_porteros:
			break
		for par in tarea["pares"]:
			if hilo_cancela or (look.is_empty() and hilo_solo_porteros):
				break










			var parque_hasta: int = Time.get_ticks_usec() + PARQUE_PRINCIPAL_US
			while not hilo_cancela and Time.get_ticks_usec() < KitRecolor.principal_pide_hasta_us \
					and Time.get_ticks_usec() < parque_hasta:
				OS.delay_usec(200)
			if hilo_cancela:
				break





			var ruta_par: String = String(par[0])
			var fuente: Texture2D =(load(ruta_par) as Texture2D) \
					if ResourceLoader.exists(ruta_par) else null
			if fuente == null:
				continue


			KitRecolor.pon_imagen_en_meta(bool(par[2]) if look.is_empty()
				else _keeper_par_al_atlas(ruta_par))
			KitRecolor.apply_recordando(fuente, par[1])
			KitRecolor.pon_imagen_en_meta(false)
			hilo_unidades += 1
		if hilo_cancela or look.is_empty():
			continue


		var armado: SpriteFrames = _build_keeper_frames(look)


		_atlas_revisa(armado, true)
		hilo_frames[String(tarea["key"])] = armado
		hechos += 1


	if not SceneFade.telon_precalentando():
		KitRecolor.olvida_analisis()
	hilo_us = int(Time.get_ticks_usec() - t0)
	hilo_lecturas_gpu = KitRecolor.lecturas_gpu_en_hilo - gpu0
	return hechos








