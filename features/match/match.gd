func _pique_acto(culpable: AnimatedSprite3D) -> String:
	var yo: AnimatedSprite3D = _self_actor
	var quien: String = _pique_nombre(culpable)
	if not is_instance_valid(yo) or not is_instance_valid(culpable) or quien.is_empty():
		_pique_sin_acto()
		return ""
	_pique_quien = quien

	var f: Vector2 = _duel_facing
	if f.length_squared() < 0.0001:
		f = Vector2(0.0, -1.0)
	f = f.normalized()
	var p_yo: Vector2 = Vector2(yo.position.x, yo.position.z)
	var p_el: Vector2 = p_yo - f * PIQUE_PATADA_DIST


	var ahora: int = Time.get_ticks_msec()
	for a in [yo, culpable]:
		_run_target.erase(a)
		_anim_lock[a] = ahora + PIQUE_LOCK_MS
		(a as AnimatedSprite3D).speed_scale = 0.0
	culpable.position = Vector3(p_el.x, culpable.position.y, p_el.y)



	var juego: Camera3D = SceneFade.camara_de(self)
	var lado: Vector2 = Vector2(- f.y, f.x)
	var mid: Vector2 =(p_yo + p_el) * 0.5
	if juego != null and (Vector2(juego.global_position.x, juego.global_position.z)
			- mid).dot(lado) < 0.0:
		lado = - lado
	_pique_encuadra(mid + f * PIQUE_ADELANTE_M, lado, PIQUE_ANCHO_M)
	var der: Vector3 = _pique_cam.global_transform.basis.x
	var hacia: String = "east" if f.x * der.x + f.y * der.z > 0.0 else "west"
	var vuelta: String = "west" if hacia == "east" else "east"
	var a_patada: String = "pelea_patada_" + hacia
	var a_recibe: String = "pelea_recibe_" + hacia
	var listo: bool = await _pique_arma([[culpable, a_patada], [yo, a_recibe]])
	if not _pique_vivo(yo, culpable):
		return ""
	if not listo:
		for a in [yo, culpable]:
			_anim_lock.erase(a)
			(a as AnimatedSprite3D).speed_scale = 1.0
		_pique_sin_acto()
		return ""
	var estado: Dictionary = _pique_monta(juego, [yo, culpable], mid)

	yo.flip_h = false
	culpable.flip_h = false
	yo.play(a_recibe)
	yo.frame = 0
	yo.speed_scale = 0.0
	culpable.play(a_patada)
	culpable.speed_scale = 1.0
	await _shoot_wait(PIQUE_PATADA_GOLPE)
	if not _pique_vivo(yo, culpable):
		return ""


	yo.speed_scale = 1.0
	_audio.dolor(true)
	_audio.voz_tras("protesta", 0.5)
	_ref_pita()
	_haptic(50)


	_say("pique_patada", 0.3, {"picado": quien})


	var t0: int = Time.get_ticks_msec()
	await _pique_arma([[yo, "pelea_encara_" + vuelta],
		[culpable, "pelea_encara_" + hacia], [culpable, "pelea_dedo_" + hacia]])
	var resta: float = PIQUE_CAIDA_S - float(Time.get_ticks_msec() - t0) / 1000.0
	if resta > 0.0:
		await _shoot_wait(resta)
	if not _pique_vivo(yo, culpable):
		_pique_recoge(estado, yo, culpable)
		return ""


	var p_el2: Vector2 = p_yo - f * PIQUE_DEDO_DIST
	culpable.position = Vector3(p_el2.x, culpable.position.y, p_el2.y)
	_pique_pose(yo, vuelta)
	_pique_pose(culpable, hacia)
	_pique_encuadra((p_yo + p_el2) * 0.5, lado, PIQUE_CAREO_ANCHO_M)


	await _shoot_wait(PIQUE_PIDE_S)
	if not _pique_vivo(yo, culpable):
		_pique_recoge(estado, yo, culpable)
		return ""
	var elijo: String = _pique_eleccion_forzada
	if elijo.is_empty():
		_hud.ask_choice(Competitions.accent_of(GameState.current_fixture()),
			Pique.CALMA, I18n.t("CALMA"), Pique.ENCARA, I18n.t("ENCÁRATE"),
			I18n.tf("{0} TE BUSCA", [CareerTheme.caps(quien)]))
		elijo = String(await _hud.choice_made)
		_hud.clear_coin_panel()
	if not _pique_vivo(yo, culpable):
		_pique_recoge(estado, yo, culpable)
		return ""
	if elijo == Pique.ENCARA:


		var p_el3: Vector2 = p_yo - f * PIQUE_CAREO_DIST
		create_tween().tween_property(culpable, "position",
			Vector3(p_el3.x, culpable.position.y, p_el3.y), PIQUE_ACERCA_S)
		_pique_juega(yo, "pelea_encara_" + vuelta, vuelta)
		_say("pique_encara", 0.0, {"picado": quien})

		_audio.roar(-10.0, 0.45)
		_stadium.crowd_excite(0.9)
		_momentum.register("pique_encara")
		_push_momentum()
		_pique_fase = "encarado"
		_pique_coach = GestoMister.EV_PIQUE_ENCARA
		await _shoot_wait(PIQUE_DESFASE_S)
		if is_instance_valid(culpable):
			_pique_juega(culpable, "pelea_encara_" + hacia, hacia)



		var dado_corro: float = _pique_tangana_dado_forzado \
				if _pique_tangana_dado_forzado >= 0.0 else randf()
		if Pique.tangana(_is_derby, elijo, dado_corro):
			var t1: int = Time.get_ticks_msec()
			var corro: Dictionary = _pique_corro(estado, yo, culpable,(p_yo + p_el3) * 0.5)
			await _pique_arma(_pique_corro_gestos(yo, culpable, corro, hacia, vuelta))
			var queda: float = PIQUE_CAREO_S - float(Time.get_ticks_msec() - t1) / 1000.0
			if queda > 0.0:
				await _shoot_wait(queda)
			if _pique_vivo(yo, culpable):
				await _pique_tangana(estado, yo, culpable, corro, f, lado, hacia, vuelta)
		else:
			await _shoot_wait(PIQUE_CAREO_S)
	else:



		elijo = Pique.CALMA
		_pique_juega(culpable, "pelea_dedo_" + hacia, hacia)
		_say("pique_calma", 0.0, {"picado": quien})
		_momentum.register("pique_calma")
		_push_momentum()
		_bump_rating("pique_calma")
		_pique_fase = "calma"
		_pique_calor[quien] = 0
		_pique_coach = GestoMister.EV_PIQUE_CALMA
		await _shoot_wait(PIQUE_DEDO_S)
		if _pique_vivo(yo, culpable):
			var camina: String = "walk_" + hacia
			if _gesto_listo(yo, camina):
				yo.flip_h = false
				yo.play(camina)
				yo.speed_scale = 1.0
			var p_va: Vector2 = p_yo + f * PIQUE_ALEJA_M
			create_tween().tween_property(yo, "position",
				Vector3(p_va.x, yo.position.y, p_va.y), PIQUE_ALEJA_S)
			_pique_pose(culpable, hacia)
			await _shoot_wait(PIQUE_ALEJA_S)
	_pique_recoge(estado, yo, culpable)
	return elijo




func _pique_arma(pares: Array) -> bool:
	for _i in PIQUE_ARMA_FRAMES:
		var listos: bool = true
		for par in pares:
			_ondemand_deadline_us = Time.get_ticks_usec() + PIQUE_ARMA_US
			if not _gesto_listo(par[0], String(par[1])):
				listos = false
		if listos:
			return true
		await get_tree().process_frame
		if not is_inside_tree():
			return false
	return false



func _pique_vivo(yo: Variant, el: Variant) -> bool:
	return is_inside_tree() and state == State.DUEL and is_instance_valid(yo) \
			and is_instance_valid(el)




func _pique_pose(a: AnimatedSprite3D, lado: String) -> void:
	if not is_instance_valid(a):
		return
	a.flip_h = false
	var anim: StringName = IDLE_ANIM.get(lado, &"idle")
	if a.sprite_frames != null and a.sprite_frames.has_animation(anim):
		a.play(anim)
	a.speed_scale = 1.0




func _pique_juega(a: AnimatedSprite3D, anim: String, lado: String) -> void:
	if not is_instance_valid(a):
		return
	if _gesto_listo(a, anim):
		a.flip_h = false
		a.play(anim)
		a.speed_scale = 1.0
	else:
		_pique_pose(a, lado)



func _pique_sin_acto() -> void:
	_play_fall_gesture()
	_audio.dolor(true)
	_audio.voz_tras("protesta", 0.5)
	_ref_pita()




func _pique_encuadra(centro: Vector2, lado: Vector2, ancho: float) -> void:
	if _pique_cam == null:
		_pique_cam = Camera3D.new()
		add_child(_pique_cam)
	_pique_cam.fov = PIQUE_FOV
	var vp: Vector2 = SceneFade.rect_visible(self).size
	var aspecto: float = vp.x / maxf(vp.y, 1.0)
	var tan_v: float = tan(deg_to_rad(PIQUE_FOV * 0.5))
	var d: float = maxf(ancho /(2.0 * tan_v * aspecto), PIQUE_ALTO_M /(2.0 * tan_v))
	var pos: Vector2 = centro + lado * d
	_pique_cam.position = Vector3(pos.x, PIQUE_CAM_Y, pos.y)
	_pique_cam.look_at(Vector3(centro.x, PIQUE_MIRA_Y, centro.y))








func _pique_monta(juego: Camera3D, pareja: Array, centro: Vector2) -> Dictionary:
	var estado: Dictionary = {"juego": juego, "chip": _hud.hide_player_chip(true),
		"ball": _ball.visible, "ocultos": [],
		"flip_yo": _self_actor.flip_h if is_instance_valid(_self_actor) else false}
	_ball.visible = false
	_hud.show_hint("")
	_pique_aparta(estado, centro, PIQUE_CORRO_M, pareja)
	_pique_cam.current = true
	_cam_base_frame = -1
	return estado




func _pique_aparta(estado: Dictionary, centro: Vector2, radio: float, fuera: Array) -> void:
	var cam: Vector2 = Vector2(_pique_cam.position.x, _pique_cam.position.z)
	var candidatos: Array = _todos_actores().duplicate()
	for extra in [_keeper, _ref_center]:
		if is_instance_valid(extra):
			candidatos.append(extra)
	for a in candidatos:
		if not is_instance_valid(a) or a in fuera or not (a as Node3D).visible:
			continue
		var p: Vector2 = Vector2((a as Node3D).position.x,(a as Node3D).position.z)
		if p.distance_to(centro) < radio or Geometry2D \
				.get_closest_point_to_segment(p, cam, centro).distance_to(p) < PIQUE_TAPA_M:
			(a as Node3D).visible = false
			_pecho_visible(a, false)
			(estado["ocultos"] as Array).append(a)







func _pique_recoge(estado: Dictionary, yo: Variant, el: Variant) -> void:
	if _pique_cam != null:
		_pique_cam.current = false
	var juego: Camera3D = SceneFade.vivo(estado.get("juego")) as Camera3D
	if is_instance_valid(juego):
		juego.current = true
	else:
		_aim_cam.current = true
	_cam_base_frame = -1
	for a in Array(estado.get("ocultos", [])):
		if is_instance_valid(a):
			(a as Node3D).visible = true
			_pecho_visible(a, true)
	_ball.visible = bool(estado.get("ball", true))
	_hud.hide_player_chip(not bool(estado.get("chip", false)))
	for a in [yo, el]:
		if is_instance_valid(a):
			_anim_lock.erase(a)
			(a as AnimatedSprite3D).speed_scale = 1.0
	if is_instance_valid(el):
		_face_ball(el)
	if is_instance_valid(yo):
		yo.flip_h = bool(estado.get("flip_yo", false))
		if yo.sprite_frames != null and yo.sprite_frames.has_animation("idle"):
			yo.play("idle")










func _pique_corro(estado: Dictionary, yo: AnimatedSprite3D, el: AnimatedSprite3D,
		centro: Vector2) -> Dictionary:
	return {"tuyos": _pique_cercanos(_teammate_actors, yo, centro, estado),
		"suyos": _pique_cercanos(_rival_actors, el, centro, estado)}


func _pique_cercanos(lista: Array, fuera: AnimatedSprite3D, centro: Vector2,
		estado: Dictionary) -> Array:
	var ocultos: Array = estado.get("ocultos", [])
	var hay: Array = []
	var lejos: Array = []
	for a in lista:
		if not is_instance_valid(a) or a == fuera or a == _self_actor or a == _keeper:
			continue
		if (a as Node3D).visible or a in ocultos:
			hay.append(a)
		else:
			lejos.append(a)
	var cerca := func(x: Node3D, y: Node3D) -> bool:
		return Vector2(x.position.x, x.position.z).distance_squared_to(centro) \
				< Vector2(y.position.x, y.position.z).distance_squared_to(centro)
	hay.sort_custom(cerca)
	lejos.sort_custom(cerca)
	return (hay + lejos).slice(0, Pique.TANGANA_POR_LADO)




func _pique_corro_gestos(yo: AnimatedSprite3D, el: AnimatedSprite3D, corro: Dictionary,
		hacia: String, vuelta: String) -> Array:
	var pares: Array = [[el, "pelea_empuja_" + hacia], [yo, "pelea_empujado_" + vuelta]]
	var tuyos: Array = corro["tuyos"]
	var suyos: Array = corro["suyos"]
	if tuyos.size() > 0 and suyos.size() > 0:
		pares += [[tuyos[0], "pelea_empuja_" + vuelta], [suyos[0], "pelea_empujado_" + hacia]]
	if tuyos.size() > 1 and suyos.size() > 1:
		pares += [[tuyos[1], "pelea_dedo_" + vuelta], [suyos[1], "pelea_encara_" + hacia]]
	return pares













func _pique_tangana(estado: Dictionary, yo: AnimatedSprite3D, el: AnimatedSprite3D,
		corro: Dictionary, f: Vector2, lado: Vector2, hacia: String, vuelta: String) -> void:
	var tuyos: Array = corro["tuyos"]
	var suyos: Array = corro["suyos"]
	var ref: AnimatedSprite3D = _ref_center if is_instance_valid(_ref_center) else null

	var usados: Array = []
	if tuyos.size() > 0 and suyos.size() > 0:
		usados += [tuyos[0], suyos[0]]
	if tuyos.size() > 1 and suyos.size() > 1:
		usados += [tuyos[1], suyos[1]]
	var guardados: Array = []
	var ahora: int = Time.get_ticks_msec()
	_pique_tangana_hubo = true
	_pique_corro_tuyo = []
	for a in usados:
		guardados.append({"a": a, "pos": a.position, "vis": a.visible, "flip": a.flip_h,
			"anim": a.animation, "lock": _anim_lock.get(a, -1),
			"corre": _run_target.has(a), "run": _run_target.get(a)})
		_run_target.erase(a)
		_anim_lock[a] = ahora + PIQUE_LOCK_MS
		a.visible = true
		_pecho_visible(a, true)
		if a in tuyos and not _pique_nombre(a).is_empty():
			_pique_corro_tuyo.append(_pique_nombre(a))


	var c: Vector2 =(Vector2(yo.position.x, yo.position.z)
		+ Vector2(el.position.x, el.position.z)) * 0.5
	_pique_en(el, c, f, lado, - PIQUE_EMPUJE_DIST * 0.5, 0.0)
	_pique_en(yo, c, f, lado, PIQUE_EMPUJE_DIST * 0.5, 0.0)

	var el_fin: float = - PIQUE_EMPUJE_DIST * 0.5 - PIQUE_SEPARA_M
	var yo_fin: float = PIQUE_EMPUJE_DIST * 0.5 + PIQUE_EMPUJE_RETRO_M + PIQUE_SEPARA_M
	if usados.size() >= 2:
		var t1: float = el_fin - PIQUE_CORRO_HOLGURA_M
		_pique_en(usados[0], c, f, lado, t1, - PIQUE_CORRO_FONDO_M)
		_pique_en(usados[1], c, f, lado, t1 - PIQUE_EMPUJE_DIST, - PIQUE_CORRO_FONDO_M)
		_pique_pose(usados[0], vuelta)
		_pique_pose(usados[1], hacia)
	if usados.size() >= 4:
		var r2: float = yo_fin + PIQUE_CORRO_HOLGURA_M
		_pique_en(usados[2], c, f, lado, r2 + PIQUE_DEDO_DIST, - PIQUE_CORRO_FONDO_M)
		_pique_en(usados[3], c, f, lado, r2, - PIQUE_CORRO_FONDO_M)
		_pique_juega(usados[2], "pelea_dedo_" + vuelta, vuelta)
		_pique_juega(usados[3], "pelea_encara_" + hacia, hacia)
	if ref != null:


		_anim_lock[ref] = ahora + PIQUE_LOCK_MS
		_ref_vel.erase(ref)
		ref.visible = true
		_pique_en(ref, c, f, lado, PIQUE_ARBITRO_DESDE_M, PIQUE_ARBITRO_DELANTE_M)
	var mira: Vector2 = c + f * PIQUE_TANGANA_DESVIO_M
	_pique_encuadra(mira, lado, PIQUE_TANGANA_ANCHO_M)
	_pique_aparta(estado, mira, PIQUE_TANGANA_ANCHO_M * 0.5, [yo, el, ref] + usados)
	_say("pique_tangana", 0.0, {"picado": _pique_quien})
	_audio.roar(-8.0, 0.6)
	_stadium.crowd_excite(1.0)
	_audio.voz_tras("protesta", 0.2)
	_momentum.register("pique_tangana")
	_push_momentum()

	_pique_empujon(el, yo, hacia, vuelta, f)
	await _shoot_wait(PIQUE_CORRO_DESFASE_S)
	if not _pique_vivo(yo, el):
		_pique_devuelve(guardados)
		return
	_haptic(30)

	if usados.size() >= 2:
		_pique_empujon(usados[0], usados[1], vuelta, hacia, - f)
	await _shoot_wait(PIQUE_ARBITRO_LLEGA_S)
	if not _pique_vivo(yo, el):
		_pique_devuelve(guardados)
		return

	if ref != null and is_instance_valid(ref):
		var corre: String = "run_" + vuelta
		if _gesto_listo(ref, corre):
			ref.flip_h = false
			ref.play(corre)
			ref.speed_scale = 1.0
		var meta: Vector2 = c + lado * PIQUE_ARBITRO_DELANTE_M
		create_tween().tween_property(ref, "position",
			Vector3(meta.x, ref.position.y, meta.y), PIQUE_ARBITRO_CORRE_S)
		await _shoot_wait(PIQUE_ARBITRO_CORRE_S)
		if not _pique_vivo(yo, el):
			_pique_devuelve(guardados)
			return
	_ref_pita()


	if ref != null and is_instance_valid(ref):
		_anim_lock[ref] = Time.get_ticks_msec() + PIQUE_LOCK_MS

	for par in [[yo, f, vuelta], [el, - f, hacia]]:
		var a: AnimatedSprite3D = par[0]
		var p: Vector3 = a.position
		var atras: Vector2 = par[1]
		create_tween().tween_property(a, "position", p + Vector3(atras.x, 0.0, atras.y)
			* PIQUE_SEPARA_M, PIQUE_ARBITRO_CORRE_S)
		_pique_pose(a, String(par[2]))
	for i in usados.size():
		_pique_pose(usados[i], vuelta if i % 2 == 0 else hacia)
	await _shoot_wait(PIQUE_SEPARA_S)
	_pique_devuelve(guardados)
	if ref != null and is_instance_valid(ref):
		_anim_lock.erase(ref)




func _pique_en(a: AnimatedSprite3D, c: Vector2, f: Vector2, lado: Vector2, s: float,
		d: float) -> void:
	var p: Vector2 = c + f * s + lado * d
	a.position = Vector3(p.x, a.position.y, p.y)





func _pique_empujon(da: AnimatedSprite3D, recibe: AnimatedSprite3D, dir_da: String,
		dir_recibe: String, atras: Vector2) -> void:
	_pique_juega(da, "pelea_empuja_" + dir_da, dir_da)
	var anim: String = "pelea_empujado_" + dir_recibe
	var listo: bool = _gesto_listo(recibe, anim)
	if listo:
		recibe.flip_h = false
		recibe.play(anim)
		recibe.frame = 0
		recibe.speed_scale = 0.0
	await _shoot_wait(PIQUE_EMPUJE_GOLPE)
	if not is_instance_valid(recibe) or not is_inside_tree():
		return
	if listo:
		recibe.speed_scale = 1.0
	var p: Vector3 = recibe.position
	create_tween().tween_property(recibe, "position", p + Vector3(atras.x, 0.0, atras.y)
		* PIQUE_EMPUJE_RETRO_M, PIQUE_EMPUJE_RETRO_S)




func _pique_devuelve(guardados: Array) -> void:
	for g in guardados:
		var a: AnimatedSprite3D = g["a"]
		if not is_instance_valid(a):
			continue
		a.position = g["pos"]
		a.visible = bool(g["vis"])
		_pecho_visible(a, a.visible)
		a.flip_h = bool(g["flip"])
		a.speed_scale = 1.0
		if a.sprite_frames != null and a.sprite_frames.has_animation(g["anim"]):
			a.play(g["anim"])
		if int(g["lock"]) >= 0:
			_anim_lock[a] = int(g["lock"])
		else:
			_anim_lock.erase(a)
		if bool(g["corre"]):
			_run_target[a] = g["run"]










func _pique_tarjetas(culpable: AnimatedSprite3D, eleccion: String) -> float:
	if eleccion.is_empty():
		return _ref_amonesta(true, culpable)
	var gen0: int = _ref_yellow_gen
	var fuera0: bool = _ref_sent_off
	var beat: float = _ref_amonesta(true, culpable,
		eleccion == Pique.CALMA or _pique_tangana_hubo)


	var suyas: int = 0
	if _ref_yellow_gen != gen0:
		suyas = 2 if _ref_sent_off and not fuera0 else 1
	_pique_amarilla_el = _pique_amarilla_el or suyas > 0
	var dado: float = _pique_mi_dado_forzado if _pique_mi_dado_forzado >= 0.0 else randf()
	if not is_instance_valid(_ref_center):
		return beat
	var mia: bool = Pique.mi_amarilla(eleccion, Arbitros.factor_tarjeta(_arbitro_hoy()), dado)
	_pique_amarilla_tuyo = "" if not _pique_tangana_hubo \
			else Pique.amarilla_de_los_tuyos(mia, _pique_corro_tuyo)
	if not mia and _pique_amarilla_tuyo.is_empty():
		return beat



	var t: float = REF_YELLOW_DELAY_S + REF_RED_DELAY_S * float(suyas)
	if mia:
		SceneFade.timer(t, false).timeout.connect(
			_pique_mi_tarjeta_now.bind(_ref_yellow_gen))
	else:
		SceneFade.timer(t, false).timeout.connect(
			_pique_tarjeta_tuyo_now.bind(_ref_yellow_gen, _pique_amarilla_tuyo))
	return maxf(beat, t + DUEL_FOUL_BEAT_CARD - REF_YELLOW_DELAY_S)




