static func _servicio_angulo_tiro(p: Vector2) -> float:
	return absf((Vector2(-3.66, 0.0) - p).angle_to(Vector2(3.66, 0.0) - p))




static func _servicio_pase_absurdo(srv: Vector2, ball: Vector2) -> bool:
	var suyo: float = _servicio_angulo_tiro(srv)
	if suyo <= _servicio_angulo_tiro(ball):
		return false
	return srv.y < ball.y or suyo >= deg_to_rad(SERVICIO_TIRO_CLARO_DEG)






static func _servicio_srv_pos(ball: Vector2, s_srv: float, d: float, a: float) -> Vector2:
	if d * cos(a) > SERVICIO_SRV_BACK_MAX:
		a = acos(SERVICIO_SRV_BACK_MAX / d)
	return Vector2(clampf(ball.x + s_srv * d * sin(a), - FIELD_EDGE, FIELD_EDGE),
		clampf(ball.y + d * cos(a), 4.0, FIELD_BACK))














static func _servicio_variante(pedida: String) -> Dictionary:


	if not _servicio_gesto_pedido(pedida).is_empty():
		return {}
	return _servicio_fila(SERVICIO_VARIANTES, pedida, "variante")








static func _servicio_gesto_pedido(pedida: String) -> String:
	var q: String = pedida.strip_edges().to_lower()
	return q if SERVICIO_ROTULOS.has(q) else ""






static func _servicio_gesto_fila(v: Dictionary) -> String:
	if bool(v.get("chilena", false)):
		return "chilena"
	if bool(v.get("cabeza", false)):
		return "cabeza"
	if bool(v.get("pecho", false)):
		return "volea"
	var perfil: String = String(v.get("perfil", "raso"))
	if perfil == "bote":
		return "bote"
	if perfil == "aire" and v.has("alto") and float((v["alto"] as Vector2).x) >= SERVICIO_MUSLO_DESDE:
		return "muslo"
	return "pie"




static func _servicio_casa_gesto(f: Dictionary, gesto: String) -> bool:
	if gesto == SERVICIO_SIRVEN:
		return SERVICIO_GESTOS_SIRVEN.has(_servicio_gesto_fila(f))
	return _servicio_gesto_fila(f) == gesto




static func _servicio_zona(pedida: String) -> Dictionary:
	return _servicio_fila(SERVICIO_ZONAS, pedida, "zona")




static func _servicio_cabe(v: Dictionary, zona_id: String) -> bool:
	if v.has("zonas"):
		return (v["zonas"] as Array).has(zona_id)
	return not SERVICIO_ZONAS_AEREAS.has(zona_id)


static func _servicio_fila(tabla: Array[Dictionary], pedida: String, que: String) -> Dictionary:
	var q: String = pedida.strip_edges()
	if q.is_empty():
		return {}
	for v in tabla:
		if String(v["name"]).nocasecmp_to(q) == 0:
			return v
	for v in tabla:
		if String(v["id"]).nocasecmp_to(q) == 0:
			return v
	push_warning("servicio: %s pedida '%s' no existe; se sortea" % [que, pedida])
	return {}









