const LINO_CUT_MIN: float = 1.6




const LINO_PUSH_IN: float = 0.55

var _lino: AnimatedSprite3D
var _lino_cam: Camera3D
var _lino_tween: Tween





func _cut_to_linesman(ball_pos: Vector3) -> void:

	var side: float = 1.0 if ball_pos.x >= 0.0 else -1.0


	var band_x: float = side *(Stadium.FIELD_HALF_W + 1.4)


	var line_z: float = _offside_line_at_kick
	if line_z == INF:
		line_z = _last_defender_z()
	if line_z == INF:
		line_z = ball_pos.z
	line_z = clampf(line_z, 4.0, Stadium.FIELD_DEPTH - 4.0)

















	_lino = AnimatedSprite3D.new()
	_lino.sprite_frames = OffsideFlag.frames(_ref_look())
	_lino.pixel_size = PLAYER_HEIGHT_M / PLAYER_METRICS.x
	_lino.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	_lino.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_lino.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	_lino.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	_lino.position = Vector3(band_x, PLAYER_METRICS.y * _lino.pixel_size, line_z)
	_actors.add_child(_lino)
	_lino.play("signal")

















	_refs_visibles(false)


	var foot: Vector3 = Vector3(band_x, 0.0, line_z)
	if _lino_cam == null:
		_lino_cam = Camera3D.new()
		_lino_cam.fov = 46.0
		add_child(_lino_cam)
	var eye: Vector3 = Vector3(side *(Stadium.FIELD_HALF_W - 3.5), 1.9, line_z + 3.2)
	var look: Vector3 = foot + Vector3(0.0, 1.35, 0.0)

	var dur: float = maxf(OffsideFlag.cycle_seconds(_lino.sprite_frames), LINO_CUT_MIN)



	var axis: Vector3 =(eye - look).normalized()
	_lino_cam.position = eye + axis * LINO_PUSH_IN
	_lino_cam.look_at(look)
	_lino_cam.current = true
	if _lino_tween and _lino_tween.is_valid():
		_lino_tween.kill()


	if Settings.reduce_motion:
		_lino_cam.position = eye
	else:
		_lino_tween = create_tween()
		_lino_tween.tween_property(_lino_cam, "position", eye, dur) \
				.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)



	SceneFade.timer(dur, false).timeout.connect(_end_linesman_cut)


func _end_linesman_cut() -> void:
	if _lino_tween and _lino_tween.is_valid():
		_lino_tween.kill()



	_refs_visibles(true)


	if _aim_cam and state != State.AIMING and state != State.STRIKING:
		_aim_cam.current = true







































