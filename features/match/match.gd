			Tactics.con_desnivel(Tactics.profile(String(rival_hoy.get("id", "")),
				int(rival_hoy.get("rating", 62))), _desnivel),
			match_minute, _dif_sit(), _sit_desde()), _rival_expulsados,
			_expulsados_mios.size()), _momentum.calor()),
		_lluvia_hoy()), float(_arbitro_hoy().get("ventaja", 0.5))),
		-1.0 if _home_match else 1.0)















