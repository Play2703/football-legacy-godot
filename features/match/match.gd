func _servicio_npcs_arma(srv: AnimatedSprite3D, g: Dictionary) -> void:
	_serve_mov = {}
	_serve_lance = {}
	var pie: Vector2 = g["pie"]
	var meta: Vector2 = _serve_plan["ball"]
	_serve_orsay = _servicio_orsay()



	var n_mates: int = int(_serve_plan.get("n_mates", _teammate_actors.size()))
	var n_riv: int = int(_serve_plan.get("n_rivales", _rival_actors.size()))
	_serve_fondo_rng = _rng_de_jugada(meta, "servicio_fondo")
	for k in _teammate_actors.size():
		var a: AnimatedSprite3D = _teammate_actors[k]
		if a == srv or not is_instance_valid(a):
			continue
		var p := Vector2(a.global_position.x, a.global_position.z)
		if k >= n_mates:
			_serve_mov[a] = _servicio_fondo_mov(p, pie, meta, true)
			continue
		var abre: float = signf(p.x - meta.x) if absf(p.x - meta.x) > 0.01 else 1.0


		var to: Vector2 = _servicio_onside(
			_servicio_en_campo(Vector2(p.x + abre * 1.5, maxf(p.y - 4.0, 5.0))), _serve_orsay)
		if not _servicio_libre(to, pie, meta, SERVICIO_NPC_LIBRE):
			to = p
		_serve_mov[a] = {"to": to, "v": Vector2.ZERO, "vmax": 4.5, "desde": 0.35}
	var presion: bool = bool(_serve_plan.get("presion", false))
	var lance: Dictionary = g.get("lance", {})
	var que: String = String(lance.get("que", ""))
	for i in _rival_actors.size():
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a):
			continue



		_anim_lock.erase(a)
		var p := Vector2(a.global_position.x, a.global_position.z)
		if i == 0 and presion:
			match que:
				"barrida", "a_dos":


					_serve_mov[a] = {"to": p, "v": Vector2.ZERO, "vmax": 2.0, "desde": 0.15,
						"sigue": srv, "para": 2.8}
				"carga":

					_serve_mov[a] = {"to": p, "v": Vector2.ZERO, "vmax": 4.5, "desde": 0.0,
						"sigue": srv, "para": 0.9}
				_:
					_serve_mov[a] = {"to": p, "v": Vector2.ZERO, "vmax": 3.8, "desde": 0.15,
						"sigue": srv, "para": 1.3}
			continue
		if i == 1 and bool(_serve_plan.get("dos", false)) and lance.has("sienta"):


			_serve_mov[a] = {"to": Vector2(lance["sienta"]), "v": Vector2.ZERO, "vmax": 3.0,
				"desde": 0.6, "fijo": true}
			continue
		var to: Vector2
		if i >= n_riv:
			_serve_mov[a] = _servicio_fondo_mov(p, pie, meta, false)
			to = _serve_mov[a]["to"]
		else:
			var hacia: float = signf(meta.x - p.x) if absf(meta.x - p.x) > 0.01 else 0.0
			to = _servicio_en_campo(Vector2(p.x + hacia * randf_range(0.8, 1.8),
				p.y - randf_range(1.0, 2.0)))
			if not _servicio_libre(to, pie, meta, SERVICIO_NPC_LIBRE):
				to = p
			_serve_mov[a] = {"to": to, "v": Vector2.ZERO, "vmax": 3.0, "desde": 0.2}




		if p.y <= _serve_orsay:
			_serve_mov[a]["linea"] = true
			_serve_mov[a]["to"] = Vector2(to.x, minf(to.y, maxf(p.y, _serve_orsay)))













const SERVICIO_FONDO_VMAX: float = 2.6
const SERVICIO_FONDO_RONDA := Vector2(1.8, 1.2)
const SERVICIO_FONDO_BASCULA: float = 2.0
var _serve_fondo_rng: RandomNumberGenerator = RandomNumberGenerator.new()


func _servicio_fondo_mov(p: Vector2, pie: Vector2, meta: Vector2, mio: bool) -> Dictionary:
	var r: RandomNumberGenerator = _serve_fondo_rng
	var hacia: float = signf(meta.x - p.x) if absf(meta.x - p.x) > 0.01 else 0.0
	var to: Vector2
	if mio:
		to = _servicio_onside(_servicio_fondo_en_campo(Vector2(p.x + hacia * r.randf_range(0.0, 1.0),
			p.y - r.randf_range(1.0, 2.5)), p), _serve_orsay)
	else:
		to = _servicio_fondo_en_campo(Vector2(p.x + hacia * r.randf_range(0.8, 1.8),
			p.y - r.randf_range(0.5, 1.5)), p)
	if not _servicio_libre(to, pie, meta, SERVICIO_NPC_LIBRE):
		to = p
	return {"to": to, "v": Vector2.ZERO, "vmax": SERVICIO_FONDO_VMAX,
		"desde": r.randf_range(0.2, 0.5), "extra": p, "techo": maxf(FIELD_BACK, p.y)}




static func _servicio_fondo_en_campo(q: Vector2, base: Vector2) -> Vector2:
	return Vector2(clampf(q.x, - FIELD_EDGE, FIELD_EDGE), clampf(q.y, 4.0,
		maxf(FIELD_BACK, base.y)))







func _servicio_fondo_otro(a: AnimatedSprite3D, p: Vector2, base: Vector2,
		meta: Vector2, sostiene: bool) -> Vector2:
	var r: RandomNumberGenerator = _serve_fondo_rng
	var mio: bool = not _rival_actors.has(a)
	var centro: Vector2 = base + Vector2(clampf(meta.x - base.x, - SERVICIO_FONDO_BASCULA,
		SERVICIO_FONDO_BASCULA), 0.0)
	for _i in 4:
		var to: Vector2 = _servicio_fondo_en_campo(centro + Vector2(
			r.randf_range(- SERVICIO_FONDO_RONDA.x, SERVICIO_FONDO_RONDA.x),
			r.randf_range(- SERVICIO_FONDO_RONDA.y, SERVICIO_FONDO_RONDA.y)), base)
		if mio:
			to = _servicio_onside(to, _serve_orsay)
		elif sostiene:
			to.y = minf(to.y, maxf(p.y, _serve_orsay))
		if to.distance_to(p) <= SERVICIO_NPC_LLEGA:
			continue
		if _servicio_en_cono(to, meta) and not _servicio_en_cono(p, meta):
			continue
		if _serve_i < _serve_k and not _servicio_libre(to, _serve_pie, meta, SERVICIO_NPC_LIBRE):
			continue
		return to
	return p





func _servicio_npcs_patada(srv: AnimatedSprite3D, g: Dictionary, t_patada: float) -> void:
	var pie: Vector2 = g["pie"]
	var meta: Vector2 = _serve_plan["ball"]


	_serve_orsay = _servicio_orsay()
	var cierra: AnimatedSprite3D = null
	var cerca: float = INF
	for a in _serve_mov.keys():
		if not is_instance_valid(a):
			continue
		var m: Dictionary = _serve_mov[a]
		var p := Vector2(a.global_position.x, a.global_position.z)




		var sostiene: bool = _rival_actors.has(a) and p.y <= _serve_orsay
		if sostiene:
			m["linea"] = true
			var to: Vector2 = m["to"]
			m["to"] = Vector2(to.x, minf(to.y, maxf(p.y, _serve_orsay)))
		else:
			m.erase("linea")






		if _teammate_actors.has(a) and a != _self_actor:
			if p.y < _serve_orsay:
				m["to"] = Vector2(p.x, _serve_orsay + SERVICIO_VUELVE_M)
				m["vmax"] = _servicio_vuelve_vmax(p, m["to"], float(m["vmax"]))
			else:
				m["to"] = _servicio_onside(m["to"], _serve_orsay)
			continue
		if m.has("sigue"):
			m.erase("sigue")
			m["to"] = p
			continue
		if _rival_actors.has(a) and not sostiene and p.distance_to(meta) < cerca:
			cerca = p.distance_to(meta)
			cierra = a
	if cierra != null:
		var p := Vector2(cierra.global_position.x, cierra.global_position.z)
		var hacia: Vector2 =(p - meta).normalized() if p.distance_to(meta) > 0.01 \
				else Vector2(0.0, -1.0)



		var al_arco: Vector2 =(- meta).normalized() if meta.length() > 0.01 else Vector2(0.0, -1.0)
		var abre: float = al_arco.angle_to(hacia)
		var cono: float = deg_to_rad(SERVICIO_CIERRA_CONO)
		if absf(abre) < cono:
			hacia = al_arco.rotated(cono *(signf(abre) if absf(abre) > 0.001 else 1.0))


		var to: Vector2 = _servicio_en_campo(meta + hacia * 4.4)
		if _servicio_libre(to, pie, meta, SERVICIO_NPC_LIBRE):
			_serve_mov[cierra]["to"] = to
			_serve_mov[cierra]["vmax"] = 4.0


			_serve_mov[cierra].erase("extra")
			_serve_mov[cierra].erase("techo")
	if is_instance_valid(srv):
		var sp := Vector2(srv.global_position.x, srv.global_position.z)
		var al_area: Vector2 = Vector2(0.0, 8.0) - sp
		al_area = al_area.normalized() if al_area.length() > 0.01 else Vector2(0.0, -1.0)








		var v0: Vector2 = Vector2.ZERO
		var tramos: Array = g.get("tramos", [])
		if not tramos.is_empty():
			var tr: Array = tramos[tramos.size() - 1]
			var a: Vector2 = tr[0]
			var b: Vector2 = tr[1]
			v0 =(b - a) / maxf(float(tr[2]), 0.05)




		var linea: float = _serve_orsay +(SERVICIO_VUELVE_M if sp.y < _serve_orsay else 0.0)
		var to: Vector2 = _servicio_onside(_servicio_en_campo(sp + al_area * 4.0), linea)
		var vmax: float = 5.0
		if sp.y < _serve_orsay:
			vmax = _servicio_vuelve_vmax(sp, to, vmax)
		_serve_mov[srv] = {"to": to, "v": v0, "vmax": vmax, "desde": t_patada}








func _servicio_vuelve_vmax(desde: Vector2, to: Vector2, vmax: float) -> float:
	var t: float = maxf(float(_serve_k) * SIM_DT, 0.5)
	return clampf(SERVICIO_VUELVE_HOLGURA * desde.distance_to(to) / t, vmax,
		maxf(vmax, SERVICIO_VUELVE_VMAX))


















func _servicio_lance(srv: AnimatedSprite3D, g: Dictionary, t: float, dt: float) -> void:
	var lance: Dictionary = g.get("lance", {})
	if lance.is_empty() or not bool(_serve_plan.get("presion", false)) \
			or not is_instance_valid(srv):
		return
	if _rival_actors.is_empty() or not is_instance_valid(_rival_actors[0]):
		return
	var r0: AnimatedSprite3D = _rival_actors[0]
	var que: String = String(lance["que"])
	var pie: Vector2 = g["pie"]
	var meta: Vector2 = _serve_plan["ball"]
	var sp := Vector2(srv.global_position.x, srv.global_position.z)
	var p0 := Vector2(r0.global_position.x, r0.global_position.z)
	var fase: int = int(_serve_lance.get("fase", 0))
	var ahora: int = Time.get_ticks_msec()
	if que == "barrida" or que == "a_dos":
		if fase == 0 and t >= float(lance["t"]):
			var tirado: int = _servicio_se_tira(r0, Vector2(lance["fin"]), pie, meta)
			if tirado == 1:
				_serve_lance["fase"] = 2
				_serve_lance["hecho"] = true
			elif tirado < 0 or t >= float(lance["t"]) + SERVICIO_LANCE_INSISTE:
				_serve_lance["fase"] = 2
				_serve_lance["degradado"] = true
				_servicio_lance_degrada(r0, que)
		if que == "a_dos" and bool(_serve_plan.get("dos", false)) \
				and int(_serve_lance.get("fase2", 0)) == 0 and t >= float(lance["t2"]) \
				and _rival_actors.size() > 1 and is_instance_valid(_rival_actors[1]):
			var r1: AnimatedSprite3D = _rival_actors[1]
			var p1 := Vector2(r1.global_position.x, r1.global_position.z)
			var cabe: bool = _servicio_libre(p1, pie, meta, SERVICIO_NPC_LIBRE)


			if cabe and _play_dir_gesture(r1, "fall", Vector2(lance["f"]), SERVICIO_LANCE_SUELO_MS):
				_serve_mov.erase(r1)
				_serve_lance["fase2"] = 2
				_serve_lance["hecho2"] = true
				_fx.dust_burst(Vector3(p1.x, 0.0, p1.y))
			elif not cabe or t >= float(lance["t2"]) + SERVICIO_LANCE_INSISTE:
				_serve_lance["fase2"] = 2
				_serve_lance["degradado"] = true
				_servicio_lance_degrada(r1, que)
	elif que == "carga":
		var hombro: Vector2 = lance["hombro"]
		if fase == 0 and t >= float(lance["t"]):
			var cabe: bool = _servicio_libre(sp + hombro, pie, meta, SERVICIO_NPC_LIBRE)


			if cabe and _play_dir_gesture(r0, "carga", sp - p0, 600):
				_serve_mov.erase(r0)
				_serve_lance["fase"] = 1
				_serve_lance["hecho"] = true
				fase = 1
				_fx.dust_burst(Vector3((sp.x + p0.x) * 0.5, 0.0,(sp.y + p0.y) * 0.5))
			elif not cabe or t >= float(lance["t"]) + SERVICIO_LANCE_INSISTE:
				_serve_lance["fase"] = 2
				_serve_lance["degradado"] = true
				_servicio_lance_degrada(r0, que)
		if fase == 1:
			_anim_lock[r0] = ahora + 200

			var quiere: Vector2 = sp + hombro
			var np: Vector2 = _servicio_en_campo(p0.lerp(quiere, 1.0 - exp(-14.0 * dt)))
			r0.global_position = Vector3(np.x, r0.global_position.y, np.y)
			if not bool(_serve_lance.get("t2", false)) and t >= float(lance["t2"]):
				_serve_lance["t2"] = true
				_fx.dust_burst(Vector3((sp.x + np.x) * 0.5, 0.0,(sp.y + np.y) * 0.5))
			if t >= float(lance["t_cae"]):
				var cae: Vector2 = lance["cae"]
				if _play_dir_gesture(r0, "fall", cae, SERVICIO_LANCE_SUELO_MS):


					_slide_travel(r0, cae, 0.5, 0.3, false)
					_serve_lance["fase"] = 2
					_serve_lance["cae"] = true
					_fx.dust_burst(Vector3(np.x, 0.0, np.y))
				elif t >= float(lance["t_cae"]) + SERVICIO_LANCE_INSISTE:


					_serve_lance["fase"] = 2
					_serve_lance["degradado"] = true
					_anim_lock.erase(r0)





func _servicio_se_tira(r: AnimatedSprite3D, fin: Vector2, pie: Vector2, meta: Vector2) -> int:
	var p := Vector2(r.global_position.x, r.global_position.z)
	var hacia: Vector2 = fin - p
	if hacia.length() < 0.8:
		return -1
	for i in 5:
		if not _servicio_libre(p.lerp(fin, float(i + 1) / 5.0), pie, meta, SERVICIO_NPC_LIBRE):
			return -1
	if not _play_dir_gesture(r, "slide", hacia, SERVICIO_LANCE_SUELO_MS):
		return 0
	_serve_mov.erase(r)


	r.speed_scale = SLIDE_ANIM_SPEED
	_slide_travel(r, hacia, clampf(hacia.length(), SLIDE_MIN_M, SLIDE_MAX_M))
	_splash_at(p, Vector3(hacia.x, 0.0, hacia.y), 20.0)
	return 1





func _servicio_lance_degrada(r: AnimatedSprite3D, que: String) -> void:
	if not _serve_mov.has(r):
		return
	var m: Dictionary = _serve_mov[r]
	if que == "carga":
		m["para"] = 1.3
		return
	m.erase("sigue")
	m["to"] = Vector2(r.global_position.x, r.global_position.z)







func _servicio_npcs(dt: float, t: float) -> void:






	dt *= _servicio_reloj_ruta()
	var ahora: int = Time.get_ticks_msec()
	for a in _serve_mov.keys():
		if not is_instance_valid(a):
			continue
		var m: Dictionary = _serve_mov[a]
		var p := Vector2(a.global_position.x, a.global_position.z)
		var want := Vector2.ZERO
		if t >= float(m["desde"]):
			var to: Vector2 = m["to"]
			var sigue: Variant = m.get("sigue")
			if sigue is AnimatedSprite3D and is_instance_valid(sigue):
				var sp := Vector2(sigue.global_position.x, sigue.global_position.z)
				var lejos: Vector2 = p - sp
				to = sp +(lejos.normalized() if lejos.length() > 0.01 else Vector2(0.0, 1.0)) \
						* float(m["para"])
			elif p.distance_to(to) <= SERVICIO_NPC_LLEGA and not m.has("fijo"):

				to = _servicio_npc_otro(a, p)
				m["to"] = to






			if a != _self_actor and _teammate_actors.has(a):
				var legal: Vector2 = _servicio_onside(to, _serve_orsay)
				if legal.distance_to(p) > SERVICIO_NPC_LLEGA:
					to = legal
			var falta: Vector2 = to - p
			if falta.length() > 0.05:
				want = falta.normalized() * minf(float(m["vmax"]), falta.length() * 2.2)
		var v: Vector2 = m["v"]
		v = v.lerp(want, 1.0 - exp(- SERVICIO_NPC_ACEL * dt))
		if want == Vector2.ZERO and v.length() < LOCO_MIN_SPD:
			v = Vector2.ZERO
		m["v"] = v





		if want.length() > WALK_EXIT:
			a.set_meta("pace_run_until", ahora + 250)
		if v != Vector2.ZERO:






			var np: Vector2 = _servicio_en_campo(p + v * dt, minf(4.0, p.y))





			if absf(p.x) > FIELD_EDGE:
				var borde: float = absf(p.x)
				np.x = clampf(p.x + v.x * dt, - borde, borde)



			if m.has("techo") and p.y + v.y * dt > FIELD_BACK:
				np.y = minf(p.y + v.y * dt, maxf(float(m["techo"]), p.y))




			if m.has("linea") and np.y > maxf(p.y, _serve_orsay):
				np.y = maxf(p.y, _serve_orsay)
				v.y = minf(v.y, 0.0)
				m["v"] = v
			a.global_position = Vector3(np.x, a.global_position.y, np.y)










		if v.length() < LOCO_MIN_SPD and _anim_lock.get(a, 0) <= ahora:
			_face_ball(a)








	if is_instance_valid(_self_actor) and not _servicio_yo(t) \
			and (state == State.SETUP or state == State.RESOLVED) \
			and _anim_lock.get(_self_actor, 0) <= ahora:
		_face_ball(_self_actor)




static func _servicio_en_cono(q: Vector2, meta: Vector2) -> bool:
	var rel: Vector2 = q - meta
	if rel.length() <= 0.01 or rel.length() >= SERVICIO_CONO_M:
		return false
	var al_arco: Vector2 =(- meta).normalized() if meta.length() > 0.01 else Vector2(0.0, -1.0)
	return absf(al_arco.angle_to(rel)) < deg_to_rad(SERVICIO_CIERRA_CONO)









func _servicio_npc_otro(a: AnimatedSprite3D, p: Vector2) -> Vector2:
	var meta: Vector2 = _serve_plan.get("ball", Vector2.ZERO)
	var rival: bool = _rival_actors.has(a)



	var sostiene: bool = rival and bool((_serve_mov.get(a, {}) as Dictionary).get("linea", false))


	var base: Variant =(_serve_mov.get(a, {}) as Dictionary).get("extra")
	if base is Vector2:
		return _servicio_fondo_otro(a, p, base, meta, sostiene)
	for _i in 4:
		var to: Vector2
		if sostiene:
			var lado: float = signf(meta.x - p.x) if _i == 0 and absf(meta.x - p.x) > 1.0 \
					else (1.0 if randf() < 0.5 else -1.0)
			to = Vector2(p.x + lado * randf_range(1.0, SERVICIO_NPC_PASO_RIVAL),
				p.y - randf_range(0.0, 0.5))
		elif rival:
			var rel: Vector2 = p - meta
			var d: float = rel.length()
			var dir: Vector2 = rel / d if d > 0.01 else Vector2(0.0, 1.0)
			if d > SERVICIO_NPC_CERCA + 0.5:
				var paso: float = minf(SERVICIO_NPC_PASO_RIVAL, d - SERVICIO_NPC_CERCA)
				to = p - dir.rotated(randf_range(-0.5, 0.5)) * paso
			else:
				var giro: float = randf_range(0.5, 1.0) *(1.0 if randf() < 0.5 else -1.0)
				to = meta + dir.rotated(giro) *(SERVICIO_NPC_CERCA + randf())
		else:
			var hueco := Vector2(randf_range(-9.0, 9.0), randf_range(6.0, 11.0))





			hueco = _servicio_onside(hueco, _serve_orsay)
			to = p +(hueco - p).limit_length(
				randf_range(SERVICIO_NPC_PASO_MATE.x, SERVICIO_NPC_PASO_MATE.y))
		to = _servicio_en_campo(to)

		if sostiene:
			to.y = minf(to.y, maxf(p.y, _serve_orsay))
		if to.distance_to(p) <= SERVICIO_NPC_LLEGA:
			continue
		if _servicio_en_cono(to, meta) and not _servicio_en_cono(p, meta):
			continue
		if _serve_i < _serve_k and not _servicio_libre(to, _serve_pie, meta, SERVICIO_NPC_LIBRE):
			continue
		return to
	return p













func _play_servicio_pase() -> void:
	var srv: AnimatedSprite3D = _servicio_server()
	if srv == null or not is_instance_valid(_self_actor) or not is_instance_valid(_ball) \
			or _serve_plan.is_empty():
		return
	var previo: int = state
	state = State.SETUP
	if bool(_serve_plan.get("saque", false)):
		_saque_largo_planta(srv)
	var g: Dictionary = _servicio_guion(_serve_plan, _cesped_bote, _cesped_drag)
	var pase: Dictionary = g["pase"]
	if pase.is_empty():
		state = previo
		return
	_serve_gen += 1
	var gen: int = _serve_gen
	_serve_vivo = false
	_serve_golpe = Vector2.INF
	_serve_primera = false
	_serve_pie = g["pie"]
	_serve_ruta = pase["ruta"]
	_serve_k = int(pase["k"])
	_serve_i = 0
	_serve_cita = pase["cruce"]
	_serve_k_recibe = int(pase.get("k_recibe", -1))
	_serve_control = String(pase.get("control", ""))
	_serve_pica = int(pase.get("pica", -1))
	_serve_acum = 0.0
	_serve_reloj = SERVICIO_GOLPEO_RELOJ_CABEZA
	_serve_cruce = {}
	_serve_cita_vibro = false
	_serve_vista = ""
	_serve_ruta_n0 = _serve_ruta.size()
	_serve_cola = false
	_servicio_jugada(srv, g, pase, gen, previo)


	var espera: float = 0.0
	while _serve_corre and not _serve_vivo and gen == _serve_gen and espera < 8.0 \
			and is_inside_tree():
		await get_tree().physics_frame
		if can_process():
			espera += get_physics_process_delta_time()
















func _servicio_jugada(srv: AnimatedSprite3D, g: Dictionary, pase: Dictionary, gen: int,
		previo: int) -> void:
	_serve_corre = true
	var meta: Vector2 = _serve_plan["ball"]
	var mira: Vector3 = Vector3(meta.x, 0.6, meta.y)
	var inicio: Vector2 = g["inicio"]
	srv.global_position = Vector3(inicio.x, srv.global_position.y, inicio.y)


	var quieto: bool = String(g.get("tipo", "")) == "parado"
	if quieto:
		var punto: Vector2 = g["pie"]
		_ball.position = Vector3(punto.x, BALL_VISUAL_D * 0.5, punto.y)
	_servicio_npcs_arma(srv, g)
	_serve_yo = _servicio_desmarque(g, pase)
	if not _serve_yo.is_empty():
		var s0: Vector2 = _serve_yo["ruta"][0]
		_self_actor.global_position = Vector3(s0.x, _self_actor.global_position.y, s0.y)
		_face_ball(_self_actor)


	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + SERVICIO_GESTO_BUDGET_US)
	var t_total: float = 0.0


	var saque: bool = String(g.get("tipo", "")) == "saque"
	if saque:
		var t_saque: float = await _saque_largo_gesto(srv, g, gen, mira)
		if t_saque < 0.0:
			_servicio_fin(gen, previo)
			return
		t_total += t_saque


	var pie: Vector2 = g["pie"]
	var al_pase: Vector2 =(meta - pie).normalized() if pie.distance_to(meta) > 0.01 \
			else Vector2(g["eje"])
	var dk: String = _dir_name(Vector3(al_pase.x, 0.0, al_pase.y))
	var pateando: bool = false


	var tramos: Array = g["tramos"]
	var bdir: Vector2 = g["e1"]



	var lance: Dictionary = g.get("lance", {})
	var riego: Array = []
	var regado: bool = lance.is_empty() or not bool(_serve_plan.get("presion", false))
	if not regado and not _rival_actors.is_empty() and is_instance_valid(_rival_actors[0]):
		var r0: AnimatedSprite3D = _rival_actors[0]
		var e1: Vector2 = g["e1"]
		match String(lance["que"]):
			"barrida":
				riego = [[r0, "slide", Vector2(lance["fin"]) - Vector2(r0.global_position.x,
					r0.global_position.z)]]
			"a_dos":
				riego = [[r0, "slide", Vector2(lance["fin"]) - Vector2(r0.global_position.x,
					r0.global_position.z)]]
				if _rival_actors.size() > 1 and is_instance_valid(_rival_actors[1]):
					riego.append([_rival_actors[1], "fall", Vector2(lance["f"])])
			"carga":
				riego = [[r0, "carga", - e1], [r0, "fall", Vector2(lance["cae"])]]
	for i_tr in tramos.size():
		var tr: Array = tramos[i_tr]
		var ultimo: bool = i_tr == tramos.size() - 1
		var a: Vector2 = tr[0]
		var b: Vector2 = tr[1]
		var dur: float = tr[2]
		var toques: float = tr[3]
		var rumbo: Vector2 =(b - a).normalized() if a.distance_to(b) > 0.01 \
				else Vector2(g["e2"])




		var dn: String = _dir_name(Vector3(rumbo.x, 0.0, rumbo.y))


		var fam: String = String(tr[4]) if tr.size() > 4 else "run"


		if fam == "carga" and not bool(_serve_plan.get("presion", false)):
			fam = "run"
		var zancada: String = fam + "_" + dn
		if fam != "run" and not _anim_usable(srv, zancada):
			zancada = "run_" + dn


		if fam != "quieto" and _anim_usable(srv, zancada):
			srv.play(zancada)
			_anim_lock[srv] = Time.get_ticks_msec() + int((dur + 0.3) * 1000.0)
		var t: float = 0.0
		while t < dur:
			await get_tree().physics_frame
			if not _servicio_sigue(gen) or not is_instance_valid(srv):
				_servicio_fin(gen, previo)
				return
			if not can_process():
				continue
			var dt: float = get_physics_process_delta_time()
			t += dt
			t_total += dt
			var u: float = clampf(t / dur, 0.0, 1.0)
			var aqui: Vector2 = a.lerp(b, u)
			srv.global_position = Vector3(aqui.x, srv.global_position.y, aqui.y)
			if not regado:
				_ondemand_deadline_us = maxi(_ondemand_deadline_us,
					Time.get_ticks_usec() + SERVICIO_LANCE_RIEGO_US)
				regado = true
				for par in riego:
					var v: Vector2 = par[2]
					if not _gesto_listo(par[0], "%s_%s" % [par[1], _dir_name(Vector3(v.x, 0.0, v.y))]):
						regado = false






			if ultimo and not pateando and dur - t <= SERVICIO_KICK_AT:
				pateando = true




				_ondemand_deadline_us = maxi(_ondemand_deadline_us,
					Time.get_ticks_usec() + SERVICIO_GESTO_BUDGET_US)
				if _gesto_listo(srv, "kick_" + dk):
					srv.play("kick_" + dk)




					var sf: SpriteFrames = srv.sprite_frames
					var fps_k: float = maxf(sf.get_animation_speed("kick_" + dk), 1.0)
					_anim_lock[srv] = Time.get_ticks_msec() \
							+ int(1000.0 * float(sf.get_frame_count("kick_" + dk)) / fps_k) + 34
				else:







					var al_tiro: String = "run_" + dk
					if _anim_usable(srv, al_tiro):
						srv.play(al_tiro)
						_anim_lock[srv] = Time.get_ticks_msec() + 450



			bdir = bdir.lerp(rumbo, 1.0 - exp(-25.0 * dt))
			bdir = bdir.normalized() if bdir.length() > 0.01 else rumbo
			var lejos: float = SERVICIO_DRIB_CERCA \
					+ SERVICIO_DRIB_LEJOS * absf(sin(u * PI * toques))
			var bp: Vector2 = aqui + bdir * lejos


			if pateando or quieto:
				bp = pie
			var antes: Vector3 = _ball.position
			_ball.position = Vector3(bp.x, BALL_VISUAL_D * 0.5, bp.y)
			_ball_roll(Vector2(_ball.position.x - antes.x, _ball.position.z - antes.z)
				/ maxf(dt, 0.001))


			if not _serve_vivo:
				_ball_field = bp
				_aim_cam_look(Vector3(bp.x, 0.0, bp.y).lerp(mira, 0.3) + Vector3(0.0, 0.6, 0.0),
					dt, 5.0)
			_servicio_lance(srv, g, t_total, dt)
			_servicio_npcs(dt, t_total)





	if not saque:
		_ball.position = Vector3(pie.x, BALL_VISUAL_D * 0.5, pie.y)
		if not _serve_vivo:
			_ball_field = pie
	_ball_roll(Vector2.ZERO)
	_servicio_npcs_patada(srv, g, t_total)




	var i_mando: int = _servicio_mando_i(_serve_k, _serve_k_recibe, _serve_control == "pecho",
		_servicio_chilena())
	var botes: Array[int] = pase["botes"]
	var botes_vy: Array[float] = pase["botes_vy"]

	_servicio_encola_botes(botes, botes_vy, _serve_i)


	var se_fue: bool = false

	var recibido: bool = false

	var i_chilena: int = i_mando - roundi(SERVICIO_CHILENA_ARRANQUE / SIM_DT) \
			if _servicio_chilena() else -1
	while _serve_i < _serve_ruta.size() - 1:
		await get_tree().physics_frame
		if gen != _serve_gen or not is_inside_tree() or not is_instance_valid(_ball):
			break
		if not can_process():
			continue
		if se_fue:
			if state != State.RESOLVED:
				break
		elif not _servicio_sigue(gen):
			break





		elif not _serve_vivo and _serve_i >= i_mando:
			break


		if _servicio_foto():
			continue
		var dt: float = get_physics_process_delta_time()
		t_total += dt

		_servicio_cola()






		if _serve_salto.is_empty() and _serve_golpe != Vector2.INF and _servicio_cabeza() \
				and state == State.STRIKING \
				and _serve_i >= _serve_k - roundi(SERVICIO_SALTO_T / SIM_DT):
			_servicio_salta()
		_servicio_cruce_tick()
		_serve_acum += clampf(Engine.time_scale, 0.0, 1.0) * _servicio_reloj_ruta()
		if _serve_acum < 1.0 - 0.0001:
			_servicio_entre_ticks(dt, t_total, mira, se_fue, i_mando)
			continue
		_serve_acum -= 1.0
		_serve_i += 1







		var sig_i: int = mini(_serve_i + 1, _serve_ruta.size() - 1)
		var resto: float = 0.0 if _serve_i == _serve_k else clampf(_serve_acum, 0.0, 1.0)
		_ball.position = _serve_ruta[_serve_i].lerp(_serve_ruta[sig_i], resto) \
				+ Vector3(0.0, BALL_VISUAL_D * 0.5, 0.0)

		_strike_mira_tick()


		_servicio_cola_cam()



		if state == State.STRIKING and not _serve_cita_vibro and _servicio_primera_persona() \
				and _servicio_cita_abierta():
			_serve_cita_vibro = true
			_haptic(10)




			if _hud != null:
				_hud.show_hint(_servicio_grito())
				_hud.show_message(_servicio_grito(), Color("ffe66d"), 0.6)



		var vel: Vector3 =(_serve_ruta[_serve_i] - _serve_ruta[_serve_i - 1]) / SIM_DT
		_ball_roll(Vector2(vel.x, vel.z))











		if not _serve_vivo and not se_fue:
			_aim_cam_look((_ball.position + vel * FLIGHT_LEAD).lerp(mira, 0.3), dt, 8.0)
			_servicio_zoom_tick(i_mando)



		if not _serve_vivo and _servicio_recibe() \
				and _serve_i == maxi(_serve_k_recibe - roundi(SERVICIO_LENTA_ANTES / SIM_DT), 1):
			_servicio_lenta(true)


		if not _serve_vivo and i_chilena >= 1 \
				and _serve_i == maxi(i_chilena - roundi(SERVICIO_LENTA_ANTES / SIM_DT), 1):
			_servicio_lenta(true)
		_servicio_lenta_tick()







		if _serve_k_recibe >= 1 and not recibido and not _serve_vivo and not se_fue:


			var i_gesto: int = _serve_k_recibe - _servicio_anticipa(_serve_control)
			if _serve_i < i_gesto:
				if _serve_i >= i_gesto - SERVICIO_RIEGO_TICKS:
					_servicio_recibe_riega()
			elif _serve_i <= i_mando:
				recibido = _servicio_recibe_gesto()




		if i_chilena >= 1 and _serve_salto.is_empty() and not _serve_vivo and not se_fue:
			if _serve_i >= i_chilena:
				_servicio_chilena_arma(i_mando)
			elif _serve_i >= i_chilena - roundi(SERVICIO_CHILENA_RIEGO / SIM_DT):
				_servicio_chilena_riega()
		if not _serve_vivo and not se_fue and _serve_i >= i_mando:
			_servicio_mando(meta)

			_servicio_encola_botes(botes, botes_vy, _serve_i)
		_play_marks(_serve_i)

		if _servicio_foto():
			continue
		_servicio_npcs(dt, t_total)
		if se_fue:
			continue




		if state == State.STRIKING and (_serve_salto.is_empty()
				or (_servicio_chilena_pre() and not bool(_serve_salto.get("corte", false)))):
			_strike_clear_view()



		if _servicio_chilena_pre() and not bool(_serve_salto.get("corte", false)) \
				and state == State.STRIKING and _serve_golpe != Vector2.INF \
				and _serve_i >= _serve_k - roundi(SERVICIO_CHILENA_CORTE / SIM_DT):
			_serve_salto["corte"] = true
			_strike_corta_a_apuntar()
			if is_instance_valid(_self_actor):
				_self_actor.visible = true
				_self_actor.flip_h = false


		if _serve_salto.is_empty() and _serve_golpe != Vector2.INF and _servicio_cabeza() \
				and state == State.STRIKING \
				and _serve_i >= _serve_k - roundi(SERVICIO_SALTO_T / SIM_DT):
			_servicio_salta()
		if not _serve_salto.is_empty():
			_servicio_salto_pose(_serve_salto, float(_serve_k - _serve_i) - _serve_acum)
		if _serve_i >= _serve_k and _serve_golpe != Vector2.INF:
			_servicio_remata(_serve_golpe)
			break
		if _servicio_se_fue():
			_servicio_se_va()
			se_fue = true


	if gen == _serve_gen and _serve_vivo and is_inside_tree() and is_instance_valid(_ball) \
			and (state == State.AIMING or state == State.STRIKING):
		if _serve_golpe != Vector2.INF and state == State.STRIKING:
			_servicio_remata(_serve_golpe)
		else:
			_servicio_se_va()





	if gen == _serve_gen:
		for a in _serve_mov.keys():
			if is_instance_valid(a):
				SceneFade.timer(PACE_DT_MAX + 0.05, false).timeout.connect(
					_servicio_reposa.bind(a, gen))
	_servicio_fin(gen, previo)




func _servicio_reposa(a, gen: int) -> void:
	if gen == _serve_gen and state == State.RESOLVED and is_instance_valid(a) \
			and _at_rest(a, {}):
		_face_ball(a)





func _servicio_sigue(gen: int) -> bool:
	if gen != _serve_gen or not is_inside_tree() or not is_instance_valid(_ball):
		return false
	if _serve_vivo and state != State.AIMING and state != State.STRIKING:
		return false
	return true




func _servicio_fin(gen: int, previo: int) -> void:
	if gen != _serve_gen:
		return
	if not _serve_vivo and state == State.SETUP:
		state = previo
	_servicio_congela(false)
	_servicio_lenta(false)
	_servicio_zoom_fin()
	_serve_vivo = false
	_serve_corre = false









func _servicio_mando(meta: Vector2) -> void:


	_servicio_lenta(false)


	_serve_zoom_fov0 = -1.0
	var en_camino: Vector3 = _ball.position
	_serve_vivo = true




	var cita: Vector2 = Vector2(_serve_cita.x, _serve_cita.z) if _servicio_recibe() else meta
	_ball.position = Vector3(cita.x, BALL_VISUAL_D * 0.5, cita.y)
	_ball_field = cita



	var zancada: StringName = _self_actor.animation
	var cuadro: int = _self_actor.frame
	var avance: float = _self_actor.frame_progress
	var espejo: bool = _self_actor.flip_h
	_handoff_vivo = true
	_handoff_to(_self_actor)
	_handoff_vivo = false









	_handoff_live = false
	_ctrl_ficha = {}
	_ctrl_media_c = -1
	if _self_actor.sprite_frames.has_animation(zancada):
		_self_actor.play(zancada)
		_self_actor.set_frame_and_progress(cuadro, avance)
		_self_actor.flip_h = espejo


	_servicio_mira_al_balon(en_camino)


	if _servicio_chilena_pre() and String(_self_actor.animation).begins_with("chilena_"):
		_self_actor.set_frame_and_progress(SERVICIO_CHILENA_FOTO_FRAME, 0.5)
		_self_actor.speed_scale = 1.0
	if _handoff_ball_tw and _handoff_ball_tw.is_valid():
		_handoff_ball_tw.kill()
	_ball.position = en_camino
	_show_drive_ring()








	var srv_a: AnimatedSprite3D = _servicio_server()
	if srv_a != null:
		var srv_nom: String = String(_finisher_of(srv_a).get("name", ""))
		if not srv_nom.is_empty():
			_pase_mate = srv_nom
			_asiste_mate = srv_nom





func _servicio_encola_botes(botes: Array[int], botes_vy: Array[float], desde: int) -> void:
	_bmarks = []
	_bmark_i = 0
	for i in botes.size():
		if botes[i] > desde:
			_queue_mark(_serve_ruta[botes[i]], botes_vy[i], botes[i])











static func _servicio_mando_i(k: int, k_rec: int = -1, pecho: bool = false,
		chilena: bool = false) -> int:
	if k_rec >= 1:



		if pecho:
			return clampi(maxi(k - roundi(SERVICIO_CITA_ANTES / SIM_DT), k_rec + 1),
				1, maxi(k - 1, 1))
		return clampi(k_rec + roundi(SERVICIO_MANDO_TRAS_CONTROL / SIM_DT), 1, maxi(k - 1, 1))
	if chilena:
		return clampi(k - roundi(SERVICIO_CHILENA_MANDO / SIM_DT), 1, maxi(k - 1, 1))
	return clampi(k - roundi(SERVICIO_MANDO_ANTES / SIM_DT), 1, maxi(k - 1, 1))





static func _servicio_ventana(k: int, k_rec: int = -1, pecho: bool = false,
		chilena: bool = false) -> float:
	return float(k - _servicio_mando_i(k, k_rec, pecho, chilena)) * SIM_DT





func _servicio_foto() -> bool:
	var quieto: bool = _serve_vivo and state == State.AIMING
	if quieto != _serve_quieto:
		_servicio_congela(quieto)
	return quieto













func _servicio_congela(on: bool) -> void:
	if on == _serve_quieto:
		return
	_serve_quieto = on
	var ahora: int = Time.get_ticks_msec()
	if on:
		_serve_quieto_ms = ahora
		_serve_pausados = []

		_serve_candados = []
		for a in _anim_lock.keys():
			if int(_anim_lock[a]) > ahora:
				_anim_lock[a] = int(_anim_lock[a]) + SERVICIO_FOTO_CANDADO_MS
				_serve_candados.append(a)
		var cuerpos: Array = _todos_actores() + _refs_vivos()
		cuerpos.append(_self_actor)
		cuerpos.append(_keeper)
		for a in cuerpos:
			if is_instance_valid(a) and a.is_playing() and not _serve_pausados.has(a):
				a.pause()
				_serve_pausados.append(a)
		return
	var congelado: int = ahora - _serve_quieto_ms
	for a in _serve_candados:
		if _anim_lock.has(a):
			_anim_lock[a] = int(_anim_lock[a]) - SERVICIO_FOTO_CANDADO_MS + congelado
	_serve_candados = []
	for a in _serve_pausados:
		if is_instance_valid(a) and not a.is_playing():


			if a == _self_actor and _servicio_chilena_pre():
				continue
			a.play()
	_serve_pausados = []




































const SERVICIO_YO_TRAS := Vector2(0.22, 0.35)
const SERVICIO_YO_ANTES := Vector2(1.2, 1.8)
const SERVICIO_YO_VMAX: float = 6.0
const SERVICIO_YO_LIBRE: float = 0.9
const SERVICIO_YO_CITA: float = 1.6
const SERVICIO_YO_GENTE: float = 1.2
const SERVICIO_YO_REGATE: float = 1.5


const SERVICIO_YO_RECURSO: Array[float] = [1.2, 2.0, 3.0]
const SERVICIO_YO_RUMBOS: int = 16
const SERVICIO_YO_TIPOS: Array[Dictionary] = [
	{"tipo": "arranca", "largo": Vector2(3.0, 5.0), "giro": 35.0, "peso": 3},
	{"tipo": "apoyo", "largo": Vector2(2.0, 3.5), "giro": 30.0, "peso": 2},
	{"tipo": "se_ofrece", "largo": Vector2(2.0, 3.5), "giro": 25.0, "peso": 2},
	{"tipo": "amaga", "largo": Vector2(2.2, 3.0), "giro": 30.0, "peso": 2},
	{"tipo": "trota", "largo": Vector2(1.2, 2.0), "giro": 180.0, "peso": 1},
]


func _servicio_desmarque(g: Dictionary, pase: Dictionary) -> Dictionary:
	if not is_instance_valid(_self_actor) or pase.is_empty():
		return {}
	var e := Vector2(_self_actor.global_position.x, _self_actor.global_position.z)
	var pie: Vector2 = g["pie"]
	var meta: Vector2 = _serve_plan["ball"]
	var k_rec: int = int(pase.get("k_recibe", -1))



	var t_base: float = float(g.get("dura", SERVICIO_DRIB_T1 + SERVICIO_DRIB_T2))
	var i_mando: int = _servicio_mando_i(int(pase["k"]), k_rec,
		String(pase.get("control", "")) == "pecho", _servicio_chilena())
	var t_mando: float = t_base + float(i_mando) * SIM_DT
	var al_arco: Vector2 =(- e).normalized() if e.length() > 0.01 else Vector2(0.0, -1.0)
	var al_pase: Vector2 =(pie - e).normalized() if pie.distance_to(e) > 0.01 else al_arco

	var eje: Vector2 =(meta - pie).normalized() if meta.distance_to(pie) > 0.01 \
			else Vector2(0.0, 1.0)
	var fuera := Vector2(- eje.y, eje.x)
	if fuera.dot(e - pie) < 0.0:
		fuera = - fuera


	var cruce: Vector3 = pase["cruce"]
	var cita := Vector2(cruce.x, cruce.z)
	var ruta_pase: Array[Vector3] = pase["ruta"]

	var fin: Vector2 = e
	var t_llega: float = -1.0
	if k_rec >= 1 and k_rec < ruta_pase.size():
		var rec: Vector3 = ruta_pase[k_rec]
		var lleva: Vector3 = rec - ruta_pase[k_rec - 1]
		fin = _servicio_postura(Vector2(rec.x, rec.z), Vector2(- lleva.x, - lleva.z))


		t_llega = t_base + float(k_rec - _servicio_anticipa(String(pase.get("control", "")))) \
				* SIM_DT - 0.1
	elif _servicio_chilena():



		var i_chi: int = i_mando - roundi(SERVICIO_CHILENA_ARRANQUE / SIM_DT)
		var al_arco_c: Vector2 = _servicio_al_arco(cita)
		var tt: float = clampf(inverse_lerp(HEADER_CONTACT_BAND.x, HEADER_CONTACT_BAND.y,
			cruce.y + BALL_VISUAL_D * 0.5), 0.0, 1.0)
		fin = _servicio_en_campo(cita - al_arco_c * lerpf(HEADER_STEP_LOW, HEADER_STEP_HIGH, tt))
		t_llega = t_base + float(i_chi) * SIM_DT - 0.1






	var llega: Vector2 = cita
	if k_rec >= 1 and k_rec < ruta_pase.size():
		llega = Vector2(ruta_pase[k_rec].x, ruta_pase[k_rec].z)
	var linea: Array[Vector2] = []
	for i in mini(int(pase["k"]) + 1, ruta_pase.size()):
		var q := Vector2(ruta_pase[i].x, ruta_pase[i].z)
		if q.distance_to(cita) > SERVICIO_YO_CITA and q.distance_to(llega) > SERVICIO_YO_CITA:
			linea.append(q)
	var regate: Array[Vector2] = []
	regate.assign(g.get("puntos", [Vector2(g["inicio"]), Vector2(g["giro"]), Vector2(g["hasta"])]))
	var gente: Array[Vector2] = []
	var srv: AnimatedSprite3D = _servicio_server()
	for a in _todos_actores() + [_keeper]:
		if not is_instance_valid(a) or a == srv:
			continue
		gente.append(Vector2(a.global_position.x, a.global_position.z))
		if _serve_mov.has(a):
			gente.append(Vector2(_serve_mov[a]["to"]))

	for q in g.get("suelo", []):
		gente.append(Vector2(q))
	var total: int = 0
	for tp in SERVICIO_YO_TIPOS:
		total += int(tp["peso"])
	for _intento in 12:
		var r: int = randi() % total
		var tp: Dictionary = SERVICIO_YO_TIPOS[0]
		for cand in SERVICIO_YO_TIPOS:
			r -= int(cand["peso"])
			if r < 0:
				tp = cand
				break
		var largo: float = randf_range(tp["largo"].x, tp["largo"].y)
		var giro: float = deg_to_rad(randf_range(- float(tp["giro"]), float(tp["giro"])))
		var ruta: Array[Vector2] = []
		match String(tp["tipo"]):
			"arranca":
				ruta = [e - al_arco.rotated(giro) * largo, fin]
			"apoyo":
				ruta = [e - al_pase.rotated(giro) * largo, fin]
			"se_ofrece":
				ruta = [e + fuera.rotated(giro) * largo, fin]
			"amaga":
				var ida: Vector2 = al_arco.rotated(giro)
				ruta = [e + ida * 0.8, e + ida * largo, fin]
			_:
				ruta = [e + Vector2.from_angle(giro) * largo, fin]
		if not _servicio_yo_valida(ruta, linea, gente, regate):
			continue
		var plan: Dictionary = _servicio_yo_plan(ruta, String(tp["tipo"]), t_llega, t_mando)
		if not plan.is_empty():
			return plan

	var recurso: Dictionary = _servicio_yo_recurso(e, fin, linea, gente, regate, t_llega, t_mando)
	if not recurso.is_empty():
		return recurso
	if t_llega > 0.0 and e.distance_to(fin) > 0.02:
		var desde: float = maxf(t_llega - SERVICIO_YO_ANTES.x, 0.0)




		var recta: Array[Vector2] = [e, fin]
		return {"ruta": recta, "desde": desde, "dur": t_llega - desde,
			"largo": e.distance_to(fin), "tipo": "planta"}
	return {}









func _servicio_yo_recurso(e: Vector2, fin: Vector2, linea: Array[Vector2],
		gente: Array[Vector2], regate: Array[Vector2], t_llega: float,
		t_mando: float) -> Dictionary:
	var recta: Array[Vector2] = [e, fin]
	if _servicio_yo_valida(recta, linea, gente, regate):
		var plan_e: Dictionary = _servicio_yo_plan(recta, "recta", t_llega, t_mando)
		if not plan_e.is_empty():
			return plan_e
	var mejor: Dictionary = {}
	var mejor_d: float = INF
	for largo in SERVICIO_YO_RECURSO:
		for j in SERVICIO_YO_RUMBOS:
			var s0: Vector2 = fin + Vector2.from_angle(TAU * float(j) / float(SERVICIO_YO_RUMBOS)) \
					* largo
			if s0.distance_to(e) >= mejor_d:
				continue
			var ruta: Array[Vector2] = [s0, fin]
			if not _servicio_yo_valida(ruta, linea, gente, regate):
				continue
			var plan: Dictionary = _servicio_yo_plan(ruta, "recurso", t_llega, t_mando)
			if not plan.is_empty():
				mejor = plan
				mejor_d = s0.distance_to(e)
	return mejor





func _servicio_yo_plan(ruta: Array[Vector2], tipo: String, t_llega: float,
		t_mando: float) -> Dictionary:
	var desde: float
	var dur: float
	if t_llega > 0.0:
		desde = maxf(t_llega - randf_range(SERVICIO_YO_ANTES.x, SERVICIO_YO_ANTES.y), 0.0)
		dur = t_llega - desde
	else:
		desde = maxf(t_mando - randf_range(SERVICIO_YO_ANTES.x, SERVICIO_YO_ANTES.y), 0.0)
		dur = t_mando + randf_range(SERVICIO_YO_TRAS.x, SERVICIO_YO_TRAS.y) - desde
	var metros: float = 0.0
	for i in range(1, ruta.size()):
		metros += ruta[i - 1].distance_to(ruta[i])


	if dur <= 0.0 or metros * 1.5 / dur > SERVICIO_YO_VMAX:
		return {}




	if metros < 1.0:
		return {}
	return {"ruta": ruta, "desde": desde, "dur": dur, "largo": metros, "tipo": tipo}




func _servicio_yo_valida(ruta: Array[Vector2], linea: Array[Vector2],
		gente: Array[Vector2], regate: Array[Vector2]) -> bool:
	for i in range(1, ruta.size()):
		var a: Vector2 = ruta[i - 1]
		var b: Vector2 = ruta[i]
		var n: int = maxi(ceili(a.distance_to(b) / 0.25), 1)
		for j in n + 1:
			var q: Vector2 = a.lerp(b, float(j) / float(n))
			if _servicio_en_campo(q).distance_to(q) > 0.01:
				return false
			for p in linea:
				if q.distance_to(p) < SERVICIO_YO_LIBRE:
					return false
			for o in gente:
				if q.distance_to(o) < SERVICIO_YO_GENTE:
					return false
			for k in range(1, regate.size()):
				if not _servicio_libre(q, regate[k - 1], regate[k], SERVICIO_YO_REGATE):
					return false
	return true





func _servicio_yo(t: float) -> bool:
	if _serve_yo.is_empty() or not is_instance_valid(_self_actor):
		return false
	var u: float = clampf((t - float(_serve_yo["desde"])) / float(_serve_yo["dur"]), 0.0, 1.0)
	if u <= 0.0:
		return false
	var s: float = float(_serve_yo["largo"]) * u * u *(3.0 - 2.0 * u)
	var ruta: Array[Vector2] = _serve_yo["ruta"]
	var q: Vector2 = ruta[ruta.size() - 1]
	for i in range(1, ruta.size()):
		var tramo: float = ruta[i - 1].distance_to(ruta[i])
		if s <= tramo:
			q = ruta[i - 1].lerp(ruta[i], s / maxf(tramo, 0.0001))
			break
		s -= tramo
	var antes := Vector2(_self_actor.global_position.x, _self_actor.global_position.z)
	_self_actor.global_position = Vector3(q.x, _self_actor.global_position.y, q.y)
	return antes.distance_to(q) > 0.0001




