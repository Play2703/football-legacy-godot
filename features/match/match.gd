var _tag_touched: AnimatedSprite3D = null
var _tag_finger: int = -1



const TAG_TOUCH_R: float = 80.0




func _track_tag_touch(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed:


			if _tag_finger == -1:
				_tag_finger = event.index
				_tag_touched = _actor_at(event.position)




				_tag_press_actor = _tag_touched
				_tag_press_pos = event.position
				_tag_press_ms = Time.get_ticks_msec()
		elif event.index == _tag_finger:
			_tag_finger = -1
			_tag_touched = null
			_maybe_order_tap(event.position)
			_tag_press_actor = null
	elif event is InputEventScreenDrag and event.index == _tag_finger:



		_tag_touched = _actor_at(event.position)





func _actor_at(screen_pos: Vector2) -> AnimatedSprite3D:
	var best: AnimatedSprite3D = null
	var best_d: float = TAG_TOUCH_R
	for pool in [_teammate_actors, _rival_actors, [_keeper, _self_actor]]:
		for a in pool:
			if not is_instance_valid(a) or _aim_cam.is_position_behind(a.global_position):
				continue
			var d: float = _aim_cam.unproject_position(
				a.global_position).distance_to(screen_pos)
			if d < best_d:
				best_d = d
				best = a
	return best





















