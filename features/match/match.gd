func _play_dir_gesture(actor: AnimatedSprite3D, prefix: String, toward: Vector2,
		hold_ms: int) -> bool:
	if actor == null or not is_instance_valid(actor) or actor.sprite_frames == null:
		return false
	var dir: Vector3 = Vector3(toward.x, 0.0, toward.y)
	if dir.length() < 0.01:
		dir = Vector3(0.0, 0.0, 1.0)
	var anim: String = "%s_%s" % [prefix, _dir_name(dir)]



	if not _gesto_listo(actor, anim):
		return false
	actor.play(anim)
	actor.speed_scale = 1.0
	_anim_lock[actor] = Time.get_ticks_msec() + hold_ms







	if (prefix == "slide" or prefix == "rodillas") and _audio != null:
		_audio.barrida()


	if prefix == "slide" or prefix == "rodillas" or prefix == "fall":
		_ensucia(actor)
	return true










func _play_slide_gesture(actor: AnimatedSprite3D, victima: Vector2 = Vector2.INF) -> void:
	if actor == null or not is_instance_valid(actor):
		return



	_slide_dir = Vector2.ZERO
	var a_ti: bool = victima.is_finite()
	var meta: Vector2 = victima if a_ti else _ball_field
	var hacia: Vector2 = Vector2(meta.x - actor.position.x, meta.y - actor.position.z)




	if _play_dir_gesture(actor, "slide", hacia, 900):



		actor.speed_scale = SLIDE_ANIM_SPEED
		if a_ti:
			var largo: float = maxf(hacia.length() - FALTA_PARA_M, 0.0)
			_slide_travel(actor, hacia, largo)
			_falta_contacto(_contacto_barrida(hacia.length(), largo,
				_slide_anim_secs(actor)))
		else:
			_slide_travel(actor, hacia)





			var d: float = hacia.length()
			_falta_contacto(_contacto_barrida(d,
				clampf(d * SLIDE_REACH, SLIDE_MIN_M, SLIDE_MAX_M), _slide_anim_secs(actor)))





	_splash_at(Vector2(actor.position.x, actor.position.z),
		Vector3(hacia.x, 0.0, hacia.y), 20.0)






const SLIDE_MIN_M: float = 1.1
const SLIDE_MAX_M: float = 2.4
const SLIDE_SCAR_W: float = 0.52








const SLIDE_ANIM_SPEED: float = 0.6






const ZANCADA_ANIM_SPEED: float = 0.6















const FALTA_PIERNA_M: float = 0.6
const FALTA_PARA_M: float = 0.3
const ZANCADA_LLEGA_M: float = 0.55
const ZANCADA_CONTACTO_S: float = 0.28



var _falta_contacto_s: float = 0.0
var _falta_contacto_f: int = -1


func _falta_contacto(segundos: float) -> void:
	_falta_contacto_s = maxf(segundos, 0.0)
	_falta_contacto_f = Engine.get_process_frames()





func _contacto_barrida(dist: float, largo: float, dur: float) -> float:
	if largo <= 0.0:
		return 0.0
	var f: float = clampf((dist - FALTA_PIERNA_M) / largo, 0.0, 1.0)
	return (1.0 - pow(1.0 - f, 1.0 / 3.0)) * dur








func _al_contacto(que: Callable) -> void:
	var espera: float = _falta_contacto_s \
			if _falta_contacto_f == Engine.get_process_frames() else 0.0
	if espera <= 0.02:
		que.call()
		return
	SceneFade.timer(espera, false).timeout.connect(_al_contacto_llega.bind(que,
		_self_actor.get_instance_id() if is_instance_valid(_self_actor) else 0))






func _al_contacto_llega(que: Callable, yo_id: int) -> void:
	if is_instance_valid(_self_actor) and _self_actor.get_instance_id() == yo_id:
		que.call()







func _al_contacto_siempre(que: Callable) -> void:
	var espera: float = _falta_contacto_s \
			if _falta_contacto_f == Engine.get_process_frames() else 0.0
	if espera <= 0.02:
		que.call()
		return
	SceneFade.timer(espera, false).timeout.connect(que)











