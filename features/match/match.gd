		var dir3: Vector3 = _pase_iman(_world_aim_dir(pull.normalized(), _aim_guide_elev()))


		var base3: Vector3 = dir3
		dir3 = _grada_tiembla(dir3)
		_aim.set_precision(_ctrl_precision())
		_feed_aim_launch()








		var ancla: Vector3 = _aim_ancla()

		_aim.set_cam_dist(_guia_cam_dist(ancla))
		_aim.show_aim(ancla, dir3, ratio)




		_ring_aim_dir = dir3
