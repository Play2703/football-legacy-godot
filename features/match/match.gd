	var a: Vector2 = Vector2(actor.position.x, actor.position.z)
	return de.distance_to(a) >= META_LARGO_M












const META_RUMBO_K: float = 0.25

























func _meta_receptor(lista: Array) -> AnimatedSprite3D:
	if _traj.is_empty():
		return null


	var last: int = _traj.size() - 1
	if _stop_i > 0:
		last = mini(last, _stop_i)
	var desde: int = clampi(_traj_i, 0, last)

	var fin: Vector2 = Vector2(_traj[last].x, _traj[last].z)
	var rumbo: Vector2 = fin - Vector2(_traj[0].x, _traj[0].z)
	var con_rumbo: bool = rumbo.length() > 1.0
	if con_rumbo:
		rumbo = rumbo.normalized()
	var ahora: int = Time.get_ticks_msec()
	var mejor: AnimatedSprite3D = null
	var mejor_d: float = INF
	for a in lista:


		if not is_instance_valid(a) or a == _meta_por or a.has_meta("hold_wall") \
				or a.has_meta("fk_run") or _anim_lock.get(a, 0) > ahora \
				or int(a.get_meta("caido_t", 0)) > ahora:
			continue
		var p: Vector2 = Vector2(a.position.x, a.position.z)
		var d: float = INF




		var j: int = desde
		while j < last:
			var k: int = mini(j + INTERCEPT_STEP, last)
			if _traj[j].y <= HEADER_MAX_H or _traj[k].y <= HEADER_MAX_H:
				var q: Vector2 = Geometry2D.get_closest_point_to_segment(p,
					Vector2(_traj[j].x, _traj[j].z), Vector2(_traj[k].x, _traj[k].z))
				d = minf(d, p.distance_to(q))
			j = k
		if d == INF:

			d = p.distance_to(fin)
		if con_rumbo:
			var rel: Vector2 = p - fin
			var mas_alla: float = rel.dot(rumbo)
			if mas_alla > 0.0:
				d = minf(d,(rel - rumbo * mas_alla).length() + mas_alla * META_RUMBO_K)
		if d < mejor_d:
			mejor_d = d
			mejor = a
	return mejor





func _meta_chance() -> Dictionary:
	_ensure_shapes()


	var lado: float = - _meta_lado_prev if _meta_lado_prev != 0.0 \
			else (-1.0 if randf() < 0.5 else 1.0)
	_meta_lado_prev = lado
	var ball: Vector2 = Vector2(lado * randf_range(META_BALL_X.x, META_BALL_X.y),
		META_BALL_Z)


	_set_gen_back(ball)















	var riv_id: String = String(GameState.current_rival().get("id", ""))
	var zona_riv: Dictionary = _meta_zona(_meta_zona_riv, META_LINEA_RIVAL)
	_meta_zona_riv = zona_riv["clave"]
	var zona_mia: Dictionary = _meta_zona(_meta_zona_mia, META_PIVOTE_Z)
	_meta_zona_mia = zona_mia["clave"]


	var linea: float = float(zona_riv["alto"]) -(_tac_bloque - 0.5) * META_LINEA_BLOQUE


	var xi: Array = _squad_hoy(_my_side_id()).slice(0, Squad.STARTING_XI)
	var yo_xi: int = Squad.user_index(xi)
	var mis_fichas: Array = []
	var yo_k: int = -1
	for i in xi.size():
		if String((xi[i] as Dictionary).get("pos", "")) == "POR":
			continue
		if i == yo_xi:
			yo_k = mis_fichas.size()
		mis_fichas.append(xi[i])
	var filas: Array = _meta_filas(_my_shape)

	var mis_huecos: Array = _meta_roles(_my_shape, _meta_huecos(_my_side_id(), xi))
	var mios: Array = _meta_salida_mia(filas, mis_huecos, ball, linea, zona_mia)
	var cen: Array = _meta_abre_centrales(mios, filas, mis_huecos)


	_meta_vacia_area(mios, cen, mis_huecos)
	mios = _meta_asienta(mios, [], ball, cen)



	var riv_fichas: Array = _meta_campo(_squad_hoy(riv_id))
	var riv_huecos: Array = _meta_roles(_rival_shape, _meta_huecos(riv_id, _squad_hoy(riv_id)))
	var filas_riv: Array = _meta_filas(_rival_shape)
	var rivales: Array = _meta_marca(filas_riv, riv_huecos, riv_fichas, mios, cen, ball,
		linea, zona_riv)



	rivales = _meta_zaga_cubre(rivales, filas_riv, mios)
	rivales = _meta_asienta(rivales, mios, ball)

	if yo_k < 0 or yo_k >= mios.size():
		yo_k = 0
		for k in mios.size():
			if (mios[k] as Vector2).y <(mios[yo_k] as Vector2).y:
				yo_k = k
	var tu: Vector2 = mios[yo_k]
	var mates: Array = mios.duplicate()
	mates.remove_at(yo_k)
	var mate_players: Array = mis_fichas.duplicate()
	if yo_k < mate_players.size():
		mate_players.remove_at(yo_k)
	_meta_sin_fuera(rivales, riv_fichas, false)
	_meta_sin_fuera(mates, mate_players, true)



	var press_roles: Array = []
	for i in rivales.size():
		if (rivales[i] as Vector2).distance_to(ball) < META_PRESS_R:
			press_roles.append(i)
	return {
		"kind": META_KIND,
		"name": "Salida de meta",
		"ball": ball,
		"defenders": rivales,
		"defender_players": riv_fichas,
		"teammates": mates,
		"mate_players": mate_players,
		"press_roles": press_roles,
		"motion_chance": 0.0,

		"correa": SALIDA_CORREA_R,
		"correa_ruptura": SALIDA_CORREA_RUPTURA,

		"meta_tu": tu,
	}







func _meta_sin_fuera(sitios: Array, fichas: Array, mine: bool) -> void:
	if MatchSim._fuera.is_empty() or sitios.size() != fichas.size():
		return
	for i in range(sitios.size() - 1, -1, -1):
		if sitios.size() <= 1:
			return
		if MatchSim.esta_fuera(mine, String((fichas[i] as Dictionary).get("name", ""))):
			sitios.remove_at(i)
			fichas.remove_at(i)









