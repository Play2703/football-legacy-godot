func _tutorial_demo_aim() -> Array:
	if _aim_cam == null or not is_instance_valid(_self_actor):
		return []
	var me: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
	var target: Vector3 = _tutorial_target_world()
	if target == Vector3.INF:
		return []
	var to_goal: Vector3 = target - me
	if to_goal.length() < 0.5:
		return []
	var ahead: Vector3 = me + to_goal.normalized() * 4.0


	if _aim_cam.is_position_behind(me) or _aim_cam.is_position_behind(ahead):
		return []
	var fwd: Vector2 = _aim_cam.unproject_position(ahead) \
			- _aim_cam.unproject_position(me)
	if fwd.length() < 4.0:
		return []






	var goal_c: Vector3 = Vector3(target.x, 1.0, target.z)
	var goal: Vector2 = Vector2.INF if _aim_cam.is_position_behind(goal_c) \
			else _aim_cam.unproject_position(goal_c)





	return [_ring_screen_center(), fwd, goal, _ring_radius_px(), _cross_mode]









func _tutorial_target_world() -> Vector3:
	if _recu:




		var al_arco: Vector2 = Vector2(0.0, Recupera.TARGET_Z) - _ball_field
		if al_arco.length() < 0.5:
			return Vector3.INF
		var goal_side: Vector2 = _ball_field + al_arco.normalized() * 3.0
		return Vector3(goal_side.x, 0.0, goal_side.y)
	if _duel_press and _press_libre:


		return Vector3(_ball_field.x, 0.0, Stadium.HALF_LINE)
	if _duel_press:

		return Vector3(_press_zone.x, 0.0, _press_zone.y)
	if is_instance_valid(_switch_target):


		return Vector3(_switch_target.position.x, 0.0, _switch_target.position.z)
	return Vector3(0.0, 0.0, 0.0)








