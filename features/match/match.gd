var _hist: Dictionary = {}


var _hist_mia: Dictionary = {}

var _hist_npc_dicha: bool = false





func _historia_arma(riv_id: String) -> void:
	_hist = {}
	_hist_mia = {}
	_hist_npc_dicha = false
	if riv_id.is_empty() or _nat_match() or Teams.by_id(riv_id).is_empty():
		return
	_hist_mia = TransferBook.trayectoria_propia(Career.start_club, Career.transfers,
		GameState.player_team_id, not Career.loan.is_empty())




	if not Career.loan.is_empty() and String(Career.loan.get("parent", "")) == riv_id:
		return
	var h: Dictionary = Commentary.historia(_hist_mia.get("etapas", []), riv_id,
		GameState.season_num)
	if h.is_empty():
		return
	_hist = {"id": riv_id, "club": TransferBook.nombre_de_etapa({"club": riv_id}),
		"via": h["via"], "temps": h["temps"], "hace": h["hace"]}








func _historia_npc(line: Dictionary) -> Dictionary:
	var seat: int = int(line.get("seat", -1))
	var nombre: String = String(line.get("name", ""))
	var riv_id: String = String(GameState.current_rival().get("id", ""))
	if _hist_npc_dicha or _nat_match() or seat < 0 or nombre.is_empty() \
			or riv_id.is_empty() or _hist_mia.is_empty():
		return {}
	var d: Dictionary = TransferBook.trayectoria_ficha(riv_id, seat,
		String(line.get("pos", "")), GameState.season_num)
	if bool(d.get("heredero", false)):
		return {}
	var yo: String = GameState.player_team_id
	var etapas: Array = d.get("etapas", [])
	var h: Dictionary = Commentary.historia(etapas, yo, GameState.season_num)
	var tramos: Array = TransferBook.solapan(_hist_mia.get("etapas", []),
		int(_hist_mia.get("desde", 1)), yo, etapas, int(d.get("desde", 0)), riv_id,
		GameState.season_num)

	var compa: String = "" if tramos.is_empty() \
			else TransferBook.nombre_de_etapa(tramos[tramos.size() - 1])
	if h.is_empty() and compa.is_empty():
		return {}
	var tag: String = "n:%s:%d" % [riv_id, seat]
	return {"npc": nombre, "npc_via": String(h.get("via", "")),
		"npc_temps": int(h.get("temps", 0)), "npc_en_club": not h.is_empty(),
		"npc_compa": compa, "npc_libre": Career.cronica_libre(tag), "hist_tag": tag}















func _fan_pressure_ruins() -> bool:
	if not _practice_kind.is_empty() or _tutorial_active or _shootout_active:
		return false
	var p: float = MatchPlan.fan_pressure_chance(_fan_rel)
	return p > 0.0 and randf() < p



















const BOUNCE_MARK_MAX: int = MatchFx.MARK_POOL

func _queue_mark(pos: Vector3, vy: float, at: int = -1) -> void:
	if _stadium == null or _bmarks.size() >= BOUNCE_MARK_MAX:
		return
	var w: String = _stadium.weather_id()
	if not WeatherWear.marks_on(w):
		return
	_bmarks.append({



		"i": at if at >= 0 else _traj.size() - 1,
		"p": pos,
		"d": WeatherWear.mark_size(vy),
		"col": WeatherWear.mark_color(w),
	})








func _play_splashes() -> void:
	if _fx == null:
		return
	while _splash_i < _splashes.size() \
			and int(_splashes[_splash_i]["i"]) <= _traj_i:
		var s: Dictionary = _splashes[_splash_i]
		_splash_i += 1
		_fx.splash_dir(s["d"])
		_fx.splash_burst(s["p"], float(s["power"]))
		if bool(s["snd"]) and _audio != null:
			_audio.splash(float(s["power"]))





func _play_marks(hasta: int = -1) -> void:
	if _fx == null:
		return


	var tope: int = _traj_i if hasta < 0 else hasta
	while _bmark_i < _bmarks.size() and int(_bmarks[_bmark_i]["i"]) <= tope:
		var m: Dictionary = _bmarks[_bmark_i]
		_bmark_i += 1
		_fx.ground_mark(m["p"], float(m["d"]), m["col"])






