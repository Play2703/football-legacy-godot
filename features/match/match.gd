func _barrida_lanza(seq: int) -> bool:
	if seq != _chance_seq or _barr_lanzada or _barr_actor == null \
			or not is_instance_valid(_barr_actor) \
			or (state != State.RUNUP and state != State.FLIGHT):
		return false
	var a: AnimatedSprite3D = _barr_actor as AnimatedSprite3D
	if a == null:
		return false
	var from: Vector3 = a.position
	var hacia: Vector2 = Vector2(_barr_punto.x - from.x, _barr_punto.z - from.z)
	if hacia.length() < 0.05:
		hacia = Vector2(0.0, 1.0)
	if not _play_dir_gesture(a, "slide", hacia, int((BARRIDA_TIRO_T + 0.35) * 1000.0)):
		return false
	a.speed_scale = SLIDE_ANIM_SPEED
	_barr_lanzada = true






	var dir: Vector2 = hacia.normalized()
	var largo: float = SLIDE_MAX_M
	var meta2: Vector2 = _inside_field(Vector2(from.x, from.z) + dir * largo)
	var to: Vector3 = Vector3(meta2.x, from.y, meta2.y)
	var ri: int = _rival_actors.find(a)
	var di: int = _duel_def_actors.find(a)


	if _barr_tw != null and _barr_tw.is_valid():
		_barr_tw.kill()
		_order_release(_barr_arrastra)
	a.set_meta("order_run", true)


	_run_target.erase(a)
	_barr_arrastra = a
	_barr_tw = create_tween()
	_barr_tw.tween_method(_slide_step.bind(a, from, to, ri, di), 0.0, 1.0,
		BARRIDA_TIRO_T).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)




	_barr_tw.tween_interval(0.35)
	_barr_tw.tween_callback(_order_release.bind(a))
	_slide_surco(from, to, BARRIDA_TIRO_T)
	_splash_at(Vector2(from.x, from.z), Vector3(dir.x, 0.0, dir.y), 20.0)
	return true







func _slide_step(t: float, actor: AnimatedSprite3D, from: Vector3, to: Vector3,
		ri: int, di: int) -> void:
	if not is_instance_valid(actor):
		return
	var p: Vector3 = from.lerp(to, t)
	actor.position = p
	if ri >= 0 and ri < _defender_pos.size():
		_defender_pos[ri] = Vector2(p.x, p.z)
	if di >= 0 and di < _duel_defs.size():
		_duel_defs[di] = Vector2(p.x, p.z)







func _slide_anim_secs(actor: AnimatedSprite3D) -> float:
	var sf: SpriteFrames = actor.sprite_frames
	var anim: String = actor.animation
	if sf == null or not sf.has_animation(anim):
		return 0.42



	var fps: float = maxf(sf.get_animation_speed(anim) * absf(actor.speed_scale), 1.0)
	return clampf(float(sf.get_frame_count(anim)) / fps, 0.25, 0.9)


























