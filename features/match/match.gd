func _fatigue_mult(p: Dictionary) -> float:
	if match_minute <= FATIGUE_MIN:
		return 1.0
	var t: float = clampf(float(match_minute - FATIGUE_MIN) / float(90 - FATIGUE_MIN),
		0.0, 1.0)
	var q: float = Squad.norm(p, "velocidad") if not p.is_empty() else 0.5
	return 1.0 - FATIGUE_DROP * t *(1.2 - 0.4 * q)













