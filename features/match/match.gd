		if not is_instance_valid(a) or i >= _defender_pos.size():
			continue


















		if a.has_meta("hold_wall"):
			continue
		sub.append(_defender_pos[i])
		sub_spd.append(_chaser_speed.get(a, AimPress.SPEED_FALLBACK))
		map.append(i)


	var sticky: Array[int] = []
	for k in map.size():
		if _press_last.has(map[k]):
			sticky.append(k)
	var out: Array[int] = []


	for k in Drive.pressers(sub, _ball_field, _press_n, Drive.PRESS_R, sticky, sub_spd):
		out.append(map[k])
	_press_last = out
	return out








