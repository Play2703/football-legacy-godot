		return
	if _ball_field.distance_to(_esl_1) <= ESLALON_R_1:
		_eslalon_suma(ESLALON_PAGA_1)
		return















	_eslalon_despega()
	if _esl_vida <= 0.0:





		_haptic(12)
		_audio.whistle()
		_eslalon_sortea_par()












