func _saque_vive(dt: float, centro: Vector2) -> void:
	if not _press_on or dt <= 0.0:
		return
	var robo: bool = _press_steal
	_press_steal = false
	_press_step(dt)
	_press_steal = robo
	_saque_respeto(centro)















func _saque_respeto(centro: Vector2) -> void:
	var tk: Array = _rival_tackles()
	for i in mini(_rival_actors.size(), _defender_pos.size()):
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or a == _keeper:
			continue
		var keep: float = Duel.steal_radius(_drive_control,
			float(tk[i]) if i < tk.size() else Duel.NEUTRAL_TACKLE) \
					+ Settings.dif_reach_off() + SAQUE_RESPETO_M

		if _recep_libre:
			keep = maxf(keep, RECEP_LIBRE_M)
		var d: Vector2 = _defender_pos[i] - centro
		if d.length() >= keep:
			continue
		if d.length() < 0.01:
			d = Vector2(0.0, -1.0)
		var n: Vector2 = d.normalized()
		var p: Vector2 = centro + n * keep
		_defender_pos[i] = p
		a.position.x = p.x
		a.position.z = p.y





		if _mark_of.has(i):
			var vm: Vector2 = _mark_vels.get(i, Vector2.ZERO)
			vm -= n * minf(vm.dot(n), 0.0)
			_mark_vels[i] = vm
			if vm.length() <= 0.1:
				_run_target.erase(a)
		elif i < _press_vels.size():
			var v: Vector2 = _press_vels[i]
			v -= n * minf(v.dot(n), 0.0)
			_press_vels[i] = v
			if v.length() <= 0.1:
				_run_target.erase(a)











func _saque_recibe(yo: AnimatedSprite3D, venia: Vector2, pecho: bool = false,
		t_falta: float = -1.0) -> bool:
	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + HEADER_GESTO_BUDGET_US)
	yo.flip_h = false
	var hold: int = CHEST_HOLD_MS if pecho else CONTROL_HOLD_MS
	if not _play_dir_gesture(yo, "chest" if pecho else "control", venia, hold):
		return false
	if t_falta >= 0.0:
		var fps: float = maxf(yo.sprite_frames.get_animation_speed(yo.animation), 1.0)
		var kc: int = _recep_cuadro(pecho, fps, t_falta)
		if kc > 0:
			yo.set_frame_and_progress(kc, 0.0)
			hold = maxi(hold - roundi(float(kc) * 1000.0 / fps), 1)
			_anim_lock[yo] = Time.get_ticks_msec() + hold
	SceneFade.timer(hold / 1000.0, false).timeout \
			.connect(_control_gesto_fin.bind(yo))
	return true




func _saque_trota(srv: AnimatedSprite3D, dt: float) -> void:
	if dt <= 0.0 or not is_instance_valid(srv):
		return
	var lado: float = signf(srv.position.x)
	var x_meta: float = lado *(FIELD_EDGE - SAQUE_DENTRO_M)
	var falta: float = x_meta - srv.position.x
	if absf(falta) < 0.05:
		return
	srv.position.x += signf(falta) * minf(SAQUE_TROTE * dt, absf(falta))
	_play_run(srv, Vector3(signf(falta), 0.0, 0.0), "run_")


















