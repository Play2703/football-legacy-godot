	if not contragolpe_en_partido:
		return false
	if not _practice_kind.is_empty() or _tutorial_active or _shootout_active:
		return false
	if not _contra_hay_rival():
		return false
	if _rival_expulsados <= _expulsados_mios.size() or _super_played >= SUPER_PER_MATCH:
		return false
	if c < DUEL_FIRST_CHANCE or c > _chances_this_match:
		return false
	for otras in [_super_chances, _contra_chances, _meta_chances, _press_chances,
			_recu_chances, _servicio_chances]:
		if (otras as Array).has(c) or (otras as Array).has(c - 1) \
				or (otras as Array).has(c + 1):
			return false
	return true


func _superioridad_toca(c: int) -> bool:
	return _superioridad_cabe(c) and _contra_rng(c, "superioridad").randf() < SUPER_P


