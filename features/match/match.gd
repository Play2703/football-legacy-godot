		return
	if not _recu_suelta and not _recu_pase \
			and _recu_yo.distance_to(_recu_pos) <= RECU_BARRE_CUERPO_R:
		var su_rumbo: Vector2 = _recu_vel.normalized() if _recu_vel.length() > 0.3 \
				else Vector2(0.0, Recupera.DIR)
		if _recu_yo_bdir.dot(su_rumbo) > 0.2:
			_recu_finish("falta")




















































func _recu_tumba_portador(rumbo: Vector2) -> void:
	if not is_instance_valid(_recu_actor):
		return


	if rumbo.length() > 0.01:
		_recu_suelo_dir = rumbo
	var hacia: Vector2 = _recu_suelo_dir if _recu_suelo_dir.length() > 0.01 \
			else Vector2(0.0, Recupera.DIR)

	var suelo_ms: int = int(_recu_rival_suelo * 1000.0)
	if suelo_ms <= 0:
		return
	var hasta: int = Time.get_ticks_msec() + suelo_ms


	if int(_recu_actor.get_meta("caido_t", 0)) > Time.get_ticks_msec():
		_anim_lock[_recu_actor] = maxi(int(_anim_lock.get(_recu_actor, 0)), hasta)
		_recu_actor.set_meta("caido_t",
			maxi(int(_recu_actor.get_meta("caido_t", 0)), hasta))
		return





	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + RECU_BARRIDA_BUDGET_US)
	if not _play_dir_gesture(_recu_actor, "fall", hacia, suelo_ms):
		return






	_recu_actor.set_meta("caido_t", hasta)





	_chase_vels.erase(_recu_actor)


	if _recu_actor.has_meta("carga_t0"):
		_recu_actor.remove_meta("carga_t0")




