func _world_drift(a: AnimatedSprite3D, delta: float) -> void:
	var pos: Vector2 = Vector2(a.position.x, a.position.z)
	if not _home_pos.has(a):
		_home_pos[a] = pos
		_amb_phase[a] = randf() * TAU



















	var goal: Vector2 = _inside_field(_block_home(a, false))






	if _duel_press and _press_zone != Vector2.ZERO:
		goal = _push_out(goal, _press_zone, PRESS_ZONE_R + 1.2)















	var es_rival: bool = _rival_set.has(a)
	var d_bola: float = pos.distance_to(_ball_field)


















	var recupera: bool = es_rival and not _mundo_viejo \
			and pos.y > _ball_field.y + WORLD_COVER_GAP




























	var achica: bool = es_rival and not recupera and not _mundo_viejo \
			and d_bola < WORLD_ACHICA_R \
			and absf(pos.x - _ball_field.x) < WORLD_ACHICA_LANE
	if recupera:
		goal = _ball_field
	elif achica:




		var hacia_b: Vector2 = pos - _ball_field
		var dh: float = maxf(hacia_b.length(), 0.001)
		goal = _inside_field(_ball_field + hacia_b / dh * WORLD_ACHICA_HOLD)
	else:
		goal = _push_out(goal, _ball_field, PRESS_WORLD_CLEAR)

























	if es_rival and not recupera and not achica:












		if pos.y <= _ball_field.y - WORLD_COVER_GAP:
			goal.y = maxf(goal.y, pos.y)



			if d_bola < PRESS_WORLD_CLEAR:
				var lado_x: float = signf(pos.x - _ball_field.x)
				if lado_x == 0.0:
					lado_x = 1.0
				goal.x = clampf(_ball_field.x + lado_x * PRESS_WORLD_CLEAR,
					- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0)
		goal.y = minf(goal.y, _ball_field.y - WORLD_COVER_GAP)
	elif not es_rival:









		goal.y +=(_ball_field.y - _home_ball0.y) *(1.0 - HOME_SHIFT_Z)
		goal = _inside_field(goal)
		goal = _push_out(goal, _ball_field, PRESS_WORLD_CLEAR)




















































		if not _mundo_viejo:
			var techo_z: float = minf(pos.y, _ball_field.y)
			if goal.y < techo_z:
				goal.y = techo_z




				if goal.distance_to(_ball_field) < PRESS_WORLD_CLEAR:
					var lado_m: float = signf(goal.x - _ball_field.x)
					if lado_m == 0.0:
						lado_m = signf(pos.x - _ball_field.x)
					if lado_m == 0.0:
						lado_m = 1.0
					goal.x = clampf(_ball_field.x + lado_m * PRESS_WORLD_CLEAR,
						- Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0)















	var tope: float = AMBIENT_SPD
	if d_bola < PRESS_WORLD_CLEAR:
		tope = lerpf(AMBIENT_SPD, WORLD_CLEAR_SPD,
			clampf(1.0 - d_bola / PRESS_WORLD_CLEAR, 0.0, 1.0))





	if not es_rival:
		var d_sitio: float = pos.distance_to(goal)
		if d_sitio > PRESS_WORLD_CLEAR:
			tope = maxf(tope, lerpf(AMBIENT_SPD, WORLD_MATE_RUN_SPD,
				clampf((d_sitio - PRESS_WORLD_CLEAR) / 6.0, 0.0, 1.0)))








	if es_rival and (pos.y > _ball_field.y or achica):
		tope = maxf(tope, WORLD_CLEAR_SPD)
	var np: Vector2 = pos.move_toward(goal, tope * delta)
	var moved: Vector2 = np - pos
	a.position = Vector3(np.x, a.position.y, np.y)



	if moved.length() > 0.0005:
		_play_run(a, Vector3(moved.x, 0.0, moved.y))
		_no_deslices(a, pos)
	else:
		_face_ball(a)





























func _no_deslices(a: AnimatedSprite3D, antes: Vector2) -> bool:
	if not String(a.animation).begins_with("idle"):
		return false
	a.position = Vector3(antes.x, a.position.y, antes.y)
	return true


func _duel_world_step(delta: float) -> void:
	if _duel_world_rivals.is_empty() and _duel_world_mates.is_empty():
		return
	_amb_t += delta
	for a in _duel_world_rivals:
		if is_instance_valid(a):
			_world_drift(a, delta)
	for a in _duel_world_mates:
		if is_instance_valid(a):
			_world_drift(a, delta)















func _duel_onside_z() -> float:
	var z: float = _duel_hold_z if not is_inf(_duel_hold_z) else _duel_target_z
	return minf(z, _ball_field.y)


func _duel_mundo_step(delta: float) -> void:



	_def_cut_fit(_duel_defs.size())



	_duel_world_step(delta)












	var presor_d: float = INF
	for d in _duel_defs:
		presor_d = minf(presor_d,(d as Vector2).distance_to(_ball_field))
	var fijaste: bool = presor_d < Duel.FIX_TRIGGER_D
	for i in _duel_mates.size():
		var m: Vector2 = _duel_mates[i]
		_duel_mate_cd[i] = maxf(_duel_mate_cd[i] - delta, 0.0)
		if _duel_mate_burst[i] > 0.0:
			_duel_mate_burst[i] -= delta
		elif _duel_mate_cd[i] <= 0.0 and fijaste and Duel.covered(m, _duel_defs):
			_duel_mate_burst[i] = Duel.BURST_T
			_duel_mate_cd[i] = Duel.BURST_T + Duel.BURST_CD
		var burst: bool = _duel_mate_burst[i] > 0.0




		var mdir: Vector2
		if not burst and i == _duel_wide_i:
			mdir = Duel.wide_run(m, Stadium.FIELD_HALF_W)
		else:
			mdir = Duel.mate_run(m, _mate_marker(i, m), _ball_field, burst)
		var f: float = Duel.MATE_BURST_F if burst else Duel.MATE_DRIFT_F
















		var onside_z: float = _duel_onside_z()
		var m_antes: Vector2 = m
		m = Duel.step_mate(m, mdir, _duel_chase_spd * f, delta,
			onside_z, _duel_target_z, Stadium.FIELD_HALF_W)
		_duel_mates[i] = m
		_duel_mate_dir[i] = mdir
		if i < _duel_mate_actors.size() and is_instance_valid(_duel_mate_actors[i]):
			var ma: AnimatedSprite3D = _duel_mate_actors[i]
			ma.position = Vector3(m.x, ma.position.y, m.y)





			if mdir.length_squared() > 0.0001 \
					and m.y <= onside_z + Duel.ONSIDE_SLACK + 0.001 \
					and (m - m_antes).dot(mdir) <= 0.0:
				ma.set_meta("de_frente_hasta", Time.get_ticks_msec() + DE_FRENTE_MS)







			if burst:
				ma.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
			_play_run(ma, Vector3(mdir.x, 0.0, mdir.y))


	var ball_chaser: int = -1
	var bc_d: float = INF
	for i in _duel_defs.size():
		if (i < _duel_def_marks.size() and int(_duel_def_marks[i]) >= 0):
			continue
		var d_ball: float = _duel_defs[i].distance_to(_ball_field)
		if d_ball < bc_d:
			bc_d = d_ball
			ball_chaser = i



















	var presor: int = -1
	var pr_d: float = INF
	for i in _duel_defs.size():
		if i < _duel_def_marks.size() and int(_duel_def_marks[i]) >= 0:
			continue
		var d_p2: float = _duel_defs[i].distance_to(_ball_field)
		if d_p2 < pr_d:
			pr_d = d_p2
			presor = i




	var holder: int = -1
	var holder_z: float = INF
	for i in _duel_defs.size():
		if i == ball_chaser \
				or (i < _duel_def_marks.size() and int(_duel_def_marks[i]) >= 0):
			continue
		if Duel.contains(_duel_defs[i], _ball_field, _tac_engage) \
				and _duel_defs[i].y < holder_z:
			holder_z = _duel_defs[i].y
			holder = i





	var pinch_p: Vector2 = Duel.pinch_point(_ball_field, _vel_anticipada(),
		_duel_target_z + 0.5)



	var pincher: int = -1
	var pinch_d: float = INF
	var pinch_spares: int = 0
	for i in _duel_defs.size():
		if i == ball_chaser or i == holder \
				or (i < _duel_def_marks.size() and int(_duel_def_marks[i]) >= 0):
			continue
		pinch_spares += 1
		if not Duel.can_pinch(_duel_defs[i], _ball_field):
			continue
		var d_p: float = _duel_defs[i].distance_to(pinch_p)
		if d_p < pinch_d:
			pinch_d = d_p
			pincher = i
	if pinch_spares < Duel.PINCH_MIN_SPARES:
		pincher = -1








	var flying: Dictionary = _lance_step(delta, _duel_defs, _duel_def_vels,
		_duel_def_actors)


	var mi_pace: float = clampf(_duel_vel.length() / maxf(_duel_run_spd, 0.01), 0.0, 1.0)
	for i in _duel_defs.size():


		if flying.has(i):
			continue




		if float(_lance_cool.get(i, 0.0)) > 0.0:
			_duel_def_vels[i] = Vector2.ZERO
			continue






























		if i == presor and i < _duel_def_hold.size():
			_duel_def_hold[i] = 0.0


























		if not _post_pasado_off \
				and i < _duel_def_hold.size() and _duel_def_hold[i] > 0.0 \
				and i < _duel_def_post.size() and _duel_def_post[i] != Vector2.INF \
				and _duel_def_post[i].y >= _ball_field.y - PRESS_POST_PASADO_M:
			_duel_def_hold[i] = 0.0
		if i < _duel_def_hold.size() and _duel_def_hold[i] > 0.0:











			var post_i: Vector2 = _duel_def_post[i] if i < _duel_def_post.size() \
					else Vector2.INF
			var yendo_aun: bool = i < _duel_def_ruta.size() and _duel_def_ruta[i] \
					and post_i != Vector2.INF \
					and _duel_defs[i].distance_to(post_i) > PRESS_POST_SNAP
			_duel_def_hold[i] = 0.0 \
					if not yendo_aun \
					and _duel_defs[i].distance_to(_ball_field) <= PRESS_GUARD_WAKE \
					else _duel_def_hold[i] - delta
			if _duel_def_hold[i] > 0.0:





				var post: Vector2 = _duel_def_post[i] if i < _duel_def_post.size() \
						else Vector2.INF
				var yendo: Vector2 = Vector2.ZERO
				if post != Vector2.INF \
						and _duel_defs[i].distance_to(post) > PRESS_POST_SNAP:




					var spd_p: float =(_duel_def_spds[i] if i < _duel_def_spds.size() \
							else _duel_chase_spd) \
							*(1.0 if (i < _duel_def_ruta.size() and _duel_def_ruta[i])
							else PRESS_POST_SPD_F)
					var np_g: Vector2 = _duel_defs[i].move_toward(post, spd_p * delta)
					yendo =(np_g - _duel_defs[i]) / maxf(delta, 0.0001)
					_duel_defs[i] = np_g
				_duel_def_vels[i] = yendo
				if i < _duel_def_actors.size() and is_instance_valid(_duel_def_actors[i]):
					var ga: AnimatedSprite3D = _duel_def_actors[i]
					var antes_g: Vector2 = Vector2(ga.position.x, ga.position.z)
					ga.position = Vector3(_duel_defs[i].x, ga.position.y, _duel_defs[i].y)


					if yendo.length() > 0.05:
						_play_run(ga, Vector3(yendo.x, 0.0, yendo.y))




						if _no_deslices(ga, antes_g):
							_duel_defs[i] = antes_g
							_duel_def_vels[i] = Vector2.ZERO
					else:
						_face_ball(ga)
				continue











		var lee_i: float = _duel_def_leads[i] if i < _duel_def_leads.size() else 0.0
		var act_i: AnimatedSprite3D = _duel_def_actors[i] \
				if i < _duel_def_actors.size() else null





		if act_i != null and is_instance_valid(act_i) \
				and (_duel_def_marks[i] if i < _duel_def_marks.size() else -1) < 0 \
				and i != holder \
				and _lance_wants(i, act_i, mi_pace, _duel_defs, _duel_def_vels, lee_i):



			var sto: Vector2 = _ball_field + _duel_vel * LANCE_LEAD_T
			var sd: Vector2 =(sto - _duel_defs[i]).normalized()
			_lance_t[i] = LANCE_T
			_lance_from[i] = _duel_defs[i]
			_lance_to[i] = sto
			_lance_team_cd = LANCE_T + LANCE_TEAM_CD
			_play_dir_gesture(act_i, "slide", sd, int(LANCE_T * 1000.0))
			continue



		_zancada_cd[i] = maxf(float(_zancada_cd.get(i, 0.0)) - delta, 0.0)
		if act_i != null and is_instance_valid(act_i) \
				and float(_zancada_cd[i]) <= 0.0 \
				and _duel_defs[i].distance_to(_ball_field) < ZANCADA_R:
			if _zancada_duelo(act_i, _ball_field - _duel_defs[i]):
				_zancada_cd[i] = ZANCADA_CD
		var target: Vector2 = Duel.hunt_point(_ball_field, _vel_anticipada(), _duel_defs[i],
			lee_i, _lee_lado * MEM_M * lee_i)
		var mark: int = _duel_def_marks[i] if i < _duel_def_marks.size() else -1
		if mark >= 0 and mark < _duel_mates.size():
			target = Duel.cover_point(_duel_mates[mark], _duel_mate_dir[mark])






			if not _duel_carga_off and not _duel_intencion_off \
					and Duel.should_shoulder(_duel_defs[i], _duel_mates[mark],
					_duel_mate_vel(mark),
					_duel_def_leads[i] if i < _duel_def_leads.size() else 0.0,
					_duel_def_pesos[i] if i < _duel_def_pesos.size() else Duel.PESO_NEUTRO):
				target = Duel.shoulder_point(_duel_mates[mark],
					_duel_mate_vel(mark), _duel_defs[i])
		elif not _tapa_off and not _duel_intencion_off \
				and _duel_defs[i].y > _ball_field.y + TAPA_BEATEN_M:



























			var spd_i: float = _duel_def_spds[i] if i < _duel_def_spds.size() \
					else DUEL_CHASE_SPD.x
			var corte: Vector2 = Duel.intercept_point(_ball_field, _vel_anticipada(),
				_duel_defs[i], spd_i)
			target = _inside_field(corte) if corte != Vector2.INF \
					else Duel.cover_goal_point(_ball_field)
		elif i == holder:


			target = Duel.contain_point(_ball_field, _vel_anticipada(),
				_duel_target_z + 0.5, _tac_contain)
		elif i == pincher \
				and _duel_defs[i].distance_to(_ball_field) > _tac_engage:



			target = pinch_p
		elif i != ball_chaser:
			var danger: int = -1
			var danger_z: float = INF
			for mi in _duel_mates.size():
				if _duel_mates[mi].y < danger_z \
						and Duel.free_mate(_duel_mates[mi], _duel_defs, i):
					danger_z = _duel_mates[mi].y
					danger = mi
			if danger >= 0:
				target = Duel.cover_point(_duel_mates[danger], _duel_mate_dir[danger])









				if not _duel_carga_off and not _duel_intencion_off \
						and Duel.should_shoulder(_duel_defs[i],
						_duel_mates[danger], _duel_mate_vel(danger),
						_duel_def_leads[i] if i < _duel_def_leads.size() else 0.0,
						_duel_def_pesos[i] if i < _duel_def_pesos.size() else Duel.PESO_NEUTRO):
					target = Duel.shoulder_point(_duel_mates[danger],
						_duel_mate_vel(danger), _duel_defs[i])


		var spd: float = _duel_def_spds[i] if i < _duel_def_spds.size() else _duel_chase_spd



		spd *= _puddle_slow(_duel_defs[i])
		var k: float = _duel_def_ks[i] if i < _duel_def_ks.size() else Duel.CHASE_ACCEL_K





		if i == ball_chaser and mark < 0 and Duel.should_jockey(_duel_defs[i],
				_ball_field, _duel_pos,
				_duel_def_leads[i] if i < _duel_def_leads.size() else 0.0,
				_duel_vel.length() / maxf(_duel_run_spd, 0.01)):
			target = Duel.jockey_point(_ball_field, _duel_target_z + 0.5)
			spd *= Duel.JOCKEY_SPD_F























		elif mark < 0 and not _duel_carga_off and not _duel_intencion_off \
				and Duel.should_shoulder(_duel_defs[i], _duel_pos, _duel_vel,
				_duel_def_leads[i] if i < _duel_def_leads.size() else 0.0,
				_duel_def_pesos[i] if i < _duel_def_pesos.size() else Duel.PESO_NEUTRO,
				_duel_defs[i].distance_to(_ball_field), 0.0, _shoulder_swing):
			target = Duel.shoulder_point(_duel_pos, _duel_vel, _duel_defs[i])




		var out: Array = Duel.step_defender_cut(_duel_defs[i], _duel_def_vels[i],
			target, spd, delta, k, _npc_cut_agil(k),
			_duel_def_cut_armed[i], _duel_def_cut_recov[i])
		_duel_defs[i] = out[0]
		_duel_def_vels[i] = out[1]
		_duel_def_cut_armed[i] = out[2]
		_duel_def_cut_recov[i] = out[3]


		if i < _duel_def_actors.size() and is_instance_valid(_duel_def_actors[i]):
			var a: AnimatedSprite3D = _duel_def_actors[i]
			a.position = Vector3(_duel_defs[i].x, a.position.y, _duel_defs[i].y)






			if (out[1] as Vector2).length() > 0.1 \
					and _anim_lock.get(a, 0) <= Time.get_ticks_msec():
				_play_run(a, Vector3((out[1] as Vector2).x, 0.0,(out[1] as Vector2).y))
	_carga_duel(delta)
	_relax_duel()



























	if not _duel_press and not _duel_open and not _mundo_viejo:
		_press_recluta_cercanos(true)























func _duel_cam_yaw_step(delta: float) -> void:
	var eje: float = _axis_dyaw()
	if _duel_cam_yaw_set:
		_duel_cam_yaw = lerp_angle(_duel_cam_yaw, eje,
			1.0 - exp(- DUEL_CAM_YAW_STIFF * delta))
	else:
		_duel_cam_yaw = eje
		_duel_cam_yaw_set = true


func _duel_camera(delta: float, pace_now: float) -> void:
	_carga_kick_step(delta)













	var ancla_cam: Vector3 = _ball.global_position
	if _recu and is_instance_valid(_self_actor):
		ancla_cam = Vector3(_self_actor.position.x, _ball.global_position.y,
			_self_actor.position.z)
	var cam_goal: Vector3 = ancla_cam + _bowl_off(ancla_cam,
		(_duel_cam_off * _open_zoom).rotated(Vector3.UP, _duel_cam_yaw)
		+ _carga_kick)



	cam_goal.y += _grua_alto



	if _recu_viaje_t > 0.0:
		_recu_viaje_t = maxf(_recu_viaje_t - delta, 0.0)






		var meta_v: Vector3 = cam_goal
		if is_instance_valid(_self_actor):
			meta_v = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z) \
					+(cam_goal - ancla_cam)
		_aim_cam.global_position = _recu_viaje_p0.lerp(meta_v,
			smoothstep(0.0, 1.0, 1.0 - _recu_viaje_t / RECU_VIAJE_T))
	else:
		_aim_cam.global_position = _aim_cam.global_position.lerp(cam_goal,
			1.0 - exp(- DUEL_CAM_STIFF * delta))

















	var want_lead: Vector2 = _duel_facing
	if _duel_press and _press_libre:



		var to_meta: Vector2 = Vector2(_ball_field.x, Stadium.HALF_LINE) - _ball_field
		want_lead = to_meta.normalized() if to_meta.length() > 0.5 else _duel_facing
	elif _duel_press:
		var to_zone: Vector2 = _press_zone - _ball_field
		want_lead = to_zone.normalized() if to_zone.length() > 0.5 else _duel_facing
	else:
		want_lead =(Vector2(0.0, -1.0) + _duel_facing * DUEL_CAM_LEAD_MIX).normalized()
	if want_lead.length_squared() < 0.0001:
		want_lead = _duel_cam_lead
	want_lead = want_lead.normalized()
	var lead_t: float = 1.0 - exp(- DUEL_CAM_LEAD_STIFF * delta)
	if _duel_press:










		_duel_cam_lead = _duel_cam_lead.rotated(
			_duel_cam_lead.angle_to(want_lead) * lead_t).normalized()
	else:
		_duel_cam_lead = _duel_cam_lead.lerp(want_lead, lead_t).normalized()




	var ritmo_lead: float = 1.0 if Settings.reduce_motion \
			else lerpf(CAM_LEAD_RITMO_MIN, 1.0, pace_now)
	_cam_lead_ritmo = lerpf(_cam_lead_ritmo, ritmo_lead, lead_t)






	var duel_look: Vector3 = ancla_cam + Vector3(0.0, 0.4, 0.0) \
			+ Vector3(_duel_cam_lead.x, 0.0, _duel_cam_lead.y) \
			*(DUEL_CAM_LEAD_M * _cam_lead_ritmo)









	if not _duel_press and not _recu:
		duel_look = duel_look.lerp(Vector3(0.0, CROSSBAR_H, 0.0), DRIVE_CAM_GOAL_LOOK)




	var duel_yo: Vector3 = _ball.global_position
	if is_instance_valid(_self_actor):
		duel_yo = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)











	var look_stiff: float = DUEL_CAM_STIFF
	if _recu_viaje_t > 0.0:
		look_stiff = lerpf(RECU_VIAJE_LOOK_STIFF, DUEL_CAM_STIFF,
			smoothstep(0.0, 1.0, 1.0 - _recu_viaje_t / RECU_VIAJE_T))





	_drive_look_lift(duel_look, duel_yo, delta, look_stiff)













	if _recu_viaje_t > 0.0:
		pass
	elif is_instance_valid(_self_actor):




		_weld_cam_lateral(duel_yo +(cam_goal - ancla_cam), delta, duel_yo)
	else:
		_weld_cam_lateral(cam_goal, delta)

































	if _recu_viaje_t > 0.0:
		_fx_roll = 0.0
		_fx_facing_prev = _duel_facing
	else:
		_fx_apply_roll(delta, _duel_facing)


func _update_duel(delta: float) -> void:


	if _recu:
		_update_recu(delta)
		return
	if not _duel_active:
		return


	if _cano_vivo:
		_cano_mundo(delta)
		return





	_duel_cam_yaw_step(delta)






