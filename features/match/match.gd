func _eslalon_marcador() -> Vector2:
	var mejor: Vector2 = _ball_field + Vector2(0.0, 2.5)
	var d: float = INF
	for pos in _duel_defs:
		var dd: float = _ball_field.distance_squared_to(pos)
		if dd < d:
			d = dd
			mejor = pos
	return mejor





func _eslalon_caja(p: Vector2) -> Vector2:
	var lim: float = minf(ESLALON_CAJA_R, FIELD_EDGE - ESLALON_R_1)
	return Vector2(
		clampf(p.x, - lim, lim),
		clampf(p.y, Stadium.HALF_LINE - ESLALON_CAJA_R,
			Stadium.HALF_LINE + ESLALON_CAJA_R))














func _eslalon_sortea_par() -> void:
	var yo: Vector2 = _ball_field
	var hacia: Vector2 = _eslalon_marcador() - yo
	if hacia.length_squared() < 0.01:
		hacia = Vector2(0.0, 1.0)
	hacia = hacia.normalized()
	var d3: float = randf_range(ESLALON_D.x, ESLALON_D.y)
	var d1: float = randf_range(ESLALON_D.x, ESLALON_D.y)
	_esl_3 = _eslalon_caja(yo + hacia.rotated(randf_range(-0.6, 0.6)) * d3)













	var mejor: Vector2 = Vector2.ZERO
	var mejor_d: float = -1.0
	for i in ESLALON_INTENTOS:
		var giro: float = randf_range(-0.9, 0.9) if i == 0 \
				else TAU * float(i) / float(ESLALON_INTENTOS)
		var cand: Vector2 = _eslalon_caja(yo +(- hacia).rotated(giro) * d1)
		var dd: float = cand.distance_to(_esl_3)
		if dd > mejor_d:
			mejor_d = dd
			mejor = cand
		if dd >= ESLALON_SEP_MIN:
			break








	if mejor_d < ESLALON_SEP_MIN:
		var centro: Vector2 = Vector2(0.0, Stadium.HALF_LINE)
		var fuga: Vector2 = centro - _esl_3
		if fuga.length_squared() < 0.01:
			fuga = Vector2(1.0, 0.0)
		mejor = _eslalon_caja(_esl_3 + fuga.normalized() *(ESLALON_SEP_MIN + 1.0))
	_esl_1 = mejor
	_esl_vida = ESLALON_VIDA
	_eslalon_muestra()
	_eslalon_maquina()





func _eslalon_suma(pts: int) -> void:
	_encargo_hechos += pts
	var need_e: int = int(_encargo.get("need", 1))
	var e_antes: int = Encargo.estrellas(_encargo_hechos - pts, need_e)
	var e_ahora: int = Encargo.estrellas(_encargo_hechos, need_e)
	if is_instance_valid(_hud):
		if e_ahora > e_antes:
			_hud.show_points("★".repeat(e_ahora), CareerTheme.MONEY, true)
		else:
			_hud.show_points("+%d" % pts, CareerTheme.GOOD, pts >= 2)
	if e_ahora > e_antes:
		_audio.roar()
		_haptic(70)
	else:
		_audio.net()
		_haptic(30 + pts * 12)




	_press_tire_pend = minf(_press_tire_pend + _press_respiro, 1.0)
	_eslalon_sortea_par()






func _eslalon_step(delta: float) -> void:





	if _press_armed:
		_dianas_arrancado = true

	_esl_fatiga = _carry_fatigue



	if _esl_repone > 0.0:
		_esl_repone -= delta
