		"p": pos + Vector3(0.0, 0.06, 0.0),
		"d": Vector3(vel.x, 0.0, vel.z),
		"power": power,
		"snd": loud,
	})


















var _talk: Commentary = Commentary.new()




const TALK_COLOR: Color = Color("e8e4dc")
const TALK_HOLD: float = 3.2
const TALK_GOAL_DELAY: float = 2.6




func _say(kind: String, delay: float = 0.0, extra: Dictionary = {}) -> void:



	if not _practice_kind.is_empty() or _tutorial_active or _shootout_active \
			or _hud == null:
		return
	var f: Dictionary = GameState.current_fixture()



	var rival_f: Dictionary = GameState.current_rival()
	var estilo_riv: String = "" if rival_f.is_empty() else String(Tactics.profile(
		String(rival_f.get("id", "")),
		int(rival_f.get("rating", 62))).get("estilo", ""))
	var ctx: Dictionary = {
		"minute": match_minute,
		"estilo": estilo_riv,
		"lead": team_goals - rival_goals,
		"away": not _home_match,
		"derby": _is_derby,
		"extra": _extra_time,



		"rival": Nations.team_label(GameState.current_rival()),
		"comp": Competitions.name_of(f),
		"tuyos": match_goals,
		"forma": Career.form,
		"final_liga": String(f.get("comp", "league")) == "league" \
				and GameState.season_progress() >= CELEB_LAST_ROUND,




		"rel_equipo": _chem_rel if _chem_rel >= 0 else 50,
		"rel_aficion": _fan_rel,
	}



	if not _hist.is_empty():
		var hid: String = String(_hist["id"])
		ctx["hist_club"] = _hist["club"]
		ctx["hist_via"] = _hist["via"]
		ctx["hist_temps"] = _hist["temps"]
		ctx["hist_hace"] = _hist["hace"]
		if kind == "saque":
			ctx["hist_tag"] = "s:" + hid
			ctx["hist_saque"] = Career.cronica_libre("s:" + hid)
		elif kind == "gol":
			ctx["hist_tag"] = "g:" + hid
			ctx["hist_gol"] = Career.cronica_libre("g:" + hid)
	ctx.merge(extra, true)
	var line: Dictionary = _talk.say(kind, ctx)
	if line.is_empty():
		return


	if Commentary.CLAVES_HISTORIA.has(String(line["key"])):
		Career.cronica_marca(String(ctx.get("hist_tag", "")))
		if kind == "gol_rival":
			_hist_npc_dicha = true
	var text: String = I18n.tf(String(line["key"]), line["args"])
	if delay <= 0.0:
		_hud.show_message(text, TALK_COLOR, TALK_HOLD)
		return







	SceneFade.timer(delay, false).timeout.connect(_say_ahora.bind(text))



