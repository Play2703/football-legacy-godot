					i == 0 and (anim == "idle" or anim == "idle_back")])
		if not pares_campo.is_empty():
			trabajo.append({"key": "", "pares": pares_campo})









	for grupo in [["medico_%d", _medic_anims(), _medic_frames_cache],
			["seguridad_%d", _guard_anims(), _guard_frames_cache]]:
