func _lance_bonus(defs: Array) -> Array:
	var out: Array = []



	var dif_off: float = Settings.dif_reach_off()
	for i in defs.size():






		if float(_lance_cool.get(i, 0.0)) > 0.0:
			out.append(-99.0)
			continue
		var t: float = float(_lance_t.get(i, 0.0))


		out.append((LANCE_REACH if t > 0.0
			and (1.0 - t / LANCE_T) >= LANCE_REACH_FROM else 0.0) + dif_off)
	return out
















