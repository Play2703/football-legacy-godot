			else String(_finisher_of(srv).get("name", ""))
	var ape: String = "" if nom.is_empty() else CareerUi.surname(CareerUi.display_name(nom))
	var txt: String = I18n.t("¡BALÓN LARGO!") if ape.is_empty() \
			else I18n.tf("¡{0} TE LA CUELGA!", [ape])
	_hud.show_message(txt, SALIDA_ROTULO_COLOR, SERVICIO_PLACA_T)


func _recep_sigue(gen: int) -> bool:
	return gen == _recep_gen and is_inside_tree() and is_instance_valid(_ball) \
			and _recep_srv != null and is_instance_valid(_recep_srv) \
			and _self_actor != null and is_instance_valid(_self_actor)



func _recep_anim(parte: String) -> String:
	return "%s_south" % String(RecepcionAerea.PARTES[parte]["gesto"])




func _recep_fps(yo: AnimatedSprite3D, parte: String) -> float:
	var anim: String = _recep_anim(parte)
	if yo != null and yo.sprite_frames != null and yo.sprite_frames.has_animation(anim):
		return maxf(yo.sprite_frames.get_animation_speed(anim), 1.0)
	for row: Dictionary in ACTOR_ANIMS:
		if String(row["anim"]) == String(RecepcionAerea.PARTES[parte]["gesto"]) + "_%s":
			return float(row.get("fps", 12.0))
	return 12.0





func _recep_gesto(yo: AnimatedSprite3D, parte: String) -> bool:
	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + HEADER_GESTO_BUDGET_US)
	yo.flip_h = false
	var e: Dictionary = RecepcionAerea.PARTES[parte]
	var fps: float = _recep_fps(yo, parte)
	var antes: float = RecepcionAerea.t_gesto(parte, fps)
	var n: int = 6
	var anim: String = _recep_anim(parte)
	if yo.sprite_frames != null and yo.sprite_frames.has_animation(anim):
		n = yo.sprite_frames.get_frame_count(anim)
	var hold: int = roundi(1000.0 *(antes / RECEP_LENTO
		+ maxf(float(n) / fps - antes, 0.0))) + 120
	if not _play_dir_gesture(yo, String(e["gesto"]), _recep_hacia, hold):
		return false
	SceneFade.timer(hold / 1000.0, false, false, true).timeout \
			.connect(_control_gesto_fin.bind(yo))
	return true




