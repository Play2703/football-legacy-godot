		var p0: Vector2 = Vector2(a.position.x, a.position.z)
		if p0.distance_to(_recu_pos) > Recupera.CERCA_JUGADA_R:
			continue
		cand.append({"a": a, "d": p0.distance_to(_recu_pos)})
	cand.sort_custom(func(x: Dictionary, y: Dictionary) -> bool:
		return float(x["d"]) < float(y["d"]))
	var tope: int = Recupera.enganchan_max(_recu_apoyos.size())
	for c in cand.slice(0, tope):
		var a: AnimatedSprite3D = c["a"]
		var p: Vector2 = Vector2(a.position.x, a.position.z)
		var rp: Dictionary = a.get_meta("player", {}) if a.has_meta("player") else {}
