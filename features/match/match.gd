func _diana_x_en(i: int, t: float) -> float:
	if i < 0 or i >= _dianas_sitio.size():
		return 0.0
	var d: Dictionary = _dianas_sitio[i]
	var fase: float = float(d["dir"]) \
			* _vaiven_fase(t, DIANA_VEL_INI, DIANA_VEL_FIN, DIANA_MUEVE_DESDE) + float(d["fase"])

	var amp: float = minf(float(d["amp"]),
		Stadium.FIELD_HALF_W - absf(float(d["x"])) - DIANA_HALF_W - 1.0)
	return float(d["x"]) + sin(fase) * maxf(0.0, amp)

















