func _tutorial_results_fx(rows: Array[Control], total_l: Label,
		total: int) -> void:
	await get_tree().process_frame
	for i in rows.size():
		if not is_instance_valid(rows[i]):
			return
		var tw: Tween = rows[i].create_tween()
		tw.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
		tw.set_ignore_time_scale(true)
		tw.tween_property(rows[i], "modulate:a", 1.0, 0.16) \
				.set_delay(TUT_ROW_STEP * i)



		var s: int = int(_tutorial_stars[i]) if i < _tutorial_stars.size() else 0
		SceneFade.timer(TUT_ROW_STEP * i, false).timeout.connect(
			_tutorial_row_cue.bind(s))
	if not is_instance_valid(total_l):
		return
	var wait: float = TUT_ROW_STEP * rows.size() + 0.12
	var cnt: Tween = total_l.create_tween()
	cnt.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	cnt.set_ignore_time_scale(true)
	cnt.tween_method(_tutorial_count_to.bind(total_l),
			0.0, float(total), TUT_COUNT_T) \
					.set_delay(wait).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)



	var rarity: int = 0
	if total >= Tutorial.max_total():
		rarity = 2
	elif total >= 11:
		rarity = 1
	SceneFade.timer(wait + TUT_COUNT_T, false).timeout.connect(
		_tutorial_total_cue.bind(total_l, rarity))



