const BOTTLE_SCALE: float = 1.45


const BOTTLE_BEER_P: float = 0.45


const BOTTLE_SOUND_P: float = 0.34

func _throw_bottle(anchor: Vector3) -> void:
	if state != State.RESOLVED:
		return
	if _stadium == null or not is_instance_valid(_stadium):
		return
	var beer: bool = randf() < BOTTLE_BEER_P
	var b: Node3D = _stadium.make_bottle(
		Stadium.BOTTLE_BEER if beer else Stadium.BOTTLE_WATER,
		Stadium.BOTTLE_BEER_CAP if beer else Stadium.BOTTLE_WATER_CAP)
	b.scale = Vector3.ONE * BOTTLE_SCALE





	var pivot: Node3D = Node3D.new()
	b.position = Vector3(0.0, - Stadium.BOTTLE_H * 0.6 * BOTTLE_SCALE, 0.0)
	pivot.add_child(b)

	var from: Vector3 = Vector3(anchor.x + randf_range(-9.0, 9.0), 3.2, -6.5)
	var to: Vector3 = Vector3(anchor.x + randf_range(- BOTTLE_SPREAD, BOTTLE_SPREAD),
		0.06, anchor.z + randf_range(0.5, BOTTLE_SPREAD))
	pivot.position = from
	add_child(pivot)
	_celeb_props.append(pivot)




	var axis: Vector3 = Vector3(randf_range(-1.0, 1.0), randf_range(-0.2, 0.2),
		randf_range(-1.0, 1.0)).normalized()
	var spin: float = randf_range(6.0, 12.0)
	var tw: Tween = create_tween()
	tw.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.set_ignore_time_scale(true)


	tw.tween_method(func(t: float) -> void:
			if not is_instance_valid(pivot):
				return
			pivot.position = from.lerp(to, t) \
					+ Vector3(0.0, sin(t * PI) * BOTTLE_ARC, 0.0)
			pivot.basis = Basis(axis, t * BOTTLE_FLIGHT * spin),
		0.0, 1.0, BOTTLE_FLIGHT)


	tw.tween_callback(_bottle_lands.bind(pivot, to, to - from, beer))
	_celeb_runs.append(tw)











func _bottle_lands(pivot: Node3D, at: Vector3, dir: Vector3, beer: bool) -> void:
	if not is_instance_valid(pivot):
		return
	var rest: Vector3 = Vector3(at.x, Stadium.BOTTLE_R * BOTTLE_SCALE, at.z)
	pivot.position = rest
	pivot.basis = Basis(Vector3.UP, randf() * TAU) * Basis(Vector3.RIGHT, PI * 0.5)
	if _fx != null:

		_fx.spill_burst(rest + Vector3(0.0, Stadium.BOTTLE_R * BOTTLE_SCALE, 0.0),
			dir, 0.85, beer)
	if _audio != null and randf() < BOTTLE_SOUND_P:
		_audio.splash(6.0)

















const RIVAL_TRUDGE_SPEED: float = 1.45
const RIVAL_TRUDGE_MIN: float = 2.5
const RIVAL_TRUDGE_MAX: float = 13.0
const RIVAL_STAND_P: float = 0.25














const ENCAJA_SUELO_T0: float = 0.3
const ENCAJA_SUELO_PASO: float = 0.2


const ENCAJA_SUELO_DIRS: Array[String] = ["south", "east", "south", "west"]


const ENCAJA_SUELO_REINTENTOS: int = 6
const ENCAJA_SUELO_REINTENTO_S: float = 0.1

func _encajan_tras_gol(rival: bool) -> void:


	var arco: Vector3 = Vector3(0.0, 0.0, Stadium.FIELD_DEPTH) if rival else Vector3.ZERO
	var quienes: Array = []
	for a in (_teammate_actors if rival else _rival_actors):
		if is_instance_valid(a):
			quienes.append(a)

	if rival and _self_actor != null and is_instance_valid(_self_actor) \
			and _self_actor.visible:
		quienes.append(_self_actor)
	quienes.sort_custom(func(p: Node3D, q: Node3D) -> bool:
		return absf(p.position.z - arco.z) < absf(q.position.z - arco.z))
	var al_suelo: int = LecturaGol.cuantos_al_suelo(_lectura, quienes.size())

	for a in quienes:
		_cara(a, "lamento", 5.0)
	for i in quienes.size():
		var a: AnimatedSprite3D = quienes[i]
		if i < al_suelo:
			_encaja_al_suelo(a, i)
			continue
		if randf() < RIVAL_STAND_P:



			_face(a, Vector3(arco.x - a.position.x, 0.0, arco.z - a.position.z))
			continue
		var d: float = randf_range(RIVAL_TRUDGE_MIN, RIVAL_TRUDGE_MAX)
		var target: Vector3 = Vector3(
			clampf(a.position.x + randf_range(-2.0, 2.0),
				- Stadium.FIELD_HALF_W + 1.5, Stadium.FIELD_HALF_W - 1.5),
			a.position.y,
			maxf(a.position.z - d, Stadium.HALF_LINE) if rival \
					else minf(a.position.z + d, Stadium.HALF_LINE))



		if (target.z - a.position.z) *(-1.0 if rival else 1.0) < RIVAL_TRUDGE_MIN:
			_face(a, Vector3(arco.x - a.position.x, 0.0, arco.z - a.position.z))
			continue
		_run_target[a] = target
		_play_run(a, target - a.position)
		var tw: Tween = create_tween()
		tw.tween_property(a, "position", target,
			maxf(_flat_dist(a.position, target) / RIVAL_TRUDGE_SPEED, 0.4))
		tw.tween_callback(_end_rival_walk.bind(a, arco))
		_celeb_runs.append(tw)





func _end_rival_walk(actor, arco: Vector3 = Vector3.ZERO) -> void:
	_run_target.erase(actor)
	if not is_instance_valid(actor):
		return
	_face(actor, Vector3(arco.x - actor.position.x, 0.0, arco.z - actor.position.z))




func _encaja_al_suelo(actor: AnimatedSprite3D, orden: int) -> void:
	var tw: Tween = create_tween()
	tw.tween_interval(ENCAJA_SUELO_T0 + ENCAJA_SUELO_PASO * float(orden)
		+ randf_range(0.0, 0.1))
	tw.tween_callback(_encaja_cae.bind(actor,
		ENCAJA_SUELO_DIRS[orden % ENCAJA_SUELO_DIRS.size()], ENCAJA_SUELO_REINTENTOS))
	_celeb_runs.append(tw)







func _encaja_cae(actor, dn: String, quedan: int) -> void:
	if not is_instance_valid(actor):
		return
	var anim: String = "fall_" + dn
	var ahora: int = Time.get_ticks_msec()
	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + CELEB_GESTO_BUDGET_US)
	if int(_anim_lock.get(actor, 0)) <= ahora and _gesto_listo(actor, anim):

		_run_target.erase(actor)
		actor.play(anim)
		actor.speed_scale = 1.0
		_anim_lock[actor] = ahora + CELEB_HOLD_MS
		return
	if quedan > 0:
		var tw: Tween = create_tween()
		tw.tween_interval(ENCAJA_SUELO_REINTENTO_S)
		tw.tween_callback(_encaja_cae.bind(actor, dn, quedan - 1))
		_celeb_runs.append(tw)
















