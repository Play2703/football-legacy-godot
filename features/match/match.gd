const ENTRANCE_DEF_Z: float = 15.0
const ENTRANCE_FRONT_Z: float = 47.0



const ENTRANCE_KEEPER_Z: float = 5.0













const ENTRANCE_SPEED: float = 13.0





const ENTRANCE_STRIDE: float = 2.7


