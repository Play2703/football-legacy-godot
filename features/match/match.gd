static func _corro_marcas(anchor: Vector3, focus: Node3D, otros: Array) -> Dictionary:
	var out: Dictionary = {}
	out[focus] = Vector3(anchor.x, anchor.y, anchor.z)
	var n: int = mini(otros.size(), CORRO_RONDA)
	var arco: float = 360.0 - 2.0 * CORRO_HUECO_GRADOS
	var dentro: Array = []
	for i in n:
		var g: float = 270.0 if n == 1 \
				else 90.0 + CORRO_HUECO_GRADOS + arco * float(i) / float(n - 1)
		dentro.append(_corro_punto(anchor, g, CORRO_RADIO_M))
	var m: int = otros.size() - n
	var fuera: Array = []
	for j in m:
		fuera.append(_corro_punto(anchor, 270.0 +(float(j) - float(m - 1) * 0.5) * 30.0,
			CORRO_RADIO_M + 1.5))
	for k in otros.size():
		var libres: Array = dentro if k < n else fuera
		var p: Vector3 = otros[k].position
		var mejor: int = 0
		for s in range(1, libres.size()):
			if Vector2(libres[s].x - p.x, libres[s].z - p.z).length() \
					< Vector2(libres[mejor].x - p.x, libres[mejor].z - p.z).length():
				mejor = s
		out[otros[k]] = libres[mejor]
		libres.remove_at(mejor)
	return out


static func _corro_punto(anchor: Vector3, grados: float, radio: float) -> Vector3:
	return _formacion_en_campo(Vector2(anchor.x, anchor.z)
		+ Vector2.from_angle(deg_to_rad(grados)) * radio, anchor.y)




