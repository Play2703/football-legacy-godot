func _handle_duel_input(event: InputEvent) -> void:


	if _recu:
		_recu_input(event)
		return
	if event is InputEventScreenTouch:
		if event.pressed:



			_flip_reanuda()












			if _duel_cross_allowed() and _duel_finger != -1 \
					and event.index != _duel_finger:
				if _cross_tap_finger != -1:
					return
				_cross_tap_finger = event.index
				_cross_tap_press = event.position
				return
			if _duel_finger == -1:










				if not _duel_active or not _touch_in_drive_ring(event.position):
					return
				_recu_arrastre_heredado = false





				if _duel_press:





					_press_armed = true



					_duel_finger = event.index
					_duel_start = event.position
					_open_shot_aim = false
					_ring_out = true
					_duel_steer = Vector2.ZERO
					_aim.set_advance(true)
					_hud.show_hint(_solo_academia(_aim_hint()))
					return
				_duel_finger = event.index


				_open_shot_aim = true


				_ring_aim_shown = false
				_ring_out = false
				_duel_steer = Vector2.ZERO


				_ring_anchor_center()
				_aim.set_advance(false)
				_open_aim_fx(true)


				_stadium.crowd_excite(1.0)
				_hud.show_hint(_solo_academia(_aim_hint()))
				return
		elif event.index == _duel_finger:
			_duel_finger = -1
			_recu_arrastre_heredado = false
			if _open_shot_aim:




				if event.canceled and event.index == PUNTERO_DEDO:
					_aim.hide_aim()
					_soft_aim_clear()
					_ring_aim_shown = false
					_stadium.crowd_excite(0.5)
					return
				_open_field_shot(event.position, event.canceled)
				return















			_duel_steer = Vector2.ZERO
			_duel_vel = Vector2.ZERO
			_aim.hide_aim()
			_ring_out = false















			if not _duel_press:
				_open_shot_aim = true
				_open_aim_fx(true)
				_aim.set_advance(false)



			_ring_start = _ring_screen_center()

			_ring_live_dir = Vector2.ZERO
			_ring_start_ground = Vector2(_self_actor.position.x,
				_self_actor.position.z) if is_instance_valid(_self_actor) \
						else _ground_at(_ring_start)
			_ring_px = _ring_radius_px()









			if not _duel_press and is_instance_valid(_self_actor):
				_self_actor.pause()
			_hud.show_hint(_solo_academia(_aim_hint()))
		elif event.index == _cross_tap_finger:




			_cross_tap_finger = -1
			if not event.canceled:
				_set_cross_mode(not _cross_mode)
	elif event is InputEventScreenDrag and event.index == _duel_finger:








		var candado: bool = _duel_press or _recu_arrastre_heredado
		var inside: bool = false if candado else _pos_in_ring(event.position)
		if not candado and inside == _ring_out:
			_ring_out = not inside
			if _ring_out:


				_open_shot_aim = false
				_ring_aim_shown = false
				_open_aim_fx(false)
				if is_instance_valid(_self_actor):
					_self_actor.play()
				_aim.hide_aim()
				_aim.set_advance(true)









			else:







				_open_shot_aim = true


				_ring_aim_shown = false
				_open_aim_fx(true)

				var rumbo: Vector2 = _duel_steer
				_duel_steer = Vector2.ZERO








				_ring_anchor_center()


				if is_instance_valid(_self_actor):
					_self_actor.pause()
				_aim.set_advance(false)
		if _open_shot_aim:
			_update_ring_aim(event.position)
			return









		var ancla: Vector2 = _duel_start if candado else _ring_screen_center()
		var pull: Vector2 = ancla - event.position
		if pull.length() < DUEL_STEER_DEADZONE:
			_duel_steer = Vector2.ZERO
			_aim.hide_aim()
			return
