func _encargo_hud() -> void:
	if _encargo.is_empty() or _hud == null:
		return
	if String(_encargo.get("modo", "")) == Encargo.MODO_ZONAS:
		return


	if String(_encargo.get("modo", "")) == Encargo.MODO_DIANA:




		var quedan: int = maxi(0, int(ceilf(float(_encargo.get("tries", 60)) - _dianas_t)))
		var need: int = int(_encargo.get("need", 1))
		var llenas: int = Encargo.estrellas(_encargo_hechos, need)


		var siguiente: int = Encargo.puntos_estrella(need, llenas) \
				if llenas < Encargo.ESTRELLAS.size() else 0
		_hud.set_dianas(quedan, _encargo_hechos, llenas, Encargo.ESTRELLAS.size(), siguiente)
		return


	if _encargo.has("reto"):
		_hud.set_practice_clock("%d · %d/%d" % [_encargo_hechos, _encargo_intentos,
			int(_encargo.get("tries", 1))])
		return
	_hud.set_practice_clock("%d/%d" % [_encargo_hechos, int(_encargo.get("need", 1))])






func _encargo_gate() -> bool:





	if String(_encargo.get("modo", "")) == Encargo.MODO_DIANA:
		if _dianas_t >= float(_encargo.get("tries", 60)):




			_dianas_remata_vuelos()
			_encargo_cerrar(_encargo_hechos >= int(_encargo.get("need", 1)))
			return false
		return true
	if _encargo_hechos >= int(_encargo.get("need", 1)):
		_encargo_cerrar(true)
		return false
	if _encargo_intentos >= int(_encargo.get("tries", 1)):
		_encargo_cerrar(false)
		return false
	return true










func _encargo_cerrar(ok: bool) -> void:
	GameState.encargo_result = {
		"ok": ok,
		"estrellas": Encargo.estrellas(_encargo_hechos, int(_encargo.get("need", 1))),
		"logrado": _encargo_hechos,
		"need": int(_encargo.get("need", 1)),
		"tries": int(_encargo.get("tries", 1)),
		"modo": String(_encargo.get("modo", Encargo.MODO_TIRO)),
		"stat": String(_encargo.get("stat", "")),
		"kind": String(_encargo.get("kind", "")),
	}
	if _encargo.has("reto"):
		GameState.encargo_result["reto"] = String(_encargo.reto)
	GameState.encargo = {}
	_encargo = {}
	_dianas_t = 0.0
	_dianas_anim = 0.0
	_dianas_arrancado = false
	_dianas_bocina_corta = false
	_eslalon = false
	_esl_fatiga = 0.0
	_esl_repone = 0.0
	_eslalon_esconde()
	if _hud != null:
		_hud.hide_dianas()
	for b in _dianas_muertos:
		if is_instance_valid(b):
			b.queue_free()
	_dianas_muertos = []
	for v in _dianas_vuelos:
		var nv: Variant = v.get("n")
		if nv is Node and is_instance_valid(nv):
			(nv as Node).queue_free()
	_dianas_vuelos = []
	_hide_dianas()
	_hide_blancos()
	GameState.training_active = false
	GameState.training_home = false
	GameState.practice_kind = ""
	GameState.readonly_save = false



	var reto: String = String(GameState.encargo_result.get("reto", ""))
	if reto != "":
		Nube.anotar_reto(reto, _encargo_hechos)
		SceneFade.to_scene("res://ui/amigos.tscn")
		return
	SceneFade.to_scene("res://ui/career_hub.tscn")


