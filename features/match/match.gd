func _rating_reason(outcome: String) -> String:
	match outcome:
		"goal": return I18n.t("GOL", "nota")
		"cano_sale": return I18n.t(Cano.ROTULO_SALE)
		"cano_falla": return I18n.t(Cano.ROTULO_FALLA)
		"recep_sale": return I18n.t(RECEP_ROTULO_SALE)
		"recep_falla": return I18n.t(RECEP_ROTULO_FALLA)




		"save", "penal_save": return I18n.t("ATAJADA", "nota")
		"post", "penal_post": return I18n.t("PALO", "nota")
		"wide", "over", "penal_wide": return I18n.t("FUERA", "nota")






		"blocked":
			if _autogol_rival(_outcome):
				return I18n.t("DESVIADO", "nota")
			if _rebote_mate_causa:
				return I18n.t("PASE FALLADO", "nota")
			return I18n.t("BLOQUEADO", "nota")
		"cleared":
			if _rebote_mate_causa:
				return I18n.t("PASE FALLADO", "nota")
			return I18n.t("DESPEJE", "nota")
		"offside": return I18n.t("FUERA DE JUEGO", "nota")






		"dribble_lost":
			if _meta_corte:
				return I18n.t("PASE CORTADO", "nota")
			return I18n.t("TE RESBALASTE", "nota") if _perdida_resbalon \
					else I18n.t("BALÓN PERDIDO", "nota")






		"keeper_out": return I18n.t("LA ATRAPA EL PORTERO", "nota")


		"gol_regalado": return I18n.t("GOL EN CONTRA", "nota")



		"dribble_out": return I18n.t("SE TE FUE FUERA", "nota")
		"missball": return I18n.t("SIN CONTACTO", "nota")


		"own_goal": return I18n.t("EN PROPIA", "nota")
		"switch_done": return I18n.t("CENTRO PUESTO", "nota")
		"switch_short", "switch_fail": return I18n.t("PASE FALLADO", "nota")
		"press_out_win": return I18n.t("SALIDA LIMPIA", "nota")
		"press_out_caged": return I18n.t("ENCERRADO", "nota")
		"press_out_foul": return I18n.t("FALTA AL SALIR", "nota")
		"foul_won": return I18n.t("FALTA", "nota")
		"pique_calma": return I18n.t("TEMPLE", "nota")
		"pique_amarilla": return I18n.t("AMARILLA", "nota")
		"foul_ceded", "penal_ceded": return I18n.t("LA COBRA OTRO", "nota")



		"dribble_win": return I18n.t("REGATE", "nota")


		"recu_win": return I18n.t("ROBO", "nota")







		"recu_lost":
			if _recu_last_why == "gol":
				return I18n.t("GOL EN CONTRA", "nota")
			if _recu_last_why == "falta":
				return I18n.t("FALTA", "nota")
			return I18n.t("DESBORDADO", "nota")
		"recu_out": return I18n.t("FUERA", "nota")
		"pass": return I18n.t("PASE", "nota")
		"key_pass": return I18n.t("PASE CLAVE", "nota")


		"assist": return I18n.t("ASISTENCIA", "nota")
		_: return ""










