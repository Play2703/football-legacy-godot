func _album_arma(r: ReplayView, clip: ReplayRec.Clip, gol_id: int) -> void:
	if not _album_permite(clip, gol_id):
		return
	r.album_gol = gol_id

	r.album_pide = _album_guarda.bind(gol_id)
	if _goal_guardados.has(gol_id):
		r.album_nace = ReplayView.Album.GUARDADO
	elif _goal_guardando.has(gol_id):
		r.album_nace = ReplayView.Album.GUARDANDO
	elif ReplayAlbum.cuantas() >= ReplayAlbum.MAX_POR_RANURA:
		r.album_nace = ReplayView.Album.LLENO
	else:
		r.album_nace = ReplayView.Album.LISTO






func _album_guarda(miniatura: Image, gol_id: int) -> void:
	if _goal_guardando.has(gol_id):
