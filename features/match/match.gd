func _va_a_mi_arco(pos: Vector3, vel: Vector3) -> bool:





	if _shootout_active or _recu:
		return false
	if vel.z <= 0.5:
		return false
	var falta: float = OWN_GOAL_Z - pos.z
	if falta <= 0.0:
		return true

	if vel.length_squared() * OWN_GOAL_REACH_K >= falta:
		return true






	var muere: float = pos.z + vel.length_squared() * OWN_GOAL_REACH_K
	return muere >= OWN_GOAL_Z - OWN_GOAL_KEEPER_ZONE_M


