const AMBIENT_T: float = 9.0


const AMBIENT_FLAT: float = 0.55



const AMBIENT_SPD: float = 1.35




const WORLD_CLEAR_SPD: float = 3.4





const WORLD_MATE_RUN_SPD: float = 5.0




const WORLD_COVER_GAP: float = 2.0




















