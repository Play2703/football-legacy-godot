static var _guard_frames_cache: Dictionary = {}




static func _guard_anims() -> Array:
	var out: Array = []
	for d in ["west", "east"]:
		for fam in [["walk", 9.0], ["run", 12.0]]:
			var rutas: Array = []
			for i in range(1, 9):
				rutas.append("res://assets/sprites/anim/seguridad_%s_%s_%02d.png" % [fam[0], d, i])
			out.append(["%s_%s" % [fam[0], d], float(fam[1]), true, rutas])

		var pl: Array = []
		for i in range(1, 9):
			pl.append("res://assets/sprites/anim/seguridad_placaje_%s_%02d.png" % [d, i])
		out.append(["placaje_" + d, 13.0, false, pl])
		out.append(["idle_" + d, 5.0, true, ["res://assets/sprites/anim/seguridad_idle_%s.png" % d]])
	out.append(["idle", 5.0, true, ["res://assets/sprites/anim/seguridad_idle_south.png"]])
	return out


func _guard_frames(semilla: String) -> SpriteFrames:
	if not _guard_frames_cache.has(semilla):
