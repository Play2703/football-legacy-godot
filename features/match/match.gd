func _open_field_keeper_step(delta: float, apuntando: bool = false) -> void:

	var mi_vel: Vector2 = Vector2.ZERO if apuntando else _duel_vel
	if not is_instance_valid(_keeper):
		return
	var kp: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)









	if _keeper_lance_step(delta, _duel_pos, _duel_control) == KL_VOLANDO:
		if _keeper_robo(Vector2(_keeper.position.x, _keeper.position.z), _duel_control):
			_haptic(30)
			_hud.show_message(I18n.t("TE LA QUITÓ EL PORTERO"), Color.WHITE, 1.2)
			_open_field_clear()
		return



	if _keeper_down_left() > 0.0:
		return
	if _keeper_dist(_ball_field) <= _keeper_reach_r():

		var cita: Vector2 = _keeper_lance_point(kp, mi_vel,
			clampf(mi_vel.length() / maxf(_duel_run_spd, 0.01), 0.0, 1.0), _duel_pos)
		if cita != Vector2.INF:
			_keeper_lance_begin(kp, cita, _duel_pos)
			return







		var out: Array = Duel.step_defender(kp, _keeper_out_vel, _ball_field,
			minf(lerpf(KEEPER_OUT_SPD_MIN, KEEPER_OUT_SPD_MAX, _keeper_speed),
				_duel_run_spd * 0.9), delta,
			Duel.CHASE_ACCEL_K *(1.0 +(_keeper_accel - 0.5) * 2.0 * NPC_ACCEL_SPAN))
		_keeper_out_vel = out[1]
		kp = out[0]
		_keeper.position = Vector3(kp.x, _keeper.position.y, kp.y)
		_play_keeper_out(Vector3(_keeper_out_vel.x, 0.0, _keeper_out_vel.y))
		if _keeper_robo(kp, _duel_control):
			_haptic(30)
			_play_keeper_smother()
			_hud.show_message(I18n.t("TE LA QUITÓ EL PORTERO"), Color.WHITE, 1.2)
			_open_field_clear()
		return

	var home: Vector2 = _keeper_spot(_ball_field)
	if kp.distance_to(home) > 0.25:
		var back: Array = Duel.step_defender(kp, _keeper_out_vel, home,
			KEEPER_OUT_SPD_MIN, delta)
		_keeper_out_vel = back[1]
		kp = back[0]
		_keeper.position = Vector3(kp.x, _keeper.position.y, kp.y)
		_play_keeper_out(Vector3(_keeper_out_vel.x, 0.0, _keeper_out_vel.y))
	else:
		_keeper_out_vel = Vector2.ZERO
		if _keeper.animation != "idle" and _keeper.sprite_frames.has_animation("idle"):
			_keeper.play(_keeper_anim("idle"))









