	_open_shootout_screen(rival)
	_sim_screen.add_line(120 if _extra_time else 90,
		I18n.t("¡TANDA DE PENALES!"), "break")
	await _shoot_wait(1.6)
	_sim_screen.finish()
	await _shoot_wait(0.4)
	_hud.show_shootout_tally(GameState.you_of(GameState.current_fixture()), rival,
		Competitions.accent_of(GameState.current_fixture()))
	while true:


		var scored: bool



		var taker_now: Dictionary = {}
		var taker_is_you: bool = taken == my_slot
		if taker_is_you:
			taker_now = {"name": Career.player_name,
				"number": GameState.shirt_number_now()}
		elif not my_takers.is_empty():
			taker_now = my_takers[taken % my_takers.size()]



		_shootout_pre = {"mine": mine, "theirs": theirs, "taken": taken,
			"friendly": true}
		if taker_is_you:
			_hud.show_message(I18n.t("¡TE TOCA A TI!"), UiKit.CYAN, 1.3)
			await _shoot_wait(1.3)
			scored =(await _shootout_my_kick()) == "goal"
			await _shoot_wait(1.3)
		else:
			scored = await _shootout_sim_kick(true,
				_shootout_teammate_scores(taker_now), my_takers, taken)
		last_side_mine = true
		last_scored = scored
		if scored:
			scorer_mine = taker_now
			scorer_mine_you = taker_is_you
			mine += 1
			_stadium.crowd_react("home", "goal")
			_audio.roar(-4.0)
		else:
			_stadium.crowd_react("away", "save")
			_audio.ooh()

