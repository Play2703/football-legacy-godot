static func pon_dia_rival(opp: String, fuera: Dictionary, carga: Array = []) -> bool:
	if opp.is_empty() or opp == GameState.player_team_id:
		return false



	var c: Array = carga if carga.size() >= 3 else [1, 1, 0]
	var orden: Array = Squad.orden_con_carga(opp, int(c[0]), int(c[1]), int(c[2]), fuera)
	if orden.is_empty():
		return false
	Squad.set_match_lineup(opp, orden)



	Squad.fija_dia_con_bajas(opp, fuera)
	return true


