func _entrance_slots(team_id: String, own_goal_z: float, fichas: Array = []) -> Array:
	var rows: Array = ScenarioStore.FORMATION_ROWS.get(
		ScenarioStore.formation_of(team_id), ScenarioStore.FORMATION_ROWS["4-4-2"])


	var huecos: Array = Squad.slots_of(ScenarioStore.formation_of(team_id)) \
			if not fichas.is_empty() else []
	var dir: float = 1.0 if own_goal_z < Stadium.HALF_LINE else -1.0
	var out: Array = []
	out.append(Vector2(0.0, own_goal_z + dir * ENTRANCE_KEEPER_Z))
	for r in rows.size():
		var n: int = int(rows[r])


		var t_row: float = 0.0 if rows.size() <= 1 else float(r) / float(rows.size() - 1)
		var z: float = own_goal_z + dir * lerpf(ENTRANCE_DEF_Z, ENTRANCE_FRONT_Z, t_row)


		var role: String = "def" if r == 0 else ("att" if r == rows.size() - 1 else "mid")
		var w: float = float((ScenarioStore.ROW_WIDTH[role] as Dictionary).get(n, 12.0))

		var xs: Array[float] = []
		for i in n:
			var t: float = 0.5 if n <= 1 else float(i) / float(n - 1)
			xs.append(- dir * lerpf(- w, w, t))


		var base: int = out.size()
		var orden: Array[int] = []
		for i in n:
			orden.append(i)
		orden.sort_custom(func(a: int, b: int) -> bool:
			var fa: int = _flanco(base + a, huecos)
			var fb: int = _flanco(base + b, huecos)
			return a < b if fa == fb else fa < fb)
		var fila: Array[float] = []
		fila.resize(n)
		for j in n:
			fila[orden[j]] = xs[j]
		for i in n:
			out.append(Vector2(fila[i], z))
	return out












func _flanco(k: int, huecos: Array) -> int:
	if k >= huecos.size():
		return 0
	var v: Variant = huecos[k]
	var puesto: String = String((v as Dictionary).get("pos", "")) if v is Dictionary else String(v)
	match puesto:
		"LTI", "MI", "EI":
			return -1
		"LTD", "MD", "ED":
			return 1
	return 0






func _start_entrance(dur: float) -> void:
	var mine: Dictionary = KitRecolor.team_only(GameState.player_look())
	var theirs: Dictionary = KitRecolor.team_only(_rival_kit_cfg())










	_ensure_anims(TEAM_TEX, mine, "run_")
	_ensure_anims(RIVAL_TEX, theirs, "run_")


























	_ensure_anims(TEAM_TEX, _self_cfg(), "run_")
	_entrants.clear()
	_entrance_t = 0.0




	var gap: float = clampf(dur * 0.03, 0.09, 0.16)
	var sides: Array = _entrance_sides(mine, theirs)
	for side in 2:
		var fichas: Array = _entrance_fichas(side, String(sides[side][2]))
		var slots: Array = _entrance_slots(String(sides[side][2]),
			ENTRANCE_GOAL_Z[side], fichas)
















		var order: Array[int] = []
		for k in slots.size():
			order.append(k)
		order.sort_custom(func(a: int, b: int) -> bool:
			return (slots[a] as Vector2).distance_squared_to(ENTRANCE_GATE) \
					>(slots[b] as Vector2).distance_squared_to(ENTRANCE_GATE))
		for i in mini(order.size(), ENTRANCE_PER_SIDE):
			var k: int = order[i]


			_spawn_entrant(sides[side][0], sides[side][1], i, side, gap, slots[k],
				fichas[k] if k < fichas.size() else {}, k == 0)










