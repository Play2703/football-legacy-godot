func _press_next_zone() -> void:



	if _eslalon:
		_eslalon_sortea_par()
		return
	if _press_zone_pred != Vector2.ZERO:
		_press_zone = _press_zone_pred
	else:
		_press_zone = _sortea_zona(_ball_field)
	_show_press_zone()



	_press_zone_pred = Vector2.ZERO
	if _press_zone_i + 1 < _press_zones_n:
		_press_zone_pred = _sortea_zona(_press_zone)







		if _press_armed or _press_zone_i > 0:
			_press_add_guards(_press_zone, _press_zone_pred, _press_zone_i + 1)
		else:
			_press_guards_pend = true
	elif _press_zone_i == 0 and not _press_armed:


		_press_guards_pend = true




func _sortea_zona(desde: Vector2) -> Vector2:
	_press_zone_side = - _press_zone_side
	var avance: float = randf_range(PRESS_ZONE_D.x, PRESS_ZONE_D.y)
	var lado: float = randf_range(PRESS_ZONE_SIDE.x, PRESS_ZONE_SIDE.y)















	var limite: float = FIELD_EDGE - PRESS_ZONE_R
	var margen: float = limite - _press_zone_side * desde.x
	if margen < PRESS_ZONE_SIDE.x:
		_press_zone_side = - _press_zone_side
		margen = limite - _press_zone_side * desde.x
	lado = minf(lado, maxf(margen, PRESS_ZONE_SIDE.x))
	var x: float = desde.x + _press_zone_side * lado
	return Vector2(
		clampf(x, - FIELD_EDGE + PRESS_ZONE_R, FIELD_EDGE - PRESS_ZONE_R),
		maxf(desde.y - avance, PRESS_ZONE_R + 2.0))








































func _press_add_guards(desde: Vector2, hasta: Vector2, idx: int,
		cupo_fijo: int = -1) -> void:




	if idx < 0 or (PRESS_OUT_RING and idx <= 0):
		return



	if _press_sin_guardias:
		return

















	var pendientes: int = maxi(0, _press_zones_n - 1 - idx)




	var cuenta: int = 0
	for d in _duel_defs:
		if not _duel_broke or float((d as Vector2).y) < _ball_field.y + PRESS_REZAGADO_M:
			cuenta += 1
	var faltan: int = PRESS_OUT_MAX_DEFS - cuenta - pendientes
	if faltan <= 0:
		return









	var cupo_g: int = cupo_fijo if cupo_fijo >= 0 \
			else randi_range(PRESS_ZONE_GUARDS.x, PRESS_ZONE_GUARDS.y)



	if _tutorial_active:
		cupo_g = mini(cupo_g, TUTORIAL_RIVALES_MAX)
	var n: int = mini(cupo_g, faltan)





	var en_ruta: int = mini(_press_guard_ruta, n)


	var dentro_x: float = - signf(hasta.x) if absf(hasta.x) > 0.5 \
			else (1.0 if randf() < 0.5 else -1.0)
	for i in n:
		var ang: float = 0.0
		var r: float = randf_range(PRESS_GUARD_R.x, PRESS_GUARD_R.y)




		var orden: int = maxi(0, i - en_ruta)











		var lado: float = 0.0 if (n - en_ruta) <= 1 \
				else (1.0 if orden % 2 == 0 else -1.0)
		match _press_guard_forma:
			"linea":

				ang = - PI * 0.5 + lado * 0.25 + randf_range(-0.1, 0.1)
			"dentro":


				ang =(0.0 if dentro_x > 0.0 else PI) \
						+ lado * 0.45 + randf_range(-0.15, 0.15)
			"solo":






				if orden == 0:
					ang = - PI * 0.5 + randf_range(-0.15, 0.15)
				else:
					ang = - PI * 0.5 + lado * randf_range(0.5, 0.95) \
							+ randf_range(-0.2, 0.2)
					r *= 1.25
			"pinza":




				ang = - PI * 0.5 +(1.0 if orden % 2 == 0 else -1.0) \
						*(0.96 + randf_range(-0.12, 0.12))
			"escalon":








				ang = - PI * 0.5 + lado * randf_range(0.5, 0.95) \
						+ randf_range(-0.2, 0.2)
				var centro_r: float =(PRESS_GUARD_R.x + PRESS_GUARD_R.y) * 0.5
				r = centro_r *(0.85 if orden == 0 else (1.05 if orden == 1 else 1.25)) \
						+(r - centro_r) * 0.25
			_:

				ang = - PI * 0.5 + lado * randf_range(0.5, 0.95) \
						+ randf_range(-0.2, 0.2)



		if i < en_ruta:














			if not _press_promote_ruta(desde, hasta):
				break
			continue
		var puesto: Vector2 = hasta + Vector2(cos(ang), sin(ang)) * r
		puesto = Vector2(
			clampf(puesto.x, - Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
			clampf(puesto.y, 4.0, Stadium.FIELD_DEPTH - 4.0))






		var es_punta: bool = orden == 0 and (
			(_press_guard_punta == "primera" and idx == 0)
			or (_press_guard_punta == "ultima" and idx == _press_zones_n - 1))
		if not _press_promote_guard(puesto, false, -1, es_punta):
			break












func _press_promote_ruta(desde: Vector2, hasta: Vector2) -> bool:
	var eje: Vector2 = hasta - desde
	var largo: float = maxf(eje.length(), 0.01)
	var u: Vector2 = eje / largo
	var perp: Vector2 = Vector2(- u.y, u.x)
	var best: int = -1
	var best_d: float = INF
	var best_p: Vector2 = Vector2.ZERO
	for i in _duel_world_rivals.size():
		var a: AnimatedSprite3D = _duel_world_rivals[i]
		if not is_instance_valid(a):
			continue
		var p: Vector2 = Vector2(a.position.x, a.position.z)

		if p.y > _ball_field.y + 2.0:
			continue
		var rel: Vector2 = p - desde
		var t: float = clampf(rel.dot(u) / largo, PRESS_RUTA_T.x, PRESS_RUTA_T.y)
		var proy: Vector2 = desde + u *(largo * t)
		var d: float = p.distance_to(proy)
		if d < best_d:
			best_d = d
			best = i


			var lado: float = signf(rel.dot(perp))
			if lado == 0.0:
				lado = 1.0 if randf() < 0.5 else -1.0
			best_p = proy + perp * lado * randf_range(PRESS_RUTA_LAT * 0.4, PRESS_RUTA_LAT)
	if best < 0:
		return false
	best_p = Vector2(
		clampf(best_p.x, - Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
		clampf(best_p.y, 4.0, Stadium.FIELD_DEPTH - 4.0))
	return _press_promote_guard(best_p, true, best)











func _press_promote_guard(puesto: Vector2, ruta: bool = false, elegido: int = -1,
		punta: bool = false) -> bool:
	var best: int = elegido
	var best_d: float = INF





	var cand: Array = []
	for i in (0 if elegido >= 0 else _duel_world_rivals.size()):
		var a: AnimatedSprite3D = _duel_world_rivals[i]
		if not is_instance_valid(a):
			continue
		var p: Vector2 = Vector2(a.position.x, a.position.z)


		if p.y > _ball_field.y + 2.0:
			continue
		var d: float = p.distance_to(puesto)
		if punta:
			cand.append(Vector3(d, float(i), Squad.norm(
				a.get_meta("player", {}) if a.has_meta("player") else {},
				"velocidad")))
		elif d < best_d:
			best_d = d
			best = i
	if punta and not cand.is_empty():


		cand.sort_custom(func(x, y): return x.x < y.x)
		var mejor_v: float = -1.0
		for k in mini(3, cand.size()):
			if cand[k].z > mejor_v:
				mejor_v = cand[k].z
				best = int(cand[k].y)
	if best < 0:
		return false
	var a: AnimatedSprite3D = _duel_world_rivals[best]
	_duel_world_rivals.remove_at(best)
	var p: Vector2 = Vector2(a.position.x, a.position.z)
	var rp: Dictionary = a.get_meta("player", {}) if a.has_meta("player") else {}
	_face_ball(a)



	_duel_def_actors.append(a)
	_duel_defs.append(p)
	_duel_def_vels.append(Vector2.ZERO)
	var q: float = Duel.spread(Squad.norm(rp, "velocidad")) if not rp.is_empty() \
			else 0.5


	_duel_def_spds.append(_pace_for(DUEL_CHASE_SPD.x, DUEL_CHASE_SPD.y, q,
		PACE_JIT_PRESS_LO, PACE_JIT_PRESS_HI))
	_duel_def_tackles.append(Duel.spread(Squad.norm(rp, "entrada")) \
			if not rp.is_empty() else Duel.NEUTRAL_TACKLE)
	_duel_def_leads.append(clampf((Duel.spread(Squad.norm(rp, "entrada")) \
			if not rp.is_empty() else 0.5) * _tac_lead_mult, 0.0, 1.0))


	if not rp.is_empty() and not _handoff_live:
		var ex: Dictionary = _ex_companeros().get(int(rp.get(Squad.SEAT_KEY, -1)), {})
		if not ex.is_empty():
			_duel_def_leads[-1] = ExCompanero.lead_con(_duel_def_leads[-1],
				int(ex["temporadas"]))
	_duel_def_ks.append(_npc_accel_k(rp))



	_duel_def_pesos.append(
		Duel.peso(Duel.spread(Squad.norm(rp, "entrada")),
			Duel.spread(Squad.norm(rp, "aceleracion")))
		if not rp.is_empty() else Duel.PESO_NEUTRO)



	_duel_def_marks.append(-1)




	_duel_def_hold.append(PRESS_RUTA_HOLD if ruta else PRESS_GUARD_HOLD)
	_duel_def_post.append(puesto)
	_duel_def_ruta.append(ruta)
	_chaser_speed[a] = _duel_def_spds[_duel_def_spds.size() - 1]
	return true












