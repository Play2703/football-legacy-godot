	var out_side_step: int = 0



	var out_i: int = -1

	var braking: bool = false
	var brake_step: int = 0
	var brake_n: int = 0
	var wall_checked: Dictionary = {}


	for d_i in _defender_pos.size():
		if _defender_pos[d_i].y >= pos.z - 0.25:
			wall_checked[d_i] = true





	var barr: Dictionary = _barrida_candidato(pos, vel, tuyo, libre_npc)
	var barr_di: int = int(barr.get("i", -1))
	var barr_d: Vector2 = barr.get("d", Vector2.ZERO)
	var barr_vivo: bool = barr_di >= 0

	var barr_eq: float = _rival_lead(barr.get("a")) if barr_vivo else Duel.NEUTRAL_TACKLE
	var barr_m_min: float = INF



	var barr_q_max: float = 0.0
	var barr_de_pie: bool = false

	if barr_vivo:
		_barr_antes = _barrida_lee(vel.length(), Vector2(pos.x, pos.z).distance_to(barr_d))

	var desv_toques: int = 0
	_bajo_muro = false






	if not _desv_vivo_sem.is_empty():
		var sv: Dictionary = _desv_vivo_sem
		_desv_vivo_sem = {}
		_desv_anota(0, String(sv["tipo"]), String(sv["parte"]), sv["actor"], false,
			sv["v_in"], sv["giro"])
		_desv_toques[0]["vivo"] = true
		desv_toques = 1






		var mate: bool = bool(sv.get("mate", false))
		if mate:
			_desv_toques[0]["mate"] = true
			_desv_tipo = ""
			_desv_parte = ""
			_desv_actor = null
			_desv_pw = 0.0

		var ai: int = _rival_actors.find(sv["actor"])
		if ai >= 0 and ai < _defender_pos.size():
			wall_checked[ai] = true

		if _autogol_on and String(sv["tipo"]) == "desvio" and not mate:
			_desv_cruce0 = sv["cruce0"]
			_desv_iba_fuera = _iba_fuera(_desv_cruce0)


		if sv["barr_a"] != null and is_instance_valid(sv["barr_a"]):
			_barr_actor = sv["barr_a"]
			_barr_mudo_i = int(sv["barr_mudo"])
			_barr_lanzada = true


			var bi: int = _rival_actors.find(sv["barr_a"])
			if bi >= 0 and bi < _defender_pos.size():
				wall_checked[bi] = true


		if String(sv["tipo"]) == "rechace":
			_outcome = "blocked"
			resolved = true
			resolve_step = 0
			resolve_i = 0
			_rebound_i = 0


	var vel_prev: Vector3 = vel
	var keeper_x0: float = _keeper.position.x if _keeper else 0.0

















	var keeper_z: float = _keeper.position.z if _keeper else KEEPER_LINE_Z
	var keeper_beaten: bool = false
	if _keeper != null:
		keeper_beaten = keeper_z > KEEPER_BEATEN_OUT_Z \
				and pos.z < keeper_z - KEEPER_BEATEN_MARGIN
















	var parry_atras: bool = false
	var keeper_faces: bool = _keeper != null \
			and keeper_z > KEEPER_BEATEN_OUT_Z and pos.z > keeper_z + 0.2











	var meta_directo: bool = _meta_saca()
	if meta_directo:
		keeper_faces = false






















	var deep_origin: bool = pos.z > Stadium.HALF_LINE
	var sim_steps: int = SIM_STEPS_DEEP if deep_origin else SIM_STEPS
	_deep_pass_flight = deep_origin
	_libero_out = false


	_keeper_claim = false


	var wind_vx: float = 0.0



	var pud: Puddles = _stadium.puddles if _stadium != null else null



	var lluvia: bool = _stadium != null \
			and bool(_stadium.weather.get("rain", false))



	var wake_step: int = -999
	var was_dry: bool = true
	for step in sim_steps:
		_traj.append(pos)
		vel_prev = vel

		var h_speed: float = Vector2(vel.x, vel.z).length()
		if h_speed > CURL_MIN_SPEED and absf(spin) > 0.02:
			var perp: Vector3 = Vector3(vel.z, 0.0, - vel.x).normalized()
			var curl: float = CURL_ACCEL * minf(h_speed / CURL_REF_SPEED, 1.0)
			if pos.y <= 0.0:
				curl *= CURL_GROUND
			vel += perp * spin * curl * SIM_DT



		if h_speed > 0.5 and absf(back_spin) > 0.02 and pos.y > 0.0:
			vel.y += back_spin * VERT_MAGNUS * h_speed * SIM_DT







		if pos.y > 0.12:
			wind_vx +=(_wind.x * WIND_DRIFT_FRAC - wind_vx) *(WIND_DRAG * SIM_DT)
			vel.z += _wind.z *(WIND_PUSH * SIM_DT)
		else:

			wind_vx *= 1.0 - 4.0 * SIM_DT
		vel.y -= 9.8 * SIM_DT
		vel *= 1.0 - 0.12 * SIM_DT
		pos += vel * SIM_DT
		pos.x += wind_vx * SIM_DT



		if not _ref_scan.is_empty() \
				and _scan_refs(_traj[_traj.size() - 1], pos, vel):


			vel *= 0.16
			vel.y = minf(vel.y, 0.0)







		if _dron_ix < 0 and _dron_vivo():
			var dron_c: Vector3 = _dron.centro()
			var dron_toque: Vector3 = Dron.toca(_traj[_traj.size() - 1], pos, dron_c,
				Dron.HIT_R + BALL_R)
			if dron_toque != Vector3.INF:
				_dron_ix = _traj.size()
				_dron_v = vel
				_dron_tuyo = tuyo
				pos = dron_toque
				vel = Dron.rebote(vel, dron_toque, dron_c)







		if _playa_ix < 0 and _playa_vivo():
			var pl_c: Vector3 = _playa.centro()
			var arriba: Vector3 = Vector3(0.0, BALL_R, 0.0)
			var pl_toque: Vector3 = Dron.toca(_traj[_traj.size() - 1] + arriba,
				pos + arriba, pl_c, BalonPlaya.R + BALL_R)
			if pl_toque != Vector3.INF:
				_playa_ix = _traj.size()
				_playa_v = vel
				_playa_p = pl_toque
				_playa_tuyo = tuyo
				pos = pl_toque - arriba
				vel = _playa_desvia(vel, pl_toque, pl_c)













		if _glass_ix < 0 and _stadium != null \
				and vel.length() >= GLASS_REACH_SPEED:
			var vidrio: Dictionary = _stadium.box_pane_hit(
				_traj[_traj.size() - 1], pos)
			if not vidrio.is_empty():
				_glass_ix = _traj.size()
				_glass_i = int(vidrio["i"])
				_glass_p = vidrio["punto"]
				_glass_speed = vel.length()


				_glass_ruta = PackedVector3Array([_traj[_traj.size() - 1], _glass_p])


				vel *= 0.12
				vel.y = minf(vel.y, 0.0)
		if _bottle_ix < 0 and _stadium != null \
				and Vector2(vel.x, vel.z).length() >= BOTTLE_KNOCK_SPEED:
			var bot: int = _stadium.water_bottle_hit(_traj[_traj.size() - 1], pos)
			if bot >= 0:
				_bottle_ix = _traj.size()
				_bottle_i = bot
				_bottle_from = _traj[_traj.size() - 1]


				_bottle_vel = vel







		if _rope_ix < 0 and tuyo and _stadium != null \
				and vel.length() >= ROPE_SNAP_SPEED:
			var arriba_c: Vector3 = Vector3(0.0, BALL_R, 0.0)
			var cuerda: int = _stadium.net_rope_hit(_traj[_traj.size() - 1] + arriba_c,
				pos + arriba_c, BALL_R + Stadium.STAY_ROPE_R)
			if cuerda >= 0:
				_rope_ix = _traj.size()
				_rope_i = cuerda





		var wet: float = 0.0
		if pud != null and pos.y <= 0.02:
			wet = pud.depth_at(pos.x, pos.z)
			if wet <= PUDDLE_MIN:
				wet = 0.0





		if bar_drop and pos.z < - BAR_DEEP_Z:
			bar_drop = false
			resolved = true
			resolve_step = step
			resolve_i = _traj.size() - 1
			_outcome = "goal"

		if pos.y < 0.0:
			pos.y = 0.0









			if not bar_drop and _post_i >= 0 and _post_out_p == Vector3.ZERO \
					and absf(pos.x) < GOAL_AREA_HALF_W and pos.z < GOAL_AREA_Z:
				_post_out_p = pos
			if bar_drop:














				bar_drop = false
				resolved = true
				resolve_step = step
				resolve_i = _traj.size() - 1
				_bar_bounce_p = pos
				if pos.z < - BALL_R:
					_outcome = "goal"
					_bar_in_out = true
				else:




					_outcome = "post"
					_post_out_p = pos
					_rebound_i = _traj.size() - 1
				vel.y = absf(vel.y) * 0.5
				vel.z = absf(vel.z) * 0.6 + randf_range(1.5, 3.0)
				vel.x *= 0.85
			elif absf(vel.y) > 1.5:






				_queue_mark(pos, vel.y)


				vel.y = - vel.y * lerpf(_cesped_bote
					*(1.0 + randf_range(- _cesped_jitter, _cesped_jitter)),
					PUDDLE_BOUNCE, wet)
				var keep: float = lerpf(0.85, PUDDLE_SKID, wet)
				vel.x *= keep
				vel.z *= keep
				if wet > 0.0:


					_add_splash(pos, vel,
						Vector2(vel.x, vel.z).length() + absf(vel.y) * 2.0, true)
					wake_step = step
					was_dry = false
			else:
				vel.y = 0.0
				if wet > 0.0 and was_dry \
						and Vector2(vel.x, vel.z).length() > SPLASH_WAKE_SPEED:

					_add_splash(pos, vel, Vector2(vel.x, vel.z).length(), true)
					wake_step = step
					was_dry = false
		if pos.y == 0.0 and vel.y == 0.0:






			var roll_k: float = _cesped_drag + PUDDLE_ROLL_DRAG * wet
			vel.x *= 1.0 - roll_k * SIM_DT
			vel.z *= 1.0 - roll_k * SIM_DT












			var spd: float = Vector2(vel.x, vel.z).length()
			if wet > 0.0:
				if spd > SPLASH_WAKE_SPEED and step - wake_step >= SPLASH_GAP_STEPS:
					_add_splash(pos, vel, spd, was_dry)
					wake_step = step
				was_dry = false
			elif lluvia:




				if spd > WAKE_FILM_SPEED and step - wake_step >= SPLASH_GAP_FILM:
					_add_splash(pos, vel, spd * SPRAY_FILM, false)
					wake_step = step
				was_dry = true
			else:
				was_dry = true






		if barr_vivo and not resolved and not crossed:



			var bt: float = float(step + 1) * SIM_DT + BARRIDA_TIRO_PRE + _barr_antes
			var bm: float = INF
			if bt <= BARRIDA_TIRO_T and pos.y < BARRIDA_TIRO_INTENTO_H:
				var bx: float = 1.0 - bt / BARRIDA_TIRO_T
				bm = Vector2(pos.x, pos.z).distance_to(barr_d) \
						-(FALTA_PIERNA_M + SLIDE_MAX_M *(1.0 - bx * bx * bx))


			var bq: float = 0.0
			if bm <= 0.0:
				bq = clampf(- bm / BARRIDA_TIRO_PROF, 0.0, 1.0) * _barrida_cuerpo(- bm, pos.y)
			if bm < barr_m_min and bq >= barr_q_max:
				barr_m_min = bm
				barr_q_max = bq





				if bm < _barrida_intento(barr_eq) and not barr_de_pie:
					_barr_actor = barr.get("a")
					_barr_punto = pos
					_barr_mudo_i = int((BARRIDA_TIRO_T - BARRIDA_TIRO_PRE - _barr_antes
						+ BARRIDA_TIRO_MUDO_S) / SIM_DT)
			elif barr_m_min < INF or bt > BARRIDA_TIRO_T:
				barr_vivo = false


				var bp: Vector3 = _traj[_traj.size() - 1]
				if barr_m_min <= 0.0 and not barr_de_pie:

					wall_checked[barr_di] = true
					if randf() < _barrida_p_max(barr_eq) * barr_q_max:




						var bl_f: float = clampf(- barr_m_min / BARRIDA_TIRO_PROF, 0.0, 1.0)
						var pb: Array = _barrida_parte(- barr_m_min, bp.y)


						var nb: Vector3 = _desv_rasante(_desv_normal(vel_prev,
							Vector2(bp.x - barr_d.x, bp.z - barr_d.y), 1.0 - bl_f,
							float(pb[2])), 1.0 - _barrida_cuerpo(- barr_m_min, bp.y))
						var rb: Dictionary = _desv_respuesta(vel_prev, spin, back_spin,
							nb, float(pb[1]), false, 1.0)


						var vt: Vector3 = _barrida_techo(rb["vel"], vel_prev)
						if vt != rb["vel"]:
							rb["vel"] = vt
							if String(rb["tipo"]) == "desvio" and vt.z > 0.0:
								rb["tipo"] = "rechace"
						var bi: int = _traj.size() - 1



