func _tie_carry() -> int:
	var prev: Array = GameState.your_first_leg(GameState.current_fixture())
	return int(prev[0]) - int(prev[1]) if prev.size() >= 2 else 0












func _ko_sembrado(f: Dictionary = {}) -> int:
	var fx: Dictionary = GameState.current_fixture() if f.is_empty() else f
	if GameState.tie_rule(fx) != "sembrado":
		return 0
	return 1 if GameState.liguilla_you_better(String(fx.get("opp", ""))) else -1







