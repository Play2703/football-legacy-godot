func _run_coin_toss() -> void:
	_toss_won = false



	var soy_yo: bool = _am_captain() and _on_pitch_at_end()





	var dormidos: Array = []
	for hijo in _actors.get_children():
		var nodo: Node3D = hijo as Node3D
		if nodo != null and nodo.visible:
			nodo.visible = false
			dormidos.append(nodo)
	var ball_vis: bool = _ball.visible
	_ball.visible = false
	_toss_paint_header()
	var sitios: Dictionary = Volado.sitios(Stadium.FIELD_DEPTH)




	var mio: Vector2 = sitios["yo"]
	_toss_bodies.append(_spawn_actor(RIVAL_TEX, mio.x, mio.y,
		PLAYER_METRICS, PLAYER_HEIGHT_M, true if soy_yo else null))
	var suyo: Vector2 = sitios["rival"]
	_toss_bodies.append(_spawn_actor(RIVAL_TEX, suyo.x, suyo.y,
		RIVAL_METRICS, PLAYER_HEIGHT_M, null, true))


	var ref_cfg: Dictionary = _ref_look()
	var central: Vector2 = sitios["central"]
	var arbitro: AnimatedSprite3D = _spawn_actor(RIVAL_TEX, central.x, central.y,
		RIVAL_METRICS, PLAYER_HEIGHT_M, ref_cfg)
	_toss_bodies.append(arbitro)
	for clave in ["asis_izq", "asis_der"]:
		var p: Vector2 = sitios[clave]
		_toss_bodies.append(_spawn_actor(RIVAL_TEX, p.x, p.y,
			RIVAL_METRICS, PLAYER_HEIGHT_M, ref_cfg))


	if _toss_cam == null:
		_toss_cam = Camera3D.new()
		add_child(_toss_cam)
	_toss_cam.fov = Volado.FOV_CORRO
	_toss_cam.current = true




	_hud.show_hint("")
	_audio.whistle()



	var corro: Dictionary = Volado.camara_corro(Stadium.FIELD_DEPTH, TOSS_PUSH_IN)
	_toss_cam.position = corro["eye"]
	_toss_cam.look_at(corro["look"])
	if not Settings.reduce_motion:
		var cerrado: Dictionary = Volado.camara_corro(Stadium.FIELD_DEPTH)
		_toss_tw = create_tween()
		_toss_tw.tween_property(_toss_cam, "position", cerrado["eye"], 2.4) \
				.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	_hud.show_message(I18n.t("EL VOLADO"), UiKit.GOLD, 1.5)
	await _shoot_wait(1.9)
	_toss_paint_header()





	if _toss_tw != null and _toss_tw.is_valid():
		_toss_tw.kill()
	_toss_coin = _make_coin()
	_toss_coin.position = Volado.punto_mano(central)




	_toss_coin.rotation = Vector3(PI * 0.5, 0.0, 0.0)
	_actors.add_child(_toss_coin)


	_pose_arbitro_volado(arbitro, false)
	_hud.show_hint("")
	var mano: Dictionary = Volado.camara_mano(central)
	_toss_cam.fov = Volado.FOV_MANO
	_toss_cam.position = mano["eye"]
	_toss_cam.look_at(mano["look"])



	var cara_txt: String = I18n.t("Cara")
	var sol_txt: String = I18n.t("Sol")
	var eleccion: String
	if soy_yo:
		_hud.ask_coin_side(Competitions.accent_of(GameState.current_fixture()),
			cara_txt, sol_txt, I18n.t("¿Cara o sol?"))
		eleccion = String(await _hud.coin_side_chosen)
	else:
		eleccion = Volado.CARA if randf() < 0.5 else Volado.SOL
		_hud.show_message(I18n.tf("Tu equipo pide {0}.",
			[cara_txt if eleccion == Volado.CARA else sol_txt]),
			Color("f4f1ec"), 1.5)
		await _shoot_wait(1.7)
	_toss_paint_header()





	var vuelo_cam: Dictionary = Volado.camara_vuelo(Stadium.FIELD_DEPTH, central)
	_toss_cam.fov = Volado.FOV_VUELO
	_toss_cam.position = vuelo_cam["eye"]
	_toss_cam.look_at(vuelo_cam["look"])
	_pose_arbitro_volado(arbitro, true)



	await _shoot_wait(TOSS_ARM_LEAD)
	var alto: float = Volado.MANO_Y + TOSS_RISE
	var caida: Vector3 = Volado.punto_caida(central)
	var salida: Vector3 = _toss_coin.position


	_toss_spin_tw = create_tween()
	_toss_spin_tw.tween_property(_toss_coin, "rotation:x",
		PI * 0.5 + TAU * TOSS_SPINS, TOSS_FLY * 2.0).from(PI * 0.5)
	var arco: Tween = create_tween()
	arco.set_parallel(true)



	arco.tween_property(_toss_coin, "position:x", caida.x, TOSS_FLY * 2.0)
	arco.tween_property(_toss_coin, "position:z", caida.z, TOSS_FLY * 2.0)
	arco.tween_property(_toss_coin, "position:y", alto, TOSS_FLY) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	arco.chain().tween_property(_toss_coin, "position:y", caida.y, TOSS_FLY) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)


	if not Settings.reduce_motion:
		_toss_tw = create_tween()
		_toss_tw.tween_method(_toss_cam_mira,
			Vector3(salida.x, Volado.MANO_Y + 0.35, salida.z),
			Vector3(caida.x, alto, caida.z), TOSS_FLY) \
					.set_trans(Tween.TRANS_SINE)
	await _shoot_wait(TOSS_FLY * 2.0 + 0.15)
	_toss_paint_header()



	var salio: String = Volado.CARA if randf() < 0.5 else Volado.SOL



	if _toss_force != 0:
		var quiero_ganar: bool = _toss_force > 0
		salio = eleccion if quiero_ganar else (
			Volado.SOL if eleccion == Volado.CARA else Volado.CARA)
	_toss_won = Volado.gana(eleccion, salio)








	for tw in [_toss_spin_tw, _toss_tw]:
		if tw != null and tw.is_valid():
			tw.kill()
	_toss_spin_tw = null
	_toss_coin.rotation = Vector3(0.0 if salio == Volado.CARA else PI, 0.0, 0.0)
	_toss_coin.position = caida
	var suelo: Dictionary = Volado.camara_suelo(caida)
	_toss_cam.fov = Volado.FOV_SUELO
	_toss_cam.position = suelo["eye"]
	_toss_cam.look_at(suelo["look"])
	if not Settings.reduce_motion:


		var lejos: Vector3 = suelo["eye"] +(suelo["eye"] - suelo["look"]).normalized() * 0.55
		_toss_cam.position = lejos
		_toss_tw = create_tween()
		_toss_tw.tween_property(_toss_cam, "position", suelo["eye"], 0.85) \
				.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)



	await _shoot_wait(TOSS_REVEAL_LOOK)
	_audio.ooh() if not _toss_won else _audio.roar(-8.0)
	_hud.show_message(I18n.tf("La moneda dice {0}.",
		[cara_txt if salio == Volado.CARA else sol_txt]), UiKit.GOLD,
		TOSS_REVEAL_HOLD)
	await _shoot_wait(TOSS_REVEAL_HOLD)
	_toss_paint_header()




	var plano: Dictionary = Volado.camara_grada(_toss_won,
		_stadium.away_stand_spot() if _stadium != null else Vector3(27.0, 0.0, -1.6))
	if _toss_tw != null and _toss_tw.is_valid():
		_toss_tw.kill()
	_toss_cam.fov = Volado.FOV_CORRO
	_toss_cam.position = plano["eye"]
	_toss_cam.look_at(plano["look"])
	if _stadium != null:
		_stadium.crowd_react("home" if _toss_won else "away", "goal")
	if _toss_won:
		_audio.roar(-2.0)
		_hud.show_message(I18n.t("¡GANAS EL VOLADO! Pateas con tu gente."),
			UiKit.GOLD, TOSS_STAND_HOLD)
	else:
		_audio.ooh()
		_hud.show_message(I18n.t("Pierdes el volado: pateas ante la grada rival."),
			Color("ffb0b0"), TOSS_STAND_HOLD)
	await _shoot_wait(TOSS_STAND_HOLD)
	_clear_coin_toss()


	if _aim_cam:
		_aim_cam.current = true
	for nodo in dormidos:
		if is_instance_valid(nodo):
			nodo.visible = true
	_ball.visible = ball_vis
















