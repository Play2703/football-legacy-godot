func _fuera_del_hueco(ang: float, hueco: float, w: float) -> float:
	if w <= 0.0:
		return ang


	var d: float = wrapf(ang - hueco, - PI, PI)
	var borde: float = w + HUECO_JAMBA
	if absf(d) >= borde:
		return ang
	return hueco +(borde if d >= 0.0 else - borde)













func _jitter_reparto(paso: float) -> float:
	var amp: float = minf(paso * 0.25, 0.22)
	return randf_range(- amp, amp)



