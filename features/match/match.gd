func _strike_vreach() -> float:
	var dist: float = _shot_cam.global_position.distance_to(_strike_focus())
	if _lienzo_h:
		return tan(deg_to_rad(STRIKE_FOV * 0.5)) * dist * 0.72
	return tan(deg_to_rad(_shot_cam.fov * 0.5)) * dist * 0.72


























const BALL_ROLL_FRAMES: float = 4.0
const BALL_ROLL_FPS: float = 10.0


const ROLL_SCALE_MIN: float = 0.12
const ROLL_SCALE_MAX: float = 3.2























const STRIKE_ROLL_SLOW: float = 0.5




















func _ball_roll_ejes(frames: SpriteFrames) -> void:
	for eje in ["rollfwd", "rollside"]:
		var puestos: int = 0
		frames.add_animation(eje)
		frames.set_animation_loop(eje, true)
		frames.set_animation_speed(eje, BallDeco.AXIS_FPS)
		for i in BallDeco.AXIS_FRAMES:
			var path: String = "res://assets/sprites/objects/ball_%s_%d.png" % [eje, i]
			if not ResourceLoader.exists(path):
				continue
			var tex: Texture2D = load(path)
			if tex:
				frames.add_frame(eje, tex)
				puestos += 1


		if puestos == 0:
			frames.remove_animation(eje)























const ROLL_AXIS_EPS: float = 0.0001








func _roll_axis(vel: Vector2, cam: Camera3D) -> Array:
	var anim: String = "roll"
	var sentido: float = 1.0
	if cam != null:








		var v: Vector2 = vel
		var espejo: float = 1.0
		if v.x < 0.0 or (v.x == 0.0 and v.y < 0.0):
			v = - v
			espejo = -1.0
		var w: Vector3 = Vector3.UP.cross(Vector3(v.x, 0.0, v.y))
		var b: Basis = cam.global_transform.basis
		var wx: float = w.dot(b.x)
		var wy: float = w.dot(b.y)





		if absf(wy) >= absf(wx) - ROLL_AXIS_EPS:
			anim = "rollside"
			sentido =(1.0 if wy >= 0.0 else -1.0) * espejo
		else:
			anim = "rollfwd"
			sentido =(1.0 if wx >= 0.0 else -1.0) * espejo
	if _ball == null or _ball.sprite_frames == null \
			or not _ball.sprite_frames.has_animation(anim):
		anim = "roll"
		sentido = 1.0
	return [anim, sentido]


func _ball_roll(vel: Vector2, ritmo: float = 1.0) -> void:
	if not is_instance_valid(_ball) or _ball.sprite_frames == null:
		return
	var spd: float = vel.length()
	if spd < 0.05:








		if _ball.sprite_frames.has_animation("idle") \
				and String(_ball.animation) != "idle":
			_ball.play("idle")
		_ball.speed_scale = 1.0
		return
	var eje: Array = _roll_axis(vel, SceneFade.camara_de(self))
	var anim: String = String(eje[0])
	var sentido: float = float(eje[1])


	_ball.flip_h = false
	if String(_ball.animation) != anim:
		_ball.play(anim)
	_ball.speed_scale = _roll_scale(spd) * sentido * ritmo


func _roll_scale(speed: float) -> float:
	var rev_s: float = speed /(PI * BALL_VISUAL_D)
	return clampf(rev_s *(BALL_ROLL_FRAMES / BALL_ROLL_FPS),
		ROLL_SCALE_MIN, ROLL_SCALE_MAX)


func _update_strike_ball(delta: float) -> void:
	var ground_y: float = BALL_VISUAL_D * 0.5

	_ball.position += Vector3(_strike_vel.x, 0.0, _strike_vel.z) * delta





	if bool(_strike_motion.get("airborne", false)):
		_ball.position.y += _strike_vel.y * delta
		_strike_vel.y -= float(_strike_motion.get("gravity", HEADER_AIR_GRAVITY)) * delta
		_strike_travel += Vector2(_strike_vel.x, _strike_vel.z).length() * delta
		_ball_roll(Vector2(_strike_vel.x, _strike_vel.z), STRIKE_ROLL_SLOW)
		if _strike_travel >= _strike_span:
			_miss_strike_ball()
		return






	var g: float = float(_strike_motion.get("gravity", STRIKE_GRAVITY))
	var settle: float = STRIKE_SETTLE_VY * float(_strike_motion.get("vscale", 1.0))
	if _ball.position.y > ground_y + 0.0001 or _strike_vel.y > 0.0:
		_ball.position.y += _strike_vel.y * delta
		_strike_vel.y -= g * delta
		if _ball.position.y <= ground_y and _strike_vel.y < 0.0:
			_ball.position.y = ground_y
			var vy_up: float = - _strike_vel.y \
					* float(_strike_motion.get("rest", STRIKE_RESTITUTION))
			_strike_vel.y = vy_up if vy_up >= settle else 0.0
	else:
		_ball.position.y = ground_y
		_strike_vel.y = 0.0
	_strike_travel += Vector2(_strike_vel.x, _strike_vel.z).length() * delta




	_ball_roll(Vector2(_strike_vel.x, _strike_vel.z), STRIKE_ROLL_SLOW)
	if _strike_travel >= _strike_span:
		_miss_strike_ball()




