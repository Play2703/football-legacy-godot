func _switch_chance() -> Dictionary:
	var largo: Dictionary = _weighted_row(SWITCH_LENGTHS)
	var banda: Vector2 = largo["x"]
	var side: float = 1.0 if randf() < 0.5 else -1.0
	var x0: float = side * clampf(randf_range(banda.x, banda.y),
		SWITCH_BALL_X.x, SWITCH_BALL_X.y)
	var z0: float = randf_range(SWITCH_BALL_Z.x, SWITCH_BALL_Z.y)
	var ball: Vector2 = Vector2(x0, z0)




	var rango: Vector2 = largo["d"]
	var d: float = randf_range(rango.x, rango.y)










	var x_max_util: float = d - 2.0 - SWITCH_CROSS
	if absf(x0) > x_max_util:
		x0 = side * maxf(x_max_util, SWITCH_BALL_X.x)
		ball = Vector2(x0, z0)
	var dx_min: float = minf(absf(x0) + SWITCH_CROSS, d - 2.0)
	var dz_max: float = sqrt(maxf(d * d - dx_min * dx_min, 0.0))
	var dz: float = minf(randf_range(SWITCH_ADV.x, SWITCH_ADV.y), dz_max)
	var dx: float = sqrt(maxf(d * d - dz * dz, 1.0))
	var target: Vector2 = Vector2(
		clampf(x0 - side * dx, - SWITCH_X_MAX, SWITCH_X_MAX),
		maxf(z0 - dz, SWITCH_Z_MIN))
	var shape: String = SWITCH_SHAPES[randi() % SWITCH_SHAPES.size()]
	var defs: Array = _switch_defense(ball, target, shape)









	var once: Dictionary = _rival_eleven_at(ball)
	var mundo: Dictionary = _press_world(ball, once, defs)
	return {
		"kind": Practice.SWITCH,
		"name": String(largo["name"]),
		"ball": ball,
		"teammates": _switch_mates(ball, target, side),
		"defenders": defs,
		"defender_players": mundo["press_players"],
		"extras_rivals": mundo["rivals"],
		"extras_rival_players": mundo["rival_players"],
		"extras_mates": mundo["mates"],
		"switch": true,



		"switch_len": String(largo["id"]),
		"switch_shape": shape,
	}





func _weighted_row(rows: Array) -> Dictionary:
	var total: int = 0
	for r in rows:
		total += int(r.get("peso", 1))
	var roll: int = randi() % maxi(total, 1)
	for r in rows:
		roll -= int(r.get("peso", 1))
		if roll < 0:
			return r
	return rows[rows.size() - 1]




func _switch_defense(ball: Vector2, target: Vector2, shape: String) -> Array:
	var defs: Array = []
	var n: int = randi_range(SWITCH_RIVALS.x, SWITCH_RIVALS.y)



	if _tutorial_active:
		n = mini(n, TUTORIAL_RIVALES_MAX)
	var eje: Vector2 =(target - ball).normalized()
	var perp: Vector2 = eje.orthogonal()
	var lado: float = 1.0 if randf() < 0.5 else -1.0
	for i in n:
		var frac: float = float(i) / maxf(float(n - 1), 1.0)
		var p: Vector2 = ball
		match shape:
			"salida":


				var ang: float = lerpf(-0.9, 0.9, frac)
				p = ball + eje.rotated(ang) * randf_range(3.5, 8.0)
			"destino":


				if i == 0:
					p = ball.lerp(target, 0.55) + perp * lado * randf_range(2.0, 5.0)
				else:
					p = target + Vector2(randf_range(-1.0, 1.0),
						randf_range(-1.0, 1.0)).normalized() * randf_range(3.0, 7.5)
			"linea":

				var lz: float = lerpf(ball.y, target.y, randf_range(0.4, 0.55))
				p = Vector2(lerpf(ball.x, target.x, lerpf(0.12, 0.88, frac)), lz)
			_:

				p = ball.lerp(target, lerpf(0.25, 0.85, frac)) \
						+ perp * lado * randf_range(1.5, 6.0)
		lado = - lado
		defs.append(Vector2(clampf(p.x, - FIELD_EDGE, FIELD_EDGE),
			clampf(p.y, 4.0, FIELD_BACK)))
	return defs






func _switch_mates(ball: Vector2, target: Vector2, side: float) -> Array:
	var mates: Array = [target]
	for i in randi_range(SWITCH_HELPERS.x, SWITCH_HELPERS.y):
		var spot: String = SWITCH_HELP_SPOTS[randi() % SWITCH_HELP_SPOTS.size()]
		var p: Vector2 = ball
		match spot:
			"interior":


				p = Vector2(ball.x - side * randf_range(7.0, 13.0),
					ball.y - randf_range(2.0, 8.0))
			"banda":

				p = Vector2(ball.x + side * randf_range(0.0, 3.0),
					ball.y - randf_range(6.0, 12.0))
			_:


				p = Vector2(ball.x - side * randf_range(4.0, 10.0),
					ball.y + randf_range(1.0, 7.0))
		mates.append(Vector2(clampf(p.x, - FIELD_EDGE, FIELD_EDGE),
			clampf(p.y, 4.0, FIELD_BACK)))
	return mates





























