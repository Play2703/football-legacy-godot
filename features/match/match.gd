			_fans_keep_ball()









	if _beer_ix >= 0 and _stand_ix < 0 and not _beer_out \
			and _traj_i >= _beer_ix - BEER_LEAD:
		_beer_out = true
		_show_beer_fan()
	if _beer_ix >= 0 and _stand_ix < 0 and not _beer_done and _traj_i >= _beer_ix:
		_beer_done = true
		_spill_the_beer()







	if _glass_ix >= 0 and not _glass_cut and _traj_i >= _glass_ix - GLASS_CAM_LEAD:
		_glass_cut = true

		if not Settings.reduce_motion and Career.claim_damage_scene("glass"):
			_cut_to_box_glass()

	if _glass_ix >= 0 and not _glass_spooked and _stadium != null \
			and _traj_i >= _glass_ix - GLASS_SPOOK_LEAD:
		_glass_spooked = true
		_stadium.spook_box(_glass_i)

	if _glass_ix >= 0 and not _glass_done and _traj_i >= _glass_ix:
		_glass_done = true
		_break_box_glass()


	if _vend_ix >= 0 and not _vend_cut and _traj_i >= _vend_ix - VEND_CUT_LEAD:
		_vend_cut = true
		if not Settings.reduce_motion:
			_cut_to_vendor()
	if _vend_ix >= 0 and not _vend_done and _traj_i >= _vend_ix:
		_vend_done = true
		_hit_vendor()

	if _dron_ix >= 0 and not _dron_done and _traj_i >= _dron_ix:
		_dron_done = true
		_hit_dron()

	if _playa_ix >= 0 and not _playa_done and _traj_i >= _playa_ix:
		_playa_done = true
		_hit_playa()

	if _celu_ix >= 0 and not _celu_done and _traj_i >= _celu_ix:
		_celu_done = true
		_hit_celu()








