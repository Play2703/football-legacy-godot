func _spawn_entrant(tex: Texture2D, look: Dictionary, i: int, side: int,
		gap: float, target: Vector2, ficha: Dictionary = {},
		es_por: bool = false) -> void:





	var lane: float = ENTRANCE_LANE *(0.5 - float(side))
	var metrics: Vector2 = RIVAL_METRICS if side == 1 else PLAYER_METRICS




	var vestido: Dictionary = _portero_look(side, String(ficha.get("name", ""))) \
			if es_por else look
	var a: AnimatedSprite3D = _spawn_actor(tex, ENTRANCE_MOUTH.x,
		ENTRANCE_MOUTH.y + lane, metrics, PLAYER_HEIGHT_M, vestido, side == 1)
	if es_por:
		_vestir_de_portero(a, vestido)


	a.visible = false
	a.play("idle")


	if not ficha.is_empty():
		a.set_meta("player", ficha)


		var tside: TagSide = TagSide.RIVAL if side == 1 \
				else (TagSide.YOU if bool(ficha.get("is_you", false)) else TagSide.MATE)
		_attach_name_tag(a, tside, String(ficha.get("name", "")))





		var tag: Node3D = a.get_node_or_null("NameTag")
		if tag != null:
			tag.scale = Vector3.ONE * ENTRANCE_TAG_SCALE



	_entrants.append({
		"node": a,
		"path": PackedVector2Array([
			ENTRANCE_MOUTH + Vector2(0.0, lane),
			ENTRANCE_GATE + Vector2(0.0, lane),
			target,
		]),
		"t0": gap * float(i) + 0.5 * gap * float(side),




		"face": signf(Stadium.HALF_LINE - ENTRANCE_GOAL_Z[side]),
		"done": false,
	})









func _tick_entrance(delta: float) -> void:
	if _entrants.is_empty():
		return
	_entrance_t += delta
	for e in _entrants:




		var raw: Variant = e["node"]
		if not is_instance_valid(raw):
			continue
		var a: AnimatedSprite3D = raw
		var t: float = _entrance_t - float(e["t0"])
		if t <= 0.0:
			continue
		var path: PackedVector2Array = e["path"]
		var d: float = t * ENTRANCE_SPEED
		var here: Vector2 = _entrance_point(path, d)
		a.position = Vector3(here.x, a.position.y, here.y)
		if not a.visible:
			a.visible = true
			a.speed_scale = clampf(ENTRANCE_SPEED / ENTRANCE_STRIDE,
				1.0, ENTRANCE_ANIM_MAX)









		if _entrance_len(path) - d <= 0.05:
			if not e["done"]:
				e["done"] = true
				a.speed_scale = 1.0
			_face(a, Vector3(0.0, 0.0, float(e["face"])))
			continue
		e["done"] = false


		var ahead: Vector2 = _entrance_point(path, d + 1.0)
		_play_run(a, Vector3(ahead.x - here.x, 0.0, ahead.y - here.y))



func _entrance_len(path: PackedVector2Array) -> float:
	var total: float = 0.0
	for i in range(path.size() - 1):
		total += path[i].distance_to(path[i + 1])
	return total




func _entrance_point(path: PackedVector2Array, d: float) -> Vector2:
	for i in range(path.size() - 1):
		var seg: Vector2 = path[i + 1] - path[i]
		var len_seg: float = seg.length()
		if d <= len_seg:
			return path[i] + seg.normalized() * maxf(d, 0.0)
		d -= len_seg
	return path[path.size() - 1]





func _stop_entrance() -> void:
	_entrants.clear()







































