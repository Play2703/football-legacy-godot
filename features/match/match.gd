func _cedida_deshaz_clon() -> void:
	if _falta_taker.is_empty():
		return
	var clon: AnimatedSprite3D = null
	var usados: Dictionary = {_falta_taker: true, Career.player_name: true}
	for a in _teammate_actors:
		if a == null or not is_instance_valid(a) or not a.has_meta("player"):
			continue
		var n: String = String(Dictionary(a.get_meta("player")).get("name", ""))
		usados[n] = true
		if n == _falta_taker:
			clon = a
	if clon == null:
		return
	var libre_row: Dictionary = {}
	for row in _squad_hoy(_my_side_id()):
		if String(row.get("pos", "")) == "POR":
			continue

		if MatchSim.esta_fuera(true, String(row.get("name", ""))):
			continue
		if not usados.has(String(row.get("name", ""))):
			libre_row = row
			break
	_drop_name_tag(clon)
	if libre_row.is_empty():
		clon.remove_meta("player")
		return
	var nn: String = String(libre_row.get("name", ""))
	var look: Dictionary = _look_for(nn, GameState.player_look(), "",
		int(libre_row.get("number", 0)))
	_revestir_actor(clon, TEAM_TEX, look)
	clon.set_meta("look", look)
	clon.set_meta("player", libre_row)


	clon.set_meta("af", clampf(
		float(Career.socio_v(nn)) / float(Career.SOCIO_MAX), -1.0, 1.0))
	_attach_name_tag(clon, TagSide.MATE, nn)



































