func _cobro_carrerilla(dir3: Vector3) -> void:
	var y0: float = _self_actor.position.y
	var contact: Vector3 = Vector3(_ball_field.x, y0, _ball_field.y) - dir3 * 0.5
	_play_run(_self_actor, contact - _self_actor.position)
	var run_tw: Tween = create_tween().set_trans(Tween.TRANS_LINEAR)
	run_tw.tween_property(_self_actor, "position", contact, 0.55)
	run_tw.tween_property(_self_actor, "position",
		contact + Vector3(dir3.x, 0.0, dir3.z) * 0.45, 0.32) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	await _shoot_wait(0.41)



	if not is_inside_tree() or not is_instance_valid(_self_actor):
		return
	var kick_anim: String = "kick_" + _dir_name(dir3)


	if _gesto_listo(_self_actor, kick_anim):
