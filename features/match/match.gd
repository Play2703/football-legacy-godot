func _celeb_coach_mira(f: Vector3) -> Vector3:
	var par: Vector3 = _celeb_coach_par(_celeb_focus_pos)
	var falta: float = Vector2(f.x - _celeb_focus_pos.x, f.z - _celeb_focus_pos.z).length()
	var w: float = clampf(inverse_lerp(CELEB_COACH_MIRA_LEJOS, CELEB_COACH_MIRA_CERCA,
		falta), 0.0, 1.0)
	var corre: Vector3 = f + Vector3(0.0, CELEB_LOOK_H, 0.0)
	return corre.lerp(Vector3(par.x, CELEB_COACH_LOOK_Y, par.z), w)



