		var slots: Array = [_ball]
		slots.append_array(_actors.get_children())



		_rec.arm(slots, [_self_actor] if _self_actor != null else [])


		if _rec.audio == null or not is_instance_valid(_rec.audio):
			_rec.audio = ReplayAudio.instala(self)
	if not _rec.armed:
		return
























	var paso: float = delta / maxf(Engine.time_scale, 0.05) \
			if _fx != null and _fx.reloj_en_rampa() else delta * _rec_reloj_mundo()
	_rec_t += paso











	var cam_viva: Camera3D = SceneFade.camara_de(self)
	if cam_viva != null and cam_viva == _shot_cam and _aim_cam != null:
		cam_viva = _aim_cam




	var aro_ok: bool = _drive_ring != null and is_instance_valid(_drive_ring) \
			and _drive_ring.is_visible_in_tree() and _drive_ring.layers != 0
	var palabra: String = ""
	if aro_ok and _ring_label != null and _ring_label.visible:
		palabra = _ring_label_current
	_rec.ring_state(_drive_ring.position if aro_ok else Vector3.ZERO,
		(_drive_ring.mesh as QuadMesh).size.x if aro_ok else 0.0, palabra)
	_rec.sample(_rec_t, cam_viva)







func _rec_reloj_mundo() -> float:
	return clampf(_world_k(false) * _servicio_reloj_ruta(), 0.05, 1.0)




func _freeze_goal_replay() -> void:
	var minuto: String = "%d'" % match_minute
	var clip: ReplayRec.Clip = _rec.freeze(minuto)
	if clip == null:
		return








	var cedido_ajeno: bool =(_cedida_en_curso or _corner_ced_live) and not _cedida_tuya
	clip.ajeno = _celeb_rival or _rebound_mate or (_pass_done and not _rebound_cut) \
			or cedido_ajeno

	if _cano_rec_t >= 0.0 and clip.times.size() > 0 and _cano_rec_t >= clip.times[0]:
		clip.cano_t = _cano_rec_t
	_goal_clip = clip


	_goal_seq += 1
	_goal_clips[_goal_seq] = clip
	_goal_metas[_goal_seq] = _meta_repe(minuto, clip)
	while _goal_clips.size() > GOAL_CLIPS_MAX:
		var viejo: Variant = _goal_clips.keys()[0]
		_goal_clips.erase(viejo)
		_goal_metas.erase(viejo)

















	if not _practice_kind.is_empty():
		return
	var path: PackedVector3Array = clip.ball_path()
	var flat: PackedFloat32Array = PackedFloat32Array()
	for i in range(0, path.size(), 2):
		flat.append(path[i].x)
		flat.append(path[i].y)
		flat.append(path[i].z)
	Career.goal_reel = {
		"path": flat,
		"season": GameState.season_num,
		"opp": String(GameState.current_fixture().get("opp", "")),
		"minuto": minuto,
	}






func _meta_repe(minuto: String, clip: ReplayRec.Clip) -> Dictionary:
