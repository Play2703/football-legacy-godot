func _mira_rechace(target: Vector3, bp: Vector3) -> Vector3:
	var cam: Vector3 = _aim_cam.global_position
	var t: Vector3 = target - cam
	t.y = 0.6 +(target.y - 0.6) * cam_rechace_y - cam.y
	var plano: float = Vector2(t.x, t.z).length()
	var b: Vector3 = bp - cam
	var plano_b: float = Vector2(b.x, b.z).length()
	if plano < 0.01 or plano_b < 0.01:
		return target
	var picado_b: float = atan2(b.y, plano_b)
	var m: float = deg_to_rad(_aim_cam.fov * 0.5) * CAM_RECHACE_BORDE
	var picado: float = clampf(atan2(t.y, plano), picado_b - m, picado_b + m)
	return cam + Vector3(t.x, plano * tan(picado), t.z)


func _update_flight_camera(delta: float) -> void:







	if Practice.con_maquina(_practice_kind):
		return








	if _cobro_corre:
		return


	if _despeje_quieto:
		return
	var bp: Vector3 = _ball.position

	var vel: Vector3 = Vector3.ZERO
	if _traj_i > 0 and _traj_i < _traj.size():
		vel =(_traj[_traj_i] - _traj[_traj_i - 1]) / SIM_DT

	var target: Vector3 = bp + vel * FLIGHT_LEAD + Vector3(0.0, 0.6, 0.0)

	if cam_rechace_y < 1.0 and (_balon_suelto() or _clear_phase):
		target = _mira_rechace(target, bp)










	if bp.z >= OWN_GOAL_Z:
		if _cam_mi_linea == Vector3.INF:
			_cam_mi_linea = Vector3(bp.x, bp.y + 0.6, OWN_GOAL_Z)
		target = _cam_mi_linea

	var to_ball: Vector3 = bp - _aim_cam.global_position
	var cam_d: float = maxf(to_ball.length(), 0.5)
	var ang_speed: float =(vel - vel.project(to_ball)).length() / cam_d
	var stiff: float = lerpf(FLIGHT_STIFF.x, FLIGHT_STIFF.y,
		clampf(ang_speed / 1.6, 0.0, 1.0))
	_aim_cam_look(target, delta, stiff)

	if _flight_d0 <= 0.0:
		_flight_d0 = cam_d
	var half: float = tan(deg_to_rad(_aim_fov_base * 0.5)) * pow(_flight_d0 / cam_d, FLIGHT_FOV_K)
	var want: float = clampf(rad_to_deg(2.0 * atan(half)),
		FLIGHT_FOV_MIN, _aim_fov_base + 4.0)


	var k: float = 4.0
	if _outcome == "goal" and _cross_i >= 0 and _traj_i >= _cross_i:
		var t: float = clampf(float(_traj_i - _cross_i) * SIM_DT / GOAL_PUSH_S, 0.0, 1.0)


		want = lerpf(want, GOAL_PUSH_FOV, t * t *(3.0 - 2.0 * t))


		k = 8.0
	_aim_cam.fov = lerpf(_aim_cam.fov, want, 1.0 - exp(- k * delta))

















