		return _ring_start
	var body: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
	if _aim_cam.is_position_behind(body):
		return _ring_start
	return _aim_cam.unproject_position(body)








func _pos_in_ring(screen_pos: Vector2) -> bool:


	var hyst: float = 1.0 if _ring_out else 1.0 / RING_HYST
	var r: float = _ring_world_r * hyst
	var g: Vector2 = _ground_at(screen_pos)
	if is_inf(g.x) or not is_instance_valid(_self_actor):



		return _ring_screen_center().distance_to(screen_pos) \
				<= _ring_radius_px() * hyst






	return g.distance_to(Vector2(_self_actor.position.x, _self_actor.position.z)) <= r


























































