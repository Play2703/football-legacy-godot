func _order_drag_now(a: AnimatedSprite3D) -> void:



	var from_a: Vector3 = a.position
	var to: Vector3 = a.get_meta("order_dest", _order_drag_target(a))
	var speed: float = maxf(float(_chaser_speed.get(a, 3.2)) * 0.62, 0.1)
	var dur: float = _flat_dist(a.position, to) / speed
	var tws: Array = []
	_run_target[a] = to
	a.set_meta("order_run", true)
	_play_run(a, to - a.position)
	var tw: Tween = _order_tween_new()
	tw.tween_property(a, "position", to, dur)

	tw.parallel().tween_method(_order_path_trim.bind(a), 0.0, 1.0, dur)
	tw.tween_callback(func() -> void:
		_run_target.erase(a)
		_order_release(a)
		if is_instance_valid(a):
			_face_ball(a))
	tws.append(tw)
	var di: int = _nearest_defender_index(a.position, ORDER_DRAG_REACH_M)
	if di >= 0:
		var r: AnimatedSprite3D = _rival_actors[di]


		a.set_meta("order_drag_rival", r)

		var rto: Vector3 = to +(r.position - a.position).normalized() * 1.1
		rto.y = r.position.y
		_run_target[r] = rto
		r.set_meta("order_run", true)
		_play_run(r, rto - r.position)
		var tw2: Tween = _order_tween_new()
		var from_r: Vector3 = r.position


		tw2.tween_method(_drag_defender_step.bind(from_r, rto, di, r), 0.0, 1.0, dur)
		tw2.tween_callback(func() -> void:
			_run_target.erase(r)
			_order_release(r)
			if is_instance_valid(r):
				_face_ball(r))
		tws.append(tw2)













	var ci: int = _nearest_defender_index(from_a, ORDER_DRAG_COVER_REACH_M, di)
	if ci >= 0:
		var c: AnimatedSprite3D = _rival_actors[ci]
		var hueco: Vector3 = from_a
		var haciabalon: Vector3 = Vector3(_ball_field.x, from_a.y, _ball_field.y) - hueco
		if haciabalon.length() > 0.01:
			hueco += haciabalon.normalized() * ORDER_DRAG_COVER_LAG_M
		hueco.y = c.position.y
		var cdur: float = maxf(_flat_dist(c.position, hueco)
			/ maxf(float(_chaser_speed.get(c, 3.2)) * 0.8, 0.1), 0.2)
		_run_target[c] = hueco




		a.set_meta("order_drag_cover", c)
		c.set_meta("order_run", true)
		_play_run(c, hueco - c.position)
		var tw3: Tween = _order_tween_new()
		var from_c: Vector3 = c.position
		tw3.tween_method(_drag_defender_step.bind(from_c, hueco, ci, c), 0.0, 1.0, cdur)
		tw3.tween_callback(func() -> void:
			_run_target.erase(c)
			_order_release(c)
			if is_instance_valid(c):
				_face_ball(c))
		tws.append(tw3)
	_order_tweens[a] = tws






func _drag_defender_step(t: float, from_r: Vector3, rto: Vector3, di: int,
		r: AnimatedSprite3D) -> void:
	if not is_instance_valid(r):
		return
	var p: Vector3 = from_r.lerp(rto, t)
	r.position = p
	if di < _defender_pos.size():
		_defender_pos[di] = Vector2(p.x, p.z)





func _nearest_defender_index(from: Vector3, max_m: float, skip: int = -1) -> int:
	var best: int = -1
	var bd: float = max_m
	for i in _rival_actors.size():
		if i == skip:
			continue
		var r: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(r) or r.has_meta("hold_wall") \
				or r.has_meta("order_run"):
			continue
		var d: float = _flat_dist(r.position, from)
		if d < bd:
			bd = d
			best = i
	return best










func _fire_order_runs() -> void:


	_orders_locked = true
	for a in _mate_orders.keys():
		if not is_instance_valid(a):
			continue
		if a.has_meta("order_fired"):
			for tw in _order_tweens.get(a, []):




				if _order_tw_vivo(tw):
					tw.play()

			a.remove_meta("order_paused")
			if _run_target.has(a):
				_play_run(a, _run_target[a] - a.position)
			for m in ["order_drag_rival", "order_drag_cover"]:
				var r_dormido: Variant =(a.get_meta(m) if a.has_meta(m) else null)
				if r_dormido == null or not is_instance_valid(r_dormido):
					continue



				(r_dormido as AnimatedSprite3D).remove_meta("order_paused")
				if _run_target.has(r_dormido):
					_play_run(r_dormido, _run_target[r_dormido] - r_dormido.position)
			continue
		var order: int = int(_mate_orders[a])
		if order == ORDER_STAY:
			continue
		a.set_meta("order_fired", true)
		if order == ORDER_DRAG:
			_order_drag_now(a)
			continue
		var to: Vector3 = _order_run_target(a)
		var dur: float = _flat_dist(a.position, to) \
				/ maxf(float(_chaser_speed.get(a, 3.3)), 0.1)
		_run_target[a] = to
		a.set_meta("order_run", true)
		_play_run(a, to - a.position)
		var tw: Tween = _order_tween_new()
		tw.tween_property(a, "position", to, dur)


		tw.parallel().tween_method(_order_path_trim.bind(a), 0.0, 1.0, dur)
		tw.tween_callback(func() -> void:
			_run_target.erase(a)
			_order_release(a)
			if is_instance_valid(a):
				_face_ball(a))
		var tws: Array = _order_tweens.get(a, [])
		tws.append(tw)
		_order_tweens[a] = tws









func _orders_pause() -> void:
	for a in _mate_orders.keys():
		if not is_instance_valid(a):
			continue
		for tw in _order_tweens.get(a, []):



			if _order_tw_vivo(tw):
				tw.pause()









		if _order_owned(a) and _run_target.has(a):
			a.set_meta("order_paused", true)
			_face_ball(a)
		for m in ["order_drag_rival", "order_drag_cover"]:
			var r: Variant =(a.get_meta(m) if a.has_meta(m) else null)
			if r != null and is_instance_valid(r) and _order_owned(r) \
					and _run_target.has(r):
				(r as AnimatedSprite3D).set_meta("order_paused", true)
				_face_ball(r)





func _clear_orders() -> void:
	for a in _mate_orders.keys():
		if is_instance_valid(a):
			_undo_order(a)

	for a in _order_paths.keys():
		if is_instance_valid(_order_paths[a]):
			_order_paths[a].queue_free()
	_mate_orders.clear()
	_order_tweens.clear()
	_order_tw_muertos.clear()
	_order_paths.clear()




































var _aim_soft: Vector2 = Vector2.INF
var _aim_soft_anchor: Vector2 = Vector2.INF






func _soft_aim_pos(ancla: Vector2, crudo: Vector2) -> Vector2:
	if _aim_soft == Vector2.INF or _aim_soft_anchor != ancla:
		_aim_soft_anchor = ancla
		_aim_soft = crudo
		return crudo


	var ref: float = maxf(MAX_PULL * AIM_LEVER_REF * _pull_scale(), 1.0)
	var alpha: float = clampf(ancla.distance_to(crudo) / ref, AIM_SOFT_ALPHA_MIN, 1.0)
	_aim_soft = _aim_soft.lerp(crudo, alpha)
	return _aim_soft



func _soft_aim_clear() -> void:
	_aim_soft = Vector2.INF
	_aim_soft_anchor = Vector2.INF


func _world_aim_dir(aim: Vector2, elev: float = 0.0) -> Vector3:














































	var objetivo: float = aim.angle()
	aim = Vector2(aim.x * AIM_LATERAL_GAIN, aim.y).normalized()
	var bp: Vector3 = Vector3(_ball_field.x, 0.0, _ball_field.y)











	var base: Basis = _aim_cam.global_basis
	if _drive_cam_settling and not _drive_active:
		base = _aim_cam_basis
	var flat: Vector3 = Vector3(- base.z.x, 0.0, - base.z.z)
	var fwd: Vector3 = flat.normalized() if flat.length() > 0.01 \
			else (Vector3.ZERO - bp).normalized().rotated(Vector3.UP, _aim_yaw)
	var right: Vector3 = Vector3(- fwd.z, 0.0, fwd.x)
	return _solve_aim_dir((right * aim.x + fwd * - aim.y).normalized(), objetivo, elev)













func _solve_aim_dir(semilla: Vector3, objetivo: float, elev: float) -> Vector3:
	if _aim_cam == null or not is_instance_valid(_aim_cam):
		return semilla
	var tope: float = deg_to_rad(AIM_FIX_MAX)
	var f_lo: float = _aim_screen_err(semilla, - tope, objetivo, elev)
	var f_hi: float = _aim_screen_err(semilla, tope, objetivo, elev)
	if is_nan(f_lo) or is_nan(f_hi):
		return semilla



	if signf(f_lo) == signf(f_hi):
		var mejor: float = - tope if absf(f_lo) < absf(f_hi) else tope
		return semilla.rotated(Vector3.UP, mejor).normalized()
	var lo: float = - tope
	var hi: float = tope
	for i in AIM_FIX_ITERS:
		var mid: float =(lo + hi) * 0.5
		var f: float = _aim_screen_err(semilla, mid, objetivo, elev)
		if is_nan(f):
			return semilla
		if signf(f) == signf(f_lo):
			lo = mid
			f_lo = f
		else:
			hi = mid
	return semilla.rotated(Vector3.UP,(lo + hi) * 0.5).normalized()









func _aim_screen_err(semilla: Vector3, delta: float, objetivo: float,
		elev: float) -> float:
	var bp: Vector3 = Vector3(_ball_field.x, 0.0, _ball_field.y)
	var plano: Vector3 = semilla.rotated(Vector3.UP, delta)
	var rayo: Vector3 =(plano + Vector3.UP * tan(elev)).normalized()
	var punta: Vector3 = bp + rayo * AIM_RAY_M
	if _aim_cam.is_position_behind(bp) or _aim_cam.is_position_behind(punta):
		return NAN
	var p0: Vector2 = _aim_cam.unproject_position(bp)
	var p1: Vector2 = _aim_cam.unproject_position(punta)
	if p0.distance_to(p1) < AIM_RAY_MIN_PX:
		return NAN
	return angle_difference(objetivo,(p1 - p0).angle())






















func _pull_ratio(pull: Vector2) -> float:
	return clampf(pull.length() / maxf(MAX_PULL * _pull_scale(), 1.0), 0.0, 1.0)












func _aim_ratio(pull: Vector2, screen_pos: Vector2) -> float:
	return _ring_pull_ratio(screen_pos) if _aim_from_ring else _pull_ratio(pull)










func _aim_dead(pull: Vector2, ratio: float) -> bool:
	if _aim_from_ring:
		return _ring_dead(pull, ratio)
	return ratio < MIN_POWER_RATIO


















func _ring_pull_ratio(screen_pos: Vector2) -> float:
	return clampf(_ring_pull_frac(screen_pos), 0.0, 1.0)





func _ground_at(screen_pos: Vector2) -> Vector2:
	if _aim_cam == null:
		return Vector2.INF
	var from: Vector3 = _aim_cam.project_ray_origin(screen_pos)
	var dir: Vector3 = _aim_cam.project_ray_normal(screen_pos)


	if dir.y > -0.001:
		return Vector2.INF
	var g: Vector3 = from + dir *(- from.y / dir.y)
	return Vector2(g.x, g.z)




func _ring_pull_frac(screen_pos: Vector2) -> float:
	var g: Vector2 = _ground_at(screen_pos)
	if is_inf(g.x) or _ring_start_ground == Vector2.INF:

		return (_ring_start - screen_pos).length() / maxf(_ring_px, 1.0)
	return g.distance_to(_ring_start_ground) / maxf(_ring_world_r, 0.01)






















func _touch_in_drive_ring(screen_pos: Vector2) -> bool:
	if not is_instance_valid(_self_actor):
		return false
	var feet: Vector2 = Vector2(_self_actor.position.x, _self_actor.position.z)

	var from: Vector3 = _aim_cam.project_ray_origin(screen_pos)
	var dir: Vector3 = _aim_cam.project_ray_normal(screen_pos)
	if absf(dir.y) > 0.0001:
		var ground: Vector3 = from + dir *(- from.y / dir.y)
		if Drive.in_ring(Vector2(ground.x, ground.z), feet, _ring_world_r):
			return true

	var body: Vector3 = _self_actor.global_position + Vector3.UP * PLAYER_HEIGHT_M * 0.5
	if _aim_cam.is_position_behind(body):
		return false
	return _aim_cam.unproject_position(body).distance_to(screen_pos) <= DRIVE_TOUCH_R














