static func _medic_anims() -> Array:
	var out: Array = []
	for d in ["west", "east"]:
		var run: Array = []
		for i in 6:
			run.append("res://assets/sprites/anim/medico_run_%s_%02d.png" % [d, i])
		out.append(["run_" + d, 9.0, true, run])
		var at: Array = []
		for i in 4:
			at.append("res://assets/sprites/anim/medico_atiende_%s_%02d.png" % [d, i])
		out.append(["atiende_" + d, 6.0, false, at])
	for d in ["south", "north", "east", "west"]:
		out.append(["idle_" + d, 5.0, true, ["res://assets/sprites/anim/medico_idle_%s.png" % d]])
	return out


func _medic_frames(semilla: String) -> SpriteFrames:



	if not _medic_frames_cache.has(semilla):
		_pe_suelta(true)
	if _medic_frames_cache.has(semilla):
		return _medic_frames_cache[semilla]
	var frames: SpriteFrames = _frames_de_personal(_medic_anims(), Coach.look_de(semilla))


	if frames != null:
		_medic_frames_cache[semilla] = frames
	return frames




static func _frames_de_personal(anims: Array, cfg: Dictionary) -> SpriteFrames:
	var frames: SpriteFrames = SpriteFrames.new()
	for a in anims:
		var anim: String = a[0]
		frames.add_animation(anim)
		frames.set_animation_speed(anim, float(a[1]))
		frames.set_animation_loop(anim, bool(a[2]))
		for ruta in a[3]:
			var t: Texture2D = _cara_de_personal(load(ruta), cfg)
			if t == null:
				return null
			frames.add_frame(anim, t)
	return frames




static func _cara_de_personal(t: Variant, cfg: Dictionary) -> Texture2D:
