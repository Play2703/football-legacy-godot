func _recu_chance() -> Dictionary:
	var rng := RandomNumberGenerator.new()
	rng.randomize()



	_ensure_shapes()
	var ch: Dictionary = Recupera.chance(rng, _my_shape, _rival_shape)
	_recu_reparte_fichas(ch)
	return ch


















func _recu_reparte_fichas(ch: Dictionary) -> void:
	var sus: Array =(ch["defenders"] as Array) +(ch.get("extras_rivals", []) as Array)
	var sus_pl: Array = _recu_empareja(sus, _rival_by_advance(), false)
	var n_def: int =(ch["defenders"] as Array).size()
	ch["defender_players"] = sus_pl.slice(0, n_def)
	ch["extras_rival_players"] = sus_pl.slice(n_def)
	var mios: Array =(ch["teammates"] as Array) +(ch.get("extras_mates", []) as Array)


	var mios_pl: Array = _recu_empareja(mios.slice(1),
		_recu_por_avance(_finishers_hoy()), true)
	mios_pl.insert(0, {})
	var n_mate: int =(ch["teammates"] as Array).size()
	ch["mate_players"] = mios_pl.slice(0, n_mate)
	ch["extras_mate_players"] = mios_pl.slice(n_mate)




func _recu_empareja(sitios: Array, fichas: Array, hacia_mi_arco: bool) -> Array:
	var out: Array = []
	out.resize(sitios.size())
	var idx: Array = range(sitios.size())
	if hacia_mi_arco:
		idx.sort_custom(func(a, b): return \
				(sitios[a] as Vector2).y <(sitios[b] as Vector2).y)
	else:
		idx.sort_custom(func(a, b): return \
				(sitios[a] as Vector2).y >(sitios[b] as Vector2).y)
	for k in idx.size():
		out[idx[k]] = {} if fichas.is_empty() else fichas[k % fichas.size()]
	return out





func _recu_por_avance(fichas: Array) -> Array:
	var out: Array = fichas.duplicate()
	out.sort_custom(func(a, b): return \
			int(POS_ADVANCE.get(String(a.get("pos", "")), 2)) \
			> int(POS_ADVANCE.get(String(b.get("pos", "")), 2)))
	return out





