func guarda_repe(gol_id: int, miniatura: Image, al_terminar: Callable) -> void:
	var clip: ReplayRec.Clip = _goal_clips.get(gol_id)
	if clip == null or _practice_kind != "" or _festejo_revivido:
		al_terminar.call("", "SIN_CLIP")
		return
	var meta: Dictionary = _goal_metas.get(gol_id, {})
	var arbol: SceneTree = get_tree()
	var tope_ms: int = Time.get_ticks_msec() + int((ReplayAudio.COLA_S + 2.0) * 1000.0)
	while Time.get_ticks_msec() < tope_ms:
		var sin_cola: bool = _rec.audio == null or not is_instance_valid(_rec.audio) \
				or not _rec.audio.cola_pendiente(clip)
		if sin_cola and not clip.mini.is_empty():
			break

		await arbol.process_frame
	ReplayAlbum.guarda_async(clip, meta, miniatura, al_terminar)










