		maxi(_serve_k - _serve_i, 1), al_arco)
	var anim: String = String(s["anim"])
	if not is_instance_valid(_self_actor) or not anim.begins_with("chilena_") \
			or not _gesto_listo(_self_actor, anim):
		return


	_serve_yo = {}
	s["pre"] = true
	s["gesto"] = true
	s["sube_n"] = maxi(i_mando - _serve_i, 1)
	s["alto"] = SERVICIO_CHILENA_SUBE
	_serve_salto = s
	_self_actor.visible = true
	_self_actor.flip_h = false


	var fps: float = _self_actor.sprite_frames.get_animation_speed(anim)
	_self_actor.speed_scale = maxf(1.0,(float(SERVICIO_CHILENA_FOTO_FRAME) + 0.4)
		/(maxf(fps, 1.0) * maxf(float(i_mando - _serve_i) * SIM_DT, SIM_DT)))
	_self_actor.play(anim)
	_serve_chilena = true
	_chilena_viva = true




	_anim_lock[_self_actor] = Time.get_ticks_msec() + int((float(maxi(_serve_k - _serve_i, 0))
		* SIM_DT / minf(SERVICIO_LENTA, _servicio_reloj_ruta()) + CHILENA_T + 0.6) * 1000.0)




func _servicio_chilena_riega() -> void:
