					pos = _tube_pushout(i2, tube_bar)


























			if (_rebound_i >= 0 or parry_atras) and _outcome != "goal" and vel.z < 0.0:
				var prev_r: Vector3 = _traj[_traj.size() - 1]
				if prev_r.z > 0.0 and pos.z <= 0.0:
					var dzr: float = prev_r.z - pos.z
					var pl_r: Vector3 = pos if dzr <= 0.0001 \
							else prev_r.lerp(pos, clampf(prev_r.z / dzr, 0.0, 1.0))
					if absf(pl_r.x) < GOAL_HALF_W and pl_r.y + BALL_R < CROSSBAR_H:
