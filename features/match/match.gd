func _muestra_resultado(you_hoy: Dictionary, rival_hoy: Dictionary, figura: Dictionary,
		is_nat: bool, rating: float, summary_data: Dictionary, fx_hoy: Dictionary = {}) -> void:
	var f: Dictionary = figura.duplicate()
