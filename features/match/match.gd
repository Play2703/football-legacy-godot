func _meta_por_asiento(pos: Array, filas: Array, fichas: Array, izq_menos_x: bool) -> Array:
	var out: Array = pos.duplicate()
	var base: int = 0
	for f in filas:
		var n: int = int(f)
		if base + n > pos.size():
			break
		var huecos: Array = range(base, base + n)
		huecos.sort_custom(func(a: int, b: int) -> bool:
			var xa: float =(pos[a] as Vector2).x
			var xb: float =(pos[b] as Vector2).x
			return xa < xb if izq_menos_x else xa > xb)
		var b0: int = base
		var orden: Array = range(n)
		orden.sort_custom(func(a: int, b: int) -> bool:
			var fa: int = _flanco(b0 + a, fichas)
			var fb: int = _flanco(b0 + b, fichas)
			return a < b if fa == fb else fa < fb)
		for j in n:
			out[base + int(orden[j])] = pos[int(huecos[j])]
		base += n
	return out







func _meta_abre_centrales(mios: Array, filas: Array, fichas: Array) -> Array:
	if filas.is_empty():
		return []
	var n_def: int = mini(int(filas[0]), mios.size())
	var cen: Array = []
	for k in n_def:
		if _flanco(k, fichas) == 0:
			cen.append(k)
	if cen.is_empty():
		return cen
	cen.sort_custom(func(a: int, b: int) -> bool:
		return (mios[a] as Vector2).x <(mios[b] as Vector2).x)



	var abre: float = randf_range(META_CENTRAL_X - 3.0, META_CENTRAL_X + 2.0)
	var alto: float = randf_range(-4.0, 1.0)
	for j in cen.size():
		var t: float = 0.5 if cen.size() <= 1 else float(j) / float(cen.size() - 1)






		var z: float =(META_CENTRAL_Z - 6.0 if is_equal_approx(t, 0.5) else META_CENTRAL_Z) + alto
		mios[int(cen[j])] = Vector2(lerpf(- abre, abre, t), z)
	return cen









func _meta_vacia_area(mios: Array, cen: Array, fichas: Array) -> void:
	var frontal: float = Stadium.FIELD_DEPTH - Stadium.PA_DEPTH
	for k in mios.size():
		var v: Vector2 = mios[k]
		if cen.has(k) or v.y <= frontal or absf(v.x) >= Stadium.PA_HALF_W:
			continue
		var lado: int = _flanco(k, fichas)
		var x: float = v.x if lado == 0 else float(lado) \
				*(Stadium.PA_HALF_W + randf_range(META_LATERAL_X.x, META_LATERAL_X.y))
		mios[k] = Vector2(x, frontal - randf_range(META_LATERAL_Z.x, META_LATERAL_Z.y))







func _meta_asienta(pts: Array, fijos: Array, ball: Vector2, dentro: Array = []) -> Array:
	var out: Array = pts.duplicate()
	var borde: float = Stadium.FIELD_DEPTH - Stadium.PA_DEPTH - PEN_OUT_PAD
	for _pasada in 3:
		for i in out.size():
			var p: Vector2 = out[i]
			p = _push_out(p, ball, META_BALL_CLEAR)
			for q in fijos:
				p = _push_out(p, q, EXTRA_SEP)
			for j in out.size():
				if j != i:
					p = _push_out(p, out[j], EXTRA_SEP)
			if not dentro.has(i) and absf(p.x) < Stadium.PA_HALF_W + PEN_OUT_PAD and p.y > borde:
				p.y = borde
			out[i] = _inside_field(p)
	return out






