const SUB_IN_INJURY_P: float = 0.5







static func _suelo_ocasiones(rasgos: Dictionary) -> int:
	return maxi(CHANCE_FIRST, int(rasgos.get("primera", 0)))















func _quiza_entras_por_lesion(line: Dictionary) -> bool:




	if _starter or _stadium == null or _sub_in_adelantado:
		return false
	if match_minute >= _play_from:
		return false
	if not _practice_kind.is_empty() or _hooked or _injured_out:
		return false


	if String(line.get("team", "")) != "you":
		return false
	var quien: String = String(line.get("name", ""))
	if quien.is_empty() or quien == Career.player_name:
		return false
	var min_les: int = int(line.get("minute", 0))


	if min_les >= MatchSim.HALF_MIN or min_les + 1 >= _play_from:
		return false
	if randf() >= SUB_IN_INJURY_P:
		return false


	await _play_injury_scene({"name": quien, "number": int(line.get("num", 0))})
	if state != State.SIM:
		return false
	var mins_antes: int = maxi(_play_to - _play_from, 1)
	var nuevo_from: int = clampi(min_les + 1, 1, MatchSim.HALF_MIN - 1)
	_play_from = nuevo_from


	_energy_billed_min = nuevo_from
	_my_minutes = maxi(_play_to - _play_from, 1)


	_sub_in_min = nuevo_from
	_sub_in_adelantado = true


	if _banca_espera:
		_banca_marca_entrada(nuevo_from)







	_chance_lo = clampi(maxi(_suelo_ocasiones(_rasgos), nuevo_from + 2), CHANCE_FIRST,
		_chance_hi)
	_base_chances = clampi(int(round(float(_base_chances)
		* float(_my_minutes) / float(mins_antes))), 1, MAX_CHANCES_PER_MATCH)
	_reschedule_chances()



	var in_lines: Array[Dictionary] = []
	_inject_sub_note(in_lines, nuevo_from - 1, nuevo_from)
	for ln in in_lines:
		_sim_screen.add_line(int(ln["minute"]), String(ln["text"]),
			String(ln["kind"]), 0, String(ln.get("team", "")),
			String(ln.get("name", "")))
	await _play_sub_scene(false)
	return state == State.SIM




func _banca_fuera() -> bool:
	return _banca_espera or _banca_quieta




func _banca_dif() -> int:
	var dif: int = team_goals - rival_goals
	if String(_banca.get("importancia", "")) == DescansoPactado.VUELTA:
		dif += _tie_carry()
	return dif









func _banca_espera_tramos() -> void:
	var imp: String = String(_banca.get("importancia", DescansoPactado.NORMAL))
	for m in DescansoPactado.puntos_de_control(imp):
		if match_minute < m - 1:
			await _run_sim_segment(m - 1, true)
			if state != State.SIM:
				return


		if not _banca_espera:
			_banca_recola()
			return
		var dif: int = _banca_dif()
		var entra: int = DescansoPactado.minuto_entrada(imp, dif)
		if entra >= 0 and entra <= m:
			_banca_entra(m)
			return
	_banca_se_queda()





func _banca_entra(m: int) -> void:
	var mins_antes: int = maxi(_play_to - _play_from, 1)
	_play_from = m
	_energy_billed_min = m
	_my_minutes = maxi(_play_to - _play_from, 1)
	_sub_in_min = m
	_chance_lo = clampi(maxi(_suelo_ocasiones(_rasgos), m + 2), CHANCE_FIRST, _chance_hi)

	_base_chances = clampi(int(round(float(_base_chances)
		* float(_my_minutes) / float(mins_antes))), 1, MAX_CHANCES_PER_MATCH)
	_banca_marca_entrada(m)
	_banca_recola()


func _banca_marca_entrada(m: int) -> void:
	_banca_espera = false
	_banca_entro_min = m
	_banca_dif_entrada = _banca_dif()







func _banca_recola() -> void:
	var idx: int = chance_index
	chance_index = 0
	_reschedule_chances()
	chance_index = idx





func _banca_se_queda() -> void:
	_banca_espera = false
	_banca_quieta = true
	_my_minutes = 0
	_chance_minutes.clear()
	_banca_nota_min = match_minute + 1






