func _at_rest(actor: AnimatedSprite3D, moving: Dictionary) -> bool:
	return is_instance_valid(actor) and not _run_target.has(actor) \
			and not (_corner_move and _corner_home.has(actor)) and not moving.has(actor) \
			and _anim_lock.get(actor, 0) <= Time.get_ticks_msec() \
			and not _linea_lo_mueve(actor)








func _linea_lo_mueve(actor: AnimatedSprite3D) -> bool:
	if not actor.has_meta("de_frente_hasta") \
			or int(actor.get_meta("de_frente_hasta")) <= Time.get_ticks_msec():
		return false
	var vt: float = float(actor.get_meta("loco_vt", -1.0))
	if vt < 0.0 or float(Time.get_ticks_msec()) / 1000.0 - vt > LINEA_PASO_FRESCO_S:
		return false
	return (actor.get_meta("loco_v", Vector2.ZERO) as Vector2).length() >= LOCO_MIN_SPD








































