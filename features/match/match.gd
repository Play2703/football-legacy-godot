	mm.billboard_mode = BaseMaterial3D.BILLBOARD_FIXED_Y
	mm.billboard_keep_scale = true
	mm.render_priority = 4
	mm.no_depth_test = true
	medal.material_override = mm



	var y0: float = TAG_CHIP_Y + 0.55 - actor.position.y
	medal.position = Vector3(0.0, y0, 0.0)
	root.add_child(medal)
	_name_tags.append({"root": root, "chip": medal, "chip_mat": mm, "phase": 0.0,
		"w": mq.size.x, "h": mq.size.y, "base_y": y0, "lift": 0.0, "steps": 0,
		"medal": medal, "medal_mat": mm, "ovr": ovr})


func _attach_name_tag(actor: AnimatedSprite3D, side: TagSide, text: String) -> void:
	if not PLACA_EN_CANCHA:
		return
	if actor == null or not is_instance_valid(actor):
		return



	if text.is_empty():
		return





	if text.contains(" "):
		text = text.split(" ", false, 1)[1]
	var origin_y: float = actor.position.y
	var root: Node3D = Node3D.new()
	root.name = "NameTag"
	root.visible = false
	actor.add_child(root)












	var col: Color = TAG_COLORS[side]
	var medal_node: MeshInstance3D = null
	var medal_mat: StandardMaterial3D = null
	var medal_ovr: int = -1



	var alto: float = 0.0



	var tex: ImageTexture = _make_name_chip_texture(text, col, TAG_LABEL_COLORS[side])
	var chip: MeshInstance3D = MeshInstance3D.new()
	var cquad: QuadMesh = QuadMesh.new()
	cquad.size = Vector2(tex.get_width() * TAG_CHIP_PXM, tex.get_height() * TAG_CHIP_PXM)
	chip.mesh = cquad
	root.position = Vector3(0.0, TAG_CHIP_Y - origin_y - cquad.size.y * 0.5, 0.0)
	chip.position = Vector3(0.0, cquad.size.y * 0.5, 0.0)
	chip.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var chip_mat: StandardMaterial3D = StandardMaterial3D.new()
	chip_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	chip_mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	chip_mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	chip_mat.albedo_texture = tex
	chip_mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	chip_mat.billboard_mode = BaseMaterial3D.BILLBOARD_FIXED_Y
	chip_mat.billboard_keep_scale = true
	chip_mat.albedo_color = Color(1.0, 1.0, 1.0, 1.0)
	chip_mat.render_priority = 4
	chip_mat.no_depth_test = true
	chip.material_override = chip_mat
	root.add_child(chip)
	alto = cquad.size.y






	if MEDALLA_EN_CANCHA and actor.has_meta("player"):
		var rp: Dictionary = actor.get_meta("player")


		var medal_tex: ImageTexture = _make_ovr_medal_texture(
			SquadMeta.ovr_of(rp, String(rp.get("pos", ""))))
		var medal: MeshInstance3D = MeshInstance3D.new()
		var mq: QuadMesh = QuadMesh.new()
		mq.size = Vector2(medal_tex.get_width(), medal_tex.get_height()) * TAG_CHIP_PXM
		medal.mesh = mq
		medal.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		var mm: StandardMaterial3D = chip_mat.duplicate()
		mm.albedo_texture = medal_tex
		mm.albedo_color = Color(1.0, 1.0, 1.0, 1.0)
		medal.material_override = mm
		medal.position = Vector3(0.0,
			(tex.get_height() * 0.5 + medal_tex.get_height() * 0.5 + 3.0) * TAG_CHIP_PXM,
			0.0)
		chip.add_child(medal)



		medal_node = medal
		medal_mat = mm
		medal_ovr = SquadMeta.ovr_of(rp, String(rp.get("pos", "")))




		alto = medal.position.y + mq.size.y * 0.5 + cquad.size.y * 0.5

	var phase: float = PI if side == TagSide.RIVAL else 0.0
	var entry: Dictionary = {
		"root": root,
		"chip": chip,
		"chip_mat": chip_mat,
		"phase": phase,


		"w": cquad.size.x,



		"h": alto,

		"base_y": cquad.size.y * 0.5,
		"lift": 0.0,




		"steps": 0,
	}
	if medal_node != null:
		entry["medal"] = medal_node
		entry["medal_mat"] = medal_mat
		entry["ovr"] = medal_ovr
	_name_tags.append(entry)















func _drop_name_tag(actor: Node) -> void:
