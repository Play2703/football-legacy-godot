func _bump(fuerza: float) -> void:
	if _fx != null:
		_fx.shake(fuerza)

var _fx_roll: float = 0.0
var _fx_facing_prev: Vector2 = Vector2(0.0, -1.0)



















func _fx_apply_roll(delta: float, facing: Vector2) -> void:
	var objetivo: float = 0.0
	if delta > 0.0 and not Settings.reduce_motion:




		var giro: float = _fx_facing_prev.cross(facing) / delta





		var lleno: float = ROLL_MAX_DEG / ROLL_PER_RAD_S
		var t: float = minf(absf(giro) / lleno, 1.0)
		objetivo = signf(giro) * ROLL_MAX_DEG * pow(t, ROLL_CURVE)
	_fx_facing_prev = facing
	_fx_roll = lerpf(_fx_roll, deg_to_rad(objetivo), 1.0 - exp(- ROLL_STIFF * delta))
	if is_zero_approx(_fx_roll):
		return



	_aim_cam.rotate_object_local(Vector3(0.0, 0.0, 1.0), _fx_roll)





const CUT_FX_MIN_SPD: float = 3.0










func _fx_quiebre(pos: Vector2, vel_antes: float) -> void:
	if vel_antes < CUT_FX_MIN_SPD:
		return
	if _fx != null:
		_fx.dust_burst(Vector3(pos.x, 0.0, pos.y))
	_haptic(12)


