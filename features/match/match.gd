const DANGER_FAR: float = 32.0
const DANGER_NEAR: float = 5.5















const OOH_FROM: float = 0.52
const OOH_TO: float = 0.3
const OOH_LOCK: float = 7.0

var _danger_peak: float = 0.0
var _ooh_lock: float = 0.0











var _shootout_side: int = 0


















const SIM_TENSION: float = 0.9



const SIM_DANGER_RATE: float = 2.0

var _sim_danger: float = 0.0
var _sim_danger_target: float = 0.0





static func danger_at(dist: float) -> float:
	var t: float = 1.0 - clampf((dist - DANGER_NEAR)
		/(DANGER_FAR - DANGER_NEAR), 0.0, 1.0)




	var v: float = smoothstep(0.0, 1.0, t)
	return v * v


func _tick_crowd_danger(delta: float) -> void:
	if not is_instance_valid(_stadium) or not is_instance_valid(_ball):
		return
	var vivo: bool = state == State.AIMING or state == State.STRIKING \
			or state == State.RUNUP or state == State.FLIGHT \
			or state == State.PASSING or state == State.DUEL
































	if _recu and (_recu_over or _recu_gol_cantado):
		vivo = false




	if _grada_gol_seq == _chance_seq:
		vivo = false





	if state != State.SIM:
		_sim_danger = 0.0
		_sim_danger_target = 0.0
	var d: float = 0.0
	if state == State.SIM:



		_sim_danger = move_toward(_sim_danger, _sim_danger_target,
			delta * SIM_DANGER_RATE)
		d = _sim_danger




		if _sim_screen != null:
			_sim_screen.set_danger(d)
	elif vivo:
		var bp: Vector3 = _ball.position
		var dist: float = Vector2(bp.x, bp.z).length()
		if _shootout_side != 0:




			d = danger_at(dist) * float(_shootout_side)
		elif not _shootout_active:




			var mia: float = Vector2(bp.x, bp.z - ENTRANCE_GOAL_Z[0]).length()
			d = danger_at(dist) if dist <= mia else - danger_at(mia)
	_stadium.crowd_danger(d)
	if _audio:
		_audio.danger(d)
	if _ooh_lock > 0.0:
		_ooh_lock -= delta




	_danger_peak = maxf(_danger_peak, absf(d))
	if absf(d) <= OOH_TO:








		if vivo and _danger_peak >= OOH_FROM and _ooh_lock <= 0.0 and _audio \
				and not _shootout_active:
			_ooh_lock = OOH_LOCK
			_audio.ooh()
		_danger_peak = 0.0






