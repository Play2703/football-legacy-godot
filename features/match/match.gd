static func _formacion_en_campo(p: Vector2, y: float) -> Vector3:
	return Vector3(clampf(p.x, - Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0), y,
		clampf(p.y, -1.0, Stadium.FIELD_DEPTH - 1.0))




static func _pasillo_marca(anchor: Vector3, inward: Vector2, k: int) -> Vector3:
	var across: Vector2 = Vector2(- inward.y, inward.x)
	var p: Vector2 = Vector2(anchor.x, anchor.z) \
			+ inward *(PASILLO_PASO_M * float(k / 2 + 1)) \
			+ across *(PASILLO_ANCHO_M *(-1.0 if k % 2 == 0 else 1.0))
	return _formacion_en_campo(p, anchor.y)


static func _pasillo_marcas(anchor: Vector3, inward: Vector2, otros: Array) -> Dictionary:
	var out: Dictionary = {}
	for k in otros.size():
		out[otros[k]] = _pasillo_marca(anchor, inward, k)
	return out



static func _pasillo_salida(anchor: Vector3, inward: Vector2, n: int) -> Vector3:
	var filas: int =(n + 1) / 2
	var p: Vector2 = Vector2(anchor.x, anchor.z) + inward *(PASILLO_PASO_M * float(filas + 1))
	return _formacion_en_campo(p, anchor.y)




