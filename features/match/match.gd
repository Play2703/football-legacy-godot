		"marcador": [team_goals, rival_goals],
		"local": _home_match,
		"ajeno": clip.ajeno,
		"viento": [_wind.x, _wind.y, _wind.z],
	}






	var fx: Dictionary = GameState.current_fixture()
	var comp: String = String(fx.get("comp", ""))
	meta["club"] = _my_side_id()
	meta["comp"] = comp
	meta["jornada"] = int(fx.get("round_idx", -1)) + 1 if comp == "league" \
			and int(fx.get("round_idx", -1)) >= 0 else 0
	if _stadium != null and is_instance_valid(_stadium):
		meta["clima"] = _stadium.weather_id()
		meta["lluvia"] = _stadium.rain_level()
