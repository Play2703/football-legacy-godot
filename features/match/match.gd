func _recorta_cancha_mia(chance: Dictionary, n_fichas: int) -> void:
	var xm: Array =(chance.get("extras_mates", []) as Array).duplicate()
	var sobran: int = mini((chance.get("teammates", []) as Array).size() + xm.size()
		- n_fichas, xm.size())
	for _k in sobran:
		var atras: int = 0
		for i in xm.size():
			if (xm[i] as Vector2).y >(xm[atras] as Vector2).y:
				atras = i
		xm.remove_at(atras)
	if sobran > 0:
		chance["extras_mates"] = xm












func _recorta_cancha_rival(chance: Dictionary, n_fichas: int) -> void:
	var xr: Array =(chance.get("extras_rivals", []) as Array).duplicate()
	var sobran: int = mini((chance.get("defenders", []) as Array).size() + xr.size()
		- n_fichas, xr.size())
	for _k in sobran:
		var arriba: int = 0
		for i in xr.size():
			if (xr[i] as Vector2).y >(xr[arriba] as Vector2).y:
				arriba = i
		xr.remove_at(arriba)
	if sobran > 0:
		chance["extras_rivals"] = xr














