func _chin_burbuja(actor: AnimatedSprite3D, mano: int) -> void:
	var piel: Variant =(actor.get_meta("look", {}) as Dictionary).get("skin",
		KitRecolor.REF_SKIN)
	var b: Sprite3D = Sprite3D.new()
	b.name = "ChinBurbuja"
	b.texture = _chin_burbuja_tex(mano, piel if piel is Color else KitRecolor.REF_SKIN)
	b.pixel_size = CHIN_BURBUJA_PX
	b.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	b.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	b.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	b.no_depth_test = true
	b.render_priority = 3
	b.position = Vector3(0.0, CHIN_BURBUJA_Y - actor.position.y, 0.0)
	b.scale = Vector3.ONE * 0.2
	actor.add_child(b)
	_celeb_props.append(b)
	var tw: Tween = b.create_tween()
	tw.tween_property(b, "scale", Vector3.ONE, 0.2) \
			.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_interval(CHIN_BURBUJA_S)
	tw.tween_property(b, "scale", Vector3.ONE * 0.01, 0.15) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(b.queue_free)




func _chin_burbuja_tex(mano: int, piel: Color) -> Texture2D:
	const LADO: int = 30
	var img: Image = Image.create(LADO, LADO, false, Image.FORMAT_RGBA8)
	var c: float =(LADO - 1) * 0.5
	for y in LADO:
		for x in LADO:
			var d: float = Vector2(x - c, y - c).length()
			if d <= c - 1.0:
				img.set_pixel(x, y, CareerTheme.INK_LIGHT)
			elif d <= c:
				img.set_pixel(x, y, CareerTheme.INK_DARK)
	var tex: Texture2D = load(BancaJuego.MANOS_PNG[clampi(mano, 0, 2)]) as Texture2D
	var m: Image = tex.get_image() if tex != null else null
	if m == null:
		return ImageTexture.create_from_image(img)
	if m.is_compressed():
		m.decompress()
	m.convert(Image.FORMAT_RGBA8)
	var o: Vector2i = Vector2i((LADO - m.get_width()) / 2,(LADO - m.get_height()) / 2)
	for y in m.get_height():
		for x in m.get_width():
			var px: Color = m.get_pixel(x, y)
			if px.a > 0.5:
				img.set_pixel(o.x + x, o.y + y,
					Color(px.r * piel.r, px.g * piel.g, px.b * piel.b, 1.0))
	return ImageTexture.create_from_image(img)




