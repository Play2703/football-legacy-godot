func _palabra_tiro() -> String:
	if _meta_saca():
		return RING_LABEL_TEXT_DESPEJE
	if _golpe_de_cabeza():


		return RING_LABEL_TEXT_GESTO["cabeza"]
	if _servicio_por_rematar():

		var gesto: String = "chilena" if _serve_chilena else _servicio_gesto(_serve_plan)
		return String(RING_LABEL_TEXT_GESTO.get(gesto, RING_LABEL_TEXT_TIRO))
	return RING_LABEL_TEXT_TIRO
















