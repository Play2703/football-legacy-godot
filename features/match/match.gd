func _generate_chance() -> Dictionary:





	if not _practice_kind.is_empty():
		_last_chance_name = _practice_kind
		return _practice_chance(_practice_kind)



	_tac_zaga_hoy()


	var lado_c: float = _desv_corner_pend
	_desv_corner_pend = 0.0




















	if _press_chances.has(chance_index):
		_last_chance_name = Practice.PRESS_OUT





		var forma: int = int(_saque_huecos.get(chance_index, SAQUE_HUECO_NO))
		if forma == SAQUE_HUECO_LARGO:
			_last_chance_name = Practice.SAQUE_LARGO
			_servicio_played += 1
			_saque_played += 1
			var sl: Dictionary = _servicio_chance("", true, true)
			_remember_lado(sl)
			return sl
		_press_played += 1
		if forma == SAQUE_HUECO_CORTO:
			var sc: Dictionary = _saque_chance()
			_last_chance_name = SAQUE_KIND
			_saque_played += 1
			_remember_lado(sc)
			return sc






		if Practice.salida_jugada_on:
			var salida: Dictionary = _salida_chance()
			_last_chance_name = SALIDA_KIND
			_remember_lado(salida)
			return salida
		var press: Dictionary = _press_out_chance()
		_remember_lado(press)
		return press






	if _recu_chances.has(chance_index):
		_last_chance_name = Practice.RECUPERA
		_recu_played += 1
		var rc: Dictionary = _recu_chance()
		_remember_lado(rc)
		return rc




	if _meta_chances.has(chance_index):
		_last_chance_name = META_KIND
		_meta_played += 1
		var mc: Dictionary = _meta_chance()
		_remember_lado(mc)
		return mc









	if _servicio_chances.has(chance_index):
		var escenario: String = _servicio_escenario(chance_index)
		_last_chance_name = String(SERVICIO_KIND_DE.get(escenario, Practice.SERVICIO))
		_servicio_played += 1
		var sc: Dictionary = _servicio_chance(escenario, true)
		_remember_lado(sc)
		return sc








	if lado_c != 0.0 and chance_index >= 1 and chance_index <= _chance_minutes.size() \
			and _desv_corner_vale(_desv_corner_min, int(_chance_minutes[chance_index - 1])):
		var cc: Dictionary = _chance_from_origin(_draw_set_piece(lado_c, SP_CORNER_ROLL))
		_last_chance_name = String(cc.get("kind", "corner"))
		_remember_lado(cc)
		return cc




	if _pre_largo_toca(chance_index):
		_pre_largo_hecho = true
		_pre_gasta()
		_last_chance_name = Practice.RECEPCION
		var rl: Dictionary = _recepcion_chance()
		_remember_lado(rl)
		return rl











	if _meta_cabe(chance_index) and randi() % 100 < META_P_PARADO:
		_last_chance_name = META_KIND
		_meta_played += 1
		_meta_chances.append(chance_index)
		var mp: Dictionary = _meta_chance()
		_remember_lado(mp)
		return mp






	if _contra_toca(chance_index):
		var volcado: bool = _rival_volcado()
		_last_chance_name = CONTRA_KIND
		_contra_played += 1
		_contra_chances.append(chance_index)
		var ct: Dictionary = _contragolpe_chance(volcado,
			_contra_rng(chance_index, "sitio"))
		_remember_lado(ct)
		return ct
	if _superioridad_toca(chance_index):
		_super_played += 1
		_super_chances.append(chance_index)
		var sp: Dictionary = _hombre_de_mas_chance(_contra_rng(chance_index, "sup_sitio"))

		_last_chance_name = String(sp.get("kind", ""))
		_remember_lado(sp)
		return sp



	_force_wing = _wing_drought >= _wing_patience
	var chance: Dictionary = _roll_chance()
	var tries: int = 0

































	var tope: int = 6 +(FOTO_TRIES_BANDA - FOTO_TRIES
			if foto_repite_p > 0.0 and _banda_propia() != 0 else 0)
	var foto_vista: bool = false
	while tries < tope:
		if String(chance.get("kind", "")) != _last_chance_name:
			if _skips_dead_ball(chance):
				var ps: Dictionary = _parado_servido(chance)
				if not ps.is_empty():
					_force_wing = false
					return ps
				if _pedido_generado(chance) and not _skips_by_pos(chance) \
						and not _repeats_lado(chance):
					chance["pedido"] = true
					break
			elif not _skips_by_pos(chance) and not _repeats_lado(chance):
				if not _repite_foto(chance, tries):
					break
				foto_vista = true
		chance = _roll_abierto() if foto_vista else _roll_chance()
		tries += 1
	_last_chance_name = String(chance.get("kind", ""))



	if _last_chance_name == SAQUE_KIND:
		_press_played += 1
		_saque_played += 1
	_remember_lado(chance)
	_force_wing = false
	return chance

















