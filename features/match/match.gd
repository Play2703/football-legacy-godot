func _meta_portero_frame(delta: float) -> void:
	if not _meta_viva or _meta_por != null or _meta_corte:
		return
	if not is_instance_valid(_recu_por) or _recu_por == _keeper:
		return
	var por: AnimatedSprite3D = _recu_por
	var p: Vector2 = Vector2(por.position.x, por.position.z)



	var meta: Vector2 = Vector2(
		clampf(_ball_field.x * META_POR_SIGUE, - GOAL_HALF_W, GOAL_HALF_W),
		OWN_GOAL_Z - KEEPER_HOME_Z)
	var d: Vector2 = meta - p
	if d.length() <= META_POR_LLEGO:
		if por.animation != _por_idle_anim(por):
			por.play(_por_idle_anim(por))
		return

	var vel: float = KEEPER_OUT_SPD_MIN if d.length() > META_POR_TROTE else 1.6
	var paso: Vector2 = d.normalized() * minf(vel * delta, d.length())
	por.position.x = p.x + paso.x
	por.position.z = p.y + paso.y
	_play_dir_gesture(por, "run" if vel > 2.0 else "walk", d.normalized(), 120)



