func _corner_profile_dir() -> String:

	var to_box: Vector2 = - _ball_field
	if to_box.length_squared() < 0.0001:
		to_box = Vector2(0.0, 1.0)
	var right: Vector2 = Vector2(1.0, 0.0)
	if is_instance_valid(_aim_cam):
		var b: Basis = _aim_cam.global_transform.basis
		var r: Vector2 = Vector2(b.x.x, b.x.z)
		if r.length_squared() > 0.0001:
			right = r.normalized()
	return "east" if to_box.dot(right) > 0.0 else "west"


func _corner_profile_anim() -> String:
	return "idle_" + _corner_profile_dir()



























const CORNER_CAM_MAX_X: float = 52.0
const CORNER_CAM_MIN_Z: float = -3.0
















const CORNER_AIM_STEPS: int = 12








const CORNER_AIM_MAX: float = 0.12














const CORNER_PAN_Z: float = 9.0
















const CORNER_CAM_MAX_Z: float = Stadium.PA_DEPTH




















func _uses_corner_camera() -> bool:
	if _chance_kind == "corner":
		return true
	return _cross_setpiece and _chance_kind == "libre" \
			and _ball_field.y <= CORNER_CAM_MAX_Z


func _fit_corner_camera(bp: Vector3, _dir0: Vector3) -> void:
	_aim_cam.fov = CORNER_FOV
	var s: float = signf(bp.x) if not is_zero_approx(bp.x) else 1.0
	var look: Vector3 = Vector3(- s * CORNER_LOOK_X, CORNER_LOOK_Y, CORNER_LOOK_Z)









	var axis: Vector3 =(bp - Vector3(look.x, bp.y, look.z))
	axis.y = 0.0
	axis = axis.normalized() if axis.length() > 0.001 else Vector3(s, 0.0, -1.0).normalized()
	var cam_pos: Vector3 = bp + axis * CORNER_BACK
	cam_pos.y = CORNER_CAM_H










	cam_pos = bp +(cam_pos - bp) * Settings.cam_zoom_mul() * OPEN_PLAY_ZOOM_15


	look.z +=(_aim_yaw / deg_to_rad(CAM_YAW_MAX)) * CORNER_PAN_Z


	cam_pos.x = clampf(cam_pos.x, - CORNER_CAM_MAX_X, CORNER_CAM_MAX_X)
	cam_pos.z = maxf(cam_pos.z, CORNER_CAM_MIN_Z)
	_aim_cam.position = cam_pos
	_aim_cam.look_at(look)


	if not is_instance_valid(_self_actor):
		return
	var feet: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
	var must: Array = [bp + Vector3.UP * BALL_VISUAL_D, feet,
		feet + Vector3.UP * PLAYER_HEIGHT_M]
	var chest: Vector3 = feet + Vector3.UP *(PLAYER_HEIGHT_M * 0.5)
	var lo: float = 0.0
	var hi: float = -1.0
	for i in CORNER_AIM_STEPS + 1:
		var k: float = float(i) / float(CORNER_AIM_STEPS) * CORNER_AIM_MAX
		_aim_cam.look_at(look.lerp(chest, k))
		if _points_in_frame(must, 0.06, 0.94, 0.09, 0.93):
			hi = k
			break
		lo = k
	if hi < 0.0:


		hi = CORNER_AIM_MAX
	for _j in 6:
		var mid: float =(lo + hi) * 0.5
		_aim_cam.look_at(look.lerp(chest, mid))
		if _points_in_frame(must, 0.06, 0.94, 0.09, 0.93):
			hi = mid
		else:
			lo = mid
	_aim_cam.look_at(look.lerp(chest, hi))






























func _fit_aim_camera(bp: Vector3, dir0: Vector3, h0: float, back0: float,
		bottom: float = 0.85, piso: Vector2 = Vector2.ZERO,
		vista_pref: bool = true, como_abierto: bool = false) -> void:


	var must: Array = [bp + Vector3.UP * BALL_VISUAL_D]
	if is_instance_valid(_self_actor):
		var feet: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
		must.append(feet)
		must.append(feet + Vector3.UP * PLAYER_HEIGHT_M)















	if _pass_view_on() and is_instance_valid(_self_actor):
		var yo: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
		must = [yo, yo + Vector3.UP * PLAYER_HEIGHT_M]







	if como_abierto:
		must = [bp, bp + Vector3.UP * PLAYER_HEIGHT_M]



























	if _chance_kind == "penal" and not _shootout_active \
			and not _pass_view_on() and not como_abierto:
		var head: Vector3 = Vector3.UP * PLAYER_HEIGHT_M
		must.append(Vector3(0.0, 0.0, bp.z + PEN_ARC_R + PEN_GAP.y) + head)
		must.append(Vector3(- PEN_FIT_HALF_W, 0.0, Stadium.PA_DEPTH) + head)
		must.append(Vector3(PEN_FIT_HALF_W, 0.0, Stadium.PA_DEPTH) + head)















	var want: Array = []





	if _pass_view_on():








		var yo_a: Vector3 = bp
		if is_instance_valid(_self_actor):
			yo_a = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
		want = [yo_a + dir0 * OPEN_FRAME_FWD + Vector3(0.0, PLAYER_HEIGHT_M, 0.0)]
	elif not como_abierto and (_chance_kind == "penal" or _chance_kind == "libre" \
			or _chance_kind == "corner" or _cross_setpiece):
		want = [
			Vector3(- GOAL_HALF_W, 0.0, 0.0), Vector3(GOAL_HALF_W, 0.0, 0.0),
			Vector3(0.0, CROSSBAR_H, 0.0)]
	else:



		want = [bp + dir0 * OPEN_FRAME_FWD + Vector3(0.0, PLAYER_HEIGHT_M, 0.0)]























	if _switch_active and is_instance_valid(_switch_target):
		var mate_feet: Vector3 = Vector3(
			_switch_target.position.x, 0.0, _switch_target.position.z)
		must.append(mate_feet)
		must.append(mate_feet + Vector3.UP * PLAYER_HEIGHT_M)
		want = []




























	var abierto: bool =(want.size() == 1 and not _switch_active) or _pass_view_on()
	var center: Vector3 = Vector3.ZERO
	if abierto:
		center = _aim_self_center(bp)
	else:
		for p in must + want:
			center += p
		center /= float((must + want).size())



	var back: float = back0
	var h: float = h0









	var step_back: float = 1.8
	var step_h: float = 1.0
	var extra_lo: float = 0.0
	var extra_hi: float = -1.0
	for i in 26:
		var extra: float = float(i)
		_aim_cam.position = bp - dir0 *(back0 + step_back * extra) \
				+ Vector3(0.0, h0 + step_h * extra, 0.0)
		_aim_cam.look_at(center)
		var ok: bool = _points_in_frame(must, 0.09, 0.91, 0.12, bottom)


		if ok and step_back * extra < 22.0:
			ok = _points_in_frame(want, 0.04, 0.96, 0.05, 0.92)
		if ok:
			extra_hi = extra
			break
		extra_lo = extra
	if extra_hi < 0.0:
		extra_hi = 25.0


	for _j in 6:
		var mid: float =(extra_lo + extra_hi) * 0.5
		_aim_cam.position = bp - dir0 *(back0 + step_back * mid) \
				+ Vector3(0.0, h0 + step_h * mid, 0.0)
		_aim_cam.look_at(center)
		var ok2: bool = _points_in_frame(must, 0.09, 0.91, 0.12, bottom)
		if ok2 and step_back * mid < 22.0:
			ok2 = _points_in_frame(want, 0.04, 0.96, 0.05, 0.92)
		if ok2:
			extra_hi = mid
		else:
			extra_lo = mid
	back = back0 + step_back * extra_hi
	h = h0 + step_h * extra_hi
































	if como_abierto or (_pass_view_on() and _chance_kind != "corner") \
			or (_chance_kind != "penal" and _chance_kind != "corner"):
		var zoom_out: float = EXTRA_ZOOM_OUT_50
		if abierto:
			zoom_out *= OPEN_ZOOM_OUT
		back *= zoom_out
		h *= zoom_out






	back *= OPEN_PLAY_ZOOM_15
	h *= OPEN_PLAY_ZOOM_15


	if _meta_viva:
		back *= META_CAM_ZOOM
		h *= META_CAM_ZOOM



	if _zonas_h_on():
		back *= _cam_tumbada
		h *= _cam_tumbada









	back = maxf(back, piso.x)
	h = maxf(h, piso.y)






	if _pass_view_on():
		var modulo: float = sqrt(back * back + h * h)
		var ang: float = lerpf(atan2(h, maxf(back, 0.001)),
			deg_to_rad(BANDA_PITCH_DEG), _banda_cerca())
		if ang > atan2(h, maxf(back, 0.001)):
			back = modulo * cos(ang)
			h = modulo * sin(ang)























	if abierto and vista_pref and Settings.cam_vista == Settings.VISTA_CAMPO:
		var actual: float = atan2(h, maxf(back, 0.001))
		var meta: float = minf(deg_to_rad(VISTA_CAMPO_PITCH_DEG), actual)



		var modulo_v: float = sqrt(back * back + h * h) * VISTA_CAMPO_ZOOM
		back = modulo_v * cos(meta)
		h = modulo_v * sin(meta)
	_fit_back = back
	_fit_h = h
	_aim_cam.position = bp - dir0 * back + Vector3(0.0, h, 0.0)













	if abierto and is_zero_approx(_aim_yaw) and not _pass_view_on():
		_orbit_goal_in(bp, center, must, bottom)

	var orbita: float = _aim_yaw
	if not is_zero_approx(orbita):
		_aim_cam.position = bp +(_aim_cam.position - bp).rotated(Vector3.UP, orbita)






	var pedido: Vector3 = _aim_cam.position - bp
	var metido: Vector3 = _bowl_off(bp, pedido)
	if metido != pedido:
		orbita += - Vector2(pedido.x, pedido.z).angle_to(Vector2(metido.x, metido.z))
		_aim_cam.position = bp + metido
	if is_zero_approx(orbita):
		_look_frame(center, abierto)
	else:
		_look_frame(bp +(center - bp).rotated(Vector3.UP, orbita), abierto)

























func _orbit_goal_in(bp: Vector3, center: Vector3, must: Array, bottom: float) -> void:
	var boca: Array = [
		Vector3(- GOAL_HALF_W, 0.0, 0.0), Vector3(GOAL_HALF_W, 0.0, 0.0),
		Vector3(0.0, CROSSBAR_H, 0.0)]
	var off0: Vector3 = _aim_cam.position - bp




	var hacia: Vector2 = Vector2(bp.x, bp.z)
	if hacia.length_squared() < 0.0001:
		return











	var mejor_off: Vector3 = off0
	var mejor_d: float = _goal_off_center(bp, off0, center, boca)
	var ang: float = GOAL_ORBIT_STEP
	while ang <= GOAL_ORBIT_MAX:
		for lado: float in [1.0, -1.0]:
			var cand: Vector3 = off0.rotated(Vector3.UP, deg_to_rad(ang) * lado)
			if not _points_in_frame_at(bp, cand, center, must,
					0.09, 0.91, 0.12, bottom, false):
				continue
			var d: float = _goal_off_center(bp, cand, center, boca)
			if d < mejor_d:
				mejor_d = d
				mejor_off = cand
		ang += GOAL_ORBIT_STEP
	_aim_cam.position = bp + mejor_off




func _goal_frame_ok(bp: Vector3, off: Vector3, center: Vector3, boca: Array,
		must: Array, bottom: float) -> bool:
	if not _points_in_frame_at(bp, off, center, boca, 0.06, 0.94, 0.05, 0.92, true):
		return false





	return _points_in_frame_at(bp, off, center, must, 0.09, 0.91, 0.12, bottom, false)




func _goal_off_center(bp: Vector3, off: Vector3, center: Vector3,
		boca: Array) -> float:
	_place_probe(bp, off, center, true)
	var boca_c: Vector3 = boca[2] if boca.size() > 2 else Vector3.ZERO
	if _aim_cam.is_position_behind(boca_c):
		return 9.0
	var w: float = SceneFade.rect_visible(self).size.x
	if w <= 0.0:
		return 9.0
	return absf(_aim_cam.unproject_position(boca_c).x / w - 0.5)



func _points_in_frame_at(bp: Vector3, off: Vector3, center: Vector3, pts: Array,
		x0: float, x1: float, y0: float, y1: float, bajado: bool) -> bool:
	_place_probe(bp, off, center, bajado)
	return _points_in_frame(pts, x0, x1, y0, y1)




func _place_probe(bp: Vector3, off: Vector3, center: Vector3,
		bajado: bool) -> void:
	_aim_cam.position = bp + _bowl_off(bp, off)
	_look_frame(center, bajado)






func _aim_self_center(bp: Vector3) -> Vector3:
	if is_instance_valid(_self_actor):
		return Vector3(_self_actor.position.x, PLAYER_HEIGHT_M * 0.5,
			_self_actor.position.z)
	return bp + Vector3.UP * BALL_VISUAL_D
























func _open_self_y() -> float:
	var centro: float = OPEN_SELF_Y_H if _lienzo_h else OPEN_SELF_Y
	if not _pass_view_on():
		return centro
	return lerpf(centro, BANDA_SELF_Y_H if _lienzo_h else BANDA_SELF_Y, _banda_cerca())












func _banda_cerca() -> float:










	var me_x: float = _ball_field.x
	var lado: float = 0.0
	if _aim_cam != null:
		lado = signf((- _aim_cam.global_transform.basis.z).x)
	if is_zero_approx(lado):
		lado = float(_pass_view_side())


	var hacia_cam: float = clampf(- me_x * lado, - Stadium.FIELD_HALF_W, Stadium.FIELD_HALF_W)




	return clampf(hacia_cam / Stadium.FIELD_HALF_W, 0.0, 1.0)


func _lift_aim(me: Vector3) -> Vector3:
	var to_me: Vector3 = me - _aim_cam.global_position
	if to_me.length_squared() < 0.0001:
		return me
	var lat: Vector3 = to_me.cross(Vector3.UP)
	if lat.length_squared() < 1e-06:
		return me
	var theta: float = atan(2.0 *(_open_self_y() - 0.5)
		* tan(deg_to_rad(_aim_cam.fov) * 0.5))

	if _lienzo_h:
		theta += _travesano_h_alza(to_me, lat.normalized(), theta)
	return _aim_cam.global_position + to_me.rotated(lat.normalized(), theta)












func _travesano_h_alza(to_me: Vector3, lat: Vector3, theta: float) -> float:
	var d: Vector3 = to_me.rotated(lat, theta).normalized()
	if absf(d.y) > 0.999:
		return 0.0
	var base: Basis = Basis.looking_at(d, Vector3.UP)
	var tan_v: float = tan(deg_to_rad(_aim_cam.fov) * 0.5)
	var vis: Vector2 = SceneFade.rect_visible(self).size
	if vis.y <= 0.0:
		return 0.0
	var tan_h: float = tan_v * vis.x / vis.y
	var a_max: float = - INF
	for sx in [-1.0, 1.0]:
		var p: Vector3 = base.transposed() \
				*(Vector3(sx * GOAL_HALF_W, CROSSBAR_H, 0.0) - _aim_cam.global_position)
		if p.z > -0.5 or absf(p.x / - p.z) > tan_h:
			continue
		a_max = maxf(a_max, atan2(p.y, - p.z))
	if a_max == - INF:
		return 0.0
	var a_meta: float = atan(2.0 *(0.5 - TRAVESANO_H_MIN) * tan_v)
	if a_max <= a_meta:
		return 0.0
	var tope: float = atan(2.0 *(TRAVESANO_H_SELF_MAX - 0.5) * tan_v)
	return clampf(a_max - a_meta, 0.0, maxf(tope - theta, 0.0))





func _look_frame(center: Vector3, abierto: bool) -> void:
	_aim_cam.look_at(_lift_aim(center) if abierto else center)





func _points_in_frame(pts: Array, x0: float, x1: float, y0: float, y1: float) -> bool:
	var size: Vector2 = SceneFade.rect_visible(self).size
	if size.x <= 0.0 or size.y <= 0.0:
		return true
	var lo: Vector2 = Vector2(size.x * x0, size.y * y0)
	var hi: Vector2 = Vector2(size.x * x1, size.y * y1)
	for p in pts:
		if _aim_cam.is_position_behind(p):
			return false
		var s: Vector2 = _aim_cam.unproject_position(p)
		if s.x < lo.x or s.x > hi.x or s.y < lo.y or s.y > hi.y:
			return false
	return true
























