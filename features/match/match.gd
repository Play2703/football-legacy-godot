func _tutorial_demo_siguiente() -> void:
	if _tutorial_demo_cola.is_empty() or _hud == null or not _tutorial_active \
			or not is_inside_tree():
		return







	if _practice_kind != _tutorial_demo_kind:
		_tutorial_demo_cola.clear()
		return











	if _ring_finger != -1 or _aim_finger != -1 or _duel_finger != -1 \
			or _drive_finger != -1 or _stick_finger != -1 or _stick_der_finger != -1 \
			or state != _tutorial_demo_estado:
		SceneFade.timer(0.2).timeout.connect(_tutorial_demo_siguiente)
		return
	var ficha: Dictionary = _tutorial_demo_cola.pop_front()
	var aim: Array = _tutorial_demo_aim()
	if aim.is_empty():
		return
	var pasos: Array = ficha.get("pasos", [])
	var text: String = String(pasos[0]) if not pasos.is_empty() \
			else Tutorial.demo(_tutorial_i)
	var modo: String = String(ficha.get("modo", "resortera"))











	var stick = null
	var izq: bool = false
	if _zonas_h_on() and ficha.has("stick"):
		izq = String(ficha["stick"]) == "izq"
		if (izq and not _stick_izq_vivo()) or (not izq and not _puntero_tirar_cabe()):
			_tutorial_demo_siguiente()
			return
		if modo == "centro" and not _modo_on():
			modo = "resortera"
			pasos = [text]
		if izq:
			_stick_izq_crea()
		else:
			_stick_der_crea()
		stick = _stick_ui if izq else _stick_der_ui







	if stick != null and Entrada.pad_juega():
		pasos = _tutorial_pasos_listos(pasos)


	var demo: Control = GESTURE_DEMO.new()
	_hud.add_child(demo)
	if stick != null:


		demo.call("en_stick", _stick_recorrido(), float(stick.base_r()), izq)
	demo.call("set_gesto", modo, pasos,
		_modo_centro if stick != null else _tutorial_demo_vacio)


	demo.connect("fase", _tutorial_demo_fase)




	demo.tree_exited.connect(_tutorial_demo_siguiente)







	var vueltas: int = 1 if pasos.size() > 2 else 2
	if stick != null:
		demo.play(stick.esquina(), aim[1], text, vueltas, _tutorial_demo_aim_stick.bind(izq))
	else:
		demo.play(aim[0], aim[1], text, vueltas, _tutorial_demo_aim)








