func _pecho_follow() -> void:
	if _pecho.is_empty():
		return
	var cam: Camera3D = SceneFade.camara_de(self)
	for a in sin_muertos(_pecho):



		if not is_instance_valid(a):
			continue
		var duenio: AnimatedSprite3D = a as AnimatedSprite3D
		var fila: Dictionary = _pecho[a]
		if duenio == null:
			continue








		var base: String = PechoRig.base_de(duenio)
		var r: Dictionary = Pecho.rects_base(base) if not base.is_empty() \
				else Pecho.rects(duenio.animation, duenio.frame)
		var esc: Sprite3D = SceneFade.vivo(fila.get("esc")) as Sprite3D
		if is_instance_valid(esc):
			Pecho.seguir(esc, duenio, r.get("esc", Rect2()), duenio.pixel_size, cam)


		var par: Sprite3D = SceneFade.vivo(fila.get("par")) as Sprite3D
		if is_instance_valid(par):
			Pecho.seguir(par, duenio, KitRecolor.parche_rect(base, par.texture),
				duenio.pixel_size, cam)
		var pat: Sprite3D = SceneFade.vivo(fila.get("pat")) as Sprite3D
		if is_instance_valid(pat):
			Pecho.seguir(pat, duenio, r.get("pat", Rect2()), duenio.pixel_size, cam,
				Pecho.PAT_CRECE)
		var fab: Sprite3D = SceneFade.vivo(fila.get("fab")) as Sprite3D
		if is_instance_valid(fab):
