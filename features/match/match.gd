		right.y = 0.0
		right = right.normalized()



		var enter_d: float = _strike_reach() * 0.92


		var vel_k: float = _strike_vel_k()





		if _lienzo_h and GOLPEO_ENTRADA_RETRATO_H:
			enter_d = _strike_reach_juego() * 0.92
			vel_k = 1.0
		_strike_span = enter_d * 2.0
		_strike_travel = 0.0
		var speed: float = float(_strike_motion.get("speed", 0.5)) * vel_k


		if bool(_strike_motion.get("airborne", false)):




			var y_abs: float = clampf(float(_strike_motion.get("entry_h", contact_y)),
				ball_center.y - _strike_vreach(), ball_center.y + _strike_vreach())
			_ball.position = Vector3(ball_center.x, y_abs, ball_center.z) \
					+ right *(side * enter_d)
		else:
			var entry_h: float = clampf(float(_strike_motion.get("entry_h", 0.0)),
				0.0, _strike_vreach())
			_ball.position = ball_center + right *(side * enter_d) \
					+ Vector3(0.0, entry_h, 0.0)
		_strike_vel = - right * side * speed
		_strike_vel.y = float(_strike_motion.get("vy0", 0.0))








		_ball_roll(Vector2(_strike_vel.x, _strike_vel.z), STRIKE_ROLL_SLOW)




		if _strike_motion.has("slowmo"):
			_fx.slowmo(float(_strike_motion["slowmo"]))



	_cabezazo_baja()





















const STRIKE_IDLE_REV_S: float = 0.22


func _strike_idle_spin() -> void:
	if not is_instance_valid(_ball) or _ball.sprite_frames == null:
		return









	var eje: Array = _roll_axis(_strike_spin_dir(), _shot_cam)
	var anim: String = String(eje[0])
	var sentido: float = float(eje[1])
	if not _ball.sprite_frames.has_animation(anim):
		return
	_ball.flip_h = false
	if String(_ball.animation) != anim:
		_ball.play(anim)
	var n: float = float(_ball.sprite_frames.get_frame_count(anim))
	var fps: float = _ball.sprite_frames.get_animation_speed(anim)
	if n <= 0.0 or fps <= 0.0:
		return
	_ball.speed_scale = STRIKE_IDLE_REV_S *(n / fps) * sentido








const STRIKE_WAKE_PERIOD: float = 0.09




const STRIKE_WAKE_SCALE: float = 0.32




const STRIKE_MUD_TINT: Color = Color(0.46, 0.31, 0.18, 1.0)
const STRIKE_MUD_SCALE: float = 0.8



const STRIKE_WAKE_POWER: float = 3.2

var _strike_wake_cd: float = 0.0


func _strike_wake(delta: float) -> void:
	if _fx == null or _stadium == null or not is_instance_valid(_ball):
		return
	var lluvia: bool = bool(_stadium.weather.get("rain", false))
	var nieve: bool = bool(_stadium.weather.get("snow", false))
	if not lluvia and not nieve:
		return







	var k: float = clampf(_world_k(), 0.05, 1.0)
	_strike_wake_cd -= delta * k
	if _strike_wake_cd > 0.0:
		return
	_strike_wake_cd = STRIKE_WAKE_PERIOD




	var rumbo: Vector2 = _strike_spin_dir()






	var borde: Vector2 = rumbo *(BALL_VISUAL_D * 0.45)
	var suelo: Vector3 = Vector3(_ball.position.x + borde.x, 0.03,
		_ball.position.z + borde.y)
	if _ball.position.y > BALL_VISUAL_D * 0.9:
		return
	_fx.splash_dir(Vector3(rumbo.x, 0.0, rumbo.y))
	if nieve:




		_fx.step_splash(suelo, Vector3(- rumbo.x, 0.0, - rumbo.y),
			clampf(STRIKE_WAKE_POWER / 7.0, 0.0, 1.0), true, STRIKE_WAKE_SCALE,
			Color(1.0, 1.0, 1.0, 1.0), k)
		return











	_fx.splash_burst(suelo, STRIKE_WAKE_POWER, STRIKE_WAKE_SCALE, k)
	var cola: Vector3 = Vector3(_ball.position.x - borde.x, 0.03,
		_ball.position.z - borde.y)
	_fx.step_splash(cola, Vector3(rumbo.x, 0.0, rumbo.y),
		clampf(STRIKE_WAKE_POWER / 7.0, 0.0, 1.0), false,
		STRIKE_WAKE_SCALE * STRIKE_MUD_SCALE, STRIKE_MUD_TINT, k)





func _strike_spin_dir() -> Vector2:
	if not _strike_motion.is_empty():
		var v: Vector2 = Vector2(_strike_vel.x, _strike_vel.z)
		if v.length_squared() > 0.0001:
			return v.normalized()
	var rumbo: Vector2 = _drive_facing
	if rumbo.length_squared() < 0.0001:
		rumbo = _aim_dir
	if rumbo.length_squared() < 0.0001:
		rumbo = Vector2(0.0, -1.0)
	return rumbo.normalized()








func _strike_reach() -> float:
	var dist: float = _shot_cam.global_position.distance_to(_strike_focus())
	var vp: Vector2 = SceneFade.rect_visible(self).size
	var aspect: float = vp.x / maxf(vp.y, 1.0)
	var half_w: float = tan(deg_to_rad(_shot_cam.fov * 0.5)) * aspect * dist
	return half_w + BALL_VISUAL_D * 0.5 * 1.25











func _strike_fov() -> float:
	if not _lienzo_h or not STRIKE_FOV_TUMBADO_D4:
		return STRIKE_FOV
	var alto: float = SceneFade.rect_visible(self).size.y
	var t: float = tan(deg_to_rad(STRIKE_FOV * 0.5)) * alto / float(Lienzo.RETRATO.y)
	return rad_to_deg(2.0 * atan(t))







func _strike_reach_juego() -> float:
	var dist: float = _shot_cam.global_position.distance_to(_strike_focus())
	var half_w: float = tan(deg_to_rad(STRIKE_FOV * 0.5)) * AIM_ASPECT * dist
	return half_w + BALL_VISUAL_D * 0.5 * 1.25















func _strike_vel_k() -> float:
	if not _lienzo_h:
		return 1.0
	return _strike_reach() / maxf(_strike_reach_juego(), 0.0001)









func _strike_rect_juego() -> Rect2:
	var vp: Vector2 = SceneFade.rect_visible(self).size
	if not _lienzo_h:
		return Rect2(Vector2.ZERO, vp)
	var medio_alto: float = vp.y * 0.5 * tan(deg_to_rad(STRIKE_FOV * 0.5)) \
			/ tan(deg_to_rad(_shot_cam.fov * 0.5))
	var medio: Vector2 = Vector2(medio_alto * AIM_ASPECT, medio_alto)
	return Rect2(vp * 0.5 - medio, medio * 2.0)








func _strike_focus() -> Vector3:
	if _strike_pivot != Vector3.ZERO:
		return _strike_pivot
	return Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)





func _header_contact_y() -> float:
