var _slide_dir: Vector2 = Vector2.ZERO








var _slide_tw: Tween = null



const SLIDE_REACH: float = 0.8





























func _slide_travel(actor: AnimatedSprite3D, hacia: Vector2, largo_fijo: float = -1.0,
		dur_fija: float = -1.0, surco: bool = true) -> void:
	var falta: float = hacia.length()
	if falta < 0.01:
		return
	var dir: Vector2 = hacia / falta




	_slide_dir = dir
	var largo: float = clampf(falta * SLIDE_REACH, SLIDE_MIN_M, SLIDE_MAX_M)



	if largo_fijo >= 0.0:
		largo = minf(largo_fijo, SLIDE_MAX_M)
		if largo < 0.05:
			return
	var from: Vector3 = actor.position
	var meta2: Vector2 = _inside_field(Vector2(from.x, from.z) + dir * largo)
	var to: Vector3 = Vector3(meta2.x, from.y, meta2.y)


	var ri: int = _rival_actors.find(actor)
	var di: int = _duel_def_actors.find(actor)
	var dur: float = dur_fija if dur_fija > 0.0 else _slide_anim_secs(actor)
	actor.set_meta("order_run", true)
	if _slide_tw != null and _slide_tw.is_valid():
		_slide_tw.kill()
	_slide_tw = create_tween()
	_slide_tw.tween_method(_slide_step.bind(actor, from, to, ri, di), 0.0, 1.0, dur) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	_slide_tw.tween_callback(_order_release.bind(actor))




	if surco:
		_slide_surco(from, to, dur)





func _slide_surco(from: Vector3, to: Vector3, dur: float) -> void:
	if _fx != null and _stadium != null:
		_fx.slide_scar(from, to, SLIDE_SCAR_W,
			WeatherWear.scar_color(_stadium.weather_id()), dur)





		if bool(_stadium.weather.get("snow", false)):
			for i in 5:
				var q: Vector3 = from.lerp(to, float(i) / 4.0)
				_stadium.tread_at(q.x, q.z, 1.0)







































func _desv_vivo(actor: AnimatedSprite3D, antes) -> bool:
	if not (_desv_on and _desv_vivo_on and _tope_pierna) or _keeper_triggered \
			or _traj_i <= 0 or _traj_i >= _traj.size() or _balon_suelto() \
			or _bloqueo_seco() \
			or actor == _keeper or not _rival_actors.has(actor):
		return false
	var bp: Vector3 = _traj[_traj_i]


	var viento: float = _viento_en(_traj_i)
	var v_in: Vector3 =(bp - _traj[_traj_i - 1]) / SIM_DT - Vector3(viento, 0.0, 0.0)



	if v_in.length() < DESV_VIVO_V or v_in.z >= 0.0 \
			or bp.y >= ZANCADA_TAPA_MAX_H - BALL_R:
		return false


	if _robo_area_puede(bp) or (_meta_viva and bp.z > META_CASTIGO_Z):
		return false



	var giro: Vector2 = _vuelo_giro
	var lado: Vector2 = Vector2(bp.x - actor.position.x, bp.z - actor.position.z)
	var f: Vector2 = Vector2(v_in.x, v_in.z).normalized()
	var b: float = clampf((lado - f * lado.dot(f)).length()
		/ maxf(_alcance_rival(bp.y, v_in.length()), 0.05), 0.0, 1.0)
	var parte: String = _parte_del_cuerpo(bp.y + BALL_R)
	var nd: Vector3 = _desv_normal(v_in, lado, b, float(DESV_PARTES[parte][1]))
	var r: Dictionary = _desv_respuesta(v_in, giro.x, giro.y, nd,
		float(DESV_PARTES[parte][0]), true, randf())
	if String(r["tipo"]) == "seco":
		return false



	if not _zancada_en({"i": _traj_i, "a": actor}, SIM_DT):
		_play_clear_gesture(actor, false)
	_last_toucher = antes if antes != null and is_instance_valid(antes) else null



	var cruce0: Vector3 = _cruce_sin_choque(bp, v_in, giro.x, giro.y, viento,
		SIM_STEPS - _traj_i)
	var out: Vector3 = r["vel"]
	var p0: Vector3 = Vector3(bp.x, maxf(bp.y, 0.0), bp.z)
	p0.z = maxf(p0.z, actor.position.z + DESV_SEP) if out.z > 0.0 \
			else minf(p0.z, actor.position.z - DESV_SEP)

	var ba = _barr_actor if _barr_actor != null and is_instance_valid(_barr_actor) \
			and _traj_i <= _barr_mudo_i else null
	_desv_vivo_sem = {"tipo": r["tipo"], "parte": parte, "actor": actor, "v_in": v_in,
		"giro": Vector2(float(r["spin"]), float(r["back"])),
		"barr_a": ba, "barr_mudo":(_barr_mudo_i - _traj_i) if ba != null else -1,
		"cruce0": cruce0}


	if _fk_runs_on:
		_end_cross_runs()

	_cross_i = -1
	_net_hit = false
	_impact_sfx = false


	_foto_desde_cuerpos()
	_simulate_flight(p0, out, float(r["spin"]), float(r["back"]))
	_desv_vivo_sem = {}
	state = State.FLIGHT
	_traj_i = 0
	return true








func _viento_en(k: int) -> float:
	var w: float = 0.0
	for s in mini(k, _traj.size()):
		if (_traj[s] as Vector3).y > 0.12:
			w +=(_wind.x * WIND_DRIFT_FRAC - w) *(WIND_DRAG * SIM_DT)
		else:
			w *= 1.0 - 4.0 * SIM_DT
	return w







func _desv_contacto() -> void:
	var t: Dictionary = _desv_toques[_desv_vistos]
	_desv_vistos += 1




	_olympic_live = false




	if _audio != null:
		_audio.kick()
	_haptic(20)
	var i: int = int(t.get("i", -1))

	if i >= 0 and i < _traj.size() and _traj[i].y < HEADER_MIN_H \
