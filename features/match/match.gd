func _fans_keep_ball() -> void:
	if _stadium == null:
		return
	_lost_balls += 1
	_stadium.crowd_excite(0.8)
	_hud.show_message(I18n.t("¡Se quedan el balón!"), Color("ffd76d"), 1.4)

























	if Settings.reduce_motion or not _stadium.stand_seat_exists(_stand_p) \
			or not Career.claim_damage_scene("stand"):

		if _ball != null and is_instance_valid(_ball):
			_ball.visible = false
		return
	var spot: Vector3 = _stadium.stand_catch_spot(_stand_p)








	if _ball != null and is_instance_valid(_ball):
		_ball.visible = false
		if is_instance_valid(_stand_ball):
			_stand_ball.queue_free()
		_stand_ball = AnimatedSprite3D.new()
		_stand_ball.sprite_frames = _ball.sprite_frames
		_stand_ball.animation = _ball.animation
		_stand_ball.pixel_size = _ball.pixel_size
		_stand_ball.billboard = _ball.billboard
		_stand_ball.texture_filter = _ball.texture_filter
		_stand_ball.alpha_cut = _ball.alpha_cut
		_stand_ball.position = spot
		add_child(_stand_ball)


		var bt: Tween = create_tween()
		bt.tween_property(_stand_ball, "position", spot + Vector3(0.0, 0.6, 0.0), 0.55) \
				.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	if _stand_cam == null:
		_stand_cam = Camera3D.new()
		add_child(_stand_cam)

	_stand_cam.fov = 44.0








	var inward: Vector3 = - spot
	inward.y = 0.0
	inward = inward.normalized()
	var eye: Vector3 = spot + inward * 13.0 + Vector3(0.0, 2.2, 0.0)
	_stand_cam.position = eye
	_stand_cam.look_at(spot)
	_stand_cam.current = true
	if _stand_tween and _stand_tween.is_valid():
		_stand_tween.kill()


	_stand_tween = create_tween()
	_stand_tween.tween_property(_stand_cam, "position",
		eye +(spot - eye).normalized() * 0.9, STAND_CUT_DUR) \
				.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	SceneFade.timer(STAND_CUT_DUR, false).timeout.connect(_end_stand_cut)





















func _ball_to_the_street() -> void:
	if _stadium == null:
		return
	_street_balls += 1



	Achievements.ingest_street_ball()
	_hud.show_message(I18n.t("¡Se fue a la calle!"), Color("ffd76d"), 1.4)



	_stadium.crowd_excite(0.4)




	if Settings.reduce_motion or not Career.claim_damage_scene("calle"):

		if _ball != null and is_instance_valid(_ball):
			_ball.visible = false
		return






















	var cruce: Vector3 = _stand_p
	cruce.z = minf(cruce.z, BACK_WALL_Z)














































	cruce.x = clampf(cruce.x, - Stadium.STREET_HALF_W, Stadium.STREET_HALF_W)
	var spot: Vector3 = _stadium.street_catch_spot(cruce)






















	var corredor_ini: float =(spot.z + STREET_CAM_BACK - cruce.z) \
			* STREET_CAM_TAN_H * STREET_BALL_IN_FRAME
	var aim: Vector3 = spot
	aim.x = clampf(spot.x, cruce.x - corredor_ini, cruce.x + corredor_ini)














	var borde: float = maxf(0.0, _stadium._ring_x()
		-(spot.z + STREET_CAM_BACK -(cruce.z - STREET_BALL_RUN)) * STREET_CAM_TAN_H)
	aim.x = clampf(aim.x, - borde, borde)







	var calle_hx: float = Stadium.STREET_HALF_W



	if _ball != null and is_instance_valid(_ball):
		_ball.visible = false
		if is_instance_valid(_stand_ball):
			_stand_ball.queue_free()
		_stand_ball = AnimatedSprite3D.new()
		_stand_ball.sprite_frames = _ball.sprite_frames
		_stand_ball.animation = _ball.animation
		_stand_ball.pixel_size = _ball.pixel_size
		_stand_ball.billboard = _ball.billboard
		_stand_ball.texture_filter = _ball.texture_filter
		_stand_ball.alpha_cut = _ball.alpha_cut



		var salida: Vector3 = cruce
		salida.y = minf(salida.y, STREET_BALL_TOP)






		salida.x = clampf(salida.x, aim.x - corredor_ini, aim.x + corredor_ini)
		_stand_ball.position = salida
		add_child(_stand_ball)




		var rumbo: Vector3 = Vector3(_stand_vel.x, 0.0, _stand_vel.z)
		if rumbo.length_squared() < 0.01:


			rumbo = Vector3(0.0, 0.0, -1.0)














		var meta: Vector3 = cruce + Vector3(0.0, 0.0, - STREET_BALL_RUN)




















		var corredor: float =(spot.z + STREET_CAM_BACK - meta.z) * STREET_CAM_TAN_H \
				* STREET_BALL_IN_FRAME
		meta.x = clampf(salida.x + rumbo.normalized().x * STREET_BALL_RUN,
			- calle_hx, calle_hx)
		meta.x = clampf(meta.x, aim.x - corredor, aim.x + corredor)
		var bt: Tween = create_tween()
		bt.set_parallel(true)



		bt.tween_property(_stand_ball, "position:x", meta.x, STREET_BALL_DUR)
		bt.tween_property(_stand_ball, "position:z", meta.z, STREET_BALL_DUR)
		bt.tween_property(_stand_ball, "position:y", 0.0, STREET_BALL_DUR) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	if _stand_cam == null:
		_stand_cam = Camera3D.new()
		add_child(_stand_cam)




	_stand_cam.fov = 44.0





	var eye: Vector3 = aim + Vector3(0.0, STREET_CAM_H, STREET_CAM_BACK)
	_stand_cam.position = eye
	_stand_cam.look_at(aim)
	_stand_cam.current = true
	if _stand_tween and _stand_tween.is_valid():
		_stand_tween.kill()


	_stand_tween = create_tween()
	_stand_tween.tween_property(_stand_cam, "position",
		eye + Vector3(0.0, 0.0, STREET_CAM_PULL), STAND_CUT_DUR) \
				.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


	SceneFade.timer(STAND_CUT_DUR, false).timeout.connect(_end_stand_cut)


















