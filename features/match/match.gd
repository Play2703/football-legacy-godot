const PRISA_EXTRA_DESDE_PRORROGA: int = 110
const PRISA_EXTRA_TOPE: int = 89
const PRISA_EXTRA_TOPE_PRORROGA: int = 118





static func _prisa_extra_minuto(minute: int, ultima: int, play_to: int,
		extra_time: bool) -> int:
	if minute <(PRISA_EXTRA_DESDE_PRORROGA if extra_time else PRISA_EXTRA_DESDE):
		return -1
	var tope: int = mini(PRISA_EXTRA_TOPE_PRORROGA if extra_time else PRISA_EXTRA_TOPE,
		play_to - 1)
	var m: int = maxi(minute, ultima) + 2
	return m if m <= tope else -1







