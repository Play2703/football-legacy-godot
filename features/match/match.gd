func _recep_corre(a: AnimatedSprite3D, q: Vector2, v: float, rumbo: Vector2 = Vector2.ZERO,
		fam: String = "run_") -> void:
	var d: Vector2 = q - Vector2(a.position.x, a.position.z)
	_recep_pon(a, q)
	if d.length() <= 0.0005:
		d = rumbo
	var dn: String = String(_recep_perfil.get(a, ""))
	if dn.is_empty():
		if d.length() <= 0.0005:
			return
		dn = _dir_name(Vector3(d.x, 0.0, d.y))
		_recep_perfil[a] = dn
	_anim_lock[a] = Time.get_ticks_msec() + RECEP_PASO_MS
	_ondemand_deadline_us = maxi(_ondemand_deadline_us, Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
	var anim: String = fam + dn
	if not _anim_usable(a, anim):
		fam = "run_"
		anim = fam + dn
		if not _anim_usable(a, anim):
			return
	if String(a.animation) != anim:


		var f_prev: int = a.frame
		var p_prev: float = a.frame_progress
		var sigue: bool = a.is_playing() and a.sprite_frames.has_animation(a.animation) \
				and a.sprite_frames.get_frame_count(a.animation) == a.sprite_frames.get_frame_count(anim)
		a.flip_h = false
		a.play(anim)
		if sigue:
			a.set_frame_and_progress(f_prev, p_prev)
	a.speed_scale = clampf(v /(WALK_STRIDE_MPS if fam == "walk_" else RUN_STRIDE_MPS),
		STRIDE_SCALE_MIN, ENTRANCE_ANIM_MAX)





func _recep_pide(yo: AnimatedSprite3D, q: Vector2, v: float) -> void:
	if not _anim_usable(yo, "wave_walk"):
		_recep_corre(yo, q, v, Vector2.ZERO, "walk_")
		return
	_recep_pon(yo, q)
	if String(yo.animation) != "wave_walk":
		yo.flip_h = false
		yo.play("wave_walk")
	yo.speed_scale = 1.0
	_anim_lock[yo] = Time.get_ticks_msec() + RECEP_PASO_MS





func _recep_quieto(a: AnimatedSprite3D, rumbo: Vector2) -> void:
	var dn: String = _dir_name(Vector3(rumbo.x, 0.0, rumbo.y))
	var anim: String = "idle" if dn == "south" else ("idle_back" if dn == "north" else "idle_" + dn)
	if String(a.animation) != anim and _anim_usable(a, anim):
		a.flip_h = false
		a.speed_scale = 1.0
		a.play(anim)





func _recep_frena(yo: AnimatedSprite3D, llega: Vector2, pies: Vector2, k: float, t: float) -> void:
	if k >= 1.0:
		_recep_pon(yo, pies)
		_recep_quieto(yo, _recep_hacia)
		_anim_lock[yo] = Time.get_ticks_msec() + RECEP_PASO_MS
		return
	var q: Vector2 = llega.lerp(pies, 1.0 -(1.0 - k) *(1.0 - k))
	_recep_corre(yo, q, 2.0 * llega.distance_to(pies) *(1.0 - k) / maxf(t, 0.05), _recep_hacia)




func _recep_vive(dt: float, sitio: Vector2) -> void:
	_saque_vive(dt, sitio)
	_recep_rivales(dt)






func _recep_rivales(dt: float) -> void:
	if dt <= 0.0:
		return
	var anda: float = WALK_ENTER * _pace_world_k()
	for i in mini(_rival_actors.size(), _defender_pos.size()):
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or a == _keeper:
			continue
		var antes: Vector2 = _recep_rival_antes.get(i, _defender_pos[i])
		if _defender_pos[i].distance_to(antes) >= anda * dt:
			a.set_meta("pace_run_until", Time.get_ticks_msec() + RECEP_PASO_MS)
			_recep_rival_antes[i] = _defender_pos[i]
			continue
		_defender_pos[i] = antes
		a.position.x = antes.x
		a.position.z = antes.y
		_run_target.erase(a)
		_recep_rival_antes[i] = antes




func _play_recepcion() -> bool:
	var srv: AnimatedSprite3D = _recep_srv
	var yo: AnimatedSprite3D = _self_actor
	if srv == null or not is_instance_valid(srv) or yo == null or not is_instance_valid(yo) \
			or not is_instance_valid(_ball):
		return true
	var gen: int = _recep_gen
	if _practice_kind.is_empty():
		_recep_partido_visto = true
	state = State.SETUP
	_recep_ultimo = ""
	var r: float = BALL_VISUAL_D * 0.5
	var parte: String = _recep_parte
	var e: Dictionary = RecepcionAerea.PARTES[parte]

	var aro: bool = _drive_ring != null and is_instance_valid(_drive_ring) and _drive_ring.visible
	if aro:
		_drive_ring.visible = false
	_hud.show_hint("")




	var sitio: Vector2 = _ball_field
	var pies: Vector2 = Vector2(yo.position.x, yo.position.z)
	_recep_pies = pies
	var srv2: Vector2 = Vector2(srv.position.x, srv.position.z)
	var venia: Vector2 = srv2 - pies
	var vn: Vector2 = venia.normalized() if venia.length() > 0.01 else Vector2(1.0, 0.0)
	var pase: Vector2 = - vn
	var pase3: Vector3 = Vector3(pase.x, 0.0, pase.y)
	_recep_hacia = vn.rotated(deg_to_rad(RECEP_CERCA_DEG) * _recep_lado)
	var reposo: Vector3 = Vector3(sitio.x, r, sitio.y)
	var contacto: Vector3 = RecepcionAerea.contacto(pies, _recep_hacia, parte)
	_recep_contacto = contacto
	var desde: Vector3 = Vector3(srv2.x + pase.x * 0.45, r, srv2.y + pase.y * 0.45)
	var largo: float = Vector2(contacto.x - desde.x, contacto.z - desde.z).length()


	var fuerza: float = RecepcionAerea.fuerza_de(_recep_rng)
	var vuelo_s: float = RecepcionAerea.vuelo_de(largo, fuerza)
	_recep_plan = RecepcionAerea.plan(desde, contacto, vuelo_s,
		RecepcionAerea.t_gesto(parte, _recep_fps(yo, parte)), Career.control_norm(),
		_recep_racha, parte, RecepcionAerea.aro_de(_recep_rng),
		RecepcionAerea.comba_de(_recep_rng, desde, contacto, vuelo_s), fuerza)
	_recep_t = 0.0
	_recep_toque = -1.0
	_recep_veredicto = ""
	_ball.position = desde
	_ball.visible = true
	var p: Dictionary = _recep_plan
	var vuelo: float = float(p["vuelo"])
	var t_ideal: float = RecepcionAerea.t_ideal(p)
	var t_corte: float = maxf(RecepcionAerea.aro_t0(p) - RECEP_CORTE_S, RECEP_PELOTAZO_S + 0.1)




	var t_frena: float = maxf(t_ideal - t_corte, 0.05)
	var llega: Vector2 = pies - _recep_hacia * clampf(RECEP_CORRE_V * t_frena * 0.5,
		RECEP_FRENA_M.x, RECEP_FRENA_M.y)
	var corre: Vector2 = Vector2(0.0, -1.0).rotated(deg_to_rad(
		_recep_rng.randf_range(- RECEP_CORRE_GIRO_DEG, RECEP_CORRE_GIRO_DEG)))
	var t_carrera: float = RECEP_CARRERILLA_S + RECEP_KICK_AT + t_corte
	var arranca: Vector2 = llega - corre * clampf(RECEP_CORRE_V * t_carrera,
		RECEP_CORRE_M.x, RECEP_CORRE_M.y)
	arranca.x = clampf(arranca.x, - FIELD_EDGE, FIELD_EDGE)


	var v_corre: float = arranca.distance_to(llega) / maxf(t_carrera, 0.05)
	var v_carrerilla: float = RECEP_CARRERILLA_M / RECEP_CARRERILLA_S
	var t_acto: float = 0.0

	var atras: Vector2 = srv2 - pase * RECEP_CARRERILLA_M
	_recep_pon(srv, atras)

	var pide_f: Vector2 =(srv2 - arranca).normalized() if srv2.distance_to(arranca) > 0.01 else vn
	var pide_desde: Vector2 = arranca - pide_f * RECEP_PIDE_V * RECEP_PIDE_S
	_recep_pon(yo, pide_desde)
	_recep_franjas_on()
	_recep_foco = yo
	var ojo_p: Vector3 = _recep_ojo_pide(arranca, pide_f)
	var mira_p: Vector2 = Vector2(arranca.x - ojo_p.x, arranca.y - ojo_p.z)
	_recep_cam_on(ojo_p, mira_p, _recep_ver_pide(yo, mira_p))
	_recep_quieto(srv, pase)

	for _i in 20:
		_ondemand_deadline_us = Time.get_ticks_usec() + 20000
		if _gesto_listo(yo, "wave_walk"):
			break
		await get_tree().process_frame
		if not _recep_sigue(gen):
			return _recep_corta(aro)





	var recibe: String = _recep_anim(parte)
	_cara(yo, RECEP_CARA_PIDE, RECEP_PIDE_S + 0.3)
	var dt: float = 0.0
	var tp: float = 0.0
	while tp < RECEP_PIDE_S:
		_recep_pide(yo, pide_desde.lerp(arranca, tp / RECEP_PIDE_S), RECEP_PIDE_V)
		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
		_anim_usable(srv, RECEP_PATADA + "east")
		_anim_usable(srv, RECEP_PATADA + "west")
		for dn: String in ["east", "west", "north", "south"]:
			_anim_usable(yo, "run_" + dn)
			_anim_usable(srv, "run_" + dn)
		_anim_usable(yo, "walk_south")
		_anim_usable(yo, recibe)
		await get_tree().physics_frame
		if not _recep_sigue(gen):
			return _recep_corta(aro)
		dt = get_physics_process_delta_time() if can_process() else 0.0
		tp += dt
		_recep_vive(dt, sitio)
		_recep_plano(dt / maxf(Engine.time_scale, 0.01), _recep_ver_pide(yo, mira_p))
		_recep_tapa()
	_recep_pon(yo, arranca)

	_recep_foco = srv
	var ojo0: Vector3 = _recep_ojo_pelotazo(srv2, pase)
	_recep_cam_on(ojo0, Vector2(srv2.x - ojo0.x, srv2.y - ojo0.z), _recep_ver_pelotazo(srv, desde))

	_recep_corre(yo, arranca, v_corre, corre)


	var kick: String = RECEP_PATADA + _dir_name(pase3)
	for _i in 30:
		_ondemand_deadline_us = Time.get_ticks_usec() + 20000
		if _gesto_listo(srv, kick):
			break
		await get_tree().process_frame
		if not _recep_sigue(gen):
			return _recep_corta(aro)
	var tk: float = 0.0
	var pateo: bool = false
	var suena: bool = false

	var falta: float = 0.0
	while true:

		if suena:
			if String(srv.animation) != kick:
				break
			falta =(float(RECEP_KICK_CUADRO - srv.frame) - srv.frame_progress - RECEP_KICK_CONTACTO) \
					/ maxf(srv.sprite_frames.get_animation_speed(kick) * srv.speed_scale, 0.01)
			if falta <= 0.0:
				break
		if tk >= RECEP_CARRERILLA_S + RECEP_KICK_AT +(RECEP_KICK_TOPE_S if suena else 0.0):
			break
		if tk < RECEP_CARRERILLA_S:
			_recep_corre(srv, atras.lerp(srv2, tk / RECEP_CARRERILLA_S), v_carrerilla, pase)
		elif not pateo:
			pateo = true
			_recep_pon(srv, srv2)
			if _gesto_listo(srv, kick):
				srv.flip_h = false
				srv.speed_scale = 1.0
				srv.play(kick)
				_anim_lock[srv] = Time.get_ticks_msec() + 900
				suena = true
		_recep_corre(yo, arranca.lerp(llega, clampf(t_acto / t_carrera, 0.0, 1.0)), v_corre, corre)
		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
		_anim_usable(yo, recibe)
		await get_tree().physics_frame
		if not _recep_sigue(gen):
			return _recep_corta(aro)
		dt = get_physics_process_delta_time() if can_process() else 0.0
		tk += dt
		t_acto += dt
		_recep_vive(dt, sitio)
		_recep_plano(dt / maxf(Engine.time_scale, 0.01), _recep_ver_pelotazo(srv, desde))
		_recep_tapa()
	_recep_pon(srv, srv2)


	_recep_t = maxf(0.0, - falta)




	_audio.kick()
	_fx.shake(RECEP_GOLPE_SACUDE * lerpf(RECEP_GOLPE_FUERZA.x, RECEP_GOLPE_FUERZA.y,
		float(p.get("fuerza", 0.5))))
	_haptic(30)




	var cerca: bool = false
	var hombro: bool = false
	var quieto: bool = false
	var t_gesto_ini: float = INF
	var gesto: bool = false
	var ojo_cerca: Vector3 = Vector3(pies.x + _recep_hacia.x * RECEP_CERCA_M, RECEP_CERCA_Y,
		pies.y + _recep_hacia.y * RECEP_CERCA_M)
	var ver_cerca: Array[Vector3] = _recep_ver_cerca(pies)
	dt = 0.0
	while true:
		_recep_t = minf(_recep_t, vuelo)
		_ball.position = RecepcionAerea.balon(p, _recep_t)

		if not hombro and not cerca and _recep_t >= RECEP_PELOTAZO_S:
			hombro = true
			_recep_foco = yo
			var o1: Vector3 = _recep_ojo_hombro(Vector2(yo.position.x, yo.position.z), vn)
			_recep_cam_on(o1, srv2 - Vector2(o1.x, o1.z), _recep_ver_hombro(srv, yo))
			if quieto:
				_recep_quieto(srv, pase)
		if not cerca and _recep_t >= t_corte:
			cerca = true
			hombro = false
			_recep_foco = yo
			_recep_pon(yo, llega)
			_recep_cam_on(ojo_cerca, - _recep_hacia, ver_cerca)
			if quieto:
				_recep_quieto(srv, pase)

			_recep_frena(yo, llega, pies, 0.0, t_frena)
			_cara(yo, RECEP_CARA_ESPERA, maxf(t_ideal - _recep_t, 0.1) + 1.0)

		if not quieto and (String(srv.animation) != kick or not srv.is_playing()):
			quieto = true
			_recep_quieto(srv, pase)
		if not cerca:
			_recep_corre(yo, arranca.lerp(llega, clampf(t_acto / t_carrera, 0.0, 1.0)), v_corre)
		elif not gesto:

			_recep_frena(yo, llega, pies, clampf((_recep_t - t_corte) / t_frena, 0.0, 1.0), t_frena)
		if not _recep_escucha and RecepcionAerea.escucha(p, _recep_t):
			_recep_escucha = true
			_hud.clear_message()
			_recep_monta_aro()
			_recep_lenta = true
			_fx.slowmo(RECEP_LENTO)
			_cara(yo, RECEP_CARA_ESPERA, 2.0)

		if is_instance_valid(_recep_aro) and _recep_aro.toque_t >= 0.0 \
				and _recep_veredicto.is_empty():
			_recep_toca()

		if not is_nan(recep_auto) and _recep_veredicto.is_empty() \
				and _recep_t >= t_ideal + recep_auto:
			_recep_toca()
		if _recep_veredicto.is_empty() and RecepcionAerea.se_fue(p, _recep_t):
			_recep_veredicto = RecepcionAerea.SE_VA
			_recep_toque = _recep_t
			if is_instance_valid(_recep_aro):
				_recep_aro.cierra(Cano.TARDE)
		if is_inf(t_gesto_ini) and not _recep_veredicto.is_empty():


			t_gesto_ini = vuelo - 0.04 if _recep_veredicto == RecepcionAerea.SE_VA \
					else RecepcionAerea.t_gesto_arranca(p, _recep_toque, _recep_veredicto)
		if not gesto and _recep_t >= t_gesto_ini:

			_recep_pon(yo, pies)
			_anim_lock.erase(yo)
			gesto = _recep_gesto(yo, parte)
		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
		_anim_usable(yo, recibe)
		if hombro:
			_recep_ojo = _recep_ojo_hombro(Vector2(yo.position.x, yo.position.z), vn)
			_recep_plano(dt / maxf(Engine.time_scale, 0.01), _recep_ver_hombro(srv, yo))
		elif not cerca:
			_recep_plano(dt / maxf(Engine.time_scale, 0.01), _recep_ver_pelotazo(srv, desde))
		_recep_tapa()
		_recep_pinta()
		if _recep_t >= vuelo:
			break
		await get_tree().physics_frame
		if not _recep_sigue(gen):
			return _recep_corta(aro)
		dt = get_physics_process_delta_time() if can_process() else 0.0
		_recep_t += dt
		t_acto += dt
		_recep_vive(dt, sitio)
	_recep_escucha = false
	_recep_pon(yo, pies)
	if _recep_lenta:
		_recep_lenta = false
		_fx.slowmo_off(0.3)
	var limpia: bool = _recep_veredicto == RecepcionAerea.LIMPIA
	_recep_ultimo = _recep_veredicto


	if limpia:
		var pts: PackedVector3Array = PackedVector3Array()
		_rebote_trayectoria(pts, contacto, reposo, float(e["doma_vy"]), float(e["doma_bote"]))

		_fx.hit_stop(RECEP_DOMA_GOLPE.x, RECEP_DOMA_GOLPE.y, RECEP_DOMA_GOLPE.z)
		_fx.shake(0.08)
		_audio.toque(0.8)
		if not gesto:
			_recep_gesto(yo, parte)
		_cara(yo, RECEP_CARA_BIEN, 2.0)


		if _practice_kind.is_empty():
			_bump_rating("recep_sale")
		_recep_racha += 1
		_ball_field = sitio


		var tr: float = 0.0
		var tc: float = 0.0
		var dur: float = maxf(float(pts.size() - 1) / 60.0, 0.05)
		var orb0: Vector2 = Vector2(ojo_cerca.x - pies.x, ojo_cerca.z - pies.y)
		var ver_tu: Array[Vector3] = _recep_ver_tu(pies)
		while tr < RECEP_RESPIRO_S:
			_pecho_muestra(minf(tc / dur, 1.0), pts)
			await get_tree().physics_frame
			if not _recep_sigue(gen):
				return _recep_corta(aro)
			dt = get_physics_process_delta_time() if can_process() else 0.0
			var dr: float = dt / maxf(Engine.time_scale, 0.01)
			tr += dr
			tc += dt
			_recep_vive(dt, sitio)
			var u: float = smoothstep(0.0, 1.0, clampf(tr / RECEP_RESPIRO_S, 0.0, 1.0))
			var o: Vector2 = orb0.rotated(deg_to_rad(RECEP_ORBITA_DEG * _recep_lado) * u)
			_recep_ojo = Vector3(pies.x + o.x, RECEP_CERCA_Y + RECEP_ORBITA_SUBE_M * u, pies.y + o.y)
			_recep_f = - o.normalized()
			_recep_plano(dr, ver_tu)
			_recep_pinta()
		var i0: int = clampi(int(tc / dur * float(pts.size() - 1)), 0, pts.size() - 1)
		_recep_quita_aro()
		_recep_franjas_sale()


		if not await _recep_vuelta(gen, sitio, pts.slice(i0)):
			return _recep_corta(aro)
		_ball.position = reposo


		_trap_enabled = false
		_trap_active = false
		_strike_motion = {}
		_header_chance = false





		_drive_lock_t = 0.0



		_saque_respeto(sitio)
		_saque_respiro_t = RECEP_RESPIRO_RIVAL_S
		if aro and is_instance_valid(_drive_ring):
			_drive_ring.visible = true

		_anim_lock.erase(srv)
		_pasador_arranca(srv, yo, Offer.APOYO)
		return true



	_recep_racha = 0
	_recep_libre = false
	_fx.shake(0.12)
	_audio.toque(0.6)
	_cara(yo, "resoplar", 2.3)
	var ruta: PackedVector3Array = RecepcionAerea.suelto(contacto,
		RecepcionAerea.rebote(_recep_rng, p), r, RECEP_SUELTO_S)
	var fin: Vector3 = ruta[ruta.size() - 1]
	var caza: int = -1
	var caza_d: float = INF
	for i in mini(_rival_actors.size(), _defender_pos.size()):
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or a == _keeper:
			continue
		var d: float = _defender_pos[i].distance_to(Vector2(fin.x, fin.z))
		if d < caza_d:
			caza_d = d
			caza = i
	var ts: float = 0.0
	while ts < RECEP_FALLO_VE_S:
		_ball.position = ruta[clampi(int(ts * 60.0), 0, ruta.size() - 1)]
		_recep_vive(dt, sitio)
		_recep_caza(caza, dt)
		_recep_pinta()
		await get_tree().physics_frame
		if not _recep_sigue(gen):
			return _recep_corta(aro)
		dt = get_physics_process_delta_time() if can_process() else 0.0
		ts += dt
	_recep_quita_aro()
	_recep_franjas_sale()
	if not await _recep_vuelta(gen, sitio,
			ruta.slice(clampi(int(ts * 60.0), 0, ruta.size() - 1)), caza):
		return _recep_corta(aro)
	_ball_field = Vector2(_ball.position.x, _ball.position.z)
	if aro and is_instance_valid(_drive_ring):
		_drive_ring.visible = true
	_outcome = "missball"
	_recep_nota_falla = _practice_kind.is_empty()
	_resolve_chance("missball")
	return false




func _recep_reanuda() -> void:
	if not is_inside_tree() or state != State.RESOLVED \
			or _practice_kind != Practice.RECEPCION:
		return
	_next_chance()




func _recep_corta(aro: bool) -> bool:
	_recep_escucha = false
	_recep_quita_aro()
	if _recep_lenta:
		_recep_lenta = false
		_fx.slowmo_off()
	if is_inside_tree():
		_recep_suelta_cam()
	_recep_franjas_fuera()
	if aro and _drive_ring != null and is_instance_valid(_drive_ring):
		_drive_ring.visible = true
	return false

func _practice_chance(kind: String) -> Dictionary:
	if kind == Practice.RECEPCION:
		return _recepcion_chance()


	if kind == Practice.RECUPERA:
		return _recu_chance()
	if kind == Practice.SWITCH:
		return _switch_chance()
	if kind == Practice.PRESS_OUT:
		return _press_out_chance()



	if kind == Practice.SALIDA:
		return _salida_chance()

	if kind == Practice.SALIDA_META:
		return _meta_chance()

	if kind == Practice.SAQUE_BANDA:
		return _saque_chance()
	if kind == Practice.ZONES:
		return _zonas_chance()
	if kind == Practice.ESLALON:
		return _eslalon_chance()
	if kind == Practice.ENTRADA:
		return _entrada_chance()
	if kind == Practice.CLEAN_SHOT:
		return _clean_shot_chance()
	if kind == Practice.DIANAS:
		return _dianas_chance()
	if kind == Practice.BLANCOS:
		return _blancos_chance()
	if kind == Practice.RELEVO:
		return _relevo_chance()


	if kind == Practice.SAQUE_LARGO:
		return _servicio_chance("", false, true)


	if Practice.es_servicio(kind):
		return _servicio_chance(Practice.gesto_de(kind))


	if kind == Practice.DRIBBLE:
		return _make_duel_chance()

	if kind == Practice.CANO:
		return _make_duel_chance()



	if kind == Practice.OPEN_FIELD:
		return {
			"kind": "regate",
			"name": "Campo abierto",
			"ball": Vector2(0.0, Stadium.HALF_LINE),
			"target_z": -10.0,
			"teammates": [],
			"defenders": [],
			"open_field": true,
		}
	var side: float = -1.0 if randf() < 0.5 else 1.0
	if Practice.SET_ROLL.has(kind):
		var band: Array = Practice.SET_ROLL[kind]
		return _chance_from_origin(
			_draw_set_piece(side, randi_range(int(band[0]), int(band[1]))))
	for i in Practice.TRIES:
		var o: Dictionary = _draw_open_any(-1.0 if randf() < 0.5 else 1.0)
		if String(o.get("kind", "")) == kind:
			return _chance_from_origin(o)








	if Practice.OPEN_ROLL.has(kind):
		var forced: Array = Practice.OPEN_ROLL[kind]
		return _chance_from_origin(
			_draw_open_play(side, randi_range(int(forced[0]), int(forced[1]))))
	var arch: Dictionary = ChanceArchetypes.force_open(kind, side)
	if not arch.is_empty():
		return _chance_from_origin(arch)
	return _chance_from_origin(_draw_open_play(side))



















func _zonas_chance() -> Dictionary:
	return {
		"kind": "regate",
		"name": "Las cuatro zonas",
		"ball": Vector2(randf_range(- PRESS_OUT_X, PRESS_OUT_X),
			randf_range(PRESS_OUT_Z.x, PRESS_OUT_Z.y)),


		"target_z": -10.0,
		"teammates": [],
		"defenders": [],
		"press_out": true,
		"press_zones": ZONAS_ACADEMIA,
		"press_sin_guardias": true,
	}



















func _eslalon_chance() -> Dictionary:
	var centro: Vector2 = Vector2(0.0, Stadium.HALF_LINE)
	var yo: Vector2 = centro + Vector2(randf_range(-4.0, 4.0), randf_range(-4.0, 4.0))








	var el: Vector2 = yo + Vector2(randf_range(-2.0, 2.0),
		randf_range(ESLALON_RIVAL_D.x, ESLALON_RIVAL_D.y))
	return {
		"kind": "regate",
		"name": "Eslalon con rival",
		"ball": yo,
		"target_z": -10.0,
		"teammates": [],
		"defenders": [el],
		"press_out": true,
		"press_zones": ESLALON_ZONAS,
		"press_sin_guardias": true,
		"press_respiro": ESLALON_RESPIRO,
		"eslalon": true,
	}





















func _dianas_chance() -> Dictionary:
	var origen: Dictionary = {
		"kind": "libre",
		"name": "Porterías chiquitas",
		"ball": Vector2(DIANA_TIRO_X, DIANA_TIRO_Z),
		"mates": [0, 0], "rivals": [0, 0],
