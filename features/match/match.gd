func _diana_enciende(i: int) -> void:
	if i < 0 or i >= _dianas_nodos.size():
		return
	var raiz: Node3D = _dianas_nodos[i]
	if not is_instance_valid(raiz):
		return





	if raiz.has_meta("verde_tw"):
		var previo: Tween = raiz.get_meta("verde_tw") as Tween
		if previo != null and previo.is_valid():
			previo.kill()
	var tw: Tween = create_tween().set_parallel(true)
	raiz.set_meta("verde_tw", tw)
	for m in _mallas_de(raiz):






		var red: ShaderMaterial = m.material_override as ShaderMaterial
		if red != null:
			if not red.has_meta("tint0"):
				red.set_meta("tint0", red.get_shader_parameter("net_tint"))
			var tint0: Color = red.get_meta("tint0")
			red.set_shader_parameter("net_tint", CareerTheme.GOOD)
			tw.tween_method(func(c: Color) -> void: red.set_shader_parameter("net_tint", c),
					CareerTheme.GOOD, tint0, 0.35).set_delay(DIANAS_VERDE_T)
			continue
		var mat: BaseMaterial3D = m.material_override as BaseMaterial3D
		if mat == null:
			continue


		if not mat.has_meta("col0"):
			mat.set_meta("col0", mat.albedo_color)
		var col0: Color = mat.get_meta("col0")
		mat.albedo_color = CareerTheme.GOOD
		tw.tween_property(mat, "albedo_color", col0, 0.35).set_delay(DIANAS_VERDE_T)



func _mallas_de(n: Node) -> Array[MeshInstance3D]:
