func _resolve_falta_cedida(penal: bool, ya_sorteado: bool = false,
		forzado: Dictionary = {}) -> void:







	if _cedida_tuya:
		return
	if not ya_sorteado:
		_sortea_cobro_cedido(penal, forzado)




	var resuelve: bool = state != State.RESOLVED and state != State.ENDED \
			and state != State.SIM
	_resolve_chance("penal_ceded" if penal else "foul_ceded")
	if not resuelve:
		return







	if not _falta_taker.is_empty() and _falta_taker != Career.player_name \
			and not _cedida_ajena:
		_mate_socio[_falta_taker] = int(_mate_socio.get(_falta_taker, 0)) + 2






	if not _falta_cedida_gol:







		if penal and _cesion_stake.is_empty() and not _cedida_ajena:
			_cesion_stake = {"tipo": "cedido", "gol": false, "quien": _falta_taker}
		_goal_note = {"minute": match_minute, "scorer": _falta_taker,
			"cedida": "penal" if penal else "libre", "fallo": true}
		return





	team_goals += 1
	_sync_score()





	var goleador: String = _cedida_goleador if not _cedida_goleador.is_empty() \
			else _falta_taker





	if not goleador.is_empty() and goleador != Career.player_name:
		_mate_scorers[goleador] = int(_mate_scorers.get(goleador, 0)) + 1



		if not _cedida_ajena:
			_mate_socio[goleador] = int(_mate_socio.get(goleador, 0)) + 2



	_momentum.register_sim("goal_team")
	_push_momentum()















	var card: Dictionary = _cedida_card() if goleador == _falta_taker \
			else _mate_card(goleador)
	if not card.is_empty():



		_hud.show_goal_card(false, goleador, 0, 0, card)


	_goal_note = {"minute": match_minute, "scorer": goleador,
		"cedida": "penal" if penal else "libre", "fallo": false}













































