					_stadium.crowd_react("home", "close")
					_audio.ooh()
		theirs_r.append(r_scored)
		_hud.update_shootout_tally(mine_r, theirs_r)
		taken += 1
		await _shoot_wait(1.2)
		if _shootout_over(mine, theirs, taken, taken):


			await _shootout_replay()
			break
	var won: bool = mine > theirs
	GameState.next_shootout_winner = 1 if won else -1
	_tanda_dif = 1 if won else -1
	GameState.next_shootout_hero = _shootout_hero(won, last_side_mine, last_scored,
		scorer_mine if won else scorer_theirs, scorer_mine_you, mine, theirs)


	_shootout_note = I18n.tf("PENALES {0}-{1}", [mine, theirs])





	_shootout_side = 0
	_stadium.crowd_danger(0.0)
	_audio.danger(0.0)
	_audio.unhush()
	_hud.show_message(I18n.tf("¡PASAS TÚ! ({0}-{1})", [mine, theirs]) if won
		else I18n.tf("ELIMINADO EN PENALES ({0}-{1})", [mine, theirs]),
		UiKit.GOLD if won else Color("ffb0b0"), 2.4)
	if won:
		_stadium.crowd_react("home", "goal")


		_stadium.confetti_cannons_fire()
