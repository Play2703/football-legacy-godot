	if bool(cfg.get("de_calle", false)):
		return cfg
	var clave: String = CrestLogos.key_of(_club_de(is_rival))
	if clave.is_empty() or not CrestLogos.has(clave):
		return cfg
	var out: Dictionary = cfg.duplicate()
	out["crest_logo"] = clave
	return out





