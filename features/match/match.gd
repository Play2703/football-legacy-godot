const COLA_BAJA_K: float = 1.0





const COLA_BAJA_MAX: float = 0.7


const COLA_BAJA_RAMPA: float = 0.08



const COLA_PORTERIA_FIJA: bool = true








static func cola_baja(cae: float) -> float:
	if COLA_BAJA_K <= 0.0 or cae <= 0.0:
		return 0.0
	var g: float = cae - COLA_BAJA_RAMPA * 0.5
	if cae < COLA_BAJA_RAMPA:
		var x: float = cae / COLA_BAJA_RAMPA
		g = COLA_BAJA_RAMPA *(x * x * x - 0.5 * x * x * x * x)
	g *= COLA_BAJA_K
	var codo: float = COLA_BAJA_MAX * 0.5
	if g <= codo:
		return g
	return codo +(COLA_BAJA_MAX - codo) * tanh((g - codo) /(COLA_BAJA_MAX - codo))




func _servicio_cola_vale() -> bool:
	return COLA_BAJA_K > 0.0 and _lienzo_h and state == State.STRIKING and _serve_vivo \
			and _serve_i >= _serve_k and is_instance_valid(_shot_cam) and _shot_cam.current \
			and _serve_salto.is_empty() and _serve_golpe == Vector2.INF \
			and _servicio_cabeza() and not _servicio_chilena() and not _servicio_pecho() \
			and not bool(_serve_plan.get("saque", false))


func _servicio_cola_cam() -> void:
	if not _servicio_cola_vale():
		return

	if _serve_cola_y0 == INF:
		_serve_cola_y0 = _ball.position.y
	var b0: Basis = _strike_base_final
	var rig: Vector3 = _strike_cam_anchor + _strike_cam_off
	var h: float = cola_baja(_serve_cola_y0 - _ball.position.y)




	_shot_cam.position = rig - b0.y * h



	var rel: Vector3 = Vector3(0.0, CROSSBAR_H, 0.0) - rig
	var prof: float = - rel.dot(b0.z)
	var th: float = 0.0
	if COLA_PORTERIA_FIJA and prof > 1.0:
		var alto: float = rel.dot(b0.y)
		th = atan2(alto + h, prof) - atan2(alto, prof)
	_shot_cam.global_transform.basis = b0.rotated(b0.x, th) if th != 0.0 else b0


	_strike_clear_view()

















































const CITA_AIRE_PX: float = 32.0



const CITA_ORBITA_MAX_DEG: float = 8.0


func _servicio_cita_aire() -> void:
	_serve_cita_orbita = 0.0
	if CITA_AIRE_PX <= 0.0 or not _lienzo_h or not _serve_vivo or _hud == null \
			or not is_instance_valid(_shot_cam) or not _servicio_cabeza() \
			or _servicio_chilena() or _servicio_pecho() \
			or bool(_serve_plan.get("saque", false)):
		return
	var marcador: float = _hud.marcador_abajo()
	if marcador <= 0.0:
		return
	var meta: float = marcador + CITA_AIRE_PX
	var piv: Vector3 = _strike_pivot
	var b0: Basis = _strike_base_final
	var pos0: Vector3 = _strike_cam_anchor + _strike_cam_off
	if _cita_larguero_y(b0, pos0) >= meta:
		return

	var lo: float = 0.0
	var hi: float = deg_to_rad(CITA_ORBITA_MAX_DEG)
	if _cita_larguero_y(b0.rotated(b0.x, hi), piv +(pos0 - piv).rotated(b0.x, hi)) < meta:
		lo = hi
	else:
		for _i in 24:
			var mid: float =(lo + hi) * 0.5
			if _cita_larguero_y(b0.rotated(b0.x, mid), piv +(pos0 - piv).rotated(b0.x, mid)) < meta:
				lo = mid
			else:
				hi = mid
		lo = hi
	_strike_cam_off = piv +(pos0 - piv).rotated(b0.x, lo) - _strike_cam_anchor
	_place_shot_cam()
	_strike_base_final = _shot_cam.global_transform.basis
	_serve_cita_orbita = rad_to_deg(lo)





func _cita_larguero_y(b: Basis, pos: Vector3) -> float:
	var alto: float = SceneFade.rect_visible(self).size.y
	var rel: Vector3 = Vector3(0.0, CROSSBAR_H, 0.0) - pos
	var prof: float = - rel.dot(b.z)
	if prof <= 0.05:
		return INF
	var f: float = alto * 0.5 / tan(deg_to_rad(_shot_cam.fov) * 0.5)
	return alto * 0.5 - f * rel.dot(b.y) / prof







































func _strike_clear_view() -> void:
	if state != State.STRIKING or _shot_cam == null:
		return
	var cam: Vector3 = _shot_cam.global_position


	var lim: float = cam.distance_to(_strike_pivot) - STRIKE_CLEAR_MARGIN
	for a in _teammate_actors + _rival_actors:
		if not is_instance_valid(a) or a == _self_actor:
			continue
		if cam.distance_to(a.global_position) < lim:
			if a.visible:
				a.visible = false





				a.set_meta(ReplayRec.META_OCULTO_GOLPEO, true)
				_strike_hidden.append(a)






func _strike_restore_view() -> void:
	for a in _strike_hidden:
		if is_instance_valid(a):
			a.visible = true
			a.remove_meta(ReplayRec.META_OCULTO_GOLPEO)
	_strike_hidden.clear()



















