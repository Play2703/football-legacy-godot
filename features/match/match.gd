func _salida_step(delta: float) -> void:
	if not _salida_viva:
		return
	match state:
		State.AIMING, State.STRIKING, State.RUNUP, State.FLIGHT, State.PASSING:
			pass
		_:
			return
	if _drive_beat or _cobro_corre:
		return
	_meta_portero_frame(delta)
	_salida_t += delta
	_salida_quieto_t += delta
	if state == State.AIMING:

		_salida_golpe_d = 0.0
		var z: float = _ball_field.y


		if _salida_mejor_z == INF or z < _salida_mejor_z - SALIDA_GANA_M:
			_salida_mejor_z = z
			_salida_quieto_t = 0.0
		if not _salida_hito and z < Stadium.HALF_LINE:
			_salida_cruza()


	if _salida_quieto_t >= _salida_estanca_s():
		_salida_quieto_t = 0.0
		_salida_aprieta()
	if _salida_t >= _salida_tope_s() and state == State.AIMING:
		_salida_cierra("tope")















func _salida_cruza() -> void:
	_salida_hito = true


	if _contra_viva:
		return

	if not _salida_hablo_progreso:
		_salida_hablo_progreso = true
		_say("salida_medio")
	if not _practice_kind.is_empty() or _tutorial_active or _shootout_active:
		return
	_duel_wins_match += 1
	_momentum.register("press_out_win")
	_push_momentum()
	_count_rating("press_out_win")
	var r: float = _live_rating()
	_hud.set_rating(r, 0.0)
	_shown_rating = r





func _salida_aprieta() -> void:
	if _press_n >= DRIVE_PRESS_CAP:
		return
	_press_n += 1
	_salida_escalones += 1




