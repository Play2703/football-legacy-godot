func _chin_a_la_derecha(actor: Node3D, otro: Node3D) -> bool:
	var d: Vector2 = Vector2(otro.position.x - actor.position.x,
		otro.position.z - actor.position.z)
	_cam_base_refresh()
	if not _cam_present or not _cam_base_ok:
		return d.x >= 0.0
	return d.dot(_cam_right_flat) >= 0.0




func _chin_llega(actor: AnimatedSprite3D) -> void:
	if not is_instance_valid(actor):
		return
	if not _chin_vivos():
		_celeb_still(actor)
		return
	_run_target.erase(actor)
	if not _chin_llegados.has(actor):
		_chin_llegados.append(actor)
	var foco: AnimatedSprite3D = _celeb_focus as AnimatedSprite3D
	var otro: AnimatedSprite3D = _chin_socio if actor == foco else foco
	_chin_espera(actor, otro)
	if _chin_llegados.size() < 2:
		return
	_chin_espera(otro, actor)
	if _chin_recoloca():
		return
	SceneFade.timer(CHIN_ESPERA_S, false).timeout.connect(
		_chin_empieza.bind(_chin_token))



func _chin_espera(actor: AnimatedSprite3D, otro: AnimatedSprite3D) -> void:
	_hold_celebration(actor)
	var anim: String = "idle_east" if _chin_a_la_derecha(actor, otro) else "idle_west"
	actor.play(anim if _anim_usable(actor, anim) else "idle")







func _chin_recoloca() -> bool:
	if _chin_paso_dado:
		return false
	_cam_base_refresh()
	if not _cam_present or not _cam_base_ok:
		return false
	var foco: AnimatedSprite3D = _celeb_focus as AnimatedSprite3D
	var eje: Vector2 = Vector2(_chin_socio.position.x - foco.position.x,
		_chin_socio.position.z - foco.position.z)
	if eje.length_squared() < 0.0001 \
			or absf(eje.normalized().dot(_cam_right_flat)) >= CHIN_COSTADO_MIN:
		return false
	_chin_paso_dado = true
	var lado: float = 1.0 if eje.dot(_cam_right_flat) >= 0.0 else -1.0
	var fin: Vector3 = foco.position
	var p: Vector2 = Vector2(fin.x, fin.z) + _cam_right_flat * lado * CHIN_SEP_M
	if _chin_fuera(p, fin):
		p = Vector2(fin.x, fin.z) - _cam_right_flat * lado * CHIN_SEP_M
	var dest: Vector3 = _chin_dentro(p, fin)
	dest.y = _chin_socio.position.y
	_chin_llegados.erase(_chin_socio)

	_anim_lock.erase(_chin_socio)
	_run_target[_chin_socio] = dest
	var tw: Tween = create_tween()
	tw.tween_property(_chin_socio, "position", dest,
		maxf(_flat_dist(_chin_socio.position, dest) / CHIN_PASO_VEL, 0.25))
	tw.tween_callback(_chin_llega.bind(_chin_socio))
	_celeb_runs.append(tw)
	return true






func _chin_empieza(token: int) -> void:
	if token != _chin_token or not _chin_vivos():
		return
	var foco: AnimatedSprite3D = _celeb_focus as AnimatedSprite3D
	var listos: bool = true
	for n: AnimatedSprite3D in [foco, _chin_socio]:
		_ondemand_deadline_us = Time.get_ticks_usec() + CELEB_GESTO_BUDGET_US
		listos = _gesto_listo(n, "chinchanpu") and listos
	if not listos:
		_chin_intentos += 1
		if _chin_intentos <= CHIN_INTENTOS_MAX:
			SceneFade.timer(CHIN_REINTENTO_S, false).timeout.connect(
				_chin_empieza.bind(token))
			return
		for n: AnimatedSprite3D in [foco, _chin_socio]:
			if _anim_usable(n, "celebration"):
				_hold_celebration(n)
				n.play("celebration")
		_chin_socio = null
		return
	_chin_tira(foco, _chin_socio)
	_chin_tira(_chin_socio, foco)
	_cara(foco, "concentra", CHIN_MANO_S + CHIN_VEREDICTO_S)
	_cara(_chin_socio, "concentra", CHIN_MANO_S + CHIN_VEREDICTO_S)
	SceneFade.timer(CHIN_MANO_S, false).timeout.connect(
		_chin_manos.bind(token))





