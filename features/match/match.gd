func _puntero_ctx() -> String:
	return "%d|%d|%s|%s" % [state, _chance_seq, _cobro_corre, _saque_mando]




func _puntero_duenos() -> Array[int]:
	if _cobro_corre:
		return [_cobro_finger]
	if _saque_mando:
		return [_saque_dedo]
	match state:
		State.AIMING:
			return [_ring_finger, _drive_finger, _aim_finger if _aiming else -1,
				_order_finger, _orbit_finger]
		State.DUEL:
			return [_duel_finger]
	return []



func _puntero_ocupado() -> bool:
	for i in _puntero_duenos():
		if i != -1 and i != PUNTERO_DEDO:
			return true
	return false






func _puntero_quita() -> void:


	if not _puntero_tocando or _jala_on:
		return
	var cancela: bool = _puntero_apunta()
	_puntero_tocando = false
	_puntero_toque(false, cancela)




func _puntero_apunta() -> bool:
	if not _puntero_tocando:
		return false
	if _ring_finger == PUNTERO_DEDO:
		return not _ring_out
	if state == State.DUEL:
		return _duel_finger == PUNTERO_DEDO and _open_shot_aim
	return _aiming and _aim_finger == PUNTERO_DEDO






func _puntero_tirar_listo() -> bool:

	if _jala_corre:
		return state == State.AIMING and not _ring_dead(_jala_ancla - _jala_pos, _jala_fuerza)
	if not _puntero_apunta():
		return false
	var p: Vector2 = _puntero_pos
	if _ring_finger == PUNTERO_DEDO or state == State.DUEL:
		return not _ring_dead(_ring_start - p, _ring_pull_ratio(p))
	var pull: Vector2 = _aim_start - p
	return not _aim_dead(pull, _aim_ratio(pull, p))








func _puntero_potencia() -> float:
	if _jala_corre:
		return _jala_fuerza
	if not _puntero_apunta():
		return _jala_k()
	var p: Vector2 = _puntero_pos
	if _ring_finger == PUNTERO_DEDO or state == State.DUEL:
		return _ring_pull_ratio(p)
	return _aim_ratio(_aim_start - p, p)





func _puntero_tirar_cabe() -> bool:
	if _cobro_corre or _saque_mando:
		return false
	if state == State.DUEL:
		return not _duel_press and not _recu
	return state == State.AIMING


func _puntero_toque(bajado: bool, cancelado: bool = false) -> void:
