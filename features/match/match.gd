func _blanco_disco(r: float, col: Color, dz: float) -> MeshInstance3D:
	var m: MeshInstance3D = MeshInstance3D.new()
	var cm: CylinderMesh = CylinderMesh.new()
	cm.top_radius = r
	cm.bottom_radius = r
	cm.height = BLANCO_GROSOR
	cm.radial_segments = 18
	cm.rings = 0
	m.mesh = cm
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED


	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = col
	m.material_override = mat
	m.rotation_degrees = Vector3(90.0, 0.0, 0.0)
	m.position = Vector3(0.0, 0.0, dz)
	m.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return m























func _vaiven_fase(t: float, v_ini: float, v_fin: float, desde: float) -> float:
	if not _dianas_arrancado:
		return v_ini * t
	var total: float = maxf(1.0, float(_encargo.get("tries", 60)))
	var t0: float = _dianas_anim - _dianas_t
	var te: float = maxf(0.0, t - t0)
	var fase: float = v_ini * minf(t, t0)
	var quieto: float = clampf(desde, 0.0, 1.0) * total
	fase += v_ini * minf(te, quieto)
	if te > quieto:
		var largo: float = maxf(0.01, total - quieto)
		var s: float = minf(te, total) - quieto
		fase += v_ini * s +(v_fin - v_ini) * s * s /(2.0 * largo)
		if te > total:
			fase += v_fin *(te - total)
	return fase








func _blanco_pos_en(i: int, t: float) -> Vector2:
	if i < 0 or i >= _blancos_sitio.size():
		return Vector2.ZERO
	var d: Dictionary = _blancos_sitio[i]



	var fase: float = float(d["dir"]) \
			* _vaiven_fase(t, BLANCO_VEL_INI, BLANCO_VEL_FIN, 0.0) + float(d["fase"])
	var r: float = float(d["r"])


	var x: float = clampf(float(d["x"]) + sin(fase) * float(d["amp"]),
		- GOAL_HALF_W + r, GOAL_HALF_W - r)
	var y: float = clampf(float(d["y"]), r + 0.04, CROSSBAR_H - r)
	return Vector2(x, y)






func _blanco_vivo(i: int, t: float) -> bool:
	if i < 0 or i >= _blancos_sitio.size():
		return false
	var d: Dictionary = _blancos_sitio[i]
	var roto: float = float(d.get("roto", -1.0))
	if roto < 0.0:
		return true
	return t < roto or t >= float(d.get("vuelve", roto))















func _blancos_atrapa() -> void:
	_dianas_pts_balon = 0
	_dianas_diana_balon = -1
	_dianas_poste_balon = false
	if _traj.size() < 2 or _blancos_sitio.is_empty():
		return



	var paso: float = SIM_DT
	var mejor_g: int = -1
	var mejor_pts: int = 0
	var mejor_i: int = -1
	for i in range(1, _traj.size()):
		var a: Vector3 = _traj[i - 1]
		var b: Vector3 = _traj[i]
		if b.z >= a.z:
			continue
		for g in _blancos_sitio.size():
			var pz: float = float(_blancos_sitio[g]["z"])
			if a.z <= pz or b.z > pz:
				continue


			var f: float = clampf((a.z - pz) / maxf(0.0001, a.z - b.z), 0.0, 1.0)
			var t_cruce: float = _dianas_anim +(float(i - 1) + f) * paso
			if not _blanco_vivo(g, t_cruce):
				continue
			var p: Vector3 = a.lerp(b, f)
			var c: Vector2 = _blanco_pos_en(g, t_cruce)

			if Vector2(p.x, p.y).distance_to(c) > float(_blancos_sitio[g]["r"]) + BALL_R:
				continue
			if int(_blancos_sitio[g]["pts"]) > mejor_pts:
				mejor_pts = int(_blancos_sitio[g]["pts"])
				mejor_g = g
				mejor_i = i
	if mejor_g < 0:
		return
	_dianas_pts_balon = mejor_pts
	_dianas_diana_balon = mejor_g



	var t_roto: float = _dianas_anim + float(mejor_i) * paso
	_blancos_sitio[mejor_g]["roto"] = t_roto
	_blancos_sitio[mejor_g]["vuelve"] = t_roto + BLANCO_VUELVE





func _blanco_rompe(i: int) -> void:
	if i < 0 or i >= _blancos_nodos.size():
		return
	var n: Node3D = _blancos_nodos[i]
