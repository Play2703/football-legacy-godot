		return "barrera" if d - LINE_A_CEIL >= 9.15 + WALL_GAP else "zonal"








	var tac: float =(_tac_bloque - 0.5) * 2.0 * TAC_SHAPE_M
	var lo: float = 16.0 + tac + randf_range(- SHAPE_BLEND, SHAPE_BLEND)
