const CELU_TEL_DELANTE: float = 0.3


const CELU_POV_PASOS: int = 7
const CELU_POV_W: int = 540
const CELU_POV_H: int = 960
const CELU_POV_FOV: float = 62.0

const CELU_VISTAS_MIN: float = 0.8
const CELU_VISTAS_MAX: float = 3.6
const CELU_CUENTA_S: float = 1.5
const CELU_CARD_S: float = 2.6

const CELU_TARJETA_TRAS_S: float = 0.9


const CELU_CAIDO_GRADA_Y: float = 0.55

const CELU_TEL_SALTO: float = 1.8
const CELU_TEL_VUELO_S: float = 0.75

var _celu: AnimatedSprite3D = null
var _celu_rng: RandomNumberGenerator = RandomNumberGenerator.new()
var _celu_rolled: bool = false
var _celu_on: bool = false

var _celu_caido: bool = false


