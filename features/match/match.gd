		await _shoot_wait(1.1)
		if _shootout_over(mine, theirs, taken + 1, taken):
			taken += 1


			if taker_is_you and scored and mine > theirs:
				Achievements.ingest_shootout_winner()


			await _shootout_replay()
			break

		var their_taker: Dictionary = {} if their_takers.is_empty() \
				else their_takers[taken % their_takers.size()]
		_shootout_pre = {"mine": mine, "theirs": theirs, "taken": taken,
			"friendly": false}
		var r_scored: bool = await _shootout_sim_kick(false,
			_shootout_rival_scores(their_taker), their_takers, taken)
		last_side_mine = false
		last_scored = r_scored
		if r_scored:
			scorer_theirs = their_taker
			theirs += 1
			_stadium.crowd_react("away", "goal")
			_audio.ooh()
		else:








			match _shootout_last_outcome:
				"save":
					_hud.show_message(I18n.t("¡LO ATAJA TU PORTERO!"), UiKit.CYAN, 1.4)
