func _zonas_h_on() -> bool:
	var s: Vector2 = SceneFade.rect_visible(self).size
	return s.x > s.y




func _puntero_vivo() -> bool:
	if not _zonas_h_on() or _hud == null or _escena_sorda():
		return false
	if _cobro_corre or _saque_mando:
		return true
	match state:
		State.AIMING:

			return not _drive_beat
		State.DUEL, State.RESOLVED:
			return true
		State.STRIKING:


			return not _strike_locked
	return false










func _stick_izq_vivo() -> bool:
	if not _puntero_vivo():
		return false
	if _cobro_corre or _saque_mando or state != State.AIMING:
		return true
	return _drive_enabled or _trap_enabled



func _puntero_on() -> bool:
	return state == State.STRIKING and not _strike_locked and _zonas_h_on() and _hud != null













func _controles_dedo() -> bool:
	return (not Entrada.sin_dedo() or Entrada.raton_juega()) and not Entrada.hay_mando()




func _puntero_campo_on() -> bool:
	return _puntero_vivo() and not _puntero_on()





func _stick_input(event: InputEvent) -> bool:


	if event is InputEventScreenTouch and event.pressed:
		_dedos_tragados.erase(event.index)


		if event.index != PUNTERO_DEDO:
			_pad_suelta()
	if _golpear_input(event) or _modo_input(event) \
			or _stick_der_input(event) or _stick_izq_input(event):
		return true
	return _dedo_suelto_traga(event)




func _stick_izq_input(event: InputEvent) -> bool:
	if event is InputEventScreenTouch:
		var t: InputEventScreenTouch = event
		if t.index == PUNTERO_DEDO:
			return false
		if t.pressed:
			if _stick_finger != -1 or not _puntero_vivo() or not _stick_en_zona(t.position):
				return false




			var golpeo: bool = _puntero_on()
			if golpeo:
				if _ball_contact_at(t.position) != Vector2.INF \
						and not _stick_toca_base(t.position):
					return false
			elif _touch_in_drive_ring(t.position):
				return false
			_stick_finger = t.index


			_stick_base = t.position - _puntero_off * _stick_recorrido() if golpeo \
					else t.position
			_stick_v = t.position - _stick_base

			if not _stick_izq_vivo():
				return true
			_stick_pinta(t.position)
			if not golpeo:
				_puntero_posa()
			return true
		if t.index != _stick_finger:
			return false
		_stick_suelta()
		return true
	if event is InputEventScreenDrag and event.index == _stick_finger:
		var d: InputEventScreenDrag = event
		var v: Vector2 = d.position - _stick_base
		var recorrido: float = _stick_recorrido()
		if v.length() > recorrido:


			_stick_base = d.position - v.normalized() * recorrido
			v = v.normalized() * recorrido
		_stick_v = v
		if _stick_izq_vivo():
			_stick_pinta(_stick_base + v)
		if _puntero_on():
			_puntero_aplica(v)
		return true
	return false





func _puntero_aplica(v: Vector2) -> void:
	_puntero_off =(v / _stick_recorrido()).limit_length(1.0)






func _puntero_entra() -> void:
	_puntero_off = Vector2.ZERO
	_golpear_suelta()
	if _stick_finger != -1:
		_stick_base += _stick_v
		_stick_v = Vector2.ZERO
		if _stick_ui != null:
			_stick_ui.pon(_stick_base, _stick_base)






func _puntero_patea() -> void:
	if not _puntero_on():
		return
	var circle: Array = _strike_circle if _strike_circle.size() == 2 else _ball_screen_circle()
	if circle.size() != 2:
		return
	var ev: InputEventScreenTouch = InputEventScreenTouch.new()
	ev.index = PUNTERO_DEDO
	ev.pressed = true
	ev.position =(circle[0] as Vector2) + _puntero_off * float(circle[1])
	_handle_strike_input(ev)






func _golpear_input(event: InputEvent) -> bool:
	if event is InputEventScreenTouch:
		var t: InputEventScreenTouch = event
		if t.index == PUNTERO_DEDO:
			return false
		if t.pressed:
			if _golpear_finger != -1 or not _puntero_on() or not _stick_der_en_zona(t.position):
				return false










			if _ball_contact_at(t.position) != Vector2.INF and not _golpear_toca(t.position):
				return false
			_golpear_finger = t.index
			if _golpear_ui != null:
				_golpear_ui.pulsado = true


			_puntero_patea()
			return true
		if t.index != _golpear_finger:
			return false
		_golpear_suelta()
		return true
	return event is InputEventScreenDrag and event.index == _golpear_finger



func _golpear_suelta() -> void:
	_golpear_finger = -1
	if _golpear_ui != null:
		_golpear_ui.pulsado = false



func _golpear_candado() -> bool:
	return _serve_vivo and not _servicio_cita_abierta()






func _golpear_tick() -> void:
	var on: bool = _puntero_on()
	if _golpear_ui == null:
		if not on:
			return
		_golpear_ui = BOTON_GOLPEAR.new()
		_hud.add_child(_golpear_ui)
	_golpear_ui.visible = on and _controles_dedo()
	if not on:


		_golpear_ui.vela(false, BOTON_GOLPEAR.VELO_SALE_S)
		return
	_stick_der_crea()
	var candado: bool = _golpear_candado()

	_golpear_ui.cara(candado)
	_golpear_ui.alfa_k = Settings.mando_alfa_k()
	_golpear_ui.pon(_stick_der_ui.esquina(), GOLPEAR_R * _mando_k())

	_golpear_ui.vela(_golpear_pisado(), get_process_delta_time())













func _golpear_pisado() -> bool:
	if not _puntero_on() or _shot_cam == null or not is_instance_valid(_ball):
		return false
	_stick_der_crea()
	var disco: Array = _ball_screen_circle()
	var rp: float = float(disco[1]) * BALL_ART_R / BALL_R
	if rp <= 0.5:
		return false
	var r_btn: float = GOLPEAR_R * _mando_k() *(1.0 + BOTON_GOLPEAR.CANTO_K)
	return (disco[0] as Vector2).distance_to(_stick_der_ui.esquina()) \
			<= r_btn *(1.0 + GOLPEAR_VELO_HOLGURA_K) + rp







func _modo_input(event: InputEvent) -> bool:
	if event is InputEventScreenTouch:
		var t: InputEventScreenTouch = event
		if t.index == PUNTERO_DEDO:
			return false
		if t.pressed:
			if _modo_finger != -1 or not _modo_on() \
					or t.position.distance_to(_modo_centro()) > MODO_R * _mando_k() * MODO_TOQUE_K:
				return false

			if _touch_in_drive_ring(t.position):
				return false
			_modo_finger = t.index
			if _modo_ui != null:
				_modo_ui.pulsado = true
			_on_mode_toggle_requested()
			return true
		if t.index != _modo_finger:
			return false
		_modo_suelta()
		return true
	return event is InputEventScreenDrag and event.index == _modo_finger



func _modo_suelta() -> void:
	_modo_finger = -1
	if _modo_ui != null:
		_modo_ui.pulsado = false







func _modo_on() -> bool:
	if not _puntero_vivo() or not _puntero_tirar_cabe() or _no_se_centra():
		return false
	return state == State.AIMING or _duel_cross_allowed()














func _modo_centro() -> Vector2:
	_stick_der_crea()
	var ang: float = MODO_ANG if _stick_der_ui.a_la_derecha() else 180.0 - MODO_ANG
	var c: Vector2 = _stick_der_ui.esquina() + Vector2.from_angle(deg_to_rad(ang)) \
			*(JOYSTICK_TACTIL.BASE_R + MODO_HUECO + MODO_R) * _mando_k()
	if _hud == null:
		return c
	return Vector2(c.x, _hud.cam_chip_mid_y())





func _modo_tick() -> void:
	var on: bool = _modo_on()
	if _modo_ui == null:
		if not on:
			return
		_modo_ui = BOTON_MODO.new()

		Glifos.cuelga(_modo_ui, "fl_modo", CORNER_TOP_LEFT)
		_hud.add_child(_modo_ui)
	_modo_ui.visible = on
	if not on:
		return
	_modo_ui.cara(_cross_mode, _palabra_tiro())
	_modo_ui.alfa_k = Settings.mando_alfa_k()
	_modo_ui.pon(_modo_centro(), MODO_R * _mando_k())




func _golpear_toca(pos: Vector2) -> bool:
	_stick_der_crea()
	return pos.distance_to(_stick_der_ui.esquina()) <= GOLPEAR_R * _mando_k() * MODO_TOQUE_K



func _stick_toca_base(pos: Vector2) -> bool:
	return _stick_ui != null and pos.distance_to(_stick_ui.esquina()) <= _stick_ui.base_r()









func _dedo_suelto_traga(event: InputEvent) -> bool:
	if event is InputEventScreenDrag:
		return _dedos_tragados.has(event.index)
	if not (event is InputEventScreenTouch) or event.index == PUNTERO_DEDO:
		return false
	var t: InputEventScreenTouch = event
	if not t.pressed:
		if not _dedos_tragados.has(t.index):
			return false
		var foto: Dictionary = _dedos_tragados[t.index]
		_dedos_tragados.erase(t.index)
		if not t.canceled:
			_orden_tap_suelto(foto, t.position)
		return true
	if not _puntero_tocando or state == State.RESOLVED or _recu or not _puntero_vivo():
		return false
	_dedos_tragados[t.index] = {
		"actor": _actor_at(t.position) if _order_tap_candidate(t.position) else null,
		"pos": t.position, "ms": Time.get_ticks_msec(),
	}
	return true




func _orden_tap_suelto(foto: Dictionary, suelta: Vector2) -> void:
	var a = foto.get("actor")
	if a == null or not is_instance_valid(a) or not _teammate_actors.has(a):
		return
	if state != State.AIMING or _orders_locked or not _am_captain():
		return
	if Time.get_ticks_msec() - int(foto["ms"]) > ORDER_TAP_MS:
		return
	if suelta.distance_to(foto["pos"]) > ORDER_TAP_SLOP_PX:
		return
	_cycle_order(a)


func _stick_en_zona(pos: Vector2) -> bool:
	return _mando_franja(pos, Settings.mando_zurdo)





func _mando_franja(pos: Vector2, derecha: bool) -> bool:
	var s: Vector2 = SceneFade.rect_visible(self).size
	if pos.y <= s.y * STICK_ZONA_Y:
		return false
	return pos.x > s.x *(1.0 - STICK_ZONA_X) if derecha else pos.x < s.x * STICK_ZONA_X







func _stick_der_input(event: InputEvent) -> bool:
	if event is InputEventScreenTouch:
		var t: InputEventScreenTouch = event
		if t.index == PUNTERO_DEDO:
			return false
		if t.pressed:
			if _stick_der_finger != -1 or not _stick_der_puede() \
					or not _stick_der_en_zona(t.position):
				return false

			if _touch_in_drive_ring(t.position):
				return false
			_stick_der_finger = t.index
			_stick_der_base = t.position
			_stick_der_v = Vector2.ZERO
			_stick_der_ctx = _puntero_ctx()
			_stick_der_pinta()
			_jala_empieza()
			return true
		if t.index != _stick_der_finger:
			return false
		_stick_der_suelta(not t.canceled)
		return true
	if event is InputEventScreenDrag and event.index == _stick_der_finger:
		var d: InputEventScreenDrag = event
		var v: Vector2 = d.position - _stick_der_base
		var recorrido: float = _stick_recorrido()
		if v.length() > recorrido:


			_stick_der_base = d.position - v.normalized() * recorrido
			v = v.normalized() * recorrido
		_stick_der_v = v
		_stick_der_pinta()
		if _jala_on:
			_puntero_mueve()
		return true
	return false


func _stick_der_en_zona(pos: Vector2) -> bool:
	return _mando_franja(pos, not Settings.mando_zurdo)




func _stick_der_puede() -> bool:
	return _puntero_vivo() and _puntero_tirar_cabe() and not _puntero_ocupado()






func _stick_suelta() -> void:
	_stick_finger = -1
	_stick_v = Vector2.ZERO
	if _stick_ui != null:
		_stick_ui.suelta()
	_puntero_quita()




func _stick_der_suelta(tira: bool = false) -> void:
	_stick_der_finger = -1
	if _stick_der_ui != null:
		_stick_der_ui.suelta()


	if _jala_on:
		_jala_suelta(tira)
	_stick_der_v = Vector2.ZERO





func _jala_empieza() -> bool:
	if _jala_on or not _stick_der_puede():
		return false
	if not _puntero_tocando:
		_puntero_posa()
		if not _puntero_tocando:
			return false
	_jala_on = true
	_puntero_mueve()
	return true




func _jala_k() -> float:
	var zm: float = _stick_zona_muerta()
	return clampf((_stick_der_v.length() - zm) /(_stick_recorrido() - zm), 0.0, 1.0)







func _jala_desvio(pos: Vector2, rumbo: Vector3, ancla: Vector2 = Vector2.INF) -> float:
	if not ancla.is_finite():
		ancla = _ring_start if _ring_finger == PUNTERO_DEDO or state == State.DUEL \
				else _aim_start
	var pull: Vector2 = ancla - pos
	if pull.length_squared() < 1.0:
		return 0.0
	var sale: Vector3 = _world_aim_dir(pull.normalized(), _aim_guide_elev())
	return Vector2(sale.x, sale.z).angle_to(Vector2(rumbo.x, rumbo.z))







func _jala_px(jala: float) -> float:
	if not _puntero_apunta() or _aim_from_ring or _ring_finger == PUNTERO_DEDO \
			or state == State.DUEL:
		return -1.0
	return jala * PUNTERO_MESETA_R * MAX_PULL * _pull_scale()







func _jala_suelta(tira: bool) -> void:






	var corre: bool = _jala_corre and _jala_on and state == State.AIMING and _puntero_tocando \
			and _ring_finger == PUNTERO_DEDO
	if corre:
		_jala_corre_calcula()
	var dispara: bool = tira and _jala_on and _puntero_tirar_listo()
	var pull: Vector2 = _jala_ancla - _jala_pos
	var fuerza: float = _jala_fuerza
	_jala_on = false
	_jala_corre_apaga()
	if _stick_der_ui != null:
		_stick_der_ui.carga = -1.0
	if not _puntero_tocando:
		return
	if corre and dispara:
		_jala_corre_tira(pull, fuerza)
		return
	if not dispara and _stick_finger != -1 and _stick_izq_vivo() \
			and _puntero_ctx() == _puntero_posa_ctx:
		_puntero_mueve()
		return
	_puntero_tocando = false
	_puntero_toque(false, not dispara)








func _jala_corre_cabe() -> bool:
	if not _jala_on or _stick_finger == -1 or state != State.AIMING:
		return false
	if not _drive_enabled or _trap_active or _cobro_corre or _saque_mando:
		return false
	if not _puntero_tocando or _ring_finger != PUNTERO_DEDO or not _stick_izq_vivo():
		return false
	return _stick_v.length() > _stick_zona_muerta()




func _puntero_ejes() -> Array[Vector3]:
	var b: Basis = _aim_cam.global_transform.basis
	var der: Vector3 = Vector3(b.x.x, 0.0, b.x.z).normalized()
	var lejos: Vector3 = Vector3(- b.z.x, 0.0, - b.z.z)
	if lejos.length_squared() < 0.0001:
		lejos = Vector3(b.y.x, 0.0, b.y.z)
	return [der, lejos.normalized()]







func _jala_tiende(pie: Vector3, tiro: Vector3, jala: float,
		ancla: Vector2 = Vector2.INF) -> Vector3:
	var lejos_m: float = jala * PUNTERO_MESETA_R * _ring_world_r




	var px_obj: float = -1.0 if ancla.is_finite() else _jala_px(jala)
	var col: Vector2 = Vector2(tiro.x, tiro.z)
	var suelo: Vector3 = pie
	for _i in JALA_AJUSTES:
		suelo = pie - Vector3(col.x, 0.0, col.y) * lejos_m
		var pos: Vector2 = _aim_cam.unproject_position(suelo)
		var err: float = _jala_desvio(pos, tiro, ancla)
		var largo_ok: bool = true
		if px_obj > 0.0:
			var px: float =(_aim_start - pos).length()
			largo_ok = absf(px - px_obj) < 1.0
			lejos_m *= px_obj / maxf(px, 1.0)
		if absf(err) < 0.002 and largo_ok:
			break
		col = col.rotated(err)
	return suelo





func _jala_corre_calcula() -> void:
	var dir_j: Vector2 = _stick_der_v.normalized()
	var jala: float = _jala_k()
	var pie: Vector3 = _puntero_pie()
	_jala_ancla = _ring_screen_center()
	if pie != Vector3.INF and _aim_cam != null and not _aim_cam.is_position_behind(pie):
		var ejes: Array[Vector3] = _puntero_ejes()
		var tiro: Vector3 = -(ejes[0] * dir_j.x - ejes[1] * dir_j.y)
		_jala_suelo = _jala_tiende(pie, tiro, jala, _jala_ancla)
		_jala_pos = _aim_cam.unproject_position(_jala_suelo)

		_jala_fuerza = clampf(Vector2(_jala_suelo.x - pie.x, _jala_suelo.z - pie.z).length()
			/ maxf(_ring_world_r, 0.01), 0.0, 1.0)
		return

	_jala_suelo = Vector3.INF
	_jala_fuerza = jala * PUNTERO_MESETA_R
	_jala_pos = _jala_ancla + dir_j * _jala_fuerza * _ring_radius_px()






func _jala_corre_pinta() -> void:
	var pull: Vector2 = _jala_ancla - _jala_pos
	if _aim._advance:
		_aim.set_advance(false)
	if not _ring_shows(pull):
		_aim.hide_aim()
		return
	var frio: bool = _ring_dead(pull, _jala_fuerza)
	var dir3: Vector3 = _pase_iman(_world_aim_dir(pull.normalized(), _aim_guide_elev()))
	_aim.set_precision(_ctrl_precision())
	_feed_aim_launch()
	var origen: Vector3 = _aim_origin()
	_aim.set_cam_dist(_guia_cam_dist(origen))
