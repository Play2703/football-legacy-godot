func _pass_view_side() -> int:
	var me_x: float = _ball_field.x
	if is_instance_valid(_self_actor):
		me_x = _self_actor.position.x
	if absf(me_x) >= PASS_VIEW_FLIP_X:
		var nuevo: int = -1 if me_x > 0.0 else 1




		if _pass_side != 0 and nuevo != _pass_side and _pass_view \
				and state == State.DUEL and not _flip_freeze:
			_flip_congela()
		_pass_side = nuevo
		return _pass_side
	if _pass_side != 0:
		return _pass_side


	var peso: float = 0.0
	for a in _teammate_actors:
		if is_instance_valid(a):
			peso += a.position.x - me_x
	if absf(peso) < 0.5:
		peso = - me_x
	_pass_side = 1 if peso >= 0.0 else -1
	return _pass_side





func _pass_view_want() -> Array:
