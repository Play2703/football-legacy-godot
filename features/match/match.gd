func _mate_nation(ficha: Dictionary) -> String:


	if bool(ficha.get("is_you", false)) \
			or String(ficha.get("name", "")) == Career.player_name:
		return Career.nationality





	if _nat_match():
		return Career.nationality
	var team: String = _my_side_id()
	var who: String = String(ficha.get("name", ""))
	if not team.is_empty() and not who.is_empty():

		var squad: Array = Squad.home_of(team)
		for i in squad.size():
			if String((squad[i] as Dictionary).get("name", "")) == who:
				var meta: Array = Career._ensure_squad_meta(team, squad)
				if i < meta.size():
					var n: String = String((meta[i] as Dictionary).get("nation", ""))
					if not n.is_empty():
						return n
				break
	var c: String = Teams.country_of(team)
	return c if not c.is_empty() else Career.nationality






const FLICK_MIN_DIST: float = 5.5


const FLICK_RANGE: Vector2 = Vector2(2.5, 12.0)


const FLICK_P: float = 0.55


const FLICK_IMPROVE: float = 2.0
var _flick_done: bool = false

























func _placement_score(p: Vector2) -> float:
	return p.length() + 3.0 * absf(p.x) / maxf(p.y, 1.0)





func _ai_header_flick(kicker: AnimatedSprite3D) -> bool:
	if _flick_done or kicker == null or not is_instance_valid(kicker):
		return false
	var bp: Vector3 = _ball.position
	var here: Vector2 = Vector2(bp.x, bp.z)
	var dist_goal: float = here.length()


	var wide: bool = absf(bp.x) > maxf(bp.z, 1.0) * 0.9
	if dist_goal < FLICK_MIN_DIST and not wide:
		return false






	var last_def: float = _last_defender_z()
	var mi_score: float = _placement_score(here)
	var best: AnimatedSprite3D = null
	var best_score: float = mi_score - FLICK_IMPROVE
	for t in _teammate_actors:
		if not is_instance_valid(t) or t == kicker:
			continue
		var tp: Vector2 = Vector2(t.position.x, t.position.z)
		var d: float = tp.distance_to(here)
		if d < FLICK_RANGE.x or d > FLICK_RANGE.y:
			continue



		if last_def < INF and tp.y < minf(last_def, here.y) - 0.1:
			continue
		var sc: float = _placement_score(tp)
		if sc < best_score:
			best_score = sc
			best = t
	if best == null or randf() > FLICK_P:
		return false
	_flick_done = true


	_mate_kicker = null
	var target: Vector2 = Vector2(best.position.x, best.position.z)
	var quien: String = String(_finisher_of(kicker).get("name", ""))



	if not _is_you(kicker):
		_cuenta_accion_npc(false, quien, "pass")
	_hud.show_message(I18n.tf("¡Peina {0}!", [quien]) if not quien.is_empty()
		else I18n.t("¡La peina!"), CareerTheme.GOOD, 0.8)


	if is_instance_valid(kicker):
		var to_t: Vector3 = Vector3(target.x, 0.0, target.y) - Vector3(bp.x, 0.0, bp.z)
		var anim: String = "header_" + _dir_name(to_t)







		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + HEADER_GESTO_BUDGET_US)
		if not _gesto_listo(kicker, anim):
			anim = "kick_" + _dir_name(to_t)
		if _gesto_listo(kicker, anim):
			kicker.play(anim)
			_anim_lock[kicker] = Time.get_ticks_msec() + 500
			var base_y: float = kicker.position.y
			var jt: Tween = create_tween()
			jt.tween_property(kicker, "position:y", base_y + 0.5, 0.18) \
					.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
			jt.tween_property(kicker, "position:y", base_y, 0.28) \
					.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	_audio.kick()




	_snapshot_offside(bp.z, kicker)
	_keeper_reset()
	_cross_i = -1
	_net_hit = false
	_impact_sfx = false
	_ball.flip_h = false
	_ball.play("roll", 1.0)
	var d2: float = maxf(target.distance_to(here), 0.5)
	var tfly: float = clampf(d2 / 9.0, 0.3, 0.85)
	var vh: Vector2 =(target - here) / tfly
	var vy: float = 0.5 * 9.8 * tfly + 0.6

	_simulate_flight(Vector3(bp.x, maxf(bp.y - BALL_VISUAL_D * 0.5, 0.0), bp.z),
		Vector3(vh.x, vy, vh.y), 0.0)
	state = State.FLIGHT
	_traj_i = 0
	return true









