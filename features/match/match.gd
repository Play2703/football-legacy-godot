func _puntero_alcance(k: float) -> float:
	if k <= PUNTERO_K_BORDE:
		return k / PUNTERO_K_BORDE * PUNTERO_MESETA_R
	if k <= PUNTERO_K_SALE:
		return PUNTERO_MESETA_R
	return lerpf(PUNTERO_MESETA_R, PUNTERO_MAX_R,
		(k - PUNTERO_K_SALE) /(1.0 - PUNTERO_K_SALE))






func _puntero_radios(k: float) -> float:
	if not _puntero_tirar_cabe():
		return _puntero_alcance(k)
	if k <= 0.0 or not (state == State.DUEL or _ring_finger == PUNTERO_DEDO
			or _drive_finger == PUNTERO_DEDO):
		return 0.0
	return lerpf(PUNTERO_SALE_R, PUNTERO_MAX_R, k)









func _puntero_mueve() -> void:
	var antes: Vector2 = _puntero_pos
	var zm: float = _stick_zona_muerta()
	var largo: float = _stick_v.length()
	var k: float = clampf((largo - zm) /(_stick_recorrido() - zm), 0.0, 1.0)
	var dir: Vector2 = _stick_v / largo if largo > zm else Vector2.ZERO


	var corre: bool = _jala_corre_cabe()
	if corre != _jala_corre:
		if corre:
			_jala_corre = true
			_ring_live_dir = Vector2.ZERO


			if _hud != null:
				_hud.show_hint("")
		else:
			_jala_corre_apaga()
	var jala: float = _jala_k() if _jala_on and not corre else 0.0
	var dir_j: Vector2 = _stick_der_v.normalized()
	var pie: Vector3 = _puntero_pie()
	if pie != Vector3.INF and _aim_cam != null and not _aim_cam.is_position_behind(pie):



		var ejes: Array[Vector3] = _puntero_ejes()
		var der: Vector3 = ejes[0]
		var lejos: Vector3 = ejes[1]
		var rumbo: Vector3 = der * dir.x - lejos * dir.y
		if jala > 0.0:


			var tiro: Vector3 = -(der * dir_j.x - lejos * dir_j.y)





			_puntero_suelo = _jala_tiende(pie, tiro, jala)
		else:




			_puntero_suelo = pie - rumbo * _puntero_radios(k) * _ring_world_r
		_puntero_pos = _aim_cam.unproject_position(_puntero_suelo)
	else:


		_puntero_suelo = Vector3.INF
		var r_px: float = _puntero_radios(k) * _ring_radius_px()
		if jala > 0.0:
			r_px = _jala_px(jala) if _jala_px(jala) > 0.0 \
					else jala * PUNTERO_MESETA_R * _ring_radius_px()
		_puntero_pos = SceneFade.rect_visible(self).size * 0.5 \
				+(dir_j if jala > 0.0 else - dir) * r_px
	if _puntero_tocando and _puntero_pos != antes:



		if jala > 0.0:
			_soft_aim_clear()
		var ev: InputEventScreenDrag = InputEventScreenDrag.new()
		ev.index = PUNTERO_DEDO
		ev.position = _puntero_pos
		ev.relative = _puntero_pos - antes
		_unhandled_input(ev)


	if _jala_corre:
		_jala_corre_calcula()















