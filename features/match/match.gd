const CELEB_DUENDE_ALA_M: Vector2 = Vector2(0.75, 0.45)










const BOOT_KICK_HOLD: int = 700
const BOOT_FLIGHT: float = 1.2
const BOOT_ARC: float = 7.0

func _boot_ball_run(actor: AnimatedSprite3D) -> void:
	if _ball == null or not is_instance_valid(_ball):
		_start_celebration(actor)
		return


	var bp: Vector3 = _ball.position
	var fetch: Vector3 = Vector3(clampf(bp.x, - Stadium.GOAL_HALF_W, \
			Stadium.GOAL_HALF_W), actor.position.y, maxf(bp.z, 0.0) + 2.0)
	var speed: float = _celeb_run_speed(actor, _flat_dist(actor.position, fetch))
	_run_target[actor] = fetch
	_celeb_seal_run(actor, CELEB_RUN_MAX_S)
	_play_run(actor, fetch - actor.position)

	_celeb_focus_pos = fetch
	var tw: Tween = create_tween()
	tw.tween_property(actor, "position", fetch,
		maxf(_flat_dist(actor.position, fetch) / speed, 0.3))
	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return
		_run_target.erase(actor)


		if is_instance_valid(_ball):
			_ball.position = Vector3(actor.position.x, _ball.position.y,
				maxf(actor.position.z - 0.5, 0.2))
		_play_dir_gesture(actor, "kick", Vector2(0.0, -1.0), BOOT_KICK_HOLD)
		_audio.kick()
		_boot_ball_flight())

	tw.tween_interval(0.8)
	tw.tween_callback(_start_celebration.bind(actor))
	_celeb_runs.append(tw)



func _boot_ball_flight() -> void:
	if _ball == null or not is_instance_valid(_ball):
		return
	var from: Vector3 = _ball.position
	var to: Vector3 = Vector3(from.x + randf_range(-5.0, 5.0), 4.2, -11.0)
	var tw: Tween = create_tween()
	tw.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	tw.set_ignore_time_scale(true)
	tw.tween_method(func(t: float) -> void:
			if is_instance_valid(_ball):
				_ball.position = from.lerp(to, t) \
						+ Vector3(0.0, sin(t * PI) * BOOT_ARC, 0.0),
		0.0, 1.0, BOOT_FLIGHT)
	_celeb_runs.append(tw)



























const PRISA_CARRERA_S: float = 2.2
const PRISA_RECOGE_S: float = 0.35
const PRISA_CORTE_S: float = 0.9
const PRISA_LLEVA_M: float = 8.0
const PRISA_LLEVA_SPEED: float = 5.2
const PRISA_FOCO_M: float = 3.0
const PRISA_PIE_M: float = 0.55

const PRISA_REINTENTO_S: float = 0.4






var _celeb_a_por_balon: bool = false
var _prisa_viva: bool = false
var _prisa_token: int = 0


var _prisa_extra_dada: bool = false
var _prisa_extra_min: int = -1
var _prisa_extra_idx: int = -1

func _a_por_el_balon(actor: AnimatedSprite3D) -> void:
	if _ball == null or not is_instance_valid(_ball):

		if _prisa_viva:
			_prisa_programa(PRISA_CORTE_S)
		return
	var y: float = actor.position.y
	var bp: Vector3 = _ball.position



	var boca: Vector3 = Vector3(clampf(bp.x, -(Stadium.GOAL_HALF_W - 0.8),
		Stadium.GOAL_HALF_W - 0.8), y, 0.8)
	var fetch: Vector3 = Vector3(clampf(bp.x, -(Stadium.GOAL_HALF_W - 0.5),
		Stadium.GOAL_HALF_W - 0.5), y, clampf(bp.z, - NET_DEPTH + 0.5, -0.3))
	var carry_to: Vector3 = Vector3(fetch.x * 0.5, y, PRISA_LLEVA_M)
	var d1: float = _flat_dist(actor.position, boca)
	var d2: float = _flat_dist(boca, fetch)


	var speed: float = clampf((d1 + d2) / PRISA_CARRERA_S,
		_chaser_speed.get(actor, 3.36), FENCE_RUN_SPEED)
	var dur: float =(d1 + d2) / speed
	_run_target[actor] = boca
	_celeb_seal_run(actor, dur)
	_play_run(actor, boca - actor.position)



	_celeb_focus_pos = fetch + Vector3(0.0, 0.0, PRISA_FOCO_M)
	_celeb_destinos[actor] = fetch
	_celeb_run_sum += Vector2(carry_to.x - fetch.x, carry_to.z - fetch.z)
	_celeb_run_n += 1
	var tw: Tween = create_tween()


	tw.tween_callback(func() -> void:
		_celeb_seal_run(actor, dur))
	tw.tween_property(actor, "position", boca, maxf(d1 / speed, 0.15))
	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return
		_run_target[actor] = fetch
		_play_run(actor, fetch - actor.position))
	tw.tween_property(actor, "position", fetch, maxf(d2 / speed, 0.2))
	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return
		_run_target.erase(actor)
		actor.play("idle")
		if is_instance_valid(_ball):
			_ball.position = Vector3(actor.position.x, BALL_R,
				actor.position.z + PRISA_PIE_M)
			_ball_roll(Vector2.ZERO))
	tw.tween_interval(PRISA_RECOGE_S)
	tw.tween_callback(_prisa_lleva.bind(actor, carry_to))
	_celeb_runs.append(tw)





func _prisa_lleva(actor: AnimatedSprite3D, to: Vector3) -> void:
	if not is_instance_valid(actor):
		return
	if _prisa_viva:
		_prisa_programa(PRISA_CORTE_S)
	var desde: Vector3 = actor.position
	var dist: float = _flat_dist(desde, to)
	var dur: float = maxf(dist / PRISA_LLEVA_SPEED, 0.3)
	var tw: Tween = create_tween()
	if _balon_corre(actor):




		_run_target.erase(actor)
		_anim_lock[actor] = Time.get_ticks_msec() + int(dur * 1000.0) \
				+ CELEB_RUN_SEAL_PAD_MS
		if is_instance_valid(_ball):
			_ball.visible = false
		tw.tween_property(actor, "position", to, dur)
	else:

		var dir: Vector3 =(to - desde).normalized() if dist > 0.01 \
				else Vector3(0.0, 0.0, 1.0)
		_run_target[actor] = to
		_celeb_seal_run(actor, dur)
		_play_run(actor, to - desde)
		_ball_roll(Vector2(dir.x, dir.z) * PRISA_LLEVA_SPEED)
		tw.tween_method(func(t: float) -> void:
				if not is_instance_valid(actor):
					return
				actor.position = desde.lerp(to, t)
				if is_instance_valid(_ball):
					_ball.position = Vector3(actor.position.x + dir.x * PRISA_PIE_M,
						BALL_R, actor.position.z + dir.z * PRISA_PIE_M),
			0.0, 1.0, dur)


	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return
		_run_target.erase(actor)
		if _balon_al_brazo(actor):
			_anim_lock[actor] = Time.get_ticks_msec() + 60000
			if is_instance_valid(_ball):
				_ball.visible = false
		else:
			actor.play("idle")
			if is_instance_valid(_ball):
				_ball.visible = true
				_ball_roll(Vector2.ZERO))
	_celeb_runs.append(tw)







const PRISA_HOJA: String = "res://assets/sprites/anim/balon_run_south_"
const PRISA_ANIM: String = "balon_corre"
const PRISA_FPS: float = 12.0

func _balon_corre(actor: AnimatedSprite3D) -> bool:
	var frames: SpriteFrames = actor.sprite_frames
	if frames == null:
		return false
	if not frames.has_animation(PRISA_ANIM):
		var cfg: Dictionary = actor.get_meta("anim_cfg", {})
		var bases: PackedStringArray = PackedStringArray()
		for i in range(1, 9):
			var path: String = "%s%02d.png" % [PRISA_HOJA, i]
			if not ResourceLoader.exists(path):
				continue
			if bases.is_empty():
				frames.add_animation(PRISA_ANIM)
				frames.set_animation_loop(PRISA_ANIM, true)
				frames.set_animation_speed(PRISA_ANIM, PRISA_FPS)
			frames.add_frame(PRISA_ANIM, KitRecolor.apply(load(path), cfg))
			bases.append(path.get_file().get_basename())
		if bases.is_empty():
			return false
		PechoRig.apunta(frames, bases, PRISA_ANIM)
	actor.flip_h = false
	actor.speed_scale = 1.0
	actor.play(PRISA_ANIM)
	return true






