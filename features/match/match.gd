	var techo: float = maxf(_recep_contacto.y, 2.0) + RECEP_CIELO_M
	return [p - der, p + der, p + Vector3.UP * 2.1, _recep_contacto,
		Vector3(_recep_contacto.x, techo, _recep_contacto.z)]






func _recep_plano(dt_real: float, ver_todo: Array[Vector3], corte: bool = false) -> void:
	if _recep_cam == null or not _recep_cam.current:
		return
	var f3: Vector3 = Vector3(_recep_f.x, 0.0, _recep_f.y)
	var r3: Vector3 = f3.cross(Vector3.UP)
	var c: Vector3 = _recep_ojo
	var ver: Array[Vector3] = []
	for q in ver_todo:
		if (q - c).dot(f3) > RECEP_CAM_DELANTE_M:
			ver.append(q)
	if ver.is_empty():
		return
	var yaw: Vector2 = Vector2(INF, - INF)
	var pitch: Vector2 = Vector2(INF, - INF)
	for q in ver:
		var d: Vector3 = q - c
		var fw: float = maxf(d.dot(f3), 0.1)
		var rt: float = d.dot(r3)
		var ya: float = atan2(rt, fw)
		var pa: float = atan2(d.y, Vector2(fw, rt).length())
		yaw = Vector2(minf(yaw.x, ya), maxf(yaw.y, ya))
		pitch = Vector2(minf(pitch.x, pa), maxf(pitch.y, pa))
	var y_c: float =(yaw.x + yaw.y) * 0.5
	var p_c: float =(pitch.x + pitch.y) * 0.5
	var mira: Vector3 =(f3 * cos(y_c) + r3 * sin(y_c)) * cos(p_c) + Vector3.UP * sin(p_c)
	var vp: Vector2 = SceneFade.rect_visible(self).size
	var aspecto: float = maxf(vp.x / maxf(vp.y, 1.0), 0.1)
	var m: float = deg_to_rad(RECEP_MARGEN_DEG)
	var medio_v: float = maxf((pitch.y - pitch.x) * 0.5 + m,
		atan(tan(minf((yaw.y - yaw.x) * 0.5 + m, 1.4)) / aspecto))
	var fov: float = clampf(rad_to_deg(medio_v * 2.0), RECEP_FOV.x, RECEP_FOV.y)
	var meta: Transform3D = Transform3D(Basis(), c).looking_at(c + mira, Vector3.UP)
	if corte:
		_recep_cam.global_transform = meta
		_recep_cam.fov = fov
		return
	var k: float = 1.0 - exp(- RECEP_CAM_K * dt_real)
	_recep_cam.global_transform = _recep_cam.global_transform.interpolate_with(meta, k)



	_recep_cam.global_position = c
	_recep_cam.fov = lerpf(_recep_cam.fov, fov, k)








func _recep_vuelta(gen: int, sitio: Vector2,
		pts: PackedVector3Array = PackedVector3Array(), caza: int = -1) -> bool:
	var juego: Camera3D = _recep_juego
	var dur: float = maxf(float(pts.size() - 1) / 60.0, 0.0)
	var tc: float = 0.0
	if _recep_cam == null or not _recep_cam.current or not is_instance_valid(juego):
		_recep_suelta_cam()
		if not pts.is_empty():
			_ball.position = pts[pts.size() - 1]
		return _recep_sigue(gen)
	var desde: Transform3D = _recep_cam.global_transform
	var fov0: float = _recep_cam.fov
	var yo: AnimatedSprite3D = _self_actor
	var pecho: Vector3 = Vector3(yo.position.x, 1.1, yo.position.z)
	var t: float = 0.0
	while t < CANO_VUELTA_S or tc < dur:
		await get_tree().physics_frame
		if not _recep_sigue(gen):
			return false
		var dt: float = get_physics_process_delta_time() if can_process() else 0.0
		t += dt / maxf(Engine.time_scale, 0.01)
		tc += dt
		if dur > 0.0:
			_pecho_muestra(minf(tc / dur, 1.0), pts)
		_recep_caza(caza, dt)
		var k: float = smoothstep(0.0, 1.0, clampf(t / CANO_VUELTA_S, 0.0, 1.0))
		if k >= RECEP_ASOMA_K:
			_recep_destapa()
		if is_instance_valid(juego):
			var fin: Transform3D = juego.global_transform
			var meta: Vector3 = fin.origin - fin.basis.z * maxf(fin.origin.distance_to(pecho), 1.0)
			var pos: Vector3 = desde.origin.lerp(fin.origin, k) \
					+ Vector3.UP * sin(PI * k) * RECEP_VUELTA_ARCO_M
			var mira: Vector3 = pecho.lerp(meta, k)
			var tr: Transform3D = desde
			if pos.distance_to(mira) > 0.1:
				tr = Transform3D(Basis(), pos).looking_at(mira, Vector3.UP)
			_recep_cam.global_transform = tr.interpolate_with(fin,
				smoothstep(RECEP_VUELTA_FUNDE, 1.0, k))
			_recep_cam.fov = lerpf(fov0, juego.fov, k)
		_recep_vive(dt, sitio)
	_recep_suelta_cam()
	return true



func _recep_caza(caza: int, dt: float) -> void:
	if caza < 0 or caza >= _rival_actors.size() or caza >= _defender_pos.size() \
			or not is_instance_valid(_rival_actors[caza]):
		return
	var a: AnimatedSprite3D = _rival_actors[caza]
	var hacia: Vector2 = Vector2(_ball.position.x, _ball.position.z) - _defender_pos[caza]
	if hacia.length() <= 0.5:
		return
	var q: Vector2 = _defender_pos[caza] + hacia.normalized() * minf(RECEP_CAZA_V * dt, hacia.length())
	_defender_pos[caza] = q
	a.position.x = q.x
	a.position.z = q.y
	_play_run(a, Vector3(hacia.x, 0.0, hacia.y))



func _recep_suelta_cam() -> void:
	_recep_destapa()
	_recep_foco = null
	_recep_perfil.clear()
	if _recep_cam != null:
		_recep_cam.h_offset = 0.0
		_recep_cam.v_offset = 0.0
		if _fx != null and _fx.cam == _recep_cam:
			_fx.cam = _recep_fx_cam
	if _recep_cam == null or not _recep_cam.current:
		return
	_recep_cam.current = false
	if is_instance_valid(_recep_juego):
		_recep_juego.current = true
	_cam_base_frame = -1




