			else (_tanda_dif if _tanda_dif != 0 else dif))
















func goles_del_partido() -> Array[Dictionary]:
	var goles: Array[Dictionary] = _sim_screen.goles()
	if not _goal_note.is_empty() and not bool(_goal_note.get("fallo", false)):
		var contra: bool = bool(_goal_note.get("contra", false))



		var scorer_n: String = String(_goal_note.get("scorer", ""))
		var asis_n: String = String(_goal_note.get("asistencia", ""))
		goles.append({"min": int(_goal_note.get("minute", -1)), "extra": 0,
			"name": scorer_n, "lado": 1 if contra else 0,
			"asist": asis_n if asis_n != scorer_n else "",
			"rid": _goal_seq if not contra and _goal_clip != null \
					and String(_goal_note.get("cedida", "")).is_empty() else -1})
	var marcador: Array[int] = [team_goals, rival_goals]
	var cuenta: Array[int] = [0, 0]
	var out: Array[Dictionary] = []
	for g in goles:
		var lado: int = clampi(int(g.get("lado", 0)), 0, 1)
		if cuenta[lado] >= marcador[lado]:
			continue
		cuenta[lado] += 1
		if int(g.get("rid", -1)) > 0 and not _goal_clips.has(int(g["rid"])):
			g["rid"] = -1
		out.append(g)
	for lado in [0, 1]:
		for i in range(cuenta[lado], marcador[lado]):
			out.append({"min": -1, "extra": 0, "name": "", "asist": "", "lado": lado,
				"rid": -1})
	return out










