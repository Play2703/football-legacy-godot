static func _parte_portero(anim: String, u: float, h: float) -> Dictionary:
	var bola: Vector2 = Vector2(u, h)
	var mejor: Dictionary = {"parte": "alcance", "b": 1.0, "lado": Vector2.ZERO}
	var dmin: float = INF
	for c: Array in KEEPER_PARTES.get(anim, []):
		var a: Vector2 = Vector2(float(c[1]), float(c[2]))
		var s: Vector2 = Vector2(float(c[3]), float(c[4])) - a
		var t: float = 0.0 if s.length_squared() <= 0.0 \
				else clampf((bola - a).dot(s) / s.length_squared(), 0.0, 1.0)
		var off: Vector2 = bola -(a + s * t)
		var r: float = float(c[5])
		var d: float = off.length() - r
		var p: String = String(c[0])
		if d >(KEEPER_CABEZA_HUECO if p == "cabeza" else BALL_R):
			continue
		if p == "guante":
			d -= KEEPER_GUANTE_VENTAJA
		if d < dmin:
			dmin = d
			mejor = {"parte": p, "b": clampf(off.length() /(r + BALL_R), 0.0, 1.0),
				"lado": off}
	return mejor





static func _portero_normal(vel: Vector3, lado: Vector3, b: float, ny: float,
		k: float) -> Vector3:
	var f: Vector3 = - vel.normalized() if vel.length() > 0.001 else Vector3.BACK
	var sd: Vector3 = lado - f * lado.dot(f)
	sd = sd.normalized() if sd.length() > 0.001 else f.cross(Vector3.UP).normalized()
	var th: float = asin(clampf(b * k, 0.0, 1.0))
	return (f * cos(th) + sd * sin(th) + Vector3.UP * ny).normalized()











func _parada_por_parte(anim: String, ex: float, ey: float, dxk: float, dive_x: float,
		bola: Vector2, vel: Vector3, spin: float, back: float) -> Dictionary:
	if not keeper_partes:
		return {"parte": "guante", "tipo": "guante"}
	var c: Vector3 = _save_cover(anim)
	var lado: float = 1.0 if dxk >= 0.0 else -1.0
	var k: Dictionary = _parte_portero(anim, ex * c.y * lado, c.x + ey * c.z)
	if parada_traza:
		parada_traza_ultima = {"anim": anim, "ex": ex, "ey": ey, "dxk": dxk, "dive_x": dive_x,
			"lado": lado, "x": ex * c.y * lado, "y": c.x + ey * c.z, "parte_caps": k["parte"]}
	var parte: String = String(k["parte"])
	var off: Vector2 = k["lado"]
	var lado_m: Vector3 = Vector3(lado * off.x, off.y, 0.0)
	var b: float = float(k["b"])



	var pie: String = _pinta_pie(anim, dxk, dive_x, bola)
	if not pie.is_empty() and _keeper.sprite_frames.has_animation(pie):
		parte = "pie"
		lado_m = Vector3(signf(bola.x - dive_x), 0.0, 0.0)
		b = clampf(absf(bola.x - dive_x) /(float(SAVE_PIE_ALCANCE[pie]) + BALL_R), 0.0, 1.0)
	if parte == "guante" or parte == "alcance":
		return {"parte": parte, "tipo": "guante"}
	if parte == "torso":
		return {"parte": parte, "tipo": "pecho"}
	var como: String = String(KEEPER_PARTE_COMO[parte])
	var ep: Array = DESV_PARTES[como] if DESV_PARTES.has(como) else BARRERA_PARTES[como]
	var n: Vector3 = _portero_normal(vel, lado_m, b, float(ep[1]),
		BARRERA_NORMAL_K if parte == "cabeza" else DESV_NORMAL_K)
	var r: Dictionary = _desv_respuesta(vel, spin, back, n, float(ep[0]), false, 1.0)


	if String(r["tipo"]) == "desvio":
		return {"parte": parte, "tipo": "guante"}


	var out: Vector3 = r["vel"]
	out.z = absf(out.z)
	return {"parte": parte, "tipo": "cuerpo", "vel": out, "spin": float(r["spin"]),
		"back": float(r["back"])}














func _pecho_dos_tiempos(anim: String, dxk: float, dive_x: float, kz: float,
		vel: Vector3) -> void:
	var p0: Vector3 = _traj[_traj.size() - 1]
	_pecho_i = _traj.size() - 1
	var hacia: float = 1.0 if vel.z < 0.0 else -1.0
	var fin: Vector3 = Vector3(p0.x, 0.0, kz + hacia * PECHO_DELANTE_PIES)
	if PECHO_MANOS.has(anim):
		fin = Vector3(dive_x +(1.0 if dxk >= 0.0 else -1.0) * float(PECHO_MANOS[anim]), 0.0,
			kz + hacia * BLOCAJE_DELANTE)
	var y0: float = maxf(p0.y, 0.0)
	var t: float =(PECHO_SUBE_VY + sqrt(PECHO_SUBE_VY * PECHO_SUBE_VY + 2.0 * 9.8 * y0)) / 9.8
	var n: int = maxi(ceili(t / SIM_DT), 1)
	for i in range(1, n + 1):
		var s: float = minf(float(i) * SIM_DT, t)
		var p: Vector3 = p0.lerp(fin, s / t)
		p.y = maxf(y0 + PECHO_SUBE_VY * s - 0.5 * 9.8 * s * s, 0.0)
		_traj.append(p)
	_stop_i = _traj.size() - 1


