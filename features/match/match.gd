func _glide_aim_camera(from_pos: Vector3, from_basis: Basis, from_fov: float) -> void:
	_kill_handoff_glide()
	if _aim_cam == null or Settings.reduce_motion:
		return
	var to_pos: Vector3 = _aim_cam.global_position
	var to_basis: Basis = _aim_cam.global_transform.basis
	var to_fov: float = _aim_cam.fov


	_handoff_glide_to = Transform3D(to_basis, to_pos)
	_handoff_glide_to_fov = to_fov
	_aim_cam.global_position = from_pos
	_aim_cam.global_transform.basis = from_basis
	_aim_cam.fov = from_fov
	var tw: Tween = create_tween().set_parallel(true)
	_handoff_cam_tw = tw
	var dur: float = HANDOFF_GLIDE_T
	tw.tween_property(_aim_cam, "global_position", to_pos, dur) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.tween_method(func(k: float) -> void:
			if is_instance_valid(_aim_cam):
				_aim_cam.global_transform.basis = \
						from_basis.slerp(to_basis, k).orthonormalized(),
		0.0, 1.0, dur).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.tween_property(_aim_cam, "fov", to_fov, dur) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)

















func _kill_handoff_glide() -> void:
	if _handoff_cam_tw and _handoff_cam_tw.is_valid():
		_handoff_cam_tw.kill()
		if _aim_cam != null:
			_aim_cam.global_transform = _handoff_glide_to
			_aim_cam.fov = _handoff_glide_to_fov
	if _handoff_ball_tw and _handoff_ball_tw.is_valid():
		_handoff_ball_tw.kill()
		if _ball != null:
			_ball.position = _handoff_ball_to






















