func _red_por_fuera_al_paso() -> void:
	if _net_hit or _traj_i <= 0 or _traj_i >= _traj.size():
		return
	var toque: Vector3 = _net_outside_touch(_traj[_traj_i - 1], _traj[_traj_i])
	if toque == Vector3.INF and _net_out_ix >= 0 and _traj_i >= _net_out_ix:
		toque = _net_out_p
	if toque == Vector3.INF:
		return
	_net_hit = true
	_net_hit_p = toque + Vector3(0.0, BALL_VISUAL_D * 0.5, 0.0)
	_stadium.net_impact(_net_hit_p)


	_splash_at(Vector2(toque.x, maxf(toque.z, 0.0)), Vector3.ZERO, 9.0)


	_audio.net()







const NET_DEPTH: float = Stadium.NET_DEPTH












const OWN_GOAL_Z: float = Stadium.FIELD_DEPTH






const OWN_GOAL_REACH_K: float = 0.085









const OWN_GOAL_KEEPER_ZONE_M: float = 30.0

const KEEPER_FOOT_SPD: float = 12.0



const KEEPER_FOOT_EXTRA_M: float = 1.6














const NET_GRAZE: float = 0.7



























func _net_outside_touch(a: Vector3, b: Vector3, graze: float = NET_GRAZE) -> Vector3:
	var z0: float = - NET_DEPTH

	if a.y > CROSSBAR_H and b.y <= CROSSBAR_H:
		var t: float =(a.y - CROSSBAR_H) / maxf(a.y - b.y, 0.0001)
		var p: Vector3 = a.lerp(b, clampf(t, 0.0, 1.0))
		if absf(p.x) <= GOAL_HALF_W and p.z <= 0.0 and p.z >= z0:
			return p

	if a.z < z0 and b.z >= z0:
		var t2: float =(z0 - a.z) / maxf(b.z - a.z, 0.0001)
		var p2: Vector3 = a.lerp(b, clampf(t2, 0.0, 1.0))
		if absf(p2.x) <= GOAL_HALF_W and p2.y <= CROSSBAR_H:
			return p2

	for side in [-1.0, 1.0]:
		var sx: float = side * GOAL_HALF_W
		var fuera_a: float =(a.x - sx) * side
		var fuera_b: float =(b.x - sx) * side
		if b.z > 0.0 or b.z < z0 or b.y > CROSSBAR_H:
			continue
		if fuera_a > 0.0 and fuera_b <= 0.0:
			var t3: float = fuera_a / maxf(fuera_a - fuera_b, 0.0001)
			return a.lerp(b, clampf(t3, 0.0, 1.0))

		if fuera_b >= 0.0 and fuera_b <= graze:
			return Vector3(sx, b.y, b.z)
	return Vector3.INF








func _check_impact_sfx() -> void:
	_check_damage_events()






	while _post_sfx < _post_ix.size() and _traj_i >= _post_ix[_post_sfx]:












		var pix: int = _post_ix[_post_sfx]
		var punch: float = _tube_punch(pix)





		if pix >= 0 and pix < _traj.size() and absf(_traj[pix].z) <= 2.0:
			_tube_hit_p = _traj[pix]
			_tube_hit_bar = _post_bar
			_tube_hit_punch = punch
			_tube_hit_fly = float(pix) * SIM_DT
			_tube_hit_ms = Time.get_ticks_msec()
		_audio.post(false, punch)
		_fx.shake((0.25 if _post_sfx == 0 else 0.16) * punch)







		if _ball != null and is_instance_valid(_ball) and pix > 1 and pix < _traj.size():
			_fx.punch_scale(_ball, _traj[pix - 1] - _traj[pix - 2])
		if pix >= 0 and pix < _traj.size():




			_stadium.post_impact(_traj[pix],
				punch *(1.0 if _post_sfx == 0 else 0.7), false, 1.0,
				1 if _post_bar else 0)




			_splash_at(Vector2(_traj[pix].x, maxf(_traj[pix].z, 0.0)),
				Vector3.ZERO, 12.0 * punch)
		_post_sfx += 1




	while _graze_sfx < _graze_ix.size() and _traj_i >= _graze_ix[_graze_sfx]:
		_audio.post(true)
		var gix: int = _graze_ix[_graze_sfx]
		if gix >= 0 and gix < _traj.size():
			_stadium.post_impact(_traj[gix], 0.4)
		_graze_sfx += 1







	var hit_i: int = _cross_i
	if _outcome == "save" and _cross_i < 0 and _keeper_out_i >= 0:
		hit_i = _keeper_out_i
	if _impact_sfx or hit_i < 0 or _traj_i < hit_i:
		return
	if _outcome == "post":
		_impact_sfx = true
	elif _outcome == "save" and _cross_i < 0:


		_impact_sfx = true
		if _parada_mi_arco == "pie" or _parada_con_bota():
			_audio.kick()
		else:


			var anim_out: String = String(_keeper.get_meta("save_anim", "")) \
					if _keeper else ""
			_audio.save(anim_out == "catch" or anim_out == "jump_catch")
	elif _outcome == "save":
		_impact_sfx = true


		var anim: String = String(_keeper.get_meta("save_anim", "")) if _keeper else ""
		if _parada_con_bota():
			_audio.kick()
		else:
			_audio.save(anim == "catch" or anim == "jump_catch")







		if _voz_del_fallo() == "animo":
			_audio.voz_tras("animo", 0.45)
























		var grande: float = clampf(_shot_pace * 0.6 + _save_edge * 0.4, 0.0, 1.0)
		_fx.hit_stop(lerpf(SAVE_STOP_SOFT, SAVE_STOP_HARD, grande),
			lerpf(0.04, SAVE_STOP_HOLD, grande),
			lerpf(0.2, SAVE_STOP_RECOVER, grande))





		if _cross_i >= 0 and _cross_i < _traj.size():
			var manos: Vector3 = _traj[_cross_i]
			if _keeper != null and is_instance_valid(_keeper):
				manos.x = _keeper.get_meta("dive_x", manos.x)
			_fx.glove_burst(manos)




			if _keeper != null and is_instance_valid(_keeper):
				_splash_at(Vector2(manos.x, _keeper.position.z),
					Vector3(manos.x - _keeper.position.x, 0.0, 1.0), 13.0)




			if _ball != null and is_instance_valid(_ball) and _cross_i > 0:
				_fx.punch_scale(_ball, _traj[_cross_i] - _traj[_cross_i - 1])





















