func _cam_tap_candidate(pos: Vector2) -> bool:
	if state != State.AIMING or not _pass_view_allowed():
		return false
	if not (_drive_enabled or _trap_enabled or _ring_gauge):
		return false
	return _actor_at(pos) == null


func _order_tap_candidate(pos: Vector2) -> bool:
	if state != State.AIMING or _orders_locked or not _am_captain():
		return false
	var a: AnimatedSprite3D = _actor_at(pos)
	return a != null and _teammate_actors.has(a)





func _maybe_order_tap(release_pos: Vector2) -> void:
	if state != State.AIMING or _orders_locked or not _am_captain():
		return
	if _tag_press_actor == null or not is_instance_valid(_tag_press_actor) \
			or not _teammate_actors.has(_tag_press_actor):
		return
	if Time.get_ticks_msec() - _tag_press_ms > ORDER_TAP_MS:
		return
	if release_pos.distance_to(_tag_press_pos) > ORDER_TAP_SLOP_PX:
		return
	_cycle_order(_tag_press_actor)





func _cycle_order(a: AnimatedSprite3D) -> void:
	var cur: int = int(_mate_orders.get(a, ORDER_NONE))
	var nxt: int =(cur + 1) % 4
	if cur == ORDER_NONE and _mate_orders.size() >= ORDER_MAX:
		return
	_undo_order(a)





	_offer_olvida(a)
	if _anim_lock.get(a, 0) <= Time.get_ticks_msec():
		_face_ball(a)
	if nxt == ORDER_NONE:
		_mate_orders.erase(a)
	else:
		_mate_orders[a] = nxt
		if nxt == ORDER_STAY:
			a.set_meta("order_stay", true)
		elif nxt == ORDER_DRAG:




			a.set_meta("order_dest", _order_drag_target(a))
	_order_dress(a, nxt)

	UiAudio.pop()




func _undo_order(a: AnimatedSprite3D) -> void:
	for m in ["order_drag_rival", "order_drag_cover"]:
		var r: Variant =(a.get_meta(m) if a.has_meta(m) else null)
		if r != null and is_instance_valid(r):
			_run_target.erase(r)
			_order_release(r)
	for meta in ["order_stay", "order_dest", "order_fired", "order_drag_rival",
			"order_drag_cover", "order_run", "order_paused"]:
		if a.has_meta(meta):
			a.remove_meta(meta)
	if _order_tweens.has(a):
		for tw in _order_tweens[a]:
			if tw != null and tw.is_valid():
				tw.kill()
		_order_tweens.erase(a)
	if _order_paths.has(a):
		var path: Node3D = _order_paths[a]
		if is_instance_valid(path):
			path.queue_free()
		_order_paths.erase(a)
	_run_target.erase(a)






func _order_dress(a: AnimatedSprite3D, order: int) -> void:
	for n in ["OrderRing", "OrderIcon"]:
		if a.has_node(n):
			a.get_node(n).queue_free()
	if order == ORDER_NONE:
		return
	var col: Color = OrderArt.COLORS[order]
	var ring: MeshInstance3D = MeshInstance3D.new()
	ring.name = "OrderRing"
	var qm: QuadMesh = QuadMesh.new()


	qm.size = Vector2(1.7, 1.7)
	ring.mesh = qm
	ring.rotation_degrees = Vector3(-90.0, 0.0, 0.0)
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST


	mat.albedo_texture = OrderArt.ring_tex()
	mat.albedo_color = col
	ring.material_override = mat


	ring.position = Vector3(0.0, - a.position.y + 0.03, 0.0)
	a.add_child(ring)
	var icon: Sprite3D = Sprite3D.new()
	icon.name = "OrderIcon"
	icon.texture = OrderArt.glyph_tex(order)
	icon.modulate = col


	icon.pixel_size = 0.036
	icon.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	icon.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	icon.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	icon.no_depth_test = true
	icon.render_priority = 3
	icon.position = Vector3(0.0, 2.42 - a.position.y, 0.0)
	a.add_child(icon)


	if order == ORDER_RUN:
		_order_path_draw(a, _order_run_target(a), col)
	elif order == ORDER_DRAG:
		_order_path_draw(a, a.get_meta("order_dest", a.position), col)






func _order_path_draw(a: AnimatedSprite3D, to: Vector3, col: Color) -> void:
	if _order_paths.has(a) and is_instance_valid(_order_paths[a]):
		_order_paths[a].queue_free()
	var root: Node3D = Node3D.new()
	var from: Vector3 = Vector3(a.position.x, 0.04, a.position.z)
	var dest: Vector3 = Vector3(to.x, 0.04, to.z)
	var n: int = clampi(int(from.distance_to(dest) / 1.1), 3, 12)
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.albedo_color = col
	for i in n:
		var t: float = float(i + 1) / float(n)
		var dot: MeshInstance3D = MeshInstance3D.new()
		var qm: QuadMesh = QuadMesh.new()

		qm.size = Vector2(0.42, 0.42) if i == n - 1 else Vector2(0.2, 0.2)
		dot.mesh = qm
		dot.rotation_degrees = Vector3(-90.0, 0.0, 0.0)
		dot.material_override = mat
		dot.position = from.lerp(dest, t)


		dot.set_meta("path_t", t)
		root.add_child(dot)
	_actors.add_child(root)
	_order_paths[a] = root





func _order_run_target(a: AnimatedSprite3D) -> Vector3:
	return Vector3(a.position.x * 0.55, a.position.y,
		maxf(a.position.z - ORDER_RUN_DEPTH_M, 3.0))






func _order_drag_target(a: AnimatedSprite3D) -> Vector3:
	var side: float = signf(a.position.x) if absf(a.position.x) > 0.5 \
			else (1.0 if randf() < 0.5 else -1.0)
	return Vector3(
		clampf(a.position.x + side * ORDER_DRAG_ASIDE_M,
			- Stadium.FIELD_HALF_W + 1.5, Stadium.FIELD_HALF_W - 1.5),
		a.position.y, a.position.z + 1.5)







func _order_path_trim(progress: float, a: AnimatedSprite3D) -> void:
	if not _order_paths.has(a):
		return
	var root: Node3D = _order_paths[a]
	if not is_instance_valid(root):
		return
	for dot in root.get_children():
		if float(dot.get_meta("path_t", 2.0)) <= progress:
			dot.visible = false






















func _order_owned(a: Object) -> bool:
	return a != null and is_instance_valid(a) \
			and (a as Node).has_meta("order_run")
















func _order_holds(a: Object) -> bool:
	if _order_owned(a):
		return true
	if a == null or not is_instance_valid(a):
		return false
	var n: Node = a as Node
	return n.has_meta("order_stay") \
			or (_mate_orders.has(a) and not n.has_meta("order_fired"))










