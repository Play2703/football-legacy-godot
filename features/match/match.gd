func _snapshot_offside(ball_z: float, passer: AnimatedSprite3D = null) -> void:
	_offside_teammates.clear()
	_offside_line_at_kick = INF

	_offside_de_tu_bota = passer == null or (passer == _self_actor and not _cobro_corre)




	if _meta_saca():
		return
	var linea: float = _linea_pitada_z()
	if linea == INF:
		return


	_offside_line_at_kick = linea
	for t in _teammate_actors:
		if t == passer or not is_instance_valid(t):
			continue


















		if _en_posicion_adelantada(t.position.z, linea, ball_z):
			_offside_teammates[t] = true
	var sueltos: Array[AnimatedSprite3D] = [_self_actor]
	if _cobro_corre and _cedida_yo != null:
		sueltos.append(_cedida_yo)
	for t in sueltos:
		if t == null or t == passer or not is_instance_valid(t) or _teammate_actors.has(t):
			continue
		if _en_posicion_adelantada(t.position.z, linea, ball_z):
			_offside_teammates[t] = true




static func _en_posicion_adelantada(z: float, linea: float, ball_z: float) -> bool:
	return z < linea - 0.1 and z < ball_z - 0.1 and z < Stadium.HALF_LINE - 0.1





