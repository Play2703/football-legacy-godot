const BOWL_TURN_STEP: float = 3.0
const BOWL_TURN_MAX: float = 174.0
const BOWL_PULL_STEP: float = 0.9


























const BOWL_PULL_FLOOR: float = 0.46






const GOAL_ORBIT_STEP: float = 3.0
const GOAL_ORBIT_MAX: float = 96.0


func _bowl_off(subject: Vector3, off: Vector3) -> Vector3:
	if _stadium == null or not is_instance_valid(_stadium) or not _stadium.has_bowl():
		return off
	var n: Vector3 = _stadium.bowl_breach(subject + off)
	if n == Vector3.ZERO:
		return off
	if _stadium.bowl_breach(subject) != Vector3.ZERO:
		return off









	var base: float = Vector2(off.x, off.z).length()
	var suelo: float = base * BOWL_PULL_FLOOR
	var pull: Vector3 = off
	for _i in 24:
		if Vector2(pull.x, pull.z).length() <= suelo:
			break
		var antes: Vector3 = pull
		pull *= BOWL_PULL_STEP
		if _stadium.bowl_breach(subject + pull) == Vector3.ZERO:







			var dentro: Vector3 = pull
			var fuera: Vector3 = antes
			for _j in 6:
				var medio: Vector3 =(dentro + fuera) * 0.5
				if _stadium.bowl_breach(subject + medio) == Vector3.ZERO:
					dentro = medio
				else:
					fuera = medio
			return dentro




	var s: float = signf(Vector3.UP.cross(pull).dot(n))
	if is_zero_approx(s):
		s = 1.0
	var ang: float = BOWL_TURN_STEP
	while ang <= BOWL_TURN_MAX:
		var cand: Vector3 = pull.rotated(Vector3.UP, deg_to_rad(ang) * s)
		if _stadium.bowl_breach(subject + cand) == Vector3.ZERO:
			return cand
		ang += BOWL_TURN_STEP


	for _i in 24:
		pull *= BOWL_PULL_STEP
		if _stadium.bowl_breach(subject + pull) == Vector3.ZERO:
			return pull
	return pull





func _bowl_home_yaw() -> float:
	var raw: Vector3 = _aim_cam_off.rotated(Vector3.UP, _axis_dyaw())
	var fix: Vector3 = _bowl_off(_ball.global_position, raw)
	if fix == raw:
		return 0.0
	return - Vector2(raw.x, raw.z).angle_to(Vector2(fix.x, fix.z))








func _aim_cam_home() -> Vector3:
	var sujeto: Vector3 = _ball.global_position
	return sujeto + _bowl_off(sujeto,
		_aim_cam_off.rotated(Vector3.UP, _axis_dyaw()))




func _aim_cam_home_basis() -> Basis:
	var dyaw: float = _axis_dyaw() + _bowl_home_yaw()
	if is_zero_approx(dyaw):
		return _aim_cam_basis
	return Basis(Vector3.UP, dyaw) * _aim_cam_basis




















func _update_drive_camera(delta: float) -> void:


	if _robo_cam_viva:
		return








	if not _aim_cam.current:
		if _drive_cam_mix > 0.0 or _drive_cam_settling:
			_snap_aim_camera_home()
		return


	if state != State.AIMING and state != State.RESOLVED:
		if _drive_cam_mix > 0.0 or _drive_cam_settling:
			_snap_aim_camera_home()
		return
	_drive_cam_settling = true
	var target: float = 1.0 if _drive_active else 0.0




	var blend_t: float = 0.08 if Settings.reduce_motion else DRIVE_CAM_BLEND_T
	_drive_cam_mix = move_toward(_drive_cam_mix, target, delta / blend_t)







	if is_zero_approx(_drive_cam_mix) and not _drive_active \
			and is_equal_approx(_open_zoom, 1.0) \
			and _aim_cam.global_position.distance_to(_aim_cam_home()) < DRIVE_CAM_SNAP_D:
		_snap_aim_camera_home()
		return
	var s: float = smoothstep(0.0, 1.0, _drive_cam_mix)






















	var off: Vector3 =(_aim_cam_off.rotated(Vector3.UP, _axis_dyaw()) * _open_zoom) \
			.lerp(_drive_cam_offset() * OPEN_ZOOM_AIM, s)






	_aim_cam.fov = lerpf(_aim_fov_base,
		float(CAM_PROFILES["regate"][2]), s)






	var bal_g: Vector3 = _ball.global_position - Vector3(0.0, _saque_caida_h, 0.0)
	var sujeto: Vector3 = bal_g
	if _drive_active and is_instance_valid(_self_actor):
		sujeto = bal_g.lerp(_self_actor.global_position, 0.5)








	off = _bowl_off(sujeto, off + _carga_kick_step(delta))
	_aim_cam.global_position = _aim_cam.global_position.lerp(
		sujeto + off, 1.0 - exp(- DRIVE_CAM_STIFF * delta))
	_aim_cam.global_position = sujeto + _bowl_off(sujeto,
		_aim_cam.global_position - sujeto)
	if _drive_active:








		var base_lead: Vector2 = _switch_axis() if _switch_active else Vector2(0.0, -1.0)
		var want_lead: Vector2 =(base_lead
			+ _drive_facing * DRIVE_CAM_LEAD_MIX).normalized()
		var lead_t_d: float = 1.0 - exp(- DRIVE_CAM_LEAD_STIFF * delta)
		_drive_cam_lead = _drive_cam_lead.lerp(want_lead, lead_t_d).normalized()


		var ritmo_lead_d: float = 1.0 if Settings.reduce_motion \
				else lerpf(CAM_LEAD_RITMO_MIN, 1.0, clampf(
				_drive_vel.length() / maxf(_drive_run_spd, 0.01), 0.0, 1.0))
		_cam_lead_ritmo = lerpf(_cam_lead_ritmo, ritmo_lead_d, lead_t_d)
		var look_t: Vector3 = bal_g + Vector3(0.0, 0.4, 0.0) \
				+ Vector3(_drive_cam_lead.x, 0.0, _drive_cam_lead.y) \
				*(DRIVE_CAM_LEAD_M * _cam_lead_ritmo)
		var hito: Vector3 = Vector3(0.0, CROSSBAR_H, 0.0)
		if _switch_active:
			hito = Vector3(_switch_target_pos.x, 1.0, _switch_target_pos.y)
			if is_instance_valid(_switch_target):
				hito = Vector3(_switch_target.position.x, 1.0, _switch_target.position.z)
		look_t = look_t.lerp(hito, DRIVE_CAM_GOAL_LOOK)











		_drive_look_lift(look_t, sujeto, delta)









		if is_instance_valid(_self_actor):
			var yo_d: Vector3 = Vector3(_self_actor.position.x, 0.0,
				_self_actor.position.z)
			_weld_cam_lateral(yo_d +(sujeto + off - bal_g), delta,
				yo_d)
		else:
			_weld_cam_lateral(sujeto + off, delta)
		_fx_apply_roll(delta, _drive_facing)
		return




	if _look_target == null or not is_instance_valid(_look_target):
		_aim_cam.global_transform.basis = _aim_cam.global_transform.basis.slerp(
			_aim_cam_home_basis(), 1.0 - exp(- DRIVE_CAM_STIFF * delta)).orthonormalized()





func _snap_aim_camera_home() -> void:
	_drive_cam_mix = 0.0
	_drive_cam_settling = false
	_aim_cam.global_position = _aim_cam_home()
	_aim_cam.global_transform.basis = _aim_cam_home_basis()
	_aim_cam.fov = _aim_fov_base

















