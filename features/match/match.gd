	al = al.normalized()
	if absf(al.y) > 0.99:
		return
	var fin: Vector3 = - _strike_base_final.z
	var ang: float = fin.angle_to(al)
	var tope: float = deg_to_rad(STRIKE_MIRA_MAX_DEG)
	if ang > tope:
		al = fin.slerp(al, tope / ang).normalized()
	_shot_cam.global_transform.basis = Basis.looking_at(al, Vector3.UP)




