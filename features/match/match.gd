func _dianas_sitio_pantalla(g: int) -> Vector2:
	var cam: Camera3D = SceneFade.camara_de(self)
	if cam == null:
		return Vector2.INF
	var p: Vector3
	if _practice_kind == Practice.BLANCOS:
		if g < 0 or g >= _blancos_nodos.size() or not is_instance_valid(_blancos_nodos[g]):
			return Vector2.INF
		p = _blancos_nodos[g].global_position
	else:
		if g < 0 or g >= _dianas_nodos.size() or not is_instance_valid(_dianas_nodos[g]):
			return Vector2.INF
		p = _dianas_nodos[g].global_position + Vector3(0.0, DIANA_H + 0.3, 0.0)
	if cam.is_position_behind(p):
		return Vector2.INF
	return cam.unproject_position(p)


