					pos.x = signf(pos.x) * wall_x
					vel.x = - vel.x * 0.35
					vel.z *= 0.6





			var rolling_slow: bool = pos.y <= 0.01 and Vector2(vel.x, vel.z).length() < 0.4
			var dead: bool = _outcome == "goal" or _outcome == "wide" or _outcome == "over"
			var tail: int = TAIL_DEAD_STEPS if dead else TAIL_LIVE_STEPS




















			var fin_de_tiempo: bool = step - resolve_step > tail \
