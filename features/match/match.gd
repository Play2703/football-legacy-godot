func _celeb_bowl() -> Dictionary:
	if _stadium != null and is_instance_valid(_stadium):
		return _stadium.camera_bowl()
	return {"hx": CELEB_BOWL_HX, "z_min": CELEB_BOWL_Z_MIN, "z_max": CELEB_BOWL_Z_MAX}



func _celeb_sitio(p: Vector2, u: Vector2) -> float:
	var b: Dictionary = _celeb_bowl()
	var hx: float = float(b["hx"])
	var t: float = 1000.0
	if u.x > 0.0001:
		t = minf(t,(hx - p.x) / u.x)
	elif u.x < -0.0001:
		t = minf(t,(- hx - p.x) / u.x)
	if u.y > 0.0001:
		t = minf(t,(float(b["z_max"]) - p.y) / u.y)
	elif u.y < -0.0001:
		t = minf(t,(float(b["z_min"]) - p.y) / u.y)
	return maxf(t, 0.0)





func _celeb_dentro(fp: Vector3, off: Vector3) -> Vector3:
	var plano: Vector2 = Vector2(off.x, off.z)
	var d: float = plano.length()
	if d < 0.01:
		return off
	var u: Vector2 = plano / d
	var largo: float = minf(d, maxf(_celeb_sitio(Vector2(fp.x, fp.z), u)
		- CELEB_BOWL_PAD, CELEB_ENCARA_MIN_D))
	return Vector3(u.x * largo, off.y, u.y * largo)




func _celeb_rumbo() -> Vector2:
	if _celeb_run_n > 0:
		var medio: Vector2 = _celeb_run_sum / float(_celeb_run_n)
		if medio.length() >= CELEB_ENCARA_MIN_M:
			return medio
	return Vector2(_celeb_focus_pos.x - _celeb_from_pos.x,
		_celeb_focus_pos.z - _celeb_from_pos.z)




















const CELEB_CAMPO_CONO: float = 0.96
const CELEB_VISTA_CARA: float = 0.3





static func _celeb_afuera(p: Vector2) -> Vector2:
	var nx: float = p.x / Stadium.FIELD_HALF_W
	var nz: float =(p.y - Stadium.HALF_LINE) / Stadium.HALF_LINE
	var g: Vector2 = Vector2(nx * nx * nx / Stadium.FIELD_HALF_W,
		nz * nz * nz / Stadium.HALF_LINE)
	if g.length() < 1e-06:
		return Vector2(signf(p.x) if absf(p.x) > 0.01 else 1.0, 0.0)
	return g.normalized()





func _celeb_encara(fp: Vector3, off: Vector3, h_cam: float = -1.0) -> Vector3:
	var plano: Vector2 = Vector2(off.x, off.z)
	var d: float = plano.length()
	if d < 0.5:
		return off
	var sitio: Vector2 = Vector2(fp.x, fp.z)

	var eje: Vector2 = - _celeb_afuera(sitio)
	var venir: Vector2 = _celeb_rumbo()
	var avance: Vector2 = venir.normalized() if venir.length() >= CELEB_ENCARA_MIN_M \
			else Vector2.ZERO
	var ang: float = minf(atan2(absf(plano.x), absf(plano.y)), CELEB_CAMPO_CONO)

	var lado: float = signf(Vector2(- eje.y, eje.x).dot(avance))
	if lado == 0.0:
		lado = 1.0
	var k0: float = ang * lado
	var mitad: float = CELEB_CAMPO_CONO * 0.5
	var giros: Array[float] = [k0, - k0, 0.0, lado * mitad, - lado * mitad,
		lado * CELEB_CAMPO_CONO, - lado * CELEB_CAMPO_CONO]
	var h: float = h_cam if h_cam >= 0.0 else minf(fp.y + off.y, CELEB_CAM_MAX_H)
	var otros: Array = _celeb_otros(false)



	var elegido: int = _celeb_giro_i if _celeb_giro_i >= 0 and _celeb_giro_i < giros.size() \
			else -1
	var mejor: Vector3 = off
	var coste_min: float = INF
	for i in giros.size():
		if elegido >= 0 and i != elegido:
			continue
		var u: Vector2 = eje.rotated(giros[i])
		var largo: float = clampf(minf(d, _celeb_sitio(sitio, u) - CELEB_BOWL_PAD),
			CELEB_ENCARA_MIN_D, d)
		var cam: Vector2 = sitio + u * largo
		var coste: float = _celeb_tapa(Vector3(cam.x, h, cam.y), sitio, otros) \
				+ CELEB_VISTA_DESVIO * absf(giros[i] - k0) / CELEB_CAMPO_CONO \
				+ CELEB_VISTA_CORTO *(1.0 - largo / d) \
				+ CELEB_VISTA_CARA *(1.0 - u.dot(avance)) * 0.5 * avance.length()
		if _celeb_por_la_red(cam, sitio):
			coste += CELEB_VISTA_RED
		if coste < coste_min - 0.001:
			coste_min = coste
			mejor = Vector3(u.x * largo, off.y, u.y * largo)
			if elegido < 0:
				_celeb_giro_i = i
	return mejor


















const CELEB_VISTA_ANCHO: float = 0.45
const CELEB_VISTA_DETRAS: float = 0.6


const CELEB_VISTA_LENTE: float = 3.5
const CELEB_VISTA_LENTE_ANG: float = 0.35
const CELEB_VISTA_MEDIO_FOV: float = 0.42
const CELEB_VISTA_LENTE_PESO: float = 0.8
const CELEB_VISTA_DESVIO: float = 0.15
const CELEB_VISTA_CORTO: float = 0.5
const CELEB_VISTA_RED: float = 5.0


var _celeb_giro_i: int = -1

var _celeb_destinos: Dictionary = {}




func _celeb_otros(vivos: bool) -> Array:
	var todos: Array = []
	todos.append_array(_teammate_actors)
	todos.append_array(_rival_actors)
	todos.append(_keeper)
	todos.append(_self_actor)
	var out: Array = []
	var vistos: Dictionary = {}
	for a in todos:
		if a == null or not is_instance_valid(a) or a == _celeb_focus \
				or vistos.has(a) or not (a as Node3D).visible:
			continue
		vistos[a] = true
		var p: Vector3 =(a as Node3D).position if vivos \
				else _celeb_destinos.get(a,(a as Node3D).position)
		out.append(Vector2(p.x, p.z))
	return out










static func _celeb_tapa(cam: Vector3, sujeto: Vector2, otros: Array) -> float:
	var c: Vector2 = Vector2(cam.x, cam.z)
	var v: Vector2 = sujeto - c
	var largo: float = v.length()
	if largo < 0.5:
		return 0.0
	var dir: Vector2 = v / largo
	var h: float = cam.y
	var alto_m: float = CELEB_SIGUE_SUJETO_M
	var coste: float = 0.0
	for o in otros:
		var q: Vector2 =(o as Vector2) - c
		var t: float = q.dot(dir)
		if t <= 0.2 or t >= largo - CELEB_VISTA_DETRAS:
			continue
		var l: float = absf(q.cross(dir))
		var w: float = CELEB_VISTA_ANCHO *(1.0 + t / largo)
		var de_lado: float = clampf(1.0 - l / w, 0.0, 1.0)
		var de_alto: float = clampf((h / largo -(h - alto_m) / t) /(alto_m / largo),
			0.0, 1.0)
		coste += de_lado * de_alto

		if t < CELEB_VISTA_LENTE and l / t < CELEB_VISTA_LENTE_ANG \
				and atan2(h - alto_m, t) < atan2(h - CELEB_LOOK_H, largo) \
				+ CELEB_VISTA_MEDIO_FOV:
			coste += CELEB_VISTA_LENTE_PESO *(1.0 - t / CELEB_VISTA_LENTE)
	return minf(coste, 2.0)







const CELEB_RED_PAD: float = 0.5

static func _celeb_por_la_red(cam: Vector2, sujeto: Vector2) -> bool:
	var hx: float = GOAL_HALF_W + CELEB_RED_PAD
	if cam.y < 0.0 and _celeb_cruza(cam, sujeto,
			Vector2(- hx, - NET_DEPTH - CELEB_RED_PAD), Vector2(hx, CELEB_RED_PAD)):
		return true
	var fondo: float = Stadium.FIELD_DEPTH
	return cam.y > fondo and _celeb_cruza(cam, sujeto,
		Vector2(- hx, fondo - CELEB_RED_PAD), Vector2(hx, fondo + NET_DEPTH + CELEB_RED_PAD))



static func _celeb_cruza(a: Vector2, b: Vector2, mn: Vector2, mx: Vector2) -> bool:
	var t0: float = 0.0
	var t1: float = 1.0
	var d: Vector2 = b - a
	for e in 2:
		var lo: float = mn[e] - a[e]
		var hi: float = mx[e] - a[e]
		if absf(d[e]) < 1e-06:
			if lo > 0.0 or hi < 0.0:
				return false
			continue
		var ta: float = minf(lo / d[e], hi / d[e])
		var tb: float = maxf(lo / d[e], hi / d[e])
		t0 = maxf(t0, ta)
		t1 = minf(t1, tb)
		if t0 > t1:
			return false
	return true












