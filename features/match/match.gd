func _intro_lente(cam: Camera3D) -> void:
	cam.keep_aspect = Camera3D.KEEP_HEIGHT if (_lienzo_h and INTRO_LENTE_TUMBADA) \
			else Camera3D.KEEP_WIDTH





func _intro_baja(cam: Camera3D, grados: float) -> void:
	if not (_lienzo_h and INTRO_LENTE_TUMBADA) or is_zero_approx(grados):
		return
	cam.rotate_object_local(Vector3.RIGHT, - deg_to_rad(grados))






func _start_intro() -> void:
	state = State.SETUP
	_chamarra_intro = _stadium != null and WeatherWear.marks_on(_stadium.weather_id())
	var d: int = _stadium.div if _stadium else GameState.home_div()
