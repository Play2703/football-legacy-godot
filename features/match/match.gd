func _shootout_teammate_scores(taker: Dictionary = {}) -> bool:
	var rival_id: String = String(GameState.current_rival().get("id", ""))
	var keeper_n: float = Squad.keeper_skill(Squad.keeper(rival_id))








	var quien: Dictionary = taker if not taker.is_empty() \
			else Squad.best_specialist(_my_side_id(), "penal")
	var shooter_q: float = Squad.norm(quien, "penal")
	return randf() < _con_volado(
		clampf(0.62 + shooter_q * 0.2 - keeper_n * 0.14, 0.5, 0.9), true)




func _shootout_rival_scores(taker: Dictionary = {}) -> bool:
	var keeper_n: float = Squad.keeper_skill(Squad.keeper(_my_side_id()))
	var rival: Dictionary = GameState.current_rival()




	var shooter_q: float = Squad.norm(taker, "penal") if not taker.is_empty() \
			else clampf((float(rival.get("rating", 62)) - 55.0) / 40.0, 0.0, 1.0)
	return randf() < _con_volado(
		clampf(0.62 + shooter_q * 0.2 - keeper_n * 0.14, 0.5, 0.9), false)







func _con_volado(p: float, mio: bool) -> float:
	return clampf(p + Volado.bono(_toss_won, mio), 0.42, 0.95)





func _shootout_over(a: int, b: int, a_taken: int, b_taken: int) -> bool:





	if a_taken < 5 or b_taken < 5:
		var a_max: int = a + maxi(5 - a_taken, 0)
		var b_max: int = b + maxi(5 - b_taken, 0)
		return a > b_max or b > a_max

	return a_taken == b_taken and a != b












