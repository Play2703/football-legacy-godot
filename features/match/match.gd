const PRESS_TRAMO_MIN: float = 6.0







func _press_tramos_largos(tramos: Array, ruta_total: float, n: int) -> Array:
	if tramos.size() != n or ruta_total < PRESS_TRAMO_MIN * float(n):
		return []
	var suma: float = 0.0
	for t in tramos:
		suma += maxf(0.0, float(t))
	if suma <= 0.0:
		return []
	var largos: Array = []
	for t in tramos:
		largos.append(maxf(0.0, float(t)) / suma * ruta_total)




	for i in largos.size():
		if float(largos[i]) < PRESS_TRAMO_MIN:
			var falta: float = PRESS_TRAMO_MIN - float(largos[i])
			largos[i] = PRESS_TRAMO_MIN
			var j: int = 0
			for k in largos.size():
				if float(largos[k]) > float(largos[j]):
					j = k
			largos[j] = float(largos[j]) - falta
	return largos









func _press_ruta_bonus_de(div: int, p: Dictionary) -> int:
	var b: int = 0
	if div == 1:
		b += 1
	elif div >= 4:
		b -= 1
	if not p.is_empty():


		if float(p.get("presion", 0.5)) >= 0.7:
			b += 1
		elif float(p.get("bloque", 0.5)) >= 0.7:
			b -= 1
	return b









