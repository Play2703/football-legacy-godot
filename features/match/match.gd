	var dentro: int = _serve_k - entra
	var reloj: float = SERVICIO_GOLPEO_RELOJ_CABEZA
	if dentro > 0:
		reloj = clampf(float(dentro) * SIM_DT / SERVICIO_CRUCE_PARED,
			SERVICIO_GOLPEO_RELOJ_CRUCE_MIN, SERVICIO_GOLPEO_RELOJ_CABEZA)
	_serve_cruce = {"entra": entra, "dentro": dentro, "reloj": reloj,
		"desde": entra - roundi(SERVICIO_CRUCE_ANTES / SIM_DT), "hasta": _serve_k + dentro}





