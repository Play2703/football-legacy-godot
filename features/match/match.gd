func _pose_arbitro_volado(arbitro: AnimatedSprite3D, lanzando: bool) -> void:
	if arbitro == null or arbitro.sprite_frames == null:
		return



	_ensure_anims(RIVAL_TEX, _ref_look(), "volado")
	if not arbitro.sprite_frames.has_animation("volado"):
		return
	if lanzando:
		arbitro.play("volado")


		_anim_lock[arbitro] = Time.get_ticks_msec() + TOSS_ANIM_LOCK_MS
		return
	arbitro.animation = "volado"
	arbitro.frame = 0
	arbitro.pause()
	_anim_lock[arbitro] = Time.get_ticks_msec() + TOSS_ANIM_LOCK_MS



















const COIN_CARA_TEX: Texture2D = preload(
	"res://assets/sprites/objects/moneda_cara.png")
const COIN_SOL_TEX: Texture2D = preload(
	"res://assets/sprites/objects/moneda_sol.png")

const TOSS_CANTO: Color = Color("c8a244")


func _make_coin() -> Node3D:
	var raiz: Node3D = Node3D.new()


	var canto: MeshInstance3D = MeshInstance3D.new()
	var mesh: CylinderMesh = CylinderMesh.new()
	mesh.top_radius = TOSS_COIN_R * COIN_DISC_FRAC * 0.94
	mesh.bottom_radius = TOSS_COIN_R * COIN_DISC_FRAC * 0.94
	mesh.height = TOSS_COIN_H
	mesh.radial_segments = 20
	mesh.rings = 1
	canto.mesh = mesh
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.albedo_color = TOSS_CANTO
	mat.metallic = 0.85
	mat.roughness = 0.3
	canto.material_override = mat
	canto.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	raiz.add_child(canto)

	raiz.add_child(_coin_face(COIN_CARA_TEX, true))
	raiz.add_child(_coin_face(COIN_SOL_TEX, false))
	return raiz


func _coin_face(tex: Texture2D, arriba: bool) -> Sprite3D:
	var s: Sprite3D = Sprite3D.new()
	s.texture = tex
	s.pixel_size =(TOSS_COIN_R * 2.0) / float(tex.get_width())



	s.rotation_degrees = Vector3(-90.0 if arriba else 90.0, 0.0, 0.0)
	s.position = Vector3(0.0,(TOSS_COIN_H * 0.55) *(1.0 if arriba else -1.0), 0.0)


	s.billboard = BaseMaterial3D.BILLBOARD_DISABLED
	s.double_sided = false
	s.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	s.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	s.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return s





func _clear_coin_toss() -> void:
	for tw in [_toss_tw, _toss_spin_tw]:
		if tw != null and tw.is_valid():
			tw.kill()
	_toss_tw = null
	_toss_spin_tw = null
	_hud.clear_coin_panel()
	if _toss_coin != null and is_instance_valid(_toss_coin):
		_toss_coin.queue_free()
	_toss_coin = null
	for cuerpo in _toss_bodies:
		if is_instance_valid(cuerpo):
			cuerpo.queue_free()
	_toss_bodies.clear()




func _run_shootout() -> void:
	_shootout_active = true
	_shootout_note = ""
	_hud.clear_message()


	await _run_coin_toss()
	var mine: int = 0
	var theirs: int = 0
	var taken: int = 0





	var my_slot: int =(randi() % 5) \
			if (Career.takes_penalties() and _on_pitch_at_end()) else -1





	var rival: Dictionary = GameState.current_rival()
	var mine_r: Array = []
	var theirs_r: Array = []
	var my_takers: Array = _shootout_takers(_my_side_id(), true)
	var their_takers: Array = _shootout_takers(String(rival.get("id", "")), false)







	var scorer_mine: Dictionary = {}
	var scorer_theirs: Dictionary = {}
	var scorer_mine_you: bool = false
	var last_side_mine: bool = true
	var last_scored: bool = false
