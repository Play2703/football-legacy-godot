func _socio_hat() -> Dictionary:
	var best: String = ""
	var best_n: int = 0
	for nm in _socio_goles:
		var n: int = int((_socio_goles[nm] as Dictionary).get("n", 0))
		if n > best_n:
			best = str(nm)
			best_n = n
	if best.is_empty() or best_n < Keepsakes.SOCIO_ASSISTS:
		return {}
	return {"name": best, "assists": best_n,


		"goals": maxi(int(_mate_scorers.get(best, 0)), best_n),
		"num": int((_socio_goles[best] as Dictionary).get("num", 0))}


