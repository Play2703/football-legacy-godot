func _carga_falta_ref() -> Vector2:
	if not _duel_carga_falta_vel:
		return _duel_facing
	if _duel_vel.length() < Duel.CARGA_PARADO_V:
		return _duel_facing
	return _duel_vel


func _carga_duel(delta: float) -> void:
	_bump_cd = maxf(_bump_cd - delta, 0.0)




	_carga_kick_want = Vector3.ZERO
	if _duel_carga_off or _duel_defs.is_empty():
		return
	for i in _duel_defs.size():
		var mi_peso: float = _duel_def_pesos[i] if i < _duel_def_pesos.size() \
				else Duel.PESO_NEUTRO
		var ahora: float = float(Time.get_ticks_msec()) / 1000.0
		var actor_def: AnimatedSprite3D = _duel_def_actors[i] \
				if i < _duel_def_actors.size() and is_instance_valid(_duel_def_actors[i]) \
				else null
		var push: Vector2 = Duel.carga_push(_duel_defs[i], _duel_def_vels[i],
			_duel_pos, _duel_vel, mi_peso, _carry_fisico)
		if push == Vector2.ZERO:


			if actor_def != null:
				_carga_gesto_sostiene(actor_def,
					_duel_defs[i].distance_to(_duel_pos)
						< Duel.CARGA_R * Crowding.CARGA_CONTACTO_K,
					(_duel_def_vels[i] as Vector2).length(), ahora)
			continue

		if actor_def != null:
			_carga_gesto_arranca(actor_def, ahora)



		if not _duel_carga_falta \
				and Duel.carga_es_falta(_duel_defs[i], _duel_pos, _carga_falta_ref(),
					push, Duel.carga_falta_min(_duel_def_tackles[i]
						if i < _duel_def_tackles.size() else Duel.NEUTRAL_TACKLE)
						* _carga_falta_k, _carga_espalda_cos):
			_duel_carga_falta = true
			_duel_carga_i = i




			_duel_carga_dura = Duel.carga_es_dura(_duel_defs[i], _duel_pos,
				_carga_falta_ref(), push)


		var desvio: Vector2 = Duel.carga_desvio(push, _duel_vel)
		_duel_carga_m += desvio.length() * delta
		_duel_pos = _duel_corral(_duel_pos + desvio * delta)







		if _bump_cd <= 0.0:
			_bump_cd = BUMP_CARGA_CD
			_bump(BUMP_CARGA)
		var kick: Vector3 = _carga_cam_kick(push)
		if kick.length() > _carga_kick_want.length():
			_carga_kick_want = kick



	var cuerpo_carga: AnimatedSprite3D = _self_actor
	if cuerpo_carga != null and is_instance_valid(cuerpo_carga):
		cuerpo_carga.position = Vector3(_duel_pos.x, cuerpo_carga.position.y, _duel_pos.y)





	for i in _duel_defs.size():
		for j in _duel_mates.size():
			var p2: Vector2 = Duel.carga_push(_duel_defs[i], _duel_def_vels[i],
				_duel_mates[j], _duel_mate_vel(j),
				_duel_def_pesos[i] if i < _duel_def_pesos.size() else Duel.PESO_NEUTRO,
				Duel.PESO_NEUTRO)
			if p2 == Vector2.ZERO:
				continue
			_duel_mates[j] = _inside_field(_duel_mates[j]
				+ Duel.carga_desvio(p2, _duel_mate_vel(j)) * delta)
			if j < _duel_mate_actors.size() and is_instance_valid(_duel_mate_actors[j]):
				var m: AnimatedSprite3D = _duel_mate_actors[j]
				m.position = Vector3(_duel_mates[j].x, m.position.y, _duel_mates[j].y)


func _relax_duel() -> void:
	if _duel_defs.size() + _duel_mates.size() < 2:
		return
	var pts: Array = []
	pts.append_array(_duel_defs)
	pts.append_array(_duel_mates)
	var out: Array = Crowding.relax(pts, Crowding.DUEL_SEP)
	for i in _duel_defs.size():
		if out[i] == _duel_defs[i]:
			continue
		_duel_defs[i] = _inside_field(out[i])
		if i < _duel_def_actors.size() and is_instance_valid(_duel_def_actors[i]):
			var a: AnimatedSprite3D = _duel_def_actors[i]
			a.position = Vector3(_duel_defs[i].x, a.position.y, _duel_defs[i].y)
	for i in _duel_mates.size():
		var k: int = _duel_defs.size() + i
		if out[k] == _duel_mates[i]:
			continue
		_duel_mates[i] = _inside_field(out[k])
		if i < _duel_mate_actors.size() and is_instance_valid(_duel_mate_actors[i]):
			var m: AnimatedSprite3D = _duel_mate_actors[i]
			m.position = Vector3(_duel_mates[i].x, m.position.y, _duel_mates[i].y)





func _duel_chasers() -> Array[Vector2]:
	var out: Array[Vector2] = []
	for i in _duel_defs.size():
		var mark: int = _duel_def_marks[i] if i < _duel_def_marks.size() else -1
		if mark < 0:
			out.append(_duel_defs[i])
	return out




func _mate_marker(mi: int, m: Vector2) -> Vector2:
	for di in _duel_def_marks.size():
		if int(_duel_def_marks[di]) == mi and di < _duel_defs.size():
			return _duel_defs[di]
	var best: Vector2 = _ball_field
	var best_d: float = INF
	for d in _duel_defs:
		var dd: float =(d as Vector2).distance_to(m)
		if dd < best_d:
			best_d = dd
			best = d
	return best














