func _saque_largo_planta(srv: AnimatedSprite3D) -> void:
	var s: Vector2 = _serve_plan["srv"]
	srv.global_position = Vector3(s.x, srv.global_position.y, s.y)
	var oeste: bool = s.x > 0.0
	var anim: String = "saque_banda_" +("west" if oeste else "east")
	var der: Vector3 = _saque_der()
	_serve_plan["saque_der"] = der
	_serve_plan["saque_desde"] = _saque_mano(srv, anim, SAQUE_SUELTA_I, oeste, der) \
			- Vector3(0.0, BALL_VISUAL_D * 0.5, 0.0)
