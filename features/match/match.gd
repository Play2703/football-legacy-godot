	_ensucia(_keeper)


	_keeper_triggered = true












func _keeper_va_al_balon(dir: Vector3) -> bool:
	if not is_instance_valid(_ball) or not is_instance_valid(_keeper):
		return false
	var rumbo: Vector2 = Vector2(dir.x, dir.z)
	if rumbo.length_squared() < DIR_DEGENERADO:
		return false
	var al_balon: Vector2 = Vector2(
		_ball.global_position.x - _keeper.global_position.x,
		_ball.global_position.z - _keeper.global_position.z)





	if al_balon.length() < KEEPER_BACK_BALL_MIN_M:
		var puesta: String = String(_keeper.animation)
		if not (puesta.ends_with("_east") or puesta.ends_with("_west")):
			return false
	return rumbo.normalized().dot(al_balon.normalized()) > KEEPER_BACK_BALL_DOT












func _play_keeper_out(dir: Vector3, permitir_set: bool = true,
		andar: bool = false) -> void:
	if not is_instance_valid(_keeper):
		return








	_keeper.flip_h = false





	var dnk: String = _dir_name_move(_keeper, dir)
















	if dnk == "north" and _keeper_goal_z == 0.0:
		_cam_base_refresh()
		var lat: float = 0.0
		if _cam_present and _cam_base_ok:
			lat = Vector2(dir.x, dir.z).dot(_cam_right_flat)
		else:
			lat = dir.x
		dnk = "south"
		if absf(lat) > KEEPER_NO_BACK_LAT:
			dnk = "east" if lat > 0.0 else "west"
		elif _pass_view_on() or _keeper_va_al_balon(dir):




















			var desempate: float = lat
			if absf(desempate) < 0.001 and _cam_present and _cam_base_ok:
				var al_balon: Vector3 = _ball.global_position - _keeper.global_position
				desempate = Vector2(al_balon.x, al_balon.z).dot(_cam_right_flat)
			dnk = "east" if desempate >= 0.0 else "west"
		_keeper.set_meta("dir_show", dnk)
		_keeper.set_meta("dir_last", dnk)









	elif _keeper_goal_z > 0.0:
		dnk = "north"
		_keeper.set_meta("dir_show", dnk)
		_keeper.set_meta("dir_last", dnk)
	var set_anim: String = "set_" + dnk
	if permitir_set and _keeper_set_now() \
			and _keeper.sprite_frames.has_animation(set_anim):




		_keeper.speed_scale = lerpf(KEEPER_SET_SWAY_SLOW, KEEPER_SET_SWAY_FAST,
			clampf(_keeper_speed, 0.0, 1.0))
		if _keeper.animation != set_anim:
			_keeper.play(set_anim)
		return
	var anim: String = "out_" + dnk
	if andar and _keeper.sprite_frames.has_animation("walk_" + dnk):
		anim = "walk_" + dnk
	if not _keeper.sprite_frames.has_animation(anim):
		_play_run(_keeper, dir)
		return






	var fam: String = _pace_family(_keeper)





















	if fam == "run_" and _keeper.sprite_frames.has_animation("run_" + dnk):
		_dir_force[_keeper] = dnk
		_play_run(_keeper, dir, "run_")
		_dir_force.erase(_keeper)
		return
	var v: float = float(_keeper.get_meta("pace_v", KEEPER_OUT_REF_SPD))
	_keeper.speed_scale = clampf(v / KEEPER_OUT_REF_SPD,
		KEEPER_OUT_SCALE_MIN, KEEPER_OUT_SCALE_MAX)
	if _keeper.animation != anim:
		_keeper.play(anim)

















func _rebound_grace() -> bool:








	if _clear_phase or _switch_active:
		return false
	if _shootout_active and not _cedida_en_curso and not _cobro_corre:
		return false
	if _rebound_i < 0 or _traj_i <= _rebound_i:
		return false
	if _traj.is_empty():
		return false
	_grace_steps = 0 if _grace_steps < 0 else _grace_steps + 1
















	if _cedida_en_curso and _ball != null and is_instance_valid(_ball) \
			and _ball.visible:
		var p: Vector2 = Vector2(_ball.position.x, _ball.position.z)
		var dentro: bool = absf(p.x) <= Stadium.FIELD_HALF_W - 0.5 \
				and p.y >= 0.3 and p.y <= Stadium.FIELD_DEPTH - 1.0
		if dentro and _grace_steps < CEDIDA_GRACE_STEPS:
			return true
	var queda: float = float(REBOUND_GRACE_STEPS - _grace_steps) * SIM_DT
	if queda <= 0.0:
		return false





	if _keeper_claim:
		return true

	var rest: Vector3 = _traj[mini(_traj_i, _traj.size() - 1)]


	var alcance: float = _touch_radius(rest.y)
	for pool in _chase_pools():
		for actor in pool:
			if not is_instance_valid(actor) or actor == _last_toucher:
				continue
			var falta: float = _flat_dist(actor.position, rest) - alcance
			if falta <= 0.0:
				return true

			var v: float = _chaser_speed.get(actor, AimPress.SPEED_FALLBACK)
			if v > 0.01 and falta / v <= queda:
				return true
	return false









func _play_time_left() -> float:
	var cola: float = float(maxi(_stop_i - _traj_i, 0)) * SIM_DT
	if _rebound_i < 0 or _traj_i <= _rebound_i:
		return cola
	return cola + float(maxi(REBOUND_GRACE_STEPS - maxi(_grace_steps, 0), 0)) * SIM_DT




















const KEEPER_CLAIM_R: float = 7.0



const KEEPER_CLAIM_EDGE: float = 0.75


const KEEPER_CLAIM_EDGE_T: float = 0.9


const KEEPER_CLAIM_TAKE: float = 1.05


const KEEPER_CLAIM_MIN_T: float = 0.5

const KEEPER_CLAIM_BALL_H: float = 0.7





const KEEPER_CLAIM_NEAR_Z: float = 1.5
var _keeper_claim: bool = false




func _keeper_claim_step(delta: float) -> bool:



	if not is_instance_valid(_keeper) or _libero_out \
			or (_clear_phase and not _robo_area_vivo):
		return false
	if _shootout_active or _switch_active:
		return false






	var tumbado: float = _keeper_down_left()
	if tumbado > 0.0 and not palanca_atrapada:
		return false



	if _verdict_i >= 0:
		return false






	if _traj.is_empty():
		return false


	var rest: Vector3 = _traj[mini(_stop_i, _traj.size() - 1)]














	var es_rechace: bool = _rebound_i >= 0 and _traj_i > _rebound_i
	var es_muerto: bool = _rebound_i < 0 \
			and _keeper_depth(rest.z) > KEEPER_CLAIM_NEAR_Z \
			and _outcome != "save" and _outcome != "goal"
	if not es_rechace and not es_muerto:
		return false
	var bp: Vector3 = _traj[mini(_traj_i, _traj.size() - 1)]
	if not _keeper_claim:
		if _play_time_left() < KEEPER_CLAIM_MIN_T:
			return false
		if bp.y > KEEPER_CLAIM_BALL_H:
			return false







		var claim_r: float = KEEPER_CLAIM_R *(0.85 + 0.3 * _keeper_skill)
		var kd: float = _flat_dist(_keeper.position, rest)
		if kd > claim_r:
			return false
		if palanca_atrapada:
			if not _keeper_claim_llega_antes(kd, rest, tumbado):
				return false
		else:
			var other: float = INF
			for pool in _chase_pools():
				for actor in pool:
					if is_instance_valid(actor):
						other = minf(other, _flat_dist(actor.position, rest))
			if kd > other * KEEPER_CLAIM_EDGE:
				return false


		if tumbado <= 0.0 and _keeper_tween and _keeper_tween.is_valid():
			_keeper_tween.kill()
		_keeper_claim = true


	if tumbado > 0.0:
		return false
	if palanca_atrapada and _keeper_tween and _keeper_tween.is_valid():
		_keeper_tween.kill()


	var kpos: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)
	var out: Array = Duel.step_defender(kpos, _keeper_out_vel,
		Vector2(bp.x, bp.z),
		lerpf(KEEPER_OUT_SPD_MIN, KEEPER_OUT_SPD_MAX, _keeper_speed), delta,
		_keeper_accel * NPC_ACCEL_SPAN + 1.0)
	_keeper.position = Vector3((out[0] as Vector2).x, _keeper.position.y,
		(out[0] as Vector2).y)
	_keeper_out_vel = out[1]


	_ball_field = Vector2(bp.x, bp.z)
	var to_ball: Vector3 = Vector3(bp.x - _keeper.position.x, 0.0,
		bp.z - _keeper.position.z)
	if to_ball.length() > KEEPER_CLAIM_TAKE:
















		_play_keeper_out(to_ball, false, true)
		return false



	_play_keeper_blocaje(bp)
	_ball.position = Vector3(bp.x, BALL_VISUAL_D * 0.5, bp.z)
	_finish_flight()
	return true









func _keeper_claim_llega_antes(kd: float, rest: Vector3, tumbado: float) -> bool:
	var t_k: float = tumbado + maxf(kd - KEEPER_CLAIM_TAKE, 0.0) \
			/ lerpf(KEEPER_OUT_SPD_MIN, KEEPER_OUT_SPD_MAX, _keeper_speed)
	var queda: float = float(maxi(_stop_i - _traj_i, 0)) * SIM_DT \
			if _clear_phase or _switch_active else _play_time_left()
	if t_k > queda:
		return false
	var t_o: float = INF
	for pool in _chase_pools():
		for actor in pool:
			if is_instance_valid(actor):
				var d: float = maxf(_flat_dist(actor.position, rest) - _touch_radius(rest.y), 0.0)
				t_o = minf(t_o, d / maxf(_chaser_speed.get(actor, AimPress.SPEED_FALLBACK), 0.5))
	return t_k <= t_o * KEEPER_CLAIM_EDGE_T








func _keeper_set_now() -> bool:
	if not is_instance_valid(_keeper):
		return false
	return _keeper_is_set(Vector2(_keeper.position.x, _keeper.position.z)
		.distance_to(_ball_field))


func _keeper_is_set(dist: float) -> bool:
	return dist <= _keeper_set_radius(_keeper_speed)





















































const KEEPER_FIS_LO: float = 0.25
const KEEPER_FIS_HI: float = 0.75
func _keeper_set_radius(fisico: float) -> float:
	var t: float =(clampf(fisico, KEEPER_FIS_LO, KEEPER_FIS_HI) - KEEPER_FIS_LO) \
			/(KEEPER_FIS_HI - KEEPER_FIS_LO)
	return lerpf(KEEPER_SET_R_MAX, KEEPER_SET_R_MIN, t)


func _pace_family(actor: AnimatedSprite3D) -> String:
	var now: float = float(Time.get_ticks_msec()) / 1000.0













	var k: float = _pace_world_k()
	var walk_in: float = WALK_ENTER * k
	var walk_out: float = WALK_EXIT * k
	var here: Vector3 = actor.position
	var walk: bool = bool(actor.get_meta("pace_walk", false))




	var cierra: bool = true
	if actor.has_meta("pace_t"):
		var dt: float = now - float(actor.get_meta("pace_t"))
		var prev0: Vector3 = actor.get_meta("pace_p", here)
		var d0: float = Vector2(here.x - prev0.x, here.z - prev0.z).length()
		if dt < PACE_DT_MIN \
				or (d0 < PACE_STILL_M and dt < _pace_still_dt()):




			cierra = false
		elif dt <= PACE_DT_MAX and d0 / dt <= PACE_MAX_MPS:
			var prev: Vector3 = prev0

			var d: float = d0




			var raw: float = d / dt
			var fresh: bool = not actor.has_meta("pace_v")






















			if not fresh:
				var v0: float = float(actor.get_meta("pace_raw",
					actor.get_meta("pace_v")))
				raw = clampf(raw, v0 - PACE_ACCEL_CAP * dt,
					v0 + PACE_ACCEL_CAP * dt)
			else:






				actor.set_meta("pace_slow_ms",
					(Time.get_ticks_msec() - WALK_SUSTAIN_MS) \
							if raw < walk_in else 0)



			actor.set_meta("pace_raw", raw)
			var v: float = raw if fresh \
					else lerpf(float(actor.get_meta("pace_v")), raw, PACE_SMOOTH)
			actor.set_meta("pace_v", v)








			if not fresh:






















				var now_ms: int = Time.get_ticks_msec()
				if v >= walk_in:
					actor.set_meta("pace_slow_ms", 0)
				elif int(actor.get_meta("pace_slow_ms", 0)) == 0:
					actor.set_meta("pace_slow_ms", now_ms)
				if int(actor.get_meta("pace_fam_ms", 0)) <= now_ms:
					var was: bool = walk
					if walk and v > walk_out:
						walk = false
					elif not walk and v < walk_in \
							and int(actor.get_meta("pace_slow_ms", 0)) != 0 \
							and now_ms - int(actor.get_meta("pace_slow_ms", 0)) \
							>= WALK_SUSTAIN_MS:
						walk = true
					if walk != was:
						actor.set_meta("pace_fam_ms", now_ms + FAM_HOLD_MS)
					actor.set_meta("pace_walk", walk)
		elif dt > PACE_DT_MAX:










			actor.remove_meta("pace_v")



			actor.remove_meta("pace_raw")
	if cierra:
		actor.set_meta("pace_t", now)
		actor.set_meta("pace_p", here)












	if int(actor.get_meta("pace_walk_until", 0)) > Time.get_ticks_msec():
		return "walk_"
	if walk and int(actor.get_meta("pace_run_until", 0)) > Time.get_ticks_msec():
		return "run_"
	return "walk_" if walk else "run_"


















const ONDEMAND_BUDGET_US: int = 2500

var _ondemand_deadline_us: int = 0








func _ensure_anim_now(actor: AnimatedSprite3D, anim: String) -> bool:
	if Time.get_ticks_usec() >= _ondemand_deadline_us:
		return false
	if not actor.has_meta("anim_tex") or not actor.has_meta("anim_cfg"):
		return false
	var tex: Texture2D = actor.get_meta("anim_tex")
	var cfg: Dictionary = actor.get_meta("anim_cfg")
	for slice in _anim_slices(tex, "rest"):
		if String(slice["anim"]) != anim:
			continue



		return _fill_anim_budget(actor.sprite_frames, slice, cfg)
	return false





static var _anim_target_cache: Dictionary = {}

func _anim_targets(tex: Texture2D) -> Dictionary:
	var hit: Variant = _anim_target_cache.get(tex.resource_path)
	if hit is Dictionary:
		return hit
	var out: Dictionary = {}
	for slice in _anim_slices(tex, "rest"):
		out[String(slice["anim"])] =(slice["paths"] as Array).size()
	_anim_target_cache[tex.resource_path] = out
	return out



















func _anim_usable(actor: AnimatedSprite3D, anim: String) -> bool:
	var frames: SpriteFrames = actor.sprite_frames
	if frames == null:
		return false
	var have: int = frames.get_frame_count(anim) if frames.has_animation(anim) else 0


	if not actor.has_meta("anim_tex"):
		return have > 0
	if have > 0 and have >= int(_anim_targets(actor.get_meta("anim_tex")).get(anim, 0)):
		return true
	_ensure_anim_now(actor, anim)
	return frames.has_animation(anim) and frames.get_frame_count(anim) > 0

















func _gesto_listo(actor: AnimatedSprite3D, anim: String) -> bool:
	if actor == null or not is_instance_valid(actor) or actor.sprite_frames == null:
		return false
	if not actor.has_meta("anim_tex"):


		return actor.sprite_frames.has_animation(anim)
	_anim_usable(actor, anim)
	var full: int = int(_anim_targets(actor.get_meta("anim_tex")).get(anim, 0))








	if not actor.sprite_frames.has_animation(anim):
		return false
	return full > 0 and actor.sprite_frames.get_frame_count(anim) >= full






func _fill_anim_budget(frames: SpriteFrames, slice: Dictionary, cfg: Dictionary) -> bool:
	_open_anim(frames, slice)
	var anim: String = slice["anim"]
	var paths: Array = slice["paths"]
	while frames.get_frame_count(anim) < paths.size():


		_pon_cuadro(frames, anim, paths[frames.get_frame_count(anim)], cfg)






		if Time.get_ticks_usec() >= _ondemand_deadline_us:
			break
	return frames.get_frame_count(anim) > 0







const IDLE_ANIM: Dictionary = {
	"south": &"idle", "north": &"idle_back", "east": &"idle_east", "west": &"idle_west",
}













func _face(actor: AnimatedSprite3D, dir: Vector3) -> void:
	if not is_instance_valid(actor):
		return
	var anim: StringName = IDLE_ANIM.get(_dir_name(dir), &"idle")
	if not actor.sprite_frames.has_animation(anim):
		anim = &"idle"


	if anim == &"idle" and actor.has_meta("hold_wall") \
			and actor.sprite_frames.has_animation(&"barrera"):
		anim = &"barrera"
	if actor.animation != anim:
		actor.play(anim)



