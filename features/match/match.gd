func _pasador_motivo(pos: Vector2) -> int:
	if _defender_pos.is_empty():
		return -1
	if Duel.covered(pos, _defender_pos):
		return Offer.MARCA
	if _play_style == MatchPlan.Style.DEFENSIVO:
		return Offer.APOYO
	if absf(pos.x) > Stadium.FIELD_HALF_W or pos.y < 0.0 or pos.y > Stadium.FIELD_DEPTH:
		return Offer.APOYO
	return Offer.RUPTURA






func _pasador_fuera_del_disco(p: Vector2) -> Vector2:
	var d: Vector2 = p - _ball_field
	if d.length() >= CLEAR_BALL_R:
		return p
	if d.length() < 0.01:
		d = Vector2(0.0, 1.0)
	return _inside_field(_ball_field + d.normalized() *(CLEAR_BALL_R + 0.1))




















func _pasador_arranca(pasador: AnimatedSprite3D, receptor: AnimatedSprite3D,
		motivo: int = -1) -> void:




	if not _teammate_actors.has(pasador):
		_pasador_alta(pasador)
	var pos: Vector2 = Vector2(pasador.position.x, pasador.position.z)
	var why: int = _pasador_motivo(pos)
	if motivo >= 0 and why >= 0:
		why = motivo
	if why < 0:

		_face_ball(pasador)
		return
	var line_z: float = _onside_line_z()



	var obs: Array[Vector2] = []
	if is_instance_valid(receptor):
		obs.append(Vector2(receptor.position.x, receptor.position.z))
	var meta: Vector2 = _offer_target(pos, line_z, why, obs)


	if why == Offer.RUPTURA and meta.distance_to(pos) < 0.5:
		why = Offer.APOYO
		meta = _offer_target(pos, line_z, why, obs)
	meta = _pasador_fuera_del_disco(meta)

	if not is_inf(line_z):
		meta.y = maxf(meta.y, line_z + Duel.ONSIDE_SLACK)
	if meta.distance_to(pos) < 0.5:

		_face_ball(pasador)
		return
	_offer_home[pasador] = pos
	_offer_why[pasador] = why
	_offer_goal[pasador] = meta
	_offer_burst[pasador] = PASADOR_BURST_T
	_offer_cd[pasador] = 0.0
	_offer_vels[pasador] = _chase_vels.get(pasador, Vector2.ZERO)
	_offer_dec[pasador] = int(_offer_dec.get(pasador, 0)) + 1


	_offer_recula.erase(pasador)
	if not is_inf(line_z) and pos.y < line_z + Duel.ONSIDE_SLACK:
		_offer_recula[pasador] = true
	_pasador_rafaga[pasador] = true
	_run_target[pasador] = Vector3(meta.x, pasador.position.y, meta.y)
	pasador.set_meta("pace_run_until", Time.get_ticks_msec() + 400)
































func _offer_tras_vuelo(receptor: AnimatedSprite3D) -> void:
	_offer_home.erase(receptor)
	_offer_vels.erase(receptor)
	_offer_burst.erase(receptor)
	_offer_goal.erase(receptor)
	_offer_why.erase(receptor)
	_pasador_rafaga.erase(receptor)
	var linea: float = _onside_line_z()
	for t in _teammate_actors:
		if not is_instance_valid(t) or t == _self_actor:
			continue
		var pos: Vector2 = Vector2(t.position.x, t.position.z)
		var pasado: bool = not is_inf(linea) and pos.y < linea + Duel.ONSIDE_SLACK
		if pasado:
			_offer_recula[t] = true
		else:
			_offer_recula.erase(t)


		if not _offer_home.has(t):
			continue
		if not pasado and pos.distance_to(_offer_home[t]) \
				<= _offer_leash(int(_offer_why.get(t, Offer.MARCA))):
			continue
		_offer_home[t] = Vector2(pos.x, linea + Duel.ONSIDE_SLACK) if pasado else pos
		_offer_goal.erase(t)
		_offer_burst[t] = 0.0
		_offer_vels[t] = _chase_vels.get(t, Vector2.ZERO)
		_pasador_rafaga.erase(t)
















