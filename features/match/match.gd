func _shootout_decisivo(scored: bool) -> bool:
	if _shootout_pre.is_empty():
		return false
	var mios: int = int(_shootout_pre.get("mine", 0))
	var suyos: int = int(_shootout_pre.get("theirs", 0))
	var vueltas: int = int(_shootout_pre.get("taken", 0))
	if bool(_shootout_pre.get("friendly", true)):
		if scored:
			mios += 1
		return _shootout_over(mios, suyos, vueltas + 1, vueltas)
	if scored:
		suyos += 1
	return _shootout_over(mios, suyos, vueltas + 1, vueltas + 1)





func _shootout_takers(team_id: String, mine: bool) -> Array:
	var out: Array = []

	var squad: Array = _squad_hoy(team_id)
	for i in mini(Squad.STARTING_XI, squad.size()):
		var row: Dictionary = squad[i]
		if String(row.get("pos", "")) == "POR":
			continue
		if mine and String(row.get("name", "")) == Career.player_name:
			continue





		if not mine and String(row.get("name", "")) in _expulsados_rival:
			continue



		if MatchSim.esta_fuera(mine, String(row.get("name", ""))):
			continue
		out.append(row)
	var bn: String = String(Squad.best_specialist(team_id, "penal").get("name", ""))
	for i in out.size():
		if String(out[i].get("name", "")) == bn and i > 0:
			var spec: Dictionary = out[i]
			out.remove_at(i)
			out.insert(0, spec)
			break
	return out





