func _pase_rozado() -> bool:
	if not _suelto_de_desvio():
		return false
	for t in _desv_toques:
		if String(t.get("tipo", "")) != "desvio" or not t.has("v_out"):
			return false
		var a: Vector3 = t["v_in"]
		var b: Vector3 = t["v_out"]
		var ha := Vector2(a.x, a.z)
		var hb := Vector2(b.x, b.z)
		if ha.length() < 0.1 or hb.length() < 0.1:
			return false
		if rad_to_deg(absf(ha.angle_to(hb))) > DESV_PASE_ROZADO_DEG:
			return false
	return true


