func _gesto_cabe(mio: String, og: bool) -> bool:
	_gesto_fichas = []
	_celeb_ctx_pre = {}
	_celeb_rolls_pre = []
	var tuyo: bool = mio == "goal" and not og and not _cedida_en_curso \
			and not (_pass_done and _last_toucher != null and is_instance_valid(_last_toucher))
	if not tuyo or _gesto_usado or _festejo_revivido:
		return false
	if not _force_celeb_spot.is_empty() or not _force_celeb_gesture.is_empty():
		return false
	if _nat_match() or (GameState.readonly_save and not _gesto_forzar):
		return false
	var focus_pos: Vector3 = _self_actor.position if (_self_actor \
			and is_instance_valid(_self_actor)) else Vector3(0.0, 0.0, 6.0)
	var ctx: Dictionary = _celeb_ctx_festejo(focus_pos, false, true)
	var roll_sitio: int = randi()
	var roll_gesto: int = randi()
	_celeb_ctx_pre = ctx
	_celeb_rolls_pre = [roll_sitio, roll_gesto]
	if not bool(ctx.get("partido", false)):
		return false
	if _celeb_prisa(ctx) or _celeb_honor(ctx):
		return false
	for k in ["hito", "final", "decisive", "back_injury", "dab_estreno", "chin_estreno",
			"ocarina_estreno", "pika_estreno", "pinguinazo_estreno"]:
		if bool(ctx.get(k, false)):
			return false
	if not String(ctx.get("idolo_estreno", "")).is_empty():
		return false
	if not _celeb_cascada_vista(ctx, true, _last_celeb_spot, roll_sitio, roll_gesto):
		return false
	if not GestoElegido.cargado(ctx, _celeb_spot_for(ctx, _last_celeb_spot, roll_sitio)):
		return false
	_gesto_fichas = GestoElegido.fichas(ctx, Settings.celebs_seen, _teammate_actors.size(),
		_celeb_coach_done)
	return not _gesto_fichas.is_empty()












func _gesto_pide() -> void:
	_gesto_usado = true
	_gesto_elegido = ""
	var forzada: String = _gesto_eleccion_forzada
	if not forzada.is_empty():
		_gesto_eleccion_forzada = ""
		_gesto_elegido = "" if forzada == "-" else forzada
		return
	if _hud == null or not is_instance_valid(_hud):
		return
	var arbol: SceneTree = SceneFade.arbol()
	_gesto_pausa_antes = arbol.paused
	_gesto_vivo = true
	arbol.paused = true
	if not tree_exiting.is_connected(_gesto_suelta):
		tree_exiting.connect(_gesto_suelta, CONNECT_ONE_SHOT)
	_hide_drive_ring()
	_hud.show_hint("")
	_gesto_chip_antes = _hud.hide_player_chip(true)
	if _audio != null and is_instance_valid(_audio):
		_audio.sigue_bajo_pausa(true)
	var ctx: Dictionary = _celeb_ctx_pre
	_hud.ask_gesto(_gesto_fichas, bool(ctx.get("away", false)),
		bool(ctx.get("coach_rift", false)), GestoElegido.carga(ctx), GestoElegido.ESPERA_S)
	var key: String = await _hud.gesto_elegido
	_gesto_suelta()
	if key in _gesto_fichas:
		_gesto_elegido = key




func _gesto_suelta() -> void:
	if not _gesto_vivo:
		return
	_gesto_vivo = false
	if tree_exiting.is_connected(_gesto_suelta):
		tree_exiting.disconnect(_gesto_suelta)






	var pausa_abierta: bool = _pause_menu != null and is_instance_valid(_pause_menu) \
			and _pause_menu.abierta()
	SceneFade.arbol().paused = _gesto_pausa_antes or pausa_abierta
	if _hud != null and is_instance_valid(_hud):
		_hud.hide_player_chip(not _gesto_chip_antes)
		_hud.clear_gesto()
	if _audio != null and is_instance_valid(_audio):
		_audio.sigue_bajo_pausa(false)





















func _celeb_ctx_festejo(focus_pos: Vector3, rival: bool, mio: bool) -> Dictionary:
	var fence: Dictionary = {}
	if _stadium != null and is_instance_valid(_stadium):
		fence = _stadium.fence_hug_spot(focus_pos.z)
	var ctx: Dictionary = _celeb_context()


	ctx["fence"] = fence
	ctx["hay_valla"] = not fence.is_empty()
	ctx["hay_camara"] = _stadium != null and is_instance_valid(_stadium) \
			and _stadium.camera_op_spot(focus_pos) != Vector3.INF






	ctx["hay_rincon"] = _stadium == null or not is_instance_valid(_stadium) \
			or _stadium.away_stand_spot().z < Stadium.FIELD_DEPTH * 0.5




	ctx["hay_focos"] = _stadium != null and is_instance_valid(_stadium) \
			and bool(_stadium.weather.get("floodlights", false))



	ctx["hay_charco"] = _stadium != null and is_instance_valid(_stadium) \
			and bool(_stadium.weather.get("rain", false)) \
			and not _puddle_near(focus_pos).is_empty()



	ctx["hito"] = not rival and _celeb_es_hito(mio)
	return ctx

















static func _gesto_de_eleccion(key: String, spot: String, ctx: Dictionary,
		roll_gesto: int) -> String:
	var g: String = GestoElegido.gesto(key)
	if not g.is_empty():
		return g
	var sin_ex: Dictionary = ctx.duplicate()
	sin_ex.erase("ex_club")
	var c: String = _celeb_gesture_for(spot, sin_ex, true, roll_gesto)

	var id: String = Celebs.id_for(Celebs.GESTO, c) if not c.is_empty() else ""
	if not id.is_empty() and not Settings.celeb_seen(id):
		return ""
	return c






