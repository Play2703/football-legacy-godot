		pool = spots
	return String(pool[roll % pool.size()])
















func _puddle_near(from: Vector3) -> Dictionary:
	if _stadium == null or not is_instance_valid(_stadium) \
			or _stadium.puddles == null or _stadium.puddles.list.is_empty():
		return {}
	var best: Dictionary = {}
	var best_d: float = INF
	for p in _stadium.puddles.list:
		if float(p.get("r", 0.0)) < PUDDLE_MIN_R:
			continue
		var d: float = Vector2(float(p["x"]) - from.x, float(p["z"]) - from.z).length()
		if d < best_d and d <= PUDDLE_MAX_D:
			best_d = d
			best = p
	return best














func _celeb_anchor(spot: String, side: float, scorer: Vector3,
		dir: float = 1.0) -> Dictionary:
	if dir < 0.0:
		var esp: Dictionary = _celeb_anchor(spot, side,
			Vector3(scorer.x, scorer.y, Stadium.FIELD_DEPTH - scorer.z), 1.0)
		var ep: Vector3 = esp["pos"]
		var ei: Vector2 = esp["inward"]
		return {"pos": Vector3(ep.x, ep.y, Stadium.FIELD_DEPTH - ep.z),
			"inward": Vector2(ei.x, - ei.y)}
	var y: float = scorer.y
	match spot:
		"grada":


			return {"pos": Vector3(side * randf_range(7.0, 11.0), y, -1.4),
				"inward": Vector2(- side * 0.35, 1.0).normalized()}
		"pina":

			return {"pos": Vector3(clampf(scorer.x, - Stadium.FIELD_HALF_W + 6.0,
				Stadium.FIELD_HALF_W - 6.0), y, maxf(scorer.z, 1.5)),
				"inward": Vector2(0.0, 1.0)}
		"banquillo":




			var dug: Vector3 = _stadium.dugout_focus(_home_match) \
					if (_stadium != null and is_instance_valid(_stadium)) \
					else Vector3(side *(Stadium.FIELD_HALF_W - 1.5), y, 24.0)
			var bs: float = signf(dug.x) if absf(dug.x) > 0.01 else side


			return {"pos": Vector3(bs *(Stadium.FIELD_HALF_W - 1.2), y, dug.z),
				"inward": Vector2(- bs, 0.0)}
		CELEB_SPOT_COACH:









			var cs: Vector3 = _stadium.coach_spot(_home_match) \
					if (_stadium != null and is_instance_valid(_stadium)) \
					else Vector3(- Stadium.FIELD_HALF_W - 1.9, y, Stadium.HALF_LINE)
			var ks: float = signf(cs.x) if absf(cs.x) > 0.01 else side
			var lado: float = signf(scorer.z - cs.z) if absf(scorer.z - cs.z) > 0.01 else -1.0
			return {"pos": Vector3(cs.x, y, cs.z + lado * CELEB_COACH_SIDE_M),
				"inward": Vector2(- ks, 0.0)}
		CELEB_SPOT_ALL:


			return {"pos": Vector3(clampf(scorer.x, - Stadium.FIELD_HALF_W + 6.0,
				Stadium.FIELD_HALF_W - 6.0), y, maxf(scorer.z, 2.0)),
				"inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_AWAY:




			var aw: Vector3 = _stadium.away_stand_spot() \
					if (_stadium != null and is_instance_valid(_stadium)) \
					else Vector3(27.0, y, -1.5)
			return {"pos": Vector3(aw.x, y, aw.z),
				"inward": Vector2(-0.55, 1.0).normalized()}
		CELEB_SPOT_DERBY:



			return {"pos": Vector3(side * randf_range(7.0, 11.0), y, -1.8),
				"inward": Vector2(- side * 0.35, 1.0).normalized()}
		CELEB_SPOT_FENCE, CELEB_SPOT_FENCE_SIT:








			return {"pos": Vector3(Stadium.FIELD_HALF_W - 2.0, y,
				clampf(scorer.z, Stadium.FENCE_Z_MIN, Stadium.FENCE_Z_MAX)),
				"inward": Vector2(-1.0, 0.0)}
		CELEB_SPOT_CAM:













			var op: Vector3 = _stadium.camera_op_spot(scorer) \
					if (_stadium != null and is_instance_valid(_stadium)) else Vector3.INF
			if op == Vector3.INF:
				op = Vector3(-8.5, 0.0, -7.0)
			var inw: Vector2 = Vector2(- signf(op.x), 0.0) \
					if absf(op.x) >= Stadium.FIELD_HALF_W - 1.0 else Vector2(0.0, 1.0)
			var cp: Vector2 = Vector2(op.x, op.z) + inw * CELEB_CAM_STOP_M
			return {"pos": Vector3(clampf(cp.x, - Stadium.FIELD_HALF_W + 1.5,
				Stadium.FIELD_HALF_W - 1.5), y, maxf(cp.y, CELEB_CAM_Z_MIN)),
				"inward": inw}
		CELEB_SPOT_PUDDLE:



			var pud: Dictionary = _puddle_near(scorer)
			if pud.is_empty():



				return {"pos": Vector3(clampf(scorer.x, - Stadium.FIELD_HALF_W + 6.0,
					Stadium.FIELD_HALF_W - 6.0), y, maxf(scorer.z, 1.5)),
					"inward": Vector2(0.0, 1.0)}
			return {"pos": Vector3(float(pud["x"]), y, float(pud["z"])),
				"inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_SOLO:





			return {"pos": Vector3(clampf(scorer.x, - Stadium.FIELD_HALF_W + 6.0,
				Stadium.FIELD_HALF_W - 6.0), y, maxf(scorer.z, 1.5)),
				"inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_AREA:





			return {"pos": Vector3(0.0, y, 11.0), "inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_GK:




			return {"pos": Vector3(clampf(scorer.x * 0.3, -8.0, 8.0), y,
				scorer.z + CELEB_ADVANCE_M), "inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_PRESS:




			return {"pos": Vector3(side * randf_range(6.0, 10.0), y, -2.2),
				"inward": Vector2(- side * 0.3, 1.0).normalized()}
		CELEB_SPOT_BOX:





			var ps: float = signf(scorer.x) if absf(scorer.x) > 1.5 else side





			return {"pos": Vector3(ps *(Stadium.FIELD_HALF_W - 1.2), y,
				clampf(scorer.z, 2.0, Stadium.HALF_LINE)),
				"inward": Vector2(- ps, 0.0)}
		"medio":




			return {"pos": Vector3(clampf(scorer.x * 0.4, -6.0, 6.0), y,
				scorer.z + 9.0), "inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_PASILLO:



			return {"pos": Vector3(clampf(scorer.x, -10.0, 10.0), y,
				clampf(scorer.z, 4.0, 14.0)), "inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_TREN:



			return {"pos": Vector3(clampf(scorer.x * 0.3, -5.0, 5.0), y,
				clampf(scorer.z + 6.0, 12.0, 20.0)), "inward": Vector2(0.0, 1.0)}
		CELEB_SPOT_CORRO:

			return {"pos": Vector3(clampf(scorer.x * 0.5, -8.0, 8.0), y,
				clampf(scorer.z + 3.0, 6.0, 14.0)), "inward": Vector2(0.0, 1.0)}
		_:







			var cs: float = signf(scorer.x) if absf(scorer.x) > 1.5 else side
			return {"pos": Vector3(cs * 34.0, y, 1.0),
				"inward": Vector2(- cs, 0.55).normalized()}
















