	var chance: Dictionary = _chance_from_origin(origin)
	chance["kind"] = CONTRA_KIND
	chance["volcado"] = volcado
	chance["correa"] = CONTRA_CORREA_R
	chance["correa_ruptura"] = CONTRA_CORREA_RUPTURA
	return chance
















