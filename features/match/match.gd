func _offer_leash(reason: int) -> float:
	match reason:
		Offer.RUPTURA:
			return _correa_ruptura
		Offer.APOYO:
			return MATE_SHORT_MAX_M
	return MATE_OFFER_MAX_M




func _offer_reason(pos: Vector2, short_taken: bool) -> int:


























	if _defender_pos.is_empty():
		return -1
	if Duel.covered(pos, _defender_pos):
		return Offer.MARCA
	if not Duel.free_mate(pos, _defender_pos):

		return -1


	if pos.length() <= _ball_field.length():
		return Offer.RUPTURA


	if pos.distance_to(_ball_field) <= OFFER_SHORT_R:
		return -1
	return Offer.APOYO if not short_taken else -1









func _offer_cap() -> int:
	if _play_style == MatchPlan.Style.OFENSIVO:
		return OFFER_MAX_RUNNERS + 1
	if _play_style == MatchPlan.Style.DEFENSIVO:
		return maxi(OFFER_MAX_RUNNERS - 1, 1)
	return OFFER_MAX_RUNNERS









func _offer_target(pos: Vector2, line_z: float, reason: int,
		extra_obs: Array[Vector2] = []) -> Vector2:
	var goal: Vector2
	if reason == Offer.APOYO:

		var to_ball: Vector2 = _ball_field - pos
		var largo: float = minf(maxf(to_ball.length() - OFFER_SHORT_R, 0.0), MATE_SHORT_MAX_M)
		goal = _inside_field(pos + to_ball.normalized() * largo)
	elif reason == Offer.RUPTURA:



		var lado: float = signf(pos.x - _ball_field.x)
		if lado == 0.0:
			lado = 1.0
		var al_arco: Vector2 =(Vector2.ZERO - pos).normalized() \
				if pos.length() > 0.01 else Vector2(0.0, -1.0)
		var dir: Vector2 =(al_arco + Vector2(lado * 0.45, 0.0)).normalized()
		goal = _inside_field(pos + dir * _correa_ruptura)
	else:



		var marker: Vector2 = pos
		var best: float = INF
		for d in _defender_pos:
			var dd: float = pos.distance_to(d)
			if dd < best:
				best = dd
				marker = d
		goal = _inside_field(
			pos + Duel.mate_run(pos, marker, _ball_field, true) * MATE_OFFER_MAX_M)




	goal = _inside_field(pos + _clear_lane(pos, goal - pos, extra_obs))




	if not is_inf(line_z):
		goal.y = maxf(goal.y, line_z + Duel.ONSIDE_SLACK)







		if reason == Offer.RUPTURA and goal.length() >= pos.length():
			var max_x2: float = pos.length_squared() - goal.y * goal.y
			if max_x2 > 0.25:
				goal.x = signf(goal.x) * minf(absf(goal.x), sqrt(max_x2) - 0.3)
			else:


				goal = pos
	return goal











func _mate_offer_step(delta: float) -> void:



	if _corner_move:
		return
	var braking: bool = _press_coast
	var line_z: float = _onside_line_z()
	var running: int = 0
	var short_taken: bool = false
	for t in _teammate_actors:
		if float(_offer_burst.get(t, 0.0)) > 0.0:




			if not _pasador_rafaga.has(t):
				running += 1
			if int(_offer_why.get(t, Offer.MARCA)) == Offer.APOYO:
				short_taken = true



	if not short_taken:
		for t in _teammate_actors:
			if is_instance_valid(t) and t != _self_actor \
					and Vector2(t.position.x, t.position.z).distance_to(_ball_field) <= OFFER_SHORT_R:
				short_taken = true
				break
	for t in _teammate_actors:
		if not _offer_eligible(t):
			continue


		if _order_holds(t):
			continue
		var pos: Vector2 = Vector2(t.position.x, t.position.z)
		if not _offer_home.has(t):
			_offer_home[t] = pos







			if t.has_meta("order_fired") and not is_inf(line_z) \
					and pos.y < line_z + Duel.ONSIDE_SLACK:
				_offer_recula[t] = true
				_offer_home[t] = Vector2(pos.x, line_z + Duel.ONSIDE_SLACK)
			_offer_vels[t] = Vector2.ZERO
			_offer_burst[t] = 0.0








			_offer_cd[t] = minf(OFFER_STAGGER_STEP * float(_teammate_actors.find(t)),
				OFFER_STAGGER_MAX)
		var burst: float = float(_offer_burst[t])
		var cd: float = float(_offer_cd[t])
		if not braking:
			if burst > 0.0:
				burst = maxf(0.0, burst - delta)
				if burst <= 0.0:




					cd = Duel.BURST_CD *(1.0 - OFFER_CD_JIT
						+ 2.0 * OFFER_CD_JIT * fmod(float(_teammate_actors.find(t)) * 0.618, 1.0))

					cd +=(1.0 - _mate_q(t)) * MATE_SLOW_S
					_offer_goal.erase(t)

					_pasador_rafaga.erase(t)
			elif cd > 0.0:
				cd = maxf(0.0, cd - delta)
			elif running < _offer_cap() \
					and pos.distance_to(_ball_field) <= _correa_r:

				var why: int = _offer_reason(pos, short_taken)


				if why == Offer.RUPTURA and _play_style == MatchPlan.Style.DEFENSIVO:
					why = Offer.APOYO if not short_taken else -1
				if why >= 0:
					burst = Duel.BURST_T
					running += 1
					if why == Offer.APOYO:
						short_taken = true
					_offer_why[t] = why
					var meta_o: Vector2 = _offer_target(pos, line_z, why)

					_offer_dec[t] = int(_offer_dec.get(t, 0)) + 1
					meta_o.x += _mate_err_x(t, _teammate_actors.find(t), int(_offer_dec[t]))
					_offer_goal[t] = _inside_field(meta_o)
		_offer_burst[t] = burst
		_offer_cd[t] = cd
		var goal: Vector2 = _offer_goal.get(t, pos)











		var recula: bool = bool(_offer_recula.get(t, false)) \
				and not is_inf(line_z) and pos.y < line_z + Duel.ONSIDE_SLACK
		if recula:
			goal = Vector2(pos.x, line_z + Duel.ONSIDE_SLACK)
		else:


			_offer_recula.erase(t)


		var pasa_y_va: bool = _pasador_rafaga.has(t)
		var spd: float = _chaser_speed.get(t, AimPress.SPEED_FALLBACK) \
				*(PASADOR_MULT if pasa_y_va else MATE_OFFER_MULT)
		var vel: Vector2 = _offer_vels.get(t, Vector2.ZERO)
		var out: Array



		if braking or (not recula
				and (burst <= 0.0 or pos.distance_to(goal) < MATE_OFFER_STOP)):
			out = Drive.press_brake(pos, vel, spd, delta, _rival_accel_k(t))
		else:
			out = Duel.step_defender(pos, vel, goal, spd, delta, _rival_accel_k(t))
		var np: Vector2 = _inside_field(out[0])








		var home: Vector2 = _offer_home[t]
		var correa: float = _offer_leash(int(_offer_why.get(t, Offer.MARCA)))














		correa = maxf(correa, pos.distance_to(home))
		if not recula and np.distance_to(home) > correa:
			np = home +(np - home).normalized() * correa



		if pasa_y_va:
			np = _pasador_fuera_del_disco(np)






		if not is_inf(line_z) and not recula:
			var np_libre: float = np.y
			np.y = maxf(np.y, line_z + Duel.ONSIDE_SLACK)




			if np.y > np_libre and (np - pos).dot(goal - pos) <= 0.0:
				t.set_meta("de_frente_hasta", Time.get_ticks_msec() + DE_FRENTE_MS)
		_offer_vels[t] = out[1]
		t.position = Vector3(np.x, t.position.y, np.y)







		if (out[1] as Vector2).length() > 0.1:
			_run_target[t] = Vector3(goal.x, t.position.y, goal.y)
			if float(_offer_burst.get(t, 0.0)) > 0.0:
				t.set_meta("pace_run_until", Time.get_ticks_msec() + 400)
		else:
			_run_target.erase(t)









func _cover_shares(active: Array[int]) -> Dictionary:



	var lane: Vector2 = - _ball_field
	if lane.length() < 1.0:
		return {}
	var perp: Vector2 = Vector2(- lane.y, lane.x).normalized()
	var orden: Array = []
	for i in _rival_actors.size():
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or i >= _defender_pos.size():
			continue
		if active.has(i) or a.has_meta("hold_wall"):
			continue
		orden.append([(_defender_pos[i] - _ball_field).dot(perp), i])
	orden.sort_custom(func(x: Array, y: Array) -> bool: return x[0] < y[0])
	var out: Dictionary = {}
	for k in orden.size():
		out[orden[k][1]] = AimPress.cover_share(k, orden.size())
	return out


























const TRACK_R: float = 14.0



const TRACK_MULT: float = 0.5



const TRACK_MAX: int = 3








func _track_max() -> int:
	return META_TRACK_MAX if _meta_viva else TRACK_MAX






var _mark_of: Dictionary = {}
var _mark_vels: Dictionary = {}













var _mark_home: Dictionary = {}
const MARK_LEASH_M: float = 8.0



func _lane_dist(p: Vector2) -> float:
	var a: Vector2 = _ball_field
	var ab: Vector2 = - a
	var largo2: float = ab.length_squared()
	if largo2 < 0.01:
		return p.distance_to(a)
	var t: float = clampf((p - a).dot(ab) / largo2, 0.0, 1.0)
	return p.distance_to(a + ab * t)











func _ball_guard(old: Vector2, want: Vector2) -> Vector2:
	var n: Vector2 = old - _ball_field
	if n.length() < 0.05:
		return want
	n = n.normalized()
	var paso: Vector2 = want - old
	return old + paso - n * minf(paso.dot(n), 0.0)


func _lane_guard(old: Vector2, want: Vector2) -> Vector2:
	var d_old: float = _lane_dist(old)
	if d_old < 0.05 or _lane_dist(want) >= d_old:
		return want

	var a: Vector2 = _ball_field
	var ab: Vector2 = - a
	var largo2: float = ab.length_squared()
	var pie: Vector2 = a if largo2 < 0.01 \
			else a + ab * clampf((old - a).dot(ab) / largo2, 0.0, 1.0)
	var n: Vector2 =(old - pie)
	if n.length() < 0.001:
		return want
	n = n.normalized()
	var paso: Vector2 = want - old
	return old + paso - n * minf(paso.dot(n), 0.0)









func _marca_atras(t: AnimatedSprite3D) -> bool:
	return _repliegue_on() and t.position.z > _ball_field.y + REPL_MARCA_M




func _mark_assign(active: Array[int], line_i: int) -> void:
	var tomados: Dictionary = {}

	for i in _mark_of.keys():
		var t: AnimatedSprite3D = _mark_of[i]
		var vale: bool = i < _defender_pos.size() and is_instance_valid(t) \
				and not active.has(i) and _mark_eligible(i, line_i) and not _marca_atras(t) \
				and _defender_pos[i].distance_to(Vector2(t.position.x, t.position.z)) \
				<= _track_r(i) \
				and Vector2(t.position.x, t.position.z).distance_to(
				_mark_home.get(i, _defender_pos[i])) <= MARK_LEASH_M
		if vale:
			tomados[t] = true
		else:
			if is_instance_valid(t) and _marca_atras(t):
				_marca_soltada[i] = true
			_mark_of.erase(i)
			_mark_vels.erase(i)
			_mark_home.erase(i)












	for t in _teammate_actors:
		if _mark_of.size() >= _track_max():
			break
		if not is_instance_valid(t) or t == _self_actor or tomados.has(t) \
				or not _corriendo_al_pase(t) or _marca_atras(t):
			continue
		var hombre_p: Vector2 = Vector2(t.position.x, t.position.z)
		var best_i: int = -1


		var best_rel: float = 1.0
		for i in _rival_actors.size():
			if i >= _defender_pos.size() or _mark_of.has(i) or active.has(i) \
					or not _mark_eligible(i, line_i):
				continue

			if _defender_pos[i].distance_to(hombre_p) > _mark_toma_r(i):
				continue
			var rel: float = _defender_pos[i].distance_to(hombre_p) / _track_r(i)
			if rel < best_rel:
				best_rel = rel
				best_i = i
		if best_i >= 0:
			_mark_of[best_i] = t
			_mark_home[best_i] = _defender_pos[best_i]
			tomados[t] = true
	for i in _rival_actors.size():
		if _mark_of.size() >= _track_max():
			break
		if _mark_of.has(i) or active.has(i) or not _mark_eligible(i, line_i):
			continue
		var best: AnimatedSprite3D = null
		var best_d: float = _mark_toma_r(i)
		for t in _teammate_actors:
			if not is_instance_valid(t) or tomados.has(t) or t == _self_actor or _marca_atras(t):
				continue
			var d: float = _defender_pos[i].distance_to(Vector2(t.position.x, t.position.z))
			if d < best_d:
				best_d = d
				best = t
		if best != null:
			_mark_of[i] = best
			_mark_home[i] = _defender_pos[i]
			tomados[best] = true

















func _mark_toma_r(i: int) -> float:
	return minf(_track_r(i), MARK_LEASH_M)














func _mark_eligible(i: int, line_i: int) -> bool:
	if i >= _defender_pos.size() or i >= _rival_actors.size():
		return false
	var a: AnimatedSprite3D = _rival_actors[i]
	return is_instance_valid(a) and not a.has_meta("hold_wall") and i != line_i







func _corriendo_al_pase(t: AnimatedSprite3D) -> bool:
	if float(_offer_burst.get(t, 0.0)) > 0.0:
		return true
	var idx: int = _teammate_actors.find(t)
	return idx >= 0 and float(_drive_mate_risk.get(idx, 0.0)) > 0.0











func _mark_step(delta: float, active: Array[int], braking: bool) -> void:






	for i in _mark_of.keys():
		var t: AnimatedSprite3D = _mark_of[i]
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(t) or not is_instance_valid(a):
			continue

		if _order_owned(a):
			continue
		var hombre: Vector2 = Vector2(t.position.x, t.position.z)


		var rumbo: Vector2 = _offer_vels.get(t, Vector2.ZERO)
		if rumbo.length() < 0.2:




			var idx_t: int = _teammate_actors.find(t)
			if idx_t >= 0 and idx_t < _drive_mate_vels.size():
				rumbo = _drive_mate_vels[idx_t]
		if rumbo.length() < 0.2:
			rumbo =(Vector2.ZERO - hombre).normalized() if hombre.length() > 0.01 \
					else Vector2(0.0, -1.0)
		else:
			rumbo = rumbo.normalized()
		var meta_m: Vector2 = Duel.cover_point(hombre, rumbo)




		var spd: float = minf(_chaser_speed.get(a, AimPress.SPEED_FALLBACK) * TRACK_MULT,
			AimPress.COVER_SPEED)
		var vel: Vector2 = _mark_vels.get(i, Vector2.ZERO)
		var out: Array = Drive.press_brake(_defender_pos[i], vel, spd, delta,
			_rival_accel_k(a)) if braking \
					else Duel.step_defender(_defender_pos[i], vel, meta_m, spd, delta,
			_rival_accel_k(a))





		var old: Vector2 = _defender_pos[i]
		var np: Vector2 = _inside_field(_lane_guard(old, _ball_guard(old, out[0])))
		if _lane_dist(np) < _lane_dist(old) - 0.001 \
				or np.distance_to(_ball_field) < old.distance_to(_ball_field) - 0.001:
			np = old
		_mark_vels[i] = out[1]
		_defender_pos[i] = np
		a.position = Vector3(np.x, a.position.y, np.y)
		if (out[1] as Vector2).length() > 0.1:
			_run_target[a] = Vector3(meta_m.x, a.position.y, meta_m.y)
		else:
			_run_target.erase(a)

















func _press_lanes(active: Array[int]) -> Dictionary:
	var out: Dictionary = {}
	if active.size() <= 1:
		return out
	var lane: Vector2 = - _ball_field
	if lane.length() < 1.0:
		return out
	var perp: Vector2 = Vector2(- lane.y, lane.x).normalized()

	var izq: Array = []
	var der: Array = []
	for k in range(1, active.size()):
		var i: int = active[k]
		if i >= _defender_pos.size():
			continue
		var lat: float =(_defender_pos[i] - _ball_field).dot(perp)
		if lat < 0.0:
			izq.append([lat, i])
		else:
			der.append([lat, i])


	izq.sort_custom(func(x: Array, y: Array) -> bool: return x[0] > y[0])
	der.sort_custom(func(x: Array, y: Array) -> bool: return x[0] < y[0])
	for k in izq.size():
		out[izq[k][1]] = -(1.0 + 0.9 * float(k))
	for k in der.size():
		out[der[k][1]] = 1.0 + 0.9 * float(k)
	return out



















func _press_step(delta: float) -> void:


	if _drive_beat:
		return
	while _press_vels.size() < _rival_actors.size():
		_press_vels.append(Vector2.ZERO)
	var active: Array[int] = _press_active()








	_mate_offer_step(delta)




	if active.is_empty() and not _press_coast:
		return
	_press_react_ensure()





















	for ri in _press_react.size():
		_press_react_drain(ri, delta)










	var line_i: int = _line_holder(active)




	var share: Dictionary = _cover_shares(active)

	var lanes: Dictionary = _press_lanes(active)




	_mark_assign(active, line_i)
	for i in _rival_actors.size():
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or i >= _defender_pos.size():
			continue







		if _order_owned(a):
			continue
		if not active.has(i):




			_run_target.erase(a)

			if a.has_meta("hold_wall") or i == line_i:
				continue


			if _mark_of.has(i):
				continue
			var quiere: Vector2 = AimPress.cover_point(_defender_pos[i], _ball_field,
				float(share.get(i, 0.0)))
			if quiere == _defender_pos[i]:
				continue
			_defender_pos[i] = _inside_field(
				_defender_pos[i].move_toward(quiere, AimPress.COVER_SPEED * delta))
			a.position = Vector3(_defender_pos[i].x, a.position.y, _defender_pos[i].y)
			continue




		var spd: float = _chaser_speed.get(a, AimPress.SPEED_FALLBACK)
		var meta_i: Vector2 = Drive.press_point(_ball_field, _defender_pos[i],
			float(lanes.get(i, 0.0)))
		var out: Array = Drive.press_brake(_defender_pos[i], _press_vels[i],
			spd, delta, _rival_accel_k(a)) if _press_coast \
					else Drive.press_step(_defender_pos[i],
			_press_vels[i], meta_i, spd, delta, _rival_accel_k(a))


		_defender_pos[i] = _inside_field(out[0])
		_press_vels[i] = out[1]
		a.position = Vector3(_defender_pos[i].x, a.position.y, _defender_pos[i].y)




		if (out[1] as Vector2).length() > 0.1:


			_run_target[a] = Vector3(meta_i.x, a.position.y, meta_i.y)
		else:
			_run_target.erase(a)



	_mark_step(delta, active, _press_coast)


















	_relax_defenders()




	if _press_steal and not _press_coast and Settings.dif_steal_on():
		var thief: int = _press_stealer(active)
		if thief >= 0:
			_press_stolen(thief)
			return
	if not _press_coast:
		return


	_press_coast_t += delta
	var moving: bool = false
	for i in active:
		if i < _press_vels.size() and _press_vels[i].length() >= Drive.COAST_STOP:
			moving = true
	if moving and _press_coast_t < Drive.COAST_MAX_T:
		return
	_press_end_coast()

func _press_stealer(active: Array[int]) -> int:
	var tk: Array = _rival_tackles()
	var hit: int = -1
	var margen: float = INF
	for i in active:
		if i >= _defender_pos.size():
			continue


		var keep: float = Duel.steal_radius(_drive_control,
			float(tk[i]) if i < tk.size() else Duel.NEUTRAL_TACKLE) \
					+ Settings.dif_reach_off()
		var m: float = _defender_pos[i].distance_to(_ball_field) - keep
		margen = minf(margen, m)
		if m <= 0.0 and hit < 0:
			hit = i
	_avisa_robo(margen)
	return hit

















const ROBO_AVISO_M: float = 2.6



const ROBO_AVISO_BOOST_GOLPEO: float = 1.9





var _robo_aviso: float = 0.0





func _margen_robo(defs: Array, tk: Array, control: float) -> float:
	var margen: float = INF
	for i in defs.size():


		var keep: float = Duel.steal_radius(control,
			float(tk[i]) if i < tk.size() else Duel.NEUTRAL_TACKLE) \
					+ Settings.dif_reach_off()
		margen = minf(margen,(defs[i] as Vector2).distance_to(_ball_field) - keep)
	return margen


func _avisa_robo(margen: float) -> void:
	if _hud == null or not is_instance_valid(_hud):
		return









	if state != State.STRIKING or not Settings.dif_aviso_robo():
		if _robo_aviso != 0.0:
			_robo_aviso = 0.0
			_hud.set_danger(0.0)
		return
	var t: float = 0.0
	if margen < ROBO_AVISO_M:
		t = clampf(1.0 - margen / ROBO_AVISO_M, 0.0, 1.0)


	var dt: float = maxf(get_process_delta_time(), 0.001)
	var k: float = 1.0 - pow(0.001 if t > _robo_aviso else 0.25, dt)
	_robo_aviso = lerpf(_robo_aviso, t, clampf(k, 0.0, 1.0))


	_hud.set_danger(_robo_aviso, ROBO_AVISO_BOOST_GOLPEO)






func _apaga_aviso_robo() -> void:
	_robo_aviso = 0.0
	if _hud != null and is_instance_valid(_hud):
		_hud.set_danger(0.0)












func _press_stolen(i: int) -> void:
	if i < 0 or i >= _defender_pos.size():
		return



	if i < _rival_actors.size():
		_play_slide_gesture(_rival_actors[i])
	_bump(BUMP_ROBO)
	_press_freeze(true)


	_aiming = false
	_aim_finger = -1
	_aim.hide_aim()
	_haptic(30)


	var from: Vector2 = _defender_pos[i] - _ball_field


	_al_contacto(_play_self_fall.bind(
		from.normalized() if from.length() > 0.001 else Vector2(0.0, 1.0),
		DUEL_LOST_HOLD_MS))







	var tirador: AnimatedSprite3D = _robo_area_conduce(i)



	_despedir_balon(_press_vels[i] if i < _press_vels.size() else Vector2.ZERO,
		- from.normalized() if from.length() > 0.001 else Vector2(0.0, 1.0), false)
	if tirador != null:
		_robo_area_compas(tirador)
		return



	_resolve_chance("switch_fail" if _switch_active else "dribble_lost")





















func _press_react_ensure() -> void:
	var reparto: bool = _press_react.is_empty()
	while _press_react.size() < _rival_actors.size():
		var ra: AnimatedSprite3D = _rival_actors[_press_react.size()]
		_press_react.append(
			AimPress.react_delay(_match_w_hoy(), _react_q(ra)) if reparto else 0.0)































func _world_k(con_golpeo: bool = true) -> float:
	if not _press_on:
		return 1.0
	if state != State.AIMING and state != State.STRIKING:
		return 1.0

	if _saque_lenta_off:
		return 1.0

















	var mul: float = STRIKE_SLOW_MUL if (con_golpeo and state == State.STRIKING) else 1.0
	if _slow_enter_t >= SLOW_ENTER_S:
		return _slow_k * mul
	var t: float = clampf(_slow_enter_t / SLOW_ENTER_S, 0.0, 1.0)
	return lerpf(1.0, _slow_k, 1.0 - pow(1.0 - t, 2.0)) * mul












































func _pace_world_k() -> float:
	return _world_k() * clampf(Engine.time_scale, 0.05, 1.0) * _servicio_reloj_ruta()








func _press_react_drain(i: int, delta: float) -> void:
	if i < _press_react.size() and _press_react[i] > 0.0:
		_press_react[i] = maxf(0.0, _press_react[i] - delta)


func _press_reacting(i: int, delta: float, resting: bool) -> bool:
	if resting or i >= _press_react.size() or _press_react[i] <= 0.0:
		return false
	_press_react[i] = maxf(0.0, _press_react[i] - delta)
	return true










func _press_freeze(hard: bool) -> void:
	if hard:
		_press_coast = false
		_press_coast_t = 0.0
		_press_release_actors()
		return
	if not _press_on or _press_coast:
		return
	_press_coast = true
	_press_coast_t = 0.0



func _press_end_coast() -> void:
	_press_coast = false
	_press_coast_t = 0.0
	_press_clear_photo()
	_press_release_actors()













func _press_clear_photo() -> void:
	if not _press_steal:
		return
	var tk: Array = _rival_tackles()
	for i in _press_active():
		if i >= _defender_pos.size():
			continue
		var keep: float = Duel.steal_radius(_drive_control,
			float(tk[i]) if i < tk.size() else Duel.NEUTRAL_TACKLE)
		var to: Vector2 = _defender_pos[i] - _ball_field
		var d: float = to.length()
		if d >= keep:
			continue
		var dir: Vector2 = to / d if d > 0.001 else Vector2(0.0, 1.0)
		_defender_pos[i] = _inside_field(_ball_field + dir * keep)
		if i < _press_vels.size():
			_press_vels[i] = Vector2.ZERO
		var a: AnimatedSprite3D = _rival_actors[i] if i < _rival_actors.size() else null
		if is_instance_valid(a):
			a.position = Vector3(_defender_pos[i].x, a.position.y, _defender_pos[i].y)





func _press_release_actors() -> void:





	for a in _rival_actors:
		if is_instance_valid(a) and _run_target.has(a) and not _order_owned(a):
			_run_target.erase(a)
			a.speed_scale = 1.0




	for t in _teammate_actors:
		if is_instance_valid(t) and _offer_home.has(t) and _run_target.has(t) \
				and not _order_owned(t):
			_run_target.erase(t)
			t.speed_scale = 1.0












func _update_drive_steer(screen_pos: Vector2, _from_ring: bool = false) -> void:



















	var pull: Vector2 = _ring_screen_center() - screen_pos
	if pull.length() < DRIVE_STEER_DEADZONE:
		_drive_steer = Vector2.ZERO
		_aim.hide_aim()
		return
	var dir3: Vector3 = _world_aim_dir(pull.normalized())
	_drive_steer = Vector2(dir3.x, dir3.z).normalized()


























































































































































































































