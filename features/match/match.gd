func _play_clear_gesture(actor: AnimatedSprite3D, header: bool) -> void:
	if actor == null or not is_instance_valid(actor):
		return



	var away: Vector3 = Vector3(0.0, 0.0, 1.0)


	var anim: String =("header_" if header else "despeje_") + _dir_name(away)



	if not _gesto_listo(actor, anim):
		anim = "kick_" + _dir_name(away)
	if not _gesto_listo(actor, anim):
		return
	actor.play(anim)


	_gesto_en_contacto(actor)
	_anim_lock[actor] = Time.get_ticks_msec() + 600
	if anim.begins_with("header_"):
		var base_y: float = actor.position.y
		var jump_tw: Tween = create_tween()
		jump_tw.tween_property(actor, "position:y", base_y + 0.55, GOLPE_SALTO_SUBE_T) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		jump_tw.tween_property(actor, "position:y", base_y, 0.3) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)




func _gesto_en_contacto(actor: AnimatedSprite3D) -> void:
	var k: int = _cuadro_contacto(String(actor.animation))
	if actor.sprite_frames != null \
			and actor.sprite_frames.get_frame_count(actor.animation) > k:
		actor.set_frame_and_progress(k, 0.0)




func _cuadro_contacto(anim: String) -> int:
	return DESPEJE_CUADRO_CONTACTO if anim.begins_with("despeje_") else GOLPE_CUADRO_CONTACTO



func _simulate_clear(pos: Vector3) -> void:
	_traj = []
	_splashes = []
	_splash_i = 0
	_bmarks = []
	_bmark_i = 0





	_pre_clear = _outcome
	_outcome = "cleared"

	_libre_npc = LibreNpc.NO
	_cross_i = -1
	_verdict_i = -1



	_desv_toques.clear()
	_desv_iba_fuera = false
	_desv_cruce0 = Vector3.INF
	_desv_vistos = 0
	_desv_i = -1
	_barr_mudo_i = -1
	_zancadas.clear()
	_zancadas_vistas = 0
	var dir_x: float = clampf(- pos.x * 0.02, -0.4, 0.4) + randf_range(-0.3, 0.3)
	var vel: Vector3 = Vector3(dir_x, 0.0, 1.0).normalized() * randf_range(15.0, 19.0)
	vel.y = randf_range(4.5, 7.0)








	vel.y *= lerpf(1.0, CLEAR_VY_ALTO, clampf(pos.y / HEADER_MAX_H, 0.0, 1.0))



	var pud: Puddles = _stadium.puddles if _stadium != null else null
	var lluvia: bool = _stadium != null \
			and bool(_stadium.weather.get("rain", false))
	var wake_step: int = -999
	var was_dry: bool = true
	_cam_mi_linea = Vector3.INF
	for step in 320:
		_traj.append(pos)
		vel.y -= 9.8 * SIM_DT
		vel *= 1.0 - 0.12 * SIM_DT
		pos += vel * SIM_DT
		var wet: float = 0.0
		if pud != null and pos.y <= 0.02:
			wet = pud.depth_at(pos.x, pos.z)
			if wet <= PUDDLE_MIN:
				wet = 0.0
		if pos.y < 0.0:
			pos.y = 0.0
			if absf(vel.y) > 1.5:
				_queue_mark(pos, vel.y)


				vel.y = - vel.y * lerpf(_cesped_bote
					*(1.0 + randf_range(- _cesped_jitter, _cesped_jitter)),
					PUDDLE_BOUNCE, wet)
				var keep: float = lerpf(0.85, PUDDLE_SKID, wet)
				vel.x *= keep
				vel.z *= keep
				if wet > 0.0:
					_add_splash(pos, vel,
						Vector2(vel.x, vel.z).length() + absf(vel.y) * 2.0, true)
					wake_step = step
					was_dry = false
			else:
				vel.y = 0.0
		if pos.y == 0.0 and vel.y == 0.0:
			var roll_k: float = _cesped_drag + PUDDLE_ROLL_DRAG * wet
			vel.x *= 1.0 - roll_k * SIM_DT
			vel.z *= 1.0 - roll_k * SIM_DT
			var spd: float = Vector2(vel.x, vel.z).length()
			if wet > 0.0:
				if spd > SPLASH_WAKE_SPEED and step - wake_step >= SPLASH_GAP_STEPS:
					_add_splash(pos, vel, spd, was_dry)
					wake_step = step
				was_dry = false
			elif lluvia:



				if spd > WAKE_FILM_SPEED and step - wake_step >= SPLASH_GAP_FILM:
					_add_splash(pos, vel, spd * SPRAY_FILM, false)
					wake_step = step
				was_dry = true
			else:
				was_dry = true
			if spd < 1.5:
				break
	_stop_i = _traj.size() - 1


	_verdict_i = mini(CLEAR_VERDICT_STEPS, _stop_i)
























func _cobro_ancla() -> Vector2:
	if _cedida_yo == null or not is_instance_valid(_cedida_yo) or _aim_cam == null:
		return _cobro_press
	var body: Vector3 = Vector3(_cedida_yo.position.x, 0.0, _cedida_yo.position.z)
	if _aim_cam.is_position_behind(body):
		return _cobro_press
	return _aim_cam.unproject_position(body)


func _cobro_input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed and _cobro_finger == -1:
			_cobro_finger = event.index
			_cobro_press = event.position
			_drive_steer = Vector2.ZERO
		elif not event.pressed and event.index == _cobro_finger:

			_cobro_finger = -1
			_drive_steer = Vector2.ZERO
	elif event is InputEventScreenDrag and event.index == _cobro_finger:
















		var pull: Vector2 = _cobro_ancla() - event.position
		if pull.length() < DRIVE_STEER_DEADZONE:
			_drive_steer = Vector2.ZERO
			return
		var dir3: Vector3 = _world_aim_dir(pull.normalized())
		_drive_steer = Vector2(dir3.x, dir3.z).normalized()
	elif event is InputEventScreenTouch and not event.pressed:
		_drive_steer = Vector2.ZERO


func _handle_aim_input(event: InputEvent) -> void:





	_track_tag_touch(event)
	if event is InputEventScreenTouch:
		if event.pressed:





			_suelta_dedo_perdido(event.index)


			_salida_rotulo_fuera()


			if _saque_lenta_off:
				_saque_lenta_off = false
				_slow_enter_t = 0.0
				_saque_toque_f = Engine.get_physics_frames()













			if _aiming and event.index != _aim_finger and _orbit_finger == -1:
				if _cross_tap_finger != -1:
					return
				_cross_tap_finger = event.index
				_cross_tap_press = event.position
				return




			if _ring_finger != -1 or _drive_finger != -1:
				return













			if _drive_coast and not (_drive_enabled
					and _touch_in_drive_ring(event.position)):
				_freeze_drive()
			if _orbit_finger != -1:
				return







			_kill_handoff_glide()


			if _aiming:
				return


















			if _trap_enabled and not _trap_active \
					and _touch_in_drive_ring(event.position):
				_ring_finger = event.index
				_ring_anchor_center()
				_ring_out = true
				_trap_start()
				return
			if _drive_enabled and _touch_in_drive_ring(event.position):
				_ring_finger = event.index
				_ring_anchor_center()
				_ring_out = false
				_aiming = true
				_aim_finger = event.index
				_aim_start = event.position



				if _drive_active or _drive_coast:
					_freeze_drive()
					_drive_coast_clear()
					if is_instance_valid(_self_actor):
						_self_actor.pause()



				_open_aim_fx(true)
				_stadium.crowd_excite(1.0)






				if _zonas_h_on():
					_hud.show_hint(_solo_academia(_aviso_resortera(_cross_mode)))
				else:
					_hud.show_hint(_solo_academia(I18n.t("Jala para centrar · sal del círculo para conducir")
						if _cross_mode else I18n.t("Jala para tirar · sal del círculo para conducir")))
				return












			if _ring_gauge and _touch_in_drive_ring(event.position):
				_ring_anchor_center()
				_aiming = true
				_aim_finger = event.index
				_aim_start = _ring_start
				_aim_from_ring = true
				_stadium.crowd_excite(1.0)
				return






			if _order_finger == -1 and _order_tap_candidate(event.position):
				_order_finger = event.index
				_order_press = event.position
				return
			_aiming = true
			_aim_finger = event.index
			_aim_start = event.position
			_aim_from_ring = false












			_cam_tap_ms = Time.get_ticks_msec() if _cam_tap_candidate(event.position) else 0

			_stadium.crowd_excite(1.0)
		elif event.index == _cross_tap_finger:



			_cross_tap_finger = -1
			if not event.canceled:
				_set_cross_mode(not _cross_mode)
		elif event.index == _orbit_finger:




			_orbit_finger = -1
			_hud.show_hint(_solo_academia(_aim_hint()))
		elif event.index == _ring_finger:




			if _trap_active:
				_ring_finger = -1
				return



			_end_ring_gesture(event.position, event.canceled)
		elif event.index == _drive_finger:

			_end_drive()
		elif event.index == _order_finger:



			_order_finger = -1
		elif _aiming and event.index == _aim_finger:
			_aiming = false




			_aim.hide_aim(true)




			_press_freeze(false)
			if event.canceled:


				_soft_aim_clear()
				_aim_from_ring = false
				_stadium.crowd_excite(0.5)
				return


			var pull: Vector2 = _aim_start - event.position
			var ratio: float = _aim_ratio(pull, event.position)
			if not _aim_dead(pull, ratio):
				var suelta: Vector2 = _soft_aim_pos(_aim_start, event.position)
				pull = _aim_start - suelta
				ratio = _aim_ratio(pull, suelta)
			_soft_aim_clear()
			var muerta: bool = _aim_dead(pull, ratio)






			_aim_from_ring = false
			if muerta:

				_stadium.crowd_excite(0.5)






				if _cam_tap_ms > 0 \
						and Time.get_ticks_msec() - _cam_tap_ms <= ORDER_TAP_MS \
						and event.position.distance_to(_aim_start) <= ORDER_TAP_SLOP_PX:
					_cam_tap_ms = 0
					_on_cam_focus_requested()
				return
			_aim_dir = pull.normalized()
			_power_ratio = ratio
			_enter_strike()
	elif event is InputEventScreenDrag and event.index == _cross_tap_finger:




		if event.position.distance_to(_cross_tap_press) > ORDER_TAP_SLOP_PX:
			_cross_tap_finger = -1






			if _ring_finger != -1:
				return
			_aiming = false
			_aim.hide_aim()



			_press_freeze(false)
			_stadium.crowd_excite(0.5)
			_orbit_finger = event.index
			_orbit_start = _cross_tap_press
			_orbit_base = _aim_yaw
			_hud.show_hint(_solo_academia(I18n.t("Gira la vista · suelta para volver a apuntar")))
	elif event is InputEventScreenDrag and event.index == _orbit_finger:


		_aim_yaw = clampf(_orbit_base +(_orbit_start.x - event.position.x)
			* 0.0016 * Settings.cam_orbit_mul(),
			- deg_to_rad(CAM_YAW_MAX), deg_to_rad(CAM_YAW_MAX))
		_frame_aim_camera()








		if _drive_enabled or _trap_enabled or _duel_open or _ring_gauge \
				or state == State.DUEL:
			_fit_drive_ring()
			_show_drive_ring()
	elif event is InputEventScreenDrag and event.index == _ring_finger:
		if _trap_active:
			return
		_update_ring_gesture(event.position)
	elif event is InputEventScreenDrag and event.index == _order_finger:




		if event.position.distance_to(_order_press) > ORDER_TAP_SLOP_PX:
			_aiming = true
			_aim_finger = _order_finger
			_aim_start = _order_press
			_aim_from_ring = false
			_order_finger = -1
			_stadium.crowd_excite(1.0)
	elif event is InputEventScreenDrag and event.index == _drive_finger:

		_saque_promueve(event.position)
		if event.index == _ring_finger:
			_update_ring_gesture(event.position)
			return
		_update_drive_steer(event.position)
	elif event is InputEventScreenDrag and _aiming and event.index == _aim_finger:




		if _cam_tap_ms > 0 \
				and event.position.distance_to(_aim_start) > ORDER_TAP_SLOP_PX:
			_cam_tap_ms = 0
		var pull: Vector2 = _aim_start - event.position
















		var dead: bool = _aim_dead(pull, _aim_ratio(pull, event.position))
		if dead:
			_ring_aim_shown = false
			_aim.hide_aim()


			_soft_aim_clear()
			return




		var suave: Vector2 = _soft_aim_pos(_aim_start, event.position)
