func _ambient_off(actor: AnimatedSprite3D) -> Vector2:
	var ph: float = float(_amb_phase.get(actor, 0.0))
	var w: float = TAU / AMBIENT_T * _amb_t + ph
	return Vector2(cos(w) * AMBIENT_R, sin(w) * AMBIENT_R * AMBIENT_FLAT)



func _ambient_eligible(a: AnimatedSprite3D, moving: Dictionary, last_i: int, i: int) -> bool:
	if not _at_rest(a, moving) or a == _self_actor or a == _keeper:
		return false



	if _order_holds(a) or _run_target.has(a):
		return false



	if a.has_meta("hold_wall") or (i >= 0 and i == last_i):
		return false

	if _press_last.has(i) and i >= 0:
		return false
	return float(_offer_burst.get(a, 0.0)) <= 0.0




func _ambient_step(delta: float, moving: Dictionary) -> void:
	_amb_t += delta
	if _repliegue_on():
		_repl_vivo = true
	var line_z: float = _last_defender_z()
	var last_i: int = _last_defender_index()
	for i in _rival_actors.size():
		var r: AnimatedSprite3D = _rival_actors[i]
		if i == last_i and is_instance_valid(r) and _holder_repliega(r, i, delta, moving):
			continue
		if not _ambient_eligible(r, moving, last_i, i):
			if is_instance_valid(r) and _at_rest(r, moving):
				_face_ball(r)
			continue
		var np: Vector2 = _ambient_move(r, delta, line_z, true)





		if i < _defender_pos.size():
			_defender_pos[i] = np
	for t in _teammate_actors:
		if not _ambient_eligible(t, moving, -1, -1):
			if is_instance_valid(t) and _at_rest(t, moving):
				_face_ball(t)
			continue
		_ambient_move(t, delta, line_z, false)





















func _ambient_move(a: AnimatedSprite3D, delta: float, line_z: float,
		rival: bool) -> Vector2:
	var pos: Vector2 = Vector2(a.position.x, a.position.z)
	if not _home_pos.has(a):
		_home_pos[a] = pos
		_amb_phase[a] = randf() * TAU
	var goal: Vector2 = _block_home(a)
	if not is_inf(line_z):
		if rival:
			goal.y = maxf(goal.y, line_z - AMBIENT_R * AMBIENT_FLAT)
		else:


			goal.y = maxf(goal.y, _onside_floor())



	var spd: float = AMBIENT_SPD
	if _repliegue_on():
		spd = _repliegue_paso(a, pos, goal, _block_home(a, false), delta,
			REPL_SPD if rival else SUBE_SPD)
	elif a.has_meta("repl_trote"):
		a.remove_meta("repl_trote")
	var np: Vector2 = pos.move_toward(goal, spd * delta)
	var moved: Vector2 = np - pos
	a.position = Vector3(np.x, a.position.y, np.y)



	if moved.length() > 0.0005:
		_play_run(a, Vector3(moved.x, 0.0, moved.y))
	return np






















































