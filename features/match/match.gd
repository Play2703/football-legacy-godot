const PRE_BUDGET_US: int = 20000






var pre_budget_us: int = PRE_BUDGET_US



var pre_unidades: int = 0
var pre_unidad_max_us: int = 0
func precalienta_entrada(avance: Callable = Callable()) -> void:
	var fx: Dictionary = GameState.current_fixture()
	if fx.is_empty() or not GameState.practice_kind.is_empty() \
			or GameState.tutorial_active or GameState.next_weather.is_empty() \
			or String(fx.get("comp", "")) == "nat":
		return


	frames_eager = false
	var arbol: SceneTree = Engine.get_main_loop() as SceneTree
	GameState.ensure_kit_choice()
	KitRecolor.pon_clima(Weather.get_preset(GameState.next_weather))
	_pon_capitanes()
	var mine: Dictionary = KitRecolor.team_only(GameState.player_look())
	var theirs: Dictionary = KitRecolor.team_only(_rival_kit_cfg())
	var sides: Array = _entrance_sides(mine, theirs)
	var deadline: int = Time.get_ticks_usec() + pre_budget_us


	var b_vias: Array = []
	var b_t0: int = Time.get_ticks_msec()
	var b_c0: int = Engine.get_process_frames()


	for side in 2:
		var fichas: Array = _entrance_fichas(side, String(sides[side][2]))
		if fichas.is_empty():
			continue
		var look: Dictionary = _portero_look(side,
			String((fichas[0] as Dictionary).get("name", "")))
		var key_k: String = "keeper|" + var_to_str(look)
		if _frames_cache.has(key_k):
			b_vias.append("cache")
			continue



		if SceneFade.hilo_viste(key_k):
			b_vias.append("hilo")
			continue
		b_vias.append("principal")
		var pares: Array = _warm_keeper_paths(look)
		for i in pares.size():
			if Time.get_ticks_usec() + _drain_last_us >= deadline:
				if avance.is_valid():
					avance.call((float(side) + float(i) / float(pares.size())) * 0.35)
				await arbol.process_frame
				deadline = Time.get_ticks_usec() + pre_budget_us
			var t_k: int = Time.get_ticks_usec()
			KitRecolor.pon_imagen_en_meta(_keeper_par_al_atlas(String(pares[i][0])))
			KitRecolor.apply_recordando(load(pares[i][0]), pares[i][1])
			KitRecolor.pon_imagen_en_meta(false)
			_drain_last_us = maxi(1, int(Time.get_ticks_usec() - t_k))
			pre_unidades += 1
			pre_unidad_max_us = maxi(pre_unidad_max_us, _drain_last_us)
		await arbol.process_frame
		deadline = Time.get_ticks_usec() + pre_budget_us
		_keeper_frames(look)






	if not SceneFade.hilo_porteros_vivo():
		KitRecolor.olvida_analisis()
	var b_t1: int = Time.get_ticks_msec()
	var b_c1: int = Engine.get_process_frames()
	var b_u1: int = pre_unidades


	var trios: Array = [[TEAM_TEX, mine], [RIVAL_TEX, theirs], [TEAM_TEX, _self_cfg()]]
	for j in trios.size():
		if avance.is_valid():
			avance.call(0.7 + 0.1 * float(j))
		var tex: Texture2D = trios[j][0]
		var cfg: Dictionary = trios[j][1]
		if _frames_full.has(_frames_key(tex, cfg)):
			continue
		for slice in _anim_slices(tex, "idle"):
			for path in slice["paths"]:
				if Time.get_ticks_usec() + _drain_last_us >= deadline:
					await arbol.process_frame
					deadline = Time.get_ticks_usec() + pre_budget_us
				var t_c: int = Time.get_ticks_usec()
				KitRecolor.apply_recordando(load(path), cfg)
				_drain_last_us = maxi(1, int(Time.get_ticks_usec() - t_c))
				pre_unidades += 1
				pre_unidad_max_us = maxi(pre_unidad_max_us, _drain_last_us)
		var frames: SpriteFrames = _actor_frames(tex, cfg)
		for slice in _anim_slices(tex, "rest"):
			var anim: String = slice["anim"]
			if not anim.begins_with("run_"):
				continue
			var n: int =(slice["paths"] as Array).size()



			while not frames.has_animation(anim) or frames.get_frame_count(anim) < n:
				_ondemand_deadline_us = deadline

				KitRecolor.memo_abre()
				_fill_anim_budget(frames, slice, cfg)
				KitRecolor.memo_cierra()
				if not frames.has_animation(anim) or frames.get_frame_count(anim) < n:
					await arbol.process_frame
					deadline = Time.get_ticks_usec() + pre_budget_us
	SceneFade.banco_ev({"ev": "entrada_tramos", "porteros": b_vias,
		"porteros_ms": b_t1 - b_t0, "porteros_cuadros": b_c1 - b_c0, "porteros_u": b_u1,
		"carreras_ms": Time.get_ticks_msec() - b_t1,
		"carreras_cuadros": Engine.get_process_frames() - b_c1, "carreras_u": pre_unidades - b_u1})
	if avance.is_valid():
		avance.call(1.0)




























