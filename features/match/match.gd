func _chase_aim(actor: AnimatedSprite3D, speed: float, delta: float) -> Vector3:
	if _traj.is_empty():
		return _ball.position


	var last: int = _traj.size() - 1
	if _stop_i > 0:
		last = mini(last, _stop_i)









	if _cross_i >= 0 and (_outcome == "goal" or _outcome == "wide" or _outcome == "over"):
		last = mini(last, _cross_i)
	var j: int = maxi(_traj_i, 0)
	while j <= last:
		var p: Vector3 = _traj[j]
		if p.y <= HEADER_MAX_H:
			var t: float = float(j - _traj_i) * delta
			if _flat_dist(actor.position, p) <= speed * t + _touch_radius(p.y):
				return p
		j += INTERCEPT_STEP
	return _traj[maxi(last, 0)]























