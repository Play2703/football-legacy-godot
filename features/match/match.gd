	if _stadium:
		_stadium.crowd_flashes("kickoff")






		_stadium.water_pitch(6.0)
	var dur: float = LINEUP_DUR if proto else {1: 6.2, 2: 5.4, 3: 4.4}.get(d, 5.0)

	var lift: float = {1: 1.14, 2: 1.0, 3: 0.9}.get(d, 1.0)
	_intro_from = Vector3(INTRO_FROM.x * lift, INTRO_FROM.y * lift, INTRO_FROM.z)
	_intro_cam = Camera3D.new()














	_intro_lente(_intro_cam)
	_intro_cam.fov = 41.6
	add_child(_intro_cam)
	_intro_cam.position = _intro_from
	_intro_cam.look_at(INTRO_LOOK_FROM)
	_intro_cam.current = true


	_hud.show_hint(Entrada.texto_f("Toca para saltar", "Pulsa {0} para saltar", [],
		[Entrada.boton("fl_avanza")]))




	if proto:
		_start_lineup()



		_lineup_step(0.0)
	else:
		_start_entrance(dur)













	_hud.show_broadcast_open(GameState.current_fixture(),
		2.8 if proto else minf(dur - 0.9, 3.8))





