func open_replay_clip(clip: ReplayRec.Clip, gol_id: int = -1) -> void:
	if _replay != null and is_instance_valid(_replay):
		return
	if clip == null:
		return
	if gol_id <= 0 and _goal_clips.get(_goal_seq) == clip:
		gol_id = _goal_seq
	_replay = ReplayView.new()

	_album_arma(_replay, clip, gol_id)



	_replay.closed.connect(_on_replay_closed)
	add_child(_replay)










	_replay.ring_mat_src = _drive_ring_mat
	_replay.ring_label_tex = _make_ring_label_texture

	_replay.con_mini = true
	var tapar: Array = [_ball, _actors, _sim_screen, _hud]
	for aro in [_drive_ring, _switch_ring_node]:
		if aro != null and is_instance_valid(aro):
			tapar.append(aro)






	if _fx != null and is_instance_valid(_fx):
		tapar.append_array(_fx.get_children())
	if _stadium != null and is_instance_valid(_stadium):
		tapar.append_array(_stadium.festejo_en_el_aire())
	_replay.open(clip, self, tapar, _stadium)


