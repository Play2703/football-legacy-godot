const CARA_DIR_ANIM: String = "res://assets/sprites/anim/"

func _cara_rutas_propias(sf: SpriteFrames) -> Dictionary:
	if sf == null:
		return {}
	if sf.has_meta("cara_rutas_propias"):
		return sf.get_meta("cara_rutas_propias")
	var out: Dictionary = {}
	for anim in sf.get_animation_names():
		var m: String = "pecho_bases_%s" % anim
		if not sf.has_meta(m):
			continue
		var rutas: Array = []
		for b in (sf.get_meta(m) as PackedStringArray):
			rutas.append(CARA_DIR_ANIM + b + ".png")


		if rutas.all(func(r): return ResourceLoader.exists(r)):
			out[String(anim)] = rutas
	sf.set_meta("cara_rutas_propias", out)
	return out




















const CARA_RUTAS_META: String = ReplayDisco.META_CARA_RUTAS

func _cara_rutas_de(actor: AnimatedSprite3D) -> Dictionary:
	var tex: Texture2D = actor.get_meta("anim_tex") if actor.has_meta("anim_tex") else null
	var sf: SpriteFrames = actor.sprite_frames
	var llave: String = tex.resource_path if tex != null else ""
	var porta: Dictionary = {}
	if sf != null:
		porta = sf.get_meta(CARA_RUTAS_META, {})
		var hit: Variant = porta.get(llave)
		if hit is Dictionary:
			return hit
	var rutas: Dictionary = _cara_rutas(tex)
	rutas.merge(_cara_rutas_propias(sf), true)
	if sf != null:
		porta[llave] = rutas
		sf.set_meta(CARA_RUTAS_META, porta)
	return rutas





func _cara_rutas(tex: Texture2D) -> Dictionary:
	var out: Dictionary = {}
	if tex == null:
		return out
	for slice in _anim_slices(tex, "", "*"):
		out[String(slice["anim"])] = slice["paths"]
	return out













func _chin_elige_socio(focus: Node3D, runners: Array) -> AnimatedSprite3D:
	if focus == null or not is_instance_valid(focus) or not runners.has(focus):
		return null
	var mejor: AnimatedSprite3D = null
	var mejor_d: float = INF
	for r in runners:
		if r == focus or not is_instance_valid(r) or not (r is AnimatedSprite3D):
			continue
		var a: AnimatedSprite3D = r
		if a.sprite_frames == null or not a.has_meta("anim_tex"):
			continue
		var d: float = _flat_dist(a.position, focus.position)
		if d < mejor_d:
			mejor_d = d
			mejor = a
	return mejor









static func _chin_frente(fin: Vector3, desde: Vector3, socio: Vector3) -> Vector3:
	var run: Vector2 = Vector2(fin.x - desde.x, fin.z - desde.z)
	var lado: Vector2 = Vector2(- run.y, run.x).normalized() if run.length_squared() > 0.01 \
			else Vector2(1.0, 0.0)
	if lado.dot(Vector2(socio.x - fin.x, socio.z - fin.z)) < 0.0:
		lado = - lado
	var p: Vector2 = Vector2(fin.x, fin.z) + lado * CHIN_SEP_M
	if _chin_fuera(p, fin):
		p = Vector2(fin.x, fin.z) - lado * CHIN_SEP_M
	return _chin_dentro(p, fin)



static func _chin_fuera(p: Vector2, fin: Vector3) -> bool:
	var tope_x: float = maxf(Stadium.FIELD_HALF_W - 1.0, absf(fin.x))
	return absf(p.x) > tope_x or p.y < minf(-2.0, fin.z)


static func _chin_dentro(p: Vector2, fin: Vector3) -> Vector3:
	var tope_x: float = maxf(Stadium.FIELD_HALF_W - 1.0, absf(fin.x))
	return Vector3(clampf(p.x, - tope_x, tope_x), fin.y, maxf(p.y, minf(-2.0, fin.z)))







func _chin_par(f: Vector3) -> Vector3:
	if _celeb_gesture != "chinchanpu" or _chin_socio == null \
			or not is_instance_valid(_chin_socio):
		return f
	var falta: float = Vector2(f.x - _celeb_focus_pos.x, f.z - _celeb_focus_pos.z).length()
	var w: float = clampf(inverse_lerp(CELEB_COACH_MIRA_LEJOS, CELEB_COACH_MIRA_CERCA,
		falta), 0.0, 1.0)
	w *= clampf(inverse_lerp(6.0, 2.0, _flat_dist(_chin_socio.position, f)), 0.0, 1.0)
	var medio: Vector3 = Vector3((f.x + _chin_socio.position.x) * 0.5, f.y,
		(f.z + _chin_socio.position.z) * 0.5)
	return f.lerp(medio, w)


func _chin_vivos() -> bool:
	return _chin_socio != null and is_instance_valid(_chin_socio) \
			and _celeb_focus != null and is_instance_valid(_celeb_focus) \
