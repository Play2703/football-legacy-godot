func _cesion_monta(ficha: Dictionary, yo_llevo: bool,
		centro: Vector2 = Vector2.ZERO) -> Dictionary:
	var quien: String = String(ficha.get("name", ""))
	_cesion_viva = true


	var estado: Dictionary = {"chip": _hud.hide_player_chip(true),
		"ball": _ball.visible, "yo_vis": true}


	var tapado: Dictionary = _pedido_tapado
	_pedido_tapado = {}
	if not tapado.is_empty():
		estado["chip"] = bool(tapado.get("chip", false))


	_ball.visible = false



	estado["aro"] =(_drive_ring != null and is_instance_valid(_drive_ring) \
			and _drive_ring.visible) or bool(tapado.get("aro", false))
	if bool(estado["aro"]) and is_instance_valid(_drive_ring):
		_drive_ring.visible = false


	if _self_actor != null and is_instance_valid(_self_actor):
		estado["yo_vis"] = bool(tapado.get("yo_vis", _self_actor.visible))
		_self_actor.visible = false




		_pecho_visible(_self_actor, false)



	var sitio_yo: Vector2 =(CESION_YO if yo_llevo else CESION_MATE) + centro
	var sitio_el: Vector2 =(CESION_MATE if yo_llevo else CESION_YO) + centro
	var yo: AnimatedSprite3D = _spawn_actor(TEAM_TEX, sitio_yo.x, sitio_yo.y,
		PLAYER_METRICS, PLAYER_HEIGHT_M, true)
	_celeb_props.append(yo)
	var el: AnimatedSprite3D = _spawn_actor(TEAM_TEX, sitio_el.x, sitio_el.y,
		PLAYER_METRICS, PLAYER_HEIGHT_M,
		_look_for(quien, GameState.player_look(), "",
			int(ficha.get("number", 0))))
	_celeb_props.append(el)
	for par in [[yo, yo_llevo], [el, not yo_llevo]]:
		var a: AnimatedSprite3D = par[0]
		if bool(par[1]) and _balon_al_brazo(a):
			continue
		if a.sprite_frames.has_animation("idle"):
			a.play("idle")
	estado["props"] = [yo, el]


	if _cesion_cam == null:
		_cesion_cam = Camera3D.new()
		add_child(_cesion_cam)
	_cesion_cam.fov = CESION_FOV
	var corre: Vector3 = Vector3(centro.x, 0.0, centro.y)
	_cesion_cam.position = CESION_CAM + corre
	_cesion_cam.look_at(CESION_CAM_MIRA + corre)
	_cesion_cam.current = true


	_hud.show_hint("")
	if not Settings.reduce_motion:
		var tw: Tween = create_tween()
		tw.tween_property(_cesion_cam, "position",
			CESION_CAM + corre + Vector3(0.0, 0.0, - CESION_PUSH), CESION_PUSH_S) \
					.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	return estado



func _cesion_recoge(estado: Dictionary) -> void:
	_cesion_viva = false
	_cesion_cam.current = false
	_aim_cam.current = true
	for prop in Array(estado.get("props", [])):
		_celeb_props.erase(prop)
		if is_instance_valid(prop):
			(prop as Node).queue_free()
	if _self_actor != null and is_instance_valid(_self_actor):
		_self_actor.visible = bool(estado.get("yo_vis", true))
		_pecho_visible(_self_actor, bool(estado.get("yo_vis", true)))
	_ball.visible = bool(estado.get("ball", true))
	if bool(estado.get("aro", false)) and is_instance_valid(_drive_ring):
		_drive_ring.visible = true
	_hud.hide_player_chip(not bool(estado.get("chip", false)))











func _regalo_penal_escena() -> void:
	var ficha: Dictionary = Squad.best_specialist(_my_side_id(), "penal")
	if ficha.is_empty() or String(ficha.get("name", "")) == Career.player_name:
		return
	var estado: int = state
	_shootout_active = true
	var esc: Dictionary = _cesion_monta(ficha, false)
	_hud.show_message(I18n.tf("{0} TE DA EL PENAL",
		[String(ficha.get("name", ""))]), UiKit.GOLD, CESION_REGALO_S)
	await _shoot_wait(CESION_REGALO_S)
	_cesion_recoge(esc)
	_shootout_active = false
	if state != State.ENDED:
		state = estado
	_hud.show_hint(_solo_academia(_aim_hint()))










const Cantico = preload("res://features/match/cantico.gd")

const CANTICO_S: float = 6.0

const CANTICO_GOL_DELAY_S: float = 2.4

const CANTICO_ROTULO_S: float = 2.2

var _cantico: Dictionary = {}

var _cantico_seq: int = -1

var _cantico_veces: int = 0




func _cantico_ahora() -> Dictionary:
	if _cantico.is_empty():
		_cantico = {"modo": "", "apellido": ""}
		if _practice_kind.is_empty() and not _tutorial_active and not _shootout_active:
			var hoy: Dictionary = Career.cantico_hoy()
			if not hoy.is_empty():
				_cantico["modo"] = String(hoy.get("modo", ""))
				_cantico["apellido"] = CareerUi.surname(CareerUi.display_name(Career.player_name))
	return _cantico




func _cantico_modo() -> String:
	var modo: String = String(_cantico_ahora().get("modo", ""))
	if modo != Cantico.BURLA and _grada_respuesta == GradaPide.PITA:
		return ""
	return modo




func _cantico_calma() -> float:
	return Cantico.CALMA_VIAJA if _cantico_modo() == Cantico.VIAJA else 1.0




func _cantico_suena(cuando: String) -> void:
	var modo: String = _cantico_modo()
	var letra: String = Cantico.letra(String(_cantico.get("apellido", "")), modo)
	if letra.is_empty() or _hud == null:
		return
	_cantico_veces += 1
	if modo == Cantico.BURLA:
		_hud.show_message(letra, UiKit.DANGER, CANTICO_ROTULO_S)
		if _audio:
			_audio.heckle()
		return
	_hud.show_message(letra, Momentum.HOT, CANTICO_ROTULO_S)
	if _audio:
		_audio.cantico(CANTICO_S, modo == Cantico.VIAJA)
	if cuando != "gol" and is_instance_valid(_stadium):

		_stadium._start_chant(CANTICO_S, 1)





func _cantico_gol(og: bool) -> void:
	if og or (_pass_done and _last_toucher != null and is_instance_valid(_last_toucher)):
		return
	var modo: String = _cantico_modo()
	if modo.is_empty() or modo == Cantico.BURLA:
		return

	SceneFade.timer(CANTICO_GOL_DELAY_S, false).timeout \
			.connect(_cantico_suena.bind("gol"))




func _cantico_tick() -> void:
	if state != State.AIMING or _cantico_seq == _chance_seq:
		return
	if not SetPiece.is_set_piece(_chance_kind) or _cobro_corre or _cedida_en_curso \
			or _handoff_live:
		return
	_cantico_seq = _chance_seq
	if Cantico.en_balon(_cantico_modo(), _chance_kind):
		_cantico_suena("balon")












const GradaPesa = preload("res://features/match/grada_pesa.gd")

const GRADA_TIEMBLA_BOO_S: float = 1.8

var _grada_hostil: float = -1.0

var _grada_calma: float = 1.0

var _grada_tiembla_base: Vector3 = Vector3.ZERO
var _grada_tiembla_ancla: Vector3 = Vector3.ZERO
var _grada_tiembla_ratio: float = 0.0
var _grada_tiembla_frio: bool = false
var _grada_tiembla_seq: int = -1

var _grada_tiembla_pito: int = -1

var _grada_tiembla_t: float = -1.0




func _grada_hostil_ahora() -> float:
	if _grada_hostil < 0.0:
		_grada_hostil = 0.0
		if _practice_kind.is_empty() and not _tutorial_active:
			var rival_id: String = String(GameState.current_rival().get("id", ""))


			var en_su_casa: bool = not _home_match and GameState.host_id() == rival_id
			var tono: String = String(Career.reencuentro(rival_id).get("tono", ""))
			_grada_hostil = GradaPesa.hostilidad(en_su_casa, _is_derby, tono)
	return _grada_hostil






func _grada_tiembla_amp() -> float:
	if not SetPiece.is_set_piece(_chance_kind) or _cobro_corre or _cedida_en_curso \
			or _handoff_live:
		return 0.0
	if not (state == State.AIMING
			or (state == State.STRIKING and _strike_desde == State.AIMING)):
		return 0.0

	return GradaPesa.amplitud(_grada_hostil_ahora(), _grada_calma * _cantico_calma())




func _grada_tiembla(dir3: Vector3) -> Vector3:
	var amp: float = _grada_tiembla_amp()
	if amp <= 0.0:
		return dir3
	var t: float = _grada_tiembla_t if _grada_tiembla_t >= 0.0 \
			else float(Time.get_ticks_msec()) / 1000.0
	return dir3.rotated(Vector3.UP, GradaPesa.angulo(amp, t))




func _grada_tiembla_guarda(base3: Vector3, ancla: Vector3, ratio: float,
		frio: bool = false) -> void:
	_grada_tiembla_base = base3
	_grada_tiembla_ancla = ancla
	_grada_tiembla_ratio = ratio
	_grada_tiembla_frio = frio
	_grada_tiembla_seq = _chance_seq




func _grada_tiembla_tick() -> void:
	if state != State.AIMING:
		return
	var amp: float = _grada_tiembla_amp()
	if amp <= 0.0:
		return
	if _grada_tiembla_pito != _chance_seq:
		_grada_tiembla_pito = _chance_seq

		if is_instance_valid(_stadium):
			_stadium.crowd_boo(GRADA_TIEMBLA_BOO_S)
		if _audio:
			_audio.boo(GRADA_TIEMBLA_BOO_S)
	if _ring_aim_shown and _grada_tiembla_seq == _chance_seq and _aim and _aim.visible:
		var d: Vector3 = _grada_tiembla(_grada_tiembla_base)
		_aim.show_aim(_grada_tiembla_ancla, d, _grada_tiembla_ratio, _grada_tiembla_frio)
		_ring_aim_dir = d













const GradaPide = preload("res://features/match/grada_pide.gd")
const GRADA_PIDE_S: float = 0.5
const GRADA_PALMAS_S: float = 0.9
const GRADA_RESPUESTA_S: float = 1.4

const GRADA_LOCK_MS: int = 30000

var _grada_hecha: bool = false

var _grada_note: Dictionary = {}

var _grada_respuesta: String = ""

var _grada_eleccion_forzada: String = ""
var _grada_dado_forzado: float = -1.0




func _grada_cabe(chance: Dictionary) -> bool:
	if not _practice_kind.is_empty() or _tutorial_active or _shootout_active:
		return false
	if not is_instance_valid(_self_actor):
		return false
	return GradaPide.cabe(String(chance.get("kind", "")), match_minute,
		team_goals - rival_goals, _fan_rel, _grada_hecha)


func _grada_viva(yo: AnimatedSprite3D) -> bool:
	return is_inside_tree() and state != State.ENDED and is_instance_valid(yo)




func _grada_escena(chance: Dictionary) -> void:
	if not _grada_cabe(chance):
		return
	_grada_hecha = true
	var yo: AnimatedSprite3D = _self_actor
	var p: int = GradaPide.pct(_fan_rel)


	var estado: int = state
	var interruptor: bool = _shootout_active
	state = State.AIMING
	_shootout_active = true

	_grada_sorda = true


	var t0: int = Time.get_ticks_msec()
	var listo: bool = await _pique_arma([[yo, "clap_grada"]])
	var resta: float = GRADA_PIDE_S - float(Time.get_ticks_msec() - t0) / 1000.0
	if resta > 0.0:
		await _shoot_wait(resta)
	var elijo: String = _grada_eleccion_forzada
	if elijo.is_empty() and _grada_viva(yo):
		_hud.ask_choice(Competitions.accent_of(GameState.current_fixture()),
			GradaPide.PIDE, I18n.t("PIDE ALIENTO"), GradaPide.NO, I18n.t("A LO TUYO"),
			I18n.tf("RUGE {0} % · PITA {1} %", [p, 100 - p]))
		elijo = String(await _hud.choice_made)

		_hud.clear_coin_panel()
	if elijo == GradaPide.PIDE and _grada_viva(yo):
		await _grada_palmas(yo, listo)
	_shootout_active = interruptor
	_grada_sorda = false
	if is_inside_tree() and state != State.ENDED:
		state = estado
		_hud.show_hint(_solo_academia(_aim_hint()))




func _grada_palmas(yo: AnimatedSprite3D, listo: bool) -> void:
	var anim_antes: StringName = yo.animation
	var flip_antes: bool = yo.flip_h
	_run_target.erase(yo)
	_anim_lock[yo] = Time.get_ticks_msec() + GRADA_LOCK_MS
	if listo:
		yo.flip_h = false
		yo.play("clap_grada")
		yo.speed_scale = 1.0
	else:
		_pique_pose(yo, "north")
	await _shoot_wait(GRADA_PALMAS_S)
	if not _grada_viva(yo):
		_grada_suelta(yo, anim_antes, flip_antes)
		return
	var dado: float = _grada_dado_forzado if _grada_dado_forzado >= 0.0 else randf()
	_grada_respuesta = GradaPide.resuelve(_fan_rel, dado)
	if _grada_respuesta == GradaPide.RUGE:
		_audio.roar(-6.0, 0.85)
		_stadium.crowd_excite(1.0)
		_hud.show_message(I18n.t("LA GRADA RUGE"), Momentum.HOT, GRADA_RESPUESTA_S)
		_grada_note = {"minute": match_minute,
			"text": I18n.t("PIDES ALIENTO Y LA GRADA RUGE")}
	else:


		_audio.boo(GRADA_RESPUESTA_S)
		_stadium.crowd_boo(GRADA_RESPUESTA_S, true)
		_pique_pose(yo, "north")
		_hud.show_message(I18n.t("LA GRADA TE PITA"), UiKit.DANGER, GRADA_RESPUESTA_S)
		_grada_note = {"minute": match_minute,
			"text": I18n.t("PIDES ALIENTO Y LA GRADA TE PITA")}
	_momentum.register(_grada_respuesta)
	_push_momentum()
	await _shoot_wait(GRADA_RESPUESTA_S)
	_grada_suelta(yo, anim_antes, flip_antes)


func _grada_suelta(yo: AnimatedSprite3D, anim: StringName, flip: bool) -> void:
	if not is_instance_valid(yo):
		return
	_anim_lock.erase(yo)
	yo.speed_scale = 1.0
	yo.flip_h = flip
	if yo.sprite_frames != null and yo.sprite_frames.has_animation(anim):
		yo.play(anim)



