const SHOOTOUT_REACT_RUN_M: float = 7.0
const SHOOTOUT_REACT_WALK_M: float = 2.6























func _shootout_react(actor: AnimatedSprite3D, outcome: String) -> void:
	if actor == null or not is_instance_valid(actor):
		return
	var scored: bool = outcome == "goal"













	if _shootout_decisivo(scored):
		_anim_lock.erase(actor)



		_face(actor, - Vector3(actor.position.x, 0.0, actor.position.z))
		return




	_anim_lock.erase(actor)
	var away: Vector3
	var tw: Tween = create_tween()
	if scored:









		away = Vector3(1.0 if randf() < 0.5 else -1.0, 0.0, 1.6).normalized() \
				* minf(SHOOTOUT_REACT_RUN_M, _cedida_spd(actor) * SHOOTOUT_REACT_S)
		tw.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	else:










		away = Vector3(1.0 if randf() < 0.5 else -1.0, 0.0, 0.3).normalized() \
				* SHOOTOUT_REACT_WALK_M
		tw.set_trans(Tween.TRANS_LINEAR)




















		if _cedida_en_curso:
			pass
		elif outcome == "save":
			SceneFade.timer(SHOOTOUT_SAVE_BEAT, false).timeout \
					.connect(_shootout_look_at.bind(actor))
		else:
			_look_target = actor
	tw.tween_property(actor, "position", actor.position + away, SHOOTOUT_REACT_S)






	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return
		actor.speed_scale = 1.0
		_face(actor, - away if scored else away))




	_celeb_runs.append(tw)






