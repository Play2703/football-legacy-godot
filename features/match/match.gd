	_saque_suelta = Vector3.INF







func _saque_largo_gesto(srv: AnimatedSprite3D, g: Dictionary, gen: int, mira: Vector3) -> float:
	var oeste: bool = srv.global_position.x > 0.0
	var anim: String = "saque_banda_" +("west" if oeste else "east")
	var der: Vector3 = _serve_plan.get("saque_der", Vector3.ZERO)


	var listo: bool = false
	for _i in 30:
		_ondemand_deadline_us = Time.get_ticks_usec() + 20000
		if _gesto_listo(srv, anim):
			listo = true
			break
		await get_tree().process_frame
		if not _servicio_sigue(gen) or not is_instance_valid(srv):
			return -1.0
	if listo:
		srv.play(anim)
		srv.pause()
		srv.frame = 0
		srv.flip_h = false
		_anim_lock[srv] = Time.get_ticks_msec() + 60000
	var dura: float = float(g["dura"])
	var t: float = 0.0
	while true:
		var i: int = clampi(int(maxf(t - SAQUE_ANTES_S, 0.0) * SAQUE_FPS), 0, SAQUE_SUELTA_I)
		if listo:
			srv.frame = i
		_ball.position = _saque_mano(srv, anim, i if listo else SAQUE_SUELTA_I, oeste, der)
		if not _serve_vivo:
			_ball_field = Vector2(_ball.position.x, _ball.position.z)
		if t >= dura:
			break
		await get_tree().physics_frame
		if not _servicio_sigue(gen) or not is_instance_valid(srv):
			return -1.0
		if not can_process():
			continue
		var dt: float = get_physics_process_delta_time()
		t += dt
		if not _serve_vivo:
			_aim_cam_look(Vector3(_ball.position.x, 0.0, _ball.position.z).lerp(mira, 0.3)
				+ Vector3(0.0, 0.6, 0.0), dt, 5.0)
		_servicio_npcs(dt, t)

	_saque_suelta = _ball.position


	if listo:
		_anim_lock[srv] = Time.get_ticks_msec() + int(1000.0 / SAQUE_FPS)
	return t






































