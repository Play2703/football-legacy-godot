func _nombres_de_huella(huella: String, mine: bool) -> Dictionary:
	var partes: PackedStringArray = huella.split("|")
	var out: Dictionary = {}
	if partes.size() < 2:
		return out
	for n in partes[1 if mine else 0].split(",", false):
		out[n] = true
	return out






func _sin_relevo(mine: bool, nombre: String) -> bool:
	if not MatchSim.esta_fuera(mine, nombre):
		return false
	var baja: Dictionary = _baja_ajena.get("you" if mine else "rival", {})
	return String(baja.get("fuera", "")) != nombre \
			or (baja.get("ficha", {}) as Dictionary).is_empty()













func _refresca_fichas(ch: Dictionary, k_pos: String, k_pl: String, k_xpos: String,
		k_xpl: String, en_campo: Array, mine: bool, antes: Dictionary) -> void:
	var sitios: Array = ch.get(k_pos, [])
	var fichas: Array = ch.get(k_pl, [])
	var x_sitios: Array = ch.get(k_xpos, [])
	var x_fichas: Array = ch.get(k_xpl, [])
	var juega: Dictionary = {}
	for p in en_campo:
		juega[String((p as Dictionary).get("name", ""))] = p
	var con_cuerpo: Dictionary = {}
	for f in fichas + x_fichas:
		var n: String = String((f as Dictionary).get("name", ""))
		if juega.has(n):
			con_cuerpo[n] = true


	var libres: Array = []
	for p in en_campo:
		var n: String = String((p as Dictionary).get("name", ""))
		if not con_cuerpo.has(n) and not antes.has(n):
			libres.append(p)
	var x_ok: bool = x_sitios.size() == x_fichas.size()

	if x_ok:
		for i in range(x_fichas.size() - 1, -1, -1):
			var n: String = String((x_fichas[i] as Dictionary).get("name", ""))
			if n.is_empty() or juega.has(n):
				continue
			var otro: Dictionary = {} if _sin_relevo(mine, n) \
					else _saca_libre(libres, x_fichas[i])
			if not otro.is_empty():
				x_fichas[i] = otro
			else:
				x_sitios.remove_at(i)
				x_fichas.remove_at(i)

	var wall: int = 0 if mine else int(ch.get("wall_count", 0))
	for i in range(fichas.size() - 1, -1, -1):
		var n: String = String((fichas[i] as Dictionary).get("name", ""))
		if n.is_empty() or juega.has(n):
			continue
		var otro: Dictionary = {} if _sin_relevo(mine, n) \
				else _saca_libre(libres, fichas[i])
		if otro.is_empty() and x_ok and not x_fichas.is_empty():
			otro = x_fichas.pop_back()
			x_sitios.pop_back()
		if not otro.is_empty():
			fichas[i] = otro
		elif i >= wall and sitios.size() == fichas.size() and sitios.size() > 1:
			sitios.remove_at(i)
			fichas.remove_at(i)



			if not mine:
				var roles: Array = []
				for r in ch.get("press_roles", []):
					if int(r) != i:
						roles.append(int(r) - 1 if int(r) > i else int(r))
				ch["press_roles"] = roles
		else:
			fichas[i] = {}



func _saca_libre(libres: Array, quien: Dictionary) -> Dictionary:
	if libres.is_empty():
		return {}
	var pos: String = String(quien.get("pos", ""))
	for k in libres.size():
		if String((libres[k] as Dictionary).get("pos", "")) == pos:
			return libres.pop_at(k)
	return libres.pop_front()










