func _play_injury_scene(companero: Dictionary = {}) -> void:
	if _stadium == null or not _practice_kind.is_empty():
		return
	var ajena: bool = not companero.is_empty()




	var raw: Vector2 = _injury_spot
	if ajena:
		raw = Vector2(randf_range(- Stadium.FIELD_HALF_W * 0.55, Stadium.FIELD_HALF_W * 0.55),
			randf_range(Stadium.FIELD_DEPTH * 0.3, Stadium.FIELD_DEPTH * 0.7))
	var spot: Vector2 = Vector2(
		clampf(raw.x, - Stadium.FIELD_HALF_W + 4.0, Stadium.FIELD_HALF_W - 4.0),
		clampf(raw.y, 6.0, Stadium.FIELD_DEPTH - 6.0))
	var prev_cam: Camera3D = SceneFade.camara_de(self)


	var self_estaba: bool = is_instance_valid(_self_actor) and _self_actor.visible
	if self_estaba:
		_self_actor.visible = false





	var ocultos: Array = []
	for hijo in _actors.get_children():
		if hijo is Node3D and (hijo as Node3D).visible:
			(hijo as Node3D).visible = false
			ocultos.append(hijo)




	var balon_estaba: bool = is_instance_valid(_ball) and _ball.visible
	if balon_estaba:
		_ball.visible = false





	_audio.whistle()
	_audio.ooh()
	_sim_screen.veil(true)



	var caido_nombre: String = String(companero.get("name", ""))
	var caido_look: Variant = true
	if ajena:
		caido_look = _look_for(caido_nombre, GameState.player_look(), "",
			int(companero.get("number", 0)))
	var caido: AnimatedSprite3D = _spawn_actor(TEAM_TEX, spot.x, spot.y,
		PLAYER_METRICS, PLAYER_HEIGHT_M, caido_look)


	_ondemand_deadline_us = Time.get_ticks_usec() + INJURY_ART_BUDGET_US
	var cae: bool = _play_dir_gesture(caido, "fall", Vector2(0.0, -1.0),
		INJURY_SCENE_MS)











	var caida_en_vivo: bool = cae and (ajena or not Career.pending_injury_trauma)
	if cae and not caida_en_vivo:
		caido.set_frame_and_progress(
			caido.sprite_frames.get_frame_count(caido.animation) - 1, 1.0)
		caido.pause()









	var mirones: Array = []
	var corro: Array = [Vector2(-2.6, -2.6), Vector2(0.4, -3.4), Vector2(2.8, -2.9)]
	var plantilla: Array = []
	for r in Career.squad_roster():
		if bool(r.get("is_you", false)) or String(r.get("pos", "")) == "POR":
			continue



		if ajena and String(r.get("name", "")) == caido_nombre:
			continue
		plantilla.append(r)
		if plantilla.size() >= corro.size():
			break
	for k in corro.size():
		var comp: Dictionary = plantilla[k] if k < plantilla.size() else {}
		var w: AnimatedSprite3D = _spawn_actor(TEAM_TEX,
			spot.x + Vector2(corro[k]).x, spot.y + Vector2(corro[k]).y,
			PLAYER_METRICS, PLAYER_HEIGHT_M,
			_look_for(String(comp.get("name", "")), GameState.player_look(), "",
				int(comp.get("number", 0))))
		mirones.append(w)


	var lado: float = 1.0 if spot.x >= 0.0 else -1.0
	var arte_propio: bool = true
	var medicos: Array = []









	var destinos: Array = [
		Vector2(spot.x + 0.9, spot.y - 0.5),
		Vector2(spot.x - 0.9, spot.y - 0.9),
	]
	for k in 2:



		var desde: Vector2 = Vector2(spot.x + lado * INJURY_MEDIC_FROM[k].x,
			spot.y + INJURY_MEDIC_FROM[k].y)
		var m: AnimatedSprite3D = _spawn_medic(desde.x, desde.y, "medico_%d" % k)
		if m == null:
			arte_propio = false
			m = _spawn_actor(TEAM_TEX, desde.x, desde.y,
				PLAYER_METRICS, PLAYER_HEIGHT_M, MEDIC_CFG)



		var corre: String = "run_west" if Vector2(destinos[k]).x < desde.x else "run_east"
		if arte_propio:
			m.play(corre)
		else:
			_sub_play(m, corre, "idle")
		medicos.append(m)


	var cam: Camera3D = Camera3D.new()
	cam.fov = 42.0
	add_child(cam)






	cam.position = Vector3(spot.x - lado * 1.2, 2.4, spot.y + 7.2)
	cam.look_at(Vector3(spot.x, 0.5, spot.y))
	cam.current = true
	_stadium.keep_view_clear(cam.global_position, PackedVector3Array(), cam)

	_stadium.crowd_react("home", "close")




	_audio.hush()



	if caida_en_vivo:
		await SceneFade.timer(INJURY_FALL_BEAT).timeout
	var tw: Tween = create_tween().set_parallel(true)
	for k in medicos.size():
		var m: AnimatedSprite3D = medicos[k]
		var dest: Vector3 = Vector3(destinos[k].x, m.position.y, destinos[k].y)
		tw.tween_property(m, "position", dest, 1.4) \
				.set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_SINE)
	await tw.finished





	for k in medicos.size():
		var m: AnimatedSprite3D = medicos[k]
		var hacia: String = "west" if m.position.x > spot.x else "east"
		if arte_propio:
			m.play("atiende_" + hacia)
		else:
			_sub_play(m, "idle_" + hacia, "idle")
	await SceneFade.timer(1.6).timeout
	for m in medicos:
		if is_instance_valid(m):
			m.queue_free()
	for w in mirones:
		if is_instance_valid(w):
			w.queue_free()
	if is_instance_valid(caido):
		caido.queue_free()
	if is_instance_valid(prev_cam):
		prev_cam.current = true
	cam.queue_free()
	for hijo in ocultos:
		if is_instance_valid(hijo):
			(hijo as Node3D).visible = true
	if self_estaba and is_instance_valid(_self_actor):
		_self_actor.visible = true
	if balon_estaba and is_instance_valid(_ball):
		_ball.visible = true


	_audio.unhush()
	_sim_screen.veil(false)







































