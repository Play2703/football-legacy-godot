func _ai_shot_from_ball(kicker: AnimatedSprite3D = null, header: bool = false) -> void:
	if state != State.PASSING:
		return






	if kicker != null and not _is_you(kicker):
		_mate_kicker = kicker





	_mate_has_ball = kicker != null and not _is_you(kicker) and kicker != _self_actor

	_rematador = kicker if kicker != null else _self_actor
	var bp: Vector3 = _ball.position
	_ball_field = Vector2(bp.x, bp.z)


	_defender_pos = []
	for r in _rival_actors:
		if is_instance_valid(r):
			_defender_pos.append(Vector2(r.position.x, r.position.z))
	_snapshot_offside(bp.z, kicker)





















	var finisher: Dictionary = _finisher_of(kicker)
	var place: float = _finisher_place(finisher, header)






	var dist: float = Vector2(bp.x, bp.z).length()
	var keeper_out: float = 0.0
	if _keeper != null and is_instance_valid(_keeper):
		keeper_out = clampf((_keeper_depth(_keeper.position.z) - 1.2) / 4.0, 0.0, 1.0)
	var arch: String = _pick_finish(dist, bp.x, header, finisher, keeper_out)






	var aim_dist: float = dist



	var reach_frac: float = clampf(1.0 - maxf(aim_dist - AI_AIM_NEAR_M, 0.0)
		/ AI_AIM_FAR_DIV, AI_AIM_FAR_MIN, 1.0)




	var max_off: float = minf(maxf(bp.z, 0.6) * tan(deg_to_rad(AI_AIM_CONE)),
		AI_AIM_MAX_OFF)





	var tight: float = clampf(absf(bp.x) / maxf(bp.z, 0.5) / 1.5, 0.0, 1.0)




	var post: float =(GOAL_HALF_W - 0.7) * reach_frac \
			* lerpf(1.0, AI_AIM_TIGHT_FRAC, tight) \
			* lerpf(AI_PLACE_POST_MIN, 1.0, place) \
			*(AI_AIM_CORNER if arch == "escuadra" else 1.0)






	var lo: float = bp.x - max_off
	var hi: float = bp.x + max_off
	var aim_l: float = clampf(clampf(- post, lo, hi), - GOAL_AIM_INNER_X, GOAL_AIM_INNER_X)
	var aim_r: float = clampf(clampf(post, lo, hi), - GOAL_AIM_INNER_X, GOAL_AIM_INNER_X)






	var kx: float = _keeper.position.x
	var libre: float = aim_l if absf(aim_l - kx) > absf(aim_r - kx) else aim_r
	var tapado: float = aim_r if libre == aim_l else aim_l
	var target_x: float = libre if randf() < lerpf(AI_PLACE_READ_MIN, 1.0, place) \
			else tapado

















	var fuera: float = 1.0 if target_x >= 0.0 else -1.0
	target_x += fuera * randf_range(
		- lerpf(AI_PLACE_IN_MAX, AI_PLACE_IN_MIN, place),
		lerpf(AI_PLACE_OUT_MIN, AI_PLACE_OUT_MAX, place))
	target_x = clampf(target_x, - GOAL_AIM_INNER_X, GOAL_AIM_INNER_X)
	var dir_h: Vector3 =(Vector3(target_x, 0.0, 0.0) - Vector3(bp.x, 0.0, bp.z)).normalized()



	dir_h = dir_h.rotated(Vector3.UP, deg_to_rad(randf_range(-1.5, 1.5)))














	var chilena: bool = false
	if kicker != null and is_instance_valid(kicker):
		var to_goal: Vector3 = Vector3(0.0, 0.0, 0.0) - Vector3(kicker.position.x, 0.0, kicker.position.z)




		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + HEADER_GESTO_BUDGET_US)
		var strike_anim: String =("header_" if header else "kick_") + _dir_name(to_goal)



		if not header:
			strike_anim =("volea_" if bp.y >= VOLEA_NPC_MIN_H else "empeine_") \
					+ _dir_name(to_goal)
		var palomita: bool = false
		if header and kicker != _self_actor and bp.y <= PALOMITA_H_SEAM:





			var pal: String = "palomita_" + _perfil_hacia_arco(kicker)




			if _gesto_listo(kicker, pal):
				strike_anim = pal
				palomita = true





		if chilena_forzada:

			print("CHILENA? header=%s palomita=%s mate=%s y=%.2f dist=%.1f cae=%s lista=%s" % [
				header, palomita, kicker != _self_actor, bp.y, dist,
				_traj_i >= 1 and _traj_i < _traj.size() and _traj[_traj_i].z < _traj[_traj_i - 1].z,
				_gesto_listo(kicker, "chilena_" + _dir_name(- to_goal))])
		if header and not palomita and kicker != _self_actor and bp.y > PALOMITA_H_SEAM \
				and dist < CHILENA_DIST_MAX and _traj_i >= 1 and _traj_i < _traj.size() \
				and _traj[_traj_i].z < _traj[_traj_i - 1].z \
				and (chilena_forzada or randf() < lerpf(CHILENA_SORTEO.x, CHILENA_SORTEO.y,
					Squad.norm(finisher, "punteria"))):
			var chi: String = "chilena_" + _dir_name(- to_goal)
			if _gesto_listo(kicker, chi):
				strike_anim = chi
				chilena = true
				_chilena_viva = true
				if chilena_forzada:
					print("CHILENA ARRANCA %s" % chi)






		if palomita and _hud != null:
			var quien: String = String(_finisher_of(kicker).get("name", ""))
			_hud.show_message(I18n.tf("¡Palomita de {0}!", [quien])
				if not quien.is_empty() else I18n.t("¡Palomita!"),
				CareerTheme.GOOD, 0.9)
		if chilena and _hud != null:
			var quien_c: String = String(_finisher_of(kicker).get("name", ""))
			_hud.show_message(I18n.tf("¡Chilena de {0}!", [quien_c])
				if not quien_c.is_empty() else I18n.t("¡Chilena!"),
				CareerTheme.GOOD, 0.9)






		var listo: bool = _gesto_listo(kicker, strike_anim)
		if not listo and not palomita and not chilena:
			strike_anim = "kick_" + _dir_name(to_goal)
			listo = _gesto_listo(kicker, strike_anim)
		if listo:



			kicker.speed_scale = 1.0
			kicker.play(strike_anim)
			if not palomita and not chilena:
				_gesto_en_contacto(kicker)



			_anim_lock[kicker] = Time.get_ticks_msec() \
					+(int(ACRO_T * 1000.0) + 40 if palomita
					else (int(CHILENA_T * 1000.0) + 40 if chilena else 600))
			if palomita:





				var lunge: Vector3 = kicker.position + to_goal.normalized() * ACRO_LUNGE
				var dv_tw: Tween = create_tween()
				dv_tw.set_parallel(true)
				dv_tw.tween_property(kicker, "position:x", lunge.x, ACRO_T) \
						.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
				dv_tw.tween_property(kicker, "position:z", lunge.z, ACRO_T) \
						.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
				dv_tw.set_parallel(false)




			if strike_anim.begins_with("header_") or palomita or chilena:
				var sube: float = 0.55
				var t_up: float = GOLPE_SALTO_SUBE_T
				var t_down: float = 0.3
				if chilena:


					sube = 0.6;t_up = CHILENA_CONTACT_T;t_down = CHILENA_T - CHILENA_CONTACT_T
				if palomita:





					sube = 0.5;t_up = ACRO_T * 0.22;t_down = ACRO_T * 0.78
				var base_y: float = kicker.position.y
				var jump_tw: Tween = create_tween()
				jump_tw.tween_property(kicker, "position:y", base_y + sube, t_up) \
						.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
				jump_tw.tween_property(kicker, "position:y", base_y, t_down) \
						.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	_audio.kick()
	_keeper_reset()
	_cross_i = -1
	_net_hit = false
	_impact_sfx = false
	_post_i = -1
	_post_ix = []
	_net_out_ix = -1
	_post_bar = false
	_post_out = false
	_bar_in_out = false
	_bar_bounce_p = Vector3.ZERO
	_post_out_p = Vector3.ZERO
	_bar_under = false
	_post_sfx = 0
	_graze_ix = []
	_graze_sfx = 0
	_ball.flip_h = false
	_ball.play("roll", 1.0)



	_shoot_as(arch, finisher, bp, dir_h, dist, header, chilena)
	state = State.FLIGHT
	_traj_i = 0




func _finisher_of(actor: AnimatedSprite3D) -> Dictionary:




	if _is_you(actor):
		return _your_card()
	if actor != null and is_instance_valid(actor) and actor.has_meta("player"):
		return actor.get_meta("player")
	return Squad.fallback()










func _mate_card(scorer: String) -> Dictionary:
	if scorer.strip_edges().is_empty() or scorer == Career.player_name:
		return {}
	var quien: AnimatedSprite3D = _mate_kicker \
			if _mate_kicker != null and is_instance_valid(_mate_kicker) \
			else _last_toucher
	if quien == null or not is_instance_valid(quien) or _is_you(quien):
		return {}
	var ficha: Dictionary = _finisher_of(quien)
	if String(ficha.get("name", "")) != scorer:
		return {}
	return {"name": scorer, "number": int(ficha.get("number", 0)),
		"nation": _mate_nation(ficha),
		"look": Dictionary(quien.get_meta("look", {}))}













