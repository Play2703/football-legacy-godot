func _saque_planta(chance: Dictionary) -> void:
	_saque_pecho = bool(chance.get("saque_pecho", false))
	var yo: AnimatedSprite3D = _self_actor
	if yo == null or not is_instance_valid(yo):
		return
	var lado: float = signf(_ball_field.x) if absf(_ball_field.x) > 0.01 else 1.0
	var pie: Vector2 = Vector2(lado * SAQUE_CAL_X,
		_ball_field.y + float(chance.get("saque_dz", 0.0)))


	var mejor: AnimatedSprite3D = null
	var candidatos: Array = []
	var puestos: Array = []
	for t in _teammate_actors:
		if not is_instance_valid(t) or t == yo:
			continue
		candidatos.append(t)
		puestos.append(String((t.get_meta("player", {}) as Dictionary).get("pos", "")))
	var k_srv: int = saque_srv_de(puestos, int(lado))
	if k_srv >= 0:
		mejor = candidatos[k_srv]
	else:
		var mejor_d: float = INF
		for t in candidatos:
			var d: float = Vector2(t.position.x, t.position.z).distance_to(pie)
			if d < mejor_d:
				mejor_d = d
				mejor = t
	if mejor == null:
		return
	mejor.position.x = pie.x
	mejor.position.z = pie.y
	_face_ball(mejor)
	_saque_srv = mejor


	if _practice_kind.is_empty():
		var dt_z: float = _saque_dt_z(lado)
		if not is_nan(dt_z) and absf(dt_z - pie.y) <= SAQUE_DT_R and saque_dt_forma != 0:
			_saque_dt = _stadium.coach_balon_empieza(_home_match, 20.0)




	_teammate_actors.erase(mejor)
	_todos_nm = -1




