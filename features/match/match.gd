		return






	_grada_por_peso.call_deferred(not _celeb_rival, String(_lectura.get("grada_marca", "")),
		String(_lectura.get("grada_encaja", "")), match_minute)

	var banca: bool = _home_match != _celeb_rival
	var marca: String = String(_lectura.get("dt_marca", ""))
	var encaja: String = String(_lectura.get("dt_encaja", ""))
	if not marca.is_empty():
		_stadium.coach_gesture(banca, marca, DT_PESO_S)
	if not encaja.is_empty():
		_stadium.coach_gesture(not banca, encaja, DT_PESO_S)


