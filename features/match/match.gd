	var vivos: Array[Dictionary] = []
	for v in _dianas_vuelos:
		var n: Sprite3D = v["n"]
		if not is_instance_valid(n):
			continue
		var traj: Array = v["traj"]
		var i: int = int(v["i"]) + 1
		if i >= traj.size():
			_dianas_poste_balon = bool(v.get("poste", false))
			_dianas_anota(int(v["pts"]), int(v["g"]))




			_dianas_muertos.append(n)
			while _dianas_muertos.size() > DIANAS_MAX_MUERTOS:
				var viejo: Node = _dianas_muertos.pop_front()
				if is_instance_valid(viejo):
					viejo.queue_free()
			continue
		n.position = traj[i] + Vector3(0.0, BALL_VISUAL_D * 0.5, 0.0)
		v["i"] = i
