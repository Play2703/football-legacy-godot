func _aim_cam_look(target: Vector3, delta: float, stiff: float = 6.0) -> void:
	if not _aim_cam.current:
		return
	var to_target: Vector3 = target - _aim_cam.global_position
	if to_target.length_squared() < 0.01:
		return
	var desired: Basis = Basis.looking_at(to_target.normalized(), Vector3.UP)
	var w: float = 1.0 - exp(- stiff * delta)
	_aim_cam.global_transform.basis = \
			_aim_cam.global_transform.basis.slerp(desired, w).orthonormalized()





func _drive_look_lift(look_t: Vector3, sujeto: Vector3, delta: float,
		stiff: float = DRIVE_CAM_STIFF) -> void:
	var cuerpo: Vector3 = Vector3(sujeto.x, PLAYER_HEIGHT_M * 0.5, sujeto.z)
	var alto: Vector3 = _lift_aim(cuerpo) - _aim_cam.global_position
	var plano: float = Vector2(alto.x, alto.z).length()
	var rumbo: Vector2 = Vector2(look_t.x - _aim_cam.global_position.x,
		look_t.z - _aim_cam.global_position.z)
	if rumbo.length_squared() < 0.0001 or plano < 0.001:
		_aim_cam_look(_lift_aim(cuerpo), delta, stiff)
		return
	rumbo = rumbo.normalized() * plano
	_aim_cam_look(_aim_cam.global_position
		+ Vector3(rumbo.x, alto.y, rumbo.y), delta, stiff)


















func _center_cam_on_self() -> void:
	if _aim_cam == null or not is_instance_valid(_self_actor):
		return
	var fwd: Vector3 = - _aim_cam.global_transform.basis.z
	var h: float = Vector2(fwd.x, fwd.z).length()
	if h < 0.001:
		return
	var lat: Vector3 = Vector3(- fwd.z, 0.0, fwd.x) / h
	var me: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)

	_aim_cam.global_position += lat *(me - _aim_cam.global_position).dot(lat)





	_aim_cam.global_position = me + _bowl_off(me, _aim_cam.global_position - me)


	var to_me: Vector3 = me - _aim_cam.global_position
	var flat: Vector2 = Vector2(to_me.x, to_me.z)
	if flat.length_squared() < 0.0001:
		return
	flat = flat.normalized() * h
	_aim_cam.global_transform.basis = Basis.looking_at(
		Vector3(flat.x, fwd.y, flat.y).normalized(), Vector3.UP)










func _weld_cam_lateral(goal_pos: Vector3, delta: float,
		look: Vector3 = Vector3.INF) -> void:
	if look == Vector3.INF:
		look = _ball.global_position
	var k: float = 1.0 - exp(- CAM_CENTER_STIFF * delta)
	var fwd: Vector3 = - _aim_cam.global_transform.basis.z
	var fwd_flat: Vector2 = Vector2(fwd.x, fwd.z)
	var h: float = fwd_flat.length()
	if h < 0.001:
		return

	var lat: Vector3 = Vector3(- fwd.z, 0.0, fwd.x) / h
	var err: float =(goal_pos - _aim_cam.global_position).dot(lat)
	_aim_cam.global_position += lat *(err * k)













	var pedido: Vector3 = _aim_cam.global_position - look
	var metido: Vector3 = _bowl_off(look, pedido)
	if metido != pedido:
		fwd_flat = fwd_flat.rotated(
			Vector2(pedido.x, pedido.z).angle_to(Vector2(metido.x, metido.z)))
	_aim_cam.global_position = look + metido










	var to_ball: Vector3 = look - _aim_cam.global_position
	var ball_flat: Vector2 = Vector2(to_ball.x, to_ball.z)
	if ball_flat.length_squared() < 0.0001:
		return
	var new_flat: Vector2 = ball_flat.normalized()
	var new_fwd: Vector3 = Vector3(new_flat.x * h, fwd.y, new_flat.y * h)
	_aim_cam.global_transform.basis = \
			Basis.looking_at(new_fwd.normalized(), Vector3.UP)













