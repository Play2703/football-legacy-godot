const META_CARGA_BANDA_K: float = 0.3










const META_CARGA_BANDA: Vector2 = Vector2(6.0, 10.0)
const META_CARGA_CENTRO: float = 3.0
const META_ANCHO_CENTRO: Vector2 = Vector2(0.95, 1.2)
const META_ANCHO_BANDA: Vector2 = Vector2(0.85, 1.0)


var _meta_zona_mia: Vector2i = Vector2i(9, 9)
var _meta_zona_riv: Vector2i = Vector2i(9, 9)







func _meta_zona(prev: Vector2i, altos: Array[Vector2]) -> Dictionary:
	var clave: Vector2i = prev
	while clave == prev:
		clave = Vector2i(randi_range(-1, 1), randi_range(0, altos.size() - 1))
	var carga: float = randf_range(- META_CARGA_CENTRO, META_CARGA_CENTRO)
	var ancho: float = randf_range(META_ANCHO_CENTRO.x, META_ANCHO_CENTRO.y)
	if clave.x != 0:
		carga = float(clave.x) * randf_range(META_CARGA_BANDA.x, META_CARGA_BANDA.y)
		ancho = randf_range(META_ANCHO_BANDA.x, META_ANCHO_BANDA.y)
	var alto: Vector2 = altos[clave.y]
	return {"clave": clave, "carga": carga, "ancho": ancho,
		"alto": randf_range(alto.x, alto.y)}















func _meta_zaga_cubre(rivales: Array, filas: Array, mios: Array) -> Array:
	if filas.is_empty() or mios.is_empty() or rivales.is_empty():
		return rivales
	var punta: float = INF
	for p in mios:
		punta = minf(punta,(p as Vector2).y)
	var n_def: int = mini(int(filas[0]), rivales.size())
	var zaga: float = INF
	for k in n_def:
		zaga = minf(zaga,(rivales[k] as Vector2).y)
	var baja: float = zaga -(punta - META_ZAGA_COLCHON)
	if baja <= 0.0:
		return rivales
	var out: Array = rivales.duplicate()
	for k in n_def:
		var v: Vector2 = out[k]
		out[k] = Vector2(v.x, maxf(v.y - baja, 3.0))
	return out





const META_ZAGA_COLCHON: float = 2.0


























func _meta_salida_mia(filas: Array, huecos: Array, ball: Vector2, linea: float,
		zona: Dictionary) -> Array:
	var h: int = clampi((zona["clave"] as Vector2i).y, 0, META_LAT_ALTO.size() - 1)
	var carga: float = float(zona["carga"])
	var pivote_z: float = float(zona["alto"])
	var lat_z: Vector2 = META_LAT_ALTO[h]
	var ocho_t: Vector2 = META_OCHO_T[h]


	var lado: float = 1.0 if ball.x >= 0.0 else -1.0
	var n: int = 0
	for f in filas:
		n += int(f)
	var rangos: Array = _meta_rangos(filas, n)
	var n_def: int = int(filas[0]) if not filas.is_empty() else 4
	var n_cen: int = 0
	for k in (rangos[0] if not rangos.is_empty() else []):
		if _flanco(k, huecos) == 0:
			n_cen += 1
	if n_cen % 2 == 1:
		pivote_z -= META_PIVOTE_TRES
	var out: Array = []
	for k in n:
		out.append(Vector2(0.0, pivote_z))
	for r in rangos.size():
		var fila: Array = rangos[r]
		var ultima: bool = r == rangos.size() - 1


		var centro: Array = []
		for k in fila:
			if _flanco(k, huecos) == 0:
				centro.append(k)
		if r == 0:


			for j in centro.size():
				var t: float = 0.5 if centro.size() <= 1 else float(j) / float(centro.size() - 1)
				out[centro[j]] = Vector2(lerpf(-10.0, 10.0, t), META_CENTRAL_Z)
		elif ultima:


			var baja: int = randi_range(0, maxi(centro.size() - 1, 0))
			for j in centro.size():
				var x: float = randf_range(-3.0, 3.0)
				var z: float = linea + randf_range(0.3, 1.5)
				if centro.size() >= 2:
					var t: float = float(j) / float(centro.size() - 1)
					x = lerpf(-1.0, 1.0, t) * randf_range(4.0, 8.0)
					z = linea + randf_range(0.3, 2.0) +(randf_range(1.0, 5.0) if j == baja else 0.0)
				out[centro[j]] = Vector2(x + carga, z)
		else:

			var piv: Array = []
			var ochos: Array = []
			var dieces: Array = []
			for k in centro:
				match _meta_puesto(k, huecos):
					"MCD":
						piv.append(k)
					"CAM":
						dieces.append(k)
					_:
						ochos.append(k)


			if piv.is_empty() and r == 1:
				if ochos.size() == 2:
					piv = ochos.duplicate()
					ochos.clear()
				elif ochos.size() % 2 == 1:
					var medio: int = ochos.size()>>1
					piv.append(ochos[medio])
					ochos.remove_at(medio)
			for j in piv.size():
				var x: float = lado * randf_range(0.0, 4.0)
				var z: float = pivote_z
				if piv.size() >= 2:
					var t: float = float(j) / float(piv.size() - 1)
					x = lerpf(-1.0, 1.0, t) * randf_range(META_DOBLE_X.x, META_DOBLE_X.y)

					if signf(x) != lado:
						z -= randf_range(3.0, 6.0)
				out[piv[j]] = Vector2(x + carga * META_CARGA_PIVOTE, z)
			var sube: int = randi_range(0, maxi(ochos.size() - 1, 0))
			for j in ochos.size():
				var s: float =(-1.0 if randf() < 0.5 else 1.0) if ochos.size() == 1 \
						else lerpf(-1.0, 1.0, float(j) / float(ochos.size() - 1))
				var z: float = lerpf(pivote_z, linea, randf_range(ocho_t.x, ocho_t.y))
				if ochos.size() >= 2 and j == sube:
					z -= randf_range(3.0, 6.0)
				out[ochos[j]] = Vector2(s * randf_range(META_OCHO_X.x, META_OCHO_X.y)
					+ carga * META_CARGA_OCHO, z)
			for k in dieces:
				out[k] = Vector2(randf_range(-4.0, 4.0) + carga, linea + randf_range(7.0, 12.0))

		for k in fila:
			var f: int = _flanco(k, huecos)
			if f == 0:
				continue
			var puesto: String = _meta_puesto(k, huecos)
			var z: float = randf_range(lat_z.x, lat_z.y)
			if r == 0:
				if n_def >= 5:
					z -= randf_range(4.0, 8.0)
				elif float(f) == lado:
					z += randf_range(0.0, 3.0)
				else:
					z -= randf_range(0.0, 4.0)
			elif puesto == "EI" or puesto == "ED" or ultima:
				z = linea +(randf_range(0.5, 3.0) if ultima else randf_range(2.0, 6.0))
			elif n_def <= 3:
				z -= randf_range(3.0, 7.0)
			else:
				z = lerpf(z, linea, randf_range(0.45, 0.6))
			out[k] = Vector2(float(f) * randf_range(META_BANDA_X.x, META_BANDA_X.y)
				+ carga * META_CARGA_BANDA_K, z)
	var lim: float = Stadium.FIELD_HALF_W - 1.5
	for k in n:
		var v: Vector2 = out[k]
		out[k] = Vector2(clampf(v.x, - lim, lim), clampf(v.y, 3.0, Stadium.FIELD_DEPTH - 2.0))
	return out




func _meta_roles(shape: String, huecos: Array) -> Array:
	if not huecos.is_empty():
		return huecos
	var out: Array = []
	for s in (Squad.FORMATIONS.get(shape, {}) as Dictionary).get("xi", []) as Array:
		if String(s) != "POR":
			out.append(String(s))
	return out



func _meta_puesto(k: int, huecos: Array) -> String:
	if k >= huecos.size():
		return ""
	var v: Variant = huecos[k]
	return String((v as Dictionary).get("pos", "")) if v is Dictionary else String(v)






























func _meta_marca(filas: Array, huecos: Array, fichas: Array, mios: Array, cen: Array,
		ball: Vector2, linea: float, zona: Dictionary) -> Array:
	var frontal: float = Stadium.FIELD_DEPTH - Stadium.PA_DEPTH - PEN_OUT_PAD
	var n: int = 0
	for f in filas:
		n += int(f)
	var rangos: Array = _meta_rangos(filas, n)


	var nat: Array = []
	for r in rangos.size():
		var t: float = 0.0 if rangos.size() <= 1 else float(r) / float(rangos.size() - 1)
		var z: float = lerpf(linea - 1.0, frontal - 1.0, t)
		var cuantos: int =(rangos[r] as Array).size()
		var ancho: float = _meta_ancho_fila(cuantos, r == rangos.size() - 1)
		for j in cuantos:
			var u: float = 0.5 if cuantos <= 1 else float(j) / float(cuantos - 1)
			nat.append(Vector2(lerpf(- ancho, ancho, u) * 0.5, z))
	nat = _meta_por_asiento(nat, filas, huecos, false)

	var marcables: Array = []
	for k in mios.size():
		var v: Vector2 = mios[k]
		if v.y > Stadium.FIELD_DEPTH - Stadium.PA_DEPTH and absf(v.x) < Stadium.PA_HALF_W:
			continue
		marcables.append(k)
	var coste: Array = []
	for k in marcables:
		var cita: Vector2 = _meta_sitio_marca(mios[k], META_MARCA_COSTE_M)
		var fila_c: Array = []
		for i in n:
			var c: float =(nat[i] as Vector2).distance_squared_to(cita)
			var f: int = _flanco(i, huecos)
			if f != 0 and - float(f) * cita.x < - META_CRUCE_X:
				c += META_CRUCE_COSTE
			fila_c.append(c)
		coste.append(fila_c)




	var zaga_n: int =(rangos[0] as Array).size() if not rangos.is_empty() else 0
	if zaga_n >= 3 and marcables.size() < n:
		var cobertura: Vector2 = Vector2(0.0, linea - 4.0)
		var fila_l: Array = []
		for i in n:
			fila_l.append((nat[i] as Vector2).distance_squared_to(cobertura)
				if i < zaga_n else META_CRUCE_COSTE)
		coste.append(fila_l)
	var asig: Array = _meta_hungaro(coste)
	var out: Array = nat.duplicate()
	var usado: Dictionary = {}
	for a in mini(asig.size(), marcables.size()):
		var i: int = int(asig[a])
		if i < 0:
			continue
		usado[i] = true
		out[i] = _meta_sitio_marca(mios[marcables[a]])


	var zaga_z: float = linea - 2.0
	var hay_zaga: bool = false
	for i in (rangos[0] if not rangos.is_empty() else []):
		if usado.has(i):
			zaga_z =(out[i] as Vector2).y if not hay_zaga else minf(zaga_z,(out[i] as Vector2).y)
			hay_zaga = true
	var puntas_x: float = 0.0
	var puntas_n: int = 0
	for v in mios:
		if (v as Vector2).y < linea + 5.0:
			puntas_x +=(v as Vector2).x
			puntas_n += 1
	var libre_x: float = clampf(puntas_x / float(maxi(puntas_n, 1)), -9.0, 9.0) \
			+ float(zona["carga"]) * 0.4




	var libres: Array = []
	var sueltos: Array = []
	for r in rangos.size():
		for i in rangos[r]:
			if not usado.has(i):
				(libres if r == 0 else sueltos).append(i)
	libres.sort_custom(func(a: int, b: int) -> bool:
		return absf((nat[a] as Vector2).x) < absf((nat[b] as Vector2).x))
	for j in libres.size():
		var x: float = libre_x if j == 0 else (nat[libres[j]] as Vector2).x * 0.6
		out[libres[j]] = Vector2(clampf(x, -20.0, 20.0), zaga_z - randf_range(3.0, 6.0))


	var citas: Array = []
	var cbs: Array = cen.duplicate()
	cbs.sort_custom(func(a: int, b: int) -> bool:
		return absf((mios[a] as Vector2).x - ball.x) < absf((mios[b] as Vector2).x - ball.x))
	for c in cbs:


		if absf((mios[c] as Vector2).x) < 6.0 or marcables.has(c):
			continue
		citas.append(Vector2((mios[c] as Vector2).x * randf_range(0.65, 0.85),
			frontal - randf_range(0.3, 2.0)))
	citas.append(Vector2(ball.x * 0.5 + randf_range(-2.0, 2.0), frontal - randf_range(0.3, 2.0)))
	for cita in citas:
		if sueltos.is_empty():
			break
		var mejor: int = 0
		for s in sueltos.size():
			if (nat[sueltos[s]] as Vector2).distance_to(cita) \
					<(nat[sueltos[mejor]] as Vector2).distance_to(cita):
				mejor = s
		out[sueltos[mejor]] = cita
		sueltos.remove_at(mejor)
	for i in sueltos:
		out[i] = Vector2(randf_range(-6.0, 6.0), lerpf(linea, frontal, randf_range(0.4, 0.6)))



	var puestos: Array = fichas if fichas.size() == n else huecos
	var donde: Dictionary = {}
	for i in mini(puestos.size(), out.size()):
		donde[_meta_puesto(i, puestos)] = i
	for par in [["LTI", "LTD"], ["MI", "MD"], ["EI", "ED"]]:
		if not donde.has(par[0]) or not donde.has(par[1]):
			continue
		var izq: int = donde[par[0]]
		var der: int = donde[par[1]]
		if (out[izq] as Vector2).x <(out[der] as Vector2).x:
			var tmp: Vector2 = out[izq]
			out[izq] = out[der]
			out[der] = tmp
	return out









func _meta_reparte_marcas(line_i: int) -> void:
	var rivs: Array = []
	for i in _rival_actors.size():
		if i < _defender_pos.size() and _mark_eligible(i, line_i):
			rivs.append(i)
	var hombres: Array = []
	for t in _teammate_actors:
		if is_instance_valid(t) and t != _self_actor:
			hombres.append(t)
	if rivs.is_empty() or hombres.is_empty():
		return
	var coste: Array = []
	for i in rivs:
		var fila: Array = []
		for t in hombres:
			var cita: Vector2 = Duel.cover_point(
				Vector2((t as Node3D).position.x,(t as Node3D).position.z), Vector2.ZERO)
			var d: float =(_defender_pos[i] as Vector2).distance_to(cita)
			fila.append(d * d +(META_CRUCE_COSTE if d > _track_r(i) else 0.0))
		coste.append(fila)
	var asig: Array = _meta_hungaro(coste)
	var parejas: Array = []
	for r in asig.size():
		var h: int = int(asig[r])
		if h >= 0 and float(coste[r][h]) < META_CRUCE_COSTE:
			parejas.append([float(coste[r][h]), rivs[r], hombres[h]])
	parejas.sort_custom(func(a: Array, b: Array) -> bool: return float(a[0]) < float(b[0]))
	for par in parejas.slice(0, _track_max()):
		_mark_of[int(par[1])] = par[2]
		_mark_home[int(par[1])] = _defender_pos[int(par[1])]




const META_MARCA_COSTE_M: float = 2.2


const META_CRUCE_X: float = 8.0
const META_CRUCE_COSTE: float = 10000.0




func _meta_ancho_fila(n: int, ataque: bool) -> float:
	match n:
		1:
			return 0.0
		2:
			return 20.0 if ataque else 18.0
		3:
			return 40.0 if ataque else 30.0
		4:
			return 52.0
	return 56.0







func _meta_hungaro(coste: Array) -> Array:
	var n: int = coste.size()
	if n == 0:
		return []
	var m: int =(coste[0] as Array).size()
	if n > m:
		var tr: Array = []
		for j in m:
			var fila: Array = []
			for i in n:
				fila.append(coste[i][j])
			tr.append(fila)
		var inv: Array = _meta_hungaro(tr)
		var res: Array = []
		for i in n:
			res.append(-1)
		for j in m:
			if int(inv[j]) >= 0:
				res[int(inv[j])] = j
		return res
	var u: PackedFloat64Array = PackedFloat64Array()
	u.resize(n + 1)
	var v: PackedFloat64Array = PackedFloat64Array()
	v.resize(m + 1)
	var p: PackedInt32Array = PackedInt32Array()
	p.resize(m + 1)
	var way: PackedInt32Array = PackedInt32Array()
	way.resize(m + 1)
	for i in range(1, n + 1):
		p[0] = i
		var j0: int = 0
		var minv: PackedFloat64Array = PackedFloat64Array()
		minv.resize(m + 1)
		minv.fill(INF)
		var usado: PackedByteArray = PackedByteArray()
		usado.resize(m + 1)
		while true:
			usado[j0] = 1
			var i0: int = p[j0]
			var delta: float = INF
			var j1: int = 0
			for j in range(1, m + 1):
				if usado[j] == 0:
					var cur: float = float(coste[i0 - 1][j - 1]) - u[i0] - v[j]
					if cur < minv[j]:
						minv[j] = cur
						way[j] = j0
					if minv[j] < delta:
						delta = minv[j]
						j1 = j
			for j in m + 1:
				if usado[j] == 1:
					u[p[j]] += delta
					v[j] -= delta
				else:
					minv[j] -= delta
			j0 = j1
			if p[j0] == 0:
				break
		while j0 != 0:
			var j1: int = way[j0]
			p[j0] = p[j1]
			j0 = j1
	var out: Array = []
	for i in n:
		out.append(-1)
	for j in range(1, m + 1):
		if p[j] != 0:
			out[p[j] - 1] = j - 1
	return out




func _meta_sitio_marca(hombre: Vector2, d: float = -1.0) -> Vector2:
	var hacia: Vector2 = - hombre
	var dir: Vector2 = hacia.normalized() if hacia.length() > 0.01 else Vector2(0.0, -1.0)
	return hombre + dir *(d if d >= 0.0 else randf_range(META_MARCA_M.x, META_MARCA_M.y))




func _meta_rangos(filas: Array, n: int) -> Array:
