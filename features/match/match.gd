func _carga_kick_step(delta: float) -> Vector3:
	var stiff: float = CARGA_CAM_KICK_IN \
			if _carga_kick_want.length() > _carga_kick.length() else CARGA_CAM_KICK_OUT
	_carga_kick = _carga_kick.lerp(_carga_kick_want, 1.0 - exp(- stiff * delta))
	return _carga_kick


func _carga_cam_kick(push: Vector2) -> Vector3:
	if Settings.reduce_motion:
		return Vector3.ZERO
	var fuerza: float = minf(push.length() * CARGA_CAM_KICK_M, CARGA_CAM_KICK_MAX) \
			* Settings.screen_shake
	if fuerza <= 0.0001:
		return Vector3.ZERO
	var dir: Vector2 = push.normalized()
	return Vector3(dir.x, - CARGA_CAM_KICK_DIP, dir.y) * fuerza






func _duel_mate_vel(i: int) -> Vector2:
	if i >= _duel_mate_dir.size():
		return Vector2.ZERO
	var f: float = Duel.MATE_BURST_F if i < _duel_mate_burst.size() \
			and _duel_mate_burst[i] > 0.0 else Duel.MATE_DRIFT_F
	return _duel_mate_dir[i] * _duel_chase_spd * f






















