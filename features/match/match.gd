func _eslalon_despega() -> void:
	for i in _duel_defs.size():
		var fuera: Vector2 = _push_out(_duel_defs[i], _duel_pos, Crowding.DUEL_SEP)
		if fuera == _duel_defs[i]:
			continue
		_duel_defs[i] = _inside_field(fuera)












		if i < _duel_def_vels.size():
			var radial: Vector2 =(_duel_defs[i] - _duel_pos).normalized()
			var dentro: float =(_duel_def_vels[i] as Vector2).dot(radial)
			if dentro < 0.0:
				_duel_def_vels[i] =(_duel_def_vels[i] as Vector2) - radial * dentro
		if i < _duel_def_actors.size() and is_instance_valid(_duel_def_actors[i]):
			var a: AnimatedSprite3D = _duel_def_actors[i]
			a.position = Vector3(_duel_defs[i].x, a.position.y, _duel_defs[i].y)


