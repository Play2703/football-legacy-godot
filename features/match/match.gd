func _clean_shot_chance() -> Dictionary:
	var origen: Dictionary = {}
	for _i in Practice.TRIES:
		var o: Dictionary = _draw_open_any(-1.0 if randf() < 0.5 else 1.0)
		if String(o.get("kind", "")) == "frontal":
			origen = o
			break
	if origen.is_empty():
