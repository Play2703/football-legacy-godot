func _npc_bloqueos(contenders: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	if not bloqueo_npc_enabled:
		return out
	var ahora: float = float(Time.get_ticks_msec()) / 1000.0
	var por_bando: Array = [[], []]
	for a in contenders:
		if not is_instance_valid(a):
			continue
		var cita: Vector3 = contenders[a]
		var t: float = _flat_dist(a.position, cita) \
				/ maxf(_chaser_speed.get(a, AimPress.SPEED_FALLBACK), 0.5)
		por_bando[1 if _rival_set.has(a) else 0].append([t, a])
	for lista in por_bando:
		lista.sort_custom(func(x: Array, y: Array) -> bool: return x[0] < y[0])
	for b in 2:
		var mios: Array = por_bando[b]
		var suyos: Array = por_bando[1 - b]
		if mios.size() < 2 or suyos.is_empty():
			continue
		if suyos.size() >= 2 and float(suyos[1][0]) - float(suyos[0][0]) < BLOQUEO_SOLO_S:
			continue
		var rival: AnimatedSprite3D = suyos[0][1]
		var pr: Vector2 = Vector2(rival.position.x, rival.position.z)





		var k_bloq: int = 1
		var d0: float = pr.distance_to(Vector2(mios[0][1].position.x, mios[0][1].position.z))
		var d1: float = pr.distance_to(Vector2(mios[1][1].position.x, mios[1][1].position.z))
		if d0 < d1 and float(mios[1][0]) - float(mios[0][0]) < Duel.SHOULDER_EDGE_S:
			k_bloq = 0
		var bloq: AnimatedSprite3D = mios[k_bloq][1]
		var al_balon: AnimatedSprite3D = mios[1 - k_bloq][1]
		if float(suyos[0][0]) - float(mios[1 - k_bloq][0]) >= Duel.SHOULDER_EDGE_S:
			continue
		if float(bloq.get_meta("hombro_no", 0.0)) > ahora:
			continue
		var pb: Vector2 = Vector2(bloq.position.x, bloq.position.z)
		var vr: Vector2 = _chase_vels.get(rival, Vector2.ZERO)
		var d: float = pb.distance_to(pr)
		if d > BLOQUEO_R or d < 0.0001 or vr.length() < Duel.SHOULDER_MIN_PACE:
			continue







		var sigue: bool = _bloqueo_vivo.get(rival) == bloq
		var atras: float =(pb - pr).normalized().dot(vr.normalized())
		if atras <=(Duel.SHOULDER_BEHIND_COS if d <= Duel.CARGA_R and not sigue \
				else Duel.SHOULDER_SWING_COS):
			continue
		out[bloq] = [rival, al_balon]
	return out












func _bloqueo_cita(bloq: AnimatedSprite3D, pos: Vector2, rival: AnimatedSprite3D,
		contenders: Dictionary) -> Vector2:
	var pr: Vector2 = Vector2(rival.position.x, rival.position.z)
	var vr: Vector2 = _chase_vels.get(rival, Vector2.ZERO)



	if not contenders.has(rival) or pos.distance_to(pr) <= Duel.CARGA_R:
		return Duel.shoulder_point(pr, vr, pos)
	var su_cita: Vector3 = contenders[rival]
	var fin: Vector2 = Vector2(su_cita.x, su_cita.z)
	var v_r: float = maxf(_chaser_speed.get(rival, AimPress.SPEED_FALLBACK), 0.5)
	var v_b: float = maxf(_chaser_speed.get(bloq, AimPress.SPEED_FALLBACK), 0.5)
	var largo: float = pr.distance_to(fin)
	for k in range(1, BLOQUEO_PASOS + 1):
		var f: float = float(k) / float(BLOQUEO_PASOS)
		var p: Vector2 = pr.lerp(fin, f)
		if pos.distance_to(p) / v_b <= largo * f / v_r:
			return p
	return Duel.shoulder_point(pr, vr, pos)














func _npc_shoulder(actor: AnimatedSprite3D, pos: Vector2, ball_d: float,
		contenders: Dictionary) -> Vector2:
	var mi_bando: bool = _rival_set.has(actor)













	var mi_cita: Vector3 = contenders.get(actor, _ball.position)
	var mi_d: float = pos.distance_to(Vector2(mi_cita.x, mi_cita.z))


	if mi_d > CARGA_NPC_HOMBRO_CORTE:
		return Vector2.INF
	var mi_t: float = mi_d / maxf(_chaser_speed.get(actor, AimPress.SPEED_FALLBACK), 0.5)
	var bola_d: float = minf(ball_d, mi_d)
	var best: Vector2 = Vector2.INF
	var best_d: float = Duel.SHOULDER_R
	for otro in contenders:
		if otro == actor or not is_instance_valid(otro):
			continue



		if _rival_set.has(otro) == mi_bando:
			continue
		var opos: Vector2 = Vector2(otro.position.x, otro.position.z)
		var d: float = pos.distance_to(opos)
		if d >= best_d:
			continue
		var ovel: Vector2 = _chase_vels.get(otro, Vector2.ZERO)




		var su_cita: Vector3 = contenders[otro]
		var su_t: float = opos.distance_to(Vector2(su_cita.x, su_cita.z)) \
				/ maxf(_chaser_speed.get(otro, AimPress.SPEED_FALLBACK), 0.5)
		if Duel.should_shoulder(pos, opos, ovel, _rival_lead(actor),
				_rival_peso(actor), bola_d, su_t - mi_t):
			best_d = d
			best = Duel.shoulder_point(opos, ovel, pos)
	return best






