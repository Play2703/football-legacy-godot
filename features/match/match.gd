func _ball_track() -> void:
	if _fx == null or _stadium == null:
		return
	var w: String = _stadium.weather_id()
	if not WeatherWear.marks_on(w):


		_track_last = Vector2.INF
		return
	var nieve: bool = bool(_stadium.weather.get("snow", false))
	var paso: float = BALL_TRACK_SNOW_M if nieve else BALL_TRACK_MUD_M
	if _track_last == Vector2.INF:


		_track_last = _ball_field
		return
	if _ball_field.distance_to(_track_last) < paso:
		return





	_track_last = _ball_field
	if nieve:
		_stadium.tread_at(_ball_field.x, _ball_field.y, BALL_TRACK_SNOW_HIT)
		return
	_fx.ground_mark(Vector3(_ball_field.x, 0.0, _ball_field.y),
		BALL_TRACK_MUD_D, WeatherWear.mark_color(w))


func _puddle_wake(vel: Vector2, delta: float, escala: float = 1.0) -> void:
	if _fx == null or _stadium == null:
		return
	var lluvia: bool = bool(_stadium.weather.get("rain", false))












	var nieve: bool = bool(_stadium.weather.get("snow", false))
	if not lluvia and not nieve:
		return
	_wake_cd -= delta
	var spd: float = vel.length()
	if nieve:



		if spd < WAKE_FILM_SPEED or _wake_cd > 0.0:
			return
		_wake_cd = WAKE_PERIOD













		_fx.splash_dir(Vector3(vel.x, 0.0, vel.y))
		_fx.step_splash(Vector3(_ball_field.x, 0.03, _ball_field.y),
			Vector3(- vel.x, 0.0, - vel.y), clampf(spd / 7.0, 0.0, 1.0), true, escala)
		return
	var wet: float = 0.0
	if _stadium.puddles != null:
		wet = _stadium.puddles.depth_at(_ball_field.x, _ball_field.y)
	if wet <= PUDDLE_MIN:




		_wake_dry = true
		if spd < WAKE_FILM_SPEED or _wake_cd > 0.0:
			return
		_wake_cd = WAKE_PERIOD
		_fx.splash_dir(Vector3(vel.x, 0.0, vel.y))
		_fx.splash_burst(Vector3(_ball_field.x, 0.06, _ball_field.y),
			spd * SPRAY_FILM, escala)
		return
	if spd < SPLASH_WAKE_SPEED:
		_wake_dry = true
		return


	if _wake_cd > 0.0 and not _wake_dry:
		return
	var loud: bool = _wake_dry
	_wake_cd = WAKE_PERIOD
	_wake_dry = false
	_fx.splash_dir(Vector3(vel.x, 0.0, vel.y))
	_fx.splash_burst(Vector3(_ball_field.x, 0.06, _ball_field.y), spd, escala)
	if loud and _audio != null:
		_audio.splash(spd)









func _add_splash(pos: Vector3, vel: Vector3, power: float, loud: bool) -> void:
