func _card_cam_in(r: AnimatedSprite3D) -> void:
	if not is_instance_valid(r):
		return
	var juego: Camera3D = SceneFade.camara_de(self)
	if juego == null:
		return
	if _card_cam == null:
		_card_cam = Camera3D.new()
		add_child(_card_cam)







	if juego != _card_cam:
		_card_cam_home = juego.global_transform
	if juego != _card_cam:
		_card_cam.fov = juego.fov
		_card_cam.global_transform = _card_cam_home
	_card_cam.current = true
	var destino: Transform3D = _card_cam_destino(r)
	if _card_cam_tween and _card_cam_tween.is_valid():
		_card_cam_tween.kill()
	if Settings.reduce_motion:
		_card_cam.global_transform = destino
		_card_cam.fov = CARD_CAM_FOV
	else:
		_card_cam_tween = create_tween()
		_card_cam_tween.set_parallel(true)
		_card_cam_tween.tween_property(_card_cam, "global_transform", destino,
			CARD_CAM_IN_S).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		_card_cam_tween.tween_property(_card_cam, "fov", CARD_CAM_FOV,
			CARD_CAM_IN_S).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	_card_cam_gen += 1
	SceneFade.timer(CARD_CAM_IN_S + CARD_CAM_HOLD_S, false) \
			.timeout.connect(_card_cam_out.bind(_card_cam_gen))






func _card_cam_destino(r: AnimatedSprite3D) -> Transform3D:
	var pivote: Vector3 = r.global_position + Vector3(0.0, CARD_CAM_LOOK_Y, 0.0)
	var desde: Vector3 = _card_cam_home.origin - r.global_position
	desde.y = 0.0
	if desde.length_squared() < 0.01:
		desde = Vector3.BACK
	var ojo: Vector3 = r.global_position + desde.normalized() * CARD_CAM_DIST \
			+ Vector3(0.0, CARD_CAM_HEIGHT, 0.0)
	var t: Transform3D = Transform3D.IDENTITY
	t.origin = ojo
	return t.looking_at(pivote, Vector3.UP)





func _card_cam_out(gen: int = 0) -> void:
	if gen != 0 and gen != _card_cam_gen:
		return
	if _card_cam == null or not is_instance_valid(_card_cam):
		return
	if not _card_cam.current:
		return
	if _card_cam_tween and _card_cam_tween.is_valid():
		_card_cam_tween.kill()
	if Settings.reduce_motion:
		_card_cam_end()
		return
	_card_cam_tween = create_tween()
	_card_cam_tween.set_parallel(true)
	_card_cam_tween.tween_property(_card_cam, "global_transform", _card_cam_home,
		CARD_CAM_OUT_S).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	_card_cam_tween.tween_property(_card_cam, "fov", _aim_cam.fov if _aim_cam \
			else CARD_CAM_FOV, CARD_CAM_OUT_S) \
			.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	SceneFade.timer(CARD_CAM_OUT_S, false).timeout.connect(
		_card_cam_end.bind(_card_cam_gen))




func _card_cam_end(gen: int = 0) -> void:
	if gen != 0 and gen != _card_cam_gen:
		return
	if _card_cam_tween and _card_cam_tween.is_valid():
		_card_cam_tween.kill()
	if _card_cam != null and is_instance_valid(_card_cam):
		_card_cam.current = false
	if _aim_cam and is_instance_valid(_aim_cam):
