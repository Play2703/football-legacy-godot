func _heli_part(mesh: Mesh, col: Color) -> MeshInstance3D:
	var mi: MeshInstance3D = MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = _heli_mat(col)
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_heli.add_child(mi)
	return mi





func _heli_mat(col: Color) -> StandardMaterial3D:
	var m: StandardMaterial3D = StandardMaterial3D.new()
	m.albedo_color = col
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	return m




func _tick_heli(delta: float) -> void:
	if _heli == null or not is_instance_valid(_heli):
		return
	_heli_t += delta
	var t: float = clampf(_heli_t / _heli_dur, 0.0, 1.0)
	if t < HELI_FROM or t > HELI_TO:
		_heli.visible = false
		return
	var u: float =(t - HELI_FROM) / maxf(HELI_TO - HELI_FROM, 0.001)
	_heli.visible = true
	_heli.position = Vector3(lerpf(HELI_X0, HELI_X1, u),
		lerpf(HELI_Y0, HELI_Y1, u), HELI_Z)

	_heli.rotation_degrees = Vector3(HELI_PITCH_DEG, 0.0, HELI_ROLL_DEG)
	if is_instance_valid(_heli_rotor):
		_heli_rotor.rotate_y(TAU * HELI_ROTOR_TURNS * delta)
	if is_instance_valid(_heli_tail_rotor):
		_heli_tail_rotor.rotate_x(TAU * HELI_ROTOR_TURNS * 1.6 * delta)




func _stop_heli() -> void:
	if _heli != null and is_instance_valid(_heli):
		_heli.queue_free()
	_heli = null
	_heli_rotor = null
	_heli_tail_rotor = null


