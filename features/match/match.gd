func _lineup_step(t: float) -> void:
	if _intro_cam == null:
		return
	var seg: float = t * LINEUP_DUR
	if not _lineup_anthem and seg >= LINEUP_ANTHEM_AT:
		_lineup_anthem = true
		if _audio:
			_audio.anthem(GameState.current_fixture())
	if not _lineup_clapped and seg >= LINEUP_CLAP_AT:
		_lineup_clapped = true
		_lineup_clap()
	var key: Dictionary = _lineup_key(seg)
	_intro_cam.position = Vector3(float(key["cx"]), float(key["cy"]),
		float(key["cz"]))
	_intro_cam.fov = float(key["fov"])
	_intro_cam.look_at(Vector3(float(key["lx"]), float(key["ly"]),
		float(key["lz"])))

	_intro_baja(_intro_cam, _lineup_baja(seg))









	if seg >= LINEUP_BREAK_AT:
		var kg: float = smoothstep(0.0, 1.0,
			(seg - LINEUP_BREAK_AT) / maxf(LINEUP_DUR - LINEUP_BREAK_AT, 0.001))
		var sc: float = lerpf(LINEUP_TAG_SCALE, ENTRANCE_TAG_SCALE, kg)
		for e in _entrants:
			var raw: Variant = e["node"]
			if not is_instance_valid(raw):
				continue
			var tag: Node3D =(raw as Node3D).get_node_or_null("NameTag")
			if tag != null:
				tag.scale = Vector3.ONE * sc




func _lineup_key(seg: float) -> Dictionary:
	var last: Dictionary = LINEUP_KEYS[LINEUP_KEYS.size() - 1]
	if seg >= float(last["t"]):
		return last
	for i in range(LINEUP_KEYS.size() - 1):
		var a: Dictionary = LINEUP_KEYS[i]
		var b: Dictionary = LINEUP_KEYS[i + 1]
		if seg > float(b["t"]):
			continue
		var span: float = maxf(float(b["t"]) - float(a["t"]), 0.001)
		var k: float = smoothstep(0.0, 1.0,(seg - float(a["t"])) / span)
		var out: Dictionary = {}
		for campo: String in ["cx", "cy", "cz", "lx", "ly", "lz", "fov"]:
			out[campo] = lerpf(float(a[campo]), float(b[campo]), k)
		return out
	return last












const LINEUP_BAJA_H: Array[float] = [2.5, 2.5, 8.0, 8.0, INTRO_BAJA_H]




func _lineup_baja(seg: float) -> float:
	var n: int = mini(LINEUP_KEYS.size(), LINEUP_BAJA_H.size())
	if seg >= float(LINEUP_KEYS[n - 1]["t"]):
		return LINEUP_BAJA_H[n - 1]
	for i in range(n - 1):
		var t1: float = float(LINEUP_KEYS[i + 1]["t"])
		if seg > t1:
			continue
		var t0: float = float(LINEUP_KEYS[i]["t"])
		var k: float = smoothstep(0.0, 1.0,(seg - t0) / maxf(t1 - t0, 0.001))
		return lerpf(LINEUP_BAJA_H[i], LINEUP_BAJA_H[i + 1], k)
	return LINEUP_BAJA_H[n - 1]










func _lineup_clap() -> void:
