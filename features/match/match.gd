func _handle_strike_input(event: InputEvent) -> void:
	if not event is InputEventScreenTouch:
		return
	if not event.pressed:
		return
	if _strike_locked:
		return
	var off: Vector2 = _ball_contact_at(event.position)
	if off == Vector2.INF:
		return









	if _serve_vivo and not _servicio_cita_abierta():
		return






	if _serve_vivo and _lienzo_h and _servicio_se_fue():
		return


	if not _serve_vivo and _golpeo_fuera_h():
		return
	_pon_strike_mark(off)




	if _serve_vivo:
		_servicio_toque(off)
		return
	_strike_locked = true

	if not _strike_motion.is_empty():





		_strike_contact_y = maxf(_ball.position.y - BALL_VISUAL_D * 0.5, 0.0)



		if _strike_motion.has("slowmo"):
			_fx.slowmo_off()
		_strike_motion = {}
		_ball_field = Vector2(_ball.position.x, _ball.position.z)


	SceneFade.timer(0.14, false).timeout.connect(_launch_shot.bind(off.x, off.y))


















const GOLPEO_CORTE_LATERAL_H: bool = true


























const GOLPEO_ENTRADA_RETRATO_H: bool = true


func _golpeo_fuera_h() -> bool:
	if not _lienzo_h or not GOLPEO_CORTE_LATERAL_H:
		return false
	var pantalla: Rect2 = Rect2(Vector2.ZERO, SceneFade.rect_visible(self).size)
	var cuadro: Rect2 = _strike_rect_juego().intersection(pantalla)







	if GOLPEO_ENTRADA_RETRATO_H:
		cuadro = cuadro.grow(float(_ball_screen_circle()[1]) * STRIKE_TOUCH_FORGIVE)
	return not _servicio_asoma(_ball.position, cuadro)






func _shot_spread() -> float:








	var grada: float = 1.0 if _handoff_live else MatchPlan.fan_aim_mult(_fan_rel)




	var fatiga: float = 0.0
	if not _handoff_live and _practice_kind.is_empty() and not _tutorial_active:
		fatiga = deg_to_rad(Settings.dif_fatiga_deg(Career.energy))
	return deg_to_rad(SHOT_SPREAD_DEG) *(1.0 - _ctrl_accuracy()) * grada + fatiga











static func _sweet_spot(u: float, v: float) -> float:
	var off: float = clampf(absf(u), 0.0, 1.0) * SWEET_U_W \
			+ clampf(absf(v), 0.0, 1.0) *(1.0 - SWEET_U_W)
	return clampf(1.0 - off * SWEET_FALLOFF, 0.0, 1.0)





static func _banda_frente(v: float, top: float, mid: float, low: float) -> float:
	return lerpf(top, mid,(v + 1.0) /(HEADER_V_SEAM + 1.0)) if v <= HEADER_V_SEAM \
			else lerpf(mid, low,(v - HEADER_V_SEAM) /(1.0 - HEADER_V_SEAM))

























static func _launch_from_contact(power_ratio: float, u: float, v: float,
		power_mult: float, header: bool = false, dirty: bool = false,
		cross: bool = false) -> Dictionary:
	var low: float = clampf(v, 0.0, 1.0)
	var high: float = clampf(- v, 0.0, 1.0)



	var lift: float = low if header else pow(low, STRIKE_LOW_GAMMA)




	var sweet: float = _sweet_spot(u, v)
	var pot: float = lerpf(minf(CONTACT_POWER_EDGE, power_mult), power_mult, sweet)
	var base: float =(SHOT_BASE_SPEED + SHOT_SPAN_SPEED * power_ratio) \
			* SHOT_POWER * pot
	if header:
		base *= HEADER_POWER_MULT


	var speed: float = base * lerpf(CONTACT_PACE_TOP, 1.0, 1.0 - high)
	if dirty:
		speed *= 0.8





	var deg: float = 0.0
	if header:




		deg = _banda_frente(v, HEADER_DEG_TOP, HEADER_DEG_MID, HEADER_DEG_LOW)
	elif cross:





		deg = lerpf(CROSS_DEG_TOP, CROSS_DEG_MID, 1.0 - high) if v < 0.0 \
				else lerpf(CROSS_DEG_MID, CROSS_DEG_LOW, low)
	else:
		deg = lerpf(STRIKE_DEG_TOP, STRIKE_DEG_MID, 1.0 - high) if v < 0.0 \
				else lerpf(STRIKE_DEG_MID, STRIKE_DEG_LOW, lift)





	var elev: float = deg_to_rad(deg)



	if not header and not cross:
		elev = _flatten_by_leg(elev, sweet, power_mult)














	var back: float = lift - 0.35 * high
	if header:
		back *= 0.25
	elif cross:




		var lift_c: float = clampf((deg - CROSS_DEG_MID)
			/(CROSS_DEG_LOW - CROSS_DEG_MID), 0.0, 1.0)
		speed = minf(speed * CROSS_POWER_MULT,
			lerpf(CROSS_SPEED_CAP, CROSS_SPEED_CAP_HIGH, lift_c))
		back = clampf((lift_c * 0.7 + 0.3) * CROSS_BACK_MULT - 0.35 * high, -1.0, 1.5)
	else:
		var lift_eff: float = clampf((rad_to_deg(elev) - STRIKE_DEG_MID)
			/(STRIKE_DEG_LOW - STRIKE_DEG_MID), 0.0, 1.0)
		back = lift_eff - 0.35 * high





		speed = lerpf(speed, minf(speed, LOB_SPEED_CAP), pow(lift_eff, 1.5))
	return {"speed": speed, "elev": elev, "back": back}



































static func _flatten_by_leg(elev: float, sweet: float, power_mult: float) -> float:
	var pot_ref: float = lerpf(minf(CONTACT_POWER_EDGE, POWER_FLATTEN_REF),
		POWER_FLATTEN_REF, sweet)
	var pot: float = lerpf(minf(CONTACT_POWER_EDGE, power_mult), power_mult, sweet)
	var gain: float = pot / maxf(pot_ref, 0.01)


	if gain <= 1.0001:
		return elev
	var seam: float = PI * 0.25
	if elev >= seam:
		return elev


	var s2: float = clampf(sin(2.0 * elev) * pow(gain, -2.0 * POWER_FLATTEN), 0.0, 1.0)
	var plano: float = 0.5 * asin(s2)
	var t: float = clampf((elev - deg_to_rad(STRIKE_DEG_MID))
		/(seam - deg_to_rad(STRIKE_DEG_MID)), 0.0, 1.0)
	return lerpf(plano, elev, t)








static func _primera_arco(power_ratio: float, u: float, v: float, power_mult: float,
		chilena: bool) -> Dictionary:
	var top: float = CHILENA_DEG_TOP if chilena else VOLEA_DEG_TOP
	var mid: float = CHILENA_DEG_MID if chilena else VOLEA_DEG_MID
	var low: float = CHILENA_DEG_LOW if chilena else VOLEA_DEG_LOW
	v = clampf(v, -1.0, 1.0)


	var deg: float = lerpf(top, mid, v + 1.0) if v <= 0.0 \
			else lerpf(mid, low, pow(v, STRIKE_LOW_GAMMA))
	var elev: float = deg_to_rad(deg)


	if elev > 0.0:
		elev = _flatten_by_leg(elev, _sweet_spot(u, v),
			power_mult * SERVICIO_PRIMERA_APLANA)
	return {"elev": elev, "back": _primera_picado(power_ratio, v)}






static func _cabeza_arco(power_ratio: float, v: float) -> Dictionary:
	v = clampf(v, -1.0, 1.0)


	var deg: float = lerpf(CABEZA_PRIMERA_DEG_TOP, CABEZA_PRIMERA_DEG_MID, v + 1.0) \
			if v <= 0.0 else lerpf(CABEZA_PRIMERA_DEG_MID, CABEZA_PRIMERA_DEG_LOW,
			pow(v, STRIKE_LOW_GAMMA))
	return {"elev": deg_to_rad(deg), "back": _primera_picado(power_ratio, v)}





static func _primera_picado(power_ratio: float, v: float) -> float:
	var back: float = lerpf(PRIMERA_PICADO_TOP, PRIMERA_PICADO_MID, v + 1.0) if v <= 0.0 \
			else lerpf(PRIMERA_PICADO_MID, PRIMERA_PICADO_LOW, v)
	if back < 0.0:
		back *= pow(clampf(power_ratio, 0.0, 1.0), PRIMERA_PICADO_TIRON)
	return back
















































var pase_iman_enabled: bool = true
var pase_fuerza_al_pie_enabled: bool = false



var _iman_mate: AnimatedSprite3D = null
var _iman_dir: Vector3 = Vector3.ZERO


const PASE_IMAN_DEG_MIN: float = 6.0
const PASE_IMAN_DEG_MAX: float = 10.0



const PASE_IMAN_LAT_MIN: float = 1.2
const PASE_IMAN_LAT_MAX: float = 1.8



const PASE_IMAN_FUERZA: float = 0.75
const PASE_IMAN_NUCLEO: float = 0.35


const PASE_IMAN_MIN_M: float = 2.5
const PASE_IMAN_LLENO_M: float = 14.0
const PASE_IMAN_MAX_M: float = 24.0


const PASE_IMAN_ARCO_M: float = 38.0
const PASE_IMAN_ARCO_MARGEN: float = 2.0



const PASE_LLEGA_MS: float = 7.5

const PASE_FUERZA_TOPE: float = 0.62


const PASE_FIT_VUELTAS: int = 16



func _iman_puede() -> bool:
	return pase_iman_enabled and not _header_chance and not _cross_mode \
			and not _serve_primera and not _serve_vivo and not _shootout_active \
			and _chance_kind != "penal"




static func _iman_apunta_arco(bola: Vector2, dir: Vector3) -> bool:
	if bola.length() > PASE_IMAN_ARCO_M or dir.z > -0.05:
		return false
	var x: float = bola.x + dir.x *(- bola.y / dir.z)
	return absf(x) <= GOAL_HALF_W + PASE_IMAN_ARCO_MARGEN






static func _iman_resuelve(bola: Vector2, dir: Vector3, pies: Array[Vector2],
		precision: float) -> Dictionary:
	var out: Dictionary = {"dir": dir, "i": -1, "w": 0.0, "dist": 0.0}
	var d2: Vector2 = Vector2(dir.x, dir.z)
	if d2.length_squared() < 0.0001:
		return out
	d2 = d2.normalized()
	var p: float = clampf(precision, 0.0, 1.0)
	var ang_max: float = deg_to_rad(lerpf(PASE_IMAN_DEG_MIN, PASE_IMAN_DEG_MAX, p))
	var lat_max: float = lerpf(PASE_IMAN_LAT_MIN, PASE_IMAN_LAT_MAX, p)
	var mejor: float = 1.0
	var elegido: int = -1
	for i in pies.size():
		var to: Vector2 = pies[i] - bola
		var dist: float = to.length()
		if dist < PASE_IMAN_MIN_M or dist > PASE_IMAN_MAX_M:
			continue
		var ventana: float = minf(ang_max, atan(lat_max / dist))
		var x: float = absf(d2.angle_to(to)) / ventana
		if x < mejor:
			mejor = x
			elegido = i
	if elegido < 0:
		return out
	var to_e: Vector2 = pies[elegido] - bola
	var dist_e: float = to_e.length()
	var w: float = PASE_IMAN_FUERZA *(1.0 - smoothstep(PASE_IMAN_NUCLEO, 1.0, mejor)) \
			*(1.0 - smoothstep(PASE_IMAN_LLENO_M, PASE_IMAN_MAX_M, dist_e))
	var nd: Vector2 = d2.rotated(d2.angle_to(to_e) * w)
	out["dir"] = Vector3(nd.x, 0.0, nd.y)
	out["i"] = elegido
	out["w"] = w
	out["dist"] = dist_e
	return out





func _pase_iman(dir: Vector3, fija: bool = false) -> Vector3:
	if fija:
		_iman_mate = null
		_iman_dir = Vector3.ZERO
	if not _iman_puede() or _iman_apunta_arco(_ball_field, dir):
		return dir
	var pies: Array[Vector2] = []
	var quien: Array[AnimatedSprite3D] = []
	for a in _teammate_actors:
		if a == null or not is_instance_valid(a) or a == _self_actor or not a.visible:
			continue
		pies.append(Vector2(a.position.x, a.position.z))
		quien.append(a)
	var r: Dictionary = _iman_resuelve(_ball_field, dir, pies, _ctrl_precision())
	if int(r["i"]) < 0:
		return dir
	var nuevo: Vector3 = r["dir"]
	if fija:
		_iman_mate = quien[int(r["i"])]
		_iman_dir = nuevo
	return nuevo











static func _pase_salida_justa(dist: float, elev: float, spin: float, llega: float,
		bote: float, drag: float) -> float:
	var lo: float = 1.0
	var hi: float = 40.0
	for _k in PASE_FIT_VUELTAS:
		var v: float =(lo + hi) * 0.5
		if _pase_avance_en(Vector3(0.0, v * sin(elev), v * cos(elev)), spin, dist, bote,
				drag) < llega:
			lo = v
		else:
			hi = v
	return hi




static func _pase_avance_en(vel: Vector3, spin: float, dist: float, bote: float,
		drag: float) -> float:
	var ruta: Array[Vector3] = _servicio_integra(Vector3.ZERO, vel, spin, bote, drag,
		SERVICIO_PASOS_MAX)["ruta"]
	for i in range(1, ruta.size()):
		if ruta[i].z >= dist:
			return (ruta[i].z - ruta[i - 1].z) / SIM_DT
	return 0.0






func _pase_fuerza_al_pie(speed: float, elev: float, spin: float, dirty: bool) -> float:
	var mate: AnimatedSprite3D = _iman_mate
	var rumbo: Vector3 = _iman_dir
	_iman_mate = null
	_iman_dir = Vector3.ZERO
	if mate == null or not is_instance_valid(mate) or dirty or not _iman_puede() \
			or not pase_fuerza_al_pie_enabled or not _shot_dir.is_equal_approx(rumbo):
		return speed
	var t: float = smoothstep(MIN_POWER_RATIO, PASE_FUERZA_TOPE, _power_ratio)
	if t >= 1.0:
		return speed
	var dist: float =(Vector2(mate.position.x, mate.position.z) - _ball_field).dot(
		Vector2(rumbo.x, rumbo.z).normalized())
	if dist < PASE_IMAN_MIN_M:
		return speed
	var justa: float = _pase_salida_justa(dist, elev, spin, PASE_LLEGA_MS, _cesped_bote,
		_cesped_drag)
	if justa >= speed:
		return speed
	return lerpf(justa, speed, t)



func _launch_shot(u: float, v: float) -> void:
	if state != State.STRIKING:
		return


	_remate_gesto = ""
	if _serve_primera:
		_remate_gesto = "chilena" if _serve_chilena else _servicio_gesto(_serve_plan)





	if _strike_mark != null:
		_strike_mark.limpia()



	_fire_order_runs()

















	if not _handoff_live or _recu_mando_live:
		match_shots += 1



		_shot_from = _ball_field
		_shot_pending = true


		_shot_vz = 0.0


	if _salida_viva:
		_salida_golpe_d = _ball_field.length()

	var dir_h: Vector3 = _shot_dir


	if _serve_primera:
		dir_h = _servicio_al_blanco(dir_h)




	var dirty: bool = Vector2(u, v).length() > 0.95 and absf(u) > 0.55
	if dirty:
		var wobble: float = deg_to_rad(randf_range(4.0, 9.0)) *(1.0 - _ctrl_accuracy() * 0.7)
		dir_h = dir_h.rotated(Vector3.UP, wobble *(1.0 if randf() < 0.5 else -1.0))





	if _serve_chilena:
		var giro: float = deg_to_rad(randf_range(3.0, 12.0)) *(1.0 - _ctrl_accuracy() * 0.5)
		dir_h = dir_h.rotated(Vector3.UP, giro *(1.0 if randf() < 0.5 else -1.0))






	var start_y: float = _strike_contact_y if (_header_chance or _serve_primera) else 0.0


















	var frente: bool = _header_chance and not _serve_chilena
	var launch: Dictionary = _launch_from_contact(_power_ratio, u, v,
		_ctrl_header_mult() if frente else _ctrl_power_mult(),
		frente, dirty, _cross_mode and not _header_chance)
	var speed: float = float(launch["speed"])
	var back: float = float(launch["back"])
	var elev: float = float(launch["elev"])








	if _serve_chilena:
		var arco_ch: Dictionary = _primera_arco(_power_ratio, u, v, _ctrl_power_mult(), true)
		elev = float(arco_ch["elev"])
		back = float(arco_ch["back"])


	if _serve_primera:
		speed *= SERVICIO_PRIMERA_POT









		if frente:
			var arco_cab: Dictionary = _cabeza_arco(_power_ratio, v)
			elev = float(arco_cab["elev"])
			back = float(arco_cab["back"])
		elif not _header_chance and not _cross_mode:
			var arco: Dictionary = _primera_arco(_power_ratio, u, v, _ctrl_power_mult(), false)
			elev = float(arco["elev"])
			back = float(arco["back"])
		elif not _header_chance:
			var plano: Dictionary = _launch_from_contact(_power_ratio, u, v,
				_ctrl_power_mult() * SERVICIO_PRIMERA_APLANA, false, dirty, _cross_mode)
			elev = float(plano["elev"])
			back = float(plano["back"])


		if _serve_lectura == "Tocada a destiempo" and _servicio_primera_persona():
			var fallo: Dictionary = _destiempo_desvio(dir_h, _serve_vel_golpe,
				_serve_desfase > 0.0)
			dir_h = fallo["dir"]
			elev += float(fallo["elev"])
			speed *= SERVICIO_DESTIEMPO_POT


	var spin: float = u * _ctrl_curve_mult()
	if frente:
		spin *= HEADER_SPIN_SCALE



	speed = _pase_fuerza_al_pie(speed, elev, spin, dirty)




	var spread: float = _shot_spread()
	if spread > 0.0001:


		elev += spread *(randf() + randf() - 1.0)
		dir_h = dir_h.rotated(Vector3.UP, spread *(randf() + randf() - 1.0))



	var vel: Vector3 = dir_h *(speed * cos(elev)) + Vector3(0.0, speed * sin(elev), 0.0)





	_shot_pace = clampf((vel.length() - 10.0) / 18.0, 0.0, 1.0)
	_cross_i = -1
	_keeper_triggered = false
	_net_hit = false
	_impact_sfx = false
	_post_i = -1
	_post_ix = []
	_net_out_ix = -1
	_post_bar = false
	_post_out = false
	_bar_in_out = false
	_bar_bounce_p = Vector3.ZERO
	_post_out_p = Vector3.ZERO
	_bar_under = false
	_post_sfx = 0
	_graze_ix = []
	_graze_sfx = 0
	if _keeper and _keeper.has_meta("dive_x"):
		_keeper.remove_meta("dive_x")
	if _keeper and _keeper.has_meta("save_anim"):
		_keeper.remove_meta("save_anim")
	for k in ["save_ball", "save_pinta", "save_parte"]:
		if _keeper and _keeper.has_meta(k):
			_keeper.remove_meta(k)










	if _meta_viva:
		var linea_i: int = _line_holder([] as Array[int])
		if _mark_of.is_empty():
			_meta_reparte_marcas(linea_i)
		_mark_assign([] as Array[int], linea_i)


	_snapshot_offside(_ball_field.y, _self_actor)



	_foto_desde_cuerpos()
	_simulate_flight(Vector3(_ball_field.x, start_y, _ball_field.y), vel, spin, back,
		true)








	if not _handoff_live or _recu_mando_live:
		_shot_path = FlightPath.from_traj(_traj, 0, _flight_cut())
		_shot_vz = vel.z



	_cross_drop = {}
	if _fk_line_chance and _cross_mode and not _header_chance:
		_cross_drop = _cross_drop_point()









		if not _handoff_live or _recu_mando_live:
			_setup_cross_runs()


	_strike_restore_view()
	_strike_mira_fin()


	_aim_cam.current = true
	_fx.cam = _aim_cam





	if not Practice.con_maquina(_practice_kind):
		_aim_cam.fov = _aim_fov_base + 3.0
	_flight_d0 = 0.0


	if _header_chance and _serve_primera:
		_servicio_cabezazo(dir_h, u, v)
	elif _header_chance:
		_start_header_jump(dir_h, u, v)
	elif _serve_primera:
		_servicio_primera(dir_h, u, v)
	else:
		_start_runup(dir_h, u, v, _carga_tiro)


	_carga_tiro = false








func _strike_corta_a_apuntar() -> void:
	if _strike_mark != null:
		_strike_mark.limpia()
	_strike_restore_view()
	_strike_mira_fin()
	_aim_cam.current = true
	_fx.cam = _aim_cam




	_cam_base_frame = -1






func _start_header_jump(dir_h: Vector3, u: float, v: float) -> void:
	state = State.RUNUP
	var bp: Vector3 = _ball.position
	if _self_actor:
		_self_actor.visible = true



		_self_actor.flip_h = false
		var y: float = _self_actor.position.y














		var t: float = clampf(inverse_lerp(HEADER_CONTACT_BAND.x, HEADER_CONTACT_BAND.y,
			_strike_contact_y + BALL_VISUAL_D * 0.5), 0.0, 1.0)


		var spot: Vector3 = Vector3(bp.x, y, bp.z) \
				- dir_h * lerpf(HEADER_STEP_LOW, HEADER_STEP_HIGH, t)
		_play_run(_self_actor, spot - _self_actor.position)
		var step: Tween = create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
		step.tween_property(_self_actor, "position", spot, HEADER_STEP_T)

		step.tween_property(_self_actor, "position:y",
				y + lerpf(HEADER_JUMP_LOW, HEADER_JUMP_HIGH, t), HEADER_JUMP_UP) \
						.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		step.tween_property(_self_actor, "position:y", y, HEADER_JUMP_DOWN) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)

	SceneFade.timer(HEADER_STEP_T + HEADER_CONTACT_DELAY, false) \
			.timeout.connect(_do_kick.bind(dir_h, u, v))




















const KICK_PULLBACK_T: float = 0.38






var _kick_tw: Tween

func _pull_back_for_kick() -> void:
	if _chance_kind != "corner" or not is_instance_valid(_shot_cam) \
			or not is_instance_valid(_aim_cam):
		return
	var to_pos: Vector3 = _aim_cam.global_position
	var to_basis: Basis = _aim_cam.global_transform.basis
	var tw: Tween = create_tween().set_parallel(true)
	_kick_tw = tw
	tw.tween_property(_shot_cam, "global_position", to_pos, KICK_PULLBACK_T) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)




	tw.tween_method(func(k: float) -> void:
			if is_instance_valid(_shot_cam):
				_shot_cam.global_transform.basis = _kick_from_basis.slerp(to_basis, k),
		0.0, 1.0, KICK_PULLBACK_T).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.tween_property(_shot_cam, "fov", _aim_cam.fov, KICK_PULLBACK_T) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)


var _kick_from_basis: Basis = Basis.IDENTITY




func _start_runup(dir_h: Vector3, u: float, v: float, cargada: bool = false) -> void:
	state = State.RUNUP
	var bp: Vector3 = _ball.position
	_kick_from_basis = _shot_cam.global_transform.basis if is_instance_valid(_shot_cam) \
			else Basis.IDENTITY
	_pull_back_for_kick()
	if _self_actor:
		_self_actor.visible = true
		var y: float = _self_actor.position.y


		var target: Vector3 = Vector3(bp.x, y, bp.z) - dir_h * 0.5













		if _chance_kind == "corner":
			_dir_force[_self_actor] = _corner_profile_dir()





		var carga: String = _carga_gesto(dir_h) \
				if cargada and _chance_kind != "corner" else ""
		var tw: Tween = create_tween().set_trans(Tween.TRANS_LINEAR)
		if not carga.is_empty():
			_self_actor.play(carga)
			_self_actor.set_frame_and_progress(CARGA_CUADRO, 0.0)
			_self_actor.pause()
			_carga_viva = true
			_carga_anim = carga
			_carga_gen += 1


			_anim_lock[_self_actor] = Time.get_ticks_msec() + 700
			tw.tween_property(_self_actor, "position", target, CARGA_PASO_T) \
					.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
			tw.tween_interval(0.55 - CARGA_PASO_T)
		else:



			_self_actor.set_meta("pace_run_until", Time.get_ticks_msec() + 900)
			_play_run(_self_actor, target - _self_actor.position)
			tw.tween_property(_self_actor, "position", target, 0.55)

		tw.tween_property(_self_actor, "position",
			target + Vector3(dir_h.x, 0.0, dir_h.z) * 0.45, 0.32) \
					.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)


	var kick_t: float = 0.41
	SceneFade.timer(kick_t, false).timeout.connect(_do_kick.bind(dir_h, u, v))



	if _barr_actor != null and _barr_antes > 0.0:
		SceneFade.timer(maxf(kick_t - _barr_antes, 0.0), false).timeout.connect(
			_barrida_lanza.bind(_chance_seq))



func _do_kick(dir_h: Vector3, u: float, v: float, espera: float = 0.14) -> void:
	if state != State.RUNUP:
		return

	_salta_barrera(espera)
	if _self_actor:




		var kick_anim: String =("header_" if _header_chance else "kick_") + _dir_name(dir_h)





		if _chance_kind == "corner" and not _header_chance:
			kick_anim = "kick_" + _corner_profile_dir()



		elif not _header_chance:
			var volea: bool = _serve_primera and not _serve_chilena \
					and _servicio_gesto(_serve_plan) == "volea"
			kick_anim =("volea_" if volea else "empeine_") + _dir_name(dir_h)








		var ya: String = String(_self_actor.animation)
		if _self_actor.is_playing() and ((_serve_chilena and ya.begins_with("chilena_"))
				or (_serve_primera and _header_chance
				and (ya.begins_with("header_") or ya.begins_with("palomita_")))):
			kick_anim = ya
		elif _serve_primera and _header_chance and not _serve_vista.is_empty():
			kick_anim = "header_" + _serve_vista











		var listo: bool = _gesto_listo(_self_actor, kick_anim)
		if not listo:
			kick_anim = "kick_" + _dir_name(dir_h)
			listo = _gesto_listo(_self_actor, kick_anim)


		_dir_force.erase(_self_actor)



		var carga: bool = _carga_viva and String(_self_actor.animation) == _carga_anim
		if not (listo and carga):
			_carga_viva = false
		if listo and carga:
			if String(_self_actor.animation) != kick_anim:
				_self_actor.play(kick_anim)
			_carga_anim = kick_anim
			_self_actor.set_frame_and_progress(CARGA_CUADRO, 0.0)
			_self_actor.pause()
			var fps: float = maxf(_self_actor.sprite_frames.get_animation_speed(kick_anim), 1.0)
			var suelta_t: float = float(CARGA_CUADRO) / fps
			var actor: AnimatedSprite3D = _self_actor


			SceneFade.timer(suelta_t, false).timeout.connect(
				_carga_suelta_golpe.bind(actor, kick_anim))
			_anim_lock[_self_actor] = Time.get_ticks_msec() + 600 + int(suelta_t * 1000.0)
		elif listo:
			_self_actor.play(kick_anim)




			_anim_lock[_self_actor] = Time.get_ticks_msec() \
					+(int(ACRO_T * 1000.0) + 40 if kick_anim.begins_with("palomita_") else 600)
	_audio.kick()
	_haptic(30)





	var golpe: Vector3 = _ball.position - Vector3(0.0, BALL_VISUAL_D * 0.5, 0.0)
	if _stadium != null and bool(_stadium.weather.get("rain", false)):
		_splash_at(Vector2(golpe.x, golpe.z), dir_h, 15.0)
	else:
		_fx.dust_burst(golpe)
	_fx.punch_scale(_ball, dir_h)



	if _barr_actor != null and not _barr_lanzada:
		var antes: float = espera - BARRIDA_TIRO_PRE
		if antes <= 0.0:
			_barrida_lanza(_chance_seq)
		else:
			SceneFade.timer(antes, false).timeout.connect(
				_barrida_lanza.bind(_chance_seq))

	_zancadas_antes_del_vuelo(espera)


	if espera <= 0.0:
		_begin_flight(u, v)
	else:
		SceneFade.timer(espera, false).timeout.connect(_begin_flight.bind(u, v))


func _begin_flight(u: float, v: float) -> void:
	if state != State.RUNUP:
		return






	_audio.shot(_shot_pace)












	if Practice.con_maquina(_practice_kind) and not _encargo.is_empty():
		_dianas_suelta()
		return


	_ball.flip_h = u < 0.0
	var roll_dir: float = 1.0
	if v > 0.3 and absf(u) < 0.4:
		roll_dir = -1.0
	_ball.play("roll", roll_dir, roll_dir < 0.0)




	state = State.FLIGHT
	_traj_i = 0
	_rematador = _self_actor

	_bsube_arma()



	SceneFade.timer(0.6, false).timeout.connect(
		_self_to_idle.bind(_chance_seq, _self_actor))


func _self_to_idle(seq: int = -1, quien = null) -> void:
	if _self_actor == null or not is_instance_valid(_self_actor):
		return









	if quien != null and (not is_instance_valid(quien) or quien != _self_actor):
		return







	if seq >= 0 and seq != _chance_seq:
		return


	if state == State.RESOLVED:
		return



	if _you_chasing():
		return

	if _self_actor.sprite_frames.has_animation("idle_back"):
		_self_actor.play("idle_back")
	elif _self_actor.sprite_frames.has_animation("idle"):
		_self_actor.play("idle")









func _puddle_slow(p: Vector2) -> float:
	if _stadium == null or _stadium.puddles == null:
		return 1.0
	var wet: float = _stadium.puddles.depth_at(p.x, p.y)
	if wet <= PUDDLE_MIN:
		return 1.0
	return 1.0 - PUDDLE_SLOW * clampf(wet / PUDDLE_FULL, 0.0, 1.0)
















func _splash_at(where: Vector2, dir: Vector3, power: float) -> void:
	_spray_last = 0.0
	if _fx == null or _stadium == null \
			or not bool(_stadium.weather.get("rain", false)):
		return
	var wet: float = 0.0
	if _stadium.puddles != null:
		wet = _stadium.puddles.depth_at(where.x, where.y)
	var f: float = SPRAY_FILM +(1.0 - SPRAY_FILM) \
			* clampf(wet / PUDDLE_FULL, 0.0, 1.0)
	_spray_last = power * f
	_fx.splash_dir(dir)
	_fx.splash_burst(Vector3(where.x, 0.06, where.y), _spray_last)
	if wet > PUDDLE_MIN and _audio != null:
		_audio.splash(_spray_last)



















const STEP_SPLASH_SPEED: float = 2.2




const STEP_SPLASH_PERIOD: float = 0.22





const STEP_SPLASH_PER_FRAME: int = 2





const STEP_WET_SCALE: float = 1.3














func _step_ground(actor: Node3D, moved: Vector3, dt: float) -> bool:
	var spd: float = moved.length() / maxf(dt, 0.0001)
	if spd < STEP_SPLASH_SPEED:
		return false
	var now: float = float(Time.get_ticks_msec()) / 1000.0
	if now - float(actor.get_meta("wet_step_t", -1.0)) < STEP_SPLASH_PERIOD:
		return false
	actor.set_meta("wet_step_t", now)
	var pies: Vector3 = actor.position
	var rapido: float = clampf(spd / 7.0, 0.0, 1.0)












	var pie: int = int(actor.get_meta("tread_foot", 0))
	actor.set_meta("tread_foot", 1 - pie)
	_stadium.tread_print(Vector3(pies.x, 0.0, pies.z), moved, rapido, pie)
	if bool(_stadium.weather.get("snow", false)):



		_stadium.tread_at(pies.x, pies.z, 0.55 + 0.45 * rapido)
		_fx.step_splash(Vector3(pies.x, 0.03, pies.z), moved, rapido, true)
		return true
	var wet: float = 0.0
	if _stadium.puddles != null:
		wet = _stadium.puddles.depth_at(pies.x, pies.z)
	var f: float = SPRAY_FILM +(1.0 - SPRAY_FILM) \
			* clampf(wet / PUDDLE_FULL, 0.0, 1.0)














	_fx.step_splash(Vector3(pies.x, 0.03, pies.z), moved, rapido * f, false,
		1.0 + STEP_WET_SCALE * clampf(wet / PUDDLE_FULL, 0.0, 1.0))
	return true
































const RESBALON_HONDO: float = 0.26


const RESBALON_SPEED: float = 4.0




const RESBALON_P: float = 0.1


const RESBALON_CD_MS: int = 15000

const RESBALON_GLOBAL_S: float = 5.0
















const RESBALON_SLIDE_V0: float = 4.7
const RESBALON_SLIDE_T: float = 0.34


var _resbalon_next: float = 0.0





func _resbalon_step(cuerpo: Node3D, moved: Vector3, dt: float) -> bool:


	var actor: AnimatedSprite3D = cuerpo as AnimatedSprite3D
	if actor == null or _stadium == null or _fx == null \
			or _stadium.puddles == null \
			or not bool(_stadium.weather.get("rain", false)):
		return false
	var now: int = Time.get_ticks_msec()
	var ahora_s: float = float(now) / 1000.0
	if ahora_s < _resbalon_next:
		return false
	if actor == _self_actor or actor == _keeper or not _chase_vels.has(actor):
		return false
	if _order_owned(actor) or actor.has_meta("hold_wall") \
			or int(_anim_lock.get(actor, 0)) > now \
			or int(actor.get_meta("caido_t", 0)) > now \
			or int(actor.get_meta("resbalon_cd", 0)) > now:
		return false
	var spd: float = moved.length() / maxf(dt, 0.0001)
	if spd < RESBALON_SPEED:
		return false
	var wet: float = _stadium.puddles.depth_at(actor.position.x, actor.position.z)
	if wet < RESBALON_HONDO:
		return false



	var riesgo: float = RESBALON_P \
			* clampf(wet / PUDDLE_FULL, 0.0, 1.0) \
			* clampf(spd / 7.0, 0.0, 1.0)
	if randf() > riesgo:
		return false
	var rumbo: Vector2 = Vector2(moved.x, moved.z).normalized()



	if not _play_dir_gesture(actor, "fall", rumbo, FALL_NPC_MS):
		return false
	var hasta: int = now + FALL_NPC_MS + FALL_UP_MS
	_anim_lock[actor] = hasta
	actor.set_meta("caido_t", hasta)
	actor.set_meta("resbalon_cd", now + RESBALON_CD_MS)
	_resbalon_next = ahora_s + RESBALON_GLOBAL_S



	_chase_vels.erase(actor)
	if actor.has_meta("carga_t0"):
		actor.remove_meta("carga_t0")




	actor.set_meta("resbala_v", rumbo * RESBALON_SLIDE_V0)
	actor.set_meta("resbala_t", ahora_s + RESBALON_SLIDE_T)






	var pot: float = 9.0 + 13.0 * clampf(spd / 7.0, 0.0, 1.0)
	_fx.splash_dir(Vector3(rumbo.x, 0.0, rumbo.y))
	_fx.splash_burst(Vector3(actor.position.x, 0.05, actor.position.z), pot)
	if _audio != null:
		_audio.splash(pot)
	return true
















func _resbalon_slide(cuerpo: Node3D, delta: float) -> void:
	if not cuerpo.has_meta("resbala_t"):
		return
	var ahora: float = float(Time.get_ticks_msec()) / 1000.0
	var fin: float = float(cuerpo.get_meta("resbala_t"))
	if fin <= ahora:
		cuerpo.remove_meta("resbala_t")
		cuerpo.remove_meta("resbala_v")
		return
	var k: float = clampf((fin - ahora) / maxf(RESBALON_SLIDE_T, 0.0001), 0.0, 1.0)
	var v: Vector2 = cuerpo.get_meta("resbala_v")
	var np: Vector2 = _inside_field(Vector2(cuerpo.position.x, cuerpo.position.z)
		+ v * k * delta)
	var kb: Vector3 = Vector3(np.x - cuerpo.position.x, 0.0, np.y - cuerpo.position.z)



	if cuerpo.has_meta("pace_p"):
		cuerpo.set_meta("pace_p",(cuerpo.get_meta("pace_p") as Vector3) + kb)
	if cuerpo.has_meta("loco_p"):
		cuerpo.set_meta("loco_p",(cuerpo.get_meta("loco_p") as Vector3) + kb)
	cuerpo.position += kb













































const RESBALON_YO_ANG: float = 90.0







const RESBALON_YO_PACE: float = 0.75






const RESBALON_YO_P: float = RESBALON_P





const RESBALON_YO_SLIDE_M: float = 0.8







var _resbalon_yo_next: float = 0.0





var _resbala_tw: Tween = null







var _perdida_resbalon: bool = false










func _resbalon_yo_hay(ang: float, vel_antes: Vector2, tope: float,
		pies: Vector2) -> bool:


	if _stadium == null or _stadium.puddles == null \
			or not bool(_stadium.weather.get("rain", false)):
		return false















	if not _practice_kind.is_empty() or _tutorial_active:
		return false

	if ang < RESBALON_YO_ANG:
		return false
	var pace: float = clampf(vel_antes.length() / maxf(tope, 0.01), 0.0, 1.0)
	if pace < RESBALON_YO_PACE:
		return false
	var wet: float = _stadium.puddles.depth_at(pies.x, pies.y)
	if wet < RESBALON_HONDO:
		return false



	var ahora_s: float = float(Time.get_ticks_msec()) / 1000.0
	if ahora_s < _resbalon_next or ahora_s < _resbalon_yo_next:
		return false



	var riesgo: float = RESBALON_YO_P * clampf(wet / PUDDLE_FULL, 0.0, 1.0) * pace
	return randf() < riesgo










func _resbalon_yo_fx(pies: Vector2, rumbo: Vector2, spd: float) -> void:



	_haptic(50)
	_bump(BUMP_FALTA)




	var pot: float = 9.0 + 13.0 * clampf(spd / 7.0, 0.0, 1.0)
	if _fx != null:
		_fx.splash_dir(Vector3(rumbo.x, 0.0, rumbo.y))
		_fx.splash_burst(Vector3(pies.x, 0.05, pies.y), pot)
	if _audio != null:
		_audio.splash(pot)






	if _resbala_tw != null and _resbala_tw.is_valid():
		_resbala_tw.kill()
	if is_instance_valid(_self_actor):
		var meta: Vector2 = _inside_field(
			Vector2(_self_actor.position.x, _self_actor.position.z)
			+ rumbo * RESBALON_YO_SLIDE_M)
		_resbala_tw = create_tween()
		_resbala_tw.tween_property(_self_actor, "position",
			Vector3(meta.x, _self_actor.position.y, meta.y), RESBALON_SLIDE_T) \
					.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)

	var ahora_s: float = float(Time.get_ticks_msec()) / 1000.0
	_resbalon_next = ahora_s + RESBALON_GLOBAL_S
	_resbalon_yo_next = ahora_s + float(RESBALON_CD_MS) / 1000.0















func _drive_resbalon(vel_antes: Vector2) -> void:
