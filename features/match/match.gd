func _press_out_p() -> float:
	return press_out_p_de(float(PRESS_OUT_P_POR_PUESTO.get(Squad.USER_POS,
		PRESS_OUT_P_POR_PUESTO["DC"])), _ventaja_hoy())







static func press_out_p_de(base: float, ventaja: float) -> float:
	if base <= 0.0:
		return 0.0
	return clampf(base - ventaja * PRESS_OUT_VENT_K,
		base * 0.5, minf(base * PRESS_OUT_P_SUBE_MAX, PRESS_OUT_P_TOPE))










var _press_cupo: int = -1


func _press_out_cupo() -> int:
	if _press_cupo < 0:
		_press_cupo = PRESS_OUT_PER_MATCH if randf() < _press_out_p() else 0












		if _chances_this_match < PRESS_OUT_MIN_CHANCES:
			_press_cupo = 0
	return _press_cupo



