func _pad_tick() -> void:
	var tec: bool = Entrada.teclado_juega()
	var rt_antes: bool = _pad_rt
	var rt_seguido: bool = _pad_rt_lee()
	var on: bool = Entrada.pad_juega() and _zonas_h_on() and _hud != null \
			and not _festejo_revivido and not get_tree().paused \
			and (Entrada.capa_activa() if tec else Entrada.capa()) == null


	_pad_al_paso = on and not ((Entrada.corre_tecla() or Entrada.raton_juega()) if tec else _pad_rt)
	if not on:
		_pad_suelta()
