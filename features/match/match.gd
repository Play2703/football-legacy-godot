func _ref_flags_follow() -> void:
	if _ref_flag.is_empty():
		return
	var cam: Camera3D = SceneFade.camara_de(self)
	var right: Vector3 = Vector3.RIGHT if cam == null \
			else cam.global_transform.basis.x
	right.y = 0.0
	if right.length_squared() < 0.0001:
		right = Vector3.RIGHT
	right = right.normalized()
	for a in sin_muertos(_ref_flag):



		if not is_instance_valid(a):
			continue
		var flag: Sprite3D = SceneFade.vivo(_ref_flag[a]) as Sprite3D
		var duenio: AnimatedSprite3D = a as AnimatedSprite3D
		if not is_instance_valid(flag) or duenio == null:
			continue
		var off: Vector2 = Banderin.mano_offset(duenio.pixel_size)
		var hacia: Vector3 = Vector3.ZERO if cam == null \
				else (cam.global_position - duenio.global_position).normalized()
		flag.global_position = duenio.global_position \
				+ right * off.x + Vector3(0.0, off.y, 0.0) + hacia * 0.06



		flag.visible = duenio.visible
















