func _servicio_sortea_regate() -> String:
	if not servicio_regate_forzado.is_empty():
		return servicio_regate_forzado
	var total: int = 0
	for r in SERVICIO_REGATES:
		total += int(r["peso"])
	var n: int = randi() % maxi(total, 1)
	for r in SERVICIO_REGATES:
		n -= int(r["peso"])
		if n < 0:
			return String(r["id"])
	return "recorte"








static func _servicio_regate(srv: Vector2, ball: Vector2, corte: float,
		tipo: String = "recorte") -> Dictionary:
	var eje: Vector2 = ball - srv
	eje = eje.normalized() if eje.length() > 0.01 else Vector2(0.0, -1.0)



	var e2_deg: float = 25.0 if tipo == "avance" else SERVICIO_CORTE_E2
	var e2: Vector2 = eje.rotated(deg_to_rad(e2_deg) * corte)








	var suelo_z: float = 4.0
	if tipo == "avance":
		suelo_z = minf(4.0, srv.y)
		var largo_avance: float = SERVICIO_TRAMO2 + SERVICIO_TRAMO1
		var cabe: bool = false
		for paso in 7:
			for signo in [corte, - corte]:
				var e: Vector2 = eje.rotated(deg_to_rad(25.0 + 15.0 * paso) * float(signo))
				var atras: Vector2 = srv - e * largo_avance
				if atras.y >= suelo_z and absf(atras.x) <= FIELD_EDGE:
					e2 = e
					cabe = true
					break
			if cabe:
				break
	var giro_deg: float = SERVICIO_CORTE_GIRO
	if tipo == "arrancada":
		giro_deg = 45.0
	elif tipo == "avance":
		giro_deg = 0.0
	var e1: Vector2 = e2.rotated(- deg_to_rad(giro_deg) * corte)
	var giro: Vector2 = _servicio_en_campo(srv - e2 * SERVICIO_TRAMO2, suelo_z)
	var largo1: float = SERVICIO_TRAMO1
	var t1: float = SERVICIO_DRIB_T1
	var toques1: float = SERVICIO_DRIB_TOQUES.x
	match tipo:
		"arrancada":
			largo1 = 3.2
			t1 = 0.8
			toques1 = 3.0
		"avance":
			t1 = 0.8
			toques1 = 2.0
		"doble", "a_dos":
			largo1 = 2.2
			t1 = 0.75
		"amague", "freno":
			largo1 = 2.2
			t1 = 0.8
		"carga":


			t1 = 0.95








	t1 += SERVICIO_KICK_AT
	var inicio: Vector2 = _servicio_en_campo(giro - e1 * largo1, suelo_z)

	var lado: Vector2 = Vector2(- e1.y, e1.x) * corte
	var tramos: Array = [[inicio, giro, t1, toques1, "run"]]
	var puntos: Array[Vector2] = [inicio, giro]

	var lance: Dictionary = {}
	var suelo: Array[Vector2] = []
	var sale2: Vector2 = Vector2.INF


	var fin_barrida: Vector2 = _servicio_en_campo(giro + e1 * 0.7 - lado * 0.35)
	match tipo:
		"barrida":
			tramos.append([giro, srv, SERVICIO_DRIB_T2, SERVICIO_DRIB_TOQUES.y, "run"])


			lance = {"que": "barrida", "t": t1 - 0.25, "fin": fin_barrida}
			suelo = [fin_barrida]
		"carga":
			var choque: Vector2 = _servicio_en_campo(giro - e1 * 0.7)
			tramos[0] = [inicio, choque, t1 - 0.45, toques1, "run"]



			tramos.append([choque, giro, 0.45, 0.0, "carga"])
			tramos.append([giro, srv, 0.55, 1.0, "run"])
			puntos.insert(1, choque)
			var hombro: Vector2 = e1 * 0.25 - lado * 0.55
			var cae: Vector2 =(e1 - lado).normalized()
			lance = {"que": "carga", "t": t1 - 0.45, "t2": t1 - 0.23, "t_cae": t1,
				"choque": choque, "hombro": hombro, "cae": cae}
			suelo = [_servicio_en_campo(giro + hombro + cae * 0.5)]
		"a_dos":



			var f: Vector2 = e2.rotated(deg_to_rad(45.0) * corte)
			var fuera: Vector2 = _servicio_en_campo(giro + f * 1.3)
			tramos.append([giro, fuera, 0.4, 1.0, "run"])
			tramos.append([fuera, srv, 0.5, 1.0, "run"])
			puntos.append(fuera)
			var sienta: Vector2 = _servicio_en_campo(fuera + f * 1.6)
			sale2 = _servicio_en_campo(sienta + f.rotated(deg_to_rad(90.0) * corte) * 1.2)
			lance = {"que": "a_dos", "t": t1 - 0.25, "fin": fin_barrida, "t2": t1 + 0.4,
				"sienta": sienta, "f": f}
			suelo = [fin_barrida, sienta]
		"doble":

			var fuera: Vector2 = _servicio_en_campo(giro + e2.rotated(deg_to_rad(45.0) * corte) * 0.9)
			tramos.append([giro, fuera, 0.35, 1.0, "run"])
			tramos.append([fuera, srv, 0.45, 1.0, "run"])
			puntos.append(fuera)
		"amague":


			var finta: Vector2 = _servicio_en_campo(giro - lado * 0.5)
			tramos.append([giro, finta, 0.22, 0.0, "dribble"])
			tramos.append([finta, srv, 0.6, 1.0, "run"])
			puntos.append(finta)
		"freno":

			var pisa: Vector2 = _servicio_en_campo(giro + e2 * 0.3)
			tramos.append([giro, pisa, 0.35, 0.0, "dribble"])
			tramos.append([pisa, srv, 0.5, 1.0, "run"])
			puntos.append(pisa)
		"arrancada":
			tramos.append([giro, srv, 0.45, 1.0, "run"])
		_:
			tramos.append([giro, srv, SERVICIO_DRIB_T2, SERVICIO_DRIB_TOQUES.y, "run"])
	puntos.append(srv)
	var dura: float = 0.0
	for tr in tramos:
		dura += float(tr[2])
	return {
		"inicio": inicio, "giro": giro, "hasta": srv,
		"e1": e1, "e2": e2, "eje": eje,
		"pie": srv + e2 * SERVICIO_DRIB_CERCA,
		"tipo": tipo, "tramos": tramos, "puntos": puntos, "dura": dura,
		"lance": lance, "suelo": suelo, "sale2": sale2,
	}









static func _servicio_lance_libre(reg: Dictionary, sale: Vector2, ball: Vector2) -> bool:
	var lance: Dictionary = reg.get("lance", {})
	if lance.is_empty():
		return true
	var pie: Vector2 = reg["pie"]
	var giro: Vector2 = reg["giro"]
	var e1: Vector2 = reg["e1"]
	for q in reg.get("suelo", []):
		if not _servicio_libre(q, pie, ball, SERVICIO_NPC_LIBRE):
			return false
	var que: String = String(lance["que"])
	if que == "barrida" or que == "a_dos":
		var fin: Vector2 = lance["fin"]
		for desde in [sale, giro + e1 * 2.0]:
			for i in 6:
				if not _servicio_libre(Vector2(desde).lerp(fin, float(i) / 5.0), pie, ball,
						SERVICIO_NPC_LIBRE):
					return false
		if que == "a_dos":
			var sale2: Vector2 = reg["sale2"]
			var sienta: Vector2 = lance["sienta"]
			if not sale2.is_finite() or not _servicio_libre(sale2, pie, ball, SERVICIO_PASE_LIBRE) \
					or sale2.distance_to(sale) < 2.0:
				return false
			for i in 6:
				if not _servicio_libre(sale2.lerp(sienta, float(i) / 5.0), pie, ball,
						SERVICIO_NPC_LIBRE):
					return false
	elif que == "carga":
		var choque: Vector2 = lance["choque"]
		var hombro: Vector2 = lance["hombro"]
		for i in 11:
			if not _servicio_libre(choque.lerp(giro, float(i) / 10.0) + hombro, pie, ball,
					SERVICIO_NPC_LIBRE):
				return false
	return true




static func _servicio_en_campo(p: Vector2, suelo: float = 4.0) -> Vector2:
	return Vector2(clampf(p.x, - FIELD_EDGE, FIELD_EDGE), clampf(p.y, suelo, FIELD_BACK))

































var _serve_orsay: float = 0.0




func _servicio_orsay() -> float:
	var zs: Array[float] = []
	if is_instance_valid(_keeper):
		zs.append(_keeper.global_position.z)
	for a in _rival_actors:
		if is_instance_valid(a):
			zs.append(a.global_position.z)
	return _servicio_orsay_z(zs)




static func _servicio_orsay_z(zs: Array[float]) -> float:
	if zs.size() < 2:
		return 0.0
	zs.sort()
	return zs[1]




static func _servicio_onside(p: Vector2, linea: float) -> Vector2:
	return Vector2(p.x, maxf(p.y, linea))













static func _servicio_integra(desde: Vector3, vel: Vector3, spin: float, bote: float,
		drag: float, pasos: int, suelo: bool = true) -> Dictionary:
	var ruta: Array[Vector3] = [desde]
	var botes: Array[int] = []
	var botes_vy: Array[float] = []
	var p: Vector3 = desde
	var v: Vector3 = vel
	for _i in pasos:
		var h: float = Vector2(v.x, v.z).length()
		if h > CURL_MIN_SPEED and absf(spin) > 0.02:
			var perp: Vector3 = Vector3(v.z, 0.0, - v.x).normalized()
			var curl: float = CURL_ACCEL * minf(h / CURL_REF_SPEED, 1.0)
			if p.y <= 0.0:
				curl *= CURL_GROUND
			v += perp * spin * curl * SIM_DT
		v.y -= 9.8 * SIM_DT
		v *= 1.0 - 0.12 * SIM_DT
		p += v * SIM_DT
		if p.y < 0.0 and suelo:
			p.y = 0.0
			if absf(v.y) > 1.5:
				botes.append(ruta.size())
				botes_vy.append(v.y)
				v.y = - v.y * bote
				v.x *= 0.85
				v.z *= 0.85
			else:
				v.y = 0.0
		if p.y == 0.0 and v.y == 0.0:
			v.x *= 1.0 - drag * SIM_DT
			v.z *= 1.0 - drag * SIM_DT
		ruta.append(p)
	return {"ruta": ruta, "botes": botes, "botes_vy": botes_vy}













static func _servicio_pique(ruta: Array[Vector3], botes: Array[int], botes_vy: Array[float],
		n: int) -> Vector4:
	var b: int = botes[n]
	if b < 1 or b >= ruta.size() or n >= botes_vy.size():
		var p0: Vector3 = ruta[clampi(b, 0, ruta.size() - 1)]
		return Vector4(p0.x, 0.0, p0.z, float(b) * SIM_DT)
	var prev: Vector3 = ruta[b - 1]
	var caida: float = - float(botes_vy[n]) * SIM_DT
	var f: float = clampf(prev.y / maxf(caida, 0.0001), 0.0, 1.0)
	var p: Vector3 = prev.lerp(ruta[b], f)
	return Vector4(p.x, 0.0, p.z,(float(b - 1) + f) * SIM_DT)



















static func _servicio_resuelve(desde: Vector3, meta: Vector3, perfil: String,
		objetivo: float, extra: float, spin: float, bote: float, drag: float) -> Dictionary:
	var eje := Vector2(meta.x - desde.x, meta.z - desde.z)
	var largo: float = maxf(eje.length(), 0.5)
	var u: Vector2 = eje / largo
	var theta: float = 0.0
	var vh: float
	var vy: float = 0.0

	match perfil:
		"aire":
			vh = largo / objetivo *(1.0 + 0.06 * objetivo)


			vy =(extra - desde.y + 4.9 * objetivo * objetivo) / objetivo
		"bote":
			vh =(largo - extra) / objetivo *(1.0 + 0.06 * objetivo)
			vy = 4.9 * objetivo
		_:



			var c: float = drag + 0.12
			vh = c * largo / maxf(1.0 - exp(- c * objetivo), 0.05)
	var out: Dictionary = {}
	for _vuelta in SERVICIO_RESUELVE_VUELTAS:
		var dh: Vector2 = u.rotated(theta)
		var vel := Vector3(dh.x * vh, vy, dh.y * vh)
		var sim: Dictionary = _servicio_integra(desde, vel, spin, bote, drag,
			SERVICIO_PASOS_MAX, perfil != "aire")
		var ruta: Array[Vector3] = sim["ruta"]
		var k: int = -1
		var s_prev: float = 0.0
		for i in range(1, ruta.size()):
			var s: float = Vector2(ruta[i].x - desde.x, ruta[i].z - desde.z).dot(u)
			if s >= largo:
				k = i
				break
			s_prev = s
		if k < 0:


			vh = vh + 3.0 if perfil == "raso" else vh * 1.25
			continue
		var s_k: float = Vector2(ruta[k].x - desde.x, ruta[k].z - desde.z).dot(u)
		var f: float = clampf((largo - s_prev) / maxf(s_k - s_prev, 0.0001), 0.0, 1.0)
		var cruce: Vector3 = ruta[k - 1].lerp(ruta[k], f)
		var t_c: float =(float(k - 1) + f) * SIM_DT



		var i0: int = k if f >= 0.5 else k - 1
		var ia: int = clampi(i0, 1, ruta.size() - 1)
		var ib: int = clampi(i0 + 1, 1, ruta.size() - 1)
		var paso: Vector3 =((ruta[ia] - ruta[ia - 1]) / SIM_DT).lerp(
			(ruta[ib] - ruta[ib - 1]) / SIM_DT, f - 0.5 if f >= 0.5 else f + 0.5)
		var vh_c: float = Vector2(paso.x, paso.z).length()
		var lateral: float = u.cross(Vector2(cruce.x - desde.x, cruce.z - desde.z))
		var botes: Array[int] = sim["botes"]
		out = {
			"vel": vel, "ruta": ruta, "botes": botes, "botes_vy": sim["botes_vy"],
			"k": k, "cruce": cruce, "t": t_c, "vh": vh_c, "vy": paso.y,
			"vin": Vector2(paso.x, paso.z).normalized() if vh_c > 0.01 else u,
			"error": Vector2(cruce.x - meta.x, cruce.z - meta.z).length(),
		}
		var listo: bool = absf(lateral) < 0.03
		match perfil:
			"aire":




				listo = listo and absf(cruce.y - extra) < 0.02 and absf(t_c - objetivo) < 0.02
				if not listo:




					var y_pred: float = cruce.y + paso.y *(objetivo - t_c)
					vh *= t_c / objetivo
					vy +=(extra - y_pred) / objetivo
			"bote":
				var b: int = botes[0] if not botes.is_empty() else -1
				if b < 0 or b > k:

					listo = false
					vy *= 0.8
				else:


					var pq: Vector4 = _servicio_pique(ruta, botes, sim["botes_vy"], 0)
					var s_b: float = Vector2(pq.x - desde.x, pq.z - desde.z).dot(u)
					var t_b: float = pq.w
					listo = listo and absf(s_b -(largo - extra)) < 0.05 \
							and absf(t_b - objetivo) < 0.03
					if not listo:



						var r_t: float = objetivo / maxf(t_b, 0.05)
						vy *= r_t
						vh *=(largo - extra) / maxf(s_b, 0.1) / r_t
			_:
				listo = listo and absf(t_c - objetivo) < 0.02
				if not listo:

					vh +=(t_c - objetivo) * vh * maxf(vh_c, 0.3) / largo
		if listo:
			break
		theta -= lateral / largo


	if perfil == "aire" and not out.is_empty():
		var con_suelo: Dictionary = _servicio_integra(desde, out["vel"], spin, bote, drag,
			SERVICIO_PASOS_MAX)
		out["ruta"] = con_suelo["ruta"]
		out["botes"] = con_suelo["botes"]
		out["botes_vy"] = con_suelo["botes_vy"]
	return out



















const SERVICIO_BOTE_ENTRADA: float = 0.7
const SERVICIO_BOTE_ALTO_MAX: float = 0.55


static func _servicio_bote_vuelo(objetivo: float, extra: float, largo: float) -> float:
	var hasta_pique: float = SERVICIO_BOTE_ENTRADA - extra
	if hasta_pique <= 0.0:

		return objetivo
	var tope: float = sqrt(SERVICIO_BOTE_ALTO_MAX * maxf(largo - extra, 0.5)
		/(4.9 * hasta_pique))
	return maxf(minf(objetivo, tope), SERVICIO_VUELO_MIN)









static func _servicio_guion(plan: Dictionary, bote: float, drag: float) -> Dictionary:
	var srv: Vector2 = plan["srv"]
	var ball: Vector2 = plan["ball"]


	var saque: bool = bool(plan.get("saque", false))

	var g: Dictionary
	if saque:
		g = _saque_largo_g(srv, ball)
	elif String(plan.get("regate", "")) == "parado":
		g = _parado_g(srv, ball, float(plan.get("corte", 1.0)))
	else:
		g = _servicio_regate(srv, ball, float(plan.get("corte", 1.0)),
			String(plan.get("regate", "recorte")))
	var pie: Vector2 = g["pie"]
	var desde: Vector3 = _saque_largo_desde(plan) if saque else Vector3(pie.x, 0.0, pie.y)
	var perfil: String = String(plan.get("perfil", "raso"))
	var objetivo: float = float(plan.get("objetivo", 7.0))
	var extra: float = float(plan.get("extra", 0.0))
	if perfil == "aire" and plan.has("pendiente"):
		var largo: float = pie.distance_to(ball)



		objetivo = maxf(sqrt(maxf(extra + float(plan["pendiente"]) * largo, 0.1) / 4.9),
			SERVICIO_VUELO_MIN)
	elif perfil == "bote":
		objetivo = _servicio_bote_vuelo(objetivo, extra, pie.distance_to(ball))
	g["pase"] = _servicio_resuelve(desde, Vector3(ball.x, 0.0, ball.y),
		perfil, objetivo, extra, float(plan.get("rosca", 0.0)), bote, drag)


	if not (g["pase"] as Dictionary).is_empty() and not bool(plan.get("cabeza", false)):
		if bool(plan.get("pecho", false)):
			_servicio_pecho_ruta(g["pase"], ball)
		else:
			_servicio_pie_ruta(g["pase"], ball)
	return g



static func _servicio_al_arco(p: Vector2) -> Vector2:
	return (- p).normalized() if p.length() > 0.01 else Vector2(0.0, -1.0)






static func _servicio_botes_hasta(pase: Dictionary, k: int, botes: Array[int],
		botes_vy: Array[float]) -> void:
	var de: Array = pase["botes"]
	var vy_de: Array = pase["botes_vy"]
	for n in de.size():
		if int(de[n]) < k:
			botes.append(int(de[n]))
			botes_vy.append(float(vy_de[n]) if n < vy_de.size() else 0.0)






static func _servicio_rueda(out: Array[Vector3], p: Vector3, vel: Vector3,
		delante: float, drag: float = 1.2) -> int:
	var desde := Vector2(p.x, p.z)
	var k2: int = -1
	p.y = 0.0
	vel.y = 0.0
	for _tick in SERVICIO_PASOS_MAX:
		if Vector2(vel.x, vel.z).length() < 0.1:
			break
		p += vel * SIM_DT
		vel *= exp(- drag * SIM_DT)
		out.append(p)
		if k2 < 0 and delante > 0.0 and Vector2(p.x, p.z).distance_to(desde) >= delante:
			k2 = out.size() - 1
	for _tick in SERVICIO_RUTA_RESTO:
		out.append(p)
	return k2








static func _servicio_postura(recibe: Vector2, venia: Vector2) -> Vector2:
	var al_arco: Vector2 = _servicio_al_arco(recibe)
	return recibe - al_arco * SERVICIO_RECIBE_ATRAS \
			- _servicio_lado(al_arco, venia) * SERVICIO_RECIBE_LADO







static func _servicio_lado(al_arco: Vector2, venia: Vector2) -> Vector2:
	var lado: Vector2 = venia - al_arco * venia.dot(al_arco)
	if lado.length() < 0.2 * maxf(venia.length(), 0.01):
		lado = Vector2(- al_arco.y, al_arco.x)
	return lado.normalized() if lado.length() > 0.001 else Vector2(1.0, 0.0)



static func _servicio_venia_en(ruta: Array[Vector3], k: int, punto: Vector3) -> Vector2:
	var lleva: Vector3 = punto - ruta[k - 1]
	return Vector2(- lleva.x, - lleva.z)




















static func _servicio_pecho_ruta(pase: Dictionary, meta: Vector2) -> void:
	var ruta: Array[Vector3] = pase["ruta"]
	var k: int = int(pase["k"])
	if k < 1 or k >= ruta.size():
		return
	var pecho: Vector3 = pase["cruce"]
	var botes: Array[int] = []
	var botes_vy: Array[float] = []
	_servicio_botes_hasta(pase, k, botes, botes_vy)
	var out: Array[Vector3] = []
	out.assign(ruta.slice(0, k))
	out.append(pecho)
	var al_arco: Vector2 = _servicio_al_arco(meta)
	var lado: Vector2 = _servicio_lado(al_arco, _servicio_venia_en(ruta, k, pecho))
	var g: float = 9.8


	var vy: float = sqrt(2.0 * g
		* maxf(SERVICIO_PECHO_CIMA -(pecho.y + BALL_VISUAL_D * 0.5), 0.02))



	var t_cae: float =(vy + sqrt(vy * vy + 2.0 * g * maxf(pecho.y - SERVICIO_VOLEA_Y, 0.05))) / g
	var vh: Vector2 = al_arco *(SERVICIO_PECHO_DELANTE / t_cae) + lado * SERVICIO_PECHO_LADO_V
	var p: Vector3 = pecho
	var vel := Vector3(vh.x, vy, vh.y)
	var k2: int = -1
	var picado: bool = false
	var pica: int = -1
	for _tick in SERVICIO_PASOS_MAX:
		p += vel * SIM_DT
		vel.y -= g * SIM_DT
		if p.y <= 0.0:
			if picado:
				break


			picado = true
			p.y = 0.0
			pica = out.size()
			botes.append(out.size())
			botes_vy.append(vel.y)
			vel = Vector3(vel.x * 0.8, - vel.y * 0.45, vel.z * 0.8)
		out.append(p)
		if k2 < 0 and vel.y < 0.0 and p.y <= SERVICIO_VOLEA_Y:
			k2 = out.size() - 1



			if k2 >= 1 and out[k2 - 1].y - SERVICIO_VOLEA_Y < SERVICIO_VOLEA_Y - p.y:
				k2 -= 1
	if k2 < 0:
		return
	_servicio_rueda(out, p, vel, 0.0)
	pase["ruta"] = out
	pase["botes"] = botes
	pase["botes_vy"] = botes_vy
	pase["k_recibe"] = k
	pase["recibe"] = pecho
	pase["control"] = "pecho"
	pase["k"] = k2
	pase["cruce"] = out[k2]
	pase["pica"] = pica














static func _servicio_pie_ruta(pase: Dictionary, meta: Vector2) -> void:
	var ruta: Array[Vector3] = pase["ruta"]
	var k: int = int(pase["k"])
	if k < 1 or k >= ruta.size():
		return
	var recibe: Vector3 = pase["cruce"]
	var botes: Array[int] = []
	var botes_vy: Array[float] = []
	_servicio_botes_hasta(pase, k, botes, botes_vy)
	var out: Array[Vector3] = []
	out.assign(ruta.slice(0, k))
	out.append(recibe)
	var al_arco: Vector2 = _servicio_al_arco(meta)
	var lado: Vector2 = _servicio_lado(al_arco, _servicio_venia_en(ruta, k, recibe))
	var p: Vector3 = recibe

	if p.y > 0.02:
		var vel := Vector3(lado.x * 0.5, -1.5, lado.y * 0.5)
		for _tick in SERVICIO_PASOS_MAX:
			p += vel * SIM_DT
			vel.y -= 9.8 * SIM_DT
			if p.y <= 0.0:
				break
			out.append(p)
	var k2: int = _servicio_rueda(out, p, Vector3(lado.x, 0.0, lado.y) * SERVICIO_PIE_V,
		SERVICIO_PIE_DELANTE, SERVICIO_PIE_DRAG)
	if k2 < 0:
		k2 = out.size() - 1 - SERVICIO_RUTA_RESTO
	pase["ruta"] = out
	pase["botes"] = botes
	pase["botes_vy"] = botes_vy
	pase["k_recibe"] = k
	pase["recibe"] = recibe
	pase["control"] = "pie"
	pase["k"] = k2
	pase["cruce"] = out[k2]







static func _servicio_perfil(ruta: Array[Vector3], cruce: Vector3, vin: Vector2) -> Array[Vector4]:
	var out: Array[Vector4] = []
	for i in range(0, ruta.size() - 1):
		var s: float = Vector2(ruta[i].x - cruce.x, ruta[i].z - cruce.z).dot(vin)
		if s < - SERVICIO_PERFIL_ATRAS:
			continue
		if s > SERVICIO_PERFIL_DELANTE:
			break
		var d: Vector3 =(ruta[i + 1] - ruta[i]) / SIM_DT
		var vh: float = Vector2(d.x, d.z).length()
		out.append(Vector4(s, ruta[i].y, vh, d.y / maxf(vh, 0.01)))
	return out



static func _servicio_muestra(perfil: Array, s: float) -> Vector4:
	if perfil.is_empty():
		return Vector4(s, 0.0, 1.0, 0.0)
	var a: Vector4 = perfil[0]
	if s <= a.x:
		return a
	for i in range(1, perfil.size()):
		var b: Vector4 = perfil[i]
		if b.x >= s:
			return a.lerp(b, clampf((s - a.x) / maxf(b.x - a.x, 0.0001), 0.0, 1.0))
		a = b
	return a







