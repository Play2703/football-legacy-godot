func _cruce_sin_choque(pos: Vector3, vel: Vector3, spin: float, back_spin: float,
		wind_vx: float, pasos: int) -> Vector3:
	for _step in maxi(pasos, 0):
		var p0: Vector3 = pos
		var h_speed: float = Vector2(vel.x, vel.z).length()
		if h_speed > CURL_MIN_SPEED and absf(spin) > 0.02:
			var perp: Vector3 = Vector3(vel.z, 0.0, - vel.x).normalized()
			var curl: float = CURL_ACCEL * minf(h_speed / CURL_REF_SPEED, 1.0)
			if pos.y <= 0.0:
				curl *= CURL_GROUND
			vel += perp * spin * curl * SIM_DT
		if h_speed > 0.5 and absf(back_spin) > 0.02 and pos.y > 0.0:
			vel.y += back_spin * VERT_MAGNUS * h_speed * SIM_DT
		if pos.y > 0.12:
			wind_vx +=(_wind.x * WIND_DRIFT_FRAC - wind_vx) *(WIND_DRAG * SIM_DT)
			vel.z += _wind.z *(WIND_PUSH * SIM_DT)
		else:
			wind_vx *= 1.0 - 4.0 * SIM_DT
		vel.y -= 9.8 * SIM_DT
		vel *= 1.0 - 0.12 * SIM_DT
		pos += vel * SIM_DT
		pos.x += wind_vx * SIM_DT
		if pos.y < 0.0:
			pos.y = 0.0
			if absf(vel.y) > 1.5:
				vel.y = - vel.y * _cesped_bote
				vel.x *= 0.85
				vel.z *= 0.85
			else:
				vel.y = 0.0
		if pos.y == 0.0 and vel.y == 0.0:
			vel.x *= 1.0 - _cesped_drag * SIM_DT
			vel.z *= 1.0 - _cesped_drag * SIM_DT
		if pos.z <= 0.0 and vel.z < 0.0:
			var dz: float = p0.z - pos.z
			return pos if dz <= 0.0001 else p0.lerp(pos, clampf(p0.z / dz, 0.0, 1.0))
		if vel.z >= 0.0 or absf(pos.x) > OUT_SIDE_X \
				or Vector2(vel.x, vel.z).length() < 0.3:
			return Vector3.INF
	return CRUCE_DUDOSO





