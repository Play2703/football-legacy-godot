func _warm_keeper_paths(look: Dictionary) -> Array:
	var out: Array = []
	for i in 4:
		for p_idle in ["res://assets/sprites/anim/idle_keeper_%02d.png" % i,
				"res://assets/sprites/anim/idle_keeper_north_%02d.png" % i]:
			if ResourceLoader.exists(p_idle):
				out.append([p_idle, look])
	for prefix in ["dive_", "dive_north_", "dive_high_", "dive_high_north_",
			"jump_", "jump_north_", "jump_catch_", "jump_catch_north_",
			"chest_catch_", "chest_catch_north_",
			"saque_mano_keeper_", "saque_mano_keeper_north_",
			"pie_lateral_", "pie_lateral_north_", "pie_raso_", "pie_raso_north_",
			"blocaje_lado_", "blocaje_lado_north_", "blocaje_bruces_", "blocaje_bruces_north_",
			"parada_mano_", "parada_mano_north_", "parada_plancha_", "parada_plancha_north_",
			"parada_caida_", "parada_caida_north_", "parada_colapso_", "parada_colapso_north_"]:
		for i in range(1, 13):
			var p_save: String = "res://assets/sprites/anim/%s%02d.png" % [prefix, i]
			if ResourceLoader.exists(p_save):
				out.append([p_save, look])







	var field_look: Dictionary = KitRecolor.keeper_field_cfg(look)
	for dir in ANIM_DIRS:
		for i in range(1, 9):
			var p_run: String = "res://assets/sprites/anim/run_player_%s_%02d.png" % [dir, i]
			if ResourceLoader.exists(p_run):
				out.append([p_run, field_look])
		for i in range(1, 7):
			var p_kick: String = "res://assets/sprites/anim/kick_player_%s_%02d.png" % [dir, i]
			if ResourceLoader.exists(p_kick):
				out.append([p_kick, field_look])
		var p_out: String = "res://assets/sprites/players/keeper_%s.png" % dir
		if ResourceLoader.exists(p_out):
			out.append([p_out, look])
	return out



