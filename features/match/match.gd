func _playa_maybe_spawn() -> void:

	_playa = null
	_playa_gol = false
	_playa_prev_ball = Vector3.INF
	if _playa_salio:
		return

	if _shootout_active or _tutorial_active or not _practice_kind.is_empty():
		return



	if not _playa_force and (_anuncio_parado_kind() or _meta_viva or _saque_vivo):
		return
	if not _playa_rolled:
		_playa_rolled = true



		if not _playa_force:
			_playa_rng.randomize()
		_playa_on = _playa_force or _playa_sale()
		_playa_wait = 0 if _playa_force else _playa_rng.randi_range(0, PLAYA_WAIT_MAX)
	if not _playa_on:
		return
	if _playa_wait > 0:
		_playa_wait -= 1
		return
	var red: Vector3 = Vector3(GOAL_HALF_W, CROSSBAR_H, NET_DEPTH)
	var puntos: Array[Vector3] = _playa_punto(red)
	if puntos.is_empty():


		return
	_playa_salio = true
	_playa_giro = _playa_rng.randf_range(PLAYA_GIRO_MIN, PLAYA_GIRO_MAX)
	_playa_k = _playa_rng.randf_range(PLAYA_K_MIN, PLAYA_K_MAX)
	_playa_salto = _playa_rng.randf_range(PLAYA_SALTO_MIN, PLAYA_SALTO_MAX)
	_playa_signo0 = 1.0 if _playa_rng.randf() < 0.5 else -1.0
	_playa = BalonPlaya.new()


	_actors.add_child(_playa)
	_playa.colocar(puntos, red)
	_playa.cayo.connect(_on_playa_cae)
	_playa.boto.connect(_on_playa_bota)




func _playa_sale() -> bool:
	if GameState.readonly_save:
		return false
	return _playa_rng.randf() < PLAYA_MATCH_P






func _playa_punto(red: Vector3) -> Array[Vector3]:
	var nada: Array[Vector3] = []
	if _aim_cam == null or not is_instance_valid(_aim_cam):
		return nada
	var dist: float = _ball_field.length()
	var d_max: float = minf(PLAYA_D_MAX, dist - PLAYA_HUECO)
	if d_max <= PLAYA_D_MIN:
		return nada
	var vista: Vector2 = SceneFade.rect_visible(_aim_cam).size
	var eje: Vector2 = _ball_field / dist
	var lado: Vector2 = Vector2(- eje.y, eje.x)
	var cuerpos: Array[Vector2] = _playa_cuerpos()
	for i in PLAYA_INTENTOS:
		var q: Vector2 = eje * _playa_rng.randf_range(PLAYA_D_MIN, d_max) \
				+ lado * _playa_rng.randf_range(- PLAYA_LADO, PLAYA_LADO)
		if q.y < PLAYA_Z_MIN:
			continue
		var libre: bool = true
		for c in cuerpos:
			if c.distance_to(q) < PLAYA_LIBRE:
				libre = false
				break
		if not libre:
			continue
		var p: Vector3 = Vector3(q.x, BalonPlaya.R, q.y)
		if _aim_cam.is_position_behind(p):
			continue
		var s: Vector2 = _aim_cam.unproject_position(p)
		if s.x < vista.x * PLAYA_PANT_X or s.x > vista.x *(1.0 - PLAYA_PANT_X) \
				or s.y < vista.y * PLAYA_PANT_Y0 or s.y > vista.y * PLAYA_PANT_Y1:
			continue
		var puntos: Array[Vector3] = BalonPlaya.entrada(p, red, _playa_rng)
		if not puntos.is_empty():
			return puntos
	return nada





func _playa_cuerpos() -> Array[Vector2]:
	var r: Array[Vector2] = []
	for n in _actors.get_children():
		var a: AnimatedSprite3D = n as AnimatedSprite3D
		if a != null and a.visible:
			r.append(Vector2(a.position.x, a.position.z))
	return r


func _playa_vivo() -> bool:
	return _playa != null and is_instance_valid(_playa) and _playa.vivo()








func _playa_desvia(vel: Vector3, toque: Vector3, c: Vector3) -> Vector3:
	var h: Vector2 = Vector2(vel.x, vel.z)
	var hv: float = h.length()
	if hv < 0.3:

		return Vector3(vel.x * _playa_k, maxf(vel.y, 0.0) + _playa_salto * 0.5,
			vel.z * _playa_k)
	var d: Vector2 = h / hv
	var o: Vector2 = Vector2(toque.x - c.x, toque.z - c.z)
	var o_perp: Vector2 = o - d * o.dot(d)
	var lado: Vector2 = Vector2(- d.y, d.x) * _playa_signo0
	if o_perp.length() >= PLAYA_FRENTE_M:
		lado = o_perp.normalized()
	var nh: Vector2 =(d * cos(_playa_giro) + lado * sin(_playa_giro)) * hv * _playa_k
	return Vector3(nh.x, vel.y * _playa_k + _playa_salto, nh.y)






