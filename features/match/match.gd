		_recu_def_vel.append(Vector2.ZERO)
		_recu_def_meta.append(p)
		_recu_def_act.append(a)
		_recu_def_spd.append(_pace_for(DUEL_CHASE_SPD.x, DUEL_CHASE_SPD.y,
			Duel.spread(Squad.norm(rp, "velocidad")) if not rp.is_empty() else q_club))
		_recu_def_k.append(_npc_accel_k(rp))
		_recu_def_lead.append(
			Duel.spread(Squad.norm(rp, "entrada")) if not rp.is_empty() else q_club)
		_recu_def_tackle.append(
			Duel.spread(Squad.norm(rp, "entrada")) if not rp.is_empty()
			else Duel.NEUTRAL_TACKLE)
		_recu_def_armed.append(true)
		_recu_def_recov.append(false)
		_recu_def_cd.append(0.0)
		_recu_def_barr.append(0.0)
		_recu_def_suelo.append(0.0)
		_recu_def_bdir.append(Vector2.ZERO)
		_recu_def_bcd.append(0.0)
		_recu_def_rol.append(Recupera.ROL_MARCA)
		_recu_def_marca.append(-1)

		_recu_defs.append(p)











func _recu_censo_step() -> void:

	for i in range(_recu_def_pos.size() - 1, -1, -1):
		if float(_recu_def_barr[i]) > 0.0 or float(_recu_def_suelo[i]) > 0.0:
			continue
		if (_recu_def_pos[i] as Vector2).distance_to(_ball_field) <= Recupera.CENSO_SALE:
			continue
		var b: AnimatedSprite3D = _recu_def_act[i]
		for lista in [_recu_def_pos, _recu_def_vel, _recu_def_meta, _recu_def_act,
				_recu_def_spd, _recu_def_k, _recu_def_lead, _recu_def_tackle,
				_recu_def_armed, _recu_def_recov, _recu_def_cd, _recu_def_barr,
				_recu_def_suelo, _recu_def_bdir, _recu_def_bcd,
				_recu_def_rol, _recu_def_marca]:
			(lista as Array).remove_at(i)
		if is_instance_valid(b):
			_recu_sella_linea(b, true)
			_recu_paseo.append(b)




	if _recu_def_pos.size() >= Recupera.enganchan_max(_recu_apoyos.size()):
		return
	for a in _recu_paseo:
		if not is_instance_valid(a) or not _teammate_actors.has(a):
			continue
		var p: Vector2 = Vector2(a.position.x, a.position.z)
		if p.distance_to(_ball_field) > Recupera.CENSO_ENTRA:
			continue
		_recu_paseo.erase(a)
		var rp: Dictionary = a.get_meta("player", {}) if a.has_meta("player") else {}
		var q_club: float = 0.5
		_recu_def_pos.append(p)
		_recu_def_vel.append(Vector2.ZERO)
		_recu_def_meta.append(p)
		_recu_def_act.append(a)
		_recu_def_spd.append(_pace_for(DUEL_CHASE_SPD.x, DUEL_CHASE_SPD.y,
			Duel.spread(Squad.norm(rp, "velocidad")) if not rp.is_empty() else q_club))
		_recu_def_k.append(_npc_accel_k(rp))
		_recu_def_lead.append(
			Duel.spread(Squad.norm(rp, "entrada")) if not rp.is_empty() else q_club)
		_recu_def_tackle.append(
			Duel.spread(Squad.norm(rp, "entrada")) if not rp.is_empty()
			else Duel.NEUTRAL_TACKLE)
		_recu_def_armed.append(true)
		_recu_def_recov.append(false)
		_recu_def_cd.append(0.0)
		_recu_def_barr.append(0.0)
		_recu_def_suelo.append(0.0)
		_recu_def_bdir.append(Vector2.ZERO)
		_recu_def_bcd.append(0.0)
		_recu_def_rol.append(Recupera.ROL_MARCA)
		_recu_def_marca.append(-1)
		break


















func _recu_def_step(delta: float) -> void:
	if _recu_def_pos.is_empty():
		return

















	var conduce: bool = not _recu_tiro and not _recu_pase and not _recu_suelta





	var mando_i: int = -1
	var ball: Vector2 = _ball_field



	var apoyos: Array = []
	var apoyo_dir: Array = []
	for a in _recu_apoyos:
		if is_instance_valid(a):
			apoyos.append(Vector2(a.position.x, a.position.z))
			var v: Vector2 = _chase_vels.get(a, Vector2.ZERO)
			apoyo_dir.append(v.normalized() if v.length() > 0.2 else Vector2.ZERO)
		else:
			apoyos.append(Vector2(0.0, -999.0))
			apoyo_dir.append(Vector2.ZERO)



	_recu_reparto_t -= delta
























	if _recu_reparto_t > 0.0 and conduce:
		var cont_i: int = -1
		var n_rol: int = mini(_recu_def_rol.size(), _recu_def_pos.size())
		for ri in n_rol:
			if int(_recu_def_rol[ri]) == Recupera.ROL_CONTIENE:
				cont_i = ri
				break
		if cont_i >= 0 \
				and ((_recu_def_pos[cont_i] as Vector2).y - ball.y) * Recupera.DIR \
				<= Recupera.CONTIENE_AHEAD:
			for rj in n_rol:
				if rj == cont_i or int(_recu_def_rol[rj]) == Recupera.ROL_PRESOR:
					continue
				if ((_recu_def_pos[rj] as Vector2).y - ball.y) * Recupera.DIR \
						> Recupera.CONTIENE_AHEAD:
					_recu_reparto_t = 0.0
					break
	if _recu_reparto_t <= 0.0:
		_recu_reparto_t = Recupera.REPARTO_T



		_recu_censo_step()







		var rep: Array = Recupera.reparte(_recu_def_pos, ball, apoyos, Duel.ENGAGE_R,
			_recu_def_rol, _recu_def_marca)
		_recu_def_rol = rep[0]
		_recu_def_marca = rep[1]
		_recu_prepara_contactos()






	var mi_pace: float = _recu_vel.length() / maxf(_recu_car_spd, 0.01)


	var linea_fdj: float = _recu_linea_fdj()
	var ultimo: int = -1
	var mas_z: float = - INF
	for i in _recu_def_pos.size():
		if (_recu_def_pos[i] as Vector2).y > mas_z:
			mas_z =(_recu_def_pos[i] as Vector2).y
			ultimo = i


















	var cazador: int = -1
	if _recu_pase or _recu_suelta:
		var caza_d: float = INF
		for i in _recu_def_pos.size():



			if float(_recu_def_barr[i]) > 0.0 or float(_recu_def_suelo[i]) > 0.0:
				continue
			var cd_i: float =(_recu_def_pos[i] as Vector2).distance_to(ball)
			if cd_i < caza_d:
				caza_d = cd_i
				cazador = i
	for i in _recu_def_pos.size():
		var dpos: Vector2 = _recu_def_pos[i]
		var spd: float = _recu_def_spd[i]
		_recu_def_bcd[i] = maxf(float(_recu_def_bcd[i]) - delta, 0.0)









		_recu_def_cd[i] = maxf(float(_recu_def_cd[i]) - delta, 0.0)



		if float(_recu_def_suelo[i]) > 0.0:
			_recu_def_suelo[i] = maxf(float(_recu_def_suelo[i]) - delta, 0.0)
			_recu_def_vel[i] = Vector2.ZERO
			_chase_vels.erase(_recu_def_act[i])
			continue


		if float(_recu_def_barr[i]) > 0.0:
			_recu_def_barr[i] = maxf(float(_recu_def_barr[i]) - delta, 0.0)









			var bv: Vector2 =(_recu_def_bdir[i] as Vector2) \
					*(spd * Recupera.BARRIDA_SPD
					* Recupera.barrida_largo(float(_recu_def_tackle[i]))
					* clampf(float(_recu_def_barr[i]) / Recupera.BARRIDA_T, 0.0, 1.0))
			_recu_def_pos[i] = _recu_corral(dpos + bv * delta)
			_recu_def_vel[i] = bv


























			if mando_i < 0 and conduce \
					and (_recu_def_pos[i] as Vector2).distance_to(_ball_field) \
					<= RECU_BARRE_BALON_R:
				_recu_pase = false
				_recu_suelta = true
				_recu_barrida_buena_t = RECU_BARRE_VENTANA
				_recu_rival_suelo = RECU_RIVAL_SUELO_T





				_recu_tumba_portador(_recu_def_bdir[i] as Vector2)
				_recu_vel = Vector2.ZERO
				_ball_vel =(_recu_def_bdir[i] as Vector2) * RECU_BARRE_DESPEJE_V
				_recu_pase_desde = _ball_field
				_recu_ultimo_toque = -1
				_haptic(12)
				_audio.kick()
				_stadium.crowd_excite(0.6)






				if mando_i < 0 and _recu_mando_puede(i):
					mando_i = i
			var ba: AnimatedSprite3D = _recu_def_act[i]
			if is_instance_valid(ba):
				var bp: Vector2 = _recu_def_pos[i]
				ba.position = Vector3(bp.x, ba.position.y, bp.y)





				if not String(ba.animation).begins_with("slide"):
					_ondemand_deadline_us = maxi(_ondemand_deadline_us,
						Time.get_ticks_usec() + RECU_BARRIDA_BUDGET_US)
					_play_dir_gesture(ba, "slide", _recu_def_bdir[i],
						int((float(_recu_def_barr[i]) + Recupera.BARRIDA_SUELO)
							* 1000.0))




			_chase_vels.erase(ba)
			if float(_recu_def_barr[i]) <= 0.0:
				_recu_def_suelo[i] = Recupera.BARRIDA_SUELO
			continue


























		var rol: int = int(_recu_def_rol[i]) if i < _recu_def_rol.size() \
				else Recupera.ROL_MARCA
		var mk: int = int(_recu_def_marca[i]) if i < _recu_def_marca.size() else -1
		var meta: Vector2 = ball



		var cuerpo: Vector2 = _recu_pos
		match rol:
			Recupera.ROL_PRESOR:
				meta = Duel.hunt_point(ball, _ball_vel, dpos, float(_recu_def_lead[i]))
			Recupera.ROL_CONTIENE:











				if Recupera.quiere_jockey(dpos, ball, _recu_pos,
						float(_recu_def_lead[i]), mi_pace):
					meta = Duel.jockey_point(ball, Recupera.TARGET_Z, Recupera.DIR)
					spd *= Duel.JOCKEY_SPD_F
					_recu_jockey_s += delta
				elif dpos.distance_to(ball) <= Duel.ENGAGE_R \
						and (dpos.y - ball.y) * Recupera.DIR > 0.3:





					meta = Duel.hunt_point(ball, _ball_vel, dpos, float(_recu_def_lead[i]))
				else:
					meta = Duel.contain_point(ball, _ball_vel, Recupera.TARGET_Z,
						Duel.CONTAIN_M, Recupera.DIR)
			Recupera.ROL_PINZA:
				if dpos.distance_to(ball) <= Duel.ENGAGE_R:
					meta = Duel.hunt_point(ball, _ball_vel, dpos, float(_recu_def_lead[i]))
				else:
					meta = Duel.pinch_point(ball, _ball_vel, Recupera.TARGET_Z,
						Recupera.DIR)
			Recupera.ROL_CARRIL:
				if mk >= 0 and mk < apoyos.size():
					meta = Recupera.carril_punto(ball, apoyos[mk])
					cuerpo = apoyos[mk]
				else:
					meta = Duel.contain_point(ball, _ball_vel, Recupera.TARGET_Z,
						Duel.CONTAIN_M, Recupera.DIR)
			_:
				if mk >= 0 and mk < apoyos.size():







					var mk_v: Vector2 = _recu_ap_vel[mk] \
							if mk < _recu_ap_vel.size() else Vector2.ZERO
					meta = Recupera.marca_punto(
						(apoyos[mk] as Vector2) + mk_v * Recupera.MARCA_LEAD_T,
						apoyo_dir[mk], ball)
					cuerpo = apoyos[mk]
				else:
					meta = Duel.contain_point(ball, _ball_vel, Recupera.TARGET_Z,
						Duel.CONTAIN_M, Recupera.DIR)






















		if i == cazador:
			meta = Recupera.cita(ball, _ball_vel, dpos, float(_recu_def_spd[i]))
			spd = float(_recu_def_spd[i])









		var cargando: bool = false
		if Recupera.quiere_cargar(dpos, _recu_def_vel[i], cuerpo, float(_recu_def_cd[i])):
			meta = cuerpo
			spd *= Recupera.CARGA_EMPUJE
			_recu_def_cd[i] = Recupera.CARGA_CD
			cargando = true









		if i != ultimo and i != cazador:
			meta.y = minf(meta.y, linea_fdj + Recupera.LINEA_TOLERA)









		var a_ti: Vector2 = meta - _recu_yo



		if rol != Recupera.ROL_PRESOR and not cargando and i != cazador \
				and a_ti.length() < Recupera.CORRO_YO_VIVO:
			var f: Vector2 = a_ti.normalized() if a_ti.length() > 0.01 else Vector2(1.0, 0.0)
			meta = _recu_yo + f * Recupera.CORRO_YO_VIVO












		if conduce and (rol == Recupera.ROL_PRESOR or rol == Recupera.ROL_CONTIENE) \
				and dpos.distance_to(ball) <= Recupera.ROBO_NPC_R:
			_recu_pase = false
			_recu_suelta = true



			_recu_vel = Vector2.ZERO














			if mando_i >= 0:
				_ball_vel = Vector2.ZERO
			elif _recu_mando_puede(i):
				mando_i = i
				_ball_vel = Vector2.ZERO
			else:
				_ball_vel = Recupera.pase_vel(_ball_field, _recu_yo)
			_recu_pase_desde = _ball_field
			_recu_ultimo_toque = -1
			_haptic(10)
			_audio.kick()
			continue





















		if conduce and rol == Recupera.ROL_PRESOR \
				and Recupera.quiere_barrerse(dpos, _recu_def_vel[i], ball,
					float(_recu_def_bcd[i]), float(_recu_def_spd[i]),
					float(_recu_def_tackle[i])):
			var al_balon: bool = randf() < lerpf(Recupera.BARRIDA_ROBA_P.x,
				Recupera.BARRIDA_ROBA_P.y, float(_recu_def_tackle[i]))











			var blanco: Vector2 = ball + _ball_vel * Recupera.BARRIDA_LEAD_T
			var bd: Vector2 = Recupera.barrida_dir(dpos, _recu_def_vel[i], blanco,
				0.0 if al_balon
				else randf_range(Recupera.BARRIDA_FALLA.x, Recupera.BARRIDA_FALLA.y))
			_recu_def_bdir[i] = bd
			_recu_def_barr[i] = Recupera.BARRIDA_T
			_recu_def_bcd[i] = Recupera.BARRIDA_CD
			if is_instance_valid(_recu_def_act[i]):






				_ondemand_deadline_us = maxi(_ondemand_deadline_us,
					Time.get_ticks_usec() + RECU_BARRIDA_BUDGET_US)
				_play_dir_gesture(_recu_def_act[i], "slide", bd,
					int((Recupera.BARRIDA_T + Recupera.BARRIDA_SUELO) * 1000.0))








				var q_ent: float = float(_recu_def_tackle[i])
				var largo: float = float(_recu_def_spd[i]) * Recupera.BARRIDA_SPD \
						* Recupera.barrida_largo(q_ent) * Recupera.BARRIDA_T * 0.5
				var y0: float = _recu_def_act[i].position.y




				_recu_surco(Vector3(dpos.x, y0, dpos.y),
					Vector3(dpos.x + bd.x * largo, y0, dpos.y + bd.y * largo),
					Recupera.BARRIDA_T, Recupera.barrida_surco_w(q_ent))
			continue
		if i < _recu_def_meta.size():
			_recu_def_meta[i] = meta
		var k: float = float(_recu_def_k[i])







		var out: Array = Duel.step_defender_cut(dpos, _recu_def_vel[i], meta, spd,
			delta, k, _npc_cut_agil(k), _recu_def_armed[i], _recu_def_recov[i])
		if rol != Recupera.ROL_PRESOR and rol != Recupera.ROL_CONTIENE \
				and i != cazador and not cargando:
			var falta: Vector2 = meta - dpos
			var carrera: float = minf(spd,
				maxf(falta.length() - RECU_LLEGADA_M, 0.0) * RECU_LLEGADA_K)
			if carrera < spd:
				var llegada: Vector2 =(_recu_def_vel[i] as Vector2).move_toward(
					falta.normalized() * carrera, k * spd * delta)
				out = [dpos + llegada * delta, llegada,
					_recu_def_armed[i], _recu_def_recov[i]]
		_recu_def_pos[i] = _recu_corral(out[0])
		_recu_def_vel[i] =((_recu_def_pos[i] as Vector2) - dpos) / maxf(delta, 0.0001)
		_recu_def_armed[i] = out[2]
		_recu_def_recov[i] = out[3]
		var act: AnimatedSprite3D = _recu_def_act[i]
		if is_instance_valid(act):
			var np: Vector2 = _recu_def_pos[i]
			act.position = Vector3(np.x, act.position.y, np.y)
			var v2: Vector2 = _recu_def_vel[i]
			if v2.length() > 0.1:
				act.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
				_play_run(act, Vector3(v2.x, 0.0, v2.y))
			else:
				_face_ball(act)



			_chase_vels[act] = v2




	if mando_i >= 0:
		_recu_toma_mando(mando_i)
	if is_instance_valid(_recu_actor):
		_chase_vels[_recu_actor] = _recu_vel
	if is_instance_valid(_self_actor):
		_chase_vels[_self_actor] = _recu_yo_vel




















func _recu_pasador_step(delta: float) -> void:
	if not _recu_pase or _recu_rival_suelo > 0.0 or not is_instance_valid(_recu_actor):
		return
	var antes: Vector2 = _recu_pos
	var falta: Vector2 = _recu_pasador_meta - antes
	var spd: float = maxf(_recu_car_spd * 0.65, 2.0)
	var deseada: Vector2 = falta.normalized() \
			* minf(spd, maxf(falta.length() - RECU_LLEGADA_M, 0.0) * RECU_LLEGADA_K)
	_recu_vel = _recu_vel.move_toward(deseada, spd * 3.0 * delta)
	_recu_pos = _recu_corral(antes + _recu_vel * delta)
	_recu_vel =(_recu_pos - antes) / maxf(delta, 0.0001)
	_recu_actor.position = Vector3(_recu_pos.x, _recu_actor.position.y, _recu_pos.y)
	_chase_vels[_recu_actor] = _recu_vel

	if int(_anim_lock.get(_recu_actor, 0)) > Time.get_ticks_msec():
		return
	if _recu_vel.length() > 0.1:
		_play_run(_recu_actor, Vector3(_recu_vel.x, 0.0, _recu_vel.y))
	else:
		_face_ball(_recu_actor)


func _recu_suelto_step(delta: float) -> void:
	_recu_pasador_step(delta)



































	if _recu_rival_suelo <= 0.0 and is_instance_valid(_recu_actor) \
			and not _recu_over and not _recu_pase:
		var cita_c: Vector2 = Recupera.cita(_ball_field, _ball_vel, _recu_pos,
			maxf(float(_recu_car_spd) * 0.87, 3.0))
		var outc: Array = Duel.step_defender(_recu_pos, _recu_vel, cita_c,
			maxf(float(_recu_car_spd) * 0.87, 3.0), delta, 6.0)
		_recu_pos = _recu_corral(outc[0])
		_recu_vel = outc[1]
		_recu_actor.position = Vector3(_recu_pos.x, _recu_actor.position.y,
			_recu_pos.y)
		if (_recu_vel as Vector2).length() > 0.1:
			_recu_actor.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
			_play_run(_recu_actor, Vector3(_recu_vel.x, 0.0, _recu_vel.y))
		_chase_vels[_recu_actor] = _recu_vel




	_relax_chasers()
	_recu_carga_yo()


	if is_instance_valid(_recu_actor):
		_recu_pos = _recu_corral(Vector2(_recu_actor.position.x, _recu_actor.position.z))
	if is_instance_valid(_self_actor):
		_recu_yo = _recu_corral(Vector2(_self_actor.position.x, _self_actor.position.z))
	for i in _recu_def_pos.size():
		var da: AnimatedSprite3D = _recu_def_act[i]
		if is_instance_valid(da):
			_recu_def_pos[i] = _recu_corral(Vector2(da.position.x, da.position.z))
	for i in _recu_ap_pos.size():
		var ap2: AnimatedSprite3D = _recu_apoyos[i] if i < _recu_apoyos.size() else null
		if is_instance_valid(ap2):
			_recu_ap_pos[i] = _recu_corral(Vector2(ap2.position.x, ap2.position.z))


func _recu_choque() -> void:
	_relax_chasers()
	_recu_carga_yo()
	if is_instance_valid(_recu_actor):
		_recu_pos = _recu_corral(
			Vector2(_recu_actor.position.x, _recu_actor.position.z))


		var pie: Vector2 = _recu_vel.normalized() if _recu_vel.length() > 0.2 \
				else Vector2(0.0, Recupera.DIR)


		_ball_field = _recu_pos + pie *(Duel.BALL_FOOT + _recu_lead)
		_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)
	if is_instance_valid(_self_actor):
		_recu_yo = _recu_corral(
			Vector2(_self_actor.position.x, _self_actor.position.z))
	for i in _recu_def_pos.size():
		var a: AnimatedSprite3D = _recu_def_act[i]
		if is_instance_valid(a):
			_recu_def_pos[i] = _recu_corral(Vector2(a.position.x, a.position.z))




	for i in _recu_ap_pos.size():
		var ap: AnimatedSprite3D = _recu_apoyos[i] if i < _recu_apoyos.size() else null
		if is_instance_valid(ap):
			var np: Vector2 = _recu_corral(Vector2(ap.position.x, ap.position.z))
			if np.distance_to(_recu_ap_pos[i]) > 0.05:
				_recu_choque_mueve += 1
			_recu_ap_pos[i] = np



func _recu_puebla_apoyos() -> void:
	_recu_ap_pos = []
	_recu_ap_vel = []
	_recu_ap_spd = []
	_recu_ap_k = []
	_recu_ap_meta = []
	_recu_ap_rol = []
	_recu_ap_t = []
	var q_club: float = clampf(
		(float(GameState.current_rival().get("rating", 62)) - 40.0) / 45.0, 0.0, 1.0)
	for i in _recu_apoyos.size():
		var a: AnimatedSprite3D = _recu_apoyos[i]
		var rp: Dictionary = a.get_meta("player", {}) if a.has_meta("player") else {}
		_recu_ap_pos.append(Vector2(a.position.x, a.position.z))
		_recu_ap_vel.append(Vector2.ZERO)
		_recu_ap_spd.append(_pace_for(DUEL_CHASE_SPD.x, DUEL_CHASE_SPD.y,
			Duel.spread(Squad.norm(rp, "velocidad")) if not rp.is_empty() else q_club))
		_recu_ap_k.append(_npc_accel_k(rp))
		_recu_ap_meta.append(Vector2(a.position.x, a.position.z))
		_recu_ap_rol.append(Recupera.OFR_PIE)


		_recu_ap_t.append(Recupera.OFR_T * float(i) / maxf(float(_recu_apoyos.size()), 1.0))
	_recu_ap_rol = Recupera.reparte_apoyos(_recu_ap_pos, _ball_field)











func _recu_apoyo_step(delta: float) -> void:
	if _recu_ap_pos.is_empty():
		return
	for i in _recu_ap_pos.size():
		_recu_ap_t[i] = float(_recu_ap_t[i]) - delta
		if float(_recu_ap_t[i]) <= 0.0:
			_recu_ap_t[i] = Recupera.OFR_T
			var o: Array = Recupera.ofrece(i, _recu_ap_pos[i], _ball_field,
				Recupera.TARGET_Z, _recu_defs, _recu_linea_fdj(),
				_recu_ap_pos, _recu_ap_meta, int(_recu_ap_rol[i]))
			_recu_ap_rol[i] = int(o[0])
			_recu_ap_meta[i] = o[1]



		var spd: float = float(_recu_ap_spd[i]) \
				*(Duel.MATE_BURST_F if int(_recu_ap_rol[i]) == Recupera.OFR_RUPTURA
				else Duel.MATE_DRIFT_F)








		var voy: bool = _recu_pase and i == _recu_pase_a
		if _recu_suelta and not _recu_pase:
			voy = i == Recupera.corta(_ball_field, _recu_ap_pos, 1000000000.0)
		if voy:
			spd = float(_recu_ap_spd[i])
			_recu_ap_meta[i] = Recupera.cita(_ball_field, _ball_vel, _recu_ap_pos[i], spd)
		var antes: Vector2 = _recu_ap_pos[i]
		var out: Array = Duel.step_defender(antes, _recu_ap_vel[i],
			_recu_ap_meta[i], spd, delta, float(_recu_ap_k[i]))



		if not voy:
			var falta: Vector2 =(_recu_ap_meta[i] as Vector2) - antes
			var carrera: float = minf(spd,
				maxf(falta.length() - RECU_LLEGADA_M, 0.0) * RECU_LLEGADA_K)
			var llegada: Vector2 =(_recu_ap_vel[i] as Vector2).move_toward(
				falta.normalized() * carrera, float(_recu_ap_k[i]) * spd * delta)
			out = [antes + llegada * delta, llegada]
		_recu_ap_pos[i] = _recu_corral(out[0])
		_recu_ap_vel[i] =((_recu_ap_pos[i] as Vector2) - antes) / maxf(delta, 0.0001)
		var a: AnimatedSprite3D = _recu_apoyos[i]
		if is_instance_valid(a):
			var p: Vector2 = _recu_ap_pos[i]
			a.position = Vector3(p.x, a.position.y, p.y)
			var v: Vector2 = _recu_ap_vel[i]
			if v.length() > 0.1:
				a.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
				_play_run(a, Vector3(v.x, 0.0, v.y))
			else:
				_face_ball(a)
			_chase_vels[a] = v




func _recu_pasa(i: int) -> void:
	if i < 0 or i >= _recu_ap_pos.size() or _recu_over or _recu_tiro:
		return
	_recu_pase = true
	_recu_pase_a = i
	_recu_suelta = false








	var av: Vector2 = _recu_ap_vel[i] if i < _recu_ap_vel.size() else Vector2.ZERO



	var pt: float = 0.5
	if is_instance_valid(_recu_actor) and _recu_actor.has_meta("player"):
		pt = Squad.norm(_recu_actor.get_meta("player", {}), "punteria")
	_ball_vel = Recupera.pase_vel(_ball_field, Recupera.pase_con_error(_ball_field,
		Recupera.pase_destino(_recu_ap_pos[i], av, _ball_field), randf(),
		Recupera.presionado(_ball_field, _recu_defs), pt))
	_recu_pase_desde = _ball_field
	_recu_ultimo_toque = -1

	var lado: float = -1.0 if (_recu_ap_pos[i] as Vector2).x >= _recu_pos.x else 1.0
	_recu_pasador_meta = _recu_corral(_recu_pos + Vector2(lado * 4.0, 4.0))
	_recu_pasador_meta.y = minf(_recu_pasador_meta.y,
		_recu_linea_fdj() - Recupera.OFFSIDE_HOLGURA)
	_recu_vel *= 0.55
	if is_instance_valid(_recu_actor):
		_play_dir_gesture(_recu_actor, "kick",
			_ball_vel.normalized(), ZANCADA_HOLD_MS)
	_audio.kick()











func _recu_bola_step(delta: float) -> void:



	var bola_antes: Vector2 = _ball_field
	var rod: Array = Recupera.rueda_golpe(_ball_field, _ball_vel, delta)
	_ball_field = rod[0]
	_ball_vel = rod[1]











	var cruza: bool = bola_antes.y < Recupera.TARGET_Z \
			and _ball_field.y >= Recupera.TARGET_Z
	if _recu_red_contiene() and cruza and Recupera.es_gol(_ball_field.x):
		_recu_gol_canta()
		_recu_finish("gol")
		return


	var dentro: Vector2 = _recu_corral(_ball_field)
	if not dentro.is_equal_approx(_ball_field):
		_ball_field = dentro
		_ball_vel *= 0.25
	_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)
	_ball_roll(_ball_vel)







	if is_instance_valid(_recu_actor) and _recu_rival_suelo <= 0.0 \
			and _recu_vel.length() < 0.1 \
			and String(_recu_actor.animation).begins_with("run"):
		_face_ball(_recu_actor)








	if _ball_vel.length() > 0.6 \
			and _ball_field.distance_to(_recu_pase_desde) < Recupera.PASE_SALE_D:
		return


	if _recu_yo_barr <= 0.0 and _recu_yo_suelo <= 0.0 \
			and _recu_yo.distance_to(_ball_field) < Duel.TOQUE_R + 0.25:
		_recu_gira_ataque()
		return




	var r: int = Recupera.corta(_ball_field, _recu_ap_pos, Duel.TOQUE_R + 0.35,
		bola_antes)
	if r >= 0 and r != _recu_ultimo_toque:
		_recu_toma_balon(r)
		return






	if _recu_suelta and not _recu_pase \
			and _recu_rival_suelo <= 0.0 and is_instance_valid(_recu_actor) \
			and _recu_pos.distance_to(_ball_field) < Duel.TOQUE_R + 0.35:
		_recu_pase = false
		_recu_suelta = false
		_recu_vel = Vector2.ZERO




		_recu_arranca_t = Recupera.ARRANCA_T * 0.55



		_recu_cerca_prev = INF
		_haptic(8)
		_audio.kick()
		return









	var c: int = _recu_def_corta(bola_antes, Recupera.PASE_CORTE_R_DEF)
	if c >= 0:






		if _recu_barrida_buena_t > 0.0:
			_recu_pase = false
			_recu_suelta = true







			if _recu_mando_puede(c):
				_ball_vel = Vector2.ZERO
				_recu_toma_mando(c)
			else:
				_ball_vel = Recupera.pase_vel(_ball_field, _recu_yo)
			_recu_pase_desde = _ball_field
			_recu_ultimo_toque = -1
			_haptic(10)
			_audio.kick()
			return
		_recu_pase = false
		_recu_suelta = true
		_ball_vel = Recupera.rebote(_ball_vel, _recu_def_pos[c], _ball_field)


		_recu_pase_desde = _ball_field
		_recu_ultimo_toque = -1
		_haptic(12)
		_audio.kick()
		return





	if _ball_vel.length() < 1.2:
		var mio: int = _recu_def_corta(_ball_field, Duel.TOQUE_R + 0.35, true)




		if mio >= 0 and _recu_rival_suelo <= 0.0 \
				and _recu_pos.distance_to(_ball_field) < Duel.TOQUE_R + 0.8:
			mio = -1
		if mio >= 0 \
				and Recupera.corta(_ball_field, _recu_ap_pos, Duel.TOQUE_R + 0.8) >= 0:
			mio = -1
		if mio >= 0:
			_recu_pase = false
			_recu_suelta = true






			if _recu_mando_puede(mio):
				_ball_vel = Vector2.ZERO
				_recu_toma_mando(mio)
			else:
				_ball_vel = Recupera.pase_vel(_ball_field, _recu_yo)
			_recu_pase_desde = _ball_field
			_recu_ultimo_toque = -1
			_haptic(10)
			_audio.kick()
			return






	if _ball_vel.length() < 1.2 and is_instance_valid(_keeper) \
			and Vector2(_keeper.position.x, _keeper.position.z) \
			.distance_to(_ball_field) < _keeper_reach_r():
		_recu_portero_devuelve()
		return


	if _ball_vel.length() < 0.35 and not _recu_suelta:
		_recu_pase = false
		_recu_suelta = true





func _recu_def_corta(antes: Vector2, radio: float, de_pie: bool = false) -> int:
	var disponibles: Array = []
	var indices: Array[int] = []
	for i in _recu_def_pos.size():
		if float(_recu_def_suelo[i]) > 0.0:
			continue
		if de_pie and float(_recu_def_barr[i]) > 0.0:
			continue
		disponibles.append(_recu_def_pos[i])
		indices.append(i)
	var corte: int = Recupera.corta(_ball_field, disponibles, radio, antes)
	return indices[corte] if corte >= 0 else -1







func _recu_prepara_contactos() -> void:
	if not _recu or _recu_over or _recu_tiro:
		return
	var cercanos: Array[int] = []
	for i in _recu_def_pos.size():
		if float(_recu_def_suelo[i]) <= 0.0 \
				and (_recu_def_pos[i] as Vector2).distance_to(_ball_field) < 14.0:
			cercanos.append(i)
	cercanos.sort_custom(func(a: int, b: int) -> bool:
		var a_presiona: bool = int(_recu_def_rol[a]) == Recupera.ROL_PRESOR
		var b_presiona: bool = int(_recu_def_rol[b]) == Recupera.ROL_PRESOR
		if a_presiona != b_presiona:
			return a_presiona
		return (_recu_def_pos[a] as Vector2).distance_squared_to(_ball_field) \
				<(_recu_def_pos[b] as Vector2).distance_squared_to(_ball_field))
	var pedidos: Array = []
	for i in cercanos.slice(0, 2):
		pedidos.append([_recu_def_act[i], "slide",
			_ball_field + _ball_vel * Recupera.BARRIDA_LEAD_T - _recu_def_pos[i]])
	pedidos.append([_recu_actor, "fall",
		_recu_vel if _recu_vel.length() > 0.5 else Vector2(0.0, Recupera.DIR)])
	pedidos.append([_self_actor, "slide",
		_duel_steer if _duel_steer.length() > 0.1 else _ball_field - _recu_yo])


	for angulo in [0.0, - PI / 2.0, PI / 2.0, PI]:
		for pedido in pedidos:
			var hacia: Vector2 = pedido[2]
			if hacia.length_squared() < 0.0001:
				hacia = Vector2(0.0, Recupera.DIR)
			hacia = hacia.rotated(angulo)
			_queue_anim_prioritaria(pedido[0], "%s_%s" % [pedido[1],
				_dir_name(Vector3(hacia.x, 0.0, hacia.y))])





