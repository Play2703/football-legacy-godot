func _refs_step(delta: float) -> void:




	_ref_card_follow()




	_ref_flags_follow()


	if _entrada_on:
		return
	var vivos: Array = _refs_vivos()
	if vivos.is_empty():
		return











	if _spray_fase == Spray.LISTO and state == State.AIMING and not _spray_corre:
		_spray_abandona()
	var spray_suyo: bool = _spray_fase != Spray.NADA and is_instance_valid(_ref_center)
	var spray_anda: bool = spray_suyo and _spray_fase != Spray.LISTO
	if spray_anda:
		_spray_paso(delta)
	var reloj: bool = not (state == State.SETUP or state == State.AIMING) \
			or _drive_active or _drive_coast
	if _open_shot_aim or not reloj:
		for r in vivos:


			if _anim_lock.get(r, 0) > Time.get_ticks_msec():
				continue


			if spray_anda and r == _ref_center:
				continue
			_face_ball(r)
		return
	var ball: Vector2 = Vector2(_ball.position.x, _ball.position.z)






	_ref_foco = Arbitros.foco(_ref_foco, ball, delta)
	var foco: Vector2 = _ref_foco






	var line_def: float = _last_defender_z()
	for i in _ref_assist.size():
		var a: AnimatedSprite3D = _ref_assist[i]
		if not is_instance_valid(a):
			continue
		var side: float = 1.0 if i == 0 else -1.0
		_ref_move(a, Arbitros.sitio_asistente(side, foco, line_def,
			Stadium.FIELD_HALF_W, Stadium.FIELD_DEPTH),
			Arbitros.ASSIST_SPEED, delta)
	if is_instance_valid(_ref_center) and not spray_suyo:
		_ref_side = Arbitros.lado_central(foco.x, _ref_side)
		_ref_move(_ref_center, Arbitros.sitio_central(foco, _ref_side,
			Stadium.FIELD_HALF_W, Stadium.FIELD_DEPTH),
			Arbitros.CENTER_SPEED, delta)




func _ref_move(a: AnimatedSprite3D, to: Vector2, speed: float,
		delta: float) -> void:




	if a == _ref_who and _ref_ix >= 0 and not _ref_done:
		_face_ball(a)
		return



	if _anim_lock.get(a, 0) > Time.get_ticks_msec():
		return


	var esq: Variant = _ref_dodge.get(a)
	if esq is Vector2:
		to = esq
		speed = Arbitros.DODGE_SPEED
	var from: Vector2 = Vector2(a.position.x, a.position.z)




	var out: Array = Arbitros.paso_acel(from, to,
		float(_ref_vel.get(a, 0.0)), speed, delta)
	var next: Vector2 = out[0]
	_ref_vel[a] = out[1]
	a.position.x = next.x
	a.position.z = next.y











	if from.distance_to(next) < LOCO_MIN_SPD * delta:
		_face_ball(a)

		if esq is Vector2:
			_ref_dodge.erase(a)
































const SprayBoteScr = preload("res://features/match/spray_bote.gd")


const SPRAY_PIE_M: float = 0.35


const SPRAY_MARGEN_M: float = 0.6


const SPRAY_LADO_M: float = 0.45


const SPRAY_ANTES_M: float = 0.5

const SPRAY_DELANTE_M: float = 0.25


const SPRAY_PASO: float = 1.7
const SPRAY_TROTE: float = 3.6

const SPRAY_PRISA: float = 6.0

const SPRAY_LIBRE_M: float = 0.5

const SPRAY_MIN_M: float = 1.0



const SPRAY_HUECO_M: float = 1.5
const SPRAY_HUECO_MAX_M: float = 5.0


const SPRAY_RESPIRO_S: float = 0.45


const SPRAY_SORDO_S: float = 0.25


const SPRAY_TOPE_S: float = 9.0






func _spray_toca(chance: Dictionary) -> bool:
	if int(chance.get("wall_count", 0)) <= 0 or not is_instance_valid(_ref_center):
		return false
	if _force_spray:
		return true
	return _practice_kind.is_empty() and not _tutorial_active \
			and not _shootout_active and not GameState.readonly_save





func _spray_monta(chance: Dictionary) -> void:
	_spray_gen += 1
	_spray_suelta()
	if not _spray_toca(chance):
		return
	var plan: Dictionary = _spray_traza()
	if plan.is_empty():
		return

	plan["casa"] = Vector2(_ref_center.position.x, _ref_center.position.z)
	_spray_plan = plan
	_spray_fase = Spray.LISTO
	var ini: Vector2 = plan["ini"]
	_ref_center.position.x = ini.x
	_ref_center.position.z = ini.y
	_ref_vel[_ref_center] = 0.0
	_face_ball(_ref_center)





func _spray_suelta() -> void:
	if _fx != null:
		if _spray_linea >= 0 and _spray_frac > 0.0:
			_fx.spray_tramo(_spray_linea, 1.0)
		_fx.spray_niebla(Vector3.ZERO, Vector3.ZERO, false)
	_spray_bote_fuera()
	_spray_fase = Spray.NADA
	_spray_plan = {}
	_spray_linea = -1
	_spray_frac = 0.0
	_spray_corre = false





func _spray_abandona() -> void:
	var casa: Variant = _spray_plan.get("casa")
	_spray_suelta()
	if casa is Vector2 and is_instance_valid(_ref_center):
		_ref_center.position.x = casa.x
		_ref_center.position.z = casa.y
		_ref_vel[_ref_center] = 0.0
		_face_ball(_ref_center)







func _spray_traza() -> Dictionary:
	var ball: Vector2 = _ball_field
	var muro: Array[Vector2] = []
	for r in _rival_actors:
		if is_instance_valid(r) and r.has_meta("hold_wall"):
			muro.append(Vector2(r.position.x, r.position.z))
	if muro.is_empty() or not is_instance_valid(_ref_center):
		return {}
	var centro: Vector2 = Vector2.ZERO
	for p in muro:
		centro += p
	centro /= float(muro.size())
	if centro.distance_to(ball) < 2.0:
		return {}
	var d: Vector2 =(centro - ball).normalized()
	var n: Vector2 = Vector2(- d.y, d.x)
	var hondo: float = INF
	var lat_min: float = INF
	var lat_max: float = - INF
	for p in muro:
		var rel: Vector2 = p - ball
		hondo = minf(hondo, rel.dot(d))
		lat_min = minf(lat_min, rel.dot(n))
		lat_max = maxf(lat_max, rel.dot(n))
	var base: Vector2 = ball + d *(hondo - SPRAY_PIE_M)
	var p0: Vector2 = base + n *(lat_min - SPRAY_MARGEN_M)
	var p1: Vector2 = base + n *(lat_max + SPRAY_MARGEN_M)
	var lim_x: float = Stadium.FIELD_HALF_W - 0.3
	if absf(p0.x) > lim_x or absf(p1.x) > lim_x or p0.y < 0.25 or p1.y < 0.25 \
			or p0.distance_to(p1) < SPRAY_MIN_M:
		return {}



	var mio: float =(Vector2(_ref_center.position.x, _ref_center.position.z)
		- ball).dot(n)
	for intento in 2:
		var hacia_p1: bool =(mio >= 0.0) ==(intento == 0)
		var a: Vector2 = p0 if hacia_p1 else p1
		var b: Vector2 = p1 if hacia_p1 else p0
		var plan: Dictionary = _spray_camino(ball, a, b, d)
		if not plan.is_empty():
			return plan
	return {}











func _spray_camino(ball: Vector2, a: Vector2, b: Vector2, d: Vector2) -> Dictionary:
	var u: Vector2 =(b - a).normalized()
	var lado: Vector2 = - d * SPRAY_LADO_M
	var ini: Vector2 = a - u * SPRAY_ANTES_M + lado
	var libre: float = Arbitros.LANE_M + SPRAY_LIBRE_M
	var k: float = 0.0
	while Arbitros.dist_pasillo(b + lado + u * k, ball) < libre and k < 16.0:
		k += 0.25
	var fin: Vector2 = b + lado + u * k
	if Arbitros.dist_pasillo(fin, ball) < libre:
		return {}
	if not _spray_en_campo(ini) or not _spray_en_campo(fin):
		return {}
	var extra: float = 0.0
	while extra < SPRAY_HUECO_MAX_M:
		extra += 0.25
		var otro: Vector2 = b + lado + u *(k + extra)
		if not _spray_en_campo(otro):
			break
		if not _spray_ocupado(fin):
			break
		fin = otro
	if _spray_ocupado(fin):
		fin = b + lado + u * k
	return {"a": a, "b": b, "u": u, "largo": a.distance_to(b), "ini": ini, "fin": fin}



func _spray_ocupado(p: Vector2) -> bool:
	for a in _actors.get_children():
		if a == _ref_center or not (a is AnimatedSprite3D) or not a.visible:
			continue
		if Vector2(a.position.x, a.position.z).distance_to(p) < SPRAY_HUECO_M:
			return true
	return false




func _spray_en_campo(p: Vector2) -> bool:
	return absf(p.x) <= Stadium.FIELD_HALF_W - Arbitros.EDGE_M \
			and p.y >= Arbitros.CENTER_Z_MIN and p.y <= Stadium.FIELD_DEPTH - Arbitros.EDGE_M





func _play_spray() -> void:
	if _spray_fase != Spray.LISTO or not is_instance_valid(_ref_center) or _fx == null:
		_spray_suelta()
		return
	var gen: int = _spray_gen
	var antes: State = state
	state = State.SETUP
	_spray_corre = true
	_spray_salta = false
	_spray_t = 0.0
	_spray_frac = 0.0
	var a: Vector2 = _spray_plan["a"]
	var b: Vector2 = _spray_plan["b"]
	_spray_linea = _fx.spray_nueva(Vector3(a.x, 0.0, a.y), Vector3(b.x, 0.0, b.y))
	_spray_fase = Spray.MARCA
	while true:
		await get_tree().process_frame
		if not is_inside_tree():
			return

		if gen != _spray_gen:
			break
		if _spray_fase == Spray.NADA or state == State.ENDED or _spray_t >= SPRAY_TOPE_S:
			break
	_spray_corre = false
	if gen == _spray_gen:
		_spray_cierra()
	if state == State.SETUP:
		state = antes







func _spray_cierra() -> void:
	if _fx != null:
		if _spray_linea >= 0:
			_fx.spray_tramo(_spray_linea, 1.0)
		_fx.spray_niebla(Vector3.ZERO, Vector3.ZERO, false)
	_spray_bote_fuera()
	if is_instance_valid(_ref_center) and not _spray_plan.is_empty():
		var p: Vector2 = Vector2(_ref_center.position.x, _ref_center.position.z)
		if Arbitros.dist_pasillo(p, _ball_field) < Arbitros.LANE_M:
			var fin: Vector2 = _spray_plan["fin"]
			_ref_center.position.x = fin.x
			_ref_center.position.z = fin.y
		_ref_vel[_ref_center] = 0.0
		_face_ball(_ref_center)
	_spray_fase = Spray.NADA
	_spray_plan = {}
	_spray_linea = -1






func _spray_paso(delta: float) -> void:
	_spray_t += delta
	if _spray_plan.is_empty():
		_spray_fase = Spray.NADA
		return
	var r: AnimatedSprite3D = _ref_center
	var u: Vector2 = _spray_plan["u"]
	if _spray_fase == Spray.MARCA:
		_spray_bote_sigue(u)
		if _spray_t < SPRAY_RESPIRO_S:
			return
	var fin: Vector2 = _spray_plan["fin"]
	var rapidez: float = SPRAY_PASO
	if _spray_fase == Spray.SALE:
		rapidez = SPRAY_PRISA if _spray_salta else SPRAY_TROTE
	_ref_move(r, fin, rapidez, delta)
	var p: Vector2 = Vector2(r.position.x, r.position.z)
	if _spray_fase == Spray.MARCA:
		var a: Vector2 = _spray_plan["a"]
		var largo: float = _spray_plan["largo"]
		var s: float =(p - a).dot(u) + SPRAY_DELANTE_M
		_spray_frac = maxf(_spray_frac, clampf(s / largo, 0.0, 1.0))
		_fx.spray_tramo(_spray_linea, _spray_frac)
		var punta: Vector2 = a + u *(largo * _spray_frac)
		var boquilla: Vector3 = _spray_bote_sigue(u)
		_fx.spray_niebla(boquilla, Vector3(punta.x, MatchFx.SPRAY_Y, punta.y),
			_spray_frac > 0.0 and _spray_frac < 1.0)
		if _spray_frac >= 1.0:
			_spray_fase = Spray.SALE
			_fx.spray_niebla(Vector3.ZERO, Vector3.ZERO, false)
			_spray_bote_fuera()
	elif p.distance_to(fin) <= Arbitros.ARRIVE_M:
		_spray_fase = Spray.NADA






func _spray_bote_sigue(u: Vector2) -> Vector3:
	var r: AnimatedSprite3D = _ref_center
	if not is_instance_valid(_spray_bote):
		_spray_bote = SprayBoteScr.nodo(r.pixel_size)
		_actors.add_child(_spray_bote)
	var cam: Camera3D = SceneFade.camara_de(self)
	var right: Vector3 = Vector3.RIGHT if cam == null \
			else cam.global_transform.basis.x
	right.y = 0.0
	if right.length_squared() < 0.0001:
		right = Vector3.RIGHT
	right = right.normalized()
	var lado: float = signf(Vector3(u.x, 0.0, u.y).dot(right))
	if is_zero_approx(lado):
		lado = 1.0
	var off: Vector2 = SprayBoteScr.mano_offset(r.pixel_size, lado)
	var hacia: Vector3 = Vector3.ZERO if cam == null \
			else (cam.global_position - r.global_position).normalized()
	_spray_bote.global_position = r.global_position + right * off.x \
			+ Vector3(0.0, off.y, 0.0) + hacia * 0.05
	_spray_bote.visible = r.visible
	return _spray_bote.global_position \
			+ Vector3(0.0, SprayBoteScr.boquilla_dy(r.pixel_size), 0.0)



func _spray_bote_fuera() -> void:
	if is_instance_valid(_spray_bote):
		_spray_bote.visible = false





func _spray_input(event: InputEvent) -> void:
	if _spray_salta or _spray_t < SPRAY_SORDO_S:
		return
	if not (event is InputEventScreenTouch and event.pressed):
		return
	_spray_salta = true
	if _spray_fase == Spray.MARCA:
		_spray_frac = 1.0
		if _fx != null:
			_fx.spray_tramo(_spray_linea, 1.0)
			_fx.spray_niebla(Vector3.ZERO, Vector3.ZERO, false)
		_spray_bote_fuera()
		_spray_fase = Spray.SALE
























func _scan_refs(a: Vector3, b: Vector3, vel: Vector3) -> bool:
	var t: float = float(_traj.size()) * SIM_DT
	if t > Arbitros.DODGE_HORIZON_S:


		_ref_scan.clear()
		return false
	if minf(a.y, b.y) > Arbitros.HIT_H:
		return false
	var spd: float = Vector2(vel.x, vel.z).length()
	var pegó: bool = false
	for i in range(_ref_scan.size() - 1, -1, -1):
		var r: AnimatedSprite3D = SceneFade.vivo(_ref_scan[i]) as AnimatedSprite3D
		if not is_instance_valid(r):
			_ref_scan.remove_at(i)
			continue
		var p: Vector2 = Vector2(r.position.x, r.position.z)
		if not Arbitros.atropella(p, a, b):
			continue
		_ref_scan.remove_at(i)



		if t >= Arbitros.REACT_S + Arbitros.DODGE_M / Arbitros.DODGE_SPEED \
				or spd < Arbitros.KNOCK_SPEED:
			_ref_dodge[r] = Arbitros.sitio_esquiva(p,
				Vector2(a.x, a.z), Vector2(b.x, b.z))
			continue


		if _ref_ix < 0:
			_ref_ix = _traj.size()
			_ref_who = r
			_ref_from = a
			pegó = true
	return pegó




