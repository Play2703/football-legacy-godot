func _sub_last_name(full: String) -> String:
	var parts: PackedStringArray = full.strip_edges().split(" ", false)
	if parts.is_empty():
		return full
	var last: String = String(parts[parts.size() - 1])
	if parts.size() >= 2 and parts[parts.size() - 2].to_lower() in \
			["de", "del", "la", "van", "der", "di", "dos", "da", "el", "le"]:
		last = String(parts[parts.size() - 2]) + " " + last
	return last






func _sub_out_mate() -> Dictionary:

	var squad: Array = _squad_hoy(_my_side_id())
	var field: Array = []



	var yo: int = Squad.user_index(squad)
	for i in mini(Squad.STARTING_XI, squad.size()):
		var row: Dictionary = squad[i]
		if String(row.get("pos", "")) == "POR":
			continue


		if MatchSim.esta_fuera(true, String(row.get("name", ""))):
			continue










		if i == yo:
			continue
		field.append(row)
	if field.is_empty():
		return {}
	return field[match_minute % field.size()]










func _sub_in_mate() -> Dictionary:




	var squad: Array = _squad_hoy(_my_side_id())
	var fuera: Dictionary = _salieron.get(_my_side_id(), {})
	var bench: Array = []
	for i in range(Squad.STARTING_XI, mini(Squad.STARTING_XI + Squad.BENCH_SIZE,
			squad.size())):
		var row: Dictionary = squad[i]
		if String(row.get("pos", "")) != "POR" and not fuera.has(String(row.get("name", ""))):
			bench.append(row)
	if bench.is_empty():
		return _sub_out_mate()
	return bench[match_minute % bench.size()]













func _sub_play(actor: AnimatedSprite3D, anim: String, fallback: String) -> void:
	if actor == null:
