func _tutorial_gate() -> bool:
	_tutorial_gate_busy = true
	var sigue: bool = await _tutorial_gate_inner()
	_tutorial_gate_busy = false
	return sigue




func _tutorial_gate_inner() -> bool:

	if not _tutorial_started:
		_tutorial_started = true
		await _tutorial_panel(_tutorial_i, -1)
		return true



	if _tutorial_pide_sigues:
		if not await _tutorial_sigues():
			return false
	var paso: String = Tutorial.next_step(_tutorial_i, _tutorial_j, _tutorial_goals,
		_tutorial_tries)





	if paso.begins_with("retry") and not _tutorial_con_dedos():
		paso = "next_seg" if paso == "retry_seg" \
				and _tutorial_j + 1 < Tutorial.segments(_tutorial_i).size() \
				else "drill_done"
	match paso:
		"attempt":
			return true
		"next_seg":
			_tutorial_j += 1
			_practice_kind = String(Tutorial.seg(_tutorial_i, _tutorial_j)["kind"])



			await _tutorial_seg_tip(_practice_kind)
			return true
		"retry_seg":


			await _tutorial_otra_vez(_tutorial_j)
			return true
		"retry":



			await _tutorial_otra_vez(Tutorial.retry_seg(_tutorial_i))
			return true
		_:
			_tutorial_stars.append(Tutorial.stars(_tutorial_i, _tutorial_goals,
				_tutorial_tries, _tutorial_clears, _tutorial_rondas))




			Telemetry.count("academia_d%d" %(_tutorial_i + 1))
			if _tutorial_i + 1 < Tutorial.count():
				var prev_s: int = int(_tutorial_stars.back())
				_tutorial_i += 1
				_tutorial_reset_drill()
				_practice_kind = String(Tutorial.seg(_tutorial_i, 0)["kind"])



				await _tutorial_verdict_overlay(_tutorial_i - 1, prev_s)


				if await _tutorial_panel(_tutorial_i, prev_s):
					_tutorial_rewind()
				return true
			await _tutorial_results()
			_tutorial_store(true)



			SceneFade.to_scene("res://ui/academy_offers.tscn")
			return false




func _tutorial_marca_primer_gol() -> void:
	if _tutorial_gol_visto:
		return
	_tutorial_gol_visto = true
	_tutorial_pide_sigues = true
	Telemetry.count("academia_gol")






