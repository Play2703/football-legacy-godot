func _saque_input(event: InputEvent) -> void:
	if event is InputEventScreenTouch:
		if event.pressed and _saque_dedo == -1:
			_saque_dedo = event.index
			_saque_dedo_pos = event.position
			_drive_steer = Vector2.ZERO
		elif not event.pressed and event.index == _saque_dedo:
			_saque_dedo = -1
			_drive_steer = Vector2.ZERO
	elif event is InputEventScreenDrag and event.index == _saque_dedo:
		_saque_dedo_pos = event.position
		_update_drive_steer(event.position)





