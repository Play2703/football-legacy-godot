func _pedido_generado(chance: Dictionary) -> bool:
	var kind: String = String(chance.get("kind", ""))
	if kind != "penal" and kind != "libre":
		return false
	if not _practice_kind.is_empty() or _tutorial_active or _shootout_active \
			or GameState.readonly_save:
		return false
	if kind == "libre" and _in_penalty_box(chance.get("ball", Vector2.ZERO)):
		return false
	if not MatchPlan.puede_evaporar_ocasion(_chances_reales,
			_chance_minutes.size() - chance_index):
		return false
	return not _pedido_lanzador(kind == "penal").is_empty()















func _parado_del_partido(chance: Dictionary) -> bool:
	var pedido: bool = bool(chance.get("pedido", false))
	var penal: bool = String(chance.get("kind", "")) == "penal"
	if not pedido and not penal:
		return false
	var antes: int = state
	state = State.AIMING
	var cerrada: bool = false


	if pedido and penal and _penal_del_doblete():
		_regalo_penal = true
		await _regalo_penal_escena()
	elif MatchPlan.puede_evaporar_ocasion(_chances_reales,
			_chance_minutes.size() - chance_index):


		_cedida_ajena = true
		if pedido:
			var ficha: Dictionary = _pedido_ficha(penal)
			if not ficha.is_empty():
				cerrada = not await _pedido_escena({"penal": penal, "ficha": ficha}, chance)
		elif _cesion_pendiente(chance):
			cerrada = await _cesion_penal()

	_pedido_destapa()
	if cerrada or state == State.ENDED:
		return true
	_cedida_ajena = false
	state = antes
	return false











