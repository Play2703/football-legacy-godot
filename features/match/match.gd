func _feed_aim_launch() -> void:
	var pm: float = _ctrl_power_mult()




	if _cross_mode:
		_aim.set_launch(SHOT_BASE_SPEED * SHOT_POWER * pm * CROSS_POWER_MULT,
			SHOT_SPAN_SPEED * SHOT_POWER * pm * CROSS_POWER_MULT,
			_aim_guide_elev())
		return
	_aim.set_launch(SHOT_BASE_SPEED * SHOT_POWER * pm,
		SHOT_SPAN_SPEED * SHOT_POWER * pm, _aim_guide_elev())








func _aim_guide_elev() -> float:
	if _cross_mode:
		return deg_to_rad(CROSS_DEG_MID)
	return _flatten_by_leg(deg_to_rad(STRIKE_DEG_MID), 1.0, _ctrl_power_mult())








func _ring_floor(pull: Vector2, normal: float) -> float:
	if _ring_live_dir != Vector2.ZERO and pull.dot(_ring_live_dir) < 0.0:
		return RING_FLIP_PX
	return normal






func _ring_shows(pull: Vector2) -> bool:
	return pull.length() >= _ring_floor(pull, RING_LIVE_PX) * _pull_scale()






func _ring_dead(pull: Vector2, ratio: float) -> bool:
	if ratio < MIN_POWER_RATIO:
		return true
	if pull.length() < _ring_floor(pull, RING_DEAD_PX) * _pull_scale():
		return true






	return false





