func _play_dist(actor: AnimatedSprite3D) -> float:
	var d: float = _flat_dist(actor.position, _ball.position)
	var rest: Vector3 = _play_rest()
	if rest == Vector3.INF:
		return d
	return minf(d, _flat_dist(actor.position, rest))




func _play_rest() -> Vector3:
	if _traj.is_empty():
