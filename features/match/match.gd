			and int(Career.pending_hook_min) == HOOK_HALFTIME_MIN













func _half_time_ctx(extra: bool) -> Dictionary:
	var fx: Dictionary = GameState.current_fixture()
	var nat: bool = _nat_match()
	var ko: String = ""
	if GameState.fixture_is_knockout(fx):
		if GameState.knockout_level(fx, team_goals, rival_goals):
			ko = "igualada"
		elif GameState.knockout_lost(fx, team_goals, rival_goals):
			ko = "fuera"
		elif GameState.liguilla_sin_eliminacion(fx) and team_goals < rival_goals:



			ko = "otra"
		else:
			ko = "pasas"



	var portero: String = ""
	for p in _squad_hoy(_my_side_id()):
		var pn: String = String((p as Dictionary).get("name", ""))
		if String((p as Dictionary).get("pos", "")) == "POR" \
				and not pn.is_empty() and pn != Career.player_name:
			portero = pn
			break



	var en_campo: bool = _play_to <= _play_from \
			or (match_minute >= _play_from and match_minute < _play_to)
	var comp: String = String(fx.get("comp", "league"))
	return {
		"extra": extra,
		"on_pitch": en_campo and not _hooked and not _injured_out,
		"ko": ko,



		"ko_regla": GameState.tie_rule(fx),
		"ida": GameState.your_first_leg(fx),
		"round": String(fx.get("round", "")),
		"derby": _is_derby,
		"home": _home_match,
		"red_mine": _roja_mia,
		"red_rival": _roja_suya,
		"absent": String((_baja_ajena.get("you", {}) as Dictionary).get("fuera", "")),
		"last_goal_min": _ultimo_gol_min,
		"last_goal_mine": _ultimo_gol_mio,
		"max_deficit": _max_deficit,
		"max_lead": _max_lead,
		"keeper": portero,

		"goals": match_goals,
		"coach_char": Career.nat_coach_char if nat else Career.coach_char,
		"stake": GameState.league_stake() if comp == "league" and not nat else {},



		"weather": _stadium.weather_id(),
		"rain_tier": _stadium.rain_level() if _stadium.weather_id() == "rain" else -1,
	}





