func _duel_run_spd_norm() -> float:
	var rp: Dictionary = {}
	if is_instance_valid(_recu_actor) and _recu_actor.has_meta("player"):
		rp = _recu_actor.get_meta("player", {})
	if not rp.is_empty():
		return Duel.spread(Squad.norm(rp, "velocidad"))
	return clampf((float(GameState.current_rival().get("rating", 62)) - 40.0) / 45.0,
		0.0, 1.0)



func _lance_wants(i: int, a: AnimatedSprite3D, pace: float, defs: Array, vels: Array,
		lead: float) -> bool:


	if not Settings.dif_steal_on():
		return false

	if _saque_respiro_t > 0.0:
		return false
	if _lance_team_cd > 0.0:
		return false
	if not _lance_t.is_empty():
		for k in _lance_t.keys():
			if float(_lance_t[k]) > 0.0:
				return false
	if float(_lance_cd.get(i, 0.0)) > 0.0 or float(_lance_cool.get(i, 0.0)) > 0.0:
		return false
	if pace < LANCE_MIN_PACE or lead < LANCE_MIN_READ:
		return false
	var d: float =(defs[i] as Vector2).distance_to(_ball_field)


	if d > LANCE_TRIGGER_R or d < Duel.STEAL_R_MAX:
		return false


	var v: Vector2 = vels[i] if i < vels.size() else Vector2.ZERO
	return v.dot((_ball_field -(defs[i] as Vector2)).normalized()) > 0.5





func _lance_step(delta: float, defs: Array, vels: Array, actors: Array) -> Dictionary:
	var flying: Dictionary = {}
	_lance_team_cd = maxf(_lance_team_cd - delta, 0.0)
	for i in _lance_cool.keys():
		_lance_cool[i] = maxf(float(_lance_cool[i]) - delta, 0.0)
	for i in _lance_cd.keys():
		_lance_cd[i] = maxf(float(_lance_cd[i]) - delta, 0.0)
	for i in _lance_t.keys():
		var t: float = float(_lance_t[i]) - delta
		if t <= 0.0:




















			_lance_t.erase(i)
			_lance_cool[i] = LANCE_COOL
			_lance_cd[i] = LANCE_CD + LANCE_COOL
			continue
		_lance_t[i] = t
		if i >= defs.size() or i >= vels.size():
			continue
		var to: Vector2 = _lance_to.get(i, Vector2.INF)
		var from: Vector2 = _lance_from.get(i, Vector2.INF)
		if to == Vector2.INF or from == Vector2.INF:
			continue



		var u: float = clampf(1.0 - t / LANCE_T, 0.0, 1.0)
		var was: Vector2 = defs[i]
		defs[i] = _inside_field(from.lerp(to, u))




		vels[i] =(defs[i] - was) / maxf(delta, 0.0001)
		var a: AnimatedSprite3D = actors[i] if i < actors.size() else null
		if is_instance_valid(a):
			a.position = Vector3((defs[i] as Vector2).x, a.position.y,(defs[i] as Vector2).y)
		flying[i] = true
	return flying
































const CARGA_ANIM_HOLD: float = 0.18












const CARGA_ANIM_MAX: float = 1.6







const CARGA_ANIM_PACE_MIN: float = 0.9


const OPEN_CARGA_MULT: float = 1.65
const OPEN_CARGA_MAX_V: float = 3.1












func _carga_open(delta: float) -> bool:




	_bump_cd = maxf(_bump_cd - delta, 0.0)
	_carga_kick_want = Vector3.ZERO
	if not _drive_active or _drive_coast or _defender_pos.is_empty():
		return false
	for i in _defender_pos.size():
		if i >= _rival_actors.size() or i >= _press_vels.size():
			continue
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or a.has_meta("hold_wall"):
			continue
		var ahora: float = float(Time.get_ticks_msec()) / 1000.0
		var push: Vector2 = Duel.carga_push(_defender_pos[i], _press_vels[i],
			_drive_pos, _drive_vel, _rival_peso(a), _carry_fisico)
		if push == Vector2.ZERO:




			_carga_gesto_sostiene(a,
				_defender_pos[i].distance_to(_drive_pos)
					< Duel.CARGA_R * Crowding.CARGA_CONTACTO_K,
				(_press_vels[i] as Vector2).length(), ahora)
			continue




		_carga_gesto_arranca(a, ahora)


		push = push.limit_length(OPEN_CARGA_MAX_V / maxf(OPEN_CARGA_MULT, 0.01)) \
				* OPEN_CARGA_MULT


		if Duel.carga_es_falta(_defender_pos[i], _drive_pos, _drive_facing, push,
				Duel.carga_falta_min(_rival_lead(a)) * _carga_falta_k,
				_carga_espalda_cos):




			if _choque_lo_pierdes(i):
				_drive_stolen(i, true)
				return true


			_drive_carga_foul(i, Duel.carga_es_dura(_defender_pos[i], _drive_pos,
				_drive_facing, push))
			return true








		if _bump_cd <= 0.0:
			_bump_cd = BUMP_CARGA_CD
			_bump(BUMP_CARGA)
		var kick: Vector3 = _carga_cam_kick(push)
		if kick.length() > _carga_kick_want.length():
			_carga_kick_want = kick
		var desvio: Vector2 = Duel.carga_desvio(push, _drive_vel)
		_drive_pos = _inside_field(_drive_pos + desvio * delta)
		if _self_actor != null and is_instance_valid(_self_actor):
			_self_actor.position = Vector3(
				_drive_pos.x, _self_actor.position.y, _drive_pos.y)
	return false







func _drive_carga_foul(i: int, dura: bool = false) -> void:
	if i >= 0 and i < _rival_actors.size():
		_play_trip_gesture(_rival_actors[i], _drive_pos)
	_stop_drive()




	var rumbo_caida: Vector2 = _drive_facing
	_al_contacto(func() -> void:
		_play_self_fall(rumbo_caida, DUEL_FOUL_HOLD_MS)
		_audio.dolor(dura)
		_audio.voz_tras("protesta", 0.5))
	_al_contacto_siempre(_falta_golpe.bind(_in_penalty_box(_ball_field)))
	_momentum.register("dribble_foul")
	_push_momentum()
	if not _practice_kind.is_empty():
		_resolve_chance("dribble_lost")
		return


	var penal_carga: bool = _in_penalty_box(_ball_field)
	var culpable: AnimatedSprite3D = _rival_actors[i] \
			if i >= 0 and i < _rival_actors.size() else null



	if _salida_falta(penal_carga, dura, culpable):
		return






	if _falta_la_cobra_otro(penal_carga):
		_cobro_cedido(penal_carga, {}, _cedida_beat(_ref_amonesta(dura, culpable)))
		return
	_drive_beat = true




	_chain_after_duel(_foul_chance(), I18n.t("¡PENAL! Se cobra en los once metros")
		if penal_carga else I18n.t("¡FALTA! Se cobra aquí mismo"),
		_ref_amonesta(dura, culpable), State.AIMING)


func _drive_press_step(delta: float, braking: bool = false,
		frozen: bool = false) -> void:
	while _press_vels.size() < _rival_actors.size():
		_press_vels.append(Vector2.ZERO)
	if frozen:
		for a in _rival_actors:
			if is_instance_valid(a):
				_run_target.erase(a)
		return


	_press_react_ensure()
	var active: Array[int] = _drive_press_active()


	var lanes: Dictionary = _press_lanes(active)


	var share: Dictionary = _cover_shares(active)







	var line_i: int = _line_holder(active)
	var line_z: float = _last_defender_z()



	var pasaste_la_zaga: bool = not is_inf(line_z) \
			and _ball_field.y < line_z - DRIVE_PASSED_M




	var flying: Dictionary = {} if braking else _lance_step(delta, _defender_pos,
		_press_vels, _rival_actors)
	var mi_pace: float = clampf(_drive_vel.length() / maxf(_drive_run_spd, 0.01), 0.0, 1.0)



	_mark_assign(active, line_i)
	for i in _rival_actors.size():
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or i >= _defender_pos.size():
			continue







		if _order_owned(a):
			continue
		if not active.has(i):





			_run_target.erase(a)













			var rebasado: bool = pasaste_la_zaga \
					and _defender_pos[i].y > _ball_field.y + DRIVE_PASSED_M



			if a.has_meta("hold_wall") or _mark_of.has(i) \
					or (i == line_i and not rebasado):
				continue
			var quiere: Vector2 = AimPress.cover_point(_defender_pos[i], _ball_field,
				float(share.get(i, 0.0)))




			var paso: float = AimPress.COVER_SPEED
			if rebasado or (_defender_pos[i].y < _ball_field.y \
					and _ball_field.y - _defender_pos[i].y < DRIVE_LINE_CUSHION):
				quiere.y = minf(quiere.y,
					maxf(_ball_field.y - DRIVE_LINE_CUSHION, DRIVE_LINE_FLOOR))
				paso = DRIVE_BACK_SPEED




			if not is_inf(line_z) and not rebasado:
				quiere.y = maxf(quiere.y, line_z)
			if quiere == _defender_pos[i]:
				continue
			_defender_pos[i] = _inside_field(
				_defender_pos[i].move_toward(quiere, paso * delta))
			a.position = Vector3(_defender_pos[i].x, a.position.y, _defender_pos[i].y)
			continue






		var spd: float = _chaser_speed.get(a, AimPress.SPEED_FALLBACK) \
				* _drive_recover_mult() \
				* _puddle_slow(Vector2(a.position.x, a.position.z))




		if _press_reacting(i, delta, braking):
			_run_target.erase(a)
			continue








		if flying.has(i):
			continue




		if not braking and not _mark_of.has(i) and i != line_i \
				and _lance_wants(i, a, mi_pace, _defender_pos, _press_vels, _rival_lead(a)):




			var sto: Vector2 = _ball_field + _drive_vel * LANCE_LEAD_T
			var sd: Vector2 =(sto - _defender_pos[i]).normalized()
			_lance_t[i] = LANCE_T
			_lance_from[i] = _defender_pos[i]
			_lance_to[i] = sto
			_lance_team_cd = LANCE_T + LANCE_TEAM_CD
			_play_dir_gesture(a, "slide", sd, int(LANCE_T * 1000.0))
			_run_target.erase(a)
			continue
		var k: float = _rival_accel_k(a)
		var meta_i: Vector2 = Drive.press_point(_ball_field, _defender_pos[i],
			float(lanes.get(i, 0.0)))


















		if not active.is_empty() and i == active[0] and not _mark_of.has(i) \
				and Duel.should_jockey(_defender_pos[i], _ball_field, _drive_pos,
				_rival_lead(a), _drive_vel.length() / maxf(_drive_run_spd, 0.01)):




			meta_i = Duel.jockey_point(_ball_field, DRIVE_LINE_FLOOR)
			spd *= Duel.JOCKEY_SPD_F










		elif not _mark_of.has(i) and Duel.should_shoulder(_defender_pos[i], _drive_pos,
				_drive_vel, _rival_lead(a), _rival_peso(a),
				_defender_pos[i].distance_to(_ball_field), 0.0, _shoulder_swing):
			meta_i = Duel.shoulder_point(_drive_pos, _drive_vel, _defender_pos[i])
		var out: Array = Drive.press_brake(_defender_pos[i], _press_vels[i],
			spd, delta, k) if braking else Drive.press_step(_defender_pos[i],
			_press_vels[i], meta_i, spd, delta, k)


		_defender_pos[i] = _inside_field(out[0])
		_press_vels[i] = out[1]
		a.position = Vector3(_defender_pos[i].x, a.position.y, _defender_pos[i].y)
		if (out[1] as Vector2).length() > 0.1:


			_run_target[a] = Vector3(meta_i.x, a.position.y, meta_i.y)
		else:

			_run_target.erase(a)

	_mark_step(delta, active, braking)
	_relax_defenders()









func _drive_press_active() -> Array[int]:
	var sub: Array = []
	var sub_spd: Array = []
	var map: Array[int] = []
	for i in _rival_actors.size():
		var a: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(a) or i >= _defender_pos.size():
			continue


		if a.has_meta("hold_wall"):
			continue





		if float(_lance_cool.get(i, 0.0)) > 0.0:
			continue















		if not a.has_meta("press_role") \
				and _defender_pos[i].distance_to(_ball_field) \
				>(DRIVE_ENGAGE_R if _mark_of.has(i) or _marca_soltada.has(i)
					else _drive_engage_r()):
			continue
		sub.append(_defender_pos[i])
		sub_spd.append(_chaser_speed.get(a, AimPress.SPEED_FALLBACK))
		map.append(i)




	var sticky: Array[int] = []
	for k in map.size():
		if _press_last.has(map[k]):
			sticky.append(k)
	var out: Array[int] = []
	for k in Drive.pressers(sub, _ball_field, _drive_press_n(), Drive.PRESS_R, sticky, sub_spd):
		out.append(map[k])
	_press_last = out
	return out






func _drive_press_n() -> int:
	var far: int = int(_swarm_m() / DRIVE_SWARM_M)
	return mini(_press_n + 1 + far, DRIVE_PRESS_CAP)




func _drive_engage_r() -> float:
	return minf(DRIVE_ENGAGE_R + _swarm_m() * DRIVE_SWARM_R, Drive.PRESS_R)















func _swarm_m() -> float:
	var m: float = _ball_field.distance_to(_drive_origin)
	if _meta_viva:
		m = minf(m, maxf(Stadium.FIELD_DEPTH * 0.5 - _ball_field.y, 0.0))
	return m






















func _drive_offtrap_step(delta: float) -> void:







	if _offtrap_t <= 0.0 and _offtrap_cd <= 0.0 and _tac_bloque <= OFFTRAP_MAX_BLOQUE:
		var alguien_rompe: bool = false
		for v in _drive_mate_risk.values():
			if float(v) > 0.0:
				alguien_rompe = true
				break
		if alguien_rompe:
			_offtrap_t = OFFTRAP_T
			_offtrap_up = 0.0
	_offtrap_relax(delta)



















func _offtrap_relax(delta: float) -> void:
	if _offtrap_cd > 0.0:
		_offtrap_cd = maxf(_offtrap_cd - delta, 0.0)
	if _offtrap_t <= 0.0:




		if _offtrap_up > 0.0:
			var back: float = minf(OFFTRAP_BACK_SPD * delta, _offtrap_up)
			_offtrap_shift(- back)
			_offtrap_up -= back
		return
	_offtrap_t -= delta
	if _offtrap_t <= 0.0:
		_offtrap_cd = OFFTRAP_CD
	var falta: float = OFFTRAP_STEP_M - _offtrap_up
	if falta <= 0.0:
		return
	var paso: float = minf(OFFTRAP_SPD * delta, falta)
	_offtrap_shift(paso)
	_offtrap_up += paso






func _offtrap_shift(dz: float) -> void:
	var crudeza: float = clampf(_tac_bloque / maxf(OFFTRAP_MAX_BLOQUE, 0.01), 0.0, 1.0)
	for i in _rival_actors.size():
		var r: AnimatedSprite3D = _rival_actors[i]
		if not is_instance_valid(r) or r.has_meta("hold_wall") or r.has_meta("press_role"):
			continue






		if _press_last.has(i):
			continue







		var desajuste: float = OFFTRAP_RAGGED * crudeza *(1.0 - _rival_q_tac(r))
		var mi_dz: float = dz *(1.0 - desajuste)
		r.position.z += mi_dz

		r.set_meta("de_frente_hasta", Time.get_ticks_msec() + DE_FRENTE_MS)




		if not _run_target.has(r) and _anim_lock.get(r, 0) <= Time.get_ticks_msec() \
				and absf(mi_dz) > 0.0001:
			_play_run(r, Vector3(0.0, 0.0, mi_dz))
		if i < _defender_pos.size():
			_defender_pos[i] = Vector2(r.position.x, r.position.z)


func _drive_mate_step(delta: float, braking: bool = false) -> void:
	while _drive_mate_vels.size() < _teammate_actors.size():
		_drive_mate_vels.append(Vector2.ZERO)



	if not braking:
		_drive_offer_t += delta
		if _drive_offer_t >= DRIVE_OFFER_RETHINK_T \
				or _ball_field.distance_to(_drive_offer_ball) >= DRIVE_OFFER_RETHINK_M:
			_drive_offer_rethink()







	var line_z: float = _onside_line_z()
	for i in _teammate_actors.size():
		var t: AnimatedSprite3D = _teammate_actors[i]
		if not is_instance_valid(t) or not _drive_mate_goal.has(i):
			continue



		if _order_holds(t):
			continue
		var pos: Vector2 = Vector2(t.position.x, t.position.z)
		var goal: Vector2 = _drive_mate_goal[i]






















		if float(_drive_mate_risk.get(i, 0.0)) \
				<= MATE_BREAK_TAIL_S *(0.25 + 0.75 * _mate_q(t)) \
				and not is_inf(line_z) and pos.y < line_z + 0.3:



			goal = Vector2(pos.x, line_z + 1.2)
		var spd: float = _chaser_speed.get(t, AimPress.SPEED_FALLBACK) * MATE_OFFER_MULT
		var mk: float = _rival_accel_k(t)
		var out: Array
		if braking or pos.distance_to(goal) < MATE_OFFER_STOP:
			out = Drive.press_brake(pos, _drive_mate_vels[i], spd, delta, mk)
		else:
			out = Duel.step_defender(pos, _drive_mate_vels[i], goal, spd, delta, mk)
		var np: Vector2 = _inside_field(out[0])




		var arriesga: bool = float(_drive_mate_risk.get(i, 0.0)) > 0.0
		if arriesga:
			_drive_mate_risk[i] = float(_drive_mate_risk[i]) - delta
			if float(_drive_mate_risk[i]) <= 0.0:
				_drive_mate_risk_cd[i] = BREAK_RISK_CD
		elif float(_drive_mate_risk_cd.get(i, 0.0)) > 0.0:
			_drive_mate_risk_cd[i] = maxf(float(_drive_mate_risk_cd[i]) - delta, 0.0)







		if not is_inf(line_z) and not arriesga and pos.y >= line_z + 0.3:
			var np_libre: float = np.y
			np.y = maxf(np.y, line_z + 0.3)




			if np.y > np_libre and (np - pos).dot(goal - pos) <= 0.0:
				t.set_meta("de_frente_hasta", Time.get_ticks_msec() + DE_FRENTE_MS)
		_drive_mate_vels[i] = out[1]
		t.position = Vector3(np.x, t.position.y, np.y)













		if _offer_home.has(t):
			_offer_home[t] = np
			_offer_goal.erase(t)
			_offer_burst[t] = 0.0
		if (out[1] as Vector2).length() > 0.1:
			_run_target[t] = Vector3(goal.x, t.position.y, goal.y)


			if not braking and pos.distance_to(goal) >= MATE_OFFER_STOP:
				t.set_meta("pace_run_until", Time.get_ticks_msec() + 400)
		else:
			_run_target.erase(t)








	var linea: float = _onside_line_z()
	for t in _teammate_actors:
		if not is_instance_valid(t) or t == _self_actor:
			continue
		if not is_inf(linea) and t.position.z < linea + Duel.ONSIDE_SLACK:
			_offer_recula[t] = true
		else:
			_offer_recula.erase(t)













































const LANE_FAN_DEG: float = 40.0


const LANE_FAN_STEPS: int = 4




const LANE_CLEAR_M: float = 1.9




const LANE_TURN_COST: float = 0.55
















const LANE_PASS_W: float = 0.55
const LANE_PASS_CAP: float = 3.0








func _clear_lane(pos: Vector2, run: Vector2, extra_obs: Array[Vector2] = []) -> Vector2:
	var reach: float = run.length()
	if reach < 0.5:
		return run
	var obs: Array[Vector2] = []
	for d in _defender_pos:
		obs.append(d)
	obs.append_array(extra_obs)
	for t in _teammate_actors:
		if is_instance_valid(t):
			obs.append(Vector2(t.position.x, t.position.z))
	var best_dir: Vector2 = run
	var best_score: float = - INF
	for k in range(- LANE_FAN_STEPS, LANE_FAN_STEPS + 1):
		var ang: float = deg_to_rad(LANE_FAN_DEG) * float(k) / float(LANE_FAN_STEPS)
		var cand: Vector2 = run.rotated(ang)
		var score: float = minf(_lane_air(pos, pos + cand, obs), LANE_CLEAR_M) \
				+ LANE_PASS_W * minf(_pass_air(pos + cand), LANE_PASS_CAP) \
				- LANE_TURN_COST * absf(ang)
		if score > best_score:
			best_score = score
			best_dir = cand
	return best_dir







func _pass_air(to: Vector2) -> float:
	var best: float = INF
	for d in _defender_pos:
		if (d as Vector2).distance_to(_ball_field) < 0.5:
			continue
		best = minf(best,(d as Vector2).distance_to(
			Geometry2D.get_closest_point_to_segment(d, _ball_field, to)))
	return best






func _lane_air(a: Vector2, b: Vector2, obs: Array[Vector2]) -> float:
	var best: float = INF
	for o in obs:
		if o.distance_to(a) < 0.5:
			continue
		best = minf(best, o.distance_to(Geometry2D.get_closest_point_to_segment(o, a, b)))
	return best


func _drive_offer_mates() -> void:


	_offtrap_t = 0.0
	_offtrap_cd = 0.0
	_offtrap_up = 0.0
	_drive_mate_rol = {}
	_drive_mate_goal = {}
	_drive_mate_vels = []
	_drive_mate_home = {}
	_drive_mate_dec = {}
	_keeper_out_vel = Vector2.ZERO
	for _t in _teammate_actors:
		_drive_mate_vels.append(Vector2.ZERO)
	_drive_offer_rethink()





func _drive_offer_rethink() -> void:
	_drive_offer_t = 0.0
	_drive_offer_ball = _ball_field
	var line_z: float = _onside_line_z()





	var en_juego: Array = []
	var idx_juego: Array = []
	for i in _teammate_actors.size():
		var ta: AnimatedSprite3D = _teammate_actors[i]
		if not is_instance_valid(ta):
			continue
		var p0: Vector2 = Vector2(ta.position.x, ta.position.z)
		if p0.distance_to(_ball_field) > _correa_r:
			continue
		en_juego.append(p0)
		idx_juego.append(i)
	var roles_por_i: Dictionary = {}
	var roles_lista: Array = _drive_offer_roles(en_juego)
	for k in idx_juego.size():
		roles_por_i[idx_juego[k]] = roles_lista[k]
		_drive_mate_rol[idx_juego[k]] = roles_lista[k]
	for i in _teammate_actors.size():
		var t: AnimatedSprite3D = _teammate_actors[i]
		if not is_instance_valid(t):
			continue
		var pos: Vector2 = Vector2(t.position.x, t.position.z)




		if pos.distance_to(_ball_field) > _correa_r:
			continue
		if not _drive_mate_home.has(i):
			_drive_mate_home[i] = pos
		var rol: int = int(roles_por_i.get(i, -1))







		if rol == Offer.RUPTURA and float(_drive_mate_risk.get(i, 0.0)) <= 0.0 \
				and float(_drive_mate_risk_cd.get(i, 0.0)) <= 0.0 and not is_inf(line_z):
			var libre: Vector2 = _drive_offer_goal(pos, INF, rol)
			var atado: Vector2 = _drive_offer_goal(pos, line_z, rol)
			if libre.distance_to(atado) >= BREAK_RISK_M:

				_drive_mate_risk[i] = BREAK_RISK_T +(1.0 - _mate_q(t)) * MATE_RISK_EXTRA_S














		var resta: float = float(_drive_mate_risk.get(i, 0.0))
		var mi_line: float = INF \
				if resta > MATE_BREAK_TAIL_S *(0.25 + 0.75 * _mate_q(t)) else line_z
		var goal: Vector2 = _drive_offer_goal(pos, mi_line, rol)




		var home: Vector2 = _drive_mate_home[i]
		if goal.distance_to(home) > _correa_ruptura:
			goal = home +(goal - home).normalized() * _correa_ruptura


		_drive_mate_dec[i] = int(_drive_mate_dec.get(i, 0)) + 1
		goal.x += _mate_err_x(t, i, int(_drive_mate_dec[i]))
		_drive_mate_goal[i] = _inside_field(goal)








































func _drive_offer_roles(pos_list: Array) -> Array:
	var roles: Array = []
	roles.resize(pos_list.size())
	roles.fill(-1)
	if pos_list.is_empty():
		return roles


	var orden: Array = range(pos_list.size())
	orden.sort_custom(func(a, b): return (pos_list[a] as Vector2).length() \
			<(pos_list[b] as Vector2).length())

	roles[orden[0]] = Offer.RUPTURA










	if orden.size() >= 2:
		var ultimo: int = orden[orden.size() - 1]
		if (pos_list[ultimo] as Vector2).distance_to(_ball_field) \
				> OFFER_SHORT_R + APOYO_MIN_M:
			roles[ultimo] = Offer.APOYO
	return roles






func _drive_offer_goal(pos: Vector2, line_z: float, rol: int = -1) -> Vector2:
	var goal: Vector2
	var to_mate: Vector2 = pos - _ball_field



	if to_mate.length() < LIBERA_R and to_mate.length() > 0.01 \
			and _drive_vel.dot(to_mate.normalized()) > 0.6:
		var v: Vector2 = _drive_vel.normalized()


		var perp: Vector2 = Vector2(- v.y, v.x)
		if perp.dot(to_mate) < 0.0:
			perp = - perp
		goal = _inside_field(pos + _clear_lane(pos, perp * MATE_OFFER_MAX_M))
		if not is_inf(line_z):
			goal.y = maxf(goal.y, line_z + 0.3)
		return goal



	if rol == Offer.APOYO:
		var to_ball: Vector2 = _ball_field - pos
		if to_ball.length() > 0.01:
			var largo: float = minf(maxf(to_ball.length() - OFFER_SHORT_R, 0.0),
				MATE_SHORT_MAX_M)
			goal = _inside_field(pos + _clear_lane(pos, to_ball.normalized() * largo))
			if not is_inf(line_z):
				goal.y = maxf(goal.y, line_z + 0.3)
			return goal





	if rol == Offer.RUPTURA:
		var lado: float = signf(pos.x - _ball_field.x)
		if lado == 0.0:
			lado = 1.0
		var al_arco: Vector2 =(Vector2.ZERO - pos).normalized() \
				if pos.length() > 0.01 else Vector2(0.0, -1.0)
		var rdir: Vector2 =(al_arco + Vector2(lado * 0.45, 0.0)).normalized()
		goal = _inside_field(pos + _clear_lane(pos, rdir * _correa_ruptura))
		if not is_inf(line_z):
			goal.y = maxf(goal.y, line_z + 0.3)








			if goal.length() >= pos.length():
				var max_x2: float = pos.length_squared() - goal.y * goal.y
				if max_x2 > 0.25:
					goal.x = signf(goal.x) * minf(absf(goal.x), sqrt(max_x2) - 0.3)
				else:


					goal = pos
		return goal



	var wide: float = signf(pos.x - _ball_field.x)
	if wide == 0.0:
		wide = 1.0 if pos.x >= 0.0 else -1.0
	var dir: Vector2 = Vector2(wide * 0.85, -0.55)






	var away: Vector2 = Vector2.ZERO
	var best: float = INF
	for d in _defender_pos:
		var dd: float =(d as Vector2).distance_to(pos)
		if dd < best:
			best = dd
			away = pos - d
	if away.length() > 0.01:
		dir.x += signf(away.x) * 0.6 if absf(away.x) > 0.01 else 0.0
	dir = dir.normalized()



	goal = _inside_field(pos + _clear_lane(pos, dir * MATE_OFFER_MAX_M))

	if not is_inf(line_z):
		goal.y = maxf(goal.y, line_z + 0.3)
	return goal





func _drive_release_mates() -> void:
