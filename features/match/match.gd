func _servicio_asoma(p: Vector3, rect: Rect2) -> bool:
	if _shot_cam.is_position_behind(p):
		return false
	var disco: Array = _ball_screen_circle_en(p)
	var centro: Vector2 = disco[0]
	var pegado := Vector2(clampf(centro.x, rect.position.x, rect.end.x),
		clampf(centro.y, rect.position.y, rect.end.y))
	return pegado.distance_to(centro) < float(disco[1])











func _servicio_cola() -> void:
	if not _serve_vivo or state != State.STRIKING or not _serve_salto.is_empty():
		return
	if _serve_i <= _serve_k or _serve_cola:
		return
	if _serve_i < _serve_ruta.size() - 2:
		var a: Vector3 = _serve_ruta[_serve_i]
		var sig: Vector3 = _serve_ruta[_serve_i + 1]
		if a.y > 0.0 or sig.y > 0.0 \
				or Vector2(sig.x - a.x, sig.z - a.z).length() >= SERVICIO_COLA_V * SIM_DT:
			return
		if not _servicio_asoma(_ball.position, Rect2(Vector2.ZERO, SceneFade.rect_visible(self).size)):
			return

		var rumbo := Vector2.ZERO
		for j in range(_serve_i + 1, 0, -1):
			var d := Vector2(_serve_ruta[j].x - _serve_ruta[j - 1].x,
				_serve_ruta[j].z - _serve_ruta[j - 1].z)
			if d.length() > 0.0001:
				rumbo = d.normalized()
				break
		if rumbo == Vector2.ZERO:
			rumbo = Vector2(a.x - _serve_cita.x, a.z - _serve_cita.z)
			rumbo = rumbo.normalized() if rumbo.length() > 0.001 else Vector2(0.0, 1.0)
		_serve_ruta.resize(_serve_i + 1)
		var q: Vector3 = a
		for _t in SERVICIO_COLA_MAX:
			q += Vector3(rumbo.x, 0.0, rumbo.y) * SERVICIO_COLA_V * SIM_DT
			_serve_ruta.append(q)
		_serve_cola = true
		return
	if _serve_ruta.size() >= _serve_ruta_n0 + SERVICIO_COLA_MAX:
		return
	if not _servicio_asoma(_ball.position, Rect2(Vector2.ZERO, SceneFade.rect_visible(self).size)):
		return
	var n: int = _serve_ruta.size()
	var b: Vector3 = _serve_ruta[n - 1]
	var v: Vector3 =(b - _serve_ruta[n - 2]) / SIM_DT
	var vh := Vector2(v.x, v.z)
	if vh.length() < SERVICIO_COLA_V:
		var rumbo: Vector2 = vh.normalized() if vh.length() > 0.001 \
				else Vector2(b.x - _serve_cita.x, b.z - _serve_cita.z)
		rumbo = rumbo.normalized() if rumbo.length() > 0.001 else Vector2(0.0, 1.0)
		vh = rumbo * SERVICIO_COLA_V
	var mas: Dictionary = _servicio_integra(b, Vector3(vh.x, v.y, vh.y), 0.0, _cesped_bote,
		_cesped_drag, 30)
	var ruta_mas: Array = mas["ruta"]
	for i in range(1, ruta_mas.size()):
		_serve_ruta.append(ruta_mas[i])







func _servicio_chilena_arma(i_mando: int) -> void:
