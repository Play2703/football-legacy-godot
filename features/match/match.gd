static func _rebote_mate_p(v: float, ctrl: float, remata: bool) -> float:
	return smoothstep(REBOTE_MATE_V0, REBOTE_MATE_V1, v) \
			* lerpf(REBOTE_MATE_P_TORPE, REBOTE_MATE_P_CRACK, clampf(ctrl, 0.0, 1.0)) \
			*(REBOTE_MATE_REMATE_K if remata else 1.0)






static func _rebote_mate_parte(h: float) -> String:
	var hc: float = h + BALL_R
	if hc >= DESV_H_PIERNA and h < CARRY_MAX_BALL_H:
		return "muslo"
	return _barrera_parte(hc)






















func _rebote_mate(actor: AnimatedSprite3D, releva: bool, header: bool = false) -> bool:
	if not rebote_mate_enabled or not _vuelo_tuyo or _keeper_triggered \
			or _tutorial_active or _shootout_active or not _practice_kind.is_empty() \
			or _traj_i <= 0 or _traj_i >= _traj.size() or _balon_suelto() \
			or actor == null or actor == _keeper or _is_you(actor):
		return false
	if (GameState.readonly_save or DisplayServer.get_name() == "headless") \
			and not rebote_mate_override:
		return false
	var bp: Vector3 = _traj[_traj_i]
	if bp.z > REBOTE_MATE_MAX_Z:
		return false





	var parte: String = _rebote_mate_parte(bp.y)
	if header or parte == "cabeza":
		return false

	var v_in: Vector3 =(bp - _traj[_traj_i - 1]) / SIM_DT \
			- Vector3(_viento_en(_traj_i), 0.0, 0.0)




	var ctrl_q: float = float(actor.get_meta("ctrl_q")) if actor.has_meta("ctrl_q") \
			else Squad.control(_finisher_of(actor))
	var ctrl: float = pow(clampf(ctrl_q, 0.0, 1.0), Career.REGATE_GAMMA)
	var dado: float = _rebote_mate_dado if _rebote_mate_dado >= 0.0 else randf()
	if dado >= _rebote_mate_p(v_in.length(), ctrl, not releva):
		return false
	var lado: Vector2 = Vector2(bp.x - actor.position.x, bp.z - actor.position.z)
	var f: Vector2 = Vector2(v_in.x, v_in.z).normalized()
	var b: float = clampf((lado - f * lado.dot(f)).length()
		/ maxf(_touch_radius(bp.y, ctrl_q), 0.05), 0.0, 1.0)
	var props: Array = DESV_PARTES[parte] if DESV_PARTES.has(parte) \
			else BARRERA_PARTES[parte]
	var nd: Vector3 = _desv_normal(v_in, lado, b, float(props[1]), REBOTE_MATE_NORMAL_K)


	var r: Dictionary = _desv_respuesta(v_in, _vuelo_giro.x, _vuelo_giro.y, nd,
		float(props[0]) * lerpf(REBOTE_MATE_AMORT_TORPE, REBOTE_MATE_AMORT_CRACK, ctrl),
		false, 1.0)
	var out: Vector3 = r["vel"]
	if out.length() < DESV_V_MUERTO:
		return false



	_rebote_mate_gesto(actor, parte)
	_cara(actor, "resoplar", 1.5)



	var p0: Vector3 = Vector3(bp.x, maxf(bp.y, 0.0), bp.z)
	var d: Vector2 = Vector2(out.x, out.z)
	if d.length() > 0.01 and d.dot(f) < 0.0:
		d = d.normalized()
		var along: float = lado.dot(d)
		if along < DESV_SEP:
			p0 += Vector3(d.x, 0.0, d.y) *(DESV_SEP - along)
	_rebote_mate_causa = true
	_rebote_mate_pase = {"bola": Vector2(bp.x, bp.z),
		"tramo": FlightPath.from_traj(_traj, 0, _traj_i)}



	_snapshot_offside(bp.z, actor)
