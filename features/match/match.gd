func _ref_card_follow() -> void:
	if not is_instance_valid(_ref_card) or not is_instance_valid(_ref_card_owner):
		return

















	if _ref_card_owner.animation != "tarjeta":
		_ref_card.visible = false
		return
	_anim_lock[_ref_card_owner] = maxi(
		int(_anim_lock.get(_ref_card_owner, 0)), Time.get_ticks_msec() + 100)



	var cuadro: int = _ref_card_owner.frame
	var off: Vector2 = RefCard.puno_offset(_ref_card_owner.pixel_size, cuadro)
	var cam: Camera3D = SceneFade.camara_de(self)
	var right: Vector3 = Vector3.RIGHT if cam == null \
			else cam.global_transform.basis.x
	right.y = 0.0
	if right.length_squared() < 0.0001:
		right = Vector3.RIGHT



	var hacia: Vector3 = Vector3.ZERO if cam == null \
			else (cam.global_position - _ref_card_owner.global_position).normalized()
	_ref_card.global_position = _ref_card_owner.global_position \
			+ right.normalized() * off.x + Vector3(0.0, off.y, 0.0) + hacia * 0.06



	_ref_card.visible = _ref_card_owner.visible







































