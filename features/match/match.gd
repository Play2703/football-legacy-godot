func _cedida_planta_yo_corner() -> void:
	_cedida_mates.clear()
	_cedida_rivals.clear()


	_cedida_rivals.append_array(_rival_actors)
	var lado: float = -1.0 if _ball_field.x >= 0.0 else 1.0
	var sitio: Vector2 = Vector2.ZERO
	for intento in 8:
		var cand: Vector2 = Vector2(
			lado * randf_range(1.0, Stadium.PA_HALF_W - 2.0),
			randf_range(CORNER_YO_Z.x, CORNER_YO_Z.y))
		var libre_hueco: bool = true
		for a in _todos_actores():
			if a != null and is_instance_valid(a) \
					and cand.distance_to(Vector2(a.position.x, a.position.z)) \
					< CORNER_YO_HUECO:
				libre_hueco = false
