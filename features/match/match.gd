func _anticip_for(tuyo: bool) -> float:
	return KEEPER_ANTICIP_DRIVE_S if _is_drive_shot(tuyo) else KEEPER_ANTICIP_S







func _is_drive_shot(tuyo: bool) -> bool:



	if _robo_area_vivo:
		return true
	if not tuyo or _header_chance:
		return false





	if _cross_mode or not KEEPER_DRIVE_KINDS.has(_kind_juego(_chance_kind)):
		return false
	return true





var _anticip_s: float = KEEPER_ANTICIP_S






































var KEEPER_REACT_NEAR_S: float = 0.23
var KEEPER_REACT_NEAR_CROSS_S: float = 0.18
var KEEPER_REACT_NEAR_M: float = 5.0
var KEEPER_REACT_FAR_M: float = 16.0







var _shot_dist_m: float = 99.0



var _shot_drive: bool = false





func _react_s() -> float:
	var span: float = maxf(KEEPER_REACT_FAR_M - KEEPER_REACT_NEAR_M, 0.01)
	var cerca: float = clampf((KEEPER_REACT_FAR_M - _shot_dist_m) / span, 0.0, 1.0)
	var techo: float = KEEPER_REACT_NEAR_S if _shot_drive else KEEPER_REACT_NEAR_CROSS_S
	var base: float = lerpf(KEEPER_REACT_S, techo, cerca)
	return base *(1.0 - 0.35 * clampf(_keeper_skill, 0.0, 1.0))





var _keeper_time_cap: bool = true



func _reach_time_cap(reach: float, t_fly: float) -> float:
	if not _keeper_time_cap:
		return reach
	var t_util: float = maxf(0.0, t_fly + _anticip_s - _react_s())
	return minf(reach, maxf(KEEPER_REACH_FLOOR, KEEPER_DIVE_SPD * t_util))
















var KEEPER_POSE_FLOOR: float = 0.55
var KEEPER_POSE_FULL_S: float = 0.45
func _pose_scale(t_fly: float) -> float:
	if not _keeper_time_cap:
		return 1.0
	var t_util: float = maxf(0.0, t_fly + _anticip_s - _react_s())
	return lerpf(KEEPER_POSE_FLOOR, 1.0,
		clampf(t_util / KEEPER_POSE_FULL_S, 0.0, 1.0))









































var KEEPER_TOP_REST_Y: float = 1.62
var KEEPER_TOP_FLOOR: float = 0.8
var KEEPER_TOP_FULL_S: float = 0.5




func _top_scale(t_fly: float) -> float:
	if not _keeper_time_cap:
		return 1.0
	var t_util: float = maxf(0.0, t_fly + _anticip_s - _react_s())
	return lerpf(KEEPER_TOP_FLOOR, 1.0,
		clampf(t_util / KEEPER_TOP_FULL_S, 0.0, 1.0))













func _save_ey(cover: Vector3, ball_cy: float, t_fly: float) -> float:
	var cy: float = ball_cy
	var techo: float = cover.x + cover.z
	if ball_cy > KEEPER_TOP_REST_Y and techo > KEEPER_TOP_REST_Y:
		var s: float = maxf(_top_scale(t_fly), 0.05)
		cy = KEEPER_TOP_REST_Y +(ball_cy - KEEPER_TOP_REST_Y) / s
	return (cy - cover.x) / cover.z











