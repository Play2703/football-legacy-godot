func _celeb_salto_bote(actor: AnimatedSprite3D, lamina: String, quedan: int = CELEB_SALTO_VECES) -> void:
	if quedan <= 0 or not is_instance_valid(actor) or actor.animation != lamina:
		return
	var sf: SpriteFrames = actor.sprite_frames
	var dur: float = 0.7
	if sf != null and sf.has_animation(lamina) and sf.get_animation_speed(lamina) > 0.0:
		dur = float(sf.get_frame_count(lamina)) / sf.get_animation_speed(lamina)
	actor.frame = 0
	actor.play(lamina)




	var alto_px: float = CELEB_SALTO_ALTO_M / maxf(actor.pixel_size, 0.0001)
	var y0: float = actor.offset.y
	var tw: Tween = create_tween()
	tw.tween_interval(dur * 0.3)
	tw.tween_property(actor, "offset:y", y0 + alto_px, dur * 0.3) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(actor, "offset:y", y0, dur * 0.4) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(func() -> void:
		_celeb_salto_bote(actor, lamina, quedan - 1))


