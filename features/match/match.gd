func _setup_cross_runs() -> void:
	_end_cross_runs()
	var corredores: Array = []
	for a in sin_muertos(_corner_home):
		if is_instance_valid(a):
			corredores.append(a)
	if corredores.is_empty():
		return
	var lado: float = 1.0 if _ball_field.x >= 0.0 else -1.0
	if not _cross_drop.is_empty():




		var inter: AnimatedSprite3D = null
		var best: float = INF
		var best_tgt: Vector2 = Vector2.ZERO
		for a in corredores:
			var pa: Vector2 = _flat2(a.position)
			for pt in _cross_drop["pts"]:
				var t: float = maxf(float(pt["i"]) * SIM_DT, 0.35)
				var req: float = pa.distance_to(pt["p"]) / t
				if req < best:
					best = req
					inter = a
					best_tgt = pt["p"]
		if inter != null:
			_fk_runs[inter] = {"tgt": best_tgt,
				"spd": clampf(best, FK_RUN_SPEED_MIN, FK_RUN_SPEED_MAX), "ini": 0}


	var metas: Array = [
		{"tgt": Vector2(lado * 3.0, 4.5), "ini": 0},
		{"tgt": Vector2(- lado * 3.4, 5.5), "ini": 0},
		{"tgt": Vector2(randf_range(-1.0, 1.0), 10.6), "ini": FK_RUN_LATE_I},
	]
	for meta in metas:
		var mejor: AnimatedSprite3D = null
		var md: float = INF
		for a in corredores:
			if _fk_runs.has(a):
				continue
			var dd: float = _flat2(a.position).distance_to(meta["tgt"])
			if dd < md:
				md = dd
				mejor = a
		if mejor != null:
			_fk_runs[mejor] = {"tgt": meta["tgt"],
				"spd": FK_RUN_DECOY_SPEED, "ini": int(meta["ini"])}
	for a in sin_muertos(_fk_runs):
		(a as AnimatedSprite3D).set_meta("fk_run", true)
		var mk = _corner_marker.get(a)
		if is_instance_valid(mk):
			mk.set_meta("fk_run", true)
	_fk_runs_on = not _fk_runs.is_empty()





func _update_cross_runs(delta: float) -> void:
	if not _fk_runs_on:
		return


	var pasado: bool = not _cross_drop.is_empty() \
			and _traj_i > int(_cross_drop["i"]) + FK_RUN_PAST_I
	var muerto: bool = _cross_i >= 0 and _traj_i >= _cross_i \
			and (_outcome == "goal" or _outcome == "wide" or _outcome == "over")
	if _pass_done or _mate_kicker != null or _clear_phase or muerto or pasado:
		_end_cross_runs()
		return
	var kp: Vector2 = _flat2(_keeper.position) if is_instance_valid(_keeper) \
			else Vector2(0.0, 0.8)
	for a in sin_muertos(_fk_runs):
		if not is_instance_valid(a):
			continue
		var r: Dictionary = _fk_runs[a]
		if _traj_i < int(r["ini"]):
			continue
		var p: Vector2 = _flat2((a as AnimatedSprite3D).position)

		var paso: Vector2 = _clamp_field(_push_out(
			_corner_step(p, r["tgt"], float(r["spd"]) * delta), kp, KEEPER_CLEAR))
		(a as AnimatedSprite3D).position = Vector3(paso.x,
			(a as AnimatedSprite3D).position.y, paso.y)
		var mk = _corner_marker.get(a)
		if is_instance_valid(mk):
			var to_goal: Vector2 = - paso
			if to_goal.length() < 0.1:
				to_goal = Vector2(0.0, -1.0)
			var want: Vector2 = _clamp_field(_push_out(
				paso + to_goal.normalized() * CORNER_MARK_GAP, kp, KEEPER_CLEAR))
			var mp: Vector2 = _corner_step(_flat2(mk.position), want,
				FK_MARK_SPEED * delta)
			mk.position = Vector3(mp.x, mk.position.y, mp.y)


	for i in _rival_actors.size():
		if is_instance_valid(_rival_actors[i]) and i < _defender_pos.size():
			_defender_pos[i] = _flat2(_rival_actors[i].position)



func _end_cross_runs() -> void:
	for a in sin_muertos(_fk_runs):
		if is_instance_valid(a):
			(a as AnimatedSprite3D).remove_meta("fk_run")
			var mk = _corner_marker.get(a)
			if is_instance_valid(mk):
				mk.remove_meta("fk_run")
	_fk_runs = {}
	_fk_runs_on = false











func _cross_drop_point() -> Dictionary:
	var techo: float = HEADER_CONTACT_BAND.y
	var prev_y: float = - INF
	var pts: Array = []
	var fin: int = -1
	for i in _traj.size():
		var p: Vector3 = _traj[i]
		if p.y < prev_y and p.y <= techo and p.y >= HEADER_MIN_H \
				and p.z >= 0.0 and p.z <= FK_DROP_MAX_Z \
				and absf(p.x) <= Stadium.PA_HALF_W + 2.0:
			if pts.is_empty() or i - int(pts[pts.size() - 1]["i"]) >= 6:
				pts.append({"i": i, "p": Vector2(p.x, p.z)})
			fin = i
		elif fin >= 0:
			break
		prev_y = p.y
	if pts.is_empty():
		return {}
	return {"pts": pts, "i": fin}








