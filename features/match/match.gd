var _pad_rt_disp: int = -1



var _pad_al_paso: bool = false



func _pad_rt_lee() -> bool:
	var cuadro: int = Engine.get_process_frames()
	var seguido: bool = _pad_rt_cuadro == cuadro - 1 and _pad_rt_disp == Entrada.dispositivo
	_pad_rt_cuadro = cuadro
	_pad_rt_disp = Entrada.dispositivo
	var v: float = Input.get_joy_axis(Entrada.dispositivo, JOY_AXIS_TRIGGER_RIGHT) \
			if Entrada.dispositivo >= 0 else 0.0
	_pad_rt = v >(Entrada.GATILLO_OFF if _pad_rt else Entrada.GATILLO_ON)
	return seguido






