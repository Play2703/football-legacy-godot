	_hud.show_message(I18n.t("¡Derribaste el dron de la tele!"), Color("dfe3ea"), 1.6)
	SceneFade.timer(DRON_OOH_S, false).timeout.connect(_dron_ooh)


	if _dron_tuyo:
		Achievements.ingest_drone_hit()


