func _chase_contenders(delta: float) -> Dictionary:
	var out: Dictionary = {}
	var pools: Array = _chase_pools()
	for i in pools.size():
		var lista: Array = pools[i]


		if i == 0 and _meta_saca():
			var r: AnimatedSprite3D = _meta_receptor(lista)
			if r != null:
				out[r] = _chase_aim(r, _chaser_speed.get(r, AimPress.SPEED_FALLBACK), delta)
			continue
		var rank: Array = []
		for a in lista:








			if not is_instance_valid(a) or a.has_meta("hold_wall") \
					or a.has_meta("fk_run") \
					or _anim_lock.get(a, 0) > Time.get_ticks_msec():
				continue
			var spd: float = _chaser_speed.get(a, AimPress.SPEED_FALLBACK)
			var aim: Vector3 = _chase_aim(a, spd, delta)
			rank.append([_flat_dist(a.position, aim) / maxf(spd, 0.5), a, aim])
		rank.sort_custom(func(x: Array, y: Array) -> bool: return x[0] < y[0])
		for k in mini(CHASE_GO_N, rank.size()):
			out[rank[k][1]] = rank[k][2]






		if palanca_rematador and state == State.FLIGHT and _rebound_i >= 0 \
				and (_desv_i < 0 or _rebound_i != _desv_i) \
				and is_instance_valid(_rematador) and lista.has(_rematador) \
				and not out.has(_rematador) \
				and _anim_lock.get(_rematador, 0) <= Time.get_ticks_msec():
			out[_rematador] = _chase_aim(_rematador,
				_chaser_speed.get(_rematador, AimPress.SPEED_FALLBACK), delta)
	return out






func _support_picks(contenders: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	var pools: Array = _chase_pools()
	var siguen: Dictionary = {}
	for i in pools.size():


		if i == 0 and _meta_saca():
			continue
		var lista: Array = pools[i]
		var rank: Array = []
		var plazas: int = SUPPORT_N
		for a in lista:

			if not is_instance_valid(a) or contenders.has(a) \
					or a.has_meta("hold_wall") or a.has_meta("fk_run") \
					or _anim_lock.get(a, 0) > Time.get_ticks_msec():
				continue


			if _meta_hombre(a) != null:
				continue














			if a == _rematador and state == State.FLIGHT and _rebound_i >= 0:
				out[a] = true
				continue
			var d: float = _play_dist(a)


			if _support_lejos.has(a) and d <= CHASE_MAX_M:
				out[a] = true
				siguen[a] = true
				plazas -= 1
				continue










			if d <= SUPPORT_NEAR_M:
				out[a] = true
				continue
			if d <= CHASE_MAX_M:
				rank.append([d, a])
		rank.sort_custom(func(x: Array, y: Array) -> bool: return x[0] < y[0])
		for k in mini(maxi(plazas, 0), rank.size()):
			out[rank[k][1]] = true
			siguen[rank[k][1]] = true


	_support_lejos = siguen
	return out















