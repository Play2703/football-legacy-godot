		_audio.roar()
	_intro_tween = create_tween()



	_intro_tween.tween_method(_lineup_step if proto else _intro_step, 0.0, 1.0, dur) \
			.set_trans(Tween.TRANS_LINEAR if proto else Tween.TRANS_SINE) \
			.set_ease(Tween.EASE_IN_OUT)
	_intro_tween.tween_callback(_end_intro)


	montando = false
	_warm_frames()
















func _warm_frames() -> void:



	var looks: Array[Array] = _warm_looks()






























	var deadline: int = Time.get_ticks_usec() + _warm_presupuesto()





	var est: Dictionary = {"sho": 3000, "rec": WARM_BUDGET_US, "gpu": WARM_BUDGET_US}

	var pendientes: Array = []
	for look in looks:
		var sf: SpriteFrames = null


		var telas: Dictionary = {}
		if look[0] == KEEPER_TEX:









			if not _frames_cache.has("keeper|" + var_to_str(look[1])):
				for par in _warm_keeper_paths(look[1]):
					if Time.get_ticks_usec() + _drain_last_us >= deadline:
						await get_tree().process_frame
						if _intro_cam == null:
							return
						deadline = Time.get_ticks_usec() + _warm_presupuesto()
					var t_k: int = Time.get_ticks_usec()



					KitRecolor.pon_imagen_en_meta(_keeper_par_al_atlas(String(par[0])))
					KitRecolor.apply_recordando(load(par[0]), par[1])
					KitRecolor.pon_imagen_en_meta(false)
					_mide_cuadro(int(Time.get_ticks_usec() - t_k))
				await get_tree().process_frame
				if _intro_cam == null:
					return
			sf = _keeper_frames(look[1])
		else:








			if not _frames_cache.has(_frames_key(look[0], look[1])):
				for slice in _anim_slices(look[0], "idle"):
					var anim: String = slice["anim"]
					var paths: Array = slice["paths"]
					for i in paths.size():
						if Time.get_ticks_usec() + _drain_last_us >= deadline:
							await get_tree().process_frame
							if _intro_cam == null:
								return
							deadline = Time.get_ticks_usec() + _warm_presupuesto()
						var t_c: int = Time.get_ticks_usec()


						var hecha: Texture2D = KitRecolor.apply_recordando(load(paths[i]), look[1])
						_mide_cuadro(int(Time.get_ticks_usec() - t_c))



						if i == 0 and (anim == "idle" or anim == "idle_back"):
							telas[anim] = [hecha, KitRecolor.imagen_cpu(hecha)]
			sf = _actor_frames(look[0], look[1])
































		if _lleva_lamina(look[2]):
			if not _telas_valen(sf, telas):
				pendientes.append([sf, look[2]])
				continue
			deadline = await _lamina_en_vuelo(sf, look[2], telas, est, "rec", deadline)
			if deadline < 0:
				return
	for p in pendientes:
		deadline = await _lamina_en_vuelo(p[0], p[1], {}, est, "gpu", deadline)
		if deadline < 0:
			return
	await _warm_barreras(looks)




















func _warm_barreras(looks: Array[Array]) -> void:
	var slices: Array[Dictionary] = []
	for slice in _anim_slices(RIVAL_TEX, "rest"):
		if BARRERA_ANIMS.has(String(slice["anim"])):
			slices.append(slice)
	var deadline: int = Time.get_ticks_usec() + DRAIN_BUDGET_US
	var hecho: bool = false
	for look in looks:
		if look[0] != RIVAL_TEX or _cfg_role(RIVAL_TEX, look[1]) != "npc":
			continue
		var sf: SpriteFrames = _frames_cache.get(_frames_key(look[0], look[1])) as SpriteFrames
		if sf == null:
			continue
		for slice in slices:
			var anim: String = slice["anim"]
			var paths: Array = slice["paths"]
			while not sf.has_animation(anim) or sf.get_frame_count(anim) < paths.size():
				if hecho and Time.get_ticks_usec() + _drain_last_us >= deadline:
					await get_tree().process_frame
					if _intro_cam == null:
						return
					deadline = Time.get_ticks_usec() + DRAIN_BUDGET_US
					hecho = false
				_open_anim(sf, slice)
				var t_b: int = Time.get_ticks_usec()
				_pon_cuadro(sf, anim, paths[sf.get_frame_count(anim)], look[1])
				_mide_cuadro(int(Time.get_ticks_usec() - t_b))
				hecho = true





func _telas_valen(sf: SpriteFrames, telas: Dictionary) -> bool:
	if sf == null:
		return false
	for anim in ["idle_back", "idle"]:
		if not telas.has(anim) or (telas[anim] as Array)[1] == null \
				or not sf.has_animation(anim) or sf.get_frame_count(anim) == 0 \
				or not is_same((telas[anim] as Array)[0], sf.get_frame_texture(anim, 0)):
			return false
	return true








func _lamina_en_vuelo(sf: SpriteFrames, placa: Dictionary, telas: Dictionary,
		est: Dictionary, cual: String, deadline: int) -> int:
	if Time.get_ticks_usec() + int(est[cual]) >= deadline:
		await get_tree().process_frame
		if _intro_cam == null:
			return -1
		deadline = Time.get_ticks_usec() + _warm_presupuesto()
	var t_r: int = Time.get_ticks_usec()
	var rec_esp: Dictionary = _espalda_receta(sf, placa, true, telas.get("idle_back", []))
	var rec_sho: Dictionary = _short_receta(sf, placa, true, telas.get("idle", []))
	est[cual] = maxi(1, int(Time.get_ticks_usec() - t_r))
	if Time.get_ticks_usec() + int(est["sho"]) >= deadline:
		await get_tree().process_frame
		if _intro_cam == null:
			return -1
		deadline = Time.get_ticks_usec() + _warm_presupuesto()
	var t_s: int = Time.get_ticks_usec()
	ShortNum.textura(int(placa["number"]), rec_sho)
	est["sho"] = maxi(1, int(Time.get_ticks_usec() - t_s))
	var horno: Espalda.HornoEspalda = Espalda.horno(String(placa["apellido"]),
		int(placa["number"]), rec_esp)
	if horno == null:
		return deadline
	if Time.get_ticks_usec() + horno.siguiente_us() >= deadline:
		await get_tree().process_frame
		if _intro_cam == null:
			return -1
		deadline = Time.get_ticks_usec() + _warm_presupuesto()
	while not horno.avanza(deadline):
		await get_tree().process_frame
		if _intro_cam == null:
			return -1
		deadline = Time.get_ticks_usec() + _warm_presupuesto()
	return deadline
















