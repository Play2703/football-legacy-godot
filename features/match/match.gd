func _linea_pitada_z() -> float:
	var zs: Array[float] = []
	for r in _rival_actors:
		if is_instance_valid(r):
			zs.append(r.position.z)
	zs.append(_keeper.position.z if is_instance_valid(_keeper) else 0.0)
	if zs.size() < 2:
		return INF
	zs.sort()
	return minf(zs[1], _last_defender_z())







func _last_defender_index() -> int:
	var best: int = -1
	var best_z: float = INF
	for i in _defender_pos.size():
		var r: AnimatedSprite3D = _rival_actors[i] if i < _rival_actors.size() else null
		if not is_instance_valid(r) or r.has_meta("hold_wall") or r.has_meta("press_role"):
