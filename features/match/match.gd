func _hit_referee() -> void:
	var r: AnimatedSprite3D = _ref_who
	if not is_instance_valid(r):
		return


	_audio.toque(1.0)
	_audio.ooh()
	_fx.shake(0.32)
	_hud.show_message(I18n.t("¡LE DISTE AL ÁRBITRO!"), Color("ffb0b0"), 1.3)
	if Settings.reduce_motion:



		_ref_card_after(r)
		return
	_knock_referee(r, _ref_from)
	SceneFade.timer(REF_DOWN_S, false).timeout.connect(
		_ref_get_up.bind(r))






func _knock_referee(r: AnimatedSprite3D, from: Vector3) -> void:
	var away: Vector3 = r.global_position - from
	away.y = 0.0
	if away.length_squared() < 0.0001:
		away = Vector3.FORWARD
	away = away.normalized()
	r.set_meta("rest_y", r.position.y)
	r.billboard = BaseMaterial3D.BILLBOARD_DISABLED
	var cam: Camera3D = SceneFade.camara_de(self)
	if cam != null:
		var d: Vector3 = cam.global_position - r.global_position
		d.y = 0.0
		if d.length_squared() > 0.0001:
			r.rotation.y = atan2(d.x, d.z)

	var local: Vector3 = r.global_transform.basis.inverse() * away
	var side: float = 74.0 if local.x >= 0.0 else -74.0
	var tw: Tween = create_tween()
	tw.set_parallel(true)
	tw.tween_property(r, "rotation_degrees:z", side, 0.38) \
			.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)
	tw.tween_property(r, "position:y", r.position.y * 0.52, 0.38) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)



func _ref_get_up(r: AnimatedSprite3D) -> void:
	if not is_instance_valid(r):
		return
	var tw: Tween = create_tween()
	tw.set_parallel(true)
	tw.tween_property(r, "rotation_degrees:z", 0.0, REF_UP_S) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(r, "position:y", float(r.get_meta("rest_y", r.position.y)),
		REF_UP_S).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	SceneFade.timer(REF_UP_S, false).timeout.connect(
		_ref_card_after.bind(r))




func _ref_card_after(r: AnimatedSprite3D) -> void:
	if not is_instance_valid(r):
		return
	r.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
