func _recep_cam_on(ojo: Vector3, f: Vector2, ver: Array[Vector3]) -> void:
	var actual: Camera3D = SceneFade.camara_de(self)
	if actual == null:
		return
	if actual != _recep_cam:
		_recep_juego = actual
	if _recep_cam == null:
		_recep_cam = Camera3D.new()
		add_child(_recep_cam)
	_recep_cam.current = true


	if _fx != null and _fx.cam != _recep_cam:
		_recep_fx_cam = _fx.cam
		_fx.cam = _recep_cam
	_recep_ojo = ojo
	_recep_f = f.normalized() if f.length() > 0.01 else Vector2(0.0, 1.0)
	_recep_perfil.clear()


	_cam_base_frame = -1
	_recep_plano(0.0, ver, true)
	_recep_tapa()





func _recep_tapa() -> void:
	_recep_destapa()
	var yo: AnimatedSprite3D = _self_actor
	var foco: AnimatedSprite3D = _recep_foco if _recep_foco != null \
			and is_instance_valid(_recep_foco) else yo
	if _recep_cam == null or yo == null or not is_instance_valid(yo) or foco == null:
		return
	var c: Vector2 = Vector2(_recep_ojo.x, _recep_ojo.z)
	var mira: Vector3 = - _recep_cam.global_transform.basis.z
	var f: Vector2 = Vector2(mira.x, mira.z)
	f = f.normalized() if f.length() > 0.01 else _recep_f
	var der: Vector2 = Vector2(- f.y, f.x)
	var hasta: float =(Vector2(foco.position.x, foco.position.z) - c).dot(f) + RECEP_TAPA_FONDO_M
	var vp: Vector2 = SceneFade.rect_visible(self).size
	var tan_h: float = tan(deg_to_rad(_recep_cam.fov) * 0.5) * vp.x / maxf(vp.y, 1.0)
	var todos: Array = _teammate_actors + _rival_actors
	for a in todos:
		if not (a is AnimatedSprite3D) or not is_instance_valid(a) or a == yo or a == _recep_srv \
				or not a.visible:
			continue
		var rel: Vector2 = Vector2(a.position.x, a.position.z) - c
		var along: float = rel.dot(f)
		if along < RECEP_TAPA_DELANTE_M or along > hasta:
			continue
		if absf(rel.dot(der)) < along * tan_h + RECEP_TAPA_ANCHO_M:
			a.visible = false
			_recep_tapados.append(a)


func _recep_destapa() -> void:
	for a in _recep_tapados:
		if is_instance_valid(a):
			a.visible = true
	_recep_tapados.clear()




func _recep_ojo_pide(aqui: Vector2, hacia: Vector2) -> Vector3:
	var lat: Vector2 = Vector2(- hacia.y, hacia.x) * _recep_lado
	var c: Vector2 = aqui + hacia * RECEP_PIDE_M + lat * RECEP_PIDE_LADO_M
	return Vector3(c.x, RECEP_PIDE_Y, c.y)



func _recep_ver_pide(yo: AnimatedSprite3D, mira: Vector2) -> Array[Vector3]:
