	var suyos: Array = []
	for e: Dictionary in _entrada_extras:
		(mios if bool(e["mio"]) else suyos).append(LaEntrada.extra(_entrada_plan, e, 0.0))
	while mios.size() < LaEntrada.N_MIOS:
		mios.append(_entrada_lejos(mios.size()))
	while suyos.size() < LaEntrada.N_SUYOS:
		suyos.append(_entrada_lejos(LaEntrada.N_MIOS + suyos.size()))
	return {
		"kind": "regate",
		"name": "La entrada",
		"ball": LaEntrada.tu(_entrada_plan, 0.0),
		"target_z": -10.0,
		"teammates": [],
		"defenders": [LaEntrada.cuerpo_mundo(_entrada_plan, 0.0)],
		"extras_mates": mios,
		"extras_rivals": suyos,
		"entrada": true,
	}





func _entrada_sortea() -> void:
	_entrada_plan = LaEntrada.plan(_entrada_rng, _entrada_racha, LaEntrada.sitio(_entrada_rng))
	_entrada_extras = LaEntrada.extras(_entrada_rng, _entrada_plan)




func _entrada_lejos(i: int) -> Vector2:
	var yo: Vector2 = _entrada_plan["yo"]
	var x: float = yo.x +(float(i) - 3.0) * 6.0
	return Vector2(clampf(x, - Stadium.FIELD_HALF_W + 3.0, Stadium.FIELD_HALF_W - 3.0),
		maxf(yo.y - 40.0, 3.0))





func _entrada_previa(chance: Dictionary) -> void:
	if not bool(chance.get("entrada", false)) or _entrada_plan.is_empty():
		if _entrada_on or is_instance_valid(_entrada_capa):
			_entrada_apaga()
		return
	_entrada_toma_cuerpos()
	_entrada_reinicia()
	_entrada_pinta(0.0)
	_entrada_camara(0.0, true)

	_ondemand_deadline_us = Time.get_ticks_usec() + ENTRADA_PREVIA_RIEGA_US
	_entrada_riega_carreras()


func _entrada_arranca() -> void:
	state = State.SETUP
	_entrada_on = true
	_entrada_toma_cuerpos()
	_entrada_monta_barra()
	_entrada_reinicia()
	_entrada_pinta(0.0)
	_entrada_camara(0.0, true)
	_audio.whistle()
	_hud.show_hint(Entrada.texto("Toca en el blanco para barrerte", "Toca en el blanco para barrerte"))





	_hud.nota_en_practica = true
	_hud.set_rating(_live_rating())




func _entrada_toma_cuerpos() -> void:
	_entrada_rival = _rival_actors[0] if not _rival_actors.is_empty() else null
	_entrada_mios.clear()
	_entrada_suyos.clear()
	for i in mini(LaEntrada.N_MIOS, _teammate_actors.size()):
		_entrada_mios.append(_teammate_actors[i])
	for i in range(1, mini(1 + LaEntrada.N_SUYOS, _rival_actors.size())):
		_entrada_suyos.append(_rival_actors[i])


func _entrada_apaga() -> void:
	_entrada_on = false
	_hud.nota_en_practica = false
	_entrada_lenta_fuera(true)
	if is_instance_valid(_entrada_capa):
		_entrada_capa.queue_free()
	_entrada_capa = null
	_entrada_barra = null




func _entrada_lenta_fuera(de_golpe: bool = false) -> void:
	if not _entrada_lenta:
		return
	_entrada_lenta = false
	if _fx == null:
		return
	if de_golpe:
		_fx.slowmo(1.0)
	else:
		_fx.slowmo_off()




func _entrada_monta_barra() -> void:
	if is_instance_valid(_entrada_capa):
		return
	_entrada_capa = CanvasLayer.new()
	_entrada_capa.layer = 0
	add_child(_entrada_capa)
	_entrada_barra = LaEntradaBarra.new()
	_entrada_capa.add_child(_entrada_barra)




func _entrada_intento_nuevo() -> void:
	_entrada_sortea()
	_entrada_reinicia()
	_entrada_pinta(0.0)
	_entrada_camara(0.0, true)


func _entrada_reinicia() -> void:
	_entrada_t = 0.0
	_entrada_toque = -1.0
	_entrada_veredicto = ""
	_entrada_contacto_t = 0.0
	_entrada_contacto_hecho = false
	_entrada_fin_t = 0.0
	_entrada_se_va_t = -1.0
	_entrada_pito_t = -1.0
	_entrada_tarjeta_t = -1.0
	_entrada_lenta_fuera(true)
	var tu: Vector2 = LaEntrada.tu(_entrada_plan, 0.0)
	if is_instance_valid(_self_actor):
		_anim_lock.erase(_self_actor)
		_self_actor.speed_scale = 1.0
		_self_actor.position = Vector3(tu.x, _self_actor.position.y, tu.y)
	if is_instance_valid(_entrada_rival):
		_anim_lock.erase(_entrada_rival)
		_entrada_rival.speed_scale = 1.0

	_ref_card_end()
	if is_instance_valid(_ref_center):
		_anim_lock.erase(_ref_center)
		_ref_center.speed_scale = 1.0
	_entrada_arb = tu + _entrada_arbitro_off()
	_entrada_balon_prev = LaEntrada.balon_mundo(_entrada_plan, 0.0)
	_entrada_rival_prev = LaEntrada.cuerpo_mundo(_entrada_plan, 0.0)
	_entrada_reparte()




func _entrada_reparte() -> void:
	_entrada_extra_de.clear()
	var libres: Dictionary = {true: _entrada_mios.duplicate(), false: _entrada_suyos.duplicate()}
	for e: Dictionary in _entrada_extras:
		var cola: Array = libres[bool(e["mio"])]
		if not cola.is_empty():
			_entrada_extra_de[cola.pop_front()] = e
	var i: int = -1
	var b: Vector2 = LaEntrada.balon_mundo(_entrada_plan, 0.0)
	for a: AnimatedSprite3D in _entrada_mios + _entrada_suyos:
		i += 1
		if not is_instance_valid(a):
			continue
		_anim_lock.erase(a)
		a.speed_scale = 1.0
		if _entrada_extra_de.has(a):
			continue
		var q: Vector2 = _entrada_lejos(i)
		a.position = Vector3(q.x, a.position.y, q.y)
		_face(a, Vector3(b.x - q.x, 0.0, b.y - q.y))


func _entrada_step(delta: float) -> void:
	_entrada_t += delta
	_entrada_riega()
	var p: Dictionary = _entrada_plan
	if _entrada_veredicto.is_empty() and LaEntrada.se_fue(p, _entrada_t):
		_entrada_veredicto = LaEntrada.SE_VA
		_entrada_se_va_t = _entrada_t
		_entrada_racha = 0
		_entrada_fin_t = ENTRADA_FIN_S
		_entrada_lenta_fuera()
		_bump_rating("recu_lost")
		_hud.show_message(I18n.t("¡SE TE VA!"), CareerTheme.DANGER, 1.0)
		_audio.ooh()


	if _entrada_veredicto.is_empty() and not _entrada_lenta and LaEntrada.cursor(p, _entrada_t) \
			>= - float(LaEntrada.zonas(p)[LaEntrada.AMARILLA]):
		_entrada_lenta = true
		if _fx != null:
			_fx.slowmo(ENTRADA_LENTA)
	if _entrada_toque >= 0.0 and not _entrada_contacto_hecho \
			and _entrada_t >= _entrada_contacto_t:
		_entrada_contacto()
	if _entrada_pito_t > 0.0:
		_entrada_pito_t -= delta
		if _entrada_pito_t <= 0.0:
			_ref_pita()
			if _entrada_veredicto == LaEntrada.AMARILLA:
				_entrada_tarjeta_t = REF_YELLOW_DELAY_S
	if _entrada_tarjeta_t > 0.0:
		_entrada_tarjeta_t -= delta
		if _entrada_tarjeta_t <= 0.0:

			_ref_show_card(_ref_center, false, false, "", true)
			_bump_rating("pique_amarilla")
			_hud.show_message(I18n.t("¡AMARILLA!"), RefCard.AMARILLA, 1.4)


	if not _entrada_veredicto.is_empty():
		_entrada_fin_t -= delta
		if _entrada_fin_t <= 0.0:
			_entrada_intento_nuevo()
			return
	_entrada_pinta(delta)
	_entrada_camara(delta)




static func _entrada_frena(desde: Vector2, vel: Vector2, dur: float, s: float) -> Vector2:
	var f: float = clampf(s / dur, 0.0, 1.0)
	return desde + vel *(dur * 0.5 *(1.0 -(1.0 - f) *(1.0 - f)))





func _entrada_tu_pos(t: float) -> Vector2:
	var p: Dictionary = _entrada_plan
	if _entrada_toque >= 0.0:
		var x: float = clampf((t - _entrada_toque) * ENTRADA_BARRIDA_F / LaEntrada.T_LLEGA,
			0.0, 1.0)
		return _entrada_barrida_desde.lerp(_entrada_barrida_fin, 1.0 -(1.0 - x) *(1.0 - x))
	if _entrada_se_va_t >= 0.0:
		return _entrada_frena(LaEntrada.tu(p, _entrada_se_va_t), Vector2(0.0, LaEntrada.V_TU),
			ENTRADA_FRENA_S, t - _entrada_se_va_t)
	return LaEntrada.tu(p, t)





func _entrada_pinta(delta: float) -> void:
	var p: Dictionary = _entrada_plan
	var t: float = _entrada_t
	var post: bool = _entrada_contacto_hecho
	var s: float = t - _entrada_contacto_t
	var limpia: bool = _entrada_veredicto == LaEntrada.LIMPIA
	var r: Vector2 = LaEntrada.cuerpo_mundo(p, t)
	var b: Vector2 = LaEntrada.balon_mundo(p, t)
	if post:
		r = _entrada_frena(_entrada_rival_desde, _entrada_rival_vel,
			ENTRADA_FRENA_S if limpia else ENTRADA_CAIDA_S, s)
		b = _entrada_frena(_entrada_suelto_desde, _entrada_suelto_vel,
			ENTRADA_SUELTA_S if limpia else ENTRADA_RUEDA_S, s)
	if is_instance_valid(_entrada_rival):
		var vr: Vector2 =(r - _entrada_rival_prev) / delta if delta > 0.0 else Vector2.ZERO
		_entrada_rival_prev = r
		_entrada_rival.position = Vector3(r.x, _entrada_rival.position.y, r.y)


		if not (post and not limpia):
			var vm: Vector2 = LaEntrada.vel_mundo(p)
			if vr.length() > 0.35:
				_play_run(_entrada_rival, Vector3(vr.x, 0.0, vr.y))
			elif not post:
				_face(_entrada_rival, Vector3(vm.x, 0.0, vm.y))
			else:
				_face(_entrada_rival, Vector3(b.x - r.x, 0.0, b.y - r.y))

	if is_instance_valid(_self_actor):
		var yo: Vector2 = _entrada_tu_pos(t)
		var paso: Vector2 = yo - Vector2(_self_actor.position.x, _self_actor.position.z)
		_self_actor.position = Vector3(yo.x, _self_actor.position.y, yo.y)
		if _entrada_toque < 0.0:
			if delta > 0.0 and paso.length() > 0.2 * delta:
				_play_run(_self_actor, Vector3(paso.x, 0.0, paso.y))
			else:
				_face(_self_actor, Vector3(r.x - yo.x, 0.0, r.y - yo.y))
	_entrada_arbitro(delta, r)
	_entrada_pinta_extras(delta, b)
	var vb: Vector2 =(b - _entrada_balon_prev) / delta if delta > 0.0 else Vector2.ZERO
	_entrada_balon_prev = b
	_ball_field = b
	_ball.position = Vector3(b.x, BALL_VISUAL_D * 0.5, b.y)
	_ball_roll(vb)
	if is_instance_valid(_entrada_barra):
		var congelada: float = LaEntrada.cursor(p, _entrada_toque) if _entrada_toque >= 0.0 \
				else NAN
		_entrada_barra.pinta(LaEntrada.cursor(p, t), congelada, LaEntrada.zonas(p),
			_entrada_racha, _entrada_veredicto)





func _entrada_pinta_extras(delta: float, balon: Vector2) -> void:
	var p: Dictionary = _entrada_plan
	var t: float = _entrada_t
	var t_para: float = _entrada_contacto_t if _entrada_contacto_hecho else -1.0
	for a: AnimatedSprite3D in _entrada_extra_de:
		if not is_instance_valid(a):
			continue
		var e: Dictionary = _entrada_extra_de[a]
		var vel: Vector2 = e["vel"]
		var q: Vector2 = LaEntrada.extra(p, e, t)
		if t_para >= 0.0:
			q = _entrada_frena(LaEntrada.extra(p, e, t_para), vel, ENTRADA_FRENA_S, t - t_para)
		var paso: Vector2 = q - Vector2(a.position.x, a.position.z)
		a.position = Vector3(q.x, a.position.y, q.y)
		if delta > 0.0 and paso.length() > 0.2 * delta:
			_play_run(a, Vector3(paso.x, 0.0, paso.y))
		elif delta <= 0.0 and t_para < 0.0:
			_face(a, Vector3(vel.x, 0.0, vel.y))
		else:
			_face(a, Vector3(balon.x - q.x, 0.0, balon.y - q.y))



func _entrada_arbitro_off() -> Vector2:
	return Vector2(- float(_entrada_plan.get("lado", 1)) * ENTRADA_ARBITRO.x, ENTRADA_ARBITRO.y)






func _entrada_arbitro(delta: float, rival: Vector2) -> void:
	var a_ref: AnimatedSprite3D = _ref_center
	if not is_instance_valid(a_ref):
		return
	var p: Dictionary = _entrada_plan
	var t: float = _entrada_t
	var quieto: bool = int(_anim_lock.get(a_ref, 0)) > Time.get_ticks_msec()
	var off: Vector2 = _entrada_arbitro_off()
	var a: Vector2 = LaEntrada.tu(p, t) + off
	var t_para: float = _entrada_se_va_t
	if t_para < 0.0 and _entrada_contacto_hecho:
		t_para = _entrada_contacto_t
	if t_para >= 0.0:
		a = _entrada_frena(LaEntrada.tu(p, t_para) + off, Vector2(0.0, LaEntrada.V_TU),
			ENTRADA_FRENA_S, t - t_para)
	if _entrada_contacto_hecho and _entrada_veredicto != LaEntrada.LIMPIA:
		var hacia: Vector2 = _entrada_arb - rival
		var meta: Vector2 = rival +(hacia.normalized() if hacia.length() > 0.01
			else Vector2(0.0, -1.0)) * ENTRADA_ARB_CERCA
		a = _entrada_arb if quieto else _entrada_arb.move_toward(meta, ENTRADA_ARB_V * delta)
	var paso: Vector2 = a - _entrada_arb
	_entrada_arb = a
	a_ref.position = Vector3(a.x, a_ref.position.y, a.y)
	if quieto:
		return
	if delta > 0.0 and paso.length() > 0.2 * delta:
		_play_run(a_ref, Vector3(paso.x, 0.0, paso.y))
	else:
		_face(a_ref, Vector3(rival.x - a.x, 0.0, rival.y - a.y))











func _entrada_camara(delta: float, de_golpe: bool = false) -> void:
	if _entrada_plan.is_empty() or not is_instance_valid(_self_actor):
		return
	var p: Dictionary = _entrada_plan
	var grupo: Array[Vector2] = [Vector2(_self_actor.position.x, _self_actor.position.z),
		_ball_field]
	if is_instance_valid(_entrada_rival):
		grupo.append(Vector2(_entrada_rival.position.x, _entrada_rival.position.z))
	var x0: float = INF
	var x1: float = - INF
	var z0: float = INF
	var z1: float = - INF
	for q: Vector2 in grupo:
		x0 = minf(x0, q.x)
		x1 = maxf(x1, q.x)
		z0 = minf(z0, q.y)
		z1 = maxf(z1, q.y)
	var k: float = clampf(_entrada_t / LaEntrada.t_ideal(p), 0.0, 1.0)
	k = k * k *(3.0 - 2.0 * k)
	var vp: Vector2 = SceneFade.rect_visible(self).size
	var tan_h: float = tan(deg_to_rad(_aim_cam.fov * 0.5))
	if _aim_cam.keep_aspect == Camera3D.KEEP_HEIGHT and vp.y > 0.0:
		tan_h *= vp.x / vp.y
	var lejos: float = maxf(lerpf(ENTRADA_CAM_LEJOS, ENTRADA_CAM_CERCA, k),
		((x1 - x0) * 0.5 + ENTRADA_CAM_MARGEN) / maxf(tan_h, 0.05))
	var cx: float =(x0 + x1) * 0.5
	var lado: float = float(p["lado"])
	var meta: Vector3 = Vector3(cx + lado * lerpf(ENTRADA_CAM_LADO.x, ENTRADA_CAM_LADO.y, k),
		ENTRADA_CAM_ALTO, z1 + lejos)
	if de_golpe:
		_aim_cam.global_position = meta
	else:
		_aim_cam.global_position = _aim_cam.global_position.lerp(meta,
			1.0 - exp(- ENTRADA_CAM_STIFF * delta))
	_aim_cam.look_at(Vector3(cx, 0.0,(z0 + z1) * 0.5) + ENTRADA_CAM_MIRA, Vector3.UP)



func _entrada_input(event: InputEvent) -> void:
	if (event is InputEventScreenTouch and event.pressed) \
			or Entrada.acepta(event):
		_entrada_toca()





func _entrada_toca() -> void:
	if not _entrada_veredicto.is_empty() or _entrada_toque >= 0.0:
		return
	if not LaEntrada.cuenta(_entrada_plan, _entrada_t):
		return
	_entrada_toque = _entrada_t
	_entrada_veredicto = LaEntrada.juzga(_entrada_plan, _entrada_t)
	_entrada_barrida(LaEntrada.barrida(_entrada_plan, _entrada_t, _entrada_veredicto))
	if _entrada_veredicto == LaEntrada.LIMPIA:
		_entrada_contacto_t = _entrada_t + LaEntrada.T_LLEGA
	else:
		_entrada_contacto_t = LaEntrada.t_caida(_entrada_plan, _entrada_t)
	var queda: float = ENTRADA_FIN_S
	if _entrada_veredicto == LaEntrada.FALTA:
		queda = ENTRADA_FALTA_S
	elif _entrada_veredicto == LaEntrada.AMARILLA:
		queda = ENTRADA_AMARILLA_S
	_entrada_fin_t =(_entrada_contacto_t - _entrada_t) + queda





func _entrada_barrida(b: Dictionary) -> void:
	var desde: Vector2 = b["desde"]
	var cuerpo: Vector2 = b["cuerpo"]
	var dir: Vector2 = b["dir"]
	var f: float = 1.0 -(1.0 - ENTRADA_BARRIDA_F) *(1.0 - ENTRADA_BARRIDA_F)
	_entrada_barrida_desde = desde
	_entrada_barrida_fin = desde +(cuerpo - desde) / f
	_entrada_barrida_dir = dir
	if not is_instance_valid(_self_actor):
		return
	if _play_dir_gesture(_self_actor, "slide", dir, 900):
		_self_actor.speed_scale = SLIDE_ANIM_SPEED
	var y: float = _self_actor.position.y
	_slide_surco(Vector3(desde.x, y, desde.y),
		Vector3(_entrada_barrida_fin.x, y, _entrada_barrida_fin.y),
		LaEntrada.T_LLEGA / ENTRADA_BARRIDA_F)
	_splash_at(desde, Vector3(dir.x, 0.0, dir.y), 20.0)





func _entrada_contacto() -> void:
	_entrada_contacto_hecho = true
	var p: Dictionary = _entrada_plan
	var tc: float = _entrada_contacto_t
	var vm: Vector2 = LaEntrada.vel_mundo(p)
	var dm: Vector2 = vm.normalized()
	_entrada_suelto_desde = LaEntrada.balon_mundo(p, tc)
	_entrada_rival_desde = LaEntrada.cuerpo_mundo(p, tc)
	_haptic(40)
	_audio.kick()
	_entrada_lenta_fuera()
	if _fx != null:
		_fx.hit_stop(ENTRADA_GOLPE.x, ENTRADA_GOLPE.y, ENTRADA_GOLPE.z)
		_fx.shake(ENTRADA_SACUDIDA)
	if _entrada_veredicto == LaEntrada.LIMPIA:



		var n: Vector2 = p["n"]
		_entrada_suelto_vel = - n *(2.0 * ENTRADA_LIMPIA_M / ENTRADA_SUELTA_S) \
				+ Vector2(0.0, LaEntrada.V_TU)
		_entrada_rival_vel = vm
		_entrada_racha += 1
		_bump_rating("recu_win")
		_hud.show_message(I18n.t("¡BALÓN LIMPIO!"), CareerTheme.TEXT, 1.0)
		return
	_entrada_suelto_vel = vm
	_entrada_rival_vel = dm *(2.0 * ENTRADA_CAIDA_M / ENTRADA_CAIDA_S)
	_entrada_racha = 0
	if is_instance_valid(_entrada_rival):
		_play_dir_gesture(_entrada_rival, "fall", dm,
			int((_entrada_fin_t + 0.5) * 1000.0))
	_entrada_pito_t = ENTRADA_PITO_S
	_hud.show_message(I18n.t("FALTA"), CareerTheme.DANGER, 1.0)
	_audio.ooh()









func _entrada_riega() -> void:
	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + ONDEMAND_BUDGET_US)
	_entrada_riega_carreras()
	for d: String in ["north", "south", "east", "west"]:
		if is_instance_valid(_self_actor):
			_anim_usable(_self_actor, "slide_%s" % d)
		if is_instance_valid(_entrada_rival):
			_anim_usable(_entrada_rival, "fall_%s" % d)




func _entrada_riega_carreras() -> void:
	for a: AnimatedSprite3D in _entrada_extra_de:
		if is_instance_valid(a):
			var v: Vector2 = _entrada_extra_de[a]["vel"]
			_anim_usable(a, "run_" + _dir_name_move(a, Vector3(v.x, 0.0, v.y)))
