const PENAL_BEAT_SLOW: float = 0.92
const PENAL_BEAT_FAST: float = 0.58
const PENAL_RAMP_T: float = 5.0
const PENAL_LUB: float = 0.1
const PENAL_DUB_AT: float = 0.3
const PENAL_DUB_K: float = 0.55
const PENAL_FOV_DIP: float = 1.25



const PENAL_STILL_V: float = 0.45

var _penal_pulso: bool = false
var _penal_pulso_t: float = 0.0
var _penal_fov0: float = 0.0

func _refresh_penal_pulso(delta: float) -> void:






	var quiero: bool = _chance_kind == "penal" and not _cedida_en_curso \
			and not _cobro_corre \
			and (state == State.AIMING or state == State.STRIKING)
	if quiero and not _penal_pulso:
		_penal_pulso = true
		_penal_pulso_t = 0.0
		_penal_fov0 = _aim_fov_base
	elif not quiero and _penal_pulso:
		_penal_pulso = false
		_aim_fov_base = _penal_fov0
		if _hud:
			_hud.set_penal_pulso(0.0)
		return
	if not _penal_pulso:
		return
	if Settings.reduce_motion:
		if _hud:
			_hud.set_penal_pulso(PENAL_STILL_V)
		return



	_penal_pulso_t += delta / maxf(Engine.time_scale, 0.05)
	var urg: float = clampf(_penal_pulso_t / PENAL_RAMP_T, 0.0, 1.0)
	var compas: float = lerpf(PENAL_BEAT_SLOW, PENAL_BEAT_FAST, urg)
	var f: float = fposmod(_penal_pulso_t, compas) / compas
	var env: float = _penal_golpe(f) + PENAL_DUB_K * _penal_golpe(f - PENAL_DUB_AT)
	env = clampf(env, 0.0, 1.0)
	_aim_fov_base = _penal_fov0 - PENAL_FOV_DIP * env
	if _hud:
		_hud.set_penal_pulso(env)





func _penal_golpe(x: float) -> float:
	if x < 0.0 or x > PENAL_LUB * 3.0:
		return 0.0
	var u: float = x / PENAL_LUB


	return exp(- u * u * 1.6) *(1.0 - exp(- u * 6.0)) * 1.38


func _process(_delta: float) -> void:



	var perf: bool = PerfContadores.activo
	if perf:
