func _festejo_por_peso(spot: String, anchor: Vector3) -> void:
	if _lectura.is_empty():
		return
	if not _celeb_a_por_balon:
		if bool(_lectura.get("portero_cruza", false)) and spot != CELEB_SPOT_GK:
			_keeper_run(anchor)
		if bool(_lectura.get("banquillo", false)) and spot != CELEB_SPOT_ALL:
			_bench_invasion(anchor)
