func _celeb_centra_tumbado(f: Vector3) -> void:
	var alto: float = SceneFade.rect_visible(self).size.y
	var cuerpo: Vector3 = Vector3(f.x, PLAYER_HEIGHT_M * 0.5, f.z)
	var q: Vector3 = _celeb_cam.global_transform.affine_inverse() * cuerpo
	if q.z > -0.1:
		return
	var focal: float = alto /(2.0 * tan(deg_to_rad(_celeb_cam.fov * 0.5)))
	var ahora: float = atan2(q.y, - q.z)
	var meta: float = - atan((CELEB_CUERPO_Y_H - 0.5) * alto / focal)
	_celeb_cam.rotate_object_local(Vector3.RIGHT, ahora - meta)































