func _update_drive(delta: float) -> void:




	if _drive_lock_t > 0.0:
		_drive_lock_t -= delta
		_drive_steer = Vector2.ZERO






















	var tope: float = _drive_run_spd * _puddle_slow(_drive_pos)




	var spd_now: float = minf(tope, PAD_CAMINA_MPS) if _pad_al_paso else tope












	if _drive_steer.length_squared() > 0.0001:
		_drive_facing = _drive_steer.normalized()
		var paso: Array = Duel.step_sprint_cut(_drive_vel, _drive_facing,
			spd_now, _drive_accel, _drive_control, _drive_cut_armed,
			_drive_cut_recov, delta)


		if _drive_cut_armed and not bool(paso[1]):
			_fx_quiebre(_drive_pos, _drive_vel.length())






			if _resbalon_yo_hay(Duel.cut_angle(_drive_vel, _drive_facing),
					_drive_vel, tope, _drive_pos):
				_drive_resbalon(_drive_vel)




				return
		_drive_vel = paso[0]
		_drive_cut_armed = paso[1]
		_drive_cut_recov = paso[2]
	else:
		_drive_vel = Vector2.ZERO
		_drive_cut_armed = true
		_drive_cut_recov = false
	_drive_pos += _drive_vel * delta










	_paso_balon_carry(_drive_steer, _drive_pos,
		_drive_vel, _drive_facing, spd_now, _drive_control, _drive_accel,
		_def_mas_cerca_drive(), Callable(), delta)

	_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5 + _saque_caida_h, _ball_field.y)
	_puddle_wake(_drive_vel, delta)



	_ball_track()



	if Drive.walked_in(_ball_field, GOAL_HALF_W):
		_drive_walked_in()
		return
	if Drive.out_of_play(_ball_field):
		_drive_out()
		return

	var pace_now: float = clampf(_drive_vel.length() / maxf(tope, 0.01), 0.0, 1.0)

	_carry_fatigue = Duel.tire_step(_carry_fatigue, pace_now, _carry_fisico, delta)


	_refresh_carry_control()




	var suelto: bool = _drive_steer.length_squared() > 0.0001
	var v_bola: float = _ball_vel.length() if suelto else _drive_vel.length()
	if v_bola > 0.05 or pace_now > 0.05:

		_ball_roll(_ball_vel if suelto else _drive_vel)
	else:
		_ball.speed_scale = 1.0







	if _drive_vis_off.length() > 0.001:





		_drive_vis_off = _drive_vis_off.limit_length(
			maxf(_drive_vis_off.length() - _drive_step_spd * delta, 0.0))
	if is_instance_valid(_self_actor):
		var vis: Vector2 = _drive_pos + _drive_vis_off
		_self_actor.position = Vector3(vis.x, _self_actor.position.y, vis.y)





		var stepping: bool = _drive_vis_off.length() > 0.001
































		var step_v: Vector2 = _drive_facing


		if _anim_lock.get(_self_actor, 0) > Time.get_ticks_msec():
			pass
		elif _pad_al_paso and not stepping and pace_now > 0.05 \
				and _drive_vel.length() <= PAD_CAMINA_MPS * 1.1:








			_self_actor.set_meta("pace_walk_until", Time.get_ticks_msec() + 250)
			_play_run(_self_actor, Vector3(step_v.x, 0.0, step_v.y))
		elif pace_now > 0.05 or stepping:




















			_self_actor.set_meta("pace_run_until", Time.get_ticks_msec() + 250)


			_self_actor.remove_meta("pace_walk_until")
			_play_run(_self_actor, Vector3(step_v.x, 0.0, step_v.y))
			_self_actor.speed_scale = clampf(
				0.55 +(maxf(pace_now, 0.6) if stepping else pace_now), 0.55, 1.6)
		else:
			_self_actor.speed_scale = 1.0







	if _ring_world_frozen():
		_drive_press_step(delta, true, true)
	else:
		_drive_press_step(delta, _drive_coast)

	if _saque_respiro_t > 0.0 and _drive_active:
		_saque_respeto(_ball_field)










	if not _ring_world_frozen():
		_drive_offtrap_step(delta)
	if _ring_world_frozen():
		_drive_release_mates()
	else:
		_drive_mate_step(delta, _drive_coast)
	if _drive_coast:
		_drive_coast_clear()




















	if _carga_open(delta):
		return



	if not _drive_coast and Settings.dif_steal_on() and _saque_respiro_t <= 0.0:
		var tk_d: Array = _rival_tackles()



		_avisa_robo(_margen_robo(_defender_pos, tk_d, _drive_control))





		var pace_robo_d: float = clampf(
			_drive_vel.length() / maxf(_drive_run_spd, 0.01), 0.0, 1.0)
		var thief: int = Duel.stealer(_defender_pos, _ball_field, _drive_control,
			tk_d, _lance_bonus(_defender_pos), _drive_pos, pace_robo_d)
		if thief >= 0:
			_drive_stolen(thief)
			return







	if is_instance_valid(_keeper) and not _ring_world_frozen():





		if _drive_coast and _keeper_lancing():









			_keeper_lance_step(delta, _drive_pos)
		elif _drive_coast:
			var kb: Array = Drive.press_brake(
				Vector2(_keeper.position.x, _keeper.position.z), _keeper_out_vel,
				lerpf(KEEPER_OUT_SPD_MIN, KEEPER_OUT_SPD_MAX, _keeper_speed), delta)
			_keeper.position = Vector3((kb[0] as Vector2).x, _keeper.position.y,
				(kb[0] as Vector2).y)
			_keeper_out_vel = kb[1]





			if _keeper_out_vel.length() >= KEEPER_HOME_STEP_MPS:
				_play_keeper_out(Vector3(_keeper_out_vel.x, 0.0, _keeper_out_vel.y))













		elif _keeper_sale_o_vuelve(delta):
			return













	if not _aiming and not _jala_corre:
		if _drive_steer.length_squared() > 0.0001:
			_aim.show_aim(_aim_origin(),
				Vector3(_drive_facing.x, 0.0, _drive_facing.y), _drive_steer.length())
		else:
			_aim.hide_aim()
	_move_drive_ring()




	if _drive_coast:
		_drive_coast_t += delta
		var gap: float = _ball_field.distance_to(_drive_pos) - Duel.BALL_FOOT
		if Drive.coast_done(_drive_vel, gap, _drive_coast_t):
			_freeze_drive()




























