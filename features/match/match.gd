func _recu_bloque_destino(casa: Vector2, k: Vector2) -> Vector2:
	var d: Vector2 = _ball_field - _home_ball0
	var destino: Vector2 = casa
	for eje in 2:
		if absf(d[eje]) < 0.001:
			continue
		var signo: float = signf(d[eje])
		var limite: float = Recupera.EDGE_X * signo if eje == 0 \
				else (Stadium.FIELD_DEPTH if signo > 0.0 else Recupera.HALFWAY - 6.0)
		var sitio_balon: float = maxf((limite - _home_ball0[eje]) * signo, 0.01)
		var sitio_cuerpo: float = maxf((limite - casa[eje]) * signo, 0.0)
		var acompana: float = clampf(sitio_cuerpo / sitio_balon, 0.0, 1.0)
		destino[eje] += d[eje] * k[eje] * acompana
	return destino






func _recu_drift(a: AnimatedSprite3D, delta: float) -> void:
	var pos: Vector2 = Vector2(a.position.x, a.position.z)






	if not _home_pos.has(a):
		_home_pos[a] = pos
	var casa: Vector2 = _home_pos[a]
	var li: int = int(a.get_meta("recu_linea", 1))
	var mio: bool = bool(a.get_meta("recu_mio", true))
	var k: Vector2 =(RECU_BLOQUE_MIO[li] if mio else RECU_BLOQUE_SUYO[li])



	var jk: float = float(a.get_meta("recu_jit_k", 0.5))
	k = Vector2(k.x * lerpf(RECU_GRANO_K.x, RECU_GRANO_K.y, jk),
		k.y * lerpf(RECU_GRANO_K.y, RECU_GRANO_K.x, jk))
	var goal: Vector2 = _recu_bloque_destino(casa, k)


	var cerca: float = 0.0
	var d_bal: float = pos.distance_to(_ball_field)
	if d_bal < RECU_IMAN_R:
		cerca = 1.0 - d_bal / RECU_IMAN_R
		goal = goal.lerp(_ball_field, RECU_IMAN_W * cerca)

	if mio:
		if li == 0:
			goal.y = maxf(goal.y, _ball_field.y + RECU_LINEA_MI_DEF)
		elif li == 2:
			goal.y = minf(goal.y, Recupera.HALFWAY + RECU_LINEA_MI_DEL)
	else:
		if li == 2:
			goal.y = maxf(goal.y, _ball_field.y + RECU_LINEA_SU_DEL)
		elif li == 0:
			goal.y = minf(goal.y, _ball_field.y - RECU_LINEA_SU_DEF)







		goal.y = minf(goal.y, _recu_fdj_cache - Recupera.OFFSIDE_HOLGURA)
	goal = _recu_corral(_inside_field(goal))




	var jh: float = float(a.get_meta("recu_jit_h", 0.5))
	var holgura: float = lerpf(RECU_GRANO_H.x, RECU_GRANO_H.y, jh)



	var v: Vector2 = a.get_meta("recu_drift_vel", Vector2.ZERO)
	var falta: Vector2 = goal - pos
	var jv: float = float(a.get_meta("recu_jit_v", 0.5))
	var spd: float = RECU_BLOQUE_SPD * lerpf(RECU_GRANO_V.x, RECU_GRANO_V.y, jv) \
			* lerpf(1.0, RECU_IMAN_SPD, cerca)
	var deseada: Vector2 = Vector2.ZERO
	if falta.length() >= holgura or v.length() > 0.02:
		var carrera: float = minf(spd,
			maxf(falta.length() - holgura * RECU_BLOQUE_PARADA_F, 0.0)
				* RECU_LLEGADA_K)
		deseada = falta.normalized() * carrera
	v = v.move_toward(deseada, spd * RECU_BLOQUE_ACCEL_K * delta)
	if deseada.is_zero_approx() and v.length() < 0.02:
		v = Vector2.ZERO
	var np: Vector2 = _recu_corral(_inside_field(pos + v * delta))
	var movido: Vector2 = np - pos
	a.position = Vector3(np.x, a.position.y, np.y)
	a.set_meta("recu_drift_vel", movido / maxf(delta, 0.0001))
	if movido.length() > 0.0005:
		_play_run(a, Vector3(movido.x, 0.0, movido.y))
	else:
		_face_ball(a)







