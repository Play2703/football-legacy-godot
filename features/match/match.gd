func _sim_ctx(rival: Dictionary, to_min: int = 0) -> Dictionary:
	var shown: float = clampf(Career.energy, 0.0, 100.0)













	var end_min: int = 120 if _extra_time else 90
	var out_early: bool = _play_to > _play_from and _play_to < end_min
	var gone: bool = _sub_done or _hooked or _injured_out \
			or (out_early and to_min >= _play_to)
	return {
		"minute": match_minute,
		"score_diff": team_goals - rival_goals,
		"score_text": "%d-%d" % [team_goals, rival_goals],


		"tie_carry": _tie_carry(),




		"ko_rule": GameState.tie_rule(GameState.current_fixture()),
		"ko_seed": _ko_sembrado(),
		"momentum": _momentum.level(),
		"player_name": Career.player_name,


		"rival_name": Nations.team_label(rival),
		"style": _play_style,
		"intensity": Career.intensity,



		"derby": _is_derby,
		"on_pitch": not gone and not _banca_fuera() and match_minute >= _play_from \
				and match_minute < _play_to,





		"left_pitch": gone or (match_minute >= _play_to and _play_to > _play_from),
		"asked_out": _sub_requested,
		"sub_excused": _sub_excused,
		"hooked": _hooked,


		"injured": _injured_out,



		"low_energy": shown < Career.INJURY_RAMP_TOP,





		"rating": _live_rating(),
		"rating_prev": _sim_rating_prev,
		"pos": Squad.USER_POS,



		"ko_tied": _ko_tied(),


		"pique": _pique_ctx(),


		"cano": _cano_ctx(),
	}














func _roll_live_injury(from_min: int, to_min: int) -> void:
	if _injured_out or _hooked or _sub_done or Career.pending_injury_weeks > 0 \
			or not _practice_kind.is_empty() or _shootout_active or _extra_time \
			or GameState.readonly_save or not Career.live_match_open():
		return
	for m in range(from_min, to_min):
		if randf() < Career.live_injury_minute_p(m + 1):
			_injury_strike(m + 1, false)
			return









func _injury_strike(at_min: int, trauma: bool) -> void:
	Career.pending_injury_weeks = Career.roll_injury_weeks(trauma)
	Career.pending_injury_min = at_min
	Career.pending_injury_trauma = trauma


	_injury_spot = _ball_field
	_injured_out = true
	_cara(_self_actor, "dolor", 6.0)


func _sim_on_pitch() -> bool:
	if _hooked or _sub_done or _injured_out or _banca_fuera():
		return false
	if _play_to <= _play_from:
		return true
	return match_minute >= _play_from and match_minute < _play_to











func _update_sim_energy() -> void:


	if _play_to > _play_from and not _banca_fuera():
		var billed_to: int = clampi(match_minute, _play_from, _play_to)
		if billed_to > _energy_billed_min:
			var billed_from: int = _energy_billed_min
			Career.accrue_live_spend(float(billed_to - _energy_billed_min))
			_energy_billed_min = billed_to





			_roll_live_injury(billed_from, billed_to)
	var e: float = clampf(Career.energy, 0.0, 100.0)
	_sim_screen.set_energy(e / 100.0, e < Career.LOW_ENERGY)




	_sim_screen.set_on_pitch(_sim_on_pitch())


	_sim_screen.set_lesionado(_injured_out)








	var nota: float = _live_rating()
	_sim_screen.set_rating(nota,
		0.0 if _sim_rating_prev < 0.0 else nota - _sim_rating_prev)


	_sim_rating_prev = nota






	if _sim_on_pitch() and not _sub_requested:
		var read: Dictionary = _sub_request_reading()
		_sim_screen.set_sub_reading(int(read.get("tone", Career.SUB_TONE_SNUB)),
			String(read.get("note", "")))


		_sim_screen.set_sub_hold(match_minute < _sub_hold_until)





func _goal_echo(kind: String) -> String:
	var diff: int = team_goals - rival_goals
	var sc: String = "%d-%d" % [team_goals, rival_goals]

	match kind:
		"goal_team":
			if diff > 0:
				return I18n.tf("AHORA MANDA TU EQUIPO EL {0}", [sc])
			elif diff == 0:
				return I18n.tf("TU EQUIPO EMPATA EL PARTIDO, {0}", [sc])
			return I18n.tf("TU EQUIPO RECORTA, {0}", [sc])
		"goal_rival":
			if diff < 0:
				return I18n.tf("SE ADELANTA EL RIVAL, {0}", [sc])
			elif diff == 0:
				return I18n.tf("EL RIVAL EMPATA, {0}", [sc])
			return I18n.tf("EL RIVAL RECORTA, {0}", [sc])
	return ""





func _inject_sub_note(lines: Array[Dictionary], from_min: int, to_min: int) -> void:
	var notes: Array[Dictionary] = []
	if _sub_in_min > from_min and _sub_in_min <= to_min:




		notes.append({"minute": _sub_in_min, "kind": "sub", "team": "you", "num": 0,
			"sub_in": true, "name": CareerTheme.caps(Career.player_name),
			"text": I18n.tf("ENTRA {0}", [CareerTheme.caps(Career.player_name)])})
		_sub_in_min = 0



	if _banca_nota_min > from_min and _banca_nota_min <= to_min:
		notes.append({"minute": _banca_nota_min, "kind": "neutral", "team": "you", "num": 0,
			"text": I18n.t("EL MÍSTER NO TE NECESITA HOY · TE QUEDAS EN LA BANCA")})
		_banca_nota_min = 0
	if _sub_out_min > from_min and _sub_out_min <= to_min:





		var pname: String = CareerTheme.caps(Career.player_name)
		var out_text: String
		var out_kind: String = "sub"
		if _injured_out:









			out_text = I18n.tf("{0} SALE LESIONADO · NO PUEDE CONTINUAR", [pname])
			out_kind = "injury_you"
		elif _hooked and _hook_reason == "banquillo":




			out_text = I18n.tf("EL TÉCNICO RETIRA A {0} · BALONAZO A SU PROPIO BANQUILLO",
				[pname])
		elif _hooked:



			out_text = I18n.tf("EL TÉCNICO RETIRA A {0} · ACTUACIÓN DEFICIENTE", [pname])
		elif _rested:



			out_text = I18n.tf("EL TÉCNICO RETIRA A {0} · OVACIÓN DEL ESTADIO", [pname])
		elif _sub_requested and _sub_welcome:




			out_text = I18n.tf("{0} SE VA ENTRE APLAUSOS · EL PARTIDO ESTÁ HECHO",
				[pname])
		elif _sub_requested:






			if _sub_excused:
				out_text = I18n.tf("{0} PIDE EL CAMBIO · NO LE QUEDA NADA", [pname])
			else:
				out_text = I18n.tf("{0} PIDE EL CAMBIO · EL BANQUILLO NO LO ENTIENDE",
					[pname])
		else:
			out_text = I18n.tf("SALE {0}", [pname])




		notes.append({"minute": _sub_out_min, "kind": out_kind, "team": "you", "num": 0,
			"sub_out": true,
			"name": CareerTheme.caps(Career.player_name), "text": out_text})





		if (_rested or (_sub_requested and _sub_welcome)) and is_instance_valid(_stadium):
			_stadium.crowd_react("home", "close")
		_sub_out_min = 0
	if notes.is_empty():
		return
	lines.append_array(notes)






	lines.sort_custom(func(a, b) -> bool:
		var ma: int = int(a["minute"])
		var mb: int = int(b["minute"])
		if ma != mb:
			return ma < mb
		return String(b.get("kind", "")) == "break" \
				and String(a.get("kind", "")) != "break")

























































