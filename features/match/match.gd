func _servicio_salto_arma(punto: Vector3, n: int, rumbo: Vector3 = Vector3.ZERO) -> Dictionary:

	var dir_h := Vector3(rumbo.x, 0.0, rumbo.z) if rumbo.length() > 0.001 \
			else Vector3(_shot_dir.x, 0.0, _shot_dir.z)
	dir_h = dir_h.normalized() if dir_h.length() > 0.001 else Vector3(0.0, 0.0, -1.0)


	var t: float = clampf(inverse_lerp(HEADER_CONTACT_BAND.x, HEADER_CONTACT_BAND.y,
		punto.y), 0.0, 1.0)
	var y0: float = _self_actor.position.y if is_instance_valid(_self_actor) else 0.0
	var spot := Vector3(punto.x, y0, punto.z) - dir_h * lerpf(HEADER_STEP_LOW, HEADER_STEP_HIGH, t)


	var desde: Vector3 = spot
	if is_instance_valid(_self_actor):
		var off: Vector3 = _self_actor.position - spot
		off.y = 0.0
		desde = spot + off.limit_length(1.2)









	var alto: float = lerpf(HEADER_JUMP_LOW, HEADER_JUMP_HIGH, t)
	var mira_h: Vector3 = dir_h
	if _serve_k > 0 and _serve_ruta.size() > _serve_k:
		var vin: Vector3 = _serve_ruta[_serve_k] - _serve_ruta[maxi(_serve_k - 3, 0)]
		if Vector2(vin.x, vin.z).length() > 0.001:
			mira_h = Vector3(- vin.x, 0.0, - vin.z).normalized()
	var vista: String = _dir_name(mira_h)
	var anim: String = "header_" + vista












	var palomita: bool = _servicio_palomita() and not _servicio_chilena()
	if palomita:
		var pal: String = "palomita_" + _perfil_hacia_arco_x(spot.x)
		_ondemand_deadline_us = maxi(_ondemand_deadline_us,
			Time.get_ticks_usec() + HEADER_GESTO_BUDGET_US)
		if _gesto_listo(_self_actor, pal):
			anim = pal
			vista = pal.trim_prefix("palomita_")
			alto = SERVICIO_PALOMITA_ALTO









	if _servicio_chilena() or (not palomita and punto.y > PALOMITA_H_SEAM
			and Vector2(punto.x, punto.z).length() < CHILENA_DIST_MAX
			and (chilena_forzada or (_servicio_chilena_sorteable()
			and int(Career.skills.get("precision", 0)) >= CHILENA_SELF_PRECISION
			and randf() < CHILENA_SORTEO.y))):
		vista = _dir_name(- dir_h)
		anim = "chilena_" + vista
		alto = lerpf(HEADER_JUMP_LOW, HEADER_JUMP_HIGH, t)
	_serve_vista = vista
	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + HEADER_GESTO_BUDGET_US)
	_gesto_listo(_self_actor, anim)
	return {"desde": desde, "spot": spot, "dir": dir_h, "y0": y0,
		"alto": alto, "n": n, "anim": anim, "vista": vista, "gesto": false}







func _servicio_salto_pose(s: Dictionary, falta: float) -> void:
	if not is_instance_valid(_self_actor):
		return
	if bool(s.get("pre", false)):
		_servicio_chilena_pose(s, falta)
		return
	var n: int = int(s["n"])
	var u: float = 1.0 - clampf(falta, 0.0, float(n)) / float(maxi(n, 1))
	var xz: Vector3 = Vector3(s["desde"]).lerp(Vector3(s["spot"]), sin(u * PI * 0.5))
	var sube: float = maxf(HEADER_JUMP_UP / SIM_DT, 1.0)
	var h: float = 0.0
	if falta < sube:
		var w: float = maxf(falta, 0.0) / sube
		h = float(s["alto"]) *(1.0 - w * w)
	_self_actor.position = Vector3(xz.x, float(s["y0"]) + h, xz.z)
	if bool(s["gesto"]):
		return
	var anim: String = String(s["anim"])
	var fps: float = _self_actor.sprite_frames.get_animation_speed(anim) if _self_actor.sprite_frames.has_animation(anim) else 12.0
	var chilena: bool = anim.begins_with("chilena_")
	var palomita: bool = anim.begins_with("palomita_")






	var reloj: float = maxf(_servicio_reloj_ruta(), 0.0001)
	var cuadro_golpe: int = CHILENA_CONTACT_FRAME if chilena \
			else (SERVICIO_PALOMITA_PICO if palomita else SERVICIO_CABEZA_PICO)
	var pico: float = float(cuadro_golpe) / maxf(fps, 1.0) / SIM_DT * reloj
	if falta > pico:
		return
	s["gesto"] = true

	if not _gesto_listo(_self_actor, anim):
		return
	_self_actor.flip_h = false
	_self_actor.speed_scale = 1.0
	_self_actor.play(anim)
	_serve_chilena = chilena
	if chilena:
		_chilena_viva = true




	var ya: float =(pico - maxf(falta, 0.0)) * SIM_DT * fps / reloj
	if ya > 0.0:
		_self_actor.set_frame_and_progress(int(ya), fmod(ya, 1.0))


	_anim_lock[_self_actor] = Time.get_ticks_msec() + int((maxf(falta, 0.0) * SIM_DT / reloj
		+(ACRO_T + 0.04 if palomita else 0.6)) * 1000.0)









func _servicio_cabezazo(_dir_tiro: Vector3, u: float, v: float) -> void:
