func _ball_screen_circle_en(p: Vector3) -> Array:
	var pintado: Vector3 = p \
			- _shot_cam.global_transform.basis.y *(BALL_PAD_PX * _ball.pixel_size)
	var center: Vector2 = _shot_cam.unproject_position(pintado)
	var edge: Vector2 = _shot_cam.unproject_position(
		pintado + _shot_cam.global_transform.basis.x *(BALL_VISUAL_D * 0.5))
	return [center, center.distance_to(edge)]





















func _ball_contact_at(screen_pos: Vector2) -> Vector2:
	var circle: Array = _strike_circle if _strike_circle.size() == 2 \
			else _ball_screen_circle()
	var center: Vector2 = circle[0]
	var radius: float = circle[1]
	if radius <= 1.0:
		return Vector2.INF
	var off: Vector2 =(screen_pos - center) / radius



	if off.length() > 1.0 + STRIKE_TOUCH_FORGIVE:
		return Vector2.INF
	return off.limit_length(1.0)





















