func _fence_jump(actor: AnimatedSprite3D, geo: Dictionary, is_focus: bool) -> void:
	if geo.is_empty():



		_start_celebration(actor)
		return
	var y: float = actor.position.y



	var dz: float = 0.0 if is_focus else randf_range(- FENCE_SPREAD, FENCE_SPREAD)
	var pre: Vector3 = Vector3(geo["pre"].x, y, geo["pre"].z + dz)
	var land: Vector3 = Vector3(geo["land"].x, y, geo["land"].z + dz)
	var hug: Vector3 = Vector3(geo["hug"].x, y, geo["hug"].z + dz)

	var top: Vector3 = Vector3(geo["fence"].x, y + FENCE_JUMP_H, geo["fence"].z + dz)
	var speed: float = FENCE_RUN_SPEED
	_run_target[actor] = pre
	_celeb_seal_run(actor, _flat_dist(actor.position, pre) / speed
		+ FENCE_JUMP_T + _flat_dist(land, hug) / speed)
	_play_run(actor, pre - actor.position)
	if is_focus:


		_celeb_focus_pos = hug
	var tw: Tween = create_tween()
	var via: Vector3 = _celeb_detour(actor.position, pre)
	if via != pre:
		tw.tween_property(actor, "position", via,
			maxf(_flat_dist(actor.position, via) / speed, 0.2))
		tw.tween_property(actor, "position", pre,
			maxf(_flat_dist(via, pre) / speed, 0.2))
	else:
		tw.tween_property(actor, "position", pre,
			maxf(_flat_dist(actor.position, pre) / speed, 0.3))
	tw.tween_callback(func() -> void:
		if not is_instance_valid(actor):
			return
		_run_target[actor] = land




		if _stadium != null and is_instance_valid(_stadium):
			_stadium.crowd_zone(hug, FENCE_ZONE_DUR))
	tw.tween_property(actor, "position", top, FENCE_JUMP_T * 0.55) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(actor, "position", land, FENCE_JUMP_T * 0.45) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	tw.tween_callback(func() -> void:
		if is_instance_valid(actor):
			_run_target[actor] = hug)
	tw.tween_property(actor, "position", hug,
		maxf(_flat_dist(land, hug) / speed, 0.3))
	tw.tween_callback(_start_celebration.bind(actor))
	_celeb_runs.append(tw)
































