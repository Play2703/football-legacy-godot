const BREATH_SPRINT: float = 6.0





var _breath_cd: Dictionary = {}
var _breath_prev: Dictionary = {}

func _tick_breath(delta: float) -> void:
	if _fx == null or _stadium == null or _actors == null \
			or not is_instance_valid(_actors):
		return






	var prog: float = GameState.season_progress()
	var cold: float = Weather.cold(prog) if prog >= 0.0 else 0.0
	if not WeatherWear.breath_on(_stadium.weather_id(), cold):
		return



	var vivos: Dictionary = {}
	for a in _actors.get_children():
		if not (a is AnimatedSprite3D) or not a.visible:
			continue
		if a == _heli:
			continue
		vivos[a] = true
		var here: Vector3 = a.global_position
		var moved: Vector3 = here - _breath_prev.get(a, here)
		_breath_prev[a] = here


		var spd: float = Vector3(moved.x, 0.0, moved.z).length() / maxf(delta, 0.001)
		if spd > 30.0:
			continue
		var cd: float = float(_breath_cd.get(a, 0.0)) - delta
		if cd > 0.0:
			_breath_cd[a] = cd
			continue
		_breath_cd[a] = WeatherWear.breath_period(
			clampf(spd / BREATH_SPRINT, 0.0, 1.0))













		var caja: AABB = a.get_aabb()
		var px: float = maxf(a.pixel_size, 1e-05)
		var lienzo: float = caja.size.y / px
		var dn: String = _breath_dir_name(a)
		var cara: Vector3 = _breath_face_vec(dn)

		var boca: float = caja.position.y \
				+(lienzo - 0.5 - _breath_mouth_row(a.animation, dn)) * px
		_fx.breath_puff(here + Vector3.UP * boca + cara * _breath_side(dn), cara)


	if _breath_cd.size() > vivos.size():
		for a in _breath_cd.keys():
			if not vivos.has(a):
				_breath_cd.erase(a)
				_breath_prev.erase(a)



















const BREATH_SIDE_PROFILE_M: float = 0.35






const BREATH_SIDE_M: float = 0.2










const BREATH_MOUTH_ROW_IDLE: Dictionary = {
	"east": 33.0, "west": 32.0, "south": 36.0, "north": 35.0,
}
const BREATH_MOUTH_ROW_RUN: float = 36.0




const BREATH_IDLE_DIR: Dictionary = {
	"idle": "south", "idle_back": "north", "idle_east": "east", "idle_west": "west",
}






func _breath_dir_name(actor: AnimatedSprite3D) -> String:
	var anim: String = actor.animation
	var dn: String = ""
	if anim.begins_with("run_") or anim.begins_with("walk_"):
		dn = anim.substr(anim.find("_") + 1)
	else:
		dn = String(BREATH_IDLE_DIR.get(anim, "south"))


	if actor.flip_h:
		if dn == "east":
			dn = "west"
		elif dn == "west":
			dn = "east"
	return dn




func _breath_mouth_row(anim: String, dn: String) -> float:
	if anim.begins_with("run_") or anim.begins_with("walk_"):
		return BREATH_MOUTH_ROW_RUN
	return float(BREATH_MOUTH_ROW_IDLE.get(dn, BREATH_MOUTH_ROW_RUN))




func _breath_side(dn: String) -> float:
	return BREATH_SIDE_PROFILE_M if dn == "east" or dn == "west" else BREATH_SIDE_M






func _breath_face_vec(dn: String) -> Vector3:
	_cam_base_refresh()
	if not _cam_present:

		match dn:
			"north": return Vector3(0.0, 0.0, -1.0)
			"east": return Vector3(1.0, 0.0, 0.0)
			"west": return Vector3(-1.0, 0.0, 0.0)
			_: return Vector3(0.0, 0.0, 1.0)
	if not _cam_base_ok:
		return Vector3(0.0, 0.0, 1.0)


	var right: Vector3 = Vector3(_cam_right_flat.x, 0.0, _cam_right_flat.y)
	var into: Vector3 = Vector3(_cam_into_flat.x, 0.0, _cam_into_flat.y)
	match dn:
		"north": return into
		"east": return right
		"west": return - right
		_: return - into












func _view_targets() -> PackedVector3Array:
	var pts: PackedVector3Array = PackedVector3Array()








	if (_last_celeb_spot == CELEB_SPOT_FENCE or _last_celeb_spot == CELEB_SPOT_FENCE_SIT) \
			and not _celeb_runs.is_empty():
		return pts









	if _celeb_active and _celeb_shot == CELEB_SHOT_STAND:
		return pts
	if is_instance_valid(_ball):
		pts.append(_ball.global_position)
	if is_instance_valid(_self_actor):


		pts.append(_self_actor.global_position + Vector3.UP * PLAYER_HEIGHT_M * 0.5)
	var subject: Node3D = _celeb_focus if (_celeb_active \
			and _celeb_focus != null and is_instance_valid(_celeb_focus)) else _look_target
	if subject != null and is_instance_valid(subject):
		pts.append(subject.global_position + Vector3.UP * PLAYER_HEIGHT_M * 0.5)
	return pts




