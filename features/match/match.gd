	_stop_i = _traj.size() - 1
	_stop_i = _traj.size() - 1


















































const REFLEX_SPAN: float = 1.05



const REFLEX_BASE: float = 0.427





const KEEPER_ERR_CENTER: float = 1.6
const KEEPER_ERR_CENTER_X: float = 1.5





















const KEEPER_READ_REF_S: float = 0.35
const KEEPER_READ_FULL_S: float = 1.25
const KEEPER_READ_MIN: float = 0.58
func _keeper_read_gain(t_fly: float) -> float:
	return lerpf(1.0, KEEPER_READ_MIN, clampf(
		(t_fly - KEEPER_READ_REF_S) /(KEEPER_READ_FULL_S - KEEPER_READ_REF_S), 0.0, 1.0))

func _keeper_err(t_fly: float) -> float:
	var reflex: float = REFLEX_BASE + REFLEX_SPAN * _keeper_skill





	return clampf(randfn(0.0, 0.55), -1.5, 1.5) * Settings.dif_keeper_err_mult() \
			*(0.5 + 1.3 * _shot_pace) * _keeper_nerve_mult * _keeper_read_gain(t_fly) \
			/(_difficulty * reflex)









































const PEN_CENTER_P: float = 0.12
const PEN_SIDE_MIN: float = 1.7
const PEN_SIDE_MAX: float = 3.3
const PEN_CENTER_SPAN: float = 0.35



var _pen_guess_x: float = NAN







func _roll_penalty_guess() -> void:
	if _chance_kind != "penal":
		_pen_guess_x = NAN
		return
	if randf() < PEN_CENTER_P:
		_pen_guess_x = randf_range(- PEN_CENTER_SPAN, PEN_CENTER_SPAN)
		return
	var side: float = 1.0 if randf() < 0.5 else -1.0
	_pen_guess_x = side * randf_range(PEN_SIDE_MIN, PEN_SIDE_MAX)






func _pen_dive_x(_real_x: float) -> float:
	return _pen_guess_x



















func _keeper_reach_left(keeper_z: float, t_fly: float,
		line_z: float = KEEPER_LINE_Z, out_dir: float = 1.0) -> float:
	var reach: float = KEEPER_MAX_TRAVEL *(0.85 + 0.3 * _keeper_skill)



	if _tutorial_sin_portero:
		return 0.0





	if _practice_kind == Practice.BLANCOS:
		return 0.0
	if _tutorial_active:
		reach *= TUTORIAL_KEEPER_REACH
	reach = _reach_time_cap(reach, t_fly)
	var back: float = maxf(0.0,(keeper_z - line_z) * out_dir)
	if back <= 0.0:
		return reach
	var run: float = lerpf(KEEPER_OUT_SPD_MIN, KEEPER_OUT_SPD_MAX, _keeper_speed)
	var gap: float = maxf(0.0, back - run * t_fly)
	if gap >= reach:
		return 0.0
	return sqrt(reach * reach - gap * gap)
















const KEEPER_CURL_READ: float = 0.75



func _keeper_read_x(actual: Vector3, to_z: float = 0.0) -> float:
	var commit_i: int = _traj.size() - 1 - KEEPER_LEAD_STEPS
	if commit_i < 1:
		return actual.x
	var p: Vector3 = _traj[commit_i]
	var step_v: Vector3 = p - _traj[commit_i - 1]

	if step_v.z >= -0.0001:
		return actual.x
	var recta: float = p.x + step_v.x *((p.z - to_z) / - step_v.z)




	if _playa_ix >= commit_i:
		return recta
	var real: float = _traj_cross_x(to_z)
	if is_nan(real):
		return recta
	return lerpf(recta, real, KEEPER_CURL_READ * clampf(_keeper_skill, 0.0, 1.0))









func _traj_cross_x(to_z: float) -> float:
	var last: int = _traj.size() - 1
	if _stop_i > 0:
		last = mini(last, _stop_i)
	var i: int = last
	while i >= 1:
		var a: Vector3 = _traj[i - 1]
		var b: Vector3 = _traj[i]
		if (a.z - to_z) *(b.z - to_z) <= 0.0 and absf(a.z - b.z) > 0.0001:
			return lerpf(a.x, b.x,(a.z - to_z) /(a.z - b.z))
		i -= 1
	return NAN


















