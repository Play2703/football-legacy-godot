func _keeper_sale_por() -> bool:
	if not is_instance_valid(_keeper):
		return false
	if _keeper_dist(_ball_field) > _keeper_reach_r():
		return false
	if _keeper_dist(_ball_field) <= KEEPER_OUT_CLOSE:
		return true
	if absf(_ball_field.x) > _keeper_depth(_ball_field.y):
		return false
	if _recu and not _in_penalty_box(_ball_field, _keeper_goal_z):
		return false
	return true







func _drive_keeper_step(delta: float, duelo: bool = false,
		apuntando: bool = false) -> bool:
	var control: float = _duel_control if duelo else _drive_control





	var mi_body: Vector2 = _duel_pos if duelo else _drive_pos
	var kl: int = _keeper_lance_step(delta, mi_body, control)
	if kl == KL_VOLANDO:
		if not _keeper_robo(Vector2(_keeper.position.x, _keeper.position.z), control):
			return false
		_keeper_gana(duelo)
		return true
	if kl == KL_FALTA:

		_keeper_lance_foul(duelo)
		return true





	if _keeper_down_left() > 0.0:
		return false



	if not _keeper_sale_por():

		return false
	var kp: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)









	var mi_vel: Vector2 = Vector2.ZERO if apuntando \
			else (_duel_vel if duelo else _drive_vel)
	var mi_run: float = _duel_run_spd if duelo else _drive_run_spd
	var cita: Vector2 = _keeper_lance_point(kp, mi_vel,
		clampf(mi_vel.length() / maxf(mi_run, 0.01), 0.0, 1.0), mi_body)
	if cita != Vector2.INF:
		_keeper_lance_begin(kp, cita, mi_body)
		return false






















	var plantado: bool = _keeper_set_now() and (kp - _ball_field).length() > 0.001 \
			and mi_vel.dot((kp - _ball_field).normalized()) > KEEPER_SET_CLOSING
	var out: Array = Duel.step_defender(kp, _keeper_out_vel,
		kp if plantado else _ball_field,
		lerpf(KEEPER_OUT_SPD_MIN, KEEPER_OUT_SPD_MAX, _keeper_speed)
			*(KEEPER_DUEL_SPD_K if _keeper_duel_boost() else 1.0), delta,
		Duel.CHASE_ACCEL_K *(1.0 +(_keeper_accel - 0.5) * 2.0 * NPC_ACCEL_SPAN))
	_keeper_out_vel = out[1]
	var np: Vector2 = out[0]
	_keeper.position = Vector3(np.x, _keeper.position.y, np.y)
	_play_keeper_out(Vector3(_keeper_out_vel.x, 0.0, _keeper_out_vel.y), plantado)
	if not _keeper_robo(np, control):
		return false
	_keeper_gana(duelo)
	return true






















func _keeper_sale_o_vuelve(delta: float, duelo: bool = false,
		apuntando: bool = false) -> bool:
	if _drive_keeper_step(delta, duelo, apuntando):
		return true
	if not _keeper_sale_por():
		_keeper_return_step(delta)
	return false









func _keeper_gana(duelo: bool) -> void:




	if _recu:
		_recu_portero_devuelve()
		return



	var volando: bool = _keeper_lancing()
	if duelo:
		_duel_last_outcome = "robo"
		_end_duel_common()
	else:
		_stop_drive()
	_haptic(30)








	if not volando:
		if _in_penalty_box(Vector2(_keeper.position.x, _keeper.position.z),
				_keeper_goal_z):
			_play_keeper_smother()
		else:



			var hacia: Vector2 = _ball_field - Vector2(0.0, _keeper_goal_z)
			if hacia.length_squared() < 0.0001:
				hacia = _keeper_out_vel if _keeper_out_vel.length() > 0.15 \
						else Vector2(0.0, 1.0)


			if not _play_dir_gesture(_keeper, "kick", hacia, ZANCADA_HOLD_MS):
				_play_keeper_smother()
			_keeper_triggered = true


			_slide_dir = hacia.normalized()
			_despedir_balon(hacia.normalized() * lerpf(KEEPER_OUT_SPD_MIN,
				KEEPER_OUT_SPD_MAX, _keeper_speed),
				_duel_facing if duelo else _drive_facing, false)










	if volando and not _klance_manos:
		var v: Vector2 =(_klance_to - _klance_from) / maxf(KEEPER_LANCE_T, 0.001)
		_despedir_balon(v, _duel_facing if duelo else _drive_facing, false)





















	if volando:
		_play_self_fall(_duel_facing if duelo else _drive_facing, DUEL_LOST_HOLD_MS)
	else:
		_play_dir_gesture(_self_actor, "lost",
			_duel_facing if duelo else _drive_facing, DUEL_LOST_HOLD_MS)
	_resolve_chance("keeper_out")











