func _saque_corre(yo: AnimatedSprite3D, dt: float) -> void:
	if dt <= 0.0 or not is_instance_valid(yo):
		return
	if _drive_steer.length_squared() > 0.0001:
		_drive_facing = _drive_steer.normalized()
		var paso: Array = Duel.step_sprint_cut(_drive_vel, _drive_facing,
			_drive_run_spd * _puddle_slow(_drive_pos), _drive_accel, _drive_control,
			_drive_cut_armed, _drive_cut_recov, dt)
		_drive_vel = paso[0]
		_drive_cut_armed = bool(paso[1])
		_drive_cut_recov = bool(paso[2])
	else:
		_drive_vel = Vector2.ZERO
		_drive_cut_armed = true
		_drive_cut_recov = false
	_drive_pos = _clamp_field(_drive_pos + _drive_vel * dt)
	yo.position = Vector3(_drive_pos.x, yo.position.y, _drive_pos.y)
	if _drive_vel.length_squared() > 0.0001:
		var fam: String = "run_" if _drive_vel.length() > WALK_EXIT * _pace_world_k() else "walk_"


		if fam == "run_":
			yo.set_meta("pace_run_until", Time.get_ticks_msec() + 250)
		_play_run(yo, Vector3(_drive_facing.x, 0.0, _drive_facing.y), fam)
	else:
		_saque_planta_yo(yo)
	_move_drive_ring()
	_puddle_wake(_drive_vel, dt)




func _saque_planta_yo(yo: AnimatedSprite3D) -> void:
	_drive_vel = Vector2.ZERO
	if not is_instance_valid(yo) or _anim_lock.get(yo, 0) > Time.get_ticks_msec():
		return
	var an: String = String(yo.animation)
	if (an.begins_with("run_") or an.begins_with("walk_")) \
			and yo.sprite_frames.has_animation("idle_back"):
		yo.speed_scale = 1.0
		yo.play("idle_back")






func _saque_arranca(yo: AnimatedSprite3D) -> void:
	var steer: Vector2 = _drive_steer
	_anim_lock.erase(yo)
	_begin_drive()


	_drive_pos = Vector2(yo.position.x, yo.position.z)
	_drive_vis_off = Vector2.ZERO
	_drive_lock_t = 0.0

	_drive_steer = steer
	if steer.length_squared() > 0.0001:
		_drive_facing = steer.normalized()
		_toque_dir = _drive_facing
		_carry_foto(_drive_facing)






		var v: float = maxf(_saque_v_llega.dot(_drive_facing), 0.0)
		_drive_vel = _drive_facing * minf(v, _drive_run_spd)
	_saque_v_llega = Vector2.ZERO
	_drive_finger = _saque_dedo
	_saque_promover = true
	_saque_promueve(_saque_dedo_pos)










func _saque_cam_sigue(dt: float, pie: Vector2) -> void:
	if dt <= 0.0 or _aim_cam == null or not _aim_cam.current or _robo_cam_viva \
			or not is_instance_valid(_self_actor):
		return
	var bal: Vector3 = Vector3(pie.x, BALL_VISUAL_D * 0.5, pie.y)
	var padre: Node3D = _ball.get_parent() as Node3D
	if padre != null:
		bal = padre.to_global(bal)
	var sujeto: Vector3 = bal.lerp(_self_actor.global_position, 0.5)


	var dyaw: float = - _aim_view_fwd0.angle_to(_view_fwd(pie))
	var off: Vector3 = _bowl_off(sujeto, _aim_cam_off.rotated(Vector3.UP, dyaw) * _open_zoom)
	_aim_cam.global_position = _aim_cam.global_position.lerp(
		sujeto + off, 1.0 - exp(- DRIVE_CAM_STIFF * dt))
	_aim_cam.global_position = sujeto + _bowl_off(sujeto, _aim_cam.global_position - sujeto)
	var yo_d: Vector3 = Vector3(_self_actor.position.x, 0.0, _self_actor.position.z)
	_weld_cam_lateral(yo_d +(sujeto + off - bal), dt, yo_d)









func _saque_caida_paso(delta: float) -> void:
	if _saque_caida_h <= 0.0 and _saque_caida_vy == 0.0:
		return
	if state != State.AIMING or not is_instance_valid(_ball):
		_saque_caida_h = 0.0
		_saque_caida_vy = 0.0
		return
	if delta > 0.0:
		_saque_caida_vy -= 9.8 * delta
		_saque_caida_h += _saque_caida_vy * delta
		if _saque_caida_h <= 0.0:
			_saque_caida_h = 0.0

			_saque_caida_vy = - _saque_caida_vy * SAQUE_CAIDA_BOTE \
					if _saque_caida_vy < - SAQUE_CAIDA_VMIN else 0.0
	_ball.position.y = BALL_VISUAL_D * 0.5 + _saque_caida_h





func _saque_caida_al_suelo() -> void:
	if not _saque_vivo:
		return
	_saque_caida_h = 0.0
	_saque_caida_vy = 0.0
	if is_instance_valid(_ball):
		_ball.position.y = BALL_VISUAL_D * 0.5





func _saque_promueve(pos: Vector2) -> void:
	if not _saque_promover or _drive_finger == -1 or _ring_finger != -1:
		return

	_ring_out = true
	if _pos_in_ring(pos):
		return
	_saque_promover = false
	_ring_finger = _drive_finger
	_ring_anchor_center()




static func saque_srv_de(puestos: Array, lado: int) -> int:
