	_ref_mine = tuyo
	var crossed: bool = false


	var own_crossed: bool = false







	var tube_d: float = INF
	var tube_p: Vector3 = Vector3.ZERO
	var tube_k: int = -1
	var tube_v: Vector3 = Vector3.ZERO
	var tube_bar: bool = false
	var tube_hits: int = 0
