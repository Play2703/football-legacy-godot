	_blancos_sitio[i]["anim"] = _dianas_anim + BLANCO_ROMPE_T
	_blanco_astillas(n.position, float(_blancos_sitio[i]["r"]))



	var tw: Tween = create_tween()
	tw.tween_property(n, "scale",
		Vector3(BLANCO_ROMPE_POP, BLANCO_ROMPE_POP, 1.0), BLANCO_ROMPE_T) \
				.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


	tw.tween_callback(func() -> void:
		if not is_instance_valid(n):
			return
		n.visible = false
		n.scale = Vector3.ONE)





func _blanco_astillas(centro: Vector3, r: float) -> void:
	for k in BLANCO_ASTILLAS:
		var ang: float = TAU * float(k) / float(BLANCO_ASTILLAS) + randf_range(-0.2, 0.2)
		var dir: Vector3 = Vector3(cos(ang), sin(ang), 0.0)
		var a: MeshInstance3D = MeshInstance3D.new()
		var bm: BoxMesh = BoxMesh.new()


		bm.size = Vector3(r * randf_range(0.34, 0.58), r * randf_range(0.3, 0.52),
			BLANCO_GROSOR)
		a.mesh = bm
		var mat: StandardMaterial3D = StandardMaterial3D.new()
		mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA



		mat.albedo_color = BLANCO_COL_OJO if k % 3 == 0 else BLANCO_COL_ARO
		a.material_override = mat
		a.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF


		a.position = centro + dir * r *(0.35 if k % 3 == 0 else 0.8)
		a.rotation = Vector3(0.0, 0.0, randf_range(- PI, PI))
		add_child(a)
		var destino: Vector3 = centro + dir * r * BLANCO_ASTILLA_ABRE \
				+ Vector3(0.0, - BLANCO_ASTILLA_CAIDA, randf_range(0.2, 0.6))
		var tw: Tween = create_tween().set_parallel(true)
		tw.tween_property(a, "position", destino, BLANCO_ASTILLA_T) \
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tw.tween_property(a, "rotation", a.rotation + Vector3(0.0, 0.0,
			randf_range(-6.0, 6.0)), BLANCO_ASTILLA_T)


		tw.chain().tween_property(mat, "albedo_color:a", 0.0, BLANCO_ASTILLA_T * 0.45)
		tw.chain().tween_callback(a.queue_free)




