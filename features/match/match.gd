static func _is_gol_agonico(minute: int, lead: int, extra_time: bool) -> bool:
	return (minute >= LATE_GOAL_MIN or extra_time) and (lead == 0 or lead == 1)
















static func _celeb_prisa(ctx: Dictionary) -> bool:
	if not bool(ctx.get("partido", true)):
		return false
	if _celeb_honor(ctx):
		return false
	var glob: int = int(ctx.get("global", int(ctx.get("lead", 0))))
	if glob < 0:
		return true



	var sembrado: int = int(ctx.get("sembrado", 0))
	if glob == 0 and sembrado != 0:
		return sembrado < 0
	return glob == 0 and (int(ctx.get("minute", 0)) >= LATE_GOAL_MIN \
			or bool(ctx.get("extra_time", false)))









const CELEB_HONOR_DIF: int = 2

static func _celeb_honor(ctx: Dictionary) -> bool:
	var lead: int = int(ctx.get("lead", 0))
	return lead <= - CELEB_HONOR_DIF \
			and int(ctx.get("global", lead)) <= - CELEB_HONOR_DIF


static func _celeb_spot_for(ctx: Dictionary, last: String, roll: int) -> String:
	var away: bool = bool(ctx.get("away", false))


	if bool(ctx.get("team_rift", false)):
		return CELEB_SPOT_SOLO



	if bool(ctx.get("hito", false)):
		return CELEB_SPOT_PASILLO




	if bool(ctx.get("final", false)) and not _celeb_prisa(ctx) and not _celeb_honor(ctx):
		return CELEB_SPOT_TREN
	if bool(ctx.get("derby", false)) and away:


		return CELEB_SPOT_DERBY if roll % 2 == 0 else CELEB_SPOT_AREA
	if bool(ctx.get("decisive", false)):
		return CELEB_SPOT_ALL
	if bool(ctx.get("just_subbed", false)):
		return "banquillo"
	if bool(ctx.get("coach_rift", false)):
		return CELEB_SPOT_COACH





	if _celeb_prisa(ctx):
		return "medio"
	var lead: int = int(ctx.get("lead", 0))
	if _is_gol_agonico(int(ctx.get("minute", 0)), lead, bool(ctx.get("extra_time", false))):
		return "pina"




	if _celeb_honor(ctx):
		if not away:
			return "grada"
		return CELEB_SPOT_AWAY if bool(ctx.get("hay_rincon", true)) else "corner"
	var pool: Array = CELEB_SPOTS.duplicate()
	if away:




		if bool(ctx.get("hay_rincon", true)):
			pool.append(CELEB_SPOT_AWAY)
	elif bool(ctx.get("hay_valla", true)):





		pool.append(CELEB_SPOT_FENCE)


		pool.append(CELEB_SPOT_FENCE_SIT)



	if bool(ctx.get("hay_camara", true)):
		pool.append(CELEB_SPOT_CAM)


	if bool(ctx.get("gk_saved", false)):
		pool.append(CELEB_SPOT_GK)
	if bool(ctx.get("hay_focos", false)):
		pool.append(CELEB_SPOT_PRESS)
	if bool(ctx.get("oferta", false)):
		pool.append(CELEB_SPOT_BOX)
	if bool(ctx.get("hay_charco", false)):
		pool.append(CELEB_SPOT_PUDDLE)



	if bool(ctx.get("team_love", false)):
		pool.append(CELEB_SPOT_CORRO)
	return _choose_from(pool, last, roll)














































static func _celeb_gesture_for(spot: String, ctx: Dictionary, own_scorer: bool,
		roll: int) -> String:
	if not own_scorer:
		return ""






	if spot == CELEB_SPOT_FENCE_SIT or spot in CELEB_FORMACIONES:
		return ""
	if bool(ctx.get("back_injury", false)):
		return "cielo"
	if bool(ctx.get("ex_club", false)):
		return "perdon"
	if bool(ctx.get("hat_trick", false)):
		return "tresdedos"



	if bool(ctx.get("fallon", false)):
		return "brazos"





	if bool(ctx.get("dab_estreno", false)) and spot in _celeb_gesture_spots("dab", ctx):
		return "dab"


	if bool(ctx.get("chin_estreno", false)) \
			and spot in _celeb_gesture_spots("chinchanpu", ctx):
		return "chinchanpu"



	if bool(ctx.get("ocarina_estreno", false)) \
			and spot in _celeb_gesture_spots("ocarina", ctx):
		return "ocarina"




	if bool(ctx.get("pinguinazo_estreno", false)):
		return Celebs.PINGUINAZO




	if bool(ctx.get("pika_estreno", false)):
		return "pika"



	var regalo: String = String(ctx.get("idolo_estreno", ""))
	if not regalo.is_empty() and spot in _celeb_gesture_spots(regalo, ctx):
		return regalo
	if spot == CELEB_SPOT_DERBY:
		return "playera"
	if bool(ctx.get("away", false)) and spot == "grada":
		return "playera" if roll % 2 == 0 else "callar"
	if bool(ctx.get("nat_captain", false)):
		return "capitan"
	if spot == "pina":
		return "puno" if roll % 2 == 0 else "patada"










	if _celeb_honor(ctx):
		return "aplauso"







	if bool(ctx.get("cantico", false)) and spot in _celeb_gesture_spots("cantico", ctx):
		return "cantico"
	if int(ctx.get("lead", 0)) >= CELEB_GOLEADA and roll % 2 == 1:
		return "saludo"







	if bool(ctx.get("cabezazo", false)) and roll % 3 != 2:
		return "salto"


	if bool(ctx.get("golazo", false)) and (roll / 5) % 9 == 2 \
			and spot in _celeb_gesture_spots("rugido", ctx):
		return "rugido"
	if bool(ctx.get("golazo", false)) and roll % 2 == 0:
		return "reverencia"



	if bool(ctx.get("golazo", false)) and roll % 2 == 1 \
			and spot in _celeb_gesture_spots("mortal", ctx):
		return "mortal"


	if bool(ctx.get("dab", false)) and roll % 7 == 6 \
			and spot in _celeb_gesture_spots("dab", ctx):
		return "dab"


	if bool(ctx.get("chinchanpu", false)) and roll % 7 == 5 \
			and spot in _celeb_gesture_spots("chinchanpu", ctx):
		return "chinchanpu"



	if bool(ctx.get("ocarina", false)) and roll % 11 == 10 \
			and spot in _celeb_gesture_spots("ocarina", ctx):
		return "ocarina"


	if bool(ctx.get("pika", false)) and roll % 13 == 12 \
			and spot in _celeb_gesture_spots("pika", ctx):
		return "pika"



	if bool(ctx.get("asistido", false)) and roll % 3 == 2:
		return "socio"







	if int(ctx.get("minute", 0)) >= CELEB_RELOJ_MIN and roll % 3 == 1:
		return "reloj"


	if bool(ctx.get("oferta", false)) and (roll / 5) % 9 == 0 \
			and spot in _celeb_gesture_spots("telefono", ctx):
		return "telefono"
	if bool(ctx.get("oferta", false)) and roll % 2 == 1:
		return "dorsal"
	if bool(ctx.get("pareja", false)) and roll % 5 == 4:
		return "anillo"









	if spot == "corner" and roll % 3 == 1:
		return "mastil" if (roll / 3) % 2 == 1 else "banderin"
	if spot in ["corner", "grada", CELEB_SPOT_AWAY] and roll % 3 == 0:
		return "rodillas"



	if spot in _celeb_gesture_spots("avion", ctx) and roll % 5 == 1:
		return "avion"




	if not bool(ctx.get("away", false)) and roll % 5 == 2:
		return "oreja"
	if int(ctx.get("veterano", 0)) <= 1 and roll % 5 == 3:
		return "cesped"



	if int(ctx.get("lead", 0)) >= CELEB_ZEN_LEAD and roll % 5 == 4:
		return "zen"



	if spot in _celeb_gesture_spots("selfie", ctx) and roll % 3 == 1:
		return "selfie"





	if not bool(ctx.get("away", false)) \
			and spot in ["grada", CELEB_SPOT_FENCE, CELEB_SPOT_PRESS] \
			and roll % 3 == 2:
		return "botella"


	if int(ctx.get("veterano", 0)) >= CELEB_VET_SEASONS and roll % 5 == 0:
		return "escudo"






	var fj :=(roll / 5) % 9
	if fj == 1 and bool(ctx.get("pareja", false)):
		return _fj_si_cabe("bebe", spot, ctx)
	if fj >= 3 and fj <= 7:
		return _fj_si_cabe(["robot", "surf", "bolos", "abrazo", "cumbia"][fj - 3], spot, ctx)
	return ""


static func _fj_si_cabe(clave: String, spot: String, ctx: Dictionary) -> String:
	return clave if spot in _celeb_gesture_spots(clave, ctx) else ""



















































const CELEB_LIBRES_GESTOS: Array[String] = ["cielo", "aplauso", "brazos", "playera",
	"saludo", "reverencia", "salto", "socio", "puno", "patada", "escudo", "cesped",
	"reloj", "avion", "mortal", "zen", "dorsal", "selfie", "dab", "chinchanpu", "ocarina",
	"robot", "bebe", "telefono", "surf", "bolos", "abrazo", "cumbia", "rugido", "pika"]
const CELEB_LIBRES_SITIOS: Array[String] = [CELEB_SPOT_ALL, CELEB_SPOT_DERBY,
	CELEB_SPOT_AREA]




static func _celeb_libre_cabe(clave: String, ctx: Dictionary) -> bool:
	if clave in ["playera", CELEB_SPOT_DERBY, CELEB_SPOT_AREA]:
		return bool(ctx.get("away", false))

	if clave == "selfie":
		return not _celeb_gesture_spots("selfie", ctx).is_empty()
	return true











static func _celeb_spots_eligibles(ctx: Dictionary, libres: bool = false) -> Array[String]:
	var out: Array[String] = _celeb_spots_por_momento(ctx)
	if libres:
		for s in CELEB_LIBRES_SITIOS:
			if not out.has(s) and _celeb_libre_cabe(s, ctx):
				out.append(s)
	return out


static func _celeb_spots_por_momento(ctx: Dictionary) -> Array[String]:
	var away: bool = bool(ctx.get("away", false))
	var out: Array[String] = CELEB_SPOTS.duplicate()
	if _celeb_prisa(ctx):
		out.append("medio")



	if away:
		if bool(ctx.get("hay_rincon", true)):
			out.append(CELEB_SPOT_AWAY)
	elif bool(ctx.get("hay_valla", true)):
		out.append(CELEB_SPOT_FENCE)
		out.append(CELEB_SPOT_FENCE_SIT)
	if bool(ctx.get("hay_camara", true)):
		out.append(CELEB_SPOT_CAM)
	if bool(ctx.get("derby", false)) and away:
		out.append(CELEB_SPOT_DERBY)
	if bool(ctx.get("decisive", false)):
		out.append(CELEB_SPOT_ALL)
	if bool(ctx.get("coach_rift", false)):
		out.append(CELEB_SPOT_COACH)
	if bool(ctx.get("derby", false)) and away:
		out.append(CELEB_SPOT_AREA)
	if bool(ctx.get("team_rift", false)):
		out.append(CELEB_SPOT_SOLO)
	if bool(ctx.get("gk_saved", false)):
		out.append(CELEB_SPOT_GK)
	if bool(ctx.get("hay_focos", false)):
		out.append(CELEB_SPOT_PRESS)
	if bool(ctx.get("oferta", false)):
		out.append(CELEB_SPOT_BOX)
	if bool(ctx.get("hay_charco", false)):
		out.append(CELEB_SPOT_PUDDLE)

	if bool(ctx.get("hito", false)):
		out.append(CELEB_SPOT_PASILLO)
	if bool(ctx.get("final", false)) and not _celeb_honor(ctx):
		out.append(CELEB_SPOT_TREN)
	if bool(ctx.get("team_love", false)):
		out.append(CELEB_SPOT_CORRO)
	return out






static func _celeb_gestos_eligibles(ctx: Dictionary, own_scorer: bool,
		libres: bool = false) -> Array[String]:
	var out: Array[String] = _celeb_gestos_por_momento(ctx, own_scorer)
	if libres and own_scorer:
		for g in CELEB_LIBRES_GESTOS:
			if not out.has(g) and _celeb_libre_cabe(g, ctx):
				out.append(g)


		for g in ctx.get("idolo_regalados", []):
			if not out.has(String(g)) and _celeb_libre_cabe(String(g), ctx):
				out.append(String(g))
	return out


static func _celeb_gestos_por_momento(ctx: Dictionary, own_scorer: bool) -> Array[String]:
	var out: Array[String] = []
	if not own_scorer:
		return out
	out.append("rodillas")
	out.append("banderin")
	out.append("mastil")
	if bool(ctx.get("back_injury", false)):
		out.append("cielo")
	if bool(ctx.get("ex_club", false)):
		out.append("perdon")
	if bool(ctx.get("hat_trick", false)):
		out.append("tresdedos")
	if bool(ctx.get("nat_captain", false)):
		out.append("capitan")
	if bool(ctx.get("golazo", false)):
		out.append("reverencia")
	if bool(ctx.get("asistido", false)):
		out.append("socio")
	if int(ctx.get("veterano", 0)) >= CELEB_VET_SEASONS:
		out.append("escudo")
	if int(ctx.get("veterano", 0)) <= 1:
		out.append("cesped")
	if bool(ctx.get("fallon", false)):
		out.append("brazos")
	if _celeb_honor(ctx):
		out.append("aplauso")
	if int(ctx.get("lead", 0)) >= CELEB_GOLEADA:
		out.append("saludo")
	if bool(ctx.get("cabezazo", false)):
		out.append("salto")



	out.append("avion")
	if not _celeb_gesture_spots("selfie", ctx).is_empty():
		out.append("selfie")
	if bool(ctx.get("golazo", false)):
		out.append("mortal")
	if int(ctx.get("minute", 0)) >= CELEB_RELOJ_MIN:
		out.append("reloj")
	if bool(ctx.get("oferta", false)):
		out.append("dorsal")
	if bool(ctx.get("pareja", false)):
		out.append("anillo")
	if int(ctx.get("lead", 0)) >= CELEB_ZEN_LEAD:
		out.append("zen")
	if bool(ctx.get("dab", false)):
		out.append("dab")
	if bool(ctx.get("chinchanpu", false)):
		out.append("chinchanpu")
	if bool(ctx.get("ocarina", false)):
		out.append("ocarina")
	if bool(ctx.get("pika", false)):
		out.append("pika")

	if bool(ctx.get("oferta", false)):
		out.append("telefono")
	if bool(ctx.get("pareja", false)):
		out.append("bebe")
	if bool(ctx.get("golazo", false)):
		out.append("rugido")
	out.append_array(["robot", "surf", "bolos", "abrazo", "cumbia"])


	if bool(ctx.get("cantico", false)) and not _celeb_gesture_spots("cantico", ctx).is_empty():
		out.append("cantico")
	if not bool(ctx.get("away", false)):
		out.append("oreja")

		out.append("botella")
	if bool(ctx.get("away", false)):


		out.append("playera")
		out.append("callar")
	if _is_gol_agonico(int(ctx.get("minute", 0)), int(ctx.get("lead", 0)),
			bool(ctx.get("extra_time", false))):
		out.append("puno")
		out.append("patada")
	return out





static func _celeb_gesture_spots(gesture: String, ctx: Dictionary) -> Array[String]:
	var away: bool = bool(ctx.get("away", false))
	var r: Array[String] = []
	match gesture:
		"banderin", "mastil":
			r = ["corner"]
		"botella":



			r = ["grada"]
			if bool(ctx.get("hay_valla", false)):
				r.append(CELEB_SPOT_FENCE)
			if bool(ctx.get("hay_focos", false)):
				r.append(CELEB_SPOT_PRESS)
		"puno", "patada":
			r = ["pina"]
		"playera":






			r = ["grada"]
			if away and bool(ctx.get("derby", false)):
				r = [CELEB_SPOT_DERBY]
		"callar":
			r = ["grada"]
		"brazos":




			r = ["corner", "grada"]
		"rodillas", "avion", "mortal":


			r = ["corner", "grada"]
			if away and bool(ctx.get("hay_rincon", true)):
				r.append(CELEB_SPOT_AWAY)
		"dab":



			r = ["corner", "grada"]
			if away and bool(ctx.get("hay_rincon", true)):
				r.append(CELEB_SPOT_AWAY)
		"robot", "bebe", "telefono", "bolos", "abrazo", "cumbia", "rugido", "surf":



			r = ["corner", "grada"]
			if away and bool(ctx.get("hay_rincon", true)):
				r.append(CELEB_SPOT_AWAY)
		"pika":


			r = ["corner", "grada"]
			if away and bool(ctx.get("hay_rincon", true)):
				r.append(CELEB_SPOT_AWAY)
		"ocarina":



			r = ["corner", "grada"]
			if away and bool(ctx.get("hay_rincon", true)):
				r.append(CELEB_SPOT_AWAY)
		"chinchanpu":


			r = ["corner", "grada"]
			if away and bool(ctx.get("hay_rincon", true)):
				r.append(CELEB_SPOT_AWAY)
		"selfie":


			if away:
				if bool(ctx.get("hay_rincon", true)):
					r = [CELEB_SPOT_AWAY]
			else:
				r = ["grada"]
				if bool(ctx.get("hay_valla", true)):
					r.append(CELEB_SPOT_FENCE)
		"cantico":



			if away:
				if bool(ctx.get("hay_rincon", true)):
					r = [CELEB_SPOT_AWAY]
			else:
				r = ["grada"]
		_:
			r = _celeb_spots_eligibles(ctx)





			r.erase(CELEB_SPOT_FENCE_SIT)
			for f in CELEB_FORMACIONES:
				r.erase(f)
	return r









static func _celeb_pick_flat(ctx: Dictionary, own_scorer: bool, last_id: String,
		roll: int, libres: bool = false,
		vistas: PackedStringArray = PackedStringArray()) -> Dictionary:
	var urna: Array[String] = []
	for s in _celeb_spots_eligibles(ctx, libres):
		urna.append(Celebs.id_for(Celebs.SITIO, s))
	for g in _celeb_gestos_eligibles(ctx, own_scorer, libres):
		urna.append(Celebs.id_for(Celebs.GESTO, g))




	if libres:
		var tuyas: Array[String] = []
		for x in urna:
			if vistas.has(x):
				tuyas.append(x)
		urna = tuyas
	var pool: Array = urna.filter(func(x: String) -> bool:
		return not x.is_empty() and x != last_id)
	if pool.is_empty():
		pool = urna.filter(func(x: String) -> bool: return not x.is_empty())
	if pool.is_empty():
		return {"spot": "corner", "gesture": "", "id": ""}
	var id: String = String(pool[roll % pool.size()])
	var ficha: Dictionary = Celebs.by_id(id)
	if String(ficha.get("kind", "")) != Celebs.GESTO:
		return {"spot": String(ficha.get("clave", "corner")), "gesture": "", "id": id}
	var gesture: String = String(ficha.get("clave", ""))
	var admite: Array[String] = _celeb_gesture_spots(gesture, ctx)
	if admite.is_empty():


		admite = _celeb_spots_eligibles(ctx)



	var spot: String = admite[int(roll / pool.size()) % admite.size()]
	return {"spot": spot, "gesture": gesture, "id": id}












static func _celeb_pick_bombo(ctx: Dictionary, own_scorer: bool, last_id: String,
		roll: int, vistas: PackedStringArray, elegidos: PackedStringArray) -> Dictionary:
	if not elegidos.is_empty():
		var tuyas: PackedStringArray = PackedStringArray()
		for id in elegidos:
			if vistas.has(id):
				tuyas.append(id)
		var pick: Dictionary = _celeb_pick_flat(ctx, own_scorer, last_id, roll, true, tuyas)
		if not String(pick.get("id", "")).is_empty():
			return pick
	return _celeb_pick_flat(ctx, own_scorer, last_id, roll, true, vistas)






static func _celebs_album_completo() -> bool:
	return Settings.celebs_seen_count() >= Celebs.total()







static func _celeb_cascada_vista(ctx: Dictionary, own_scorer: bool, last_spot: String,
		roll_sitio: int, roll_gesto: int) -> bool:
	var sp: String = _celeb_spot_for(ctx, last_spot, roll_sitio)
	var id: String = Celebs.id_for(Celebs.GESTO,
		_celeb_gesture_for(sp, ctx, own_scorer, roll_gesto))
	if id.is_empty():
		id = Celebs.id_for(Celebs.SITIO, sp)
	return Settings.celeb_seen(id)



























const CEDIDA_CTX_PROPIAS: Array[String] = ["back_injury", "ex_club", "hat_trick",
	"nat_captain", "golazo", "asistido", "fallon", "pareja", "oferta", "cantico"]


func _cedida_gesto(spot: String, ctx: Dictionary, roll: int) -> String:
	var ajeno: Dictionary = ctx.duplicate()
	for k in CEDIDA_CTX_PROPIAS:
		ajeno.erase(k)




	ajeno["veterano"] = CELEB_VET_SEASONS - 1
	var pool: Array[String] = []
	for g in _celeb_gestos_eligibles(ajeno, true):
		if not Settings.celeb_seen(Celebs.id_for(Celebs.GESTO, g)):
			continue
		if not _celeb_gesture_spots(g, ajeno).has(spot):
			continue
		pool.append(g)
	if pool.is_empty():
		return ""
	return pool[roll % pool.size()]


















func _gesto_socio_anotador(anotador: AnimatedSprite3D, spot: String, ctx: Dictionary) -> String:
	var nombre: String = String(_finisher_of(anotador).get("name", ""))
	if nombre.is_empty():
		return ""
	if not Settings.celeb_seen(Celebs.id_for(Celebs.GESTO, GestoSocio.GESTO_SOCIO)):
		return ""
	if not _celeb_gesture_spots(GestoSocio.GESTO_SOCIO, ctx).has(spot):
		return ""
	var r: Dictionary = GestoSocio.elegir(GestoSocio.EV_GOL_A_TU_PASE, {
		"v": Career.socio_v(nombre) + int(_mate_socio.get(nombre, 0)) + SOCIO_PASE_GOL})
	var g: String = String(r.get("gesto", ""))
	if g.is_empty():
		return ""
	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + HEADER_GESTO_BUDGET_US)
	if not _gesto_listo(anotador, g):
		return ""
	_sonda_cuenta("gesto_socio")
	return g


