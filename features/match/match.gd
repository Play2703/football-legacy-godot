var _celu_done: bool = false
var _celu_from: Vector3 = Vector3.ZERO
var _celu_tuyo: bool = false

var _celu_pov: ImageTexture = null


func _celu_maybe_spawn() -> void:

	_celu = null
	if _celu_caido:
		return
	if _shootout_active or _tutorial_active or not _practice_kind.is_empty():
		return

	if _stadium == null or _stadium.backdrop:
		return
	if not _celu_rolled:
		_celu_rolled = true
		if not _celu_force:
			_celu_rng.randomize()
		_celu_on = _celu_force or _celu_sale()
		var lado: float = -1.0 if _celu_rng.randf() < 0.5 else 1.0
		_celu_x = lado * _celu_rng.randf_range(CELU_X_MIN, CELU_X_MAX)
		_celu_cfg = _celu_look()
	if not _celu_on:
		return



	var sitio: Vector3 = _stadium.front_row_spot(_celu_x)


	if sitio != Vector3.INF and _stadium.seat_behind_cloth(sitio):
		sitio = _stadium.front_row_spot(- _celu_x)
		if sitio != Vector3.INF and _stadium.seat_behind_cloth(sitio):
			sitio = Vector3.INF
	if sitio == Vector3.INF:
		sitio = Vector3(_celu_x, 0.0, _celu_z())
	else:


		_stadium.clear_flags_near(sitio)
	_celu = _spawn_fan(sitio.x, sitio.z, _celu_cfg)
	if _celu == null:
		return
	_celu.position.y = sitio.y

	_sub_play(_celu, "celular", "idle")




func _celu_sale() -> bool:
	if GameState.readonly_save:
		return false
	return _celu_rng.randf() < CELU_MATCH_P




func _celu_look() -> Dictionary:
	var mirada: Dictionary = _random_appearance(GameState.player_look(),
		"fan_celu_%d" % _celu_rng.randi())
	mirada["boots"] = FAN_SHOES
	mirada["number"] = 0
	mirada.erase("apellido")
	return mirada


func _celu_z() -> float:
	return -4.0 - _stadium._ring_pad_z() - CELU_TRAS_VALLA


func _celu_vivo() -> bool:
	return _celu != null and is_instance_valid(_celu) and not _celu_caido




func _celu_toca(a: Vector3, b: Vector3) -> bool:
	if not _celu_vivo():
		return false
	var p: Vector3 = _celu.position

	if minf(a.y, b.y) > p.y + CELU_HIT_H or maxf(a.y, b.y) < p.y:
		return false
	var pa: Vector2 = Vector2(a.x - p.x, a.z - p.z)
	var ab: Vector2 = Vector2(b.x - a.x, b.z - a.z)
	var len2: float = ab.length_squared()
	var t: float = 0.0 if len2 <= 0.0001 else clampf(- pa.dot(ab) / len2, 0.0, 1.0)
	return (pa + ab * t).length() <= CELU_HIT_R






func _celu_alcanza(pos: Vector3, vel: Vector3) -> bool:
	if not _celu_vivo() or vel.z >= -0.1 \
			or Vector2(vel.x, vel.z).length() < CAMOP_KNOCK_SPEED:
		return false
	var p: Vector3 = _celu.position
	if p.z >= pos.z:
		return false
	var t: float =(p.z - pos.z) / vel.z
	var x: float = pos.x + vel.x * t


	var y: float = pos.y + vel.y * t - 0.5 * 9.8 * t * t
	return absf(x - p.x) <= CELU_HIT_R + BALL_R and y >= p.y - BALL_R \
			and y <= p.y + CELU_HIT_H





func _hit_celu() -> void:
	if not _celu_vivo():
		return
	_celu_caido = true
	var fan: AnimatedSprite3D = _celu
	var tuyo: bool = _celu_tuyo
	_celu_pov = await _celu_pov_tex(fan)
	if not is_instance_valid(fan):
		return
	if _audio != null and is_instance_valid(_audio):
		_audio.net()
		_audio.ooh()
	_fx.shake(0.18)
	_haptic(40)
	_hud.show_message(I18n.t("¡Le volaste el celular a un fan!"), Color("ffd0a0"), 1.4)
	_celu_cae(fan)
	_celu_tel_vuela(fan)


	await SceneFade.timer(CELU_TARJETA_TRAS_S).timeout
	await _celu_tarjeta(_celu_pov)
	_hud.show_message(I18n.t("¡Tu balonazo se hizo viral!"), Color("ff8fb8"), 1.6)
	if tuyo:
		Career.video_viral()
		Achievements.ingest_viral_video()





func _celu_cae(fan: AnimatedSprite3D) -> void:
	var away: Vector3 = fan.position - _celu_from
	away.y = 0.0
	away = away.normalized() if away.length() > 0.01 else Vector3(0.0, 0.0, -1.0)
	if _anim_usable(fan, "derribado"):
		_anim_lock[fan] = Time.get_ticks_msec() + 600000
		fan.play("derribado")




	var destino: Vector3 = fan.position + away * 0.5
	if fan.position.y > 0.5:
		var lado: float = signf(away.x) if absf(away.x) > 0.05 else 1.0
		destino = fan.position + Vector3(lado * 0.45, CELU_CAIDO_GRADA_Y, 0.0)
	var tw: Tween = create_tween()
	tw.tween_property(fan, "position", destino, 0.34) \
			.set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_QUAD)




func _celu_tel_vuela(fan: AnimatedSprite3D) -> void:
	var tel: MeshInstance3D = MeshInstance3D.new()
	var caja: BoxMesh = BoxMesh.new()
	caja.size = Vector3(0.09, 0.17, 0.012)
	tel.mesh = caja
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.albedo_color = Color("14161b")
	mat.emission_enabled = true
	mat.emission = Color("7fc4ff")
	mat.emission_energy_multiplier = 0.6
	tel.material_override = mat
	var desde: Vector3 = Vector3(fan.position.x, fan.position.y + CELU_TEL_Y,
		fan.position.z + 0.15)
	var away: Vector3 = Vector3(fan.position.x - _celu_from.x, 0.0, fan.position.z - _celu_from.z)
	away = away.normalized() if away.length() > 0.01 else Vector3(0.0, 0.0, -1.0)
	var hasta: Vector3 = desde + away * 2.4

	hasta.y = fan.position.y + 0.02 + maxf(0.0, - away.z) * 2.4 * 1.6
	tel.position = desde
	_actors.add_child(tel)
	var tw: Tween = create_tween().set_parallel(true)
	tw.tween_method(_celu_tel_arco.bind(tel, desde, hasta), 0.0, 1.0, CELU_TEL_VUELO_S)
	tw.tween_property(tel, "rotation", Vector3(TAU * 2.0, TAU * 1.5, 0.0), CELU_TEL_VUELO_S)


func _celu_tel_arco(u: float, tel: MeshInstance3D, a: Vector3, b: Vector3) -> void:
	if not is_instance_valid(tel):
		return
	var p: Vector3 = a.lerp(b, u)
	p.y += 4.0 * CELU_TEL_SALTO * u *(1.0 - u)
	tel.position = p





func _celu_pov_tex(fan: AnimatedSprite3D) -> ImageTexture:


	if DisplayServer.get_name() == "headless":
		return null
	var antes: int = clampi(_celu_ix - CELU_POV_PASOS, 0, maxi(_traj.size() - 1, 0))
	var mira: Vector3 =(_traj[antes] if not _traj.is_empty() else fan.position) \
			+ Vector3(0.0, BALL_R, 0.0)
	var dir: Vector3 = Vector3(mira.x - fan.position.x, 0.0, mira.z - fan.position.z)
	dir = dir.normalized() if dir.length() > 0.01 else Vector3(0.0, 0.0, 1.0)
	var ojo: Vector3 = Vector3(fan.position.x, fan.position.y + CELU_TEL_Y, fan.position.z) \
			+ dir * CELU_TEL_DELANTE
	var balon_en: Vector3 = Vector3.INF
	if is_instance_valid(_ball):
		balon_en = _ball.position
		_ball.position = mira
	var sub: SubViewport = SubViewport.new()
	sub.size = Vector2i(CELU_POV_W, CELU_POV_H)
	sub.world_3d = get_viewport().world_3d
	sub.render_target_update_mode = SubViewport.UPDATE_ALWAYS

	sub.msaa_3d = Viewport.MSAA_DISABLED
	sub.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
	add_child(sub)
	var c: Camera3D = Camera3D.new()
	c.fov = CELU_POV_FOV
	sub.add_child(c)
	c.position = ojo
	c.look_at(mira)
	c.current = true
	await RenderingServer.frame_post_draw



	var img: Image = null
	if is_instance_valid(sub):
		img = sub.get_texture().get_image()
		sub.queue_free()
	if balon_en != Vector3.INF and is_instance_valid(_ball):
		_ball.position = balon_en
	if img == null:
		return null
	return ImageTexture.create_from_image(img)





func _celu_tarjeta(tex: ImageTexture) -> void:
	if _hud == null or not is_instance_valid(_hud):
		return
	var vp: Vector2 = SceneFade.rect_visible(self).size
	var ancho: float = minf(vp.x * 0.5, vp.y * 0.28)
	var alto: float = ancho * float(CELU_POV_H) / float(CELU_POV_W)
	var marco: float = ancho * 0.05
	var tarjeta: Panel = Panel.new()
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = Color("0c0d10")
	sb.set_corner_radius_all(int(ancho * 0.1))
	sb.shadow_color = CareerTheme.SHADOW
	sb.shadow_size = 14
	tarjeta.add_theme_stylebox_override("panel", sb)
	tarjeta.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tarjeta.size = Vector2(ancho + marco * 2.0, alto + marco * 2.0)
	tarjeta.position =(vp - tarjeta.size) * Vector2(0.5, 0.4)
	tarjeta.pivot_offset = tarjeta.size * 0.5
	tarjeta.rotation_degrees = 3.0
	if tex != null:
		var foto: TextureRect = TextureRect.new()
		foto.texture = tex
		foto.mouse_filter = Control.MOUSE_FILTER_IGNORE
		foto.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		foto.stretch_mode = TextureRect.STRETCH_SCALE
		foto.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		foto.position = Vector2(marco, marco)
		foto.size = Vector2(ancho, alto)
		tarjeta.add_child(foto)

	var fuente: int = int(ancho * 0.07)
	var rec: Label = Label.new()
	rec.text = "● " + I18n.t("REC")
	rec.add_theme_font_size_override("font_size", fuente)
	rec.add_theme_color_override("font_color", Color("ff3b3b"))
	rec.add_theme_color_override("font_outline_color", Color.BLACK)
	rec.add_theme_constant_override("outline_size", 6)
	rec.position = Vector2(marco * 2.2, marco * 2.0)
	rec.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tarjeta.add_child(rec)
	var vistas: Label = Label.new()
	vistas.clip_text = true
	vistas.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	vistas.add_theme_font_size_override("font_size", fuente)
	vistas.add_theme_color_override("font_color", Color.WHITE)
	vistas.add_theme_color_override("font_outline_color", Color.BLACK)
	vistas.add_theme_constant_override("outline_size", 6)
	vistas.size = Vector2(ancho, fuente * 1.4)
	vistas.position = Vector2(marco, marco + alto - fuente * 1.8)
	vistas.mouse_filter = Control.MOUSE_FILTER_IGNORE
	tarjeta.add_child(vistas)
	_hud.add_child(tarjeta)
	var total: float = _celu_rng.randf_range(CELU_VISTAS_MIN, CELU_VISTAS_MAX)
	_celu_vistas(0.0, vistas)
	tarjeta.scale = Vector2(0.6, 0.6)
	var tw: Tween = create_tween().set_parallel(true)
	tw.tween_property(tarjeta, "scale", Vector2.ONE, 0.25) \
			.set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_BACK)
	tw.tween_method(_celu_vistas.bind(vistas), 0.0, total, CELU_CUENTA_S) \
			.set_delay(0.3).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_EXPO)

	var parpadeo: Tween = create_tween().set_loops(int(CELU_CARD_S / 0.5))
	parpadeo.tween_property(rec, "modulate:a", 0.2, 0.25)
	parpadeo.tween_property(rec, "modulate:a", 1.0, 0.25)
	tw.tween_property(tarjeta, "scale", Vector2(0.2, 0.2), 0.7) \
			.set_delay(CELU_CARD_S).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_CUBIC)
	tw.tween_property(tarjeta, "position", Vector2(vp.x * 0.66, vp.y * 0.1), 0.7) \
			.set_delay(CELU_CARD_S).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_CUBIC)
	tw.tween_property(tarjeta, "modulate:a", 0.0, 0.4).set_delay(CELU_CARD_S + 0.3)
	await tw.finished
	parpadeo.kill()
	if is_instance_valid(tarjeta):
		tarjeta.queue_free()


func _celu_vistas(millones: float, l: Label) -> void:
	if is_instance_valid(l):
		l.text = I18n.tf("{0} vistas", ["%.1f M" % millones])



































const DOG_DIV: int = 3









const DOG_CHANCE_P: float = 0.0068








const DOG_SPEED: float = 8.5



const DOG_ACCEL: float = 11.0


const DOG_HIT_R: float = 0.62



const DOG_HIT_H: float = 0.8

const DOG_ORBIT_R: float = 2.2



const DOG_LIFE_S: float = 18.0








const DOG_PIXEL_M: float = PLAYER_HEIGHT_M / PLAYER_METRICS.x




const DOG_CANVAS_PX: float = 48.0
const DOG_FEET_ROW: float = 46.0


const DOG_EXIT_SPD: float = 11.0


const DOG_ANIM_FPS: float = 14.0

var _dog: AnimatedSprite3D = null
var _dog_vel: Vector2 = Vector2.ZERO
var _dog_t: float = 0.0


var _dog_phase: float = 0.0

var _dog_leaving: bool = false



var _dog_done_match: bool = false




var _dog_seen_match: bool = false

var _dog_side: float = 1.0




var _dog_force: bool = false





func _dog_maybe_spawn() -> void:
	if _dog_done_match or _dog != null:
		return




	if _shootout_active or _tutorial_active or not _practice_kind.is_empty():
		return
	var div: int = _stadium.div if _stadium != null else GameState.home_div()
	if not _dog_force:
		if div != DOG_DIV:
			return
		if randf() > DOG_CHANCE_P:
			return
	var frames: SpriteFrames = _dog_frames()
	if frames == null:



		return
	_dog_done_match = true
	_dog_seen_match = true
	_dog_leaving = false
	_dog_t = 0.0
	_dog_vel = Vector2.ZERO
	_dog_phase = randf() * TAU




	_dog_side = signf(_ball_field.x) if absf(_ball_field.x) > 0.5 else (1.0 if randf() < 0.5 else -1.0)
	var entra: Vector2 = Vector2(
		_dog_side *(Stadium.FIELD_HALF_W + 1.2),
		clampf(_ball_field.y + randf_range(2.0, 7.0), 1.0, Stadium.FIELD_DEPTH - 1.0))
	_dog = AnimatedSprite3D.new()
	_dog.sprite_frames = frames
	_dog.pixel_size = DOG_PIXEL_M


	_dog.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	_dog.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_dog.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	_dog.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
	_dog.position = Vector3(entra.x,
		(DOG_FEET_ROW - DOG_CANVAS_PX * 0.5) * DOG_PIXEL_M, entra.y)
	_dog.play("run_south")


	_actors.add_child(_dog)


	_stadium.crowd_react("home", "close")









func _dog_frames() -> SpriteFrames:
	if _dog_frames_cache != null:
		return _dog_frames_cache
	var frames: SpriteFrames = SpriteFrames.new()
	frames.remove_animation("default")
	for dir in ["south", "east", "north", "west"]:
		var path: String = "res://assets/sprites/anim/perro_run_%s.png" % dir
		if not ResourceLoader.exists(path):
			return null
		var tex: Texture2D = load(path)
		if tex == null:
			return null
		var h: int = tex.get_height()
		var n: int = int(tex.get_width() / float(h))
		if n <= 0:
			return null
		var anim: String = "run_" + dir
		frames.add_animation(anim)
		frames.set_animation_speed(anim, DOG_ANIM_FPS)
		frames.set_animation_loop(anim, true)
		for i in n:
			var at: AtlasTexture = AtlasTexture.new()
			at.atlas = tex
			at.region = Rect2(i * h, 0, h, h)
			frames.add_frame(anim, at)
	_dog_frames_cache = frames
	return frames





static var _dog_frames_cache: SpriteFrames = null










func _dog_step(dt: float) -> void:
	if _dog == null:
		return
	if not is_instance_valid(_dog):



		_dog = null
		return
	_dog_t += dt
	var pos: Vector2 = Vector2(_dog.position.x, _dog.position.z)
	var goal: Vector2
	if _dog_leaving:

		goal = Vector2(_dog_side *(Stadium.FIELD_HALF_W + 6.0), pos.y)
	else:
		if _dog_t >= DOG_LIFE_S:
			_dog_leaving = true
			return
		var ball: Vector2 = Vector2(_ball.position.x, _ball.position.z)
		if _dog_ball_live():
			goal = ball
		else:



			_dog_phase += dt * 1.6
			goal = ball + Vector2(cos(_dog_phase), sin(_dog_phase)) * DOG_ORBIT_R
	var spd: float = DOG_EXIT_SPD if _dog_leaving else DOG_SPEED
	var want: Vector2 =(goal - pos)


	var v: Vector2 = want.normalized() * minf(spd, want.length() / maxf(dt, 0.0001))
	_dog_vel = _dog_vel.move_toward(v, DOG_ACCEL * dt)
	pos += _dog_vel * dt
	_dog.position = Vector3(pos.x, _dog.position.y, pos.y)
	if _dog_vel.length() > 0.05:
		var anim: String = "run_" + _dir_name(Vector3(_dog_vel.x, 0.0, _dog_vel.y))
		if _dog.sprite_frames.has_animation(anim) and _dog.animation != anim:
			_dog.play(anim)



	if _dog_leaving and absf(pos.x) > Stadium.FIELD_HALF_W + 5.0:
		_dog.queue_free()
		_dog = null
		return
	if not _dog_leaving and _dog_touching_ball():
		_dog_hit()




func _dog_ball_live() -> bool:
	return state == State.FLIGHT or state == State.DUEL




func _dog_touching_ball() -> bool:
	if not _dog_ball_live() or not _ball.visible:
		return false
	if _ball.position.y > DOG_HIT_H:
		return false
	var d: Vector2 = Vector2(_ball.position.x - _dog.position.x,
		_ball.position.z - _dog.position.z)
	return d.length() <= DOG_HIT_R









func _dog_hit() -> void:
	if _dog_leaving:
		return
	_dog_leaving = true







	if state == State.FLIGHT and _traj_i > 0 and _traj_i < _traj.size():
		_stop_i = _traj_i


	_dog_vel = Vector2(_dog_side * DOG_EXIT_SPD, _dog_vel.y * 0.3)
	_haptic(25)
	_audio.whistle()



	_audio.net()
	_audio.ooh()
	_fx.shake(0.18)


	if _duel_active:
		_duel_last_outcome = "perro"
		_end_duel_common()
	_resolve_chance("perro")




func _check_loose_touch() -> bool:
	if _clear_phase or not _ball.visible or _traj_i <= 0 or _traj_i >= _traj.size():
		return false


	if _cross_i >= 0 and _traj_i >= _cross_i \
			and (_outcome == "goal" or _outcome == "wide" or _outcome == "over"):
		return false


	if _pecho_i >= 0 and _outcome == "save" and _traj_i >= _pecho_i:
		return false



	var bh: float = _traj[_traj_i].y
	if bh > HEADER_MAX_H:
		return false

	if _last_toucher != null and (not is_instance_valid(_last_toucher)
			or _flat_dist(_last_toucher.position, _ball.position) > RETOUCH_CLEAR):
		_last_toucher = null






	var best: AnimatedSprite3D = null
	var best_is_mate: bool = false
	var best_d: float = INF



















	var mios_touch: Array = _teammate_actors
	var suyos_touch: Array = _rival_actors
	if _cedida_disputa():
		mios_touch = _teammate_actors + _cedida_mates
		suyos_touch = _rival_actors + _cedida_rivals







		if is_instance_valid(_self_actor):
			mios_touch = mios_touch + [_self_actor]









	var sube_alto: bool = _balon_suelto() \
			and bh + BALL_VISUAL_D * 0.5 > CHEST_TRAP_H + PECHO_FRANJA_M \
			and bh >(_traj[_traj_i - 1] as Vector3).y







	for actor in mios_touch:
		if not is_instance_valid(actor) or actor == _last_toucher or _desv_mudo(actor):
			continue
		var dm: float = _flat_dist(actor.position, _ball.position)





		var reach_m: float = SWITCH_REACH if (_switch_active and actor == _switch_target) \
				else _touch_radius(bh, float(actor.get_meta("ctrl_q")) if actor.has_meta("ctrl_q") \
				else Squad.control(_finisher_of(actor)))
		if dm < reach_m and dm < best_d:
			if sube_alto and _handoff_ok(actor, bh):
				continue
			best_d = dm
			best = actor
			best_is_mate = true
























	if _you_chasing() and _balon_suelto() \
			and _self_actor != _last_toucher:
		var dy: float = _flat_dist(_self_actor.position, _ball.position)
		if dy < _touch_radius(bh, Career.control_norm()) and dy < best_d:
			best_d = dy
			best = _self_actor
			best_is_mate = true







	if _cobro_corre and _cedida_yo != null and is_instance_valid(_cedida_yo) \
			and _cedida_yo != _last_toucher:
		var dc: float = _flat_dist(_cedida_yo.position, _ball.position)
		if dc < _touch_radius(bh, Career.control_norm()) and dc < best_d:
			best_d = dc
			best = _cedida_yo
			best_is_mate = true





























	var bspd: float = 0.0
	if _traj_i > 0:
		bspd =(_traj[_traj_i] - _traj[_traj_i - 1]).length() / SIM_DT
	var rival_reach: float = _alcance_rival(bh, bspd)



	var intocable: bool = _libre_npc_intocable()







	var techo_pierna: float = INF
	if _tope_pierna and not _balon_suelto():
		techo_pierna = ZANCADA_TAPA_MAX_H - BALL_R
	for actor in suyos_touch:
		if intocable or not is_instance_valid(actor) or actor == _last_toucher \
				or actor.has_meta("hold_wall") or _desv_mudo(actor):
			continue
		if bh >=(BARRIDA_TIRO_MAX_H if actor == _barr_actor and techo_pierna < INF
				else techo_pierna):
			continue
		var dr: float = _flat_dist(actor.position, _ball.position)





		if dr <= rival_reach and dr <= best_d:
			best_d = dr
			best = actor
			best_is_mate = false










	if _libero_out and is_instance_valid(_keeper) and _keeper != _last_toucher \
			and bh <= HEADER_MAX_H:
		var dk: float = _flat_dist(_keeper.position, _ball.position)
		if dk <= KEEPER_LIBERO_R and dk <= best_d:
			best_d = dk
			best = _keeper
			best_is_mate = false
	if best == null:
		return false
	_on_ball_touched(best, best_is_mate)
	return true








func _alcance_rival(bh: float, bspd: float) -> float:
	var r: float = _touch_radius(bh)
	if bh > CHASE_MAX_BALL_H:
		r *= HEADER_CLEAR_REACH
	return r * lerpf(1.0, REACT_REACH_MIN,
		clampf((bspd - REACT_SPEED_LO) /(REACT_SPEED_HI - REACT_SPEED_LO), 0.0, 1.0))








func _touch_radius(ball_h: float, ctrl: float = 0.5) -> float:
	var base: float = TOUCH_R_LOW
	if ball_h > CHASE_MAX_BALL_H:
		var t: float = clampf((ball_h - CHASE_MAX_BALL_H)
			/(HEADER_MAX_H - CHASE_MAX_BALL_H), 0.0, 1.0)
		base = lerpf(TOUCH_R_LOW, TOUCH_R_HIGH, t)
	return base * lerpf(TOUCH_CTRL_MIN, TOUCH_CTRL_MAX, clampf(ctrl, 0.0, 1.0))






const TOUCH_HARD_SPEED: float = 22.0
const TOUCH_PRESS_R: float = 3.2














func _first_touch_q(actor: AnimatedSprite3D, header: bool) -> float:
	if header:
		return 1.0


	var pace: float = 0.0
	if _traj_i > 0 and _traj_i < _traj.size():
		pace = clampf((_traj[_traj_i] - _traj[_traj_i - 1]).length() / SIM_DT
			/ TOUCH_HARD_SPEED, 0.0, 1.0)
	var high: float = clampf(_traj[_traj_i].y / CARRY_MAX_BALL_H, 0.0, 1.0) \
			if _traj_i < _traj.size() else 0.0
	var press: float = clampf(1.0 - _nearest_rival_to_ball() / TOUCH_PRESS_R, 0.0, 1.0)



	var hard: float = clampf(pace * 0.55 + high * 0.25 + press * 0.2, 0.0, 1.0)
	var ctrl: float = Squad.control(_finisher_of(actor))



	return clampf(1.0 - hard *(1.0 - ctrl), 0.25, 1.0)




func _on_target(outcome: String) -> bool:
	return outcome == "goal" or outcome == "save" or outcome == "post"


func _flat_dist(a: Vector3, b: Vector3) -> float:
	return Vector2(a.x, a.z).distance_to(Vector2(b.x, b.z))






func _rival_key() -> String:
	return String(GameState.current_rival().get("id", ""))










func _flight_cut() -> int:
	var fin: int = _traj.size() - 1
	if _stop_i > 0:
		fin = mini(fin, _stop_i)
	if _cross_i >= 0:
		fin = mini(fin, _cross_i)
	if _rebound_i >= 0:
		fin = mini(fin, _rebound_i)



	if _pecho_i >= 0:
		fin = mini(fin, _pecho_i)
	return maxi(fin, 0)












func _switch_touch(actor: AnimatedSprite3D, is_teammate: bool) -> void:
	_fx.trail_off()
	_ball.speed_scale = 1.0
	_ball.play("idle")




	if is_teammate:



		match_passes += 1
		_pass_done = true
		_log_pass(actor)




		team_goals += 1
		_sync_score()
		_resolve_chance("switch_done")
		return





	if state == State.PASSING:
		_rival_clear()
		_outcome = "switch_fail"
	else:
		_resolve_chance("switch_fail")




















func _log_pass(actor: AnimatedSprite3D, marca: bool = true) -> void:
	if not _shot_pending or not is_instance_valid(actor):
		return
	var to: Vector2 = Vector2(actor.position.x, actor.position.z)
	if marca:
		_best_pass_m = maxf(_best_pass_m, _shot_from.distance_to(to))


	var i: int = clampi(_traj_i, 0, maxi(_traj.size() - 1, 0))
	var bola: Vector2 = to if _traj.is_empty() \
			else Vector2(_traj[i].x, _traj[i].z)
	var tramo: Array = FlightPath.from_traj(_traj, 0, i)



	if not _rebote_mate_pase.is_empty():
		bola = _rebote_mate_pase["bola"]
		tramo = _rebote_mate_pase["tramo"]
		_rebote_mate_pase = {}
	_pass_open = PassBook.entry(_shot_from, bola, "", "", tramo)


func _on_ball_touched(actor: AnimatedSprite3D, is_teammate: bool) -> void:
	state = State.PASSING
	_stop_i = _traj_i


	var antes = _last_toucher
	_last_toucher = actor



	if _bsube_vuelo:
		_bsube_congela()

	if is_teammate:
		_cara(actor, "alegria", 1.5)
	elif actor != _keeper:
		_cara(actor, "alegria", 2.0)
		_cara(_self_actor, "resoplar", 2.3)


	_olympic_live = false









	if _wall_holding:
		for t in _desv_toques:
			if bool(t.get("barrera", false)):
				_release_wall()
				break









	if _traj_i >= 0 and _traj_i < _traj.size() \
			and _traj[_traj_i].y < HEADER_MIN_H:
		var toca: Vector3 = _traj[_traj_i]
		var lleva: Vector3 = Vector3.ZERO
		if _traj_i > 0:
			lleva = _traj[_traj_i] - _traj[_traj_i - 1]
		_splash_at(Vector2(toca.x, toca.z), lleva, 11.0)




	if _switch_active:
		_switch_touch(actor, is_teammate)
		return





	if (_cedida_en_curso or _corner_ced_live) and _is_you(actor):
		_cedida_tuya = true
	elif _cedida_disputa() and is_teammate and actor != _keeper:



		_cedida_goleador = String(_finisher_of(actor).get("name", ""))
	if is_teammate:






		var first_touch: bool = not _pass_done and not _rechace_relevo
		if _offside_teammates.get(actor, false):







			var rebote: bool = _balon_suelto()






			if first_touch and _offside_de_tu_bota and not rebote:
				if not _meta_sin_ti:
					match_passes += 1
				_pass_done = true




				if not _meta_sin_ti:
					_log_pass(actor, false)








			var tuyo: bool = _is_you(actor)
			_offside_remate_previo = _veredicto_del_rebote() if rebote else ""
			if rebote:
				if not tuyo and _rebound_cause.is_empty():
					_rebound_mate = true
					_rebound_cause = _veredicto_del_rebote()
				if _veredicto_del_rebote() == "save" and state == State.PASSING:
					_cuenta_parada(_parada_mi_arco.is_empty())

			_offside_tuyo = tuyo
			_offside_stop()
			return







		var header: bool = _traj[_traj_i].y > HEADER_MIN_H











		var releva: bool = _handoff_ok(actor, _traj[_traj_i].y)
		if releva:
			header = false


		if _rebote_mate(actor, releva, header):
			return


		var recupera: bool = _rebote_recupera(actor)
		if recupera:
			_rebote_mate_causa = false
		else:
			_rebote_mate_pase = {}


		if _balon_suelto() and not (_pase_rozado() and not _is_you(actor)) and not recupera:






			var yo_al_rechace: bool = _is_you(actor)
			_rebound_mate = not yo_al_rechace



			if yo_al_rechace:
				_meta_sin_ti = false
				_rebote_mate_causa = false




			if yo_al_rechace and _es_regreso(actor):
				_vuelve_tu_cuerpo(actor)




			_rebound_cut = true






			if _rebound_mate:
				_rebound_cause = _veredicto_del_rebote()





			if _veredicto_del_rebote() == "save" and state == State.PASSING:
				_cuenta_parada(_parada_mi_arco.is_empty())
			var quien: String = String(_finisher_of(actor).get("name", ""))
			if yo_al_rechace:
				_hud.show_message(I18n.t("¡Al rechace!"), Color("ffd76d"), 0.8)
			else:
				_hud.show_message(I18n.tf("¡Al rechace {0}!", [quien]) \
						if not quien.is_empty() else I18n.t("¡Al rechace!"),
					CareerTheme.GOOD, 0.8)

















			if releva and not yo_al_rechace:
				_rechace_relevo = true
				_asiste_npc = ""
				_handoff_to(actor)
				return
			_ai_shot_from_ball(actor, header)
			return










		var pase_tuyo: bool = first_touch and not _corner_ced_live and not _meta_sin_ti
		if pase_tuyo:
			match_passes += 1
			_log_pass(actor)


			_asiste_npc = ""


		if not _corner_ced_live and not _rechace_relevo:
			_pass_done = true



		_asiste_mate = ""












		if (not first_touch or _meta_sin_ti) and _handoff_live and not _corner_ced_live \
				and is_instance_valid(_self_actor) and _self_actor != actor \
				and not _is_you(_self_actor) and not _es_regreso(actor):
			var pasador_npc: String = String(_finisher_of(_self_actor).get("name", ""))
			if not _pase_mate.is_empty():
				_cuenta_accion_npc(false, _pase_mate, "pass")
			_pase_mate = pasador_npc
			_asiste_npc = pasador_npc
		var who: String = String(_finisher_of(actor).get("name", ""))










		if header and _ai_header_flick(actor):
			return








		if _es_regreso(actor):
			_regreso_a_ti(actor, releva)












		var clave: bool = pase_tuyo and not releva and not _es_regreso(actor)
		if clave:
			match_key_passes += 1
			_key_pass_live = true
			if not _pass_open.is_empty():
				_pass_open["kp"] = true





		var verb: String = "¡Cabezazo de {0}!" if header \
				else ("¡Pase a {0}!" if releva or _es_regreso(actor) else "¡Pase clave a {0}!")
		var solo: String = "¡Cabezazo!" if header \
				else ("¡Pase!" if releva or _es_regreso(actor) else "¡Pase clave!")
		_hud.show_message(I18n.tf(verb, [who]) if not who.is_empty() else I18n.t(solo),
			CareerTheme.GOOD, 0.8)



		_touch_q = _first_touch_q(actor, header)











		if releva:
			_handoff_to(actor)
			return














		_ai_shot_from_ball(actor, header)
	elif actor == _keeper:












		if absf(_keeper.position.x) > KEEPER_LIBERO_MAX_X \
				or _keeper.position.z > KEEPER_LIBERO_MAX_Z:
			_rival_clear()
		else:
			_keeper_claim_ball()
	elif not _desv_vivo(actor, antes):




		_rival_clear()























