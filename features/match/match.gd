		_pad_rt_golpea(_pad_rt)
	_pad_objetivo_tick()
	var izq: Vector2 = Entrada.eje_pad(true)
	if tec:
		izq = _tec_punto_tick(izq)
	_pad_izq(izq, _pad_mantener())
	_pad_der(Entrada.eje_pad(false))













