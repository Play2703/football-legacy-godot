const DRON_ALCANCE: Array[float] = [0.2, 1.4, 2.6, 3.6, 4.6, 5.5, 6.3, 7.0, 7.6, 8.1,
	8.6, 8.9, 9.1, 9.1, 9.1, 9.0, 8.7, 8.5, 8.2, 7.8, 7.4, 7.0, 6.5, 6.0, 5.4, 4.8, 4.1]


const DRON_MARGEN: float = 0.5






const DRON_PANT_X: float = 0.12
const DRON_PANT_Y0: float = 0.14
const DRON_PANT_Y1: float = 0.66

const DRON_INTENTOS: int = 24


