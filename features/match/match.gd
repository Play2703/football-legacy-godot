const PEDIDO_TOPE: float = 0.85
const PEDIDO_POR_PUNTO: float = 0.025
const PEDIDO_SUELO: float = 0.05


const PEDIDO_RESPUESTA_S: float = 0.9

const PEDIDO_SI: String = "pido"
const PEDIDO_NO: String = "dejo"


var _pedido_dado: float = -1.0




static func pedido_p(mio: int, suyo: int) -> float:
	return clampf(PEDIDO_TOPE + float(mio - suyo) * PEDIDO_POR_PUNTO,
		PEDIDO_SUELO, PEDIDO_TOPE)







func _pedido_ficha(penal: bool) -> Dictionary:
	if not _cobro_cedido_visible() or GameState.readonly_save:
		return {}
	return _pedido_lanzador(penal)




func _pedido_lanzador(penal: bool) -> Dictionary:
	var key: String = "penal" if penal else "parado"
	var ficha: Dictionary = _taker_row_de(
		Career.penalty_taker() if penal else Career.set_piece_taker(), key)
	if ficha.is_empty() or String(ficha.get("name", "")) == Career.player_name:
		return {}
	return ficha







func _pedido_escena(pedido: Dictionary, chance: Dictionary) -> bool:
	var ficha: Dictionary = Dictionary(pedido.get("ficha", {}))
	var penal: bool = bool(pedido.get("penal", false))
	var quien: String = String(ficha.get("name", ""))
	var key: String = "penal" if penal else "parado"
	var suyo: int = int(ficha.get(key, 0))
	var mio: int = int(Career.skills.get(key, 0))

	var estado: int = state
	_shootout_active = true


	var spot: Vector2 = chance.get("ball", Vector2(0.0, 11.0))
	var esc: Dictionary = _cesion_monta(ficha, false,
		Vector2.ZERO if penal else spot - Vector2(0.0, 11.0))
	_hud.show_message(I18n.tf("EL PENAL ES DE {0}", [quien]) if penal
		else I18n.tf("LA FALTA ES DE {0}", [quien]), UiKit.GOLD, CESION_PIDE_S + 0.6)
	await _shoot_wait(CESION_PIDE_S)



	var si_pct: int = roundi(pedido_p(mio, suyo) * 100.0)
	_hud.ask_choice(Competitions.accent_of(GameState.current_fixture()),
		PEDIDO_SI, I18n.t("PÍDESELO"), PEDIDO_NO, I18n.t("DÉJASELO"),
		I18n.tf("SÍ {0} % · NO {1} %", [si_pct, 100 - si_pct]))
	var elijo: String = String(await _hud.choice_made)

	_hud.clear_coin_panel()
	var te_lo_da: bool = false
	if elijo == PEDIDO_SI:
		_hud.show_message(I18n.tf("LE PIDES EL BALÓN A {0}", [quien]), UiKit.GOLD,
			PEDIDO_RESPUESTA_S + 0.3)
		await _shoot_wait(PEDIDO_RESPUESTA_S)
		te_lo_da =(_pedido_dado if _pedido_dado >= 0.0 else randf()) \
				< pedido_p(mio, suyo)
		if te_lo_da:
			_hud.show_message(I18n.tf("{0} TE DA EL PENAL", [quien]) if penal
				else I18n.tf("{0} TE DA LA FALTA", [quien]), UiKit.GOLD, 1.4)
		else:
			_hud.show_message(I18n.tf("{0} SE LO QUEDA" if penal
				else "{0} SE LA QUEDA", [quien]), UiKit.DANGER, 1.4)


			_pedido_note = {"minute": match_minute, "text":
				I18n.tf("LE PIDES EL PENAL A {0} Y SE LO QUEDA", [quien]) if penal
				else I18n.tf("LE PIDES LA FALTA A {0} Y SE LA QUEDA", [quien])}
		await _shoot_wait(0.5)




	await _pedido_desenlace(esc, te_lo_da, Vector2(0.0, 11.0) if penal else spot)
	_cesion_recoge(esc)
	_shootout_active = false
	if state != State.ENDED:
		state = estado
	if te_lo_da:


		if bool(pedido.get("paga_falta", false)):
			_bump_rating("foul_won")
		_pedido_abre(penal, quien)
		_hud.show_hint(_solo_academia(_aim_hint()))
		return true
	await _cobro_cedido(penal, ficha)
	return false


const PEDIDO_PASE_S: float = 0.45
const PEDIDO_SALE_S: float = 1.6
const PEDIDO_SALE_M: float = 4.5
const PEDIDO_COLOCA_S: float = 1.1














func _pedido_desenlace(esc: Dictionary, te_lo_da: bool, punto: Vector2) -> void:
	var props: Array = Array(esc.get("props", []))
	if props.size() < 2:
		return
	var yo: AnimatedSprite3D = props[0]
	var el: AnimatedSprite3D = props[1]
	if not is_instance_valid(yo) or not is_instance_valid(el):
		return
	var ball_pos: Vector3 = _ball.position
	var pecho: Vector3 = Vector3(0.0, PLAYER_HEIGHT_M * 0.45, 0.0)
	if te_lo_da:
		_cara(el, "resoplar", 2.4)
		_cara(yo, "alegria", 2.6)
		_sub_play(el, "idle", "idle")
		_ball.position = Vector3(el.position.x, 0.0, el.position.z) + pecho
		_ball.visible = true
		var hasta: Vector3 = Vector3(yo.position.x, 0.0, yo.position.z) + pecho
		var medio: Vector3 = _ball.position.lerp(hasta, 0.5) + Vector3(0.0, 0.7, 0.0)
		var tw: Tween = create_tween()
		tw.tween_property(_ball, "position", medio, PEDIDO_PASE_S * 0.5) \
				.set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_SINE)
		tw.tween_property(_ball, "position", hasta, PEDIDO_PASE_S * 0.5) \
				.set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_SINE)
		await tw.finished
		_ball.visible = false
		_balon_al_brazo(yo)


		var sale: Vector3 = el.position + _cesion_cam.global_transform.basis.x \
				* PEDIDO_SALE_M + Vector3(0.0, 0.0, 0.6)
		_sub_play(el, _pedido_anda(el.position, sale), "idle")
		var tw_sale: Tween = create_tween()
		tw_sale.tween_property(el, "position", sale, PEDIDO_SALE_S)
		await tw_sale.finished
	else:
		_cara(yo, "protesta", 2.0)
		_cara(el, "concentra", 2.8)


		var me_voy: Vector3 = yo.position - _cesion_cam.global_transform.basis.x \
				* PEDIDO_SALE_M + Vector3(0.0, 0.0, 0.8)
		_sub_play(yo, _pedido_anda(yo.position, me_voy), "idle")
		var tw_yo: Tween = create_tween()
		tw_yo.tween_property(yo, "position", me_voy, PEDIDO_SALE_S)
		await _shoot_wait(0.35)




		var al_punto: Vector3 = Vector3(punto.x - 0.35, el.position.y, punto.y + 0.5)
		_sub_play(el, _pedido_anda(el.position, al_punto), "idle")
		_ball.visible = true
		var al_pie: Vector3 = Vector3(0.35, BALL_R, -0.5)
		_ball.position = Vector3(el.position.x, 0.0, el.position.z) + al_pie
		var tw_el: Tween = create_tween().set_parallel(true)
		tw_el.tween_property(el, "position", al_punto, PEDIDO_COLOCA_S)
		tw_el.tween_property(_ball, "position", Vector3(punto.x, BALL_R, punto.y),
			PEDIDO_COLOCA_S)
		await tw_el.finished
		_sub_play(el, "idle", "idle")
		if tw_yo.is_running():
			await tw_yo.finished
		await _shoot_wait(0.6)
	_ball.visible = false
	_ball.position = ball_pos







func _pedido_anda(desde: Vector3, hasta: Vector3) -> String:
	var derecha: Vector3 = _cesion_cam.global_transform.basis.x
	return "walk_east" if (hasta - desde).dot(derecha) > 0.0 else "walk_west"





