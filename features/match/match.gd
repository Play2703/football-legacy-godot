func _strike_mira_tick() -> void:
	if not _strike_mira:
		return
	if state != State.STRIKING or not _shot_cam.current or _serve_i >= _serve_k \
			or (not _serve_salto.is_empty() and not _servicio_chilena_pre()):
		_strike_mira_fin()
		return
	var al: Vector3 = _ball.position - _shot_cam.global_position
	if al.length() < 0.05:
