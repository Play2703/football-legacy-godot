func _press_out_chance(forzado: String = "") -> Dictionary:













	var arq: Dictionary = PressArchetypes.by_id(forzado) if not forzado.is_empty() \
			else PressArchetypes.pick(randf(), _press_arq_prev, _tac_hoy(),
			-1.0 if _press_sitio_off else _press_z_prev, PRESS_OUT_ALTURA_DIF)
	if forzado.is_empty():






		_press_arq_prev = String(arq.get("id", ""))
	var zb: Vector2 = arq.get("z", PRESS_OUT_Z)
	var x: float
	var z_bal: float
	if forzado.is_empty() and not _press_sitio_off:




		x = _press_x_nueva(arq)
		z_bal = _press_z_nueva(zb)
		_press_carril_prev = _press_carril(x)
		_press_z_prev = z_bal
	else:
		if arq.has("x_abs"):
			var xa: Vector2 = arq["x_abs"]
			x = randf_range(xa.x, xa.y) *(1.0 if randf() < 0.5 else -1.0)
			x = clampf(x, - FIELD_EDGE + 1.0, FIELD_EDGE - 1.0)
		else:
			x = randf_range(- PRESS_OUT_X, PRESS_OUT_X)
		z_bal = randf_range(zb.x, zb.y)
	var ball: Vector2 = Vector2(x, z_bal)
	var defs: Array = []
	var cupo: Vector2i = arq.get("defs", PRESS_OUT_DEFS)
	var n: int = randi_range(cupo.x, cupo.y)





	var once: Dictionary = _rival_eleven_at(ball)
	var a_tiro: int = 0
	for p in once["pos"]:
		if (p as Vector2).distance_to(ball) <= PRESS_REACH_M:
			a_tiro += 1
	n = clampi(n, PRESS_MIN_DEFS,
		maxi(PRESS_MIN_DEFS, mini(a_tiro,(once["pos"] as Array).size())))




	if _tutorial_active:
		n = maxi(PRESS_MIN_DEFS, mini(n, TUTORIAL_RIVALES_MAX))






















	var forma: String = PressArchetypes.forma(arq, randf(),
		[] if n >= 3 else ["cerco"])



	var lado_x: float = - signf(x) if arq.has("x_abs") and x != 0.0 \
			else (1.0 if randf() < 0.5 else -1.0)
	var a0: float = randf() * TAU







	var hueco_w: float = float(PressArchetypes.HUECOS.get(forma, 0.0))
	var hueco: float = 0.0
	match forma:
		"embudo":

			hueco = PI * 0.5
		"lado":


			hueco = PI if lado_x > 0.0 else 0.0
		"espalda":


			hueco = 0.0 if randf() < 0.5 else PI
		_:



			hueco = a0 + PI





	var muerde: int = 0
	if forma == "lado" and n > 1:
		muerde = 1 + randi() %(n - 1)
	elif forma != "espalda":
		muerde = randi() % n
	for i in n:
		var ang: float = 0.0



		var r: float = randf_range(PRESS_R_MUERDE.x, PRESS_R_MUERDE.y) \
				if i == muerde else randf_range(PRESS_R_CUBRE.x, PRESS_R_CUBRE.y)
		match forma:
			"embudo":


				ang = - PI * 0.5 + lerpf(-1.22, 1.22,
					(float(i) + 0.5) / float(n)) + randf_range(-0.15, 0.15)
			"lado":


				if i == 0:
					ang = - PI * 0.5 + randf_range(-0.3, 0.3)
					r = randf_range(PRESS_OUT_R.y * 0.8, PRESS_OUT_R.y)
				else:













					var m: float = maxf(float(n) - 1.0, 1.0)
					var arco: float = clampf(0.3 * m, 0.7, 1.05)
					var paso: float = 2.0 * arco / m
					ang =(0.0 if lado_x > 0.0 else PI) \
							+ lerpf(- arco, arco,(float(i) - 0.5) / m) \
							+ _jitter_reparto(paso)
			"espalda":


				if i == 0:
					ang = PI * 0.5 + randf_range(-0.4, 0.4)





					r = randf_range(PRESS_R_MUERDE.x, PRESS_R_MUERDE.y)
				else:














					var m_e: float = maxf(float(n) - 1.0, 1.0)
					ang = - PI * 0.5 + lerpf(-1.0, 1.0,(float(i) - 0.5) / m_e) \
							+ _jitter_reparto(2.0 / m_e)
			_:


				ang = a0 + TAU * float(i) / float(n) + randf_range(-0.35, 0.35)





		ang = _fuera_del_hueco(ang, hueco, hueco_w)
		var p: Vector2 = ball + Vector2(cos(ang), sin(ang)) * r
		defs.append(Vector2(
			clampf(p.x, - Stadium.FIELD_HALF_W + 1.0, Stadium.FIELD_HALF_W - 1.0),
			clampf(p.y, 4.0, Stadium.FIELD_DEPTH - 4.0)))





















	if not PRESS_OUT_RING:
		defs = []
	var mundo: Dictionary = _press_world(ball, once, defs)
	return {
		"kind": "regate",



		"name": String(arq.get("name", "Cruza el medio campo")),
		"press_arq": String(arq.get("id", "atras")),








		"press_libre": true,
		"press_bandas": arq.get("bandas", [2, 2]),


		"press_tramos": arq.get("tramos", []),
		"press_respiro": float(arq.get("respiro", PRESS_ZONE_TIRE_BACK)),
		"press_guardias": String(arq.get("guardias", "cubre")),
		"press_punta": String(arq.get("punta", "")),
		"press_ruta": int(arq.get("ruta", 0)),
		"ball": ball,


		"target_z": -10.0,
		"teammates": [],
		"defenders": defs,



		"defender_players": mundo["press_players"],



		"extras_rivals": mundo["rivals"],
		"extras_rival_players": mundo["rival_players"],
		"extras_mates": mundo["mates"],
		"press_out": true,




		"press_shape": forma,



		"press_hueco": hueco,
		"press_hueco_w": hueco_w,
	}













