func _carga_gesto(dir: Vector3) -> String:
	var d: String = _dir_name(dir)
	for fam in ["empeine_", "kick_"]:
		var a: String = String(fam) + d
		if _gesto_listo(_self_actor, a) \
				and _self_actor.sprite_frames.get_frame_count(a) > CARGA_CUADRO + 1:
			return a
	return ""





func _carga_arma() -> void:
	_carga_soltada = false
	if not is_instance_valid(_self_actor) or _self_actor.sprite_frames == null:
		return


	if _carga_viva and String(_self_actor.animation) == _carga_anim:
		return
	var anim: String = _carga_gesto(Vector3(- _self_actor.position.x, 0.0,
		- _self_actor.position.z))
	if anim.is_empty():
		return
	_carga_prev = [_self_actor.animation, _self_actor.frame, _self_actor.frame_progress]
	_carga_viva = true
	_carga_anim = anim
	_carga_gen += 1
	var gen: int = _carga_gen



	_self_actor.play(anim)
	_self_actor.pause()
	var fps: float = maxf(_self_actor.sprite_frames.get_animation_speed(anim), 1.0)
	SceneFade.timer(float(CARGA_CUADRO) / fps, false).timeout.connect(
		_carga_pierna_atras.bind(gen, anim))






func _carga_pierna_atras(gen: int, anim: String) -> void:
	if _carga_viva and gen == _carga_gen and is_instance_valid(_self_actor) \
			and String(_self_actor.animation) == anim:
		_self_actor.set_frame_and_progress(CARGA_CUADRO, 0.0)






