func _anim_slices(tex: Texture2D, tier: String = "", role: String = "*") -> Array[Dictionary]:
	var ckey: String = tex.resource_path + "|" + tier + "|" + role
	var chit: Variant = _slices_cache.get(ckey)
	if chit is Array:
		return chit
	var out: Array[Dictionary] = []
	for row in ACTOR_ANIMS:
		if bool(row.get("team_only", false)) and tex != TEAM_TEX:
			continue




		if bool(row.get("team_drain", false)) and tex != TEAM_TEX and role != "*":
			continue





		if bool(row.get("sin_drenado", false)) and role != "*":
			continue
		if role != "*":
			if bool(row.get("self_only", false)) and role != "self":
				continue
			if bool(row.get("ref_only", false)) and role != "ref":
				continue
		var is_idle: bool = String(row["anim"]).begins_with("idle")
		if (tier == "idle" and not is_idle) or (tier == "rest" and is_idle):
			continue
		var dirs: Array = ANIM_DIRS if bool(row.get("dirs", false)) else [""]
		for d in dirs:
			var paths: Array[String] = []
			for i in range(int(row["from"]), int(row["to"]) + 1):
				var path: String = ANIM_ROOT +(
					(String(row["path"]) % [d, i]) if d != "" \
							else (String(row["path"]) % i))
				if ResourceLoader.exists(path):
					paths.append(path)
			if paths.is_empty():
				continue
			out.append({
				"anim":(String(row["anim"]) % d) if d != "" else String(row["anim"]),
				"paths": paths,
				"fps": float(row["fps"]),
				"loop": bool(row["loop"]),
			})










	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		var ar: bool = String(a["anim"]).begins_with("run")
		var br: bool = String(b["anim"]).begins_with("run")
		return ar and not br)
	_slices_cache[ckey] = out
	return out


func _build_actor_frames(tex: Texture2D, cfg: Dictionary) -> SpriteFrames:
	var frames: SpriteFrames = SpriteFrames.new()




	for slice in _anim_slices(tex, "idle"):
		var anim: String = slice["anim"]
		frames.add_animation(anim)
		frames.set_animation_loop(anim, bool(slice["loop"]))
		frames.set_animation_speed(anim, float(slice["fps"]))
		for path in slice["paths"]:
			frames.add_frame(anim, KitRecolor.apply(_fuente_reposo(path), cfg))



	if not frames.has_animation("idle"):
		frames.add_animation("idle")
		frames.set_animation_loop("idle", true)
		frames.set_animation_speed("idle", 4.5)
		frames.add_frame("idle", KitRecolor.apply(tex, cfg))
	return frames










static var _fuentes_reposo: Dictionary = {}

static func _fuente_reposo(path: String) -> Texture2D:
	if not KitRecolor.en_hilo_principal():
		return load(path)
	var t: Texture2D = _fuentes_reposo.get(path)
	if t == null:
		t = load(path)
		_fuentes_reposo[path] = t
	return t





func _spawn_keeper(x: float, look: Dictionary = {},
		is_rival: bool = true, dorsal: int = 0) -> AnimatedSprite3D:
	var k: AnimatedSprite3D = AnimatedSprite3D.new()


	if not KitRecolor.clima_tela.is_empty() and look.has("kit"):
		look = look.duplicate()
		look.merge(KitRecolor.clima_tela)
	look = _con_barro(look)
	k.sprite_frames = _keeper_frames(look)
	k.pixel_size = KEEPER_HEIGHT_M / KEEPER_METRICS.x
	k.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	k.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	k.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	k.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON



	k.position = Vector3(x, KEEPER_METRICS.y * k.pixel_size, _keeper_home_z())
	k.play("idle")
	_actors.add_child(k)

	_portero_laminas(k, look, is_rival, dorsal)
	return k






func _portero_laminas(k: AnimatedSprite3D, look: Dictionary, is_rival: bool,
		dorsal: int) -> void:





	k.set_meta("cara_cfg", look)


	_pecho_vestir(k, look, is_rival)












	if dorsal > 0:
		var placa: Dictionary = look.duplicate()
		placa["number"] = dorsal
		_espalda_vestir(k, placa)


		_short_vestir(k, placa)




















func _revestir_portero(k: AnimatedSprite3D, look: Dictionary, is_rival: bool,
		dorsal: int) -> void:
	if k == null or not is_instance_valid(k):
		return
	k.sprite_frames = _keeper_frames(look)
	if k.has_meta("anim_cfg"):
		k.set_meta("anim_tex", KEEPER_TEX)
		k.set_meta("anim_cfg", look)


	_laminas_retira(k)
	_portero_laminas(k, look, is_rival, dorsal)









func _keeper_frames(look: Dictionary) -> SpriteFrames:




	var ls: String = var_to_str(look)
	var fl: Dictionary = look.duplicate()
	fl.erase("keeper_base")
	var key: String = "keeper|" + ls
	if _propios_looks.has(ls):
		_apunta_portero_propio(key, [ls, var_to_str(fl)])
	else:
		_evict_cfg_strs[ls] = true
		_evict_cfg_strs[var_to_str(fl)] = true
	var hit: Variant = _frames_hit(key)
	if hit is SpriteFrames:



		_atlas_revisa(hit, true)
		return hit





	var frames: SpriteFrames = _build_keeper_frames(look)



	_atlas_revisa(frames, true)
	_frames_put(key, frames)
	return frames


