func _parada_i_contacto() -> int:
	var cue: int = _keeper_out_i if _keeper_out_i >= 0 else _cross_i
	if cue < 0:
		return -1
	var ic: int = _rebound_i if _rebound_i >= 0 else (_pecho_i if _pecho_i >= 0 else _stop_i)
	var i_c: int = cue
	if ic >= 0:
		i_c += clampi(ic - cue, 0, 1)
	if _stop_i > 0:
		i_c = mini(i_c, _stop_i)
	return i_c





















func _parada_huecos(anim: String, dx: float, dive_x: float) -> Dictionary:
	if not SAVE_VARIANTES.has(anim) or _keeper == null:
		return {}
	var geo: Dictionary = _parada_geo(dive_x, dx < 0.0)
	if geo.is_empty():
		return {}
	var out: Dictionary = {}
	for g: String in SAVE_VARIANTES:
		for v: String in SAVE_VARIANTES[g]:
			var vista: String = _keeper_anim(v)
			var enc: float = maxf(float((KEEPER_SIGUE_CONTACTO.get(vista, [0, 0.0, 0.0]) as Array)[2]), 0.0)
			out[v] = _parada_hueco_en(geo, vista, enc)
	if parada_traza:
		pinta_traza_ultima = geo.duplicate()
		pinta_traza_ultima["huecos"] = out.duplicate()
	return out




func _parada_geo(dive_x: float, flip: bool) -> Dictionary:
	var i_c: int = _parada_i_contacto()
	if i_c < 0 or i_c >= _traj.size() or _keeper == null:
		return {}
	var nodo_bola: Vector3 = _traj[i_c] + Vector3(0.0, BALL_VISUAL_D * 0.5, 0.0)
	var cam: Camera3D = _aim_cam if _aim_cam != null and is_instance_valid(_aim_cam) \
			and _aim_cam.current else get_viewport().get_camera_3d()
	var cam_pos: Vector3 = Vector3.INF
	var bas: Basis = Basis.IDENTITY
	if cam != null:
		cam_pos = cam.global_position
		var mira: Vector3 = nodo_bola + Vector3(0.0, 0.6, 0.0) - cam_pos
		bas = Basis.looking_at(mira.normalized(), Vector3.UP) \
				if mira.length_squared() > 0.01 else cam.global_transform.basis
	var ps: float = _ball.pixel_size if _ball != null else BALL_VISUAL_D / 32.0
	var off: Vector2 = _ball.offset if _ball != null else Vector2(0.0, - BALL_PAD_PX)
	return {"i_c": i_c, "bola": nodo_bola + bas.x *(off.x * ps) + bas.y *(off.y * ps),
		"suelo": Vector3(dive_x, _keeper_base_y - ParadaAlcance.NODO_SOBRE_CESPED,
			_keeper.position.z), "cam": cam_pos, "bas": bas, "flip": flip}


func _parada_hueco_en(geo: Dictionary, vista: String, enc: float) -> float:
	return ParadaAlcance.hueco_visto(vista, enc, bool(geo["flip"]), geo["suelo"], geo["bola"],
		BALL_ART_R, geo["cam"], geo["bas"])






func _pinta_variante(anim: String, dx: float, huecos: Dictionary = {}) -> String:
	if not pinta_forzada.is_empty() and _keeper.sprite_frames.has_animation(pinta_forzada) \
			and (pinta_forzada in SAVE_VARIANTES.get(anim, []) or (pinta_forzada_cruza
			and SAVE_VARIANTES.has(anim) and (pinta_forzada in SAVE_VARIANTES["dive"]
			or pinta_forzada in SAVE_VARIANTES["dive_high"]))):
		return pinta_forzada
	var grupo: Array = _pinta_grupo(anim, dx)
	var pool: Array = []
	if pinta_por_alcance and not huecos.is_empty():
		pool = ParadaAlcance.bombo(grupo, anim, _parada_ultima, huecos)

		if pinta_otro_grupo and not ParadaAlcance.alguno_llega(grupo, huecos):
			for g: String in SAVE_VARIANTES:
				if g == anim:
					continue
				var otro: Array = _pinta_grupo(g, dx)
				if ParadaAlcance.alguno_llega(otro, huecos):
					pool = ParadaAlcance.bombo(otro, g, _parada_ultima, huecos)
		if parada_traza:
			pinta_traza_ultima["pool"] = pool.duplicate()
	else:
		for v in grupo:
			if v != _parada_ultima:
				pool.append(v)
	if pool.is_empty():
		return anim
	return pool[_parada_rng.randi() % pool.size()]



func _pinta_grupo(anim: String, dx: float) -> Array:
	var grupo: Array = []
	for v in SAVE_VARIANTES.get(anim, []):
		if v == "parada_caida" and absf(dx) > SAVE_CAIDA_VIAJE:
			continue
		if _keeper.sprite_frames.has_animation(v):
			grupo.append(v)
	return grupo


func _prepare_keeper(restante: float = 0.45) -> void:
	if _keeper == null or not _keeper.has_meta("dive_x"):
		return
	var dive_x: float = _keeper.get_meta("dive_x", 0.0)
	var dx: float = dive_x - _keeper.position.x

	var anim: String = _keeper.get_meta("save_anim", _pick_save_anim(dx, _cross.y))
	if not _keeper.sprite_frames.has_animation(anim):
		anim = "dive"
















	var pinta: String = anim
	if _outcome != "save":
		if pinta == "jump_catch":
			pinta = "jump"
		elif pinta == "catch":
			pinta = "dive"
		if not _keeper.sprite_frames.has_animation(pinta):
			pinta = anim




	var huecos: Dictionary = {}
	if pinta_por_alcance and _outcome == "save":
		huecos = _parada_huecos(pinta, dx, dive_x)
	pinta = _pinta_variante(pinta, dx, huecos)
	var bola: Vector2 = _keeper.get_meta("save_ball", Vector2(_cross.x, _cross.y))

	var pie: String = _pinta_pie(anim, dx, dive_x, bola)
	if not pie.is_empty() and _keeper.sprite_frames.has_animation(pie):
		pinta = pie



	var lado_bl: float = 0.0
	if _outcome == "save" and _blocaje_suave(anim, bola.y):
		var bl: String = _pinta_blocaje(bola.x - _keeper.position.x)
		if _keeper.sprite_frames.has_animation(bl):
			pinta = bl
			var cuerpo: Vector2 = _blocaje_cuerpo_x(bl, _keeper.position.x, bola.x)
			dive_x = cuerpo.x
			dx = dive_x - _keeper.position.x
			lado_bl = cuerpo.y
	_keeper.set_meta("save_pinta", pinta)
	_parada_ultima = pinta
	if pinta.begins_with("pie_") or pinta.begins_with("blocaje_"):
		_cara(_keeper, CARA_PIE, CARA_PIE_S)
	if _keeper_tween and _keeper_tween.is_valid():
		_keeper_tween.kill()













	var duration: float = minf(clampf(absf(dx) / 4.2, 0.3, 0.8),
		maxf(restante, 0.12))
	_keeper_tween = create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	_keeper_tween.tween_property(_keeper, "position:x", dive_x, duration)

	_keeper.flip_h = dx < 0.0


	if lado_bl != 0.0:
		_keeper.flip_h = lado_bl < 0.0
	_keeper.play(_keeper_anim(pinta))







	if (anim == "dive" or anim == "dive_high" or anim == "jump") and lado_bl == 0.0:
		_keeper_knock_down(absf(dx))
		_keeper_dive_arc(anim, duration, pinta)










	_keeper.speed_scale = clampf(_anim_secs(pinta) / duration, 0.6, 2.0)


	if keeper_sigue_balon:
		_keeper_sigue_monta(anim, pinta, restante, lado_bl)


























func _keeper_sigue_monta(anim: String, pinta: String, restante: float, lado_bl: float) -> void:

	_keeper_sigue_suelta()
	_keeper_sigue_visto = {}


	if _outcome != "save" or lado_bl != 0.0 or pinta.begins_with("blocaje_"):
		return




	var vista: String = String(_keeper.animation)
	if not KEEPER_SIGUE_CONTACTO.has(vista):
		return
	var e: Array = KEEPER_SIGUE_CONTACTO[vista]
	var fr: SpriteFrames = _keeper.sprite_frames
	var n: int = fr.get_frame_count(vista)
	var fps: float = fr.get_animation_speed(vista)
	var k: int = int(e[0])
	if fps <= 0.0 or n < 2 or k > n - 1:
		return
	var meta: float = float(k) + float(e[1])





	var cue: int = _keeper_out_i if _keeper_out_i >= 0 else _cross_i
	var ic: int = _rebound_i if _rebound_i >= 0 else (_pecho_i if _pecho_i >= 0 else _stop_i)
	var i_c: int = _traj_i + roundi(restante / SIM_DT)
	if ic >= 0 and cue >= 0:
		i_c += clampi(ic - cue, 0, 1)
	if _stop_i > 0:
		i_c = mini(i_c, _stop_i)
	var t_c: float = float(i_c - _traj_i) * SIM_DT
	if t_c < KEEPER_SIGUE_TC_MIN:
		return
	var c: Vector3 = _compas_contacto(meta, fps, t_c)
	var arco: bool = anim == "dive" or anim == "dive_high" or anim == "jump"



	var despegue: float = minf(maxf(float(KEEPER_SIGUE_DESPEGUE.get(vista, 0)), c.z),
		meta - 0.5)
	var encaje: float = maxf(float(e[2]), 0.0)
	if keeper_sigue_apunta and arco:
		encaje = _keeper_sigue_apunta_encaje(vista, encaje)
	_keeper_sigue_plan = {"vista": vista, "meta": meta, "pausa": c.x, "s": c.y, "k0": c.z,
		"fps": fps, "n": n, "i0": _traj_i, "i_c": i_c, "t_c": t_c, "despegue": despegue,
		"encaje": encaje, "arco": arco, "paint": pinta, "seq": _chance_seq,
		"traj": _traj, "ult": _traj_i}



	_keeper.speed_scale = 0.0
	_keeper.set_frame_and_progress(int(c.z), 0.0)




	if arco:
		if _keeper_arc_tw and _keeper_arc_tw.is_valid():
			_keeper_arc_tw.kill()
		_keeper.position.y = _keeper_base_y
		_keeper_sunk_anim = ""
	_keeper_sigue_vigila_arma(t_c)




















const APUNTA_SUBE: float = 0.4
const APUNTA_PASO: float = 0.02
const APUNTA_GANA: float = 0.05
func _keeper_sigue_apunta_encaje(vista: String, encaje: float) -> float:
	if encaje <= 0.0 or not ParadaAlcance.CAJAS.has(vista) or _keeper == null:
		return encaje
	var geo: Dictionary = _parada_geo(float(_keeper.get_meta("dive_x", _keeper.position.x)),
		_keeper.flip_h)
	if geo.is_empty():
		return encaje
	var h0: float = _parada_hueco_en(geo, vista, encaje)
	if h0 <= ParadaAlcance.TOLERANCIA:
		return encaje
	var mejor: float = encaje
	var h_mejor: float = h0

	var n: int = ceili(maxf(APUNTA_SUBE, encaje) / APUNTA_PASO)
	for i in range(1, n + 1):
		for sg: float in [1.0, -1.0]:
			var e2: float = encaje + sg * float(i) * APUNTA_PASO
			if e2 < 0.0 or e2 > encaje + APUNTA_SUBE:
				continue
			var h: float = _parada_hueco_en(geo, vista, e2)
			if h <= ParadaAlcance.TOLERANCIA:
				if parada_traza:
					pinta_traza_ultima["apunta"] = [encaje, e2, h0, h]
				return e2
			if h < h_mejor - 0.0001:
				mejor = e2
				h_mejor = h
	if h0 - h_mejor < APUNTA_GANA:
		mejor = encaje
	if parada_traza:
		pinta_traza_ultima["apunta"] = [encaje, mejor, h0, h_mejor]
	return mejor







static func _compas_contacto(meta: float, fps: float, t_c: float) -> Vector3:
	var s1: float = meta /(fps * t_c)
	if s1 < KEEPER_SIGUE_S_MIN:
		return Vector3(t_c - meta /(fps * KEEPER_SIGUE_S_MIN), KEEPER_SIGUE_S_MIN, 0.0)
	if s1 > KEEPER_SIGUE_S_MAX:
		var k0: float = clampf(ceilf(meta - KEEPER_SIGUE_S_MAX * fps * t_c), 0.0,
			maxf(ceilf(meta) - 1.0, 0.0))
		return Vector3(0.0,(meta - k0) /(fps * t_c), k0)
	return Vector3(0.0, s1, 0.0)











func _keeper_sigue_paso() -> void:
	var p: Dictionary = _keeper_sigue_plan
	if _keeper == null or not is_instance_valid(_keeper) \
			or String(_keeper.animation) != String(p["vista"]):
		_keeper_sigue_suelta()
		return
	if int(p["seq"]) != _chance_seq:
		_keeper_sigue_contacto(true)
		return





	if _keeper_sigue_vuelo_nuevo(p):
		_keeper_sigue_contacto(true)
		return
	p["ult"] = _traj_i
	if _traj_i >= int(p["i_c"]):
		_keeper_sigue_contacto(false)
		return
	var t: float = float(_traj_i - int(p["i0"])) * SIM_DT
	var v: float = float(p["k0"]) + float(p["s"]) * float(p["fps"]) \
			* maxf(t - float(p["pausa"]), 0.0)
	var cuadro: int = int(floorf(v))
	_keeper.set_frame_and_progress(cuadro, v - float(cuadro))
	if bool(p["arco"]):
		var d0: float = float(p["despegue"])
		var u: float = 1.0 - clampf((v - d0) /(float(p["meta"]) - d0), 0.0, 1.0)
		_keeper.position.y = _keeper_base_y + float(p["encaje"]) *(1.0 - u * u)



func _keeper_sigue_vuelo_nuevo(p: Dictionary) -> bool:
	return not is_same(p["traj"], _traj) or _traj_i < int(p["ult"])










func _keeper_sigue_contacto(forzado: bool) -> void:
	var p: Dictionary = _keeper_sigue_plan
	_keeper_sigue_plan = {}
	if _keeper_sigue_tw and _keeper_sigue_tw.is_valid():
		_keeper_sigue_tw.kill()
	_keeper_sigue_tw = null
	if p.is_empty() or _keeper == null or not is_instance_valid(_keeper):
		return
	var vista: String = String(p["vista"])
	if String(_keeper.animation) != vista:
		if is_zero_approx(_keeper.speed_scale):
			_keeper.speed_scale = 1.0
		return
	_keeper_sigue_visto = {"antes": _keeper.frame, "vista": vista, "forzado": forzado,
		"i_c": int(p["i_c"]), "traj_i": _traj_i}
	var meta: float = float(p["meta"])
	if forzado:
		meta = float(_keeper.frame) + _keeper.frame_progress
	else:
		var k: int = int(floorf(meta))
		_keeper.set_frame_and_progress(k, meta - float(k))
		if bool(p["arco"]):
			_keeper.position.y = _keeper_base_y + float(p["encaje"])
	_keeper_sigue_visto["cuadro"] = _keeper.frame
	_keeper_sigue_visto["y"] = _keeper.position.y - _keeper_base_y
	var fps: float = float(p["fps"])
	var resto: float = maxf(float(int(p["n"]) - 1) - meta, 0.0)
	var s_b: float = clampf(resto /(fps * KEEPER_SIGUE_T_B), 1.0, KEEPER_SIGUE_SB_MAX)






	if bool(p["arco"]):
		var h: float = maxf(_keeper.position.y - _keeper_sigue_suelo(String(p["paint"])), 0.0)
		var t_cae: float = sqrt(2.0 * h / KEEPER_SIGUE_G) - KEEPER_SIGUE_LAND_TRAS
		s_b = clampf(resto /(fps * maxf(t_cae, 0.001)), KEEPER_SIGUE_S_MIN,
			KEEPER_SIGUE_SB_MAX)
	_keeper_sigue_visto["s_b"] = s_b
	var b: Dictionary = {"nodo": _keeper, "vista": vista, "s_b": s_b, "arco": bool(p["arco"]),
		"paint": String(p["paint"]), "t_b": resto /(fps * s_b), "n": int(p["n"])}
	if forzado:

		_keeper_sigue_b = b
		_keeper_sigue_b_arranca()
		return





	_keeper_sigue_tok += 1
	b["tok"] = _keeper_sigue_tok
	_keeper_sigue_b = b
	_keeper_sigue_b_tras_pintar(_keeper_sigue_tok)







func _keeper_sigue_b_tras_pintar(tok: int) -> void:
	await get_tree().process_frame
	if not is_inside_tree():
		return


	if int(_keeper_sigue_b.get("tok", -1)) == tok:





		if _keeper and is_instance_valid(_keeper) \
				and String(_keeper.animation) != String(_keeper_sigue_b["vista"]):
			_keeper_sigue_b_arranca()
			return
		_keeper_sigue_b["pinta"] = true
	await get_tree().process_frame
	if _keeper_sigue_b.is_empty() or int(_keeper_sigue_b.get("tok", -1)) != tok:
		return
	_keeper_sigue_b_arranca()





func _keeper_sigue_b_arranca() -> void:
	var b: Dictionary = _keeper_sigue_b
	_keeper_sigue_b = {}
	if b.is_empty() or _keeper == null or not is_instance_valid(_keeper) or b["nodo"] != _keeper:
		return
	if String(_keeper.animation) != String(b["vista"]):

		if is_zero_approx(_keeper.speed_scale):
			_keeper.speed_scale = 1.0



		if bool(b["arco"]) and not (_keeper_arc_tw and _keeper_arc_tw.is_valid() \
				and _keeper_arc_tw.is_running()):
			_keeper.position.y = _keeper_base_y
		return
	_keeper.speed_scale = float(b["s_b"])
	if bool(b["arco"]):
		_keeper_sigue_cae(String(b["paint"]), float(b["t_b"]), String(b["vista"]), int(b["n"]))




func _keeper_sigue_suelo(paint: String) -> float:
	return _keeper_base_y - _save_land_air(_save_land_key(paint))








func _keeper_sigue_cae(paint: String, t_b: float, vista: String, n: int) -> void:
	if _keeper_arc_tw and _keeper_arc_tw.is_valid():
		_keeper_arc_tw.kill()
	var floor_y: float = _keeper_sigue_suelo(paint)
	var h: float = maxf(_keeper.position.y - floor_y, 0.0)
	var t_min: float = t_b + KEEPER_SIGUE_LAND_TRAS
	var caida: float = maxf(t_min, sqrt(2.0 * h / KEEPER_SIGUE_G_MAX))








	var libre: float = _keeper_down_left() - KEEPER_SIGUE_PLAZO
	if libre < caida:
		var s0: float = _keeper.speed_scale
		var corta: float = maxf(maxf(libre, sqrt(2.0 * h / KEEPER_SIGUE_G_MAX)),
			t_b * s0 / KEEPER_SIGUE_SB_MAX + KEEPER_SIGUE_LAND_TRAS)
		if corta < caida:
			if t_b > 0.0:
				_keeper.speed_scale = s0 * t_b /(corta - KEEPER_SIGUE_LAND_TRAS)
				_keeper_sigue_visto["s_b"] = _keeper.speed_scale
			_keeper_sigue_visto["apurada"] = corta
			caida = corta
	var arc: Tween = create_tween()
	_keeper_arc_tw = arc
	arc.tween_property(_keeper, "position:y", floor_y, caida) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
	arc.tween_callback(_keeper_land.bind(paint))












	_keeper_sigue_caida = {"arc": arc, "vista": vista, "n": n, "suelo": floor_y}











func _keeper_sigue_mira() -> void:
	if bool(_keeper_sigue_b.get("arco", false)):
		var falta: float = _keeper_down_left()
		var pinta: bool = bool(_keeper_sigue_b.get("pinta", false))
		if falta <= 0.0 or (falta <= KEEPER_SIGUE_PLAZO and pinta):



			if not pinta:
				_keeper_sigue_visto["sin_pintar"] = true
			_keeper_sigue_b_arranca()
	if not _keeper_sigue_caida.is_empty():
		_keeper_sigue_mira_caida()





func _keeper_sigue_mira_caida() -> void:
	var c: Dictionary = _keeper_sigue_caida
	var arc: Tween = c["arc"]
	if arc == null or arc != _keeper_arc_tw or not arc.is_valid() or not arc.is_running():
		_keeper_sigue_caida = {}
		return
	if _keeper_down_left() > KEEPER_SIGUE_PLAZO:
		return
	_keeper_sigue_caida = {}

	if _keeper and is_instance_valid(_keeper):
		_keeper_sigue_visto["plazo_h"] = _keeper.position.y - float(c["suelo"])
	_keeper_sigue_plazo(arc, String(c["vista"]), int(c["n"]))





func _keeper_sigue_plazo(arc: Tween, vista: String, n: int) -> void:
	if arc == null or arc != _keeper_arc_tw or not arc.is_valid() or not arc.is_running():
		return
	if _keeper and is_instance_valid(_keeper) and String(_keeper.animation) == vista:
		_keeper.set_frame_and_progress(n - 1, 0.0)
	arc.custom_step(60.0)







func _keeper_sigue_vigila_arma(t: float) -> void:
	if _keeper_sigue_tw and _keeper_sigue_tw.is_valid():
		_keeper_sigue_tw.kill()
	var tw: Tween = create_tween().set_ignore_time_scale(true)
	_keeper_sigue_tw = tw
	tw.tween_interval(t + KEEPER_SIGUE_VIGIA)
	tw.tween_callback(_keeper_sigue_vigila.bind(int(_keeper_sigue_plan["seq"])))


func _keeper_sigue_vigila(seq: int) -> void:

	_keeper_sigue_tw = null
	if _keeper_sigue_plan.is_empty() or int(_keeper_sigue_plan["seq"]) != seq:
		return
	if state == State.FLIGHT and seq == _chance_seq \
			and not _keeper_sigue_vuelo_nuevo(_keeper_sigue_plan) \
			and _traj_i < int(_keeper_sigue_plan["i_c"]):
		_keeper_sigue_vigila_arma(0.0)
		return
	_keeper_sigue_contacto(true)





func _keeper_sigue_suelta() -> void:
	if _keeper_sigue_tw and _keeper_sigue_tw.is_valid():
		_keeper_sigue_tw.kill()
	_keeper_sigue_tw = null


	var b_pend: bool = not _keeper_sigue_b.is_empty()
	_keeper_sigue_b = {}
	if _keeper_sigue_plan.is_empty() and not b_pend:
		return
	_keeper_sigue_plan = {}
	if _keeper and is_instance_valid(_keeper) and is_zero_approx(_keeper.speed_scale):
		_keeper.speed_scale = 1.0











































const SAQUE_RIVAL_ESPERA: float = 0.45

const SAQUE_RIVAL_TOPE: float = 1.8


const SAQUE_RIVAL_FRENO: float = 3.0



const SAQUE_RIVAL_V_MIN: float = 6.0
const SAQUE_RIVAL_V_MAX: float = 13.5


const SAQUE_RIVAL_D_MIN: float = 6.0
const SAQUE_RIVAL_D_MAX: float = 28.0



const SAQUE_RIVAL_ABANICO_Z: float = 0.35


const SAQUE_RIVAL_SOBRA: float = 1.5

const SAQUE_RIVAL_CORRE: float = 6.5


const SAQUE_RIVAL_RECIBE_R: float = 0.8
const SAQUE_RIVAL_PIE: float = 0.35


const SAQUE_RIVAL_PARA_T: float = 0.35


const SAQUE_RIVAL_CONTROL_MAX_T: float = 1.0





const SAQUE_RIVAL_CAM_CERCA: float = 9.0
const SAQUE_RIVAL_CAM_ABRE: float = 0.9
const SAQUE_RIVAL_CAM_DIR: Vector3 = Vector3(0.0, 0.4, 0.92)

const SAQUE_RIVAL_CAM_MIRA_H: float = 1.0





const SAQUE_RIVAL_CAM_SUBE_GRADOS: float = 6.0

const SAQUE_RIVAL_CAM_RIGIDEZ: float = 2.5





const SAQUE_RIVAL_CAM_B_RIGIDEZ: float = 1.6


var _saque_rival_fase: int = 0
var _saque_rival_t: float = 0.0

var _saque_rival_quieto: float = 0.0
var _saque_rival_seq: int = -1

var _saque_rival_vel: Vector2 = Vector2.ZERO


var _saque_rival_rec: AnimatedSprite3D = null
var _saque_rival_rec_p: Vector2 = Vector2.ZERO



var _saque_rival_cam_vivo: bool = false

var _saque_rival_cam_b: Vector3 = Vector3.ZERO





func _saque_rival_sitio(kp: Vector2, ap: Vector2) -> Vector2:
	var u: Vector2 = ap - kp
	var d: float = u.length()
	u = u / d if d > 0.01 else Vector2(0.0, 1.0)
	if u.y < SAQUE_RIVAL_ABANICO_Z:
		var sx: float = signf(u.x) if absf(u.x) > 0.01 else 1.0
		u = Vector2(sx * sqrt(1.0 - SAQUE_RIVAL_ABANICO_Z * SAQUE_RIVAL_ABANICO_Z),
			SAQUE_RIVAL_ABANICO_Z)
	return kp + u * clampf(d, SAQUE_RIVAL_D_MIN, SAQUE_RIVAL_D_MAX)


func _saque_rival_arma() -> void:
	_saque_rival_fase = 0
	_saque_rival_cam_vivo = false
	_saque_rival_rec = null
	if not _practice_kind.is_empty() or _shootout_active or _open_resume \
			or _robo_area_vivo or not _parada_mi_arco.is_empty() \
			or not is_zero_approx(_keeper_goal_z) or not is_instance_valid(_keeper) \
			or not _keeper.sprite_frames.has_animation("saque_mano"):
		return
	var kp: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)
	var destino: Vector2 = Vector2.INF



	var mejor: float = INF
	for a: AnimatedSprite3D in _rival_actors:
		if not is_instance_valid(a) or not a.visible or a == _keeper:
			continue
		var pose: String = String(a.animation)
		if pose.begins_with("fall_") or pose.begins_with("slide_") \
				or pose.begins_with("lost_"):
			continue
		var ap: Vector2 = Vector2(a.position.x, a.position.z)
		var r: Vector2 = _saque_rival_sitio(kp, ap)
		var coste: float = ap.distance_to(r) + 0.15 * kp.distance_to(r)
		if coste < mejor:
			mejor = coste
			destino = r
			_saque_rival_rec = a
	var largo: float = 0.0
	if _saque_rival_rec != null:

		_run_target.erase(_saque_rival_rec)
		largo = kp.distance_to(destino) + SAQUE_RIVAL_SOBRA
	else:

		var lado: float = signf(kp.x) if absf(kp.x) > 0.3 \
				else (1.0 if _chance_seq % 2 == 0 else -1.0)
		destino = kp + Vector2(lado * 0.6, 1.0).normalized() * 14.0
		largo = kp.distance_to(destino)
	_saque_rival_rec_p = destino
	var v: float = clampf(sqrt(2.0 * SAQUE_RIVAL_FRENO * largo),
		SAQUE_RIVAL_V_MIN, SAQUE_RIVAL_V_MAX)
	_saque_rival_vel =(destino - kp).normalized() * v
	_saque_rival_t = 0.0
	_saque_rival_quieto = 0.0
	_saque_rival_seq = _chance_seq
	_saque_rival_fase = 1
	_saque_rival_cam_vivo = true
	_saque_rival_cam_b = Vector3(kp.x, 0.0, kp.y)






func _saque_rival_cam(delta: float) -> void:
	if not _saque_rival_cam_vivo or delta <= 0.0 or _aim_cam == null \
			or not _aim_cam.current:
		return
	var k: Vector3 = Vector3(_keeper.position.x, 0.0, _keeper.position.z)


	var b: Vector3 = k
	if _saque_rival_fase == 0 or _saque_rival_fase >= 3:
		var lejano: Node3D = _ball
		if _saque_rival_rec != null and is_instance_valid(_saque_rival_rec):
			lejano = _saque_rival_rec
		b = Vector3(lejano.position.x, 0.0, lejano.position.z)
	_saque_rival_cam_b = _saque_rival_cam_b.lerp(b,
		1.0 - exp(- SAQUE_RIVAL_CAM_B_RIGIDEZ * delta))
	b = _saque_rival_cam_b
	var sujeto: Vector3 = k.lerp(b, 0.5) + Vector3(0.0, SAQUE_RIVAL_CAM_MIRA_H, 0.0)
	var lejos: float = SAQUE_RIVAL_CAM_CERCA + SAQUE_RIVAL_CAM_ABRE * k.distance_to(b)
	var quiero: Vector3 = sujeto + _bowl_off(sujeto,
		SAQUE_RIVAL_CAM_DIR.normalized() * lejos)
	var w: float = 1.0 - exp(- SAQUE_RIVAL_CAM_RIGIDEZ * delta)
	_aim_cam.global_position = _aim_cam.global_position.lerp(quiero, w)
	var ojo: Vector3 = _aim_cam.global_position
	var a_k: Vector3 =(k + Vector3(0.0, SAQUE_RIVAL_CAM_MIRA_H, 0.0) - ojo).normalized()
	var a_b: Vector3 =(b + Vector3(0.0, SAQUE_RIVAL_CAM_MIRA_H, 0.0) - ojo).normalized()
	var mira: Vector3 =(a_k + a_b).normalized()
	var eje: Vector3 = mira.cross(Vector3.UP)
	if eje.length_squared() > 0.0001:
		mira = mira.rotated(eje.normalized(), deg_to_rad(SAQUE_RIVAL_CAM_SUBE_GRADOS))
	_aim_cam_look(ojo + mira * 10.0, delta, SAQUE_RIVAL_CAM_RIGIDEZ * 1.6)
	_aim_cam.fov = lerpf(_aim_cam.fov, _aim_fov_base, w)





func _saque_rival_receptor(delta: float) -> void:
	var a: AnimatedSprite3D = _saque_rival_rec
	if a == null or not is_instance_valid(a) or _saque_rival_fase == 0:
		return
	var ahora: int = Time.get_ticks_msec()
	var ap: Vector2 = Vector2(a.position.x, a.position.z)
	var kp: Vector2 = Vector2(_keeper.position.x, _keeper.position.z)
	var venia: Vector2 = kp - ap
	if _saque_rival_fase == 4:
		_saque_rival_doma(a, delta)
		return


	_anim_usable(a, "control_" + _dir_name(Vector3(venia.x, 0.0, venia.y)))
	var meta: Vector2 = _saque_rival_rec_p
	if _saque_rival_fase == 3 and _saque_rival_vel.length_squared() <= 0.0:

		meta = _ball_field +(kp - _ball_field).normalized() * - SAQUE_RIVAL_PIE
	var falta: Vector2 = meta - ap
	if falta.length() > 0.12:
		ap += falta.normalized() * minf(falta.length(), SAQUE_RIVAL_CORRE * delta)
		a.position.x = ap.x
		a.position.z = ap.y
		_play_run(a, Vector3(falta.x, 0.0, falta.y))
	else:
		_face(a, Vector3(venia.x, 0.0, venia.y))
	_anim_lock[a] = ahora + 200
	if _saque_rival_fase != 3 or _ball_field.distance_to(ap) > SAQUE_RIVAL_RECIBE_R:
		return

	_saque_rival_vel = Vector2.ZERO
	_ball_field = ap +(kp - ap).normalized() * SAQUE_RIVAL_PIE
	_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)
	_ball_roll(Vector2.ZERO)

	if not _play_dir_gesture(a, "control", venia, CONTROL_HOLD_MS):
		_face(a, Vector3(venia.x, 0.0, venia.y))
	_saque_rival_t = 0.0
	_saque_rival_fase = 4






func _saque_rival_doma(a: AnimatedSprite3D, delta: float) -> void:
	_saque_rival_t += delta
	var ahora: int = Time.get_ticks_msec()
	_anim_lock[a] = maxi(int(_anim_lock.get(a, 0)), ahora + 200)
	var domando: bool = String(a.animation).begins_with("control_") and a.is_playing()
	if _saque_rival_t < SAQUE_RIVAL_PARA_T \
			or (domando and _saque_rival_t < SAQUE_RIVAL_CONTROL_MAX_T):
		return
	_ball_roll(Vector2.ZERO)
	var venia: Vector3 = _keeper.position - a.position
	_face(a, Vector3(venia.x, 0.0, venia.z))
	_saque_rival_fase = 0


func _saque_rival_step(delta: float) -> void:
	if _saque_rival_fase == 0 and not _saque_rival_cam_vivo:
		return
	if state != State.RESOLVED or _chance_seq != _saque_rival_seq \
			or not is_instance_valid(_keeper) or not is_instance_valid(_ball):
		_saque_rival_fase = 0
		_saque_rival_cam_vivo = false
		_saque_rival_rec = null
		return
	_saque_rival_receptor(delta)
	_saque_rival_cam(delta)

	if _saque_rival_fase >= 3 and not _keeper.is_playing() \
			and String(_keeper.animation) == "saque_mano" \
			and _keeper.sprite_frames.has_animation("idle"):
		_keeper.flip_h = false
		_keeper.play("idle")
	if _saque_rival_fase == 0 or _saque_rival_fase == 4:
		return
	_saque_rival_t += delta
	var dir: Vector2 = _saque_rival_vel.normalized()
	match _saque_rival_fase:
		1:

			if _keeper.is_playing() and _saque_rival_t < SAQUE_RIVAL_TOPE:
				_saque_rival_quieto = 0.0
				return
			_saque_rival_quieto += delta
			if _saque_rival_quieto < SAQUE_RIVAL_ESPERA:
				return
			_saque_rival_fase = 2
			_saque_rival_t = 0.0
			if _keeper_tween and _keeper_tween.is_valid():
				_keeper_tween.kill()


			_keeper.flip_h = dir.x > 0.0
			_keeper.speed_scale = 1.0
			_keeper.play("saque_mano")
			_anim_lock[_keeper] = Time.get_ticks_msec() + int(5.0 / SAQUE_MANO_FPS * 1000.0)
			_ball.visible = true
			_ball_roll(Vector2.ZERO)
		2:
			if _keeper.frame >= SAQUE_MANO_CUADRO_SUELTA \
					or _saque_rival_t >=(SAQUE_MANO_CUADRO_SUELTA + 1) / SAQUE_MANO_FPS:

				_saque_rival_fase = 3
				_ball_field = Vector2(_keeper.position.x, _keeper.position.z) + dir * 0.4
				_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)
				_audio.kick()
				return
	if _saque_rival_fase == 2:



		var lado: float = 1.0 if dir.x > 0.0 else -1.0
		var baja: float = clampf(float(_keeper.frame) / float(SAQUE_MANO_CUADRO_SUELTA), 0.0, 1.0)
		_ball.position = Vector3(_keeper.position.x + lado * 0.3,
			lerpf(RECU_SAQUE_H_MANO, RECU_SAQUE_H_SUELO, baja), _keeper.position.z + 0.25)
		return


	var spd: float = maxf(0.0, _saque_rival_vel.length() - SAQUE_RIVAL_FRENO * delta)
	_saque_rival_vel = dir * spd
	_ball_field += _saque_rival_vel * delta
	_ball.position = Vector3(_ball_field.x, BALL_VISUAL_D * 0.5, _ball_field.y)
	_ball_roll(_saque_rival_vel)
	if spd <= 0.0 and String(_keeper.animation) != "saque_mano" \
			and (_saque_rival_rec == null or not is_instance_valid(_saque_rival_rec)):
		_saque_rival_fase = 0


func _finish_flight() -> void:
	if state != State.FLIGHT:
		return
	_fx.trail_off()
	_ball.speed_scale = 1.0
	_ball.play("idle")

	if _outcome == "save" and _keeper \
			and String(_keeper.animation).trim_suffix("_north") in ["catch", "jump_catch"]:
		_ball.visible = false

		_saque_rival_arma()



	elif _outcome == "save" and _keeper \
			and String(_keeper.get_meta("save_pinta", "")).begins_with("blocaje_") \
			and String(_keeper.animation).begins_with("blocaje_"):
		_ball.position = _blocaje_balon()
		_saque_rival_arma()




	elif _outcome == "save" and _keeper and _pecho_i >= 0:
		if String(_keeper.get_meta("save_anim", "")) == "jump" and _traj.size() > 0:
			if _keeper_arc_tw and _keeper_arc_tw.is_valid():
				_keeper_arc_tw.kill()
			_keeper.position.y = _keeper_base_y
			_play_keeper_blocaje(_traj[mini(_stop_i, _traj.size() - 1)])
		_saque_rival_arma()




























	if _outcome == "save":



		_set_hero_tag(_keeper, TagSide.MATE if not _parada_mi_arco.is_empty()
			else TagSide.RIVAL)
	elif _outcome == "goal":


		if _autogol_rival(_outcome):
			if is_instance_valid(_desv_actor) and _desv_actor is AnimatedSprite3D:
				_set_hero_tag(_desv_actor as AnimatedSprite3D, TagSide.RIVAL, HERO_GOAL_MS)
		elif (_pass_done and not _rebound_cut) or _rebound_mate:
			var quien: AnimatedSprite3D = _mate_kicker \
					if _mate_kicker != null and is_instance_valid(_mate_kicker) \
					else _last_toucher
			_set_hero_tag(quien if quien != null else _self_actor, TagSide.MATE,
				HERO_GOAL_MS)
		else:
			_set_hero_tag(_self_actor, TagSide.YOU, HERO_GOAL_MS)
	if _switch_active:
		_resolve_chance("switch_fail")
		return




	if _robo_area_vivo and _outcome != "own_goal" and not _shootout_active:
		_robo_area_cierra("parada" if _outcome == "save" or _keeper_claim else "fuera")
		return






	if _outcome == "own_goal" and not _shootout_active:
		rival_goals += 1
		_sync_score()






		_stadium.crowd_react("away", "goal")


		_audio.rival_goal(_home_match)
		_haptic(40)



		if _robo_area_vivo:
			_robo_area_gol()
		else:
			_autogoles += 1
		_resolve_chance(_outcome)
		return





	if _autogol_rival(_outcome) and (not _shootout_active or _cedida_tuya):
		team_goals += 1
		_desv_ogs += 1
		_sync_score()
		_resolve_chance(_outcome)
		return





	if _outcome == "goal" and (not _shootout_active or _cedida_tuya):
		team_goals += 1
		if _pass_done and not _rebound_cut:








			if not _meta_sin_ti and _asiste_npc.is_empty():
				match_assists += 1
				_apunta_asistencia_fila()



				var clave: String = "asistencia"
				if _salida_viva:
					clave = "meta_gol" if _meta_viva else _salida_gol_clave()
				_say(clave, TALK_GOAL_DELAY)
			else:
				_apunta_asiste_npc()
				if _meta_viva:



					_say("meta_gol_sin_ti" if _meta_sin_ti else "meta_gol", TALK_GOAL_DELAY)
				elif _salida_viva:
					_say(_salida_gol_clave(), TALK_GOAL_DELAY)
		elif _rebound_mate:








			if _rechace_relevo:
				_apunta_asiste_npc()
		else:
			match_goals += 1



			_apunta_asiste_mate()

			_goals_by_kind[_chance_kind] = int(_goals_by_kind.get(_chance_kind, 0)) + 1





			if _olympic_live and _rebound_i < 0:
				_goals_by_kind["olimpico"] = int(_goals_by_kind.get("olimpico", 0)) + 1


			if _chance_kind == "libre" and _bajo_muro:
				_goals_by_kind["bajo_muro"] = int(_goals_by_kind.get("bajo_muro", 0)) + 1







			if _chance_kind == "penal" and _cross_mode:
				_goals_by_kind["panenka"] = int(_goals_by_kind.get("panenka", 0)) + 1



			if _remate_gesto in ["cabeza", "volea", "chilena"]:
				var g_k: String = "gesto_" + _remate_gesto
				_goals_by_kind[g_k] = int(_goals_by_kind.get(g_k, 0)) + 1








			_goal_shots.append({"kind": _chance_kind, "dist_m": _shot_dist_m,
				"gesto": _remate_gesto,
				"olimpico": _olympic_live and _rebound_i < 0,
				"panenka": _chance_kind == "penal" and _cross_mode,
				"bajo_muro": _chance_kind == "libre" and _bajo_muro,
				"min": match_minute, "rival": _rival_key(), "t": _shot_path.duplicate()})
			if match_minute >= LATE_GOAL_MIN:
				_late_goals += 1
				_late_marcas.append(team_goals)



			if _playa_gol:
				Achievements.ingest_beach_goal()
		_sync_score()
	_resolve_chance(_outcome)






const RESOLVE_REACT_R: float = 6.0














func _pose_at_resolve(actor) -> void:
	if not is_instance_valid(actor):
		return





	if _serve_vivo and (_serve_mov.has(actor) or actor == _servicio_server()):
		return
	if actor == _last_toucher and not _rival_actors.has(actor):


		_face(actor, - Vector3(actor.position.x, 0.0, actor.position.z))
	elif actor == _last_toucher:





		_face_ball(actor)
	elif _flat_dist(actor.position, _ball.position) <= RESOLVE_REACT_R:
		_face_ball(actor)
	elif actor.animation != "idle":
		actor.play("idle")


























const PEDALEO_QUIETO_S: float = 0.2


func _desenlace_quieto(delta: float, moving: Dictionary) -> void:
	for actor in _todos_actores():
		if not is_instance_valid(actor) or not actor.visible:
			continue
		if moving.has(actor):
			actor.set_meta("quieto_t", 0.0)
			continue
		var anim: String = String(actor.animation)
		if not (anim.begins_with("walk_") or anim.begins_with("run_")):
			continue
		var t: float = float(actor.get_meta("quieto_t", 0.0)) + delta
		actor.set_meta("quieto_t", t)
		if t >= PEDALEO_QUIETO_S and _at_rest(actor, moving):
			actor.set_meta("quieto_t", 0.0)
			_pose_at_resolve(actor)











const OWN_LOSS: Array[String] = ["dribble_lost", "dribble_out", "keeper_out",
	"missball", "press_out_caged", "gol_regalado"]














func _balon_tuyo() -> bool:
	if not _handoff_live:
		return true
	return _self_actor == _handoff_you




func _prepara_cambios() -> void:
	_sub_listo = true
	if _practice_kind != "" or _tutorial_active or GameState.readonly_save:
		return
	for par in _equipos_que_rotan():
		var team_id: String = String(par[0])
		if team_id.is_empty():
			continue

		var ob: Array = _once_y_banca(team_id)
		if not ob.is_empty():
			var inicial: Dictionary = {}
			for s in ob[0]:
				inicial[int(s)] = true
			_once_inicial[team_id] = inicial
		var plan: Array = _plan_de(team_id, bool(par[1]))
		if not plan.is_empty():
			_sub_plan[team_id] = plan


		if _sin_libro(team_id):
			var ventanas: Array = Cambios.ventanas_tacticas(plan.size())
			if not ventanas.is_empty():
				_sub_tactico[team_id] = ventanas








func _equipos_que_rotan() -> Array:
	return [[_my_side_id(), true],
		[String(GameState.current_rival().get("id", "")), false]]






func _sin_libro(team_id: String) -> bool:
	return not team_id.is_empty() and team_id != GameState.player_team_id










func _ctx_sin_libro(team_id: String) -> Dictionary:
	if _sub_ctx.has(team_id):
		return _sub_ctx[team_id]
	var nat: bool = _nat_match()
	var c: Array = [1, 1, 0] if nat else Career.carga_liga(team_id)
	var semilla: int = int(c[2])
	if semilla == 0:
		semilla = GameState.season_num * 1000 + GameState.season_day
	var liga: bool = String(GameState.current_fixture().get("comp", "")) == "league"
	var ctx: Dictionary = {
		"team_id": team_id,
		"carga_hoy": maxi(int(c[0]), 1),
		"carga_prev": maxi(int(c[1]), 1),
		"semilla": semilla,
		"fuera": Career.bajas_asientos(team_id) if liga and not nat else {},
	}
	_sub_ctx[team_id] = ctx
	return ctx





func _huecos_de(team_id: String, once: Array) -> Dictionary:
	return Cambios.huecos_de(once, Squad.formation_slots(team_id).slice(0, Squad.STARTING_XI))






func _once_y_banca(team_id: String) -> Array:
	var efectivo: Array = Squad.of(team_id)
	if efectivo.size() <= Squad.STARTING_XI:
		return []
	var once: Array = []
	var banca: Array = []
	for k in efectivo.size():
		var seat: int = int((efectivo[k] as Dictionary).get(Squad.SEAT_KEY, k))
		if k < Squad.STARTING_XI:
			once.append(seat)
		elif banca.size() < SUB_BANCA:
			banca.append(seat)
	return [once, banca]










func _veta_de(team_id: String, mio: bool) -> Dictionary:
	var veta: Dictionary = {}
	if not mio:
		return veta
	var efectivo: Array = Squad.of(team_id)
	var u: int = Squad.user_index(efectivo)
	if u >= 0:
		veta[int((efectivo[u] as Dictionary).get(Squad.SEAT_KEY, u))] = true
	var sombra: int = Squad.user_index_en(Squad.of_nominal(team_id), Squad.USER_POS, false)
	if sombra >= 0:
		veta[sombra] = true
	return veta









func _plan_de(team_id: String, mio: bool) -> Array:
	var nominal: Array = Squad.of_nominal(team_id)
	if nominal.is_empty():
		return []
	var ob: Array = _once_y_banca(team_id)
	if ob.is_empty():
		return []
	var veta: Dictionary = _veta_de(team_id, mio)






	if _sin_libro(team_id):
		return Cambios.plan_sin_libro(nominal, [], ob[0], ob[1], veta,
			_ctx_sin_libro(team_id), _huecos_de(team_id, ob[0]))
	var meta: Array = Career.squad_meta_of(team_id)
	if meta.size() != nominal.size():
		return []
	var huecos: Dictionary = _huecos_de(team_id, ob[0])
	var plan: Array = Cambios.plan(nominal, meta, ob[0], ob[1], _factor_cambios(team_id),
		veta, Cambios.ENERGIA_MIN_DEFECTO, huecos)
	if not plan.is_empty():
		return plan




	return Cambios.plan_por_nivel(nominal, meta, ob[0], ob[1], veta,
		Cambios.ENERGIA_MIN_DEFECTO, huecos)


















const SUB_BANCA: int = 7
func _factor_cambios(team_id: String) -> float:
	if not team_id.is_empty() and team_id == GameState.player_team_id:
		return Career.factor_de_hoy()
	return 1.0









var _cambios_club: Array = []


func _apunta_cambio_club(team_id: String, sale: int, entra: int, minuto: int) -> void:
	if team_id.is_empty() or team_id != GameState.player_team_id or sale < 0:
		return
	_cambios_club.append({"sale": sale, "entra": entra, "minuto": minuto})




func _asiento_de_nombre(team_id: String, nombre: String) -> int:
	if nombre.is_empty():
		return -1
	var efectivo: Array = Squad.of(team_id)
	for k in mini(Squad.STARTING_XI, efectivo.size()):
		var row: Dictionary = efectivo[k]
		if String(row.get("name", "")) == nombre:
			return int(row.get(Squad.SEAT_KEY, k))
	return -1




func _aplica_cambios(minuto: int) -> void:
	if not _sub_listo:
		_prepara_cambios()
	for team_id in _sub_plan.keys():
		var pend: Array = _sub_plan[team_id]
		while not pend.is_empty() and int((pend[0] as Dictionary).get("minuto", 99)) <= minuto:
			var c: Dictionary = pend.pop_front()
			if not _haz_cambio(String(team_id), c, minuto) and _sin_libro(String(team_id)):




				var vs: Array = _sub_tactico.get(team_id, [])
				vs.append(int(c.get("minuto", minuto)))
				vs.sort()
				_sub_tactico[team_id] = vs


	for team_id in _sub_tactico.keys():
		var vs: Array = _sub_tactico[team_id]
		while not vs.is_empty() and int(vs[0]) <= minuto:
			_haz_tactico(String(team_id), int(vs.pop_front()), minuto)












func quedan_cambios(team_id: String) -> bool:
	return int(_subs_hechos.get(team_id, 0)) < Cambios.CUPO





func gasta_cambio(team_id: String) -> void:
	_subs_hechos[team_id] = int(_subs_hechos.get(team_id, 0)) + 1
	if team_id == _my_side_id() and _sim_screen != null \
			and is_instance_valid(_sim_screen) and not quedan_cambios(team_id):

		_sim_screen.set_sub_agotado(true)



func _anota_salida(team_id: String, nombre: String) -> void:
	if nombre.is_empty():
		return
	if not _salieron.has(team_id):
		_salieron[team_id] = {}
	(_salieron[team_id] as Dictionary)[nombre] = true






func _haz_tactico(team_id: String, ventana: int, minuto: int) -> void:
	if not quedan_cambios(team_id):
		return
	var nominal: Array = Squad.of_nominal(team_id)
	var ob: Array = _once_y_banca(team_id)
	if nominal.is_empty() or ob.is_empty():
		return
	var mio: bool = team_id == _my_side_id()
	var diff: int =(team_goals - rival_goals) if mio else (rival_goals - team_goals)
	var vivo: Dictionary = _vivo_sin_libro(team_id, nominal, ob)
	for c in Cambios.tacticos(nominal, [], ob[0], ob[1], _veta_de(team_id, mio),
			_ctx_sin_libro(team_id), diff, ventana, vivo["amonestados"], vivo["cerrados"],
			_huecos_de(team_id, ob[0])):
		if _haz_cambio(team_id, c as Dictionary, minuto):
			return








func _vivo_sin_libro(team_id: String, nominal: Array, ob: Array) -> Dictionary:
	var mio: bool = team_id == _my_side_id()
	var lado: String = "you" if mio else "rival"
	var rojas: Array = _expulsados_mios if mio else _expulsados_rival
	var salieron: Dictionary = _salieron.get(team_id, {})
	var inicial: Dictionary = _once_inicial.get(team_id, {})
	var amonestados: Dictionary = {}
	var cerrados: Dictionary = {}
	for s in ob[0]:
		var i: int = int(s)
		if i < 0 or i >= nominal.size():
			continue
		var nom: String = String((nominal[i] as Dictionary).get("name", ""))
		if nom in rojas:
			cerrados[i] = true
		elif not inicial.is_empty() and not inicial.has(i):
			cerrados[i] = true
		elif int(MatchSim._booked.get(lado + "" + nom, 0)) >= 1 or _ref_booked.has(nom):
			amonestados[i] = true
	for s in ob[1]:
		var j: int = int(s)
		if j >= 0 and j < nominal.size() \
				and salieron.has(String((nominal[j] as Dictionary).get("name", ""))):
			cerrados[j] = true
	return {"amonestados": amonestados, "cerrados": cerrados}






func _haz_cambio(team_id: String, c: Dictionary, minuto: int) -> bool:
	if not quedan_cambios(team_id):
		return false
	var nominal: Array = Squad.of_nominal(team_id)
	var sale: int = int(c.get("sale", -1))
	var entra: int = int(c.get("entra", -1))
	if sale < 0 or entra < 0 or sale >= nominal.size() or entra >= nominal.size():
		return false
	var q_sale: Dictionary = nominal[sale]
	var q_entra: Dictionary = nominal[entra]




	var rojas: Array = _expulsados_mios if team_id == _my_side_id() else _expulsados_rival
	if String(q_sale.get("name", "")) in rojas:
		return false


	if (_salieron.get(team_id, {}) as Dictionary).has(String(q_entra.get("name", ""))):
		return false


	var orden: Array = Squad.orden_con_cambio(Squad.of(team_id), sale, entra)
	if orden.is_empty():
		return false
	Squad.set_match_lineup(team_id, orden)
	gasta_cambio(team_id)
	_anota_salida(team_id, String(q_sale.get("name", "")))
	_apunta_cambio_club(team_id, sale, entra, minuto)
	var mio: bool = team_id == _my_side_id()
	var lado: String = "you" if mio else "rival"
	if _sim_screen != null and is_instance_valid(_sim_screen):
		_sim_screen.add_line(minuto, I18n.tf("SE VA {0}", [String(q_sale.get("name", "?"))]),
			"sub_out", int(q_sale.get("number", 0)), lado, String(q_sale.get("name", "")))
		_sim_screen.add_line(minuto, I18n.tf("ENTRA {0}", [String(q_entra.get("name", "?"))]),
			"sub_in", int(q_entra.get("number", 0)), lado, String(q_entra.get("name", "")))
	return true


















func _cuenta_accion_npc(de_rival: bool, nombre: String, accion: String) -> void:
	if _shootout_active or _tutorial_active or not _practice_kind.is_empty():
		return
	if _sim_screen != null and is_instance_valid(_sim_screen):
		_sim_screen.apunta_accion(de_rival, nombre, accion)





const REMATES_NPC: Array[String] = ["wide", "over", "save", "post", "blocked", "cleared"]
















func _cuenta_npc_de_tu_jugada(outcome: String, mi_pase: bool, vuelve_a_mi: bool) -> void:
	var ced_ajeno: bool = _corner_ced_live and not _cedida_tuya
	var remato_mate: bool = _mate_kicker != null and is_instance_valid(_mate_kicker) \
			and not _is_you(_mate_kicker)


	var remate: String = outcome


	if _autogol_rival(outcome):
		remate = "blocked"
	if outcome == "offside" and not _offside_remate_previo.is_empty():
		remate = _offside_remate_previo
	if (mi_pase or _rebound_mate or ced_ajeno) and not vuelve_a_mi and remato_mate \
			and REMATES_NPC.has(remate):
		_cuenta_accion_npc(false, String(_finisher_of(_mate_kicker).get("name", "")),
			remate)
	if not _pase_mate.is_empty():
		_cuenta_accion_npc(false, _pase_mate, "pass")
		_pase_mate = ""
	if _corner_ced_live and (_cedida_tuya or remato_mate):
		_cuenta_accion_npc(false, _falta_taker, "pass")


func _cuenta_parada(de_rival: bool) -> void:
	var club: String = String(GameState.current_rival().get("id", "")) if de_rival \
			else _my_side_id()
	var gk: Dictionary = Squad.keeper(club)
	var nom: String = String(gk.get("name", ""))
