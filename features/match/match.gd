func _practica_kit_rival() -> Dictionary:
	var mio: Color = GameState.player_kit().get("kit", Color.WHITE)
	var rival: Dictionary = GameState.current_rival()
	var mejor: Dictionary = GameState.kit_variant(rival, GameState.kit_slot_lejano(rival, mio))
	var mejor_d: float = _kit_dist(mio, mejor.get("kit", mio))
	if mejor_d >= PRACTICA_KIT_DIST:
		return mejor
	var peto: Color = PRACTICA_PETOS[0]
	for c in PRACTICA_PETOS:
		if _kit_dist(mio, c) > _kit_dist(mio, peto):
			peto = c
	var out: Dictionary = mejor.duplicate()
	out["kit"] = peto
	out["kit2"] = peto.darkened(0.35)
	out["pattern"] = "solid"
	return out



static func _kit_dist(a: Color, b: Color) -> float:
	return absf(a.r - b.r) + absf(a.g - b.g) + absf(a.b - b.b)





