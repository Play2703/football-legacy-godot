func _dianas_atrapa() -> void:
	_dianas_pts_balon = 0
	_dianas_diana_balon = -1
	_dianas_poste_balon = false


	if _practice_kind == Practice.BLANCOS:
		_blancos_atrapa()
		return
	if _practice_kind != Practice.DIANAS or _traj.size() < 2:
		return



	var paso: float = SIM_DT
	var mejor_i: int = -1
	var mejor_pts: int = 0
	var mejor_g: int = -1
	var mejor_poste: bool = false









	for i in range(1, _traj.size()):
		var a: Vector3 = _traj[i - 1]
		var b: Vector3 = _traj[i]
		if b.z >= a.z:
			continue
		var t_cruce: float = _dianas_anim + float(i) * paso
		for g in _dianas_sitio.size():
			var d: Dictionary = _dianas_sitio[g]
			var pz: float = float(d["z"])
			if a.z <= pz or b.z > pz:
				continue
			var f: float =(a.z - pz) / maxf(0.0001, a.z - b.z)
			var p: Vector3 = a.lerp(b, clampf(f, 0.0, 1.0))
			var gx: float = _diana_x_en(g, t_cruce)
			var dx: float = absf(p.x - gx)
			var alto: float = p.y + BALL_R











			if dx > DIANA_HALF_W or alto > DIANA_H:
				var largo: float =(b - a).length()
				if largo > DIANA_FINURA:
					var n: int = mini(int(largo / DIANA_FINURA) + 1, 12)
					for k in range(1, n):
						var q: Vector3 = a.lerp(b, float(k) / float(n))
						var qx: float = absf(q.x - _diana_x_en(g,
							_dianas_anim +(float(i - 1) + float(k) / float(n)) * paso))
						if qx <= DIANA_HALF_W and q.y + BALL_R <= DIANA_H \
								and q.z <= pz + DIANA_FONDO and q.z >= pz - DIANA_FONDO:
							dx = qx
							alto = q.y + BALL_R
							break

			if dx <= DIANA_HALF_W and alto <= DIANA_H:
				if mejor_i < 0 or i < mejor_i:
					mejor_i = i
					mejor_pts = int(d["pts"])
					mejor_g = g
					mejor_poste = false
				continue

			var en_palo: bool = dx <= DIANA_HALF_W + DIANA_POSTE_R + BALL_R \
					and alto <= DIANA_H + DIANA_POSTE_R + BALL_R
			if en_palo and (mejor_i < 0 or i < mejor_i):
				mejor_i = i
				mejor_pts = 0
				mejor_g = g
				mejor_poste = true
	if mejor_i < 0:




		if _outcome == "goal":
			_outcome = "wide"
		return
	_dianas_pts_balon = mejor_pts
	_dianas_diana_balon = mejor_g
	_dianas_poste_balon = mejor_poste



	var fin: int = mejor_i
	var recorrido: float = 0.0
	while fin + 1 < _traj.size() and recorrido < DIANA_FONDO:
		recorrido +=(_traj[fin + 1] - _traj[fin]).length()
		fin += 1
	_traj.resize(fin + 1)
	_stop_i = fin
	_verdict_i = fin
	_cross_i = -1



