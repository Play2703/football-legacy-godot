func _maybe_hook() -> void:







	if _hooked or _injured_out or not _practice_kind.is_empty() or _shootout_active \
			or _extra_time or GameState.readonly_save:
		return

	if not quedan_cambios(_my_side_id()):
		return






	if not _starter:
		return


	var need: int = HOOK_WASTED
	if int(Career.rel["tecnico"]) >= HOOK_TRUST_SHIELD:
		need += 1
	if _wasted_run < need:
		return




	if _live_rating() > Career.HOOK_RATING_FLOOR:
		return



	var out_min: int = maxi(mini(match_minute + HOOK_DELAY_MIN, 89), HOOK_HALFTIME_MIN)


	if _play_to - out_min < HOOK_MIN_REMAINING:
		return






	var played: int = chance_index
	for i in _chance_minutes.size():
		if _chance_minutes[i] < out_min:
			played = maxi(played, i + 1)
	_hooked = true
	gasta_cambio(_my_side_id())




	if is_instance_valid(_hud) and not _tutorial_active \
			and _practice_kind.is_empty() and not GameState.readonly_save:
		_hud.maybe_show_rule("cambio")
	_pull_off_at(out_min, played)


	Career.pending_hook = true



	Career.pending_hook_min = out_min
	Career.pending_hook_wasted = _wasted_run
	Career.pending_hook_reason = "waste"
	Career.pending_hook_shown = false

















func _maybe_rest() -> void:




	if _rested or _hooked or _sub_requested or _sub_done or _injured_out \
			or not _practice_kind.is_empty() or _shootout_active \
			or _extra_time or GameState.readonly_save:
		return
	if not quedan_cambios(_my_side_id()):
		return









	if not _starter:
		return
	if state != State.SIM and state != State.RESOLVED:
		return
	if match_minute < Career.SUB_REST_FROM_MIN or match_minute < _play_from:
		return
	var out_min: int = mini(match_minute + HOOK_DELAY_MIN, 89)


	var left: int = _play_to - out_min
	if left < 2 or left > Career.SUB_REST_MAX_LEFT:
		return



	if float(_sub_request_reading().get("justif", 0.0)) < Career.SUB_REST_JUSTIF:
		return



	if _live_rating() < Career.HOOK_RATING_FLOOR:
		return
	_rested = true
	gasta_cambio(_my_side_id())
	_sub_done = true
	_sub_excused = true
	_sub_welcome = true
	Career.pending_sub_welcome = true
	_pull_off_at(out_min)
	_sim_screen.add_line(match_minute,
		I18n.t("EL BANQUILLO PREPARA TU CAMBIO: EL PARTIDO ESTÁ HECHO"), "you")

	_sim_screen.mark_sub_pending()





















func _hook_for_own_bench() -> bool:







	if _hooked or _injured_out or _sub_done or _rested \
			or not _practice_kind.is_empty() or _shootout_active \
			or _extra_time or GameState.readonly_save:
		return false
	var out_min: int = mini(match_minute + HOOK_DELAY_MIN, 89)


	if _play_to - out_min < HOOK_MIN_REMAINING:
		return false
	_hooked = true
	gasta_cambio(_my_side_id())
	_hook_reason = "banquillo"
	_pull_off_at(out_min)
	Career.pending_hook = true
	Career.pending_hook_min = out_min
	Career.pending_hook_wasted = 0
	Career.pending_hook_reason = "banquillo"
	Career.pending_hook_shown = false
	return true















func _pull_off_at(out_min: int, played: int = -1) -> void:
	if played < 0:
		played = chance_index






	if (_sub_requested or _rested) and not _hooked:
		_sub_saved_min = maxi(_play_to - out_min, 0)
	_play_to = out_min
	_sub_out_min = out_min
	_my_minutes = maxi(out_min - _play_from, 1)
	_chance_minutes.resize(clampi(played, 0, _chance_minutes.size()))
	_chances_this_match = maxi(played, 1)
	_base_chances = _chances_this_match
	_chance_hi = mini(_chance_hi, out_min)





func _sub_today_is_ko() -> bool:
	if _sub_today_ko < 0:
		_sub_today_ko = 1 if GameState.fixture_is_knockout(GameState.current_fixture()) else 0
	return _sub_today_ko == 1



func _sub_next_is_ko() -> bool:
	if _sub_next_ko < 0:
		_sub_next_ko = 1 if GameState.fixture_is_knockout(GameState.next_fixture()) else 0
	return _sub_next_ko == 1























func _sub_request_reading() -> Dictionary:
	var out_min: int = mini(match_minute + HOOK_DELAY_MIN, 89)
	if _play_to - out_min < 2:
		return {"pts": 0.0, "justif": 1.0, "tone": Career.SUB_TONE_OK,
			"note": I18n.t("YA NO DA TIEMPO: IBAS A SALIR IGUAL"), "too_late": true}







	var window: float = maxf(float(_play_to - _play_from), 1.0)
	var left: float = clampf(float(_play_to - out_min) / window, 0.0, 1.0)
	var fresh: float = clampf(
		(Career.energy - Career.SUB_REQUEST_JUSTIFIED_ENERGY)
		/ maxf(100.0 - Career.SUB_REQUEST_JUSTIFIED_ENERGY, 1.0), 0.0, 1.0)
	var pts: float =(Career.REL_SUB_REQUEST_MIN
		+(Career.REL_SUB_REQUEST_MAX - Career.REL_SUB_REQUEST_MIN) * left) * fresh






	var clock: float = clampf((float(match_minute) - Career.SUB_SETTLED_FROM_MIN)
		/ maxf(Career.SUB_SETTLED_FULL_MIN - Career.SUB_SETTLED_FROM_MIN, 1.0), 0.0, 1.0)
	var need: float = Career.SUB_SETTLED_NEED_HI \
			-(Career.SUB_SETTLED_NEED_HI - Career.SUB_SETTLED_NEED_LO) \
			* clampf((float(match_minute) - Career.SUB_SETTLED_FROM_MIN) / 40.0, 0.0, 1.0)
	var diff: float = float(team_goals - rival_goals)



	var settled: float = clampf((diff - need + 2.0) / 2.0, 0.0, 1.0) * clock
	if _sub_today_is_ko():


		settled *= Career.SUB_SETTLED_KO_MULT







	var body: float = Career.live_injury_exposure()
	var justif: float = clampf(settled
		+(Career.SUB_JUSTIF_NEXT_BIG * clock if _sub_next_is_ko() else 0.0)
		+ Career.SUB_JUSTIF_BODY * body, 0.0, 1.0)



	var tight: float = clock * clampf((1.0 - diff) / 2.0, 0.0, 1.0)
	pts = pts *(1.0 - justif) *(1.0 + Career.SUB_CLUTCH_GAIN * tight)


	if _sub_refused:
		pts *= Career.SUB_INSIST_MULT




	var tone: int = Career.SUB_TONE_SNUB
	var note: String = ""




	var refuses: bool = false
	if pts <= 0.01:
		if justif >= Career.SUB_WELCOME_JUSTIF:
			tone = Career.SUB_TONE_WELCOME
			note = I18n.t("EL PARTIDO ESTÁ HECHO: TE LO VAN A AGRADECER")
		else:
			tone = Career.SUB_TONE_OK


			note = I18n.t("VAS AL LÍMITE: MEJOR NO FORZAR") if body >= 0.6 \
					else I18n.t("NO TE QUEDA NADA: EL MÍSTER LO ENTIENDE")
	elif _sub_refused:
		note = I18n.t("YA TE DIJO QUE NO: INSISTIR SALE CARO")
	elif diff <= 0.0 and match_minute >= Career.SUB_REFUSE_FROM_MIN:
		refuses = true
		note = I18n.t("EL PARTIDO ESTÁ EN JUEGO: TE VA A DECIR QUE AGUANTES")
	else:
		note = I18n.t("QUEDA PARTIDO Y TE QUEDAN PIERNAS: ES UN DESPLANTE")
	return {"pts": pts, "justif": justif, "tone": tone, "note": note,
		"too_late": false, "refuses": refuses}









func _on_sim_sub_requested() -> void:





	if _sub_requested or _hooked or _injured_out or not _practice_kind.is_empty() \
			or _shootout_active or _extra_time or GameState.readonly_save:
		return


	if not quedan_cambios(_my_side_id()):
		if _sim_screen != null and is_instance_valid(_sim_screen):
			_sim_screen.set_sub_agotado(true)
		_hud.show_message(I18n.t("YA NO QUEDAN CAMBIOS"), UiKit.DANGER, 0.0)
		return



	if state != State.SIM or match_minute < _play_from:
		return






	if match_minute < _sub_hold_until:
		return
	var read: Dictionary = _sub_request_reading()






	if bool(read.get("too_late", false)):
		_sim_screen.add_line(match_minute,
			I18n.t("EL BANQUILLO TE DICE QUE AGUANTES: YA NO DA TIEMPO"), "you")
		return





	if bool(read.get("refuses", false)):
		_sub_refused = true
		_sub_hold_until = match_minute + Career.SUB_HOLD_MIN
		_sim_screen.add_line(match_minute,
			I18n.t("EL MÍSTER TE DICE QUE AGUANTES: TE NECESITA AHÍ"), "you")





		_sim_screen.set_sub_hold(true)
		return
	_sub_requested = true
	_sub_ask_min = match_minute
	var tone: int = int(read.get("tone", Career.SUB_TONE_SNUB))
	var pts: float = float(read.get("pts", 0.0))
	Career.pending_sub_request_pts = pts
	Career.pending_sub_request = pts > 0.0



	_sub_welcome = tone == Career.SUB_TONE_WELCOME
	Career.pending_sub_welcome = _sub_welcome



	_sub_excused = not Career.pending_sub_request





	var ack: String = "{0} PIDE EL CAMBIO AL BANQUILLO"
	if tone == Career.SUB_TONE_WELCOME:
		ack = "{0} PIDE EL CAMBIO Y EL BANQUILLO ASIENTE"
	_sim_screen.add_line(match_minute,
		I18n.tf(ack, [CareerTheme.caps(Career.player_name)]), "you")






	_sim_screen.mark_sub_pending()








func _consummate_sub_request(drop_current: bool = false) -> void:
