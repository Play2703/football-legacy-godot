const TREN_FILA_M: float = 3.0

static func _tren_aplauden(anchor: Vector3, rumbo: Vector2, n: int, resto: Array) -> Dictionary:
	var lejos: Vector2 = Vector2(rumbo.y, - rumbo.x)
	if lejos.y > 0.0:
		lejos = - lejos
	var medio: Vector3 = _tren_medio(anchor, rumbo, n)
	var base: Vector2 = Vector2(medio.x, medio.z) + lejos * TREN_FILA_M
	var out: Dictionary = {}
	for j in resto.size():
		out[resto[j]] = _formacion_en_campo(
			base + rumbo *((float(j) - float(resto.size() - 1) * 0.5) * 1.4), anchor.y)
	return out






