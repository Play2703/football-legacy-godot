func _recep_ver_tu(pies: Vector2) -> Array[Vector3]:
	var h3: Vector3 = Vector3(_recep_hacia.x, 0.0, _recep_hacia.y)
	var der: Vector3 =(- h3).cross(Vector3.UP).normalized() * 0.6
	var p: Vector3 = Vector3(pies.x, 0.0, pies.y)
