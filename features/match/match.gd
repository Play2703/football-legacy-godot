const PAD_DER: int = 7



const PAD_ZM: float = 0.2
const PAD_SUELTA_ZM: float = 0.15
const PAD_GRACIA_MS: int = 150
const PAD_PICO_MS: int = 120

var _pad_izq_suelto_ms: int = -1
var _pad_izq_espera_neutro: bool = false
var _pad_golpeo_previo: bool = false
var _pad_der_tenia: bool = false
