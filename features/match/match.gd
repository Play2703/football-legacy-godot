static func _al_blanco(dir: Vector3, ancla: Vector3, sale: Vector3) -> Vector3:
	if dir.z > -0.1 or ancla.z <= 0.0:
		return dir
	var t: float = - ancla.z / dir.z
	var nuevo := Vector3(ancla.x + dir.x * t - sale.x, 0.0, - sale.z)
	if nuevo.z > -0.1:
		return dir
	return nuevo.normalized()









static func _destiempo_desvio(dir: Vector3, vb: Vector3, tarde: bool) -> Dictionary:
	var vh := Vector3(vb.x, 0.0, vb.z)
	var lado: Vector3 = vh - dir * vh.dot(dir)
	var reparto := Vector2(lado.length(), vb.y)
	if reparto.length() < SERVICIO_DESTIEMPO_VMIN:
		reparto = Vector2(0.0, -1.0)
	reparto = reparto.normalized()
	var ang: float = deg_to_rad(SERVICIO_DESTIEMPO_DEG) *(1.0 if tarde else -1.0)
	var out: Vector3 = dir
	if lado.length() > 0.0001:
		var q: float = ang * reparto.x
		out =(dir * cos(q) + lado.normalized() * sin(q)).normalized()
	return {"dir": out, "elev": ang * reparto.y}















