func _pinta_pie(anim: String, dx: float, dive_x: float, bola: Vector2) -> String:
	if bola.y > SAVE_PIE_Y:
		return ""
	var cual: String = ""
	if anim == "dive" and absf(dx) <= SAVE_PIE_VIAJE:
		if absf(dx) < SAVE_PIE_SPAGAT:
			cual = "pie_raso"
		elif signf(bola.x -(dive_x - dx)) == signf(dx):
			cual = "pie_lateral"
	elif anim == "catch" and _outcome != "save":

		cual = "pie_raso"
	if cual.is_empty():
		return ""
	var toca: bool = absf(bola.x - dive_x) <= float(SAVE_PIE_ALCANCE[cual]) + BALL_R
	return cual if toca ==(_outcome == "save") else ""




