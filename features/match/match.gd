const APRETON_CAM_DIST: float = 7.8
const APRETON_CAM_Y: float = 1.3
const APRETON_CAM_AIM: float = 1.05
const APRETON_CAM_FOV: float = 40.0
const APRETON_LAYER: int = 45
const APRETON_TRAGA_S: float = 0.4
var _apreton_mano: int = 0


var _apreton_guion: Array = []

var _apreton_dt_fijo: float = 0.0






func _apreton_procede() -> bool:
	if not _coach_cuts_on or _stadium == null or not is_instance_valid(_stadium) \
			or _practice_kind != "" or _shootout_active or state != State.SIM:
		return false
	var fx: Dictionary = GameState.current_fixture()
	var opp: String = String(fx.get("opp", ""))
	if not Apreton.procede(GameState.player_team_id, opp, String(fx.get("comp", ""))):
		return false
	return Apreton.sale(Apreton.semilla_de(GameState.season_num, GameState.season_day, opp))




func _play_apreton(resultado_forzado: int = -2) -> void:
	if _stadium == null or not is_instance_valid(_stadium):
		return
	var fx: Dictionary = GameState.current_fixture()
	var opp: String = String(fx.get("opp", ""))
	var comp: String = String(fx.get("comp", ""))
	var nos: int = team_goals
	var ellos: int = rival_goals
	if not GameState.readonly_save:
		var ida: Array = GameState.your_first_leg(fx)
		if ida.size() == 2:
			nos += int(ida[0])
			ellos += int(ida[1])
	var resultado: int = signi(nos - ellos) if resultado_forzado == -2 else resultado_forzado
	var nivel: int = Apreton.nivel_rival(opp, comp)
	var semilla: int = Apreton.semilla_de(GameState.season_num, GameState.season_day, opp)


	var ex: bool = comp != "nat" and not Career.ex_tecnico_en(opp).is_empty()
	var rival: Dictionary = Apreton.rival_de(nivel, resultado, semilla, ex)
	var caracter: String = "neutral" if comp == "nat" else Career.coach_char


	var ocultos: Array = []
	if is_instance_valid(_actors):
		for hijo in _actors.get_children():
			if hijo is Node3D and (hijo as Node3D).visible:
				(hijo as Node3D).visible = false
				ocultos.append(hijo)
	var balon_estaba: bool = is_instance_valid(_ball) and _ball.visible
	if balon_estaba:
		_ball.visible = false


	var anchor: Vector3 = _stadium.coach_handshake(_home_match)

	_stadium.coach_placas(true)
	var prev_cam: Camera3D = SceneFade.camara_de(self)
	var cam: Camera3D = Camera3D.new()
	cam.fov = APRETON_CAM_FOV
	add_child(cam)
	cam.current = true
	var base: Vector3 = Vector3(anchor.x + APRETON_CAM_DIST, APRETON_CAM_Y, anchor.z)
	cam.position = base
	cam.look_at(Vector3(anchor.x, APRETON_CAM_AIM, anchor.z))
	_stadium.keep_view_clear(cam.global_position, PackedVector3Array(), cam)
	_sim_screen.veil(true)


	var capa: CanvasLayer = CanvasLayer.new()
	capa.layer = APRETON_LAYER
	add_child(capa)
	var barra: ApretonBarra = ApretonBarra.new()
	barra.set_colores(GameState.you_team(), Teams.by_id(opp))
	capa.add_child(barra)
	_sim_skip = false

	var t: float = 0.0
	while t < Apreton.DUR_PITIDO:
		if state != State.SIM or not is_inside_tree():
			break
		await get_tree().process_frame
		if not is_inside_tree():
			break
		if get_tree().paused:
			continue
		t += _apreton_delta()
		if is_instance_valid(_stadium):
			_stadium.coach_handshake_llegan(t / Apreton.DUR_PITIDO)





	var estado: Dictionary = Apreton.nuevo(rival)
	barra.t0_ms = Time.get_ticks_msec()
	barra.abierta = true
	var guion: Array = _apreton_guion.duplicate()
	var t_pulso: float = 0.0
	var espera: float = 0.0
	while not bool(estado["fin"]):
		if state != State.SIM or not is_inside_tree():
			break
		await get_tree().process_frame
		if not is_inside_tree():
			break
		if get_tree().paused:


			barra.t0_ms += int(get_process_delta_time() * 1000.0)
			continue
		var dt: float = _apreton_delta()
		var toques: Array = []
		if guion.is_empty():
			toques = barra.toques.duplicate()
			barra.toques.clear()
		elif not bool(estado["armado"]):


			espera += dt
			if float(guion[0]) <= espera:
				var g0: float = float(guion[0])
				for i in guion.size():
					guion[i] = float(guion[i]) - g0
				toques.append(guion.pop_front())
		else:
			while not guion.is_empty() and float(guion[0]) <= t_pulso + dt:
				toques.append(guion.pop_front())
		estado = Apreton.paso(estado, dt, toques)
		t_pulso = float(estado["t"])
		if not bool(estado["armado"]):
			barra.t0_ms = Time.get_ticks_msec()
		barra.pinta(estado)
		if is_instance_valid(_stadium):
			_stadium.coach_handshake_pose(float(estado["barra"]) / Apreton.BARRA_MAX,
				float(estado["tension"]), bool(estado["aviso"]), int(estado["tiron"]) >= 0,
				t_pulso)
	barra.abierta = false
	var ver: int = Apreton.veredicto(float(estado["barra"]))
	_apreton_mano = ver



	if bool(estado["fin"]):
		Achievements.ingest_apreton(ver == Apreton.GANAS)



	_hud.show_message(I18n.t(Apreton.rotulo(caracter, ver, ex)), CareerTheme.INK_LIGHT,
		Apreton.DUR_DESENLACE)
	t = 0.0
	while t < Apreton.DUR_DESENLACE + APRETON_TRAGA_S:
		if state != State.SIM or not is_inside_tree():
			break
		await get_tree().process_frame
		if not is_inside_tree():
			break
		if get_tree().paused:
			continue
		t += _apreton_delta()
		if is_instance_valid(_stadium):
			_stadium.coach_handshake_suelta(ver, t / Apreton.DUR_DESENLACE)
	if is_instance_valid(_stadium):


		_stadium.coach_placas(false)
		_stadium.coach_handshake_end()
	for hijo in ocultos:
		if is_instance_valid(hijo):
			(hijo as Node3D).visible = true
	if balon_estaba and is_instance_valid(_ball):
		_ball.visible = true
	if is_instance_valid(prev_cam) and prev_cam.is_inside_tree():
		prev_cam.current = true
	cam.queue_free()
	capa.queue_free()
	_sim_skip = false



func _apreton_delta() -> float:
	return _apreton_dt_fijo if _apreton_dt_fijo > 0.0 else get_process_delta_time()







func _play_sub_scene(you_out: bool = false) -> void:
	if _stadium == null or _practice_kind != "":
		return





	_stadium.hold_coaches(SUB_SCENE_DUR + 0.6, true)













	var banca: bool = _home_match






	if you_out and _hooked and not _injured_out and _coach_cuts_on:
		var r_dt: Dictionary = GestoMister.elegir(GestoMister.EV_TE_SACA, _coach_ctx())
		if not r_dt.is_empty():
			var g_secs: float = float(r_dt["secs"]) \
					+(SUB_REF_HOLD if _stadium.ref4_spot() != Vector3.ZERO else 0.0)
			_stadium.coach_gesture(banca, String(r_dt["gesto"]), g_secs,
				bool(r_dt["espaldas"]))
	var anchor: Vector3 = _stadium.coach_spot(banca)


	_stadium.coach_placa(banca, true)








	var you_from: Vector2 = SUB_OUT_FROM if you_out \
			else Vector2(SUB_YOU_DX, SUB_YOU_DZ)
	_sub_you = _spawn_actor(TEAM_TEX, anchor.x + you_from.x, anchor.z + you_from.y,
		PLAYER_METRICS, PLAYER_HEIGHT_M, true)






	_sub_play(_sub_you,
		("walk_south" if _injured_out else "run_south") if you_out else "idle",
		"idle")






	var mate: Dictionary = _sub_in_mate() if you_out else _sub_out_mate()
	var mate_from: Vector2 = Vector2(SUB_YOU_DX, SUB_YOU_DZ) if you_out \
			else SUB_OUT_FROM
	_sub_mate = _spawn_actor(TEAM_TEX, anchor.x + mate_from.x, anchor.z + mate_from.y,
		PLAYER_METRICS, PLAYER_HEIGHT_M,
		_look_for(String(mate.get("name", "")), GameState.player_look(), "",
			int(mate.get("number", 0))))


	_sub_play(_sub_mate, "idle_back" if you_out else "run_south", "idle")
	_sub_cam = Camera3D.new()
	_sub_cam.fov = 40.0
	add_child(_sub_cam)
	_sub_cam.current = true








	_stadium.keep_view_clear(_sub_cam.global_position, PackedVector3Array(), _sub_cam)










	var calor: float = float(Career.rel_eff("aficion")) / 100.0
	_stadium.crowd_excite(0.45)
	_sim_screen.veil(true)


	var mate_name: String = _sub_last_name(String(mate.get("name", "")))
	var mate_num: int = int(mate.get("number", 0))
	var you_name: String = _sub_last_name(Career.player_name)
	var you_num: int = GameState.player_number
	var out_name: String = you_name if you_out else mate_name
	var in_name: String = mate_name if you_out else you_name
	var out_num: int = you_num if you_out else mate_num
	var in_num: int = mate_num if you_out else you_num






















	_stadium.crowd_greet(calor, SUB_REF_HOLD + SUB_SCENE_DUR * 0.4)




	_audio.greet(calor, SUB_REF_HOLD + SUB_SCENE_DUR * 0.4)
	var ref_at: Vector3 = _stadium.ref4_spot()
	if ref_at != Vector3.ZERO:
		_stadium.show_sub_board(out_num, in_num)
		var face: Vector3 = _stadium.ref4_facing()


		_sub_cam.position = ref_at + face * SUB_REF_DIST + Vector3.UP * SUB_REF_Y
		_sub_cam.look_at(ref_at + Vector3.UP * SUB_REF_AIM)
		var rt: float = 0.0
		while rt < SUB_REF_HOLD:
			if _sim_skip or state != State.SIM:
				break
			await get_tree().process_frame
			rt += get_process_delta_time()







	var mate_look: Dictionary = _sub_mate.get_meta("anim_cfg", {}) \
			if _sub_mate != null else {}
	var you_look: Dictionary = GameState.player_look()
	var mate_nat: String = _mate_nation(mate)
	var you_nat: String = Career.nationality
	_hud.show_sub_swap(
		out_name, out_num, you_nat if you_out else mate_nat,
		you_look if you_out else mate_look,
		in_name, in_num, mate_nat if you_out else you_nat,
		mate_look if you_out else you_look,
		SUB_SCENE_DUR)



	var you_at: Vector3 = _sub_you.position
	var run_at: Vector3 = _sub_mate.position if you_out else _sub_you.position
	var t: float = 0.0
	while t < SUB_SCENE_DUR:


		if _sim_skip or state != State.SIM or not is_inside_tree():
			break
		await get_tree().process_frame
		t += get_process_delta_time()
		var k: float = clampf(t / SUB_SCENE_DUR, 0.0, 1.0)
		_tick_sub_actors(k, anchor, run_at, you_out)
		if _sub_cam != null and _sub_you != null:


			var push: float = SUB_CAM_PUSH *(1.0 - pow(1.0 - k, 3.0))



			var travel: Vector3 = _sub_you.position - you_at
			_sub_cam.position = Vector3(
				anchor.x + SUB_CAM_DX + push * 0.35 + travel.x * SUB_CAM_TRAIL * 0.35,
				SUB_CAM_Y,
				anchor.z + SUB_CAM_DZ - push + travel.z * SUB_CAM_TRAIL)



			var aim: Vector3 = you_at.lerp(_sub_you.position, SUB_CAM_LAG)






			if _sub_mate != null and not you_out and k < SUB_BEAT_OUT:
				var w: float = 1.0 - smoothstep(SUB_WATCH_HOLD, SUB_BEAT_OUT, k)
				aim = aim.lerp(_sub_mate.position, SUB_WATCH_MIX * w)


			_sub_cam.look_at(aim + Vector3.UP * PLAYER_HEIGHT_M * 0.5)











			_stadium.keep_view_clear(_sub_cam.global_position,
				PackedVector3Array(), _sub_cam)
	if _sub_cam != null:
		_sub_cam.queue_free()
		_sub_cam = null


	for actor in [_sub_you, _sub_mate]:
		if actor != null:
			actor.queue_free()
	_sub_you = null
	_sub_mate = null
	_hud.clear_sub_swap()
	_stadium.crowd_excite(0.0)



	if you_out:
		await _play_hook_act()
	if is_instance_valid(_stadium):
		_stadium.coach_placa(banca, false)


	_sim_screen.veil(false)









































func _esperar_acto(act: Ceremony, layer: CanvasLayer, tope: float = ACTO_TOPE_S) -> void:
	_acto_fin = false
	act.acto_terminado.connect(_on_acto_fin)







	_apagon.pide(&"acto", _stadium, get_viewport())
	var esperado: float = 0.0
	while not _acto_fin and esperado < tope:



		if not is_inside_tree():
			break
		await get_tree().process_frame






		if not is_inside_tree():
			break
		if not is_instance_valid(act):
			break

		_apagon.sigue(get_viewport())
		if not get_tree().paused:
			esperado += get_process_delta_time() / maxf(Engine.time_scale, 0.05)




	_apagon_suelta(&"acto")
	if not _acto_fin:
		push_warning("[partido] el acto empotrado no avisó en %.0f s: el partido sigue sin él"
			% tope)
	if is_instance_valid(act) and act.acto_terminado.is_connected(_on_acto_fin):
		act.acto_terminado.disconnect(_on_acto_fin)
	if is_instance_valid(layer):
		layer.queue_free()


func _on_acto_fin() -> void:
	_acto_fin = true







func _on_sim_tapa(tapa: bool) -> void:
	if tapa:
		_apagon.pide(&"tv", _stadium, get_viewport())
	else:
		_apagon_suelta(&"tv")













func _apagon_suelta(motivo: StringName) -> void:
	var estaba: bool = _apagon.activo
	_apagon.suelta(motivo)
	if not estaba or _apagon.activo or not is_inside_tree():
		return
	_calcomanias_follow()
	CaraEncima.sigue_todas(get_tree())


func _play_hook_act() -> void:


	if Career.pending_hook_shown or GameState.readonly_save \
			or not _practice_kind.is_empty():
		return










	if _injured_out:
		return















	var reason: String = ""
	var wasted: int = 0
	var out_min: int = 0
	if Career.pending_hook:
		reason = Career.pending_hook_reason
		wasted = maxi(Career.pending_hook_wasted, 3)
		out_min = Career.pending_hook_min
	elif _live_rating() < Career.HOOK_RATING_FLOOR \
			and not _rested and not _sub_welcome:
		reason = "nota"
		out_min = _play_to
	else:
		return
	var scn: PackedScene = load(HOOK_ACT_SCENE) as PackedScene
	if scn == null:
		return
	var act: Ceremony = scn.instantiate() as Ceremony
	if act == null:
		return






	act.embedded = true
	act.data_override = _payload_tunel(reason, wasted, out_min)
	Career.pending_hook_shown = true



	if _audio != null:
		_audio.hush()
	var layer: CanvasLayer = CanvasLayer.new()
	layer.layer = HOOK_ACT_LAYER
	layer.add_child(act)
	add_child(layer)
	await _esperar_acto(act, layer)
	if not is_inside_tree():
		return
	if _audio != null:
		_audio.unhush()









func _payload_tunel(reason: String, wasted: int, out_min: int) -> Dictionary:
	var nat: bool = _nat_match()
	return {
		"kind": Ceremonies.HOOKED,
		"div": GameState.player_div(),
		"comp": String(GameState.current_fixture().get("comp", "league")),
		"minute": out_min if out_min > 0 else match_minute,
		"wasted": wasted,
		"reason": reason,
		"rating": _live_rating(),
		"coach": int(Career.nat_rel["tecnico"]) if nat else int(Career.rel["tecnico"]),
		"rival": String(GameState.current_rival().get("name", "")),
		"club": _my_side_id(),
		"nation": _my_side_id() if nat else "",
	}







