func _fan_selfie_tex(fan: AnimatedSprite3D, lado: float) -> ImageTexture:
	if fan == null or not is_instance_valid(fan):
		return null
	var fx: float = fan.position.x
	var fz: float = fan.position.z









	var gesto: String = fan.animation
	var cuadro: int = fan.frame
	var pausado: bool = not fan.is_playing()
	_fan_add_sonrisa(fan)
	_sub_play(fan, "sonrisa", "idle")


	if fan.sprite_frames.has_animation("sonrisa") \
			and fan.sprite_frames.get_frame_count("sonrisa") > 1:
		fan.set_frame_and_progress(1, 1.0)
	var mi_gesto: String = ""
	var mi_cuadro: int = 0
	if is_instance_valid(_self_actor) and _self_add_sonrisa():
		mi_gesto = _self_actor.animation
		mi_cuadro = _self_actor.frame
		_self_actor.play("posa_sonrisa")
		if _self_actor.sprite_frames.get_frame_count("posa_sonrisa") > 1:
			_self_actor.set_frame_and_progress(1, 1.0)
	var sub: SubViewport = SubViewport.new()
	sub.size = Vector2i(SELFIE_W, SELFIE_H)
	sub.world_3d = get_viewport().world_3d
	sub.render_target_update_mode = SubViewport.UPDATE_ALWAYS




	sub.msaa_3d = Viewport.MSAA_DISABLED
	sub.screen_space_aa = Viewport.SCREEN_SPACE_AA_DISABLED
	sub.use_debanding = false
	sub.scaling_3d_mode = Viewport.SCALING_3D_MODE_BILINEAR
	sub.scaling_3d_scale = 1.0
	add_child(sub)
	var c: Camera3D = Camera3D.new()
	c.fov = SELFIE_FOV
	sub.add_child(c)


	c.position = Vector3(fx + lado * SELFIE_LADO, SELFIE_ALTO, fz + SELFIE_DELANTE)
	c.look_at(Vector3(fx - lado * SELFIE_MIRA_LADO, SELFIE_MIRA, fz - 0.25))
	c.rotation_degrees.z += SELFIE_LADEO
	c.current = true
	await RenderingServer.frame_post_draw


	var img: Image = null
	if is_instance_valid(sub):
		img = sub.get_texture().get_image()
		sub.queue_free()


	if is_instance_valid(fan) and fan.sprite_frames != null \
			and fan.sprite_frames.has_animation(gesto):
		fan.play(gesto)
		fan.set_frame_and_progress(cuadro, 1.0)
		if pausado:
			fan.pause()
	if not mi_gesto.is_empty() and is_instance_valid(_self_actor) \
			and _self_actor.sprite_frames.has_animation(mi_gesto):
		_self_actor.play(mi_gesto)
		_self_actor.set_frame_and_progress(mi_cuadro, 1.0)
	if img == null:
		return null
	return ImageTexture.create_from_image(img)












func _fan_photo_flash(tex: ImageTexture) -> void:
