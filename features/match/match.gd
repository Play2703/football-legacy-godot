func _pique_nombre(a: AnimatedSprite3D) -> String:
	if not is_instance_valid(a) or not a.has_meta("player"):
		return ""
	return String((a.get_meta("player", {}) as Dictionary).get("name", ""))



func _pique_cerca() -> String:
	var mejor: String = ""
	var dmin: float = PIQUE_CERCA_M
	for i in mini(_duel_defs.size(), _duel_def_actors.size()):
		var a: AnimatedSprite3D = SceneFade.vivo(_duel_def_actors[i]) as AnimatedSprite3D
		if not is_instance_valid(a) or not _rival_set.has(a):
			continue
		var quien: String = _pique_nombre(a)
		if quien.is_empty():
			continue
		var d: float = _duel_defs[i].distance_to(_duel_pos)
		if d < dmin:
			dmin = d
			mejor = quien
	return mejor





func _pique_calienta(quien: String) -> void:
	if quien.is_empty() or _pique_hecho or not _practice_kind.is_empty() \
			or _tutorial_active or _shootout_active or quien in _expulsados_rival:
		return
	var antes: bool = Pique.caliente(_pique_calor, quien, _is_derby)
	Pique.calienta(_pique_calor, quien)
	if antes or not Pique.caliente(_pique_calor, quien, _is_derby):
		return
	if _pique_fase.is_empty():
		_pique_fase = "calor"
		_pique_quien = quien
	_say("pique_calor", 0.6, {"picado": quien})



func _pique_es(a: AnimatedSprite3D) -> bool:
	return _pique_fase in ["encarado", "calma"] and not _pique_quien.is_empty() \
			and _pique_nombre(a) == _pique_quien



func _pique_dispara(thief: int) -> bool:
	if _pique_hecho or not _practice_kind.is_empty() or _tutorial_active \
			or _shootout_active or _duel_press or _eslalon:
		return false
	if thief < 0 or thief >= _duel_def_actors.size():
		return false
	var el: AnimatedSprite3D = SceneFade.vivo(_duel_def_actors[thief]) as AnimatedSprite3D
	if not is_instance_valid(el) or el == _self_actor or not _rival_set.has(el):
		return false
	var quien: String = _pique_nombre(el)


	if not Pique.caliente(_pique_calor, quien, _is_derby):
		return false
	var dado: float = _pique_dado_forzado if _pique_dado_forzado >= 0.0 else randf()
	if not Pique.dispara(int(_pique_calor.get(quien, 0)),
			Pique.sangre_caliente(_is_derby, _titular_crecido, _frase_viva), dado, _pique_hecho,
			Pique.umbral(_is_derby)):
		return false
	_pique_hecho = true
	_pique_patada_viva = true
	_pique_quien = quien
	return true





