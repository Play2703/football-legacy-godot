const CORNER_WANDER_R: float = 2.0
const CORNER_JOG: float = 1.7
const CORNER_MARK_JOG: float = 2.5

const CORNER_MARK_GAP: float = 1.5
const CORNER_PAIR_SEP: float = 1.25
const CORNER_MARK_ASSIGN_R: float = 7.0


















const CORNER_ZONA_R: float = 4.0
const CORNER_BOX_R: float = 24.0
const CORNER_ARRIVE_R: float = 0.35
const CORNER_RETARGET: Vector2 = Vector2(0.7, 1.7)






func _setup_corner_movement() -> void:
	_corner_move = false
	_corner_is_corner = _chance_kind == "corner"

























	if not _corner_is_corner and not _cross_setpiece:
		return



	var free_rivals: Array = []
	for r in _rival_actors:
		if is_instance_valid(r) and not r.has_meta("hold_wall") \
				and not (_corner_is_corner and _fuera_del_area(_flat2(r.position))):
			free_rivals.append(r)
	var mates: Array = _teammate_actors.duplicate()
	mates.sort_custom(func(a, b):
		return _flat2(a.position).length() < _flat2(b.position).length())
	for mate in mates:
		if not is_instance_valid(mate):
			continue



		if _flat2(mate.position).length() > CORNER_BOX_R:
			continue
		var home: Vector2 = _flat2(mate.position)
		_corner_home[mate] = home
		_corner_target[mate] = home
		_corner_next_t[mate] = randf_range(CORNER_RETARGET.x, CORNER_RETARGET.y)
		var best: AnimatedSprite3D = null
		var best_d: float = CORNER_ZONA_R if _corner_is_corner and _corner_zonal \
				else CORNER_MARK_ASSIGN_R
		for r in free_rivals:
			var d: float = _flat2(r.position).distance_to(home)
			if d < best_d:
				best_d = d
				best = r
		if best != null:
			_corner_marker[mate] = best
			free_rivals.erase(best)




			var to_goal: Vector2 = - home
			if to_goal.length() < 0.1:
				to_goal = Vector2(0.0, -1.0)
			var gs: Vector2 = _clamp_field(_push_out(
				home + to_goal.normalized() * CORNER_MARK_GAP,
				_keeper_spot(_ball_field), KEEPER_CLEAR))
			best.position = Vector3(gs.x, best.position.y, gs.y)









































	if not _corner_is_corner:
		var suelo: float = _onside_floor()
		for mate in _teammate_actors:
			if not is_instance_valid(mate) or mate.position.z >= suelo:
				continue
			mate.position = Vector3(mate.position.x, mate.position.y, suelo)
			if _corner_home.has(mate):
				_corner_home[mate] = _flat2(mate.position)
				_corner_target[mate] = _corner_home[mate]
		_corner_relax()
		for i in _rival_actors.size():
			if is_instance_valid(_rival_actors[i]) and i < _defender_pos.size():
				_defender_pos[i] = _flat2(_rival_actors[i].position)
		return

















	for a in _teammate_actors + _rival_actors:
		if not is_instance_valid(a) or a.has_meta("hold_wall"):
			continue
		if _corner_home.has(a) or _corner_marker.values().has(a):
			continue
		_marca_espera(a)
	_corner_move = true







func _fuera_del_area(p: Vector2) -> bool:
	return p.y > Stadium.PA_DEPTH or absf(p.x) > Stadium.PA_HALF_W










func _marca_espera(a: AnimatedSprite3D, temperamento: bool = false) -> void:
	var aqui: Vector2 = Vector2(a.position.x, a.position.z)
	a.set_meta("cedida_espera", aqui)



	a.set_meta("cedida_dest", aqui)
	a.set_meta("cedida_pausa", randf() * CEDIDA_ESPERA_PAUSA_0)









	var tope: float = CEDIDA_ESPERA_A



	if _chance_kind == "penal" \
			and absf(a.position.z) <= Stadium.PA_DEPTH + COBRO_AREA_MARGEN:

		tope = minf(tope, maxf(absf(a.position.x)
			-(Stadium.PA_HALF_W + COBRO_AREA_MARGEN), 0.0))
	if not temperamento:
		a.set_meta("cedida_amp", tope * randf_range(0.7, 1.0))
		return
	var dado: float = randf()
	if dado < CEDIDA_ESPERA_QUIETO:
		a.set_meta("cedida_amp", 0.0)
	elif dado < CEDIDA_ESPERA_QUIETO + CEDIDA_ESPERA_CORTO:
		a.set_meta("cedida_amp", tope * randf_range(0.22, 0.5))
	else:
		a.set_meta("cedida_amp", tope * randf_range(0.7, 1.0))
















func _update_corner_movement(delta: float) -> void:


	var antes: Dictionary = {}
	var familia: Dictionary = {}
	for mate in _teammate_actors:
		if not is_instance_valid(mate) or not _corner_home.has(mate):
			continue
		var pos: Vector2 = _flat2(mate.position)
		_corner_next_t[mate] = float(_corner_next_t[mate]) - delta
		if pos.distance_to(_corner_target[mate]) < CORNER_ARRIVE_R \
				or float(_corner_next_t[mate]) <= 0.0:
			_corner_target[mate] = _corner_pick_target(mate)
			_corner_next_t[mate] = randf_range(CORNER_RETARGET.x, CORNER_RETARGET.y)
		antes[mate] = pos
		familia[mate] = ""
		pos = _corner_step(pos, _corner_target[mate], CORNER_JOG * delta)
		mate.position = Vector3(pos.x, mate.position.y, pos.y)









		var marker = _corner_marker.get(mate)
		if is_instance_valid(marker):
			var to_goal: Vector2 = - pos
			if to_goal.length() < 0.1:
				to_goal = Vector2(0.0, -1.0)
			var want: Vector2 = _push_out(pos + to_goal.normalized() * CORNER_MARK_GAP,
				_keeper_spot(_ball_field), KEEPER_CLEAR)
			antes[marker] = _flat2(marker.position)



			familia[marker] = "walk_"
			var mp: Vector2 = _corner_step(_flat2(marker.position), want,
				CORNER_MARK_JOG * delta)
			marker.position = Vector3(mp.x, marker.position.y, mp.y)
	_corner_relax()





	for actor in antes:
		if is_instance_valid(actor):
			_corner_animate(actor, _flat2(actor.position) - antes[actor], delta,
				String(familia[actor]))


	for i in _rival_actors.size():
		if is_instance_valid(_rival_actors[i]) and i < _defender_pos.size():
			_defender_pos[i] = _flat2(_rival_actors[i].position)







func _corner_relax() -> void:
	var movers: Array = []
	for a in _teammate_actors:
		if is_instance_valid(a) and _corner_home.has(a):
			movers.append(a)
	for a in _corner_marker.values():
		if is_instance_valid(a) and not movers.has(a):
			movers.append(a)
	var ball: Vector2 = _ball_field
	var kp: Vector2 = _keeper_spot(ball)

	var fixed: Array = []
	for r in _rival_actors:
		if is_instance_valid(r) and not movers.has(r):
			fixed.append(_flat2(r.position))
















	var line_z: float = _last_defender_z() if not _corner_is_corner else INF
	for _pass in 3:
		for a in movers:
			var p: Vector2 = _flat2(a.position)
			p = _push_out(p, ball, CLEAR_BALL_R)
			p = _push_out(p, kp, KEEPER_CLEAR)
			for f in fixed:
				p = _push_out(p, f, ACTOR_SEP)
			var partner: Object = _corner_partner(a)
			for b in movers:
				if b == a:
					continue
				var sep: float = CORNER_PAIR_SEP if b == partner else ACTOR_SEP
				if p.distance_to(_flat2(b.position)) < sep:
					p = _push_out(p, _flat2(b.position), sep)



			if _corner_home.has(a):
				var home: Vector2 = _corner_home[a]
				var off: Vector2 = p - home
				if off.length() > CORNER_WANDER_R:
					p = home + off.normalized() * CORNER_WANDER_R








				if line_z < INF and p.y < line_z and not _corner_marker.has(a):
					p.y = minf(line_z, home.y + CORNER_WANDER_R)



			p = _push_out(p, ball, CLEAR_BALL_R)
			p = _push_out(p, kp, KEEPER_CLEAR)
			p = _clamp_field(p)
			a.position = Vector3(p.x, a.position.y, p.y)




func _corner_partner(a: Object) -> Object:
	if _corner_marker.has(a):
		return _corner_marker[a]
	for mate in sin_muertos(_corner_marker):
		if _corner_marker[mate] == a:
			return mate
	return null





func _corner_pick_target(mate: AnimatedSprite3D) -> Vector2:
	var home: Vector2 = _corner_home[mate]
	for _try in 8:
		var ang: float = randf() * TAU
		var rad: float = sqrt(randf()) * CORNER_WANDER_R
		var cand: Vector2 = _clamp_field(home + Vector2(cos(ang), sin(ang)) * rad)
		if not _corner_target_ok(cand, mate):
			continue
		return cand
	return home


func _corner_target_ok(p: Vector2, mate: AnimatedSprite3D) -> bool:
	if p.distance_to(_ball_field) < CLEAR_BALL_R:
		return false
	if p.distance_to(_keeper_spot(_ball_field)) < KEEPER_CLEAR:
		return false



	var home: Vector2 = _corner_home[mate]
	if p.length() > maxf(home.length(), BOX_TRIGGER_R) + CORNER_WANDER_R:
		return false

	for other in _teammate_actors:
		if other == mate or not _corner_home.has(other):
			continue
		if p.distance_to(_corner_home[other]) < ACTOR_SEP + 0.3:
			return false





	if not _corner_is_corner and not _corner_marker.has(mate):
		if p.y < _corner_home[mate].y - 0.3:
			return false
	return true



func _corner_step(from: Vector2, to: Vector2, maxd: float) -> Vector2:
	var d: Vector2 = to - from
	var l: float = d.length()
	if l <= maxd or l < 0.001:
		return to
	return from + d / l * maxd


















func _corner_animate(actor: AnimatedSprite3D, moved2: Vector2, delta: float,
		fam_force: String = "") -> void:
	if moved2.length() < LOCO_MIN_SPD * delta:

		_face_ball(actor)
		return
	_play_run(actor, Vector3(moved2.x, 0.0, moved2.y), fam_force)


func _flat2(p: Vector3) -> Vector2:
	return Vector2(p.x, p.z)













func _stance_side_sign() -> float:
	if is_zero_approx(_ball_field.x):
		return 1.0
	return - signf(_ball_field.x)














