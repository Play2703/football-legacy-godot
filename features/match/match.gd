func _recep_ver_hombro(srv: AnimatedSprite3D, yo: AnimatedSprite3D) -> Array[Vector3]:


	var der: Vector3 = Vector3(_recep_f.x, 0.0, _recep_f.y).cross(Vector3.UP).normalized() * 0.6
	var p: Vector3 = Vector3(yo.position.x, 0.0, yo.position.z)
