func _formacion_despeja(anchor: Vector3, inward: Vector2, desde: float, hasta: float,
		medio: float) -> void:
	for r in _rival_actors:
		if not is_instance_valid(r):
			continue
		var p: Vector2 = _formacion_apartado(Vector2(r.position.x, r.position.z), anchor,
			inward, desde, hasta, medio)
		if p == Vector2.INF:
			continue
		var to: Vector3 = _formacion_en_campo(p, r.position.y)
		var dur: float = maxf(_flat_dist(r.position, to) / AWAY_TROT_SPEED, 0.5)
		_run_target[r] = to
		_celeb_seal_run(r, dur)
		_play_run(r, to - r.position)
		var tw: Tween = create_tween()
		tw.tween_property(r, "position", to, dur)
		tw.tween_callback(func() -> void:
			if not is_instance_valid(r):
				return
			_run_target.erase(r)
			r.play("idle"))
		_celeb_runs.append(tw)



static func _formacion_apartado(p: Vector2, anchor: Vector3, inward: Vector2, desde: float,
		hasta: float, medio: float) -> Vector2:
	var base: Vector2 = Vector2(anchor.x, anchor.z)
	var across: Vector2 = Vector2(- inward.y, inward.x)
	var largo: float =(p - base).dot(inward)
	var lado: float =(p - base).dot(across)
	if largo < desde or largo > hasta or absf(lado) >= medio:
		return Vector2.INF
	var signo: float = signf(lado) if not is_zero_approx(lado) else 1.0
	return base + inward * largo + across * signo *(medio + 2.0)














