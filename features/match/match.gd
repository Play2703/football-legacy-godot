func _on_playa_bota(fuerza: float, _pos: Vector3) -> void:
	if _audio != null and is_instance_valid(_audio):
		_audio.playa_bote(fuerza)






func _playa_step(dt: float) -> void:
	if _playa == null:
		return
	if not is_instance_valid(_playa):
		_playa = null
		return
	_playa.avanza(dt)
	if _ball == null or dt <= 0.0:
		return
	var bp: Vector3 = _ball.position
	var prev: Vector3 = _playa_prev_ball
	_playa_prev_ball = bp
	if (_playa_ix >= 0 and not _playa_done) or not _playa.empujable():
		return
	var c: Vector3 = _playa.position
	for n in _actors.get_children():
		var a: AnimatedSprite3D = n as AnimatedSprite3D
		if a == null or not a.visible or a == _ball:
			continue
		var d: Vector2 = Vector2(c.x - a.position.x, c.z - a.position.z)
		if d.length() < BalonPlaya.R + PLAYA_CUERPO_R:
			_playa.empujar(Vector3(d.x, 0.0, d.y), PLAYA_EMPUJE_V)
			return
	if prev == Vector3.INF:
		return
	var db: Vector3 = c - bp
	if db.length() < BalonPlaya.R + BALL_R:
		var vb: float = Vector2(bp.x - prev.x, bp.z - prev.z).length() / dt
		if vb < PLAYA_EMPUJE_BALL_MAX:
			_playa.empujar(db, maxf(vb * 1.3, 1.0))






























