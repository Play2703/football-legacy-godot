const TUBE_RESTITUTION: float = 0.55
const TUBE_FRICTION: float = 0.88

















const BAR_VY_MAX: float = 6.0
const BAR_VY_PASA: float = 0.35
const BAR_VY_RUMBO: float = 2.0
































const BAR_RATIO_FLAT: float = 0.3
const BAR_RATIO_STEEP: float = 0.85
const BAR_KEEP_Z_FLAT: float = 0.55
const BAR_KEEP_Z_STEEP: float = 0.12


const BAR_DEEP_Z: float = 0.6

























var BAR_CARRY_VY: float = 2.0
































const BAR_CARRY_CLEAR: float = -3.0
var BAR_RISE_UNDER: float = 0.35
func _tube_bounce(v: Vector3, p: Vector3, is_bar: bool) -> Vector3:
	var n: Vector3 = _tube_normal(p, is_bar)
	var vn: float = v.dot(n)


	var out: Vector3 = v if vn >= 0.0 else (v - n *((1.0 + TUBE_RESTITUTION) * vn))
	var tang: Vector3 = out - n * out.dot(n)
	out = n * out.dot(n) + tang * TUBE_FRICTION
	return out + Vector3(randf_range(-0.9, 0.9), randf_range(-0.3, 0.3),
		randf_range(-0.3, 0.3))






static func _larguero_techo(out: Vector3, v_in: Vector3) -> Vector3:
	if out.y <= BAR_VY_MAX:
		return out
	var h: Vector2 = Vector2(out.x, out.z)
	var dir: Vector2 = h.normalized() if h.length() > BAR_VY_RUMBO \
			else Vector2(v_in.x, v_in.z).normalized()
	h += dir *(out.y - BAR_VY_MAX) * BAR_VY_PASA
	return Vector3(h.x, BAR_VY_MAX, h.y)




func _tube_normal(p: Vector3, is_bar: bool) -> Vector3:
	if is_bar:
		var nb: Vector2 = Vector2(p.y + BALL_R - CROSSBAR_H, p.z)
		nb = Vector2(0.0, 1.0) if nb.length() < 0.001 else nb.normalized()
		return Vector3(0.0, nb.x, nb.y)
	var side: float = signf(p.x)
	var np: Vector2 = Vector2(p.x - side * GOAL_HALF_W, p.z)
	np = Vector2(side, 1.0).normalized() if np.length() < 0.001 else np.normalized()
	return Vector3(np.x, 0.0, np.y)







func _tube_pushout(p: Vector3, is_bar: bool) -> Vector3:
	var out: float = POST_HIT_BAND * 1.02
	if is_bar:
		var n: Vector2 = Vector2(p.y + BALL_R - CROSSBAR_H, p.z)
		n = Vector2(0.0, 1.0) if n.length() < 0.001 else n.normalized()
		return Vector3(p.x, CROSSBAR_H - BALL_R + n.x * out, n.y * out)
	var side: float = signf(p.x)
	var m: Vector2 = Vector2(p.x - side * GOAL_HALF_W, p.z)
	m = Vector2(side, 1.0).normalized() if m.length() < 0.001 else m.normalized()
	return Vector3(side * GOAL_HALF_W + m.x * out, p.y, m.y * out)




























func _fotograma_de_contacto(p: Vector3, is_bar: bool, k: int) -> int:
	var toca: float = BALL_ART_R + POST_R
	var side: float = signf(p.x)
	var vis: Vector3
	if is_bar:

		var nb: Vector2 = Vector2(p.y + BALL_ART_R - CROSSBAR_H, p.z)
		nb = Vector2(0.0, 1.0) if nb.length() < 0.001 else nb.normalized()
		vis = Vector3(p.x, CROSSBAR_H + nb.x * toca - BALL_ART_R, nb.y * toca)
	else:
		var m: Vector2 = Vector2(p.x - side * GOAL_HALF_W, p.z)
		m = Vector2(side, 1.0).normalized() if m.length() < 0.001 else m.normalized()
		vis = Vector3(side * GOAL_HALF_W + m.x * toca, p.y, m.y * toca)
	vis.y = maxf(vis.y, 0.0)
	var desde: int = maxi(k + 1, 1)




	while desde - 1 >= maxi(k - 1, 1) and desde - 1 < _traj.size():
		var q: Vector3 = _traj[desde - 1]
		var d: float = Vector2(q.y + BALL_ART_R - CROSSBAR_H, q.z).length() if is_bar \
				else Vector2(q.x - side * GOAL_HALF_W, q.z).length()
		if d >= toca:
			break
		desde -= 1
	if desde >= _traj.size():
		_traj.append(vis)
		return _traj.size() - 1
	for i in range(desde, _traj.size()):
		_traj[i] = vis
	return desde






func _tube_punch(pix: int) -> float:
	if pix < 1 or pix >= _traj.size():
		return 1.0
	var a: int = pix - 2 if pix >= 2 else pix - 1
	var b: int = pix - 1 if pix >= 2 else pix
	return clampf((_traj[b] - _traj[a]).length() / SIM_DT / 24.0, 0.3, 1.25)


















func _tube_approach(a: Vector3, b: Vector3) -> Dictionary:
	var best: Dictionary = {"d": INF, "p": b, "bar": false}
	for side in [-1.0, 1.0]:
		var g: Vector2 = _seg_vs_tube(
			Vector2(a.x - side * GOAL_HALF_W, a.z),
			Vector2(b.x - side * GOAL_HALF_W, b.z))
		if g.x >= float(best["d"]):
			continue
		var c: Vector3 = a.lerp(b, g.y)
		if c.y + BALL_R < CROSSBAR_H + POST_R:
			best = {"d": g.x, "p": c, "bar": false}
	var gb: Vector2 = _seg_vs_tube(
		Vector2(a.y + BALL_R - CROSSBAR_H, a.z),
		Vector2(b.y + BALL_R - CROSSBAR_H, b.z))
	if gb.x < float(best["d"]):
		var cb: Vector3 = a.lerp(b, gb.y)
		if absf(cb.x) <= GOAL_HALF_W + POST_R:
			best = {"d": gb.x, "p": cb, "bar": true}
	return best










func _seg_vs_tube(a: Vector2, b: Vector2) -> Vector2:
	var ab: Vector2 = b - a
	var l2: float = ab.length_squared()
	if l2 <= 1e-06:
		return Vector2(a.length(), 0.0)
	var t_near: float = clampf(- a.dot(ab) / l2, 0.0, 1.0)
	var d: float = a.lerp(b, t_near).length()
	if d >= POST_HIT_BAND:
		return Vector2(d, t_near)
	var bq: float = a.dot(ab)
	var c: float = a.length_squared() - POST_HIT_BAND * POST_HIT_BAND
	var disc: float = maxf(bq * bq - l2 * c, 0.0)
	return Vector2(d, clampf((- bq - sqrt(disc)) / l2, 0.0, 1.0))































func _corta_en_portero(pos: Vector3, kz: float) -> Vector3:
	_traj.append(pos)
	if kz <= 0.15:
		return pos
	var ik: int = _traj.size() - 1
	while ik > 0 and _traj[ik - 1].z <= kz:
		ik -= 1
	if ik > 0:
		var a: Vector3 = _traj[ik - 1]
		var b: Vector3 = _traj[ik]
		var dz: float = a.z - b.z
		_traj[ik] = b if dz <= 0.0001 else a.lerp(b, clampf((a.z - kz) / dz, 0.0, 1.0))
	_traj.resize(ik + 1)
	return _traj[ik]










func _parry_atras(vel: Vector3, edge: float, y: float, kz: float, x: float) -> Vector3:



	var pw: float = clampf((vel.length() - 10.0) / 18.0, 0.0, 1.0)


	var umbral: float = PARRY_ATRAS_EDGE_B1 if palanca_parry_atras else PARRY_ATRAS_EDGE

	if edge < umbral or kz <= 0.4 \
			or randf() >= PARRY_ATRAS_P * lerpf(PARRY_ATRAS_FLOJO, PARRY_ATRAS_FUERTE, pw):
		return Vector3.ZERO
	var vz: float = - clampf(vel.length() * 0.18, 2.5, 4.5)
	var t: float = kz / - vz
	if y + BALL_R >= PARRY_ALTO_Y:

		var y_obj: float = CROSSBAR_H + BALL_R + 0.45
		var vy: float =(y_obj - y + 0.5 * 9.8 * t * t) / t
		return Vector3(signf(x) * randf_range(0.0, 0.8), minf(vy, 9.0), vz)
	var lado: float = signf(x) if absf(x) > 0.05 else (1.0 if randf() < 0.5 else -1.0)
	var x_obj: float = lado *(GOAL_HALF_W + 0.06)
	return Vector3((x_obj - x) / t, randf_range(0.6, 1.6), vz)


func _parry_velocity(vel: Vector3, spin: float, ex: float, y: float = 0.0,
		kz: float = 0.0, x: float = 0.0) -> Vector3:
	var atras: Vector3 = _parry_atras(vel, clampf(absf(ex), 0.0, 1.0), y, kz, x)
	if atras != Vector3.ZERO:
		return atras
	var v_in: float = vel.length()


	var edge: float = clampf(absf(ex), 0.0, 1.0)










	var pw: float = clampf((v_in - 10.0) / 18.0, 0.0, 1.0)



	var b2: bool = palanca_rechace_vivo
	var keep: float = lerpf(REBOUND_KEEP_MAX_B2 if b2 else REBOUND_KEEP_MAX,
		REBOUND_KEEP_MIN_B2 if b2 else REBOUND_KEEP_MIN,
		clampf(_keeper_skill, 0.0, 1.0)) * lerpf(0.8, 1.35, edge) \
				* lerpf(REBOUND_POWER_MIN, REBOUND_POWER_MAX, pw)
	var pace: float = maxf(v_in * keep, REBOUND_MIN_PACE) * randf_range(0.88, 1.12)


	var side: float = signf(ex) if edge > 0.15 \
			else (1.0 if randf() < 0.5 else -1.0)

	var dir: Vector3 = Vector3(
		side * lerpf(REBOUND_ABRE_B2 if b2 else 0.3, 0.95, edge),
		lerpf(0.34, 0.22, edge),
		lerpf(0.92, 0.42, edge)).normalized()



	dir.x -= signf(spin) * minf(absf(spin), 1.5) * REBOUND_SPIN
	return dir.normalized() * pace






