	var huella: String = _huella_campo()
	if huella == _huella_montada:
		return
	_refresca_fichas(_montada, "defenders", "defender_players", "extras_rivals",
		"extras_rival_players", _rival_by_advance(), false,
		_nombres_de_huella(_huella_montada, false))
	_refresca_fichas(_montada, "teammates", "mate_players", "extras_mates",
		"extras_mate_players", _finishers_hoy(), true,
		_nombres_de_huella(_huella_montada, true))
	_setup_chance(_montada)


	if bool(_montada.get("pedido", false)):
		_pedido_tapa()
