const PLAYA_HUECO: float = 5.0



const PLAYA_LADO: float = 1.2

const PLAYA_Z_MIN: float = 1.5

const PLAYA_LIBRE: float = 1.3
const PLAYA_INTENTOS: int = 16



const PLAYA_PANT_X: float = 0.1
const PLAYA_PANT_Y0: float = 0.12
const PLAYA_PANT_Y1: float = 0.7




const PLAYA_GIRO_MIN: float = 0.17
const PLAYA_GIRO_MAX: float = 0.52
const PLAYA_K_MIN: float = 0.7
const PLAYA_K_MAX: float = 0.86
const PLAYA_SALTO_MIN: float = 0.8
const PLAYA_SALTO_MAX: float = 2.6



const PLAYA_FRENTE_M: float = 0.04

const PLAYA_OOH_S: float = 0.25



const PLAYA_CUERPO_R: float = 0.3
const PLAYA_EMPUJE_V: float = 2.2
const PLAYA_EMPUJE_BALL_MAX: float = 12.0

