func _celeb_stand_mira(f: Vector3) -> Vector3:
	var pecho: Vector3 = f + Vector3(0.0, CELEB_STAND_LOOK_H, 0.0)
	var d: float = _celeb_cam.global_position.distance_to(pecho)
	return pecho + Vector3(0.0,
		tan(deg_to_rad(_celeb_cam.fov * 0.5)) * d * CELEB_STAND_BAJO, 0.0)


func _look_after(outcome: String) -> void:
	match outcome:
		"goal":
			_pick_celebration_cam()
		"save":
			if _keeper != null and is_instance_valid(_keeper):
				_look_target = _keeper
		"post":
			_look_target = _ball
		"dribble_lost":






			_look_target = _ball
		"perro":



			_look_target = _ball









func _celeb_rival_scorer() -> Node3D:
	var ball_p: Vector3 = _ball.position if (_ball != null and is_instance_valid(_ball)) \
			else Vector3(0.0, 0.0, Stadium.FIELD_DEPTH)
	var mejor: Node3D = null
	var d_min: float = INF
	for r in _rival_actors:
		if r == null or not is_instance_valid(r):
			continue
		var d: float =(r.position - ball_p).length()
		if d < d_min:
			d_min = d
			mejor = r
	return mejor


func _pick_celebration_cam() -> void:



	if _celeb_rival and (_celeb_focus == null or not is_instance_valid(_celeb_focus) \
			or not _rival_actors.has(_celeb_focus)):
		_celeb_focus = _celeb_rival_scorer()
	if _celeb_focus == null or not is_instance_valid(_celeb_focus):
		_celeb_focus = _self_actor

	if _celeb_focus_pos == Vector3.ZERO and _celeb_focus != null \
			and is_instance_valid(_celeb_focus):
		_celeb_focus_pos = _celeb_focus.position

	var shot: String = _force_celeb_shot if not _force_celeb_shot.is_empty() \
			else _choose_celeb_shot(_last_celeb_shot, randi())









	if (_last_celeb_spot == CELEB_SPOT_FENCE or _last_celeb_spot == CELEB_SPOT_FENCE_SIT) \
			and _force_celeb_shot.is_empty():
		shot = _choose_from(CELEB_SHOTS_FENCE, _last_celeb_shot, randi())




	if _last_celeb_spot == CELEB_SPOT_CAM and _force_celeb_shot.is_empty() \
			and not _celeb_rival:
		shot = CELEB_SHOT_CAM


	if _last_celeb_spot == CELEB_SPOT_PUDDLE and _force_celeb_shot.is_empty():
		shot = _choose_from(CELEB_SHOTS_PUDDLE, _last_celeb_shot, randi())














	if _last_celeb_spot == CELEB_SPOT_COACH and _force_celeb_shot.is_empty():
		shot = CELEB_SHOT_COACH



	if _celeb_a_por_balon and _force_celeb_shot.is_empty():
		shot = "follow"
	_last_celeb_shot = shot
	_celeb_shot = shot
	if shot == "follow":

		_celeb_active = false
		if _celeb_focus != null and is_instance_valid(_celeb_focus):
			_look_target = _celeb_focus
		_swoop_follow_cam()
		_reanima_carreras_festejo()
		return
	_begin_celeb_shot(shot)
	_reanima_carreras_festejo()


















func _reanima_carreras_festejo() -> void:
	_cam_base_frame = -1
	for actor in _run_target.keys():
		if is_instance_valid(actor) and not actor.has_meta("order_paused"):


			if actor.has_meta("dir_last"):
				actor.remove_meta("dir_last")








			if actor.has_meta("dir_show"):
				actor.remove_meta("dir_show")
			_play_run(actor, _run_target[actor] - actor.position)














const CELEB_FOLLOW_D: float = 8.5
const CELEB_FOLLOW_H: float = 2.8
const CELEB_FOLLOW_T: float = 1.5

func _swoop_follow_cam() -> void:
	if _aim_cam == null or not is_instance_valid(_aim_cam):
		return
	var fp: Vector3 = _celeb_focus.position if (_celeb_focus != null \
			and is_instance_valid(_celeb_focus)) else _celeb_focus_pos
	var here: Vector3 = _aim_cam.position


	var lejos: float = CELEB_FOLLOW_D * CELEB_CAM_ALEJA

















	var meta: Vector3 = _celeb_focus_pos if _celeb_focus_pos != Vector3.ZERO else fp
	_celeb_giro_i = -1
	var off: Vector3 = _celeb_encara(meta, Vector3(
		sin(CELEB_ENCARA_CONO) * lejos, 0.0, cos(CELEB_ENCARA_CONO) * lejos),
		minf(here.y, CELEB_FOLLOW_H))
	var dest: Vector3 = Vector3(meta.x + off.x,
		minf(here.y, CELEB_FOLLOW_H), meta.z + off.z)






	_celeb_base_pos = dest
	_celeb_base_until_ms = Time.get_ticks_msec() \
			+ maxi(CELEB_DIR_SETTLE_MS, int(CELEB_FOLLOW_T * 1000.0) + 150)
	if _celeb_cam_tween and _celeb_cam_tween.is_valid():
		_celeb_cam_tween.kill()
	_celeb_cam_tween = create_tween()
	_celeb_cam_tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
	_celeb_cam_tween.set_ignore_time_scale(true)
	_celeb_cam_tween.tween_property(_aim_cam, "position", dest,
		CELEB_FOLLOW_T).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)





static func _choose_celeb_shot(last: String, roll: int) -> String:
	var pool: Array = CELEB_SHOTS.filter(func(s: String) -> bool: return s != last)
	if pool.is_empty():
		pool = CELEB_SHOTS
	return String(pool[roll % pool.size()])





func _begin_celeb_shot(shot: String) -> void:
	_look_target = null
	var fp: Vector3 = _celeb_focus_pos
	var side: float = signf(fp.x) if absf(fp.x) > 0.01 else 1.0
	if _celeb_cam == null:
		_celeb_cam = Camera3D.new()
		add_child(_celeb_cam)
	if _celeb_cam_tween and _celeb_cam_tween.is_valid():
		_celeb_cam_tween.kill()
	var start_pos: Vector3



	var fin_pos: Vector3
	_celeb_giro_i = -1
	match shot:
		"corner_low":

			_celeb_cam.fov = 52.0
			fin_pos = _celeb_cam_pos(fp,
				_celeb_encara(fp, _celeb_off_aleja(Vector3(- side * 2.0, 1.6, 3.8))))
			start_pos = _celeb_cam_pos(fp,
				_celeb_encara(fp, _celeb_off_aleja(Vector3(- side * 2.0, 1.7, 5.2))))
			_celeb_cam.position = start_pos
			_celeb_cam_tween = create_tween()
			_celeb_cam_tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			_celeb_cam_tween.set_ignore_time_scale(true)
			_celeb_cam_tween.tween_property(_celeb_cam, "position", fin_pos,
				3.0).set_trans(Tween.TRANS_SINE)
		"pushin":

			_celeb_cam.fov = 46.0
			fin_pos = _celeb_cam_pos(fp,
				_celeb_encara(fp, _celeb_off_aleja(Vector3(- side * 1.2, 1.65, 4.4))))
			start_pos = _celeb_cam_pos(fp,
				_celeb_encara(fp, _celeb_off_aleja(Vector3(- side * 1.2, 1.8, 8.6))))
			_celeb_cam.position = start_pos
			_celeb_cam_tween = create_tween()
			_celeb_cam_tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			_celeb_cam_tween.set_ignore_time_scale(true)
			_celeb_cam_tween.tween_property(_celeb_cam, "position", fin_pos,
				3.2).set_trans(Tween.TRANS_SINE)
		"wide":





			_celeb_cam.fov = 62.0
			fin_pos = _celeb_cam_pos(fp,
				_celeb_encara(fp, _celeb_off_aleja(Vector3(side * 3.4, 3.0, 10.6))))
			start_pos = _celeb_cam_pos(fp,
				_celeb_encara(fp, _celeb_off_aleja(Vector3(side * 4.5, 3.4, 13.0))))
			_celeb_cam.position = start_pos
			_celeb_cam_tween = create_tween()
			_celeb_cam_tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			_celeb_cam_tween.set_ignore_time_scale(true)
			_celeb_cam_tween.tween_property(_celeb_cam, "position", fin_pos,
				3.2).set_trans(Tween.TRANS_SINE)
		CELEB_SHOT_COACH:










			_celeb_cam.fov = CELEB_COACH_FOV
			var par: Vector3 = _celeb_coach_par(fp)
			var dz: float = signf(fp.z - par.z) if absf(fp.z - par.z) > 0.01 else -1.0
			start_pos = _celeb_cam_pos(par, _celeb_off_aleja(Vector3(
				- side * CELEB_COACH_CAM_D0, CELEB_COACH_CAM_Y - par.y,
				dz * CELEB_COACH_CAM_D0 * CELEB_COACH_CAM_SESGO)))
			_celeb_cam.position = start_pos
			_celeb_cam_tween = create_tween()
			_celeb_cam_tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			_celeb_cam_tween.set_ignore_time_scale(true)
			_celeb_cam_tween.tween_property(_celeb_cam, "position",
				_celeb_cam_pos(par, _celeb_off_aleja(Vector3(
					- side * CELEB_COACH_CAM_D1, CELEB_COACH_CAM_Y - par.y,
					dz * CELEB_COACH_CAM_D1 * CELEB_COACH_CAM_SESGO))),
				3.4).set_trans(Tween.TRANS_SINE)
		CELEB_SHOT_FENCE:






			_celeb_cam.fov = 58.0
			start_pos = _celeb_cam_pos(fp, _celeb_off_aleja(Vector3(- side * 13.0, 2.6, 6.0)))
			_celeb_cam.position = start_pos
			_celeb_cam_tween = create_tween()
			_celeb_cam_tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			_celeb_cam_tween.set_ignore_time_scale(true)
			_celeb_cam_tween.tween_property(_celeb_cam, "position",
				_celeb_cam_pos(fp, _celeb_off_aleja(Vector3(- side * 11.0, 2.4, 5.2))),
				3.4).set_trans(Tween.TRANS_SINE)
		CELEB_SHOT_STAND:































			var mira0: Vector3 = fp + Vector3(0.0, CELEB_STAND_LOOK_H, 0.0)

			var tanteo: Vector3 = Vector3(side * 48.0, 11.7, fp.z)
			if _stadium != null and is_instance_valid(_stadium):
				tanteo = _stadium.stand_view_spot(Vector3(side, 0.0, fp.z))


			var caida: float = maxf(tanteo.y - mira0.y, 0.1)
			var d_pide: float = caida / tan(deg_to_rad(CELEB_STAND_PICADA_MAX))
			var dx: float = absf(tanteo.x) - absf(fp.x)
			var dz: float = maxf(sqrt(maxf(d_pide * d_pide - dx * dx, 0.0)),
				CELEB_STAND_DZ)


			var hacia: float = 1.0 if fp.z < Stadium.HALF_LINE else -1.0
			var z_but: float = clampf(fp.z + hacia * dz, CELEB_STAND_Z_PAD,
				2.0 * Stadium.HALF_LINE - CELEB_STAND_Z_PAD)
			_celeb_cam.position = _stadium.stand_view_spot(
				Vector3(side, 0.0, z_but)) if (_stadium != null \
						and is_instance_valid(_stadium)) else Vector3(tanteo.x, tanteo.y, z_but)



			_celeb_stand_enc = CELEB_STAND_ENCUADRE_0
			_celeb_cam.fov = _celeb_stand_fov(
				_celeb_cam.position.distance_to(mira0), _celeb_stand_enc)
			if _celeb_cam_tween and _celeb_cam_tween.is_valid():
				_celeb_cam_tween.kill()
			_celeb_cam_tween = create_tween()
			_celeb_cam_tween.set_pause_mode(Tween.TWEEN_PAUSE_PROCESS)
			_celeb_cam_tween.set_ignore_time_scale(true)







			_celeb_cam_tween.tween_property(self, "_celeb_stand_enc",
				CELEB_STAND_ENCUADRE, 3.4).set_trans(Tween.TRANS_SINE)
		CELEB_SHOT_CAM:






			var op: Vector3 = _stadium.camera_op_spot(fp) \
					if (_stadium != null and is_instance_valid(_stadium)) else Vector3.INF
			if op == Vector3.INF:

				op = Vector3(fp.x, 0.0, fp.z - CELEB_CAM_STOP_M)





			var fwd: Vector3 = Vector3(fp.x - op.x, 0.0, fp.z - op.z)
			if fwd.length() > 0.01:
				op += fwd.normalized() * CELEB_CAM_POV_FWD
			start_pos = _celeb_cam_pos(fp, Vector3(op.x - fp.x,
				CELEB_CAM_POV_H - fp.y, op.z - fp.z))
			_celeb_cam.position = start_pos



			_celeb_pov_look = fp + Vector3(0.0, CELEB_CAM_POV_LOOK_H, 0.0)
			_celeb_pov_phase = 0.0




			_celeb_cam.fov = _celeb_pov_fov(
				start_pos.distance_to(fp + Vector3(0.0, CELEB_CAM_POV_LOOK_H, 0.0)))



			if _hud != null:
				_hud.show_broadcast_rec()
		"orbit":






			_celeb_cam.fov = 54.0
			var orb: Vector3 = _celeb_encara(fp, _celeb_off_aleja(Vector3(
				sin(- side * 0.7) * CELEB_ORBIT_R, CELEB_ORBIT_H,
				cos(- side * 0.7) * CELEB_ORBIT_R)))
			_celeb_orbit_r = maxf(Vector2(orb.x, orb.z).length(), CELEB_ENCARA_MIN_D)
			_celeb_orbit_ang = atan2(orb.x, orb.z)
			_celeb_orbit_sentido = 1.0
			_celeb_orbit_rebote = 0.0
			_celeb_cam.position = _celeb_cam_pos(fp, orb)
	if shot == CELEB_SHOT_STAND:



		_celeb_cam.look_at(_celeb_stand_mira(fp))
	elif shot == CELEB_SHOT_COACH:


		_celeb_cam.look_at(_celeb_coach_mira(_celeb_focus.position \
				if (_celeb_focus != null and is_instance_valid(_celeb_focus)) else fp))
	else:




		var vivo: Vector3 = _celeb_focus.position if (shot != CELEB_SHOT_CAM \
				and _celeb_focus != null and is_instance_valid(_celeb_focus)) else fp
		_celeb_cam.look_at(vivo + Vector3(0.0, CELEB_LOOK_H, 0.0))



	_celeb_fov_base = _celeb_cam.fov if (CELEB_SHOTS.has(shot)
		or shot == CELEB_SHOT_FENCE) else 0.0
	_celeb_fov_enc = CELEB_SIGUE_ENC_VALLA if shot == CELEB_SHOT_FENCE else CELEB_SIGUE_ENC
	if _celeb_fov_base > 0.0:
		var vivo0: Vector3 = _celeb_focus.position if (_celeb_focus != null \
				and is_instance_valid(_celeb_focus)) else fp
		_celeb_cam.fov = _celeb_fov_sigue(_celeb_fov_base, _celeb_cam.position.distance_to(
			vivo0 + Vector3(0.0, CELEB_LOOK_H, 0.0)), _celeb_fov_enc)


	if _celeb_lente_h():
		_celeb_cam.fov = _celeb_fov_tumbado(_celeb_cam.fov,
			SceneFade.rect_visible(self).size.y)
		_celeb_centra_tumbado(_chin_par(_celeb_focus.position if (_celeb_focus != null
			and is_instance_valid(_celeb_focus)) else fp))
	_celeb_cam.current = true





	_fx.cam = _celeb_cam
	_celeb_active = true



