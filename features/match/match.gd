func _build_chance_minutes(n: int, first: int = CHANCE_FIRST,
		last: int = CHANCE_LAST) -> Array[int]:
	var out: Array[int] = []
	if n <= 0:
		return out
	if n == 1:


		out.append(randi_range(mini(first + 4, last), maxi(last - 4, first)))
		return out


	var half: int = mini(CHANCE_WINDOW_W / 2, maxi(1,(last - first) / maxi(n, 1)))
	var lo_c: float = float(first + half)
	var span: float = maxf(0.0, float(last - half) - lo_c)
	for i in n:










		var q: float = MatchSim.danger_quantile(float(i) / float(n - 1))
		var c: int = int(round(lo_c + span * q))
		out.append(randi_range(maxi(first, c - half), mini(last, c + half)))
	out.sort()


	for i in range(1, out.size()):
		out[i] = maxi(out[i], out[i - 1] + 2)








	while out.size() > 1 and int(out[out.size() - 1]) > last:
		out.remove_at(out.size() - 1)
	if out.size() == 1:
		out[0] = clampi(int(out[0]), first, last)
	return out






