const TEC_PUNTO_VEL: float = 1.6
var _tec_punto: Vector2 = Vector2.ZERO
var _tec_punto_golpeo: bool = false
var _tec_punto_espera: bool = false


func _tec_punto_tick(wasd: Vector2) -> Vector2:
	var golpeo: bool = _puntero_on()
	if golpeo != _tec_punto_golpeo:
		_tec_punto_golpeo = golpeo
		_tec_punto = Vector2.ZERO
		_tec_punto_espera = wasd != Vector2.ZERO
	if not golpeo:
		return wasd
	if _tec_punto_espera:
		if wasd != Vector2.ZERO:
			return _tec_punto
		_tec_punto_espera = false
	_tec_punto =(_tec_punto + wasd * TEC_PUNTO_VEL * get_process_delta_time()).limit_length(1.0)
	return _tec_punto








var _pad_mantener_on: bool = false
var _pad_mantener_seq: int = -1


func _pad_mantener() -> bool:

	if not Settings.mando_alternar:
		_pad_mantener_on = false
		return Entrada.pulsada("fl_mantener")
	if _pad_mantener_on and _pad_mantener_seq != _chance_seq:
		_pad_mantener_on = false
	if Entrada.recien_pulsada("fl_mantener"):
		_pad_mantener_on = not _pad_mantener_on
		_pad_mantener_seq = _chance_seq
	return _pad_mantener_on





func _pad_suelta() -> void:
	if _stick_finger == PAD_IZQ:
		_stick_suelta()
	if _stick_der_finger == PAD_DER:
		_stick_der_suelta(false)
		_pad_der_espera_neutro = true
	_pad_der_tenia = false
	_pad_der_hist.clear()
	_pad_izq_suelto_ms = -1
	_pad_mantener_on = false
	_pad_objetivo_suelta()


func _pad_izq(eje: Vector2, mantener: bool) -> void:
	var mio: bool = _stick_finger == PAD_IZQ
	if _stick_finger != -1 and not mio:
		return
	var golpeo: bool = _puntero_on()
	var largo: float = eje.length()



	if golpeo != _pad_golpeo_previo:
		_pad_golpeo_previo = golpeo
		_pad_izq_espera_neutro = largo > PAD_SUELTA_ZM
	if _pad_izq_espera_neutro:
		if largo > PAD_SUELTA_ZM:
			eje = Vector2.ZERO
			largo = 0.0
		else:
			_pad_izq_espera_neutro = false


	var empuja: bool = largo >(PAD_SUELTA_ZM if mio else PAD_ZM) \
			or (mantener and not golpeo and not _flip_freeze)
	var ahora: int = Time.get_ticks_msec()
	if empuja or golpeo:
		_pad_izq_suelto_ms = -1
	elif mio and _pad_izq_suelto_ms < 0:
		_pad_izq_suelto_ms = ahora
	var en_gracia: bool = mio and _pad_izq_suelto_ms >= 0 \
			and ahora - _pad_izq_suelto_ms < PAD_GRACIA_MS
	if not _stick_izq_vivo() or not (empuja or golpeo or en_gracia):
		if mio:
			_stick_suelta()
			_pad_izq_suelto_ms = -1
		return




	if not mio and state == State.RESOLVED and not _cobro_corre and not _saque_mando:
		return
	_stick_izq_crea()


	var v: Vector2 = eje.limit_length(1.0) * _stick_recorrido() \
			if largo > PAD_SUELTA_ZM or (golpeo and Entrada.teclado_juega()) else Vector2.ZERO
	_stick_base = _stick_ui.esquina()
	_stick_v = v
	_stick_pinta(_stick_base + v)
	if not mio:
		_pad_salta_demo()
		_stick_finger = PAD_IZQ
		if not golpeo:
			_puntero_posa()
	if golpeo:
		_puntero_aplica(v)


func _pad_der(eje: Vector2) -> void:
	var mio: bool = _stick_der_finger == PAD_DER
	if _stick_der_finger != -1 and not mio:
		return
	if not mio and _pad_der_tenia:

		_pad_der_tenia = false
		_pad_der_espera_neutro = true
		_pad_der_hist.clear()
	var largo: float = eje.length()
	if _pad_der_espera_neutro:
		if largo > PAD_SUELTA_ZM:
			return
		_pad_der_espera_neutro = false
	var ahora: int = Time.get_ticks_msec()
	if not mio:
		if largo <= PAD_ZM:
			return
		if not _stick_der_puede():


			_pad_der_espera_neutro = true
			return


		_pad_salta_demo()
		_stick_der_crea()
		_stick_der_finger = PAD_DER
		_pad_der_tenia = true
		_stick_der_base = _stick_der_ui.esquina()
		_stick_der_v = eje.limit_length(1.0) * _stick_recorrido()
		_stick_der_ctx = _puntero_ctx()
		_pad_der_hist = [[ahora, _stick_der_v]]
		_stick_der_pinta()
		_jala_empieza()
		return
	if largo > PAD_SUELTA_ZM:
		_stick_der_base = _stick_der_ui.esquina()
		_stick_der_v = eje.limit_length(1.0) * _stick_recorrido()
		_pad_der_hist.append([ahora, _stick_der_v])
		while _pad_der_hist.size() > 1 and ahora - int(_pad_der_hist[0][0]) > PAD_PICO_MS:
			_pad_der_hist.pop_front()
		_stick_der_pinta()
		if _jala_on:
			_puntero_mueve()
		return

	var pico: Vector2 = Vector2.ZERO
	for h in _pad_der_hist:
		if ahora - int(h[0]) <= PAD_PICO_MS and (h[1] as Vector2).length() > pico.length():
			pico = h[1]
	_stick_der_v = pico
	if _jala_on:
		_puntero_mueve()
	_pad_der_tenia = false
	_pad_der_hist.clear()
	_stick_der_suelta(true)

















func _pad_boton(b: InputEventJoypadButton) -> bool:
	for accion in PAD_ACCIONES:
		if b.is_action(accion):
			return _pad_accion(accion, b.pressed)
	return false




const PAD_ACCIONES: Array[String] = ["fl_avanza", "fl_modo", "fl_atras", "fl_pausa",
	"fl_camara", "fl_objetivo", "fl_toque"]


func _pad_accion(accion: String, on: bool) -> bool:
	if _festejo_revivido or Entrada.capa_activa() != null:
		return false
	if on and (accion == "fl_avanza" or accion == "fl_modo"):
		_pad_salta_demo()
	if accion == "fl_avanza":
		if _puntero_on():
			if _golpear_ui != null:
				_golpear_ui.pulsado = on
			if on:
				_puntero_patea()
			return true
		if not on:
			return false
		if _intro_cam != null:
			_end_intro()
			return true
		if _spray_corre:
			var dedo: InputEventScreenTouch = InputEventScreenTouch.new()
			dedo.pressed = true
			_spray_input(dedo)
			return true
		if state == State.RESOLVED and _toca_seguir_cabe():
			_next_chance()
			return true







		if _recu and state == State.DUEL and _zonas_h_on():
			_recu_barre()
			return true
		return false
	if accion == "fl_modo":
		if _modo_ui != null:
			_modo_ui.pulsado = on and _modo_on()
		if not on:
			return true


		if _modo_on() or not _zonas_h_on():
			_on_mode_toggle_requested()
		return true
	if not on:
		return false
	if accion == "fl_atras":
		if _stick_der_finger == PAD_DER:
			_stick_der_suelta(false)
			_pad_der_tenia = false
			_pad_der_hist.clear()

			_pad_der_espera_neutro = true
			return true
		if _strike_cancel_cabe():
			_cancel_strike()
			return true
		return false
	if accion == "fl_pausa":
		if _pause_menu != null and is_instance_valid(_pause_menu):
			_pause_menu.open()
		return true
	if accion == "fl_camara":
		_on_cam_focus_requested()
		return true
	if accion == "fl_objetivo":
		return _pad_objetivo_cicla()
	if accion == "fl_toque":
		return _pad_objetivo_ordena()
	return false










func _pad_salta_demo() -> void:
	if _hud == null:
		return
	for child in _hud.get_children():
		if child.is_in_group("gesture_demo") and child.has_method("salta"):
			child.call("salta")










var _pad_objetivo: AnimatedSprite3D = null


func _pad_orden_cabe() -> bool:

	return _zonas_h_on() and state == State.AIMING and not _orders_locked and _am_captain() \
			and _aim_cam != null and is_instance_valid(_aim_cam)



func _pad_objetivos() -> Array:
	var vp: Rect2 = SceneFade.rect_visible(self)
	var en: Array = []
	for a in _teammate_actors:
		if not is_instance_valid(a) or not a.visible \
				or _aim_cam.is_position_behind(a.global_position):
			continue
		var p: Vector2 = _aim_cam.unproject_position(a.global_position)
		if vp.has_point(p):
			en.append([p.x, a])
	en.sort_custom(func(x: Array, y: Array) -> bool: return float(x[0]) < float(y[0]))
	var out: Array = []
	for e in en:
		out.append(e[1])
	return out


func _pad_objetivo_cicla() -> bool:
	if not _pad_orden_cabe():
		return false
	var lista: Array = _pad_objetivos()
	if lista.is_empty():
		_pad_objetivo_suelta()
		return true
	var i: int = lista.find(_pad_objetivo) if is_instance_valid(_pad_objetivo) else -1
	_pad_objetivo_suelta()
	if i + 1 < lista.size():
		_pad_objetivo = lista[i + 1]
		_tag_touched = _pad_objetivo
	UiAudio.pop()
	return true


func _pad_objetivo_ordena() -> bool:
	if not _pad_orden_cabe() or not is_instance_valid(_pad_objetivo) \
			or not _teammate_actors.has(_pad_objetivo):
		return false
	_cycle_order(_pad_objetivo)
	return true





func _pad_objetivo_tick() -> void:
	if _pad_objetivo == null:
		return
	if not is_instance_valid(_pad_objetivo) or not _pad_orden_cabe() \
			or not _teammate_actors.has(_pad_objetivo):
		_pad_objetivo_suelta()
		return
	if _tag_finger == -1:
		_tag_touched = _pad_objetivo




func _pad_objetivo_suelta() -> void:
	if _pad_objetivo == null:
		return
	if _tag_finger == -1 and _tag_touched == _pad_objetivo:
		_tag_touched = null
	_pad_objetivo = null







const ORDEN_MANDO_ALTO: float = 0.9
const ORDEN_MANDO_ANCHO: float = 0.4


func _orden_mando_tick() -> void:
	if _hud == null:
		return
	var cabe: bool = Entrada.pad_juega() and _pad_orden_cabe()
	var junto: Variant = null
	var medio: float = 0.0

	var suelo: Vector3 = Vector3.ZERO
	if cabe and is_instance_valid(_pad_objetivo) and _pad_objetivo.visible:
		suelo = Vector3(_pad_objetivo.global_position.x, 0.0, _pad_objetivo.global_position.z)
