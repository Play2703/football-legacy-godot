func _cano_tal_vez() -> void:


	var practica: bool = _practice_kind == Practice.CANO



	var hoy: bool = _cano_dado_forzado >= 0.0 \
			or (_pre_hoy == PreOcasion.CANO and chance_index >= _pre_desde)
	var permitido: bool = _duel_active and not _cano_vivo \
			and ((_practice_kind.is_empty() and hoy) or practica) \
			and not _tutorial_active and not _shootout_active and not _duel_press \
			and not _duel_open and not _eslalon and not _recu
	var i: int = _cano_victima() if permitido else -1
	if practica:
		_cano_hecho = false
	var dado: float = 0.0 if practica else \
			(_cano_dado_forzado if _cano_dado_forzado >= 0.0 else randf())
	if not Cano.dispara(i >= 0, _cano_hecho, _ctrl_control_norm(), dado):
		return
	_cano_hecho = true
	if not practica:
		_pre_gasta()
	_cano_acto(i)







func _pre_arma() -> void:
	_pre_hoy = PreOcasion.NINGUNA
	_pre_desde = PreOcasion.OCASION_MIN
	_pre_largo_hecho = false
	_pre_clave = ""
	_recep_partido_visto = false


	if not _practice_kind.is_empty() or _tutorial_active or _libre:
		return
	var sem: int = PreOcasion.semilla(Career.world_seed, Career.season_history.size())
	var n: int = Career.season_matches + 1
	_pre_clave = PreOcasion.clave(Career.season_history.size(), n)
	_pre_hoy = PreOcasion.del_partido(sem, n)
	_pre_desde = PreOcasion.desde(sem, n, _chances_this_match)



	if Career.pre_ocasion_gastada == _pre_clave:
		_pre_hoy = PreOcasion.NINGUNA


	if not pre_forzada.is_empty():
		_pre_hoy = pre_forzada
		_pre_desde = pre_desde_forzado if pre_desde_forzado >= 1 else _pre_desde





func _pre_gasta() -> void:
	if not _pre_clave.is_empty():
		Career.pre_ocasion_gastada = _pre_clave






func _pre_largo_toca(i: int) -> bool:
	if _pre_largo_hecho or _shootout_active or i < _pre_desde:
		return false
	if _pre_hoy == PreOcasion.LARGO:
		return true
	return _pre_hoy == PreOcasion.CANO and not _cano_hecho and i >= _chance_minutes.size()




func _cano_victima() -> int:
	var mejor: int = -1
	var mejor_d: float = CANO_ALCANCE_M
	for i in mini(_duel_defs.size(), _duel_def_actors.size()):
		var a: AnimatedSprite3D = SceneFade.vivo(_duel_def_actors[i]) as AnimatedSprite3D
		if not is_instance_valid(a) or not a.visible or not _rival_set.has(a):
			continue
		if _pique_nombre(a).is_empty():
			continue
		var p: Vector2 = _duel_defs[i]
		if p.y >= _duel_pos.y - 0.5:
			continue
		var d: float = p.distance_to(_duel_pos)
		if d < mejor_d:
			mejor_d = d
			mejor = i
	return mejor




func _cano_rumbo() -> Vector2:
	if _cano_f != Vector2.ZERO:
		return _cano_f
	var f: Vector2 = Vector2(0.0, 0.0) - _duel_pos
	return f.normalized() if f.length_squared() > 0.01 else Vector2(0.0, -1.0)








func _cano_sortea() -> void:
	_cano_f = Vector2.ZERO
	var base: Vector2 = _cano_rumbo()
	var giro: float = deg_to_rad(randf_range(- CANO_GIRO_MAX_DEG, CANO_GIRO_MAX_DEG))
	var f: Vector2 = base.rotated(giro)
	if f.y > -0.35:
		f = base
	_cano_f = f.normalized()
	_cano_elastica = randf() < CANO_ELASTICA_P if _cano_elastica_forzada < 0 \
			else _cano_elastica_forzada == 1




	_cano_lado_cam = 1.0 if _cano_elastica else -1.0
	_cano_cam_atras = randf_range(CANO_CAM_ATRAS_M * 0.92, CANO_CAM_ATRAS_M * 1.12)
	_cano_plante = randf_range(CANO_PLANTE_M * 0.85, CANO_PLANTE_M * 1.2)


func _cano_pon(a: AnimatedSprite3D, p: Vector2) -> void:
	if is_instance_valid(a):
		a.position = Vector3(p.x, a.position.y, p.y)


func _cano_balon(p: Vector2, alto: float = 0.0) -> void:
	_ball_field = p
	_ball.position = Vector3(p.x, BALL_VISUAL_D * 0.5 + alto, p.y)




func _cano_espera(gen: int) -> bool:
	await get_tree().process_frame
	return is_inside_tree() and gen == _chance_seq and _duel_active and state == State.DUEL


func _cano_acto(i: int) -> void:
	var gen: int = _chance_seq




	var el: AnimatedSprite3D = SceneFade.vivo(_duel_def_actors[i]) as AnimatedSprite3D
	if el == null:
		return
	var yo: AnimatedSprite3D = _self_actor
	_cano_vivo = true
	_cano_i = i
	_cano_ultimo = ""
	_cano_quien = _pique_nombre(el)
	_cano_nota_falla = false
	_cano_esconde(true)
	_duel_vel = Vector2.ZERO
	_duel_steer = Vector2.ZERO
	_hud.show_hint("")
	_cano_sortea()
	var f: Vector2 = _cano_rumbo()


	var plante: Vector2 = _duel_pos + f * _cano_plante
	var yo0: Vector2 = _duel_pos - f * CANO_CONDUCE_M
	var el0: Vector2 = plante + f * CANO_SALE_M





	var b_pie: Vector2 = _duel_pos + f * CANO_BALON_DELANTE_M \
			- Vector2(- f.y, f.x) * CANO_BALON_IZQ_M


	if _cano_elastica and is_instance_valid(yo):
		b_pie = _cano_elastica_pie(yo)
	_cano_pon(yo, yo0)
	_duel_defs[i] = el0
	_cano_pon(el, el0)
	_cano_balon(yo0 + f * Duel.BALL_FOOT)
	_anim_lock[el] = Time.get_ticks_msec() + 30000
	_play_run(el, Vector3(- f.x, 0.0, - f.y))
	if is_instance_valid(yo):
		_play_run(yo, Vector3(f.x, 0.0, f.y))
	_cano_plano(yo0)


	_espalda_follow()



	_cano_gestos = -1
	_cano_arma(el, yo)
	if not await _cano_espera(gen):
		_cano_suelta(el)
		return



	_cano_rec_t = _rec_t if _rec.armed else -1.0
	var t: float = 0.0
	var ya: Vector2 = yo0
	while t < CANO_LLEGA_S:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		var dt: float = get_process_delta_time()
		t += dt
		var k: float = clampf(t / CANO_LLEGA_S, 0.0, 1.0)
		var q: Vector2 = yo0.lerp(_duel_pos, k)
		var paso: Vector2 =(q - ya) / maxf(dt, 0.001)
		ya = q
		_cano_pon(yo, q)
		_duel_defs[i] = el0.lerp(plante, k)
		_cano_pon(el, _duel_defs[i])

		_cano_balon((q + f * Duel.BALL_FOOT).lerp(b_pie, k * k))
		_ball_roll(paso)
		_cano_plano(q, false)
	_cano_pon(yo, _duel_pos)
	_ball.speed_scale = 1.0
	while _cano_gestos < 0:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
	_face(el, Vector3(- f.x, 0.0, - f.y))
	if is_instance_valid(yo):
		_face(yo, Vector3(f.x, 0.0, f.y))






		if not _cano_pon_pose(yo):
			_cano_quieto(yo, "north")
		elif _cano_elastica:
			b_pie = _cano_elastica_pie(yo)
	_cano_balon(b_pie)



	if not _cano_planta(el):
		_cano_quieto(el, "south")
	_cara(el, "muerde", 2.0)
	_cano_lento(true)
	t = 0.0
	while t < CANO_RESPIRO_S:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		t += get_process_delta_time()
		if is_instance_valid(yo) and yo.animation != _cano_pose():
			_cano_pon_pose(yo)

	var capa: CanvasLayer = CanvasLayer.new()
	capa.layer = CANO_LAYER
	add_child(capa)
	_cano_aro = CanoAro.new()
	capa.add_child(_cano_aro)
	var hueco: Vector3 = Vector3(_duel_defs[i].x, CANO_HUECO_Y, _duel_defs[i].y)
	_cano_centra_aro(hueco)
	var entrada: float = _duel_def_tackles[i] if i < _duel_def_tackles.size() \
			else Duel.NEUTRAL_TACKLE
	var ventana: float = Cano.ventana(_ctrl_control_norm(), entrada, _carry_fatigue)
	_audio.whistle()
	var t0: int = Time.get_ticks_msec()
	t = 0.0
	while t < Cano.T_CIERRE and _cano_aro.toque_t < 0.0:
		if not await _cano_espera(gen):
			_cano_cierra_aro(capa)
			_cano_suelta(el)
			return
		t = float(Time.get_ticks_msec() - t0) / 1000.0

		_cano_centra_aro(hueco)

		if is_instance_valid(yo) and yo.animation != _cano_pose():
			_cano_pon_pose(yo)
		if is_instance_valid(el) and el.animation != _cano_guardia():
			_cano_planta(el)
		if _cano_toque_forzado >= 0.0 and t >= _cano_toque_forzado:
			_cano_aro.t = _cano_toque_forzado
			_cano_aro.toca()
		_cano_aro.pinta(t)
	var res: String = Cano.resultado(_cano_aro.toque_t, ventana)
	_cano_ultimo = res
	_cano_aro.cierra(res)
	_haptic(40 if res == Cano.SALE else 25)



	_cano_elastica = _cano_elastica and _gesto_listo(yo, CANO_ELASTICA) \
			and _gesto_listo(el, CANO_MUERDE)
	if res == Cano.SALE:
		if _cano_elastica:
			await _cano_elastica_pasa(gen, i, el, yo, f)
		else:
			await _cano_pasa(gen, i, el, yo, f)
	else:
		_cano_rec_t = -1.0
		if _cano_elastica:
			await _cano_elastica_falla(gen, i, el, yo, f)
		else:
			await _cano_falla(gen, i, el, yo, f)
	_cano_cierra_aro(capa)





func _cano_tunel_lente() -> void:
	if _cano_cam == null or not _cano_cam.current:
		return
	if _cano_zoom_tw != null and _cano_zoom_tw.is_valid():
		_cano_zoom_tw.kill()
	_cano_zoom_tw = create_tween()
	_cano_zoom_tw.set_ignore_time_scale(true)
	_cano_zoom_tw.tween_property(_cano_cam, "fov", CANO_TUNEL_FOV, 0.9) \
			.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)







func _cano_arma(el: AnimatedSprite3D, yo: AnimatedSprite3D) -> void:


	if _cano_elastica:
		var listas: bool = await _pique_arma([[el, CANO_MUERDE], [yo, CANO_ELASTICA]])
		_cano_gestos = 1 if listas else 0
		await _pique_arma([[el, CANO_CAIDA]])
		return
	var listos: bool = await _pique_arma([[el, CANO_ABRE], [yo, CANO_POSE]])
	_cano_gestos = 1 if listos else 0
	await _pique_arma([[yo, CANO_AUTOPASE], [el, CANO_CAIDA]])






func _cano_balon_en(b0: Vector2, b1: Vector2, t: float) -> Vector2:
	if t < CANO_PASA_S:
		return b0.lerp(b1, maxf(t, 0.0) / CANO_PASA_S)
	var vb: Vector2 =(b1 - b0) / CANO_PASA_S
	return b1 + vb / CANO_BALON_ROCE *(1.0 - exp(- CANO_BALON_ROCE *(t - CANO_PASA_S)))





func _cano_rodeo_en(p0: Vector2, p1: Vector2, lado: Vector2, su_k: float, k: float) -> Vector2:
	var abre: float = sin(PI * clampf(k / su_k * 0.5, 0.0, 1.0)) if k < su_k \
			else sin(PI *(0.5 + 0.5 * clampf((k - su_k) /(1.0 - su_k), 0.0, 1.0)))
	return p0.lerp(p1, k) + lado * CANO_RODEO_M * abre




const CANO_RODEO_N: int = 32
func _cano_rodeo_arco(p0: Vector2, p1: Vector2, lado: Vector2, su_k: float) -> PackedFloat32Array:
	var out := PackedFloat32Array([0.0])
	var ant: Vector2 = p0
	for n in range(1, CANO_RODEO_N + 1):
		var q: Vector2 = _cano_rodeo_en(p0, p1, lado, su_k, float(n) / CANO_RODEO_N)
		out.append(out[n - 1] + q.distance_to(ant))
		ant = q
	return out




func _cano_rodeo_k(arco: PackedFloat32Array, ty: float, dur: float) -> float:
	var a: float = CANO_RODEO_ARRANCA
	var u: float = clampf(ty / maxf(dur, 0.01), 0.0, 1.0)
	var s: float =(u * u /(2.0 * a) if u < a else u - a * 0.5) /(1.0 - a * 0.5)
	var meta: float = s * arco[arco.size() - 1]
	for n in range(1, arco.size()):
		if arco[n] >= meta:
			var tramo: float = maxf(arco[n] - arco[n - 1], 0.0001)
			return (float(n - 1) +(meta - arco[n - 1]) / tramo) / CANO_RODEO_N
	return 1.0



func _cano_pon_pose(yo: AnimatedSprite3D) -> bool:
	var pose: String = _cano_pose()
	if not is_instance_valid(yo) or not _gesto_listo(yo, pose):
		return false
	yo.flip_h = false
	yo.play(pose)
	yo.frame = 0
	yo.pause()
	return true




func _cano_pose() -> String:
	return CANO_ELASTICA if _cano_elastica else CANO_POSE






func _cano_planta(el: AnimatedSprite3D) -> bool:
	var anim: String = _cano_guardia()
	if not is_instance_valid(el) or not _gesto_listo(el, anim):
		return false
	el.flip_h = false
	el.play(anim)
	el.speed_scale = 1.0
	if _cano_elastica:
		el.frame = 0
		el.pause()
	return true


func _cano_guardia() -> String:
	return CANO_MUERDE if _cano_elastica else CANO_ABRE




func _cano_cuadro(a: AnimatedSprite3D, anim: String, k: int) -> void:
	if not is_instance_valid(a):
		return
	if a.animation != anim:
		a.flip_h = false
		a.play(anim)
	a.pause()
	if a.frame != k:
		a.frame = k






func _cano_quieto(a: AnimatedSprite3D, lado: String) -> void:
	if not is_instance_valid(a):
		return
	var anim: String = String(IDLE_ANIM.get(lado, &"idle"))
	if _anim_usable(a, anim):
		a.flip_h = false
		a.play(anim)
		a.speed_scale = 1.0
	else:
		a.pause()


func _cano_centra_aro(hueco: Vector3) -> void:
	var cam: Camera3D = SceneFade.camara_de(self)
	if cam != null and not cam.is_position_behind(hueco):
		_cano_aro.centro = cam.unproject_position(hueco)

		var lado: Vector3 = cam.global_transform.basis.x * CANO_PIERNAS_M
		_cano_aro.hueco_px = maxf(CanoAro.HUECO_PX,
			cam.unproject_position(hueco + lado).distance_to(_cano_aro.centro))
	else:
		_cano_aro.centro = SceneFade.rect_visible(self).size * 0.5





func _cano_lento(on: bool) -> void:
	if _cano_zoom_tw != null and _cano_zoom_tw.is_valid():
		_cano_zoom_tw.kill()
	if on:
		_fx.slowmo(CANO_LENTO)
		return
	_fx.slowmo_off(0.3)




	var juego: Camera3D = _cano_juego
	_cano_juego = null
	if _cano_cam == null or not _cano_cam.current or not is_instance_valid(juego):
		if _cano_cam != null:
			_cano_cam.current = false
		if is_instance_valid(juego):
			juego.current = true
		_cam_base_frame = -1
		return
	var desde: Transform3D = _cano_cam.global_transform
	var fov0: float = _cano_cam.fov
	_cano_zoom_tw = create_tween()
	_cano_zoom_tw.set_ignore_time_scale(true)
	_cano_zoom_tw.tween_method(func(k: float) -> void:
		if is_instance_valid(_cano_cam) and is_instance_valid(juego):
			_cano_cam.global_transform = desde.interpolate_with(juego.global_transform, k)
			_cano_cam.fov = lerpf(fov0, juego.fov, k),
		0.0, 1.0, CANO_VUELTA_S).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	_cano_zoom_tw.tween_callback(func() -> void:
		if _cano_cam != null:
			_cano_cam.current = false
		if is_instance_valid(juego):
			juego.current = true
		_cam_base_frame = -1)





func _cano_mundo(delta: float) -> void:
	_duel_world_step(delta)
	var f: Vector2 = _cano_rumbo()
	var izq: Vector2 = Vector2(- f.y, f.x)
	for j in mini(_duel_defs.size(), _duel_def_actors.size()):
		if j == _cano_i or (j < _duel_def_hold.size() and _duel_def_hold[j] > 0.0):
			continue
		var a: AnimatedSprite3D = SceneFade.vivo(_duel_def_actors[j]) as AnimatedSprite3D
		if not is_instance_valid(a):
			continue
		var d: Vector2 = _duel_defs[j]
		var su_lado: float = 1.0 if (d - _duel_pos).dot(izq) >= 0.0 else -1.0
		var meta: Vector2 = _ball_field + f * CANO_CERCO_M + izq * su_lado * CANO_ABRE_M
		if d.distance_to(meta) < 0.3:
			_face_ball(a)
			continue
		d = d.move_toward(meta, _duel_chase_spd * CANO_TROTE_K * delta)
		_duel_defs[j] = d
		a.position = Vector3(d.x, a.position.y, d.y)
	for m in _duel_mates.size():
		var p: Vector2 = _duel_mates[m]
		var dir: Vector2 = Duel.wide_run(p, Stadium.FIELD_HALF_W) if m == _duel_wide_i \
				else Duel.mate_run(p, _mate_marker(m, p), _ball_field, false)
		p = Duel.step_mate(p, dir, _duel_chase_spd * Duel.MATE_DRIFT_F, delta,
			_duel_onside_z(), _duel_target_z, Stadium.FIELD_HALF_W)
		_duel_mates[m] = p
		if m < _duel_mate_dir.size():
			_duel_mate_dir[m] = dir
		if m < _duel_mate_actors.size() and is_instance_valid(_duel_mate_actors[m]):
			var ma: AnimatedSprite3D = _duel_mate_actors[m]
			ma.position = Vector3(p.x, ma.position.y, p.y)







func _cano_esconde(on: bool) -> void:
	if on:
		_cano_ocultos.clear()
		for n in [_duel_line, _drive_ring]:
			if n != null and is_instance_valid(n) and (n as Node3D).visible:
				(n as Node3D).visible = false
				_cano_ocultos.append(n)
		return
	for n in _cano_ocultos:
		if is_instance_valid(n) and _duel_active:
			n.visible = true
	_cano_ocultos.clear()











func _cano_plano(yo: Vector2, corte: bool = true) -> void:
	if corte:
		if _cano_zoom_tw != null and _cano_zoom_tw.is_valid():
			_cano_zoom_tw.kill()
		_cano_juego = SceneFade.camara_de(self)
		if _cano_juego == null:
			return
		if _cano_cam == null:
			_cano_cam = Camera3D.new()
			add_child(_cano_cam)
	elif _cano_cam == null or not _cano_cam.current:
		return
	_cano_cam.global_transform = _cano_plano_xf(yo)
	_cano_cam.fov = CANO_FOV
	_cano_cam.current = true




func _cano_plano_xf(yo: Vector2) -> Transform3D:
	var f: Vector2 = _cano_rumbo()
	var lado: Vector2 = Vector2(- f.y, f.x)
	var p: Vector2 = yo - f * _cano_cam_atras + lado * CANO_CAM_LADO_M * _cano_lado_cam
	var mira: Vector2 = yo.lerp(_duel_pos + f * _cano_plante, CANO_MIRA_K)
	return Transform3D(Basis(), Vector3(p.x, CANO_CAM_Y, p.y)) \
			.looking_at(Vector3(mira.x, CANO_MIRA_Y, mira.y), Vector3.UP)


func _cano_cierra_aro(capa: CanvasLayer) -> void:
	if is_instance_valid(capa):
		capa.queue_free()
	_cano_aro = null


func _cano_suelta(el: AnimatedSprite3D) -> void:
	_cano_vivo = false
	_cano_i = -1
	_cano_f = Vector2.ZERO
	_cano_esconde(false)
	_cano_lento(false)
	if is_instance_valid(el):
		_anim_lock.erase(el)







func _cano_pasa(gen: int, i: int, el: AnimatedSprite3D, yo: AnimatedSprite3D,
		f: Vector2) -> void:
	var b0: Vector2 = _ball_field
	var b1: Vector2 = _duel_defs[i] + f * CANO_SALIDA_M
	var p0: Vector2 = _duel_pos
	var conduce: Vector2 = f *(CANO_SALIDA_M / CANO_PASA_S)


	var lado: Vector2 = Vector2(- f.y, f.x) * - _cano_lado_cam
	var p1: Vector2 = b1 - f * Duel.BALL_FOOT



	var su_k: float = clampf((_duel_defs[i] - p0).dot(f) / maxf((p1 - p0).dot(f), 0.01),
		0.2, 0.8)
	_stadium.crowd_excite(1.0)
	_stadium.crowd_react("home", "close")
	_audio.ole()


	if _practice_kind.is_empty():
		_bump_rating("cano_sale")


	var con_toque: bool = is_instance_valid(yo) and _gesto_listo(yo, CANO_AUTOPASE)




	var pasa_k: float = clampf((_duel_defs[i] - b0).dot(f) / maxf((b1 - b0).dot(f), 0.01)
		+ CANO_TUNEL_K, 0.2, 0.95)
	var lento: bool = true
	_cano_tunel_lente()
	if con_toque:
		yo.flip_h = false
		yo.play(CANO_AUTOPASE)
		yo.speed_scale = 1.0
	elif is_instance_valid(yo):
		_play_run(yo, Vector3(f.x, 0.0, f.y))

	_cara(el, "rabia", CANO_PASA_S + CANO_RABIA_S)








	var tb: float = -1.0 if con_toque else 0.0
	var ty: float = -1.0 if con_toque else 0.0
	var corre: bool = not con_toque
	var espera: float = 0.0
	var girado: bool = false
	var cae: bool = false
	var bp: Vector2 = b0
	var vb: Vector2 =(b1 - b0) / CANO_PASA_S
	var rodeo_s: float = CANO_RODEO_S
	var arco := PackedFloat32Array()
	while ty < rodeo_s or tb < CANO_PASA_S:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		var dt: float = get_process_delta_time()
		espera += dt
		var cuadro: int = yo.frame if is_instance_valid(yo) and yo.animation == CANO_AUTOPASE else 99

		var tope: bool = espera > CANO_PASA_S * 2.0
		if tb < 0.0 and (cuadro >= CANO_TOQUE_CUADRO or tope):
			tb = 0.0
			_audio.toque(0.6)
		if not corre and (cuadro >= CANO_ARRANCA_CUADRO or tope):
			corre = true
			ty = 0.0



			var v_paso: float = CANO_CONDUCE_M / CANO_LLEGA_S *(1.0 - CANO_RODEO_ARRANCA * 0.5)
			for _vuelta in 3:
				p1 = _cano_balon_en(b0, b1, maxf(tb, 0.0) + rodeo_s) - f * Duel.BALL_FOOT


				su_k = clampf((_duel_defs[i] - p0).dot(f) / maxf((p1 - p0).dot(f), 0.01),
					0.2, 0.8)
				arco = _cano_rodeo_arco(p0, p1, lado, su_k)
				rodeo_s = maxf(CANO_RODEO_S, arco[arco.size() - 1] / v_paso)
			if is_instance_valid(yo):
				_play_run(yo, Vector3(f.x, 0.0, f.y))
		if tb >= 0.0:
			tb += dt
			if lento and tb / CANO_PASA_S >= pasa_k:
				lento = false
				_fx.slowmo_off(CANO_TUNEL_SALE_S)




			bp = _cano_balon_en(b0, b1, tb)
			_ball_roll(conduce if tb < CANO_PASA_S
				else vb * exp(- CANO_BALON_ROCE *(tb - CANO_PASA_S)))
			_cano_balon(bp)
		if ty >= 0.0 and ty < rodeo_s:
			ty += dt

			if arco.is_empty():
				arco = _cano_rodeo_arco(p0, p1, lado, su_k)
			var k: float = _cano_rodeo_k(arco, ty, rodeo_s)
			var q: Vector2 = _cano_rodeo_en(p0, p1, lado, su_k, k)
			_duel_pos = q
			_cano_pon(yo, q)



			if not girado and k > CANO_GIRA_K and is_instance_valid(el):
				girado = true
				cae = _gesto_listo(el, CANO_CAIDA) \
						and _play_dir_gesture(el, "fall", - f, CANO_SUELO_MS)
				if not cae:
					_face(el, Vector3(f.x, 0.0, f.y))
	_duel_pos = p1
	_cano_balon(p1 + f * Duel.BALL_FOOT)
	_cano_pon(yo, p1)
	_ball.speed_scale = 1.0
	_hud.show_message(I18n.t(Cano.ROTULO_SALE), CareerTheme.NAV_YO, 1.4)
	_pique_calienta(_pique_nombre(el))
	_cano_suelta(el)





	_lance_cool[i] = CANO_SUELO_MS / 1000.0
	if cae and is_instance_valid(el):
		_anim_lock[el] = Time.get_ticks_msec() + CANO_SUELO_MS
		if i < _duel_def_hold.size():
			_duel_def_hold[i] = CANO_SUELO_MS / 1000.0





func _cano_falla(gen: int, i: int, el: AnimatedSprite3D, yo: AnimatedSprite3D,
		f: Vector2) -> void:
	var b0: Vector2 = _ball_field
	var plante: Vector2 = _duel_defs[i]

	var izq: Vector2 = - Vector2(- f.y, f.x)
	var golpe: Vector2 = plante - f * CANO_REBOTE_DELANTE_M + izq * CANO_PIERNAS_M
	var b2: Vector2 = _inside_field(golpe + izq * CANO_REBOTE_LADO_M - f * CANO_REBOTE_ATRAS_M)

	var ida: float = maxf(golpe.distance_to(b0) /(CANO_SALIDA_M / CANO_PASA_S), 0.05)
	var con_toque: bool = is_instance_valid(yo) and _gesto_listo(yo, CANO_AUTOPASE)
	_cano_tunel_lente()
	if con_toque:
		yo.flip_h = false
		yo.play(CANO_AUTOPASE)
		yo.speed_scale = 1.0
	var tb: float = -1.0 if con_toque else 0.0
	var espera: float = 0.0
	while true:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		var dt: float = get_process_delta_time()
		espera += dt
		var cuadro: int = yo.frame if is_instance_valid(yo) and yo.animation == CANO_AUTOPASE else 99
		if tb < 0.0 and (cuadro >= CANO_TOQUE_CUADRO or espera > CANO_PASA_S * 2.0):
			tb = 0.0
			_audio.toque(0.6)
		if tb < 0.0:
			continue
		tb += dt
		_cano_balon(b0.lerp(golpe, clampf(tb / ida, 0.0, 1.0)))
		_ball_roll(f *(CANO_SALIDA_M / CANO_PASA_S))
		if tb >= ida:
			break
	await _cano_rebote(gen, i, el, yo, f, golpe, b2)




func _cano_rebote(gen: int, i: int, el: AnimatedSprite3D, yo: AnimatedSprite3D, f: Vector2,
		golpe: Vector2, b2: Vector2) -> void:
	var plante: Vector2 = _duel_defs[i]

	var recoge: Vector2 = b2 + f * Duel.BALL_FOOT
	_audio.toque(0.9)
	_fx.slowmo_off(CANO_TUNEL_SALE_S)
	_fx.shake(CANO_ROBO_SACUDE)
	_haptic(35)
	_audio.cano_bronca()
	_stadium.crowd_boo(MatchAudio.CANO_BRONCA_DUR)
	_cara(el, "alegria", 2.0)
	if is_instance_valid(yo):
		_cara(yo, "rabia", 2.0)
	if is_instance_valid(el):
		_play_run(el, Vector3(recoge.x - plante.x, 0.0, recoge.y - plante.y))
	var tr: float = 0.0
	while tr < CANO_REBOTE_S:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		tr += get_process_delta_time()
		var k: float = ease(clampf(tr / CANO_REBOTE_S, 0.0, 1.0), 0.4)
		_cano_balon(golpe.lerp(b2, k))
		_ball_roll((b2 - golpe) / CANO_REBOTE_S *(1.0 - k))
		_duel_defs[i] = plante.lerp(recoge, k)
		_cano_pon(el, _duel_defs[i])
	if is_instance_valid(el):
		_face(el, Vector3(f.x, 0.0, f.y))
	if is_instance_valid(yo):
		_face(yo, Vector3(b2.x - _duel_pos.x, 0.0, b2.y - _duel_pos.y))
	_ball.speed_scale = 1.0
	var t: float = 0.0
	while t < CANO_DESENLACE_S:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		t += get_process_delta_time()
	_cano_suelta(el)
	_bump(BUMP_ROBO)
	_cano_perdida_vista = true
	_cano_nota_falla = _practice_kind.is_empty()
	_finish_duel(false)







func _cano_elastica_pasa(gen: int, i: int, el: AnimatedSprite3D, yo: AnimatedSprite3D,
		f: Vector2) -> void:
	var c: Dictionary = _cano_elastica_plan(i, f, yo)
	var p0: Vector2 = _duel_pos
	var lado: Vector2 = c["lado"]
	var sale: Vector2 = c["sale"]
	var v: float = c["v"]
	var t_toque: float = c["t_toque"]
	var t_cruce: float = c["t_cruce"]


	var b1: Vector2 = c["hueco"] + sale * CANO_SALIDA_M
	var nudos: Array = [c["nudo"], [t_cruce, c["hueco"], sale * v],
		[t_cruce + 2.0 * CANO_SALIDA_M / v, b1, Vector2.ZERO]]
	var p1: Vector2 = b1 - f * Duel.BALL_FOOT

	var giro: Vector2 = _duel_defs[i] + lado * CANO_ELASTICA_RODEO_M * 1.6 - f * 0.2
	var t_arranca: float = float(CANO_ELASTICA_N) / CANO_ELASTICA_FPS
	var t_cae: float = t_cruce + CANO_MUERDE_CAE_S


	_fx.slowmo(1.0)
	var lento: bool = false
	var tocado: bool = false
	var cruzado: bool = false
	var cayo: bool = false
	var cae: bool = false
	var corre: StringName = &""
	var prev: Vector2 = _ball_field
	var t: float = 0.0
	while t < t_arranca + CANO_RODEO_S:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		var dt: float = get_process_delta_time()
		t += dt
		var cerca: bool = absf(t - t_cruce) < CANO_ELASTICA_LENTO_S
		if cerca != lento:
			lento = cerca
			_fx.slowmo(CANO_ELASTICA_LENTO if lento else 1.0)
		if not tocado and t >= t_toque:
			tocado = true
			_audio.toque(0.6)
		if not cruzado and t >= t_cruce:
			cruzado = true
			_stadium.crowd_excite(1.0)
			_stadium.crowd_react("home", "close")
			_audio.ole()

			if _practice_kind.is_empty():
				_bump_rating("cano_sale")
			_cara(el, "rabia", CANO_PASA_S + CANO_RABIA_S)



		if t < t_cae:
			_cano_cuadro(el, CANO_MUERDE, _cano_muerde_cuadro(t, t_cruce))
		elif is_instance_valid(el):
			if not cayo:
				cayo = true
				cae = _gesto_listo(el, CANO_CAIDA) \
						and _play_dir_gesture(el, "fall", - f, CANO_SUELO_MS)
			if cae:
				el.pause()
				el.frame = mini(CANO_MUERDE_CAE_DESDE + int((t - t_cae) * CANO_ELASTICA_FPS),
					el.sprite_frames.get_frame_count(el.animation) - 1)



		if t < t_arranca:
			_cano_cuadro(yo, CANO_ELASTICA, clampi(int(t * CANO_ELASTICA_FPS), 0,
				CANO_ELASTICA_N - 1))
		else:
			var u: float = clampf((t - t_arranca) / CANO_RODEO_S, 0.0, 1.0)
			u = u * u *(3.0 - 2.0 * u) * 0.7 + u * 0.3
			var q: Vector2 = p0.lerp(giro, u).lerp(giro.lerp(p1, u), u)
			_duel_pos = q
			_cano_pon(yo, q)
			if is_instance_valid(yo):
				if corre == &"":
					_play_run(yo, Vector3(f.x, 0.0, f.y))
					corre = yo.animation
				elif yo.animation != corre:
					yo.play(corre)
		var bp: Vector2 = _cano_elastica_balon(t, c["pies"], nudos)
		_cano_balon(bp)
		_ball_roll((bp - prev) / maxf(dt, 0.001))
		prev = bp

	_duel_pos = p1
	_cano_balon(p1 + f * Duel.BALL_FOOT)
	_cano_pon(yo, p1)
	_ball.speed_scale = 1.0
	_hud.show_message(I18n.t(Cano.ROTULO_SALE), CareerTheme.NAV_YO, 1.4)
	_pique_calienta(_pique_nombre(el))
	_cano_suelta(el)



	_lance_cool[i] = CANO_SUELO_MS / 1000.0
	if cae and is_instance_valid(el):
		_anim_lock[el] = Time.get_ticks_msec() + CANO_SUELO_MS
		if i < _duel_def_hold.size():
			_duel_def_hold[i] = CANO_SUELO_MS / 1000.0






func _cano_elastica_falla(gen: int, i: int, el: AnimatedSprite3D, yo: AnimatedSprite3D,
		f: Vector2) -> void:
	var c: Dictionary = _cano_elastica_plan(i, f, yo)
	var sale: Vector2 = c["sale"]
	var golpe: Vector2 =(c["hueco"] as Vector2) - sale * CANO_ELASTICA_GOLPE_M
	var t_golpe: float = float(c["t_toque"]) \
			+ maxf(golpe.distance_to(c["b0"]) / float(c["v"]), 0.05)
	var nudos: Array = [c["nudo"], [t_golpe, golpe, sale * float(c["v"])]]
	var b2: Vector2 = _inside_field(golpe +(c["der"] as Vector2) * CANO_REBOTE_LADO_M
		- f * CANO_REBOTE_ATRAS_M)
	_fx.slowmo(1.0)
	var tocado: bool = false
	var prev: Vector2 = _ball_field
	var t: float = 0.0
	while t < t_golpe:
		if not await _cano_espera(gen):
			_cano_suelta(el)
			return
		var dt: float = get_process_delta_time()
		t += dt
		if not tocado and t >= float(c["t_toque"]):
			tocado = true
			_audio.toque(0.6)

		var k: int = 0
		if t < float(c["t_toque"]) + CANO_ELASTICA_CIERRA_S and t >= CANO_ELASTICA_LEE_S:
			k = 1
		_cano_cuadro(el, CANO_MUERDE, k)
		_cano_cuadro(yo, CANO_ELASTICA, clampi(int(t * CANO_ELASTICA_FPS), 0,
			CANO_ELASTICA_N - 1))
		var bp: Vector2 = _cano_elastica_balon(minf(t, t_golpe), c["pies"], nudos)
		_cano_balon(bp)
		_ball_roll((bp - prev) / maxf(dt, 0.001))
		prev = bp
	_cano_balon(golpe)
	await _cano_rebote(gen, i, el, yo, f, golpe, b2)








func _cano_elastica_plan(i: int, f: Vector2, yo: AnimatedSprite3D) -> Dictionary:
	var xf: Transform3D = _cano_plano_xf(_duel_pos)
	var der: Vector2 = Vector2(xf.basis.x.x, xf.basis.x.z).normalized()
	var lado: Vector2 = Vector2(- f.y, f.x) * - _cano_lado_cam
	var pies: Array = []
	for b in CANO_ELASTICA_BALON:
		pies.append(_cano_al_suelo(yo, _duel_pos, xf, Vector2(float(b[0]), float(b[1]))))
	var b0: Vector2 = pies[pies.size() - 1]
	var hueco: Vector2 = _duel_defs[i] + der * CANO_ELASTICA_HUECO_M
	var sale: Vector2 =(hueco - b0).normalized()
	var v: float = maxf(hueco.distance_to(b0) / CANO_ELASTICA_CRUZA_S, 0.5)
	var t_toque: float = float(CANO_ELASTICA_N - 1) / CANO_ELASTICA_FPS - CANO_ELASTICA_LATIGO_S
	return {"der": der, "lado": lado, "pies": pies, "b0": b0, "hueco": hueco, "sale": sale,
		"v": v, "t_toque": t_toque, "t_cruce": t_toque + CANO_ELASTICA_CRUZA_S,
		"nudo": [t_toque, b0,(sale + lado * 0.2).normalized() * v]}





func _cano_elastica_balon(t: float, pies: Array, nudos: Array) -> Vector2:
	if t < float(nudos[0][0]):
		var tg: float = maxf(t, 0.0) * CANO_ELASTICA_FPS
		var n: int = pies.size()
		var k: int = clampi(int(tg), 0, n - 1)
		if k == n - 1:
			return pies[k]
		var s: float = tg - float(k)
		return _cano_hermite([0.0, pies[k],(pies[k + 1] - pies[maxi(k - 1, 0)]) * 0.5],
			[1.0, pies[k + 1],(pies[mini(k + 2, n - 1)] - pies[k]) * 0.5],
			CANO_ELASTICA_DERIVA * s * s)
	for j in nudos.size() - 1:
		var a: Array = nudos[j]
		var b: Array = nudos[j + 1]
		if t <= float(b[0]):
			return _cano_hermite(a, b,(t - float(a[0])) /(float(b[0]) - float(a[0])))
	return nudos[nudos.size() - 1][1]



func _cano_hermite(a: Array, b: Array, s: float) -> Vector2:
	var dt: float = float(b[0]) - float(a[0])
	var s2: float = s * s
	var s3: float = s2 * s
	return (a[1] as Vector2) *(2.0 * s3 - 3.0 * s2 + 1.0) \
			+(a[2] as Vector2) * dt *(s3 - 2.0 * s2 + s) \
			+(b[1] as Vector2) *(3.0 * s2 - 2.0 * s3) \
			+(b[2] as Vector2) * dt *(s3 - s2)




func _cano_muerde_cuadro(t: float, t_cruce: float) -> int:
	if t >= t_cruce + CANO_MUERDE_CIERRA_S:
		return 7
	if t >= t_cruce - CANO_MUERDE_RECOMPONE_S:
		return 6
	var k: int = 0
	for par in CANO_MUERDE_T:
		if t >= float(par[0]):
			k = int(par[1])
	return k



func _cano_elastica_pie(yo: AnimatedSprite3D) -> Vector2:
	var b: Array = CANO_ELASTICA_BALON[0]
	return _cano_al_suelo(yo, _duel_pos, _cano_plano_xf(_duel_pos),
		Vector2(float(b[0]), float(b[1])))









func _cano_al_suelo(yo: AnimatedSprite3D, p0: Vector2, xf: Transform3D, px: Vector2) -> Vector2:
	var tam: Vector2 = Vector2(92.0, 92.0)
	var sf: SpriteFrames = yo.sprite_frames
	var anim: StringName = StringName(CANO_ELASTICA) if sf != null \
			and sf.has_animation(CANO_ELASTICA) and sf.get_frame_count(CANO_ELASTICA) > 0 \
			else yo.animation
	if sf != null and sf.has_animation(anim) and sf.get_frame_count(anim) > 0:
		var tex: Texture2D = sf.get_frame_texture(anim, 0)
		if tex != null:
			tam = tex.get_size()
	var e: float = tam.x / 92.0
	var sc: Vector3 = yo.global_transform.basis.get_scale()
	var c: Vector2 = tam * 0.5 if yo.centered else Vector2.ZERO
	var r_px: float = BALL_ART_R /(yo.pixel_size * sc.y * e)
	var lx: float =((px.x + 0.5) * e - c.x + yo.offset.x) * yo.pixel_size * sc.x
	var ly: float =(tam.y - c.y -(px.y + 1.0 - r_px) * e + yo.offset.y) * yo.pixel_size * sc.y
	var der: Vector3 = xf.basis.x
	der = Vector3(der.x, 0.0, der.z).normalized()
	var p: Vector3 = Vector3(p0.x, yo.global_position.y, p0.y) + der * lx + Vector3.UP * ly
	var dir: Vector3 = p - xf.origin
	var arriba: Vector3 = xf.basis.y *(BALL_PAD_PX * BALL_VISUAL_D / 32.0)
	if absf(dir.y) < 0.001:
		return p0 + Vector2(der.x, der.z) * lx
	var q: Vector3 = p + dir *((BALL_VISUAL_D * 0.5 - arriba.y - p.y) / dir.y) + arriba
	return Vector2(q.x, q.z)


























