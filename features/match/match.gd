						else I18n.t("¡AL PALO!"), UiKit.CYAN, 1.4)
					_stadium.crowd_react("home", "close")
					_audio.ooh()
				"over":
					_hud.show_message(I18n.t("¡LA MANDA POR ENCIMA!"), UiKit.CYAN, 1.4)
					_stadium.crowd_react("home", "close")
					_audio.ooh()
				_:
