func _play_half_time_act(extra: bool = false) -> void:


	if (_half_act_shown and not extra) or GameState.readonly_save \
			or not _practice_kind.is_empty():
		return









	if _injured_out:
		return













	var fuera: bool = _hook_al_descanso() and not extra
	var scn: PackedScene = load(HALF_OUT_ACT_SCENE if fuera else HALF_ACT_SCENE) \
			as PackedScene
	if scn == null:
		return
	var act: Ceremony = scn.instantiate() as Ceremony
	if act == null:
		return
	_half_act_shown = true




	var mins: int = match_minute
	if _play_to > _play_from:
		mins = maxi(clampi(match_minute, _play_from, _play_to) - _play_from, 0)
	act.embedded = true
	act.data_override = _payload_descanso(fuera, mins)



	act.data_override.merge(_half_time_ctx(extra))
	if fuera:
		Career.pending_hook_shown = true


	if act.has_signal("postura_tomada"):
		act.connect("postura_tomada", _on_postura_descanso)

	if act.has_signal("trivia_respondida"):
		act.connect("trivia_respondida", _on_trivia_descanso)



	if _audio != null:
		_audio.hush()
	var layer: CanvasLayer = CanvasLayer.new()
	layer.layer = HOOK_ACT_LAYER
	layer.add_child(act)
	add_child(layer)
	await _esperar_acto(act, layer)
	if not is_inside_tree():
		return
	if _audio != null:
		_audio.unhush()







	_update_sim_energy()





func _tick_sub_actors(k: float, anchor: Vector3, run_at: Vector3,
		you_out: bool = false) -> void:




	var walker: AnimatedSprite3D = _sub_you if you_out else _sub_mate
	var runner: AnimatedSprite3D = _sub_mate if you_out else _sub_you



	var kw: float = k * SUB_HURT_PACE if (you_out and _injured_out) else k

	_ondemand_deadline_us = maxi(_ondemand_deadline_us,
		Time.get_ticks_usec() + SUB_ANIM_BUDGET_US)




	if walker != null:




		var p: Vector2
		var leg: Vector2
		if kw < SUB_BEAT_OUT:
			var m: float = clampf(kw / SUB_BEAT_OUT, 0.0, 1.0)
			p = SUB_OUT_FROM.lerp(SUB_OUT_TO, m)
			leg = SUB_OUT_TO - SUB_OUT_FROM
		else:
			var m2: float = clampf((kw - SUB_BEAT_OUT) /(SUB_WALK_END - SUB_BEAT_OUT),
				0.0, 1.0)
			p = SUB_OUT_TO.lerp(SUB_OUT_EXIT, m2)
			leg = SUB_OUT_EXIT - SUB_OUT_TO
		walker.position.x = anchor.x + p.x
		walker.position.z = anchor.z + p.y






		if kw >= SUB_WALK_END:
			_face(walker, Vector3(1.0, 0.0, 0.0))
		else:










			if you_out and _injured_out:
				_play_run(walker, Vector3(leg.x, 0.0, leg.y), "walk_")
			else:
				_play_run(walker, Vector3(leg.x, 0.0, leg.y))

	if runner == null:
		return
	if k < SUB_BEAT_IN:






		if not you_out:
			_face(runner, Vector3(SUB_RUN_DX, 0.0, SUB_RUN_DZ))
		return
	var r: float = clampf((k - SUB_BEAT_IN) /(1.0 - SUB_BEAT_IN), 0.0, 1.0)




	var vmax: float = 1.0 /(1.0 - SUB_RUN_ACCEL * 0.5)
	var s: float
	var v_norm: float
	if r < SUB_RUN_ACCEL:
		s = vmax * r * r /(2.0 * SUB_RUN_ACCEL)
		v_norm = vmax * r / SUB_RUN_ACCEL
	else:
		s = vmax *(r - SUB_RUN_ACCEL * 0.5)
		v_norm = vmax
	runner.position.x = run_at.x + SUB_RUN_DX * s
	runner.position.z = run_at.z + SUB_RUN_DZ * s





	runner.set_meta("pace_run_until", Time.get_ticks_msec() + 250)





	_play_run(runner, Vector3(SUB_RUN_DX, 0.0, SUB_RUN_DZ))






	var v_real: float = v_norm * Vector2(SUB_RUN_DX, SUB_RUN_DZ).length() \
			/((1.0 - SUB_BEAT_IN) * SUB_SCENE_DUR)
	runner.speed_scale = clampf(v_real / RUN_STRIDE_MPS,
		STRIDE_SCALE_MIN, ENTRANCE_ANIM_MAX)










func _wait_or_skip(seconds: float) -> void:
	_sim_skip = false
	var until: int = Time.get_ticks_msec() + int(seconds * 1000.0)
	while Time.get_ticks_msec() < until:



		if _sim_skip or state != State.SIM or not is_inside_tree():
			return
		var t0: int = Time.get_ticks_msec()
		await get_tree().process_frame






		if not is_inside_tree():
			return




		if get_tree().paused:
			until += Time.get_ticks_msec() - t0
			_sim_skip = false





func _apply_sim_event(kind: String, line: Dictionary = {}) -> void:





	_sim_danger = 0.0
	_sim_danger_target = 0.0
	if _stadium != null:
		_stadium.crowd_danger(0.0)
	if _audio != null:
		_audio.danger(0.0)
	if _sim_screen != null:
		_sim_screen.set_danger(0.0)
	match kind:
		"goal_rival":
			rival_goals += 1
			_sync_score()
			_stadium.crowd_react("away", "goal")





			_audio.gol_breve(-8.0)
			_audio.drums()
			_haptic(40)
			_say("gol_rival", 0.0, _historia_npc(line))
		"goal_team":
			team_goals += 1
			_sync_score()
			_stadium.crowd_react("home", "goal")
			_audio.gol_breve(-4.0)
			_haptic(40)
		"near_team", "near_rival":


			_stadium.crowd_react("away" if kind == "near_team" else "home", "close")
			_audio.ooh()
		"card", "injury":


			_audio.whistle()
		"red":



			_audio.whistle()
			_audio.ooh()
			_haptic(30)
		"dorsal":




			_audio.ovation(-3.0)
			_haptic(20)





























func _added_time_for_half() -> int:
	var base: int = 2 + team_goals + rival_goals
	if not GameState.readonly_save:
		base += randi_range(-1, 1)
	return clampi(base, 1, 5)








func _anuncio_parado_kind() -> bool:
	return SetPiece.is_set_piece(_chance_kind) or _chance_kind == "corner"


func _ko_tied() -> bool:
	return not GameState.readonly_save \
			and GameState.knockout_level(GameState.current_fixture(),
			team_goals, rival_goals)




















func _on_pitch_at_end() -> bool:
	var end_min: int = 120 if _extra_time else 90
	return _play_from < end_min and _play_to >= end_min









func _begin_extra_time() -> int:
	_extra_time = true


	_hud.set_stoppage(0, 0)





	_hud.show_message(I18n.t("¡PRÓRROGA! Dos tiempos de 15 minutos."),
		UiKit.GOLD, 2.6)
	print("[ET] prorroga: play_to=%d hooked=%s minuto=%d" % [
		_play_to, _hooked, match_minute])
	_audio.whistle()




	if _play_to < 90 or _hooked or _banca_quieta:
		return 0
	_play_to = 120
	_my_minutes += 30


	var extra: int = 1 if randf() < 0.5 else 2











	var piso: int = match_minute + 2
	if extra == 2:
		_chance_minutes.append(randi_range(mini(maxi(94, piso), 103), 103))
		_chance_minutes.append(randi_range(mini(maxi(107, piso), 117), 117))
	else:
		_chance_minutes.append(randi_range(mini(maxi(96, piso), 114), 114))
	_chances_this_match = _chance_minutes.size()






	_chance_hi = 117
	return extra





func _finish_extra_time() -> void:
	print("[ET] resto de prorroga desde el minuto %d" % match_minute)
	if match_minute < 105:
		await _run_sim_segment(105, true)
		if state != State.SIM:
			return




		_hud.show_message(I18n.t("Fin del primer tiempo extra."),
			Color("f4f1ec"), 1.8)
		await _wait_or_skip(1.2)
		if not is_inside_tree():
			return
		if state != State.SIM:
			return
		await _play_half_time_act(true)
		if state != State.SIM:
			return
	_coach_cierra_tramo = true
	await _run_sim_segment(120, true)

























