	var puesto: Dictionary = cfg
	if _lleva_lamina(puesto):
		puesto = puesto.duplicate()
		puesto["num_lamina"] = true
	_dress_actor(actor, tex, puesto)




	actor.set_meta("look", puesto)
	_laminas_retira(actor)



	_espalda_vestir(actor, puesto)
	_short_vestir(actor, puesto)
	_pecho_vestir(actor, puesto, is_rival)
















func _laminas_retira(actor: AnimatedSprite3D) -> void:
	for tabla in [_espalda, _short]:
		if tabla.has(actor):
			var vieja = tabla[actor]
			if is_instance_valid(vieja):
				vieja.queue_free()
			tabla.erase(actor)
	if _pecho.has(actor):
		for pieza in (_pecho[actor] as Dictionary).values():
			if is_instance_valid(pieza):
				pieza.queue_free()
		_pecho.erase(actor)
	for m in ["lam_esc", "lam_par", "lam_pat", "lam_fab", "lam_cmp", "lam_man", "lam_esp",
			"lam_shn"]:
		if actor.has_meta(m):
			actor.remove_meta(m)





func _lleva_lamina(cfg: Dictionary) -> bool:




	if cfg.has("bib"):
		return false
	return not String(cfg.get("apellido", "")).strip_edges().is_empty() \
			and int(cfg.get("number", 0)) > 0




























var _lamina_rec: Dictionary = {}


func _espalda_vestir(actor: AnimatedSprite3D, cfg: Dictionary) -> void:
	if not _lleva_lamina(cfg):
		return
	_espalda_colgar(actor, cfg, _espalda_receta(actor.sprite_frames, cfg, true))










func _espalda_receta(sf: SpriteFrames, cfg: Dictionary, apunta: bool,
		tela: Array = []) -> Dictionary:




	var rec_key: String = ""
	if sf != null and sf.has_meta("frames_key"):
		rec_key = "esp|" + String(sf.get_meta("frames_key"))
	if not rec_key.is_empty() and _lamina_rec.has(rec_key):
		return _lamina_rec[rec_key]
	var frame: Image = null
	if sf != null and sf.has_animation("idle_back") \
			and sf.get_frame_count("idle_back") > 0:
		var t: Texture2D = sf.get_frame_texture("idle_back", 0)
		if t != null:
			frame = _tela_o_gpu(t, tela)
	var rec: Dictionary = Espalda.receta_para(cfg, frame,
		Espalda.caja("idle_back", 0))

	if apunta and frame != null and not rec_key.is_empty():
		_lamina_rec[rec_key] = rec
	return rec




func _espalda_colgar(actor: AnimatedSprite3D, cfg: Dictionary, rec: Dictionary) -> void:
	var tex: ImageTexture = Espalda.textura(String(cfg["apellido"]),
		int(cfg["number"]), rec)
	if tex == null:
		return
	var lam: Sprite3D = Espalda.nodo(tex)
	_actors.add_child(lam)
	_espalda[actor] = lam




	actor.set_meta("lam_esp", tex)







func _short_vestir(actor: AnimatedSprite3D, cfg: Dictionary) -> void:
	if not _lleva_lamina(cfg):
		return
	_short_colgar(actor, cfg, _short_receta(actor.sprite_frames, cfg, true))



func _short_receta(sf: SpriteFrames, cfg: Dictionary, apunta: bool,
		tela: Array = []) -> Dictionary:




	var rec_key: String = ""
	if sf != null and sf.has_meta("frames_key"):
		rec_key = "sho|" + String(sf.get_meta("frames_key"))
	if not rec_key.is_empty() and _lamina_rec.has(rec_key):
		return _lamina_rec[rec_key]
	var frame: Image = null
	if sf != null and sf.has_animation("idle") \
			and sf.get_frame_count("idle") > 0:
		var t: Texture2D = sf.get_frame_texture("idle", 0)
		if t != null:
			frame = _tela_o_gpu(t, tela)
	var rec: Dictionary = ShortNum.receta_para(cfg, frame,
		ShortNum.caja("idle", 0))
	if apunta and frame != null and not rec_key.is_empty():
		_lamina_rec[rec_key] = rec
	return rec





func _tela_o_gpu(t: Texture2D, tela: Array) -> Image:
	if tela.size() == 2 and tela[1] != null and is_same(tela[0], t):
		return tela[1]
	return KitRecolor.lee_imagen(t, "tela")



func _short_colgar(actor: AnimatedSprite3D, cfg: Dictionary, rec: Dictionary) -> void:
	var tex: ImageTexture = ShortNum.textura(int(cfg["number"]), rec)
	if tex == null:
		return
	var lam: Sprite3D = ShortNum.nodo(tex)
	_actors.add_child(lam)
	_short[actor] = lam


	actor.set_meta("lam_shn", tex)





func _short_follow() -> void:
	if _short.is_empty():
		return
	var cam: Camera3D = SceneFade.camara_de(self)
	for a in sin_muertos(_short):
		if not is_instance_valid(a):
			continue
		var duenio: AnimatedSprite3D = a as AnimatedSprite3D
		if duenio == null:
			continue
		var lam: Sprite3D = SceneFade.vivo(_short[a]) as Sprite3D
		if not is_instance_valid(lam):
			continue




		if not duenio.visible or Pinguinazo.de(duenio) != null:
			lam.visible = false
			continue



		var base: String = PechoRig.base_de(duenio)
		var r: Rect2 = ShortNum.caja_fichero(base) if not base.is_empty() \
				else ShortNum.caja(duenio.animation, duenio.frame)
		ShortNum.seguir(lam, duenio, r, duenio.pixel_size, cam)











func _pecho_visible(actor: AnimatedSprite3D, ver: bool) -> void:
	if not _pecho.has(actor):
		return
	for pieza in (_pecho[actor] as Dictionary).values():
		if is_instance_valid(pieza):
			(pieza as Node3D).visible = ver


func _espalda_follow() -> void:
	if _espalda.is_empty():
		return
	var cam: Camera3D = SceneFade.camara_de(self)
	for a in sin_muertos(_espalda):
		if not is_instance_valid(a):
			continue
		var duenio: AnimatedSprite3D = a as AnimatedSprite3D
		if duenio == null:
			continue
		var lam: Sprite3D = SceneFade.vivo(_espalda[a]) as Sprite3D
		if not is_instance_valid(lam):
			continue






		if not duenio.visible or Pinguinazo.de(duenio) != null:
			lam.visible = false
			continue
		var r: Rect2 = Espalda.caja(duenio.animation, duenio.frame)
		var cx: float = Espalda.centro(duenio.animation, duenio.frame)
		var giro: float = Espalda.giro(duenio.animation, duenio.frame)











		if r.size.x <= 0.0:
			var base: String = PechoRig.base_de(duenio)
			if not base.is_empty():
				r = Espalda.caja_fichero(base)
				cx = Espalda.centro_fichero(base)
				giro = Espalda.giro_fichero(base)
		Espalda.seguir(lam, duenio, r, duenio.pixel_size, cam, cx, giro)
















func _frames_key(tex: Texture2D, cfg: Dictionary) -> String:
	return tex.resource_path + "|" + var_to_str(cfg)










func _cfg_role(tex: Texture2D, cfg: Dictionary) -> String:
	if tex == RIVAL_TEX and cfg == RefKit.cfg_ahora():
		return "ref"
	if tex == TEAM_TEX and cfg == _self_cfg():
		return "self"
	return "npc"






var _evict_cfg_strs: Dictionary = {}


func _actor_frames(tex: Texture2D, cfg: Dictionary, role: String = "") -> SpriteFrames:
	if role.is_empty():
		role = _cfg_role(tex, cfg)
	if tex == RIVAL_TEX:
		_evict_cfg_strs[var_to_str(cfg)] = true
	var key: String = _frames_key(tex, cfg)
	var hit: Variant = _frames_hit(key)
	if hit is SpriteFrames:



		if not _frames_full.has(key):
			_queue_rest(key, hit, tex, cfg, role)


		_atlas_revisa(hit, _frames_full.has(key))
		return hit



	KitRecolor.memo_abre()
	var frames: SpriteFrames = _build_actor_frames(tex, cfg)
	KitRecolor.memo_cierra()
	_frames_put(key, frames)
	_queue_rest(key, frames, tex, cfg, role)
	return frames












func _ensure_anims(tex: Texture2D, cfg: Dictionary, prefix: String) -> void:
	var frames: SpriteFrames = _actor_frames(tex, cfg)
	if _frames_full.has(_frames_key(tex, cfg)):
		return





	var recordar: bool = prefix == "run_" or prefix == "clap"
	if recordar:
		KitRecolor.memo_abre()
	for slice in _anim_slices(tex, "rest"):
		if String(slice["anim"]).begins_with(prefix):
			_fill_anim(frames, slice, cfg)
	if recordar:
		KitRecolor.memo_cierra()





func _queue_rest(key: String, frames: SpriteFrames, tex: Texture2D,
		cfg: Dictionary, role: String = "*") -> void:
	if frames_eager:



		_fill_rest(frames, tex, cfg)
		_frames_full[key] = true

		_atlas_revisa(frames, true)
		return



	if _frames_queued.has(key):
		return
	_frames_queued[key] = true
	_frames_todo.append([frames, tex, cfg, key, role])
	_drain_frames()






func _queue_anim_prioritaria(actor: AnimatedSprite3D, anim: String) -> void:
	if not is_instance_valid(actor) or actor.sprite_frames == null \
			or not actor.has_meta("anim_tex") or not actor.has_meta("anim_cfg"):
		return
	var frames: SpriteFrames = actor.sprite_frames
	var llave: String = "%s|%s" % [frames.get_instance_id(), anim]
	if _frames_priority_queued.has(llave):


		var pendiente: Array = _frames_priority_queued[llave]
		if not is_instance_valid((pendiente[4] as WeakRef).get_ref()):
			pendiente[4] = weakref(actor)
		return
	var tex: Texture2D = actor.get_meta("anim_tex")
	for slice in _anim_slices(tex, "rest", "*"):
		if String(slice["anim"]) != anim:
			continue
		if frames.has_animation(anim) \
				and frames.get_frame_count(anim) >=(slice["paths"] as Array).size():
			return
		var entrada: Array = [frames, slice, actor.get_meta("anim_cfg"), llave,
			weakref(actor)]
		_frames_priority.append(entrada)
		_frames_priority_queued[llave] = entrada


		if not _draining and not _frames_priority_scheduled:
			_frames_priority_scheduled = true
			_drain_frames.call_deferred()
		return




func _clear_anims_prioritarias() -> void:
	_frames_priority.clear()
	_frames_priority_queued.clear()





func _next_anim_prioritaria() -> Array:
	while not _frames_priority.is_empty():
		var entrada: Array = _frames_priority[0]
		var actor: Object =(entrada[4] as WeakRef).get_ref()
		var frames: SpriteFrames = entrada[0]
		var slice: Dictionary = entrada[1]
		var anim: String = slice["anim"]
		if is_instance_valid(actor) and actor is AnimatedSprite3D \
				and actor.is_inside_tree() and actor.sprite_frames == frames \
				and (not frames.has_animation(anim) \
				or frames.get_frame_count(anim) <(slice["paths"] as Array).size()):
			return entrada
		_frames_priority.pop_front()
		_frames_priority_queued.erase(entrada[3])
	return []










func _fill_anim(frames: SpriteFrames, slice: Dictionary, cfg: Dictionary) -> void:
	_open_anim(frames, slice)
	var anim: String = slice["anim"]
	var paths: Array = slice["paths"]
	while frames.get_frame_count(anim) < paths.size():
		_pon_cuadro(frames, anim, paths[frames.get_frame_count(anim)], cfg)









func _pon_cuadro(frames: SpriteFrames, anim: String, path: String, cfg: Dictionary) -> void:
	if not atlas_cuadros:
		frames.add_frame(anim, KitRecolor.apply(load(path), cfg))
		return
	KitRecolor.pon_imagen_en_meta(true)
	var t: Texture2D = KitRecolor.apply(load(path), cfg)
	KitRecolor.pon_imagen_en_meta(false)
	_cuelga_cuadro(frames, anim, t)





func _cuelga_cuadro(frames: SpriteFrames, anim: String, t: Texture2D) -> void:
	frames.add_frame(anim, t)
	if atlas_cuadros and CuadroAtlasScr.de(frames).ofrece(anim, frames.get_frame_count(anim) - 1, t):
		_encola_sello(frames)





func _encola_sello(frames: SpriteFrames) -> void:
	if not is_inside_tree():
		return
	var a: CuadroAtlasScr = CuadroAtlasScr.existente(frames)
	if a == null:
		return
	var id: int = a.get_instance_id()
	if not _sellos_ids.has(id):
		_sellos_ids[id] = true
		_sellos.append([weakref(a), id])

	if not _draining and not _frames_priority_scheduled:
		_frames_priority_scheduled = true
		_drain_frames.call_deferred()









func _atlas_revisa(frames: SpriteFrames, completo: bool) -> void:
	if not atlas_cuadros:
		return
	var a: CuadroAtlasScr = CuadroAtlasScr.existente(frames)
	if a == null:
		return
	if completo:
		a.cierra()
	if not a.hay_pagina():
		return
	if frames_eager:
		a.sella_todo()
		return
	_encola_sello(frames)




func _sella_uno() -> bool:
	while not _sellos.is_empty():
		var e: Array = _sellos[0]
		var a: CuadroAtlasScr =(e[0] as WeakRef).get_ref() as CuadroAtlasScr
		if a == null or not a.hay_pagina():
			_sellos.pop_front()
			_sellos_ids.erase(e[1])
			continue
		var t0: int = Time.get_ticks_usec()
		a.sella_una()
		_sello_last_us = maxi(1, int(Time.get_ticks_usec() - t0))
		if not a.hay_pagina():
			_sellos.pop_front()
			_sellos_ids.erase(e[1])
		return true
	return false




func _open_anim(frames: SpriteFrames, slice: Dictionary) -> bool:
	if frames.has_animation(slice["anim"]):
		return false
	frames.add_animation(slice["anim"])
	frames.set_animation_loop(slice["anim"], bool(slice["loop"]))
	frames.set_animation_speed(slice["anim"], float(slice["fps"]))
	return true


func _fill_rest(frames: SpriteFrames, tex: Texture2D, cfg: Dictionary) -> void:
	for slice in _anim_slices(tex, "rest"):
		_fill_anim(frames, slice, cfg)
















func _drain_frames() -> void:





	_frames_priority_scheduled = false
	if _draining or _intro_cam != null or not is_inside_tree():
		return
	_draining = true
	var spent: int = Time.get_ticks_usec()


	var job: Array = []
	var slices: Array[Dictionary] = []
	var slice_i: int = 0









	var sin_sello: int = 0


	var pidio: bool = false
	while true:
		var ceder: bool = false
		var urgente: Array = _next_anim_prioritaria()





		if _dh_lote != null and state != State.SIM:
			_dh_suelta(false)

		if _pe_lote != null and (state != State.SIM or not urgente.is_empty()):
			_pe_lote.cancela = true
		var frames: SpriteFrames
		var slice: Dictionary
		var cfg: Dictionary
		if ceder:
			pass
		elif not urgente.is_empty():
			frames = urgente[0]
			slice = urgente[1]
			cfg = urgente[2]
		else:


			while true:
				if job.is_empty():
					if _frames_todo.is_empty():


						if not _sellos.is_empty():
							ceder = true
							break


						_dh_suelta(false)
						if PerfContadores.activo:
							PerfContadores.dren_us += Time.get_ticks_usec() - spent
						_draining = false
						return
					job = _frames_todo.pop_front()
					_frames_queued.erase(job[3])
					if _frames_full.has(job[3]):
						job = []
						continue


					var role: String = String(job[4]) if job.size() > 4 else "*"
					slices = _anim_slices(job[1], "rest", role)
					slice_i = 0
				frames = job[0]
				cfg = job[2]
				while slice_i < slices.size():
					slice = slices[slice_i]
					var nombre: String = slice["anim"]
					if not frames.has_animation(nombre) \
							or frames.get_frame_count(nombre) <(slice["paths"] as Array).size():
						break
					slice_i += 1
				if slice_i < slices.size():
					break
				_frames_full[job[3]] = true

				_atlas_revisa(frames, true)
				job = []





		var por_hilo: bool = not ceder and urgente.is_empty() and _dh_toca(cfg)



		if not por_hilo and not ceder and urgente.is_empty() and _pe_lote != null:
			if _pe_lote.vivo():
				ceder = true
			else:
				_pe_suelta(false)
		if por_hilo:
			var r: int = _dh_paso(job, slices, slice_i, frames, cfg)
			pidio = pidio or r < 0
			if r > 0 and Time.get_ticks_usec() - spent < DRAIN_BUDGET_US:
				continue
		elif not ceder:
			_open_anim(frames, slice)
			var anim: String = slice["anim"]
			var paths: Array = slice["paths"]
			var t_cuadro: int = Time.get_ticks_usec()
			_pon_cuadro(frames, anim, paths[frames.get_frame_count(anim)], cfg)
			_mide_cuadro(int(Time.get_ticks_usec() - t_cuadro))


			if Time.get_ticks_usec() - spent + _drain_last_us < DRAIN_BUDGET_US:
				continue
		if not _sellos.is_empty():
			if sella_en_tick(ceder, sin_sello, int(Time.get_ticks_usec() - spent),
					_sello_last_us, not _frames_priority.is_empty()):




				var con_hilo: bool =(_dh_lote != null and _dh_lote.vivo()) \
						or (_pe_lote != null and _pe_lote.vivo())
				if con_hilo and not KitRecolor.candado.try_lock():
					KitRecolor.pide_paso_principal()
					pidio = true
					sin_sello += 1
				else:
					_sella_uno()
					sin_sello = 0
					if con_hilo:
						KitRecolor.candado.unlock()
			else:
				sin_sello += 1


		if (_dh_lote != null or _pe_lote != null) and not pidio:
			KitRecolor.suelta_paso_principal()


		if PerfContadores.activo:
			PerfContadores.dren_us += Time.get_ticks_usec() - spent
		await get_tree().process_frame
		if not is_instance_valid(self) or not is_inside_tree():
			return
		pidio = false









		var esperados: int = 1
		while drenado_espera(esperados, _coste_drenado(),
				_frames_priority.is_empty() and _drenado_balon_vivo(),
				get_process_delta_time()):
			esperados += 1
			await get_tree().process_frame
			if not is_instance_valid(self) or not is_inside_tree():
				return
		spent = Time.get_ticks_usec()













func _dh_toca(cfg: Dictionary) -> bool:
	var si: bool = dren_en_hilo and not _dh_fallo and state == State.SIM and not frames_eager \
			and not bool(cfg.get("chamarra", false)) and not SceneFade.hilo_porteros_vivo()
	if not si and _dh_lote != null:
		_dh_suelta(false)
	return si












func _dh_paso(job: Array, slices: Array[Dictionary], slice_i: int, frames: SpriteFrames,
		cfg: Dictionary) -> int:
	var llave: String = String(job[3])


	if _pe_lote != null:
		if _pe_lote.vivo():
			return 0
		_pe_suelta(false)
	if _dh_lote != null and (_dh_job != llave or _dh_frames != frames or _dh_lote.cancela):
		_dh_suelta(false)
		if _dh_lote != null:
			return 0
	if _dh_lote == null:


		if _pe_turno and _pe_lanza():
			return 0
		_pe_turno = true
		_dh_lanza(llave, frames, slices, slice_i, cfg)
		return 0
	var listos: int = _dh_lote.listos()
	var nuevos: int = listos - _dh_hechos
	if nuevos <= 0:
		if not _dh_lote.vivo():


			_dh_suelta(false)
		return 0
	if _dh_lote.vivo() and nuevos < mini(DH_TANDA, _dh_destinos.size() - _dh_hechos):
		return 0
	if not KitRecolor.candado.try_lock():
		KitRecolor.pide_paso_principal()
		return -1
	var n: int = 0
	while _dh_hechos < listos:
		var d: Array = _dh_destinos[_dh_hechos]
		var sl: Dictionary = d[0]
		var i: int = int(d[1])
		var anim: String = sl["anim"]
		var cuenta: int = frames.get_frame_count(anim) if frames.has_animation(anim) else 0
		if cuenta < i:
			_dh_lote.cancela = true
			break
		var t: Texture2D = _dh_lote.tex(_dh_hechos)







		if t == null and cuenta == i:
			_dh_fallo = true
			_dh_lote.cancela = true
			break
		_dh_hechos += 1
		n += 1
		if cuenta == i and t != null:
			_open_anim(frames, sl)
			_cuelga_cuadro(frames, anim, t)
			dren_hilo_cuadros += 1
		elif cuenta > i and t != null and not is_same(frames.get_frame_texture(anim, i), t) \
				and not _dh_tex_luego(t, listos):






			KitRecolor.suelta(t)
	KitRecolor.candado.unlock()


	if _dh_hechos >= _dh_destinos.size():
		_dh_suelta(true)
	return n




func _dh_tex_luego(t: Texture2D, listos: int) -> bool:
	for j in range(_dh_hechos, listos):
		if is_same(_dh_lote.tex(j), t):
			return true
	return false








func _dh_lanza(llave: String, frames: SpriteFrames, slices: Array[Dictionary], slice_i: int,
		cfg: Dictionary) -> void:



	if _dh_fallo:
		return
	var lote: DrenHiloScr = DrenHiloScr.new()
	var destinos: Array = []
	var copia: Dictionary = cfg.duplicate(true)
	for s in range(slice_i, slices.size()):
		var sl: Dictionary = slices[s]
		var anim: String = sl["anim"]
		var paths: Array = sl["paths"]
		var desde: int = frames.get_frame_count(anim) if frames.has_animation(anim) else 0
		for i in range(desde, paths.size()):
			lote.unidades.append([String(paths[i]), copia, atlas_cuadros])
			destinos.append([sl, i])
	if lote.unidades.is_empty():
		return
	if not lote.arranca():
		_dh_fallo = true
		return
	_dh_lote = lote
	_dh_job = llave
	_dh_frames = frames
	_dh_destinos = destinos
	_dh_hechos = 0
	dren_hilo_lotes += 1






func _dh_suelta(esperar: bool) -> void:
	if _dh_lote == null:
		return
	if esperar:
		_dh_lote.espera(true)
	else:
		_dh_lote.cancela = true
		if _dh_lote.vivo():
			return
		_dh_lote.espera(false)
	_dh_lote = null
	_dh_job = ""
	_dh_frames = null
	_dh_destinos = []
	_dh_hechos = 0





func _pe_puede() -> bool:
	return _pe_hilo_ok() and not _pe_espera_montaje and _frames_priority.is_empty()




func _pe_hilo_ok() -> bool:
	return dren_en_hilo and not _dh_fallo and state == State.SIM and not frames_eager \
			and _intro_cam == null and not SceneFade.hilo_porteros_vivo()







func _pe_tick() -> void:
	if _pe_lote != null:
		if _pe_lote.vivo():
			if not _pe_puede():
				_pe_lote.cancela = true
			elif not _draining and _frames_todo.is_empty():





				KitRecolor.suelta_paso_principal()
			return
		_pe_suelta(false)
		return
	if _draining or not _frames_todo.is_empty():
		return
	if _dh_lote != null:
		_dh_suelta(false)
		if _dh_lote != null:
			return
	_pe_lanza()






func _pe_lanza() -> bool:
	if _pe_lote != null or _dh_lote != null:
		return false
	for s in ["medico_0", "medico_1", "seguridad_0", "seguridad_1"]:
		var semilla: String = s
		var medico: bool = semilla.begins_with("medico_")
		if (_medic_frames_cache if medico else _guard_frames_cache).has(semilla) \
				or _pe_fallo.has(semilla) or (not medico and not _pe_foto_posible()):
			continue
		if not _pe_puede():
			return false


		var cara: Dictionary = Coach.look_de(semilla).duplicate(true)
		var lote: DrenHiloScr = DrenHiloScr.new()
		for a in (_medic_anims() if medico else _guard_anims()):
			for ruta in a[3]:
				lote.unidades.append([String(ruta), cara, false])
		if not lote.arranca():
			_dh_fallo = true
			return false
		_pe_lote = lote
		_pe_semilla = semilla

		_pe_turno = semilla == "medico_0"
		return true
	return false



func _pe_medico_frio() -> bool:
	for s in ["medico_0", "medico_1"]:
		if not _medic_frames_cache.has(s) and not _pe_fallo.has(s):
			return true
	return false








func _pe_foto_posible() -> bool:
	if _force_fan_photo:
		return true
	if _pe_foto < 0:
		_pe_foto = 1 if not _tutorial_active and fan_photo_ok(FAN_PHOTO_KINDS[0],
			FAN_PHOTO_MIN_MINUTE, GameState.current_fixture(), GameState.player_div(),
			Career.fan_photo_seen, _practice_kind, GameState.readonly_save) else 0
	return _pe_foto == 1









func _pe_monta_fin() -> void:
	_pe_espera_montaje = false
	if _dh_lote != null and _pe_medico_frio() and _pe_hilo_ok():
		_dh_lote.cancela = true
		_pe_turno = true






func _pe_suelta(esperar: bool) -> void:
	if _pe_lote == null:
		return
	if not esperar and _pe_lote.vivo():
		_pe_lote.cancela = true
		return
	_pe_lote.espera(esperar)
	var lote: DrenHiloScr = _pe_lote
	var semilla: String = _pe_semilla
	_pe_lote = null
	_pe_semilla = ""
	if lote.listos() < lote.unidades.size():
		return
	var medico: bool = semilla.begins_with("medico_")
	var cache: Dictionary = _medic_frames_cache if medico else _guard_frames_cache
	if cache.has(semilla):
		return


	var frames: SpriteFrames = SpriteFrames.new()
	var i: int = 0
	for a in (_medic_anims() if medico else _guard_anims()):
		var anim: String = a[0]
		frames.add_animation(anim)
		frames.set_animation_speed(anim, float(a[1]))
		frames.set_animation_loop(anim, bool(a[2]))
		for _ruta in a[3]:
			var t: Texture2D = lote.tex(i)
			i += 1
			if t == null:
				_pe_fallo[semilla] = true
				return
			frames.add_frame(anim, t)
	cache[semilla] = frames
	personal_hilo_hechos += 1







static func sella_en_tick(sin_cuadro: bool, sin_sello: int, gastado_us: int, sello_us: int,
		gesto_esperando: bool) -> bool:
	if gesto_esperando:
		return false
	return sin_cuadro or sin_sello + 1 >= ATLAS_SELLO_CADA \
			or gastado_us + sello_us < DRAIN_BUDGET_US












static func drenado_espera(esperados: int, coste_us: int, balon_vivo: bool,
		delta_s: float) -> bool:
	if esperados < respiro_drenado(coste_us, balon_vivo):
		return true
	return esperados <= DRAIN_RELIEF_MAX and delta_s > DRAIN_RELIEF_S









static func respiro_drenado(coste_us: int, balon_vivo: bool) -> int:
	if not balon_vivo or coste_us <= DRAIN_COSTE_ALTO_US:
		return 1
	return clampi(ceili(float(coste_us) / float(DRAIN_BUDGET_US)), 1, DRAIN_RESPIRO_TOPE)








static func presupuesto_precalentado(coste_us: int, android: bool) -> int:
	if not android and coste_us <= DRAIN_COSTE_ALTO_US:
		return WARM_BUDGET_US
	return clampi(2 * coste_us + 500, WARM_BUDGET_US, WARM_BUDGET_LENTO_US)





static func coste_robusto(hist: PackedInt32Array) -> int:
	if hist.is_empty():
		return 0
	var orden: PackedInt32Array = hist.duplicate()
	orden.sort()
	return orden[(orden.size() - 1)>>1]




func _mide_cuadro(us: int) -> void:
	_drain_last_us = maxi(1, us)
	_drain_hist.append(_drain_last_us)
	if _drain_hist.size() > DRAIN_HIST_N:
		_drain_hist.remove_at(0)


func _coste_drenado() -> int:
	return coste_robusto(_drain_hist)




func _warm_presupuesto() -> int:
	return presupuesto_precalentado(_coste_drenado(), OS.has_feature("android"))







func _drenado_balon_vivo() -> bool:
	if not is_inside_tree() or get_tree().paused:
		return false
	return state == State.STRIKING or state == State.RUNUP \
			or state == State.FLIGHT or state == State.PASSING or state == State.DUEL

















