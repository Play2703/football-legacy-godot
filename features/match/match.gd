func _todos_actores() -> Array:






	if not is_same(_todos_src_m, _teammate_actors) \
			or not is_same(_todos_src_r, _rival_actors) \
			or _teammate_actors.size() != _todos_nm \
			or _rival_actors.size() != _todos_nr:
		_todos_src_m = _teammate_actors
		_todos_src_r = _rival_actors
		_todos_nm = _teammate_actors.size()
		_todos_nr = _rival_actors.size()
		_todos_c = _teammate_actors + _rival_actors
	return _todos_c



















