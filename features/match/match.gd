		dir = _ball_field - _recu_yo
	if dir.length() < 0.01:
		return Vector2.ZERO
	return dir.normalized()






















func _recu_barrida_llega() -> bool:
	return _recu_barrida_holgura() <= RECU_BARRE_BALON_R - RECU_AVISO_MARGEN





func _recu_barrida_holgura() -> float:
	if _recu_over or _recu_tiro or _recu_pase or _recu_suelta or _recu_zanc_t > 0.0 \
			or _recu_yo_barr > 0.0 or _recu_yo_suelo > 0.0 or _recu_yo_bcd > 0.0:
		return INF
	var dir: Vector2 = _recu_barre_rumbo()
	if dir == Vector2.ZERO or _recu_defs.is_empty():
		return INF
	var mi_spd: float = Duel.run_speed(_ctrl_speed_norm()) * _puddle_slow(_recu_yo)
	var v0: float = mi_spd * Recupera.BARRIDA_SPD
	var tf: float = Recupera.BARRIDA_T




	var dt: float = 1.0 / float(maxi(Engine.physics_ticks_per_second, 1))
	var pasos: int = ceili(tf / dt) - 1




	var lejos: float = v0 * tf * 0.5 + RECU_BARRE_BALON_R \
			+ 2.0 *(Duel.BALL_FOOT + Duel.BALL_LEAD * Recupera.TOQUE_F_MAX) \
			+ mi_spd * Recupera.PACE_LIBRE.y * Recupera.ARRANCA_MULT * tf
	if _recu_yo.distance_to(_ball_field) > lejos:
		return INF










	var defs: Array = _recu_defs.duplicate()
	var paso: Dictionary = {"p": _recu_pos, "v": _recu_vel, "armed": _recu_car_armed,
		"recov": _recu_car_recov, "arr_t": _recu_arranca_t, "cerca_prev": _recu_cerca_prev}
	var mejor: float = _recu_yo.distance_to(_ball_field)








	var umbral: float = RECU_BARRE_BALON_R - RECU_AVISO_MARGEN
	for k in range(1, pasos + 1):
		if mejor <= umbral:
			break






		var yo: Vector2 = _recu_yo + dir *(v0 * dt
			*(float(k) - float(k *(k + 1)) * 0.5 * dt / tf))
		defs[0] = yo
		_recu_portador_paso(paso, defs, mi_spd, dt)
		mejor = minf(mejor, yo.distance_to(paso["bola"]))
		if mejor <= umbral:
			break


		if mejor <= RECU_BARRE_BALON_R:
			continue
		var su_v: Vector2 = paso["v"]
		var su_rumbo: Vector2 = su_v.normalized() if su_v.length() > 0.3 \
				else Vector2(0.0, Recupera.DIR)
		if dir.dot(su_rumbo) > 0.2 \
				and yo.distance_to(paso["p"]) <= RECU_BARRE_CUERPO_R + RECU_AVISO_MARGEN:
			return INF
	return mejor




func _recu_aviso_step() -> void:
	_recu_aviso_on = _recu_barrida_llega()
	if _recu_aviso_on:
		if not _recu_aviso_hecho:
			_recu_aviso_hecho = true
			_haptic(RECU_AVISO_MS)
		return
	if _recu_aviso_hecho:
		var alcance: float = Duel.run_speed(_ctrl_speed_norm()) * Recupera.BARRIDA_SPD \
				* Recupera.BARRIDA_T * 0.5
		if _recu_yo.distance_to(_ball_field) > alcance + RECU_BARRE_BALON_R + RECU_AVISO_REARMA:
			_recu_aviso_hecho = false


func _recu_barre() -> void:
	if _recu_over or _recu_tiro or _recu_zanc_t > 0.0 \
			or _recu_yo_barr > 0.0 or _recu_yo_suelo > 0.0 \
			or _recu_yo_bcd > 0.0:
		return
	var dir: Vector2 = _recu_barre_rumbo()
	if dir == Vector2.ZERO:
		return
	_recu_yo_bdir = dir
	_recu_yo_barr = Recupera.BARRIDA_T
	_recu_yo_bcd = Recupera.BARRIDA_CD_YO
	_recu_barridas += 1
	_recu_yo_b_aviso = _recu_aviso_on
	if _recu_aviso_on:
		_recu_barridas_aviso += 1

	_recu_aviso_hecho = false


	_recu_yo_barr_cobrada = false


	var alcance: float = Duel.run_speed(_ctrl_speed_norm()) * Recupera.BARRIDA_SPD \
			* Recupera.BARRIDA_T * 0.5
	var hasta: Vector2 = _recu_yo + _recu_yo_bdir * alcance
	_recu_surco(Vector3(_recu_yo.x, 0.0, _recu_yo.y),
		Vector3(hasta.x, 0.0, hasta.y), Recupera.BARRIDA_T)
	if is_instance_valid(_self_actor):





















		_ondemand_deadline_us = Time.get_ticks_usec() + RECU_BARRIDA_BUDGET_US
		_play_dir_gesture(_self_actor, "slide", _recu_yo_bdir,
			int((Recupera.BARRIDA_T + Recupera.BARRIDA_SUELO) * 1000.0))

		_splash_at(_recu_yo, Vector3(_recu_yo_bdir.x, 0.0, _recu_yo_bdir.y), 20.0)




































	_haptic(14)












func _recu_barre_resuelve() -> void:


	if _recu_over or _recu_tiro or _recu_saque_vel != Vector2.ZERO:
		return






	if _recu_yo_barr_cobrada:
		return
	if _recu_yo.distance_to(_ball_field) <= RECU_BARRE_BALON_R:


		_recu_yo_barr_cobrada = true
		_recu_limpias += 1
		if _recu_yo_b_aviso:
			_recu_limpias_aviso += 1
		_recu_pase = false
		_recu_suelta = true
		_recu_barrida_buena_t = RECU_BARRE_VENTANA
		_recu_rival_suelo = RECU_RIVAL_SUELO_T





		_recu_tumba_portador(_recu_yo_bdir)
		_recu_vel = Vector2.ZERO
		_ball_vel = _recu_yo_bdir * RECU_BARRE_DESPEJE_V
		_recu_pase_desde = _ball_field
		_recu_ultimo_toque = -1
		_haptic(20)
		_audio.kick()
