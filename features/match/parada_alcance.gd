extends RefCounted






















































const TOLERANCIA: float = 0.07




const REPITE: float = 0.04
const BALL_R: float = 0.21

const NODO_SOBRE_CESPED: float = 37.0 * 1.78 / 65.0





static func hueco(vista: String, encaje: float, x: float, y: float, r: float = BALL_R,
		k: float = 1.0) -> float:
	if not CAJAS.has(vista):
		return INF
	var c: Array = CAJAS[vista]
	var d2: float = INF
	for i in range(0, c.size(), 4):
		var dx: float = maxf(maxf(c[i] - x, x - c[i + 2]), 0.0)
		var dy: float = maxf(maxf(c[i + 1] + encaje - y, y -(c[i + 3] + encaje)), 0.0) * k
		d2 = minf(d2, dx * dx + dy * dy)
	return maxf(sqrt(d2) - r, 0.0)




static func _proy(p: Vector3, cam: Vector3, bas: Basis) -> Vector2:
	var d: Vector3 = p - cam
	return Vector2(d.dot(bas.x), d.dot(bas.y)) / maxf(- d.dot(bas.z), 0.001)











static func hueco_visto(vista: String, encaje: float, flip: bool, suelo: Vector3, bola: Vector3,
		r: float, cam: Vector3, bas: Basis) -> float:
	var lado: float = -1.0 if flip else 1.0
	var der: Vector3 = Vector3(bas.x.x, 0.0, bas.x.z)
	var nor: Vector3 = Vector3(bas.z.x, 0.0, bas.z.z)
	if not cam.is_finite() or der.length_squared() < 1e-08 or nor.length_squared() < 1e-08:
		return hueco(vista, encaje,(bola.x - suelo.x) * lado, bola.y - suelo.y, r)
	der = der.normalized()
	nor = nor.normalized()
	var d: Vector3 = bola - cam
	var den: float = d.dot(nor)
	if absf(den) < 0.0001:
		return hueco(vista, encaje,(bola.x - suelo.x) * lado, bola.y - suelo.y, r)
	var bp: Vector3 = cam + d *((suelo - cam).dot(nor) / den)


	var n1: Vector3 = suelo + Vector3(0.0, 1.0, 0.0)
	var s0: Vector2 = _proy(n1, cam, bas)
	var ux: float =(_proy(n1 + der, cam, bas) - s0).length()
	var uy: float =(_proy(n1 + Vector3.UP, cam, bas) - s0).length()
	if ux < 1e-06:
		return hueco(vista, encaje,(bola.x - suelo.x) * lado, bola.y - suelo.y, r)
	var sb: Vector2 = _proy(bola, cam, bas)
	var rs: float =(_proy(bola + bas.x * r, cam, bas) - sb).length() / ux
	return hueco(vista, encaje,(bp - suelo).dot(der) * lado, bp.y - suelo.y, rs, uy / ux)



static func llega(h: float, tol: float = TOLERANCIA) -> bool:
	return h == INF or h <= tol




static func alguno_llega(grupo: Array, huecos: Dictionary, tol: float = TOLERANCIA) -> bool:
	for v in grupo:
		if huecos.has(v) and float(huecos[v]) <= tol:
			return true
	return false






















static func bombo(grupo: Array, base: String, ultima: String, huecos: Dictionary,
		tol: float = TOLERANCIA, repite: float = REPITE) -> Array:
	var cand: Array = []
	for v in grupo:
		if llega(float(huecos.get(v, INF)), tol):
			cand.append(v)
	if cand.is_empty():

		var mejor: String = ""
		var h_mejor: float = INF
		for v: String in grupo:
			var h: float = float(huecos.get(v, INF))
			if mejor.is_empty() or h < h_mejor - 1e-06 or (absf(h - h_mejor) <= 1e-06 and v == base):
				mejor = v
				h_mejor = h
		if mejor.is_empty():
			return []
		cand.append(mejor)
	var pool: Array = []
	for v in cand:
		if v != ultima:
			pool.append(v)
	if not pool.is_empty():
		return pool

	var lim: float = maxf(tol, float(huecos.get(cand[0], INF))) + repite
	for v in grupo:
		if v != ultima and float(huecos.get(v, INF)) <= lim:
			pool.append(v)
	return pool if not pool.is_empty() else cand







