	return Liguilla.campeones_cruce(String(fila.get("champion_ap", "")),
		String(fila.get("champion", "")), fila.get("anual", []))





func _campeon_de_campeones(pais: String, temporada: int) -> String:
	var cruce: Array = campeones_de(pais, temporada - 1)
	if cruce.size() < 2:
		return ""
	var mio: Dictionary = GameState.campeones_state
	if int(mio.get("season", -1)) == temporada and cruce.has(String(mio.get("a", ""))) \
			and cruce.has(String(mio.get("b", ""))):
		return String(mio.get("winner", ""))
	return SimLeague.campeones_partido(String(cruce[0]), String(cruce[1]), temporada)







func supercopa_de(pais: String, temporada: int) -> Array:
	if not SupercopaNacional.aplica(pais):
		return []
	var fila: Dictionary = _fila_liga(pais, temporada)



	if fila.is_empty() and temporada == 0:
		return SupercopaNacional.semilla_t0(pais)
	return _cruce_supercopa(pais, fila)




func _cruce_supercopa(pais: String, fila: Dictionary) -> Array:
	var top: Array = fila.get("top", []) as Array
	if top.size() < 2:
		top = [String(fila.get("champion", "")), String(fila.get("runner_up", ""))]
	return SupercopaNacional.entrantes(pais, top, String(fila.get("copa", "")),
		String(fila.get("copa_sub", "")), String(fila.get("copaliga", "")))









func _ganador_supercopa(pais: String, temporada: int, fila_viva: Dictionary = {}) -> String:
	var cruce: Array = supercopa_de(pais, temporada - 1)
	if SupercopaNacional.misma(pais):
		cruce = _cruce_supercopa(pais, fila_viva) if SupercopaNacional.aplica(pais) else []
	if cruce.size() < 2:
		return ""




	var mio: Dictionary = GameState.supercopa_state
	if int(mio.get("season", -1)) == temporada and not String(mio.get("winner", "")).is_empty() \
			and (cruce.has(String(mio.get("a", ""))) or String(mio.get("pais", "")) == pais):
		return String(mio.get("winner", ""))
	return SupercopaNacional.simula(pais, cruce, temporada)





func _ganador_copaliga(pais: String, temporada: int) -> String:
	if not CopaLiga.tiene(pais):
		return ""
	var mio: Dictionary = GameState.copaliga_state
	if int(mio.get("season", -1)) == temporada \
			and pais == Teams.country_of(GameState.player_team_id):
		if bool(mio.get("champion", false)):
			return GameState.player_team_id
		var w: String = String(mio.get("winner", ""))
		if not w.is_empty():
			return w
	return CopaLiga.campeon_sim(pais, temporada)





func _ganador_ligas(temporada: int) -> String:
	var st: Dictionary = GameState.ligas_state
	if int(st.get("season", -1)) != temporada:
		return ""
	return CopaLigas.campeon(st.get("mls", []), st.get("mx", []), temporada,
		st.get("ganadores", {}))






func _fila_liga(pais: String, temporada: int) -> Dictionary:
	var i: int = league_history.size() - 1
	while i >= 0:
		var fila: Dictionary = league_history[i]
		if int(fila.get("season", -1)) == temporada \
				and String(fila.get("country", "")) == pais:
			return fila
		i -= 1
	return {}









func league_champion_of(pais: String, temporada: int, div: int = 1,
		censo: Array = []) -> String:
	if div == 1:
		var fila: Dictionary = _fila_liga(pais, temporada)
		if not fila.is_empty():
			return String(fila.get("champion", ""))
	return SimLeague.champion(pais, div, temporada, censo)






func league_champions_of(pais: String, temporada: int, div: int = 1,
		censo: Array = []) -> Array:
	if div == 1:
		var fila: Dictionary = _fila_liga(pais, temporada)
		if not fila.is_empty():
			var out: Array = []
			if not String(fila.get("champion_ap", "")).is_empty():
				out.append(String(fila["champion_ap"]))
			if not String(fila.get("champion", "")).is_empty():
				out.append(String(fila["champion"]))
			return out
	return SimLeague.champions(pais, div, temporada, censo)
































