func rumores_visibles(count: int, con_mesa: bool = true) -> Array:






	if not pending_precontract.is_empty():
		return []
	var skip: Array = _rumors_dismissed.duplicate()


	for id in _market_rejected:
		var rid: String = String(id)
		if not skip.has(rid):
			skip.append(rid)
	for id in _club_vetos.keys():
		if club_vetado(String(id)) and not skip.has(String(id)):
			skip.append(String(id))
	if con_mesa:
		for o in pending_offers:
			var oid: String = String((o as Dictionary).get("id", ""))
			if not oid.is_empty() and not skip.has(oid):
				skip.append(oid)


	return Market.rumors(scout_profile(), GameState.player_team_id, count, skip,
		cortejo_activo())














