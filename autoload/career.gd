	if not ["fachada", "estilo"].has(String(House.extra_by_id(id).get("excl", ""))):
		return false
	_swap_fuera(id)
	_save()
	changed.emit()
	return true



























func buy_house_pack(plt: Dictionary, q_pre: Dictionary = {}) -> bool:
	var q: Dictionary = q_pre
	if q.is_empty() or String(q.get("plt", "")) != String(plt.get("id", "")):
		q = House.pack_quote(House.plan_of(house_level), plt)
	if q.is_empty():
		return false
	var price: int = int(q["precio"])
	if not can_afford(price):
		return false
	money -= price





	var key: String = House.layout_key(house_level)
	var vieja: Dictionary = house_layout.get(key, {})
	var capa: Dictionary = {"tabiques":(plt["tabiques"] as Array).duplicate(true)}
	if vieja.has("ventanas"):
		capa["ventanas"] =(vieja["ventanas"] as Array).duplicate(true)
	for g in q["pone"]:
		var fila: Dictionary = g as Dictionary
		var extra_id: String = String(fila["extra"])
		var primera: bool = not house_extras.has(extra_id)
		var iid: String = _add_house_item(String(fila["kind"]), extra_id,
			fila["size"] as Vector2, not primera)
		if iid.is_empty():
			continue
		if primera:
			house_extras.append(extra_id)






			var estreno_p: bool = not house_extras_estrenados.has(extra_id)
			if estreno_p:
				house_extras_estrenados.append(extra_id)
			var bumps_p: Dictionary = House.extra_by_id(extra_id).get("rel", {}) \
					if estreno_p else {}
			for k in bumps_p:
				var canal_p: String = str(k)
				var delta_p: int = int(bumps_p[k])



				if delta_p != 0 and rel.has(canal_p) and not rel_derivada(canal_p):
					rel[canal_p] = clampi(int(rel[canal_p]) + delta_p, 0, 100)
		capa[iid] = {"pos": fila["pos"], "face": int(fila["face"])}


	for iid_a in q["acomoda"]:
		capa[String(iid_a)] = q["acomoda"][iid_a]


	if plt.has("aberturas"):
		capa["aberturas"] =(plt["aberturas"] as Array).duplicate(true)



	var ac: Dictionary = q.get("acabados", {})
	if not ac.is_empty():
		house_finish["floor"] = String(ac["base"])
		set_floor_paint((ac["pintura"] as Dictionary).duplicate())
		if not String(ac["pared"]).is_empty():
			house_finish["wall"] = String(ac["pared"])
		for fid in House.pack_acabados_ids(plt):
			if not house_finishes.has(fid):
				house_finishes.append(String(fid))
	house_layout[key] = capa
	_save()
	changed.emit()
	return true










