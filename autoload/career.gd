const NAT_PAY_FLAT: int = 500
const NAT_PAY_GOAL: int = 400
const NAT_PAY_REF_WAGE: float = 1200.0

func nat_match_pay(goals: int) -> int:
	var base: int = NAT_PAY_FLAT + maxi(goals, 0) * NAT_PAY_GOAL
	var mult: float = maxf(1.0,
		float(maxi(int(contract.get("wage", 0)), 0)) / NAT_PAY_REF_WAGE)
	return int(round(float(base) * mult))





func _event_money(fx: Dictionary) -> int:
	var total: int = int(fx.get("money", 0))
	total += int(float(contract["wage"]) * float(fx.get("money_wage", 0.0)))


	total -= Multas.monto(int(contract["wage"]), float(fx.get("multa", 0.0)))
	if fx.has("money_sponsor"):







		var best_pay: int = 0
		for s in sponsors:
			best_pay = maxi(best_pay, int(Sponsors.term(s, "pay")))
		total += int(float(best_pay) * float(fx.get("money_sponsor", 0.0)))




	if total < 0 and bool(fx.get("con_ella", false)) and pareja_activa():
		var inv: float = PAREJA.invita_de(String(pareja.get("id", "")))
		total = int(round(float(total) *(1.0 - inv)))
	return total





