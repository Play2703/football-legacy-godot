func record_shots(shots: Array, passes: Array, best_pass_m: float, rival: String,
		comp: String) -> void:
	var comp_key: String = "league" if comp.is_empty() else comp
	for s in shots:
		var e: Dictionary =(s as Dictionary).duplicate()



		e["c"] = comp_key
		season_shots.append(e)
	for pa in passes:
		var pe: Dictionary =(pa as Dictionary).duplicate()
		pe["c"] = comp_key
		season_passes.append(pe)
	_bump_dist_mark(ShotBook.farthest_goal(shots), best_pass_m, rival)
