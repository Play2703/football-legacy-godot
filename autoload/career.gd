func _once_de_hoy_ctx() -> Dictionary:
	once_ctx_llamadas += 1
	var team_id: String = GameState.player_team_id
	var squad: Array = Squad.of_nominal(team_id)
	if squad.is_empty():
		return {}
	var meta: Array = _ensure_squad_meta(team_id, squad)




	var factor: float = factor_de_hoy()









	Squad.set_forma_dia(team_id, Squad.forma_del_dia(team_id, squad, meta))
	var slots: Array = Squad.formation_slots(team_id).slice(0, Squad.STARTING_XI)





	var urg: Dictionary = Squad.convoca_urgencia(team_id, squad, meta, slots)
	Squad.set_urgencias(team_id, urg["fichas"])
	squad = urg["squad"]
	meta = urg["meta"]

















	var fijos: Dictionary = {}





	var pos_hoy: String = puesto_hoy()
	var mio: int = Squad.user_index_en(squad, pos_hoy, false)














	var k: int = -1
	if mio >= 0:
		var huecos: Array = []
		for s in slots:
			huecos.append({"pos": String(s)})
		k = Squad.user_index_en(huecos, pos_hoy, false)
		if k >= 0:
			fijos[k] = mio



















	var habituales: Dictionary = {}
	for i in _once_para(squad, _meta_fresca(meta), slots, factor, fijos, k):
		habituales[int(i)] = true
	var once: Array = _once_para(squad, meta, slots, factor, fijos, k, habituales)






	var yo: Variant = null
	if k >= 0 and k < once.size() and int(once[k]) >= 0 and int(once[k]) < squad.size():
		yo = squad[int(once[k])]
	elif mio >= 0:
		yo = squad[mio]
	Squad.marca_yo_hoy(yo)
	return {"once": once, "squad": squad, "meta": meta, "slots": slots, "factor": factor,
		"fijos": fijos, "k": k, "habituales": habituales}




func _meta_fresca(meta: Array) -> Array:
	var fresca: Array = []
	for pm in meta:
		var c: Dictionary =(pm as Dictionary).duplicate()
		c["energy"] = Rotation.MAX
		fresca.append(c)
	return fresca








func _once_para(squad: Array, meta: Array, slots: Array, factor: float, fijos: Dictionary,
		k: int, habituales: Dictionary = {}) -> Array:
	var mio: int = int(fijos.get(k, -1))
	var once: Array = []
	if k >= 0 and mio >= 0 and mio < meta.size() and not Rotation.disponible(meta[mio]):
		once = _once_con_relevo(squad, meta, slots, factor, k, habituales)
	if once.is_empty():
		once = Rotation.lineup(squad, meta, slots, factor, fijos, {},
			Standing.TIRED_BENCH_ENERGY, habituales)
	if once.is_empty():







		once = []
		for i in mini(squad.size(), meta.size()):
			if once.size() >= Squad.STARTING_XI:
				break
			if Rotation.disponible(meta[i]):
				once.append(i)
		for i in mini(Squad.STARTING_XI, squad.size()):
			if once.size() >= Squad.STARTING_XI:
				break
			if not once.has(i):
				once.append(i)
	return once






func delta_once_mio() -> float:
	var team_id: String = GameState.player_team_id
	if team_id.is_empty():
		return 0.0
	if not _foto_delta.is_empty() and String(_foto_delta.get("club", "")) == team_id:
		return float(_foto_delta.get("delta", 0.0))
	if _calculando_delta:
		return 0.0
	var llave: String = "%s|%d|%d|%s|%s|%s|%d" % [team_id, GameState.season_num,
		GameState.season_day, coach_idea, _dt_llave(), puesto_hoy(), _huella_meta(team_id)]
	if _delta_once_memo.has(llave) and int(_delta_once_memo.get("v", -1)) == Squad.cache_version():
		return float(_delta_once_memo[llave])
	_calculando_delta = true
	var d: float = _calcula_delta_once()
	_calculando_delta = false
	_delta_once_memo = {llave: d, "v": Squad.cache_version()}
	return d




func _huella_meta(team_id: String) -> int:
	var meta: Variant = squad_meta.get(team_id, null)
	if not (meta is Array):
		return 0
	var h: int =(meta as Array).size()
	for pm in meta:
		if pm is Dictionary:
			h =(h * 131 + Rotation.energia(pm) * 3 +(1 if Rotation.disponible(pm) else 0)) % 2147483647
	return h





func _calcula_delta_once() -> float:
	var ctx: Dictionary = _once_de_hoy_ctx()
	if ctx.is_empty():
		return 0.0
	var fresco: Array = _once_para(ctx["squad"], _meta_fresca(ctx["meta"]), ctx["slots"],
		float(ctx["factor"]), ctx["fijos"], int(ctx["k"]))
	return Squad.delta_once(ctx["squad"], ctx["slots"], ctx["once"], fresco, int(ctx["k"]))




