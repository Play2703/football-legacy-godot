func puesto_que_te_pide() -> String:
	var club: String = GameState.player_team_id
	if club.is_empty() or Teams.by_id(club).is_empty():
		return ""
	var mio: String = puesto_hoy()
	var candidatos: Array = []
	for p in Squad.POS_LINE.keys():
		var pos: String = String(p)
		if pos != mio and Squad.puesto_elegible(pos):
			candidatos.append(pos)
	if poss.size() >= Squad.POS_MAX:

		candidatos = candidatos.filter(func(c: Variant) -> bool: return sabe_jugar(String(c)))


	var pacto: Array = pacto_puestos(club)
	if not pacto.is_empty():
		candidatos = candidatos.filter(func(c: Variant) -> bool: return pacto.has(String(c)))
	var destino: String = Squad.puesto_ofrecido(club, candidatos)
	if destino.is_empty():
		return ""


	if rival_pressure() < RECONVERSION_PRESION:
		return ""


	var xi: Array = Squad.of(club).slice(0, Squad.STARTING_XI)
	var muro_alli: int = 0
	var muro_aqui: int = 0
	for f in xi:
		var ficha: Dictionary = f as Dictionary
		var fp: String = String(ficha.get("pos", ""))
		var m: int = SquadMeta.media_of(ficha, fp)
		if fp == destino:
			muro_alli = maxi(muro_alli, m)
		elif fp == mio:
			muro_aqui = maxi(muro_aqui, m)
	return destino if muro_alli < muro_aqui else ""




const RECONVERSION_PRESION: float = 1.5

















const PROB_PETICION: Array[float] = [0.1, 0.35, 0.6, 0.85]



func lectura_peticion(pos: String) -> int:
	if not sabe_jugar(pos) or pos == puesto_hoy():
		return 0
	var puntos: int = 0
	if int(rel["tecnico"]) >= 45:
		puntos += 1
	if int(rel["tecnico"]) >= 65:
		puntos += 1
	if escalon_familiaridad(pos) >= 2:
		puntos += 1


	if pos == puesto_favorito():
		puntos += 1
	return clampi(puntos, 0, 3)





