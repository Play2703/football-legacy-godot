var _nat_year_winner: String = ""
var _nat_year_kind: String = ""






















const NAT_SWITCH_SEASONS: int = 5





func seasons_by_country() -> Dictionary:
	var out: Dictionary = {}
	for row in season_history:
		var c: String = Teams.country_of(String(row.get("club", "")))
		if c.is_empty():
			continue
		out[c] = int(out.get(c, 0)) + 1
	var now: String = Teams.country_of(GameState.player_team_id)
	if not now.is_empty():
		out[now] = int(out.get(now, 0)) + 1
	return out





func nat_switch_open() -> bool:
	return not retired and not nat_retired and nat_caps_official <= 0





func nat_switch_options() -> Array:
	if not nat_switch_open():
		return []
	var out: Array = []
	for c in seasons_by_country():
		if int(seasons_by_country()[c]) < NAT_SWITCH_SEASONS:
			continue
		var id: String = Nations.id_for_country(String(c))
		if id == nationality or Nations.by_id(id).is_empty():
			continue
		out.append(id)
	return out










func switch_nationality(to: String) -> bool:
	if not nat_switch_options().has(to):
		return false



	nat_match_clear(nationality)



	var vieja: String = nationality
	if not vieja.is_empty():
		nat_seats[vieja] = Coaches.fila_nat(nat_coach_term, nat_coach_desde, nat_coach_src,
			nat_coach_cred)
	var nueva: String = Nations.canon_id(to)
	var fila_nueva: Variant = nat_seats.get(nueva, null)
	nat_seats.erase(nueva)
	nationality = nueva
	nat_rel = {"tecnico": 50, "equipo": 50, "aficion": 50}
	nat_rel_frac = {}







	nat_coach_term = 1
	nat_coach_src = ""
	nat_coach_desde = 0
	nat_coach_char = "neutral"
	nat_coach_idea = "directo"
	nat_coach_fails = 0
	nat_coach_cred = 0
	if fila_nueva is Array and (fila_nueva as Array).size() >= 4:
		var fn: Array = fila_nueva
		nat_coach_term = maxi(int(fn[0]), 1)
		nat_coach_desde = int(fn[1])
		nat_coach_src = String(fn[2])
		nat_coach_cred = int(fn[3])

	nat_coach_idea = Coaches.idea_de(Coaches.seat(Coach.origen_nat(nueva)).get("club", ""),
		int(Coaches.seat(Coach.origen_nat(nueva)).get("term", 1)))
	Coaches.bump()
	_niv_invalida()
	nat_captain = false
	nat_seasons_out = 0
	nat_edge = 0

	nat_race_last = NAT_RACE_NONE
	nat_race_prev = NAT_RACE_NONE
	nat_notice_seen = {}



	GameState.drop_pending_nat()
	NatTeam.invalidate_candidates()
	_save()
	changed.emit()
	return true


















const NAT_CAPTAIN_CAPS: int = 15


const NAT_CAPTAIN_REL: int = 70



const NAT_CAPTAIN_REL_DROP: int = 55






func _evaluate_nat_captaincy(status: String) -> void:
	if nationality.is_empty() or nat_retired:
		if nat_captain:
			nat_captain = false
		return
	var coach: int = int(nat_rel["tecnico"])
	var dressing: int = int(nat_rel["equipo"])
	if nat_captain:

		if status != "titular" or coach < NAT_CAPTAIN_REL_DROP \
				or dressing < NAT_CAPTAIN_REL_DROP:
			nat_captain = false
		else:
			nat_captain_seasons += 1
		return

	if status == "titular" and nat_caps >= NAT_CAPTAIN_CAPS \
			and coach >= NAT_CAPTAIN_REL and dressing >= NAT_CAPTAIN_REL:
		nat_captain = true
		record_captain_band("seleccion")
		nat_captain_seasons += 1
		Achievements.ingest_nat_captain()




func is_nat_captain() -> bool:
	return nat_captain and not nat_retired














func is_captain_in_match(nat_match: bool) -> bool:
	return is_nat_captain() if nat_match else is_player_captain()






func _note_nat_champion(st: Dictionary) -> void:
	var comp: String = String(st.get("comp", ""))
	if comp != "wc" and comp != "cont":
		return
	_nat_year_kind = comp
	var w: String = String(st.get("winner", ""))




	if w == GameState.YOU_KEY:
		w = nationality
	_nat_year_winner = w if not w.is_empty() \
			else (nationality if bool(st.get("champion", false)) else "")


func _resolve_national(avg: float, lines: Array[String]) -> void:


	_nat_campeon_cierre = ""
	if nationality.is_empty():
		return


	var s: int = GameState.season_num - 1
	var nat_name: String = Nations.display_name(nationality)
	var st: Dictionary = GameState.nat_state
	_tick_nat_season(st)


	_cierra_finalissima(s, lines)

	_cierra_naciones(s, lines)

	_cierra_olimpicos(s, nat_name, lines)




	if String(st.get("comp", "")) == "friendly" and bool(st.get("playing", false)):
		_resolve_national_friendly(st, s, nat_name, lines)


		GameState.tick_nat_coef("", "")
		NatTeam.invalidate_candidates()
		return
	if bool(st.get("watch", false)) and bool(st.get("playing", false)):



		_resolve_national_watched(st, s, nat_name, lines)
	elif bool(st.get("playing", false)):


		_resolve_national_played(st, s, nat_name, lines)
	else:

		_resolve_national_absent(s, nat_name, lines)






	GameState.tick_nat_coef(_nat_year_winner, _nat_year_kind)
	NatTeam.invalidate_candidates()


	if _nat_year_kind == "cont":
		GameState.finalissima_arma(s, nationality, _nat_year_winner)
	_nat_campeon_cierre = _nat_year_winner
	_nat_year_winner = ""
	_nat_year_kind = ""





func _cierra_finalissima(s: int, lines: Array[String]) -> void:
	var fs: Dictionary = GameState.finalissima_state
	if int(fs.get("season", -1)) != s:
		return
	var pareja: Array = fs.get("pareja", [])
	if pareja.size() < 2:
		return
	if not fs.has("winner"):
		var t: Dictionary = Finalissima.ganador_sim(pareja, s)
		fs["winner"] = String(t.get("winner", ""))
		fs["score"] = String(t.get("score", ""))
	var w: String = String(fs.get("winner", ""))
	if w.is_empty():
		return
	var otro: String = String(pareja[1]) if w == String(pareja[0]) else String(pareja[0])
	lines.append(I18n.tf("FINALÍSIMA: {0} le gana a {1}",
		[Nations.display_name(w), Nations.display_name(otro)]))






func _cierra_naciones(s: int, lines: Array[String]) -> void:
	if not LigaNaciones.es_temporada(s):
		return
	var ns: Dictionary = GameState.naciones_state
	var confed: String = LigaNaciones.confed_de(nationality)
	if confed.is_empty():
		confed = "UEFA"
	var w: String = ""
	if int(ns.get("season", -1)) == s and String(ns.get("confed", "")) == confed:
		w = String(ns.get("winner", ""))
	if w.is_empty():
		w = String(LigaNaciones.sim_entera(confed, s).get("winner", ""))
		if int(ns.get("season", -1)) == s:
			ns["winner"] = w
	if w.is_empty():
		return
	lines.append(I18n.tf("LIGA DE NACIONES: {0}", [Nations.display_name(w)]))







func _cierra_olimpicos(s: int, nat_name: String, lines: Array[String]) -> void:
	if not JuegosOlimpicos.es_temporada(s):
		return
	var os: Dictionary = GameState.olimpicos_state
	var med: Dictionary = {}
	if int(os.get("season", -1)) == s and os.has("oro"):
		med = os
	else:
		med = JuegosOlimpicos.sim_entera(s)
		if int(os.get("season", -1)) == s:
			for k in ["oro", "plata", "bronce"]:
				os[k] = med.get(k, "")
	var oro: String = String(med.get("oro", ""))
	if oro.is_empty():
		return


	lines.append(I18n.tf(JuegosOlimpicos.pinta("JUEGOS OLÍMPICOS: oro para {0}"),
		[Nations.display_name(oro)]))
	if int(os.get("season", -1)) != s or not nat_played_tournament("olimpicos"):
		return
	var canon: String = Nations.canon_id(nationality)
	var key: String = ""
	for par in [["oro", "{0}: ORO en los Juegos Olímpicos"],
			["plata", "{0}: plata en los Juegos Olímpicos"],
			["bronce", "{0}: bronce en los Juegos Olímpicos"]]:
		if Nations.canon_id(String(med.get(par[0], ""))) == canon:
			key = String(par[1])
			break
	if key.is_empty():
		return
	nat_history.append({"season": s, "comp": JuegosOlimpicos.NOMBRE,
		"text": _fill_es(key, [nat_name]), "text_key": key, "text_args": [nat_name],
		"status": "olimpicos", "mine": key.contains("ORO")})













func _tick_nat_season(st: Dictionary) -> void:
	var fui: bool = bool(st.get("playing", false)) and not bool(st.get("watch", false))
	if fui:
		nat_seasons_out = 0
		return
	nat_seasons_out += 1
	for k in nat_rel.keys():
		var v: float = float(nat_rel[k])
		_apply_nat_delta(String(k),(50.0 - v) * 0.25)















func _fill_es(src: String, args: Array) -> String:
	var out: String = src
	for i in args.size():
		out = out.replace("{%d}" % i, str(args[i]))
	return out











func _nat_line(src: String, args: Array) -> String:
	var shown: Array = []
	for a in args:
		shown.append(I18n.t(str(a), "nat"))
	return I18n.tf(src, shown)





func _resolve_national_watched(st: Dictionary, s: int, nat_name: String,
		lines: Array[String]) -> void:
	_note_nat_champion(st)
	lines.append(I18n.tf("Sin sitio en la selección de {0}", [nat_name]))
	var key: String = ""
	var args: Array = []
	var comp: String = String(st.get("comp", ""))
	if comp == "wc" or comp == "cont":
		var tour: String = String(st.get("name", NatTeam.tournament_name(s, nationality)))
		if bool(st.get("champion", false)):

			key = "{0} CAMPEÓN de la {1}… sin ti"
			args = [nat_name, tour]
		elif comp == "wc" and not bool(st.get("advanced", false)):

			key = "{0}: {1} fuera en la fase de grupos (sin ti)"
			args = [tour, nat_name]
		else:
			var idx: int = int(st.get("ko_idx", 0))
			var names: Array = st.get("ko_names", [])
			var last: int = names.size() - 1
			if idx >= last and last >= 0:
				key = "{0} subcampeón de la {1} (sin ti)"
				args = [nat_name, tour]
			elif idx < names.size():
				key = "{0}: {1} eliminada en {2} (sin ti)"
				args = [tour, nat_name, String(names[idx]).to_lower()]
			else:
				key = "{0} sin ti"
				args = [tour]
		if comp == "wc":
			nat_qualified = false
		else:
			cont_qualified = false
	else:


		var target: String = String(st.get("target", "wc"))
		var goal: String = NatTeam.qual_target_name(s, nationality)
		var got: bool = cont_qualified if target == "cont" else nat_qualified
		key = "{0} se clasificó para {1} (sin ti)" if got \
				else "{0} se quedó fuera de {1}"
		args = [nat_name, goal]



		_judge_nat_coach(got, lines)
	lines.append(_nat_line(key, args))
	nat_history.append({"season": s, "comp": NatTeam.tournament_name(s, nationality),
		"text": _fill_es(key, args), "text_key": key, "text_args": args,
		"status": "fuera"})



func _resolve_national_played(st: Dictionary, s: int, nat_name: String,
		lines: Array[String]) -> void:
	_note_nat_champion(st)
	var status: String = String(nat_callup().get("status", "banca"))


	var era_capitan: bool = nat_captain
	_evaluate_nat_captaincy(status)
	if nat_captain and not era_capitan:
		lines.append(I18n.tf("CAPITÁN de {0}", [nat_name]))
	elif era_capitan and not nat_captain:
		lines.append(I18n.tf("Perdiste el brazalete de {0}", [nat_name]))
	lines.append(I18n.tf("Titular de {0}", [nat_name]) if status == "titular"
		else I18n.tf("Convocado con {0}", [nat_name]))
	var key: String = ""
	var args: Array = []




	var titulo_mio: bool = true
	var comp: String = String(st.get("comp", ""))
	if comp == "wc" or comp == "cont":

		var tour: String = String(st.get("name", NatTeam.tournament_name(s, nationality)))
		if bool(st.get("champion", false)):






			var jugado: bool = nat_played_tournament(comp)
			if not jugado:
				titulo_mio = false
				key = "{0}: {1} CAMPEÓN, y tú sin jugar un minuto"
				args = [tour, nat_name]
				lines.append(_nat_line(key, args))
			elif comp == "wc":


				grant_award("Campeón del Mundo")
				key = "¡CAMPEÓN DEL MUNDO con {0}!"
				args = [nat_name]


				lines.append(_fill_es(key, args))


			else:
				grant_award("Campeón continental")
				key = "¡CAMPEÓN de la {0} con {1}!"
				args = [tour, nat_name]


				lines.append(_nat_line(key, args))
		elif comp == "wc" and not bool(st.get("advanced", false)):
			key = "{0}: fuera en la fase de grupos con {1}"
			args = [tour, nat_name]
			lines.append(_nat_line(key, args))
		else:
			var idx: int = int(st.get("ko_idx", 0))
			var names: Array = st.get("ko_names", [])
			var last: int = names.size() - 1
			if idx >= last and last >= 0:
				key = "Subcampeón de la {0} con {1}"
				args = [tour, nat_name]
			elif idx < names.size():
				key = "{0}: eliminado en {1} con {2}"
				args = [tour, String(names[idx]).to_lower(), nat_name]
			else:
				key = "{0} con {1}"
				args = [tour, nat_name]
			lines.append(_nat_line(key, args))















		var wc_goals: int = season_nat_comp_total("wc")
		if comp == "wc" and wc_goals > 0:
			var wc_race: Array = Race.international(
				NatTeam.world_cup_field(nationality,
					NatTeam.wc_entry(nationality, s, true), s),
				s, "wc", nationality)
			var wc_top: Dictionary = Race.leader(wc_race, "goals")
			if not wc_race.is_empty() and wc_goals >= int(wc_top.get("goals", 99)):
				grant_award("Bota de Oro del Mundial")


				lines.append("BOTA DE ORO DEL MUNDIAL (%d goles · el listón era %d)"
					% [wc_goals, int(wc_top.get("goals", 0))])
		_premios_torneo_nat(s, comp, st, lines)
		if comp == "wc":
			nat_qualified = false
		else:
			cont_qualified = false
	else:



		var target: String = String(st.get("target", "wc"))
		var goal: String = NatTeam.qual_target_name(s, nationality)
		var got: bool = cont_qualified if target == "cont" else nat_qualified
		if got:
			key = "{0} se clasificó para {1}"
			args = [nat_name, goal]

			lines.append(I18n.tf("¡{0} se clasificó para {1}!",
				[nat_name, I18n.t(goal, "nat")]))
		else:
			key = "{0} se quedó fuera de {1}"
			args = [nat_name, goal]
			lines.append(_nat_line(key, args))



		_judge_nat_coach(got, lines)
	var row: Dictionary = {"season": s,
		"comp": NatTeam.tournament_name(s, nationality),
		"text": _fill_es(key, args), "text_key": key, "text_args": args,
		"status": status}



	if bool(st.get("champion", false)) and (comp == "wc" or comp == "cont"):
		row["mine"] = titulo_mio
	nat_history.append(row)




















const NAT_MEJOR_SUELO: float = 7.7
const NAT_BOTA_CONT_SUELO: int = 4
const NAT_ASIST_SUELO: int = 3

func _premios_torneo_nat(s: int, comp: String, st: Dictionary, lines: Array[String]) -> void:
	if not nat_played_tournament(comp) or not bool(st.get("advanced", true)):
		return
	var race: Array = []
	if comp == "wc":
		race = Race.international(NatTeam.world_cup_field(nationality,
			NatTeam.wc_entry(nationality, s, true), s), s, "wc", nationality)
	else:
		race = _intl_race(s, "cont")
	var avg: float = season_nat_avg(comp)
	var liston: float = NAT_MEJOR_SUELO
	if not race.is_empty():
		liston = float(Race.leader(race, "avg").get("avg", NAT_MEJOR_SUELO))
	if avg > 0.0 and avg >= liston:
		var mejor: String = "Mejor del Mundial" if comp == "wc" else "Mejor de la Copa continental"
		grant_award(mejor)

		lines.append("%s (%.1f)" % [mejor.to_upper(), avg])
	if comp == "cont":
		var g: int = season_nat_comp_total("cont")
		var top: int = NAT_BOTA_CONT_SUELO
		if not race.is_empty():
			top = int(Race.leader(race, "goals").get("goals", NAT_BOTA_CONT_SUELO))
		if g > 0 and g >= top:
			grant_award("Bota de la Copa continental")
			lines.append("BOTA DE LA COPA CONTINENTAL (%d goles · el listón era %d)"
				% [g, top])
	var a: int = season_nat_comp_total(comp, "a")
	var tope_a: int = NAT_ASIST_SUELO
	if not race.is_empty():
		tope_a = int(Race.leader(race, "assists").get("assists", NAT_ASIST_SUELO))
	if a > 0 and a >= tope_a:
		var asist: String = "Máximo Asistente del Mundial" if comp == "wc" \
				else "Máximo Asistente de la Copa continental"
		grant_award(asist)
		lines.append("%s (%d asistencias · el listón era %d)"
			% [asist.to_upper(), a, tope_a])




func _resolve_national_absent(s: int, nat_name: String, lines: Array[String]) -> void:
	lines.append(I18n.tf("Sin sitio en la selección de {0}", [nat_name]))
	var key: String = ""
	var args: Array = []
	match NatTeam.season_kind(s):
		"wc":
			var wc: Dictionary = NatTeam.simulate_world_cup(nationality, s, nat_qualified, 0.0)


			_nat_year_kind = "wc"
			_nat_year_winner = String(wc.get("winner", ""))
			if not bool(wc["played"]):
				key = "{0} no fue al Mundial"
				args = [nat_name]
			else:
				key = "Mundial sin ti: {0} de {1}"
				args = [String(wc["stage"]).to_lower(), nat_name]
			lines.append(_nat_line(key, args))
			nat_qualified = false
		"cont":
			var c: Dictionary = NatTeam.simulate_continental(nationality, s, 0.0,
				cont_qualified)
			_nat_year_kind = "cont"
			_nat_year_winner = String(c.get("winner", ""))
			if not bool(c["played"]):
				key = "{0} no se clasificó para {1}"
				args = [nat_name, NatTeam.tournament_name(s, nationality)]
			else:
				key = "{0} sin ti: {1} de {2}"
				args = [NatTeam.tournament_name(s, nationality),
					String(c["stage"]).to_lower(), nat_name]
			lines.append(_nat_line(key, args))
			cont_qualified = false
		_:
			var q: Dictionary = NatTeam.simulate_qualifiers(nationality, s, 0.0)
			var target: String = NatTeam.qual_target(s, nationality)
			var goal: String = NatTeam.qual_target_name(s, nationality)

			if target == "cont":
				cont_qualified = bool(q["qualified"])
				GameState.nat_qual_grupo_cont = NatTeam.sella_grupo(nationality, s,
					q["table"], "cont")
			else:
				nat_qualified = bool(q["qualified"])
				GameState.nat_qual_grupo = NatTeam.sella_grupo(nationality, s, q["table"])
			key = "{0} se clasificó para {1}" if bool(q["qualified"]) \
					else "{0} no se clasificó para {1}"
			args = [nat_name, goal]
			lines.append(_nat_line(key, args))
	nat_history.append({"season": s, "comp": NatTeam.tournament_name(s, nationality),
		"text": _fill_es(key, args), "text_key": key, "text_args": args,
		"status": "fuera"})











func _resolve_national_friendly(st: Dictionary, s: int, nat_name: String,
		lines: Array[String]) -> void:
	var played: int = int(st.get("played", 0))
	var won: int = int(st.get("won", 0))
	var key: String = ""
	var args: Array = []
	if bool(st.get("watch", false)) or played <= 0:


		key = "{0} sólo jugó amistosos este año"
		args = [nat_name]
	else:
		key = "{0} amistosos con {1}: {2} ganados"
		args = [played, nat_name, won]
	lines.append(_nat_line(key, args))
	nat_history.append({"season": s,


		"comp": "AMISTOSOS",
		"text": _fill_es(key, args), "text_key": key, "text_args": args,
		"status": "fuera" if bool(st.get("watch", false)) else "jugado"})

















func nombre_espalda() -> String:
	var propio: String = shirt_name.strip_edges().to_upper()
	return propio if not propio.is_empty() else espalda_auto()











func espalda_auto() -> String:
	var ape: String = Espalda.apellido_de(player_name)
	if ape.length() <= ESPALDA_MAX:
		return ape




	var partes: PackedStringArray = ape.split(" ", false)
	var corto: String = partes[partes.size() - 1] if not partes.is_empty() else ape
	return corto.substr(0, ESPALDA_MAX)






func espalda_de(nombre: String) -> String:
	if nombre.strip_edges().to_upper() == player_name.strip_edges().to_upper():
		return nombre_espalda()
	return Espalda.apellido_de(nombre)










func nombre_por_defecto() -> String:
	return I18n.t(DEFAULT_NAME)
















static func capitaliza_nombre(s: String) -> String:
	if s != s.to_lower() or s == s.to_upper():
		return s
	var partes: PackedStringArray = s.split(" ", false)
	for i in partes.size():
		var w: String = partes[i]
		if i > 0 and Espalda.PARTICULAS.has(w.to_upper()):
			continue
		partes[i] = w.substr(0, 1).to_upper() + w.substr(1)
	return " ".join(partes)





func set_player_name(nuevo: String) -> void:



	var clean: String = capitaliza_nombre(nuevo.replace("\n", " ").strip_edges())



	player_name = Espalda.acorta_nombre(clean, NOMBRE_MAX) if not clean.is_empty() \
			else nombre_por_defecto()
	_save()





func set_shirt_name(nuevo: String) -> void:
	shirt_name = nuevo.strip_edges().replace("\n", "").to_upper().substr(0, ESPALDA_MAX)
	_save()


















func rename_player(nombre: String, espalda: String) -> void:
	var rotulo: String = espalda.strip_edges().to_upper()
	var era_auto: bool = rotulo == espalda_auto()
	set_player_name(nombre)


	if era_auto or rotulo == espalda_auto():
		rotulo = ""
	set_shirt_name(rotulo)


