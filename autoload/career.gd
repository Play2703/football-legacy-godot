func _maybe_queue_market_board() -> void:
	if retired or free_agent or on_loan() or _market_settled:
		return
	if GameState.player_team_id.is_empty():
		return
	var id: String = Market.window_id(GameState.season_day, GameState.winter_day())
	if id != Market.WINDOW_SUMMER:
		return





	if not last_report.is_empty():
		return
	var sello: String = _board_sello(id)
	if _board_seen == sello:
		return



	if _board_stamp != sello:
		return





	var plantilla: Dictionary = {}
	for r in squad_roster():
		plantilla[String((r as Dictionary).get("name", ""))] = true
	var sigue: Callable = func(f: Variant) -> bool:
		return plantilla.has(String((f as Dictionary).get("name", "")))
	var venta: Array =(_market_board.get("venta", []) as Array).duplicate(true) \
			.filter(sigue)
	var cesion: Array =(_market_board.get("cesion", []) as Array).duplicate(true) \
			.filter(sigue)
	var tu_lista: String = _board_tu_lista()


	var cupo_v: int = BOARD_MAX_FILAS -(1 if tu_lista == "venta" else 0)
	var cupo_c: int = BOARD_MAX_FILAS -(1 if tu_lista == "cesion" else 0)
	venta = venta.slice(0, cupo_v)
	cesion = cesion.slice(0, cupo_c)



	var fuera: Dictionary = {}
	for n in (_market_board.get("salen_todos", []) as Array):
		fuera[String(n)] = true
	for f in venta + cesion:
		fuera[String((f as Dictionary).get("name", ""))] = true
	var intocables: Array = _board_intocables(fuera,
		BOARD_MAX_FILAS -(1 if tu_lista == "intocables" else 0))
	if venta.is_empty() and cesion.is_empty() and intocables.is_empty() \
			and tu_lista.is_empty():
		return
	_board_seen = sello




	var tu: Dictionary = tu_veredicto_mercado()
	tu["name"] = player_name
	tu["pos"] = Squad.USER_POS
	tu["media"] = ovr_shown()















	tu["precio"] = asking_price()
	tu["precio_por_que"] = Market.asking_why(list_status() != LIST_NONE,
		int(contract["seasons_left"]), venta_por_grada())
	queue_ceremony(Ceremonies.MARKET_BOARD, {
		"ventana": id,
		"season": GameState.season_num,
		"div": GameState.player_div(),
		"club": GameState.player_team_id,
		"venta": venta,
		"cesion": cesion,
		"intocables": intocables,


		"tu_lista": tu_lista,
		"tu": tu,
	})





