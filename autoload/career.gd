		eased_return = true
	injury_peak_weeks = 0







func _notify_injury(nat: bool = false, forced_out: bool = false) -> void:
	if injury_weeks <= 0:
		return

	muro_pon("lesion")




	var pico_antes: int = injury_peak_weeks
	injury_peak_weeks = maxi(injury_peak_weeks, injury_weeks)




	last_injury_drops = _injury_stat_drop(pico_antes, injury_peak_weeks)


















	_tele_lesion()
	if injury_weeks >= GRAVE_WEEKS or (forced_out and injury_weeks >= 2):
		var pay: Dictionary = {"weeks": injury_weeks}


		if not last_injury_drops.is_empty():
			pay["drops"] = last_injury_drops.duplicate()
		if forced_out:
			pay["forced_out"] = true
			pay["minute"] = last_injury_min
		if nat and not nationality.is_empty():
			pay["nation"] = nationality
		queue_ceremony(Ceremonies.INJURY, pay)


	if injury_weeks >= GRAVE_WEEKS:



		_injury_was_grave = true

















		_apply_delta("aficion", 3.0)
		_apply_delta("prensa", 2.0)

		_seed_pareja_lesion()




func injury_drop_points(weeks: int) -> int:
	if weeks < GRAVE_WEEKS:
		return 0
	return mini(weeks / INJURY_DROP_WEEKS, INJURY_DROP_MAX)










func _injury_stat_drop(pico_antes: int, pico_ahora: int) -> Dictionary:
	var pts: int = injury_drop_points(pico_ahora) - injury_drop_points(pico_antes)
	var bajas: Dictionary = {}
	for i in maxi(pts, 0):
		var vivas: Array[String] = []
		for k in SKILL_KEYS:
			if int(skills.get(k, 20)) > 20:
				vivas.append(k)
		if vivas.is_empty():
			break
		var k: String = vivas[randi() % vivas.size()]
		skills[k] = int(skills[k]) - 1
		bajas[k] = int(bajas.get(k, 0)) + 1


	if bajas.has("fisico"):
		energy = minf(energy, energy_cap())
	return bajas








