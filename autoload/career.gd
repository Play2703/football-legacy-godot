func aplica_cita(delta: float, id: String = "") -> void:
	if absf(delta) > 0.001:
		_apply_delta("pareja", delta, REL_BRAKE_EXP_DECISION)
	if id.is_empty():
		week_event = ""
		week_event_club = ""
		pending_decision = ""
	elif pending_decision == id:
		pending_decision = ""
	elif week_event == id:
		week_event = ""
		week_event_club = ""
	decision_cooldown = DECISION_COOLDOWN
	_save()
	changed.emit()






func pension_activa() -> bool:
	return pareja_pension > 0.0 and GameState.season_num <= pareja_pension_hasta





func pension_cuota() -> int:
	if not pension_activa():
		return 0
