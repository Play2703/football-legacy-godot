const CORTEJO_SERIO: int = 2






func cortejo_activo() -> bool:
	return int(contract.get("seasons_left", 9)) <= 1 and not on_loan() \
			and pending_precontract.is_empty() and not retired





func cortejo_tramo(club_id: String) -> int:
	if not cortejo_activo():
		return -1



	if _market_rumors.has(club_id) or courting_club == club_id:
		return CORTEJO_SERIO
	return CORTEJO_QUIERE if int(_cortejo.get(club_id, 0)) >= CORTEJO_FIRME \
			else CORTEJO_SIGUE




func cortejo_jornadas(club_id: String) -> int:
	return int(_cortejo.get(club_id, 0))








func cortejo_orden() -> Array:
	if not cortejo_activo():
		return []
	var ids: Array = _cortejo.keys()
	ids.sort_custom(func(a, b) -> bool:
		var ta: int = cortejo_tramo(String(a))
		var tb: int = cortejo_tramo(String(b))
		if ta != tb:
			return ta > tb
		return int(_cortejo[a]) > int(_cortejo[b]))
	return ids






func _tick_cortejo() -> void:
	if not cortejo_activo():


		if not _cortejo.is_empty():
			_cortejo = {}
			_cortejo_dia = ""
		return
	var hoy_id: String = "%d|%d" % [GameState.season_num, GameState.season_day]
	if _cortejo_dia == hoy_id:
		return
	_cortejo_dia = hoy_id
	var hoy: Array = []
	for r in rumores_visibles(4, false):
		var rid: String = String((r as Dictionary).get("id", ""))
		if not rid.is_empty():
			hoy.append(rid)


	for id in _cortejo.keys():
		if not hoy.has(String(id)):
			_cortejo.erase(id)
	var filtrado: bool = false
	for id in hoy:
		var antes: int = cortejo_tramo(id)
		_cortejo[id] = int(_cortejo.get(id, 0)) + 1
		if filtrado:
			continue



		if cortejo_tramo(id) > antes:
			_market_note(TAG_CORTEJO, String(Teams.by_id(id).get("name", id)), id)
			filtrado = true







func dismiss_rumor(club_id: String) -> void:
	if club_id.is_empty() or _rumors_dismissed.has(club_id) \
			or _market_rumors.has(club_id):
		return
	_rumors_dismissed.append(club_id)
	_veta_club(club_id)
	if courting_club == club_id:
		courting_club = ""
	_save()
	changed.emit()







func _maybe_seed_rumors(winter_day: int) -> void:

	if _rumors_done or _market_settled or on_loan():
		return
	var wf: int = Market.winter_first(winter_day)
	if GameState.season_day < wf - RUMOR_LEAD or GameState.season_day >= wf:
		return
	_rumors_done = true





	var pool: Array = Market.candidates(scout_profile(), GameState.player_team_id,
		_market_floor())
	if pool.is_empty():
		return




	pool = pool.slice(0, RUMOR_POOL)
	pool.shuffle()





	if not _market_missed.is_empty():
		var vuelven: Array = []
		var otros: Array = []
		for cand in pool:
			if _market_missed.has(String(cand.get("id", ""))):
				vuelven.append(cand)
			else:
				otros.append(cand)
		pool = vuelven + otros
	_market_missed = []




	pool = pool.filter(func(c: Dictionary) -> bool:
		return not club_vetado(String(c.get("id", ""))))
	for cand in pool.slice(0, 2):
		var id: String = String(cand.get("id", ""))
		if id.is_empty() or _market_rumors.has(id):
			continue
		_market_rumors.append(id)
	_save()
	changed.emit()





func _apply_rumor_offers() -> void:
	if _market_rumors.is_empty():
		return
	var present: Dictionary = {}
	for o in pending_offers:
		present[String(o.get("id", ""))] = true
	for id in _market_rumors:



		if present.has(String(id)) or club_vetado(String(id)):
			continue
		var forced: Dictionary = Market.forced_offer(String(id), scout_profile())
		if not forced.is_empty():
			pending_offers.insert(0, forced)
	_market_rumors = []
	_rumor_asked = []




















