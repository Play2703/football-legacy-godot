		return false
	pulse_modo = "clausulas"
	pulse_kind = "offer"
	pulse_index = index
	return true






func clausulas_presenta_oferta(index: int, peticion: Dictionary, roll: float = -1.0) -> Dictionary:
	var mesa: Dictionary = clausulas_mesa_oferta(index)
	if not bool(mesa["ok"]):
		return {}
	var b: Dictionary = mesa["base"]
	var ctx: Dictionary = mesa["ctx"]
	var p: Dictionary = Clausulas.sanea(peticion, b, ctx)
	if Clausulas.es_base(p, b):
		return {}
	var r: Dictionary = Clausulas.resolve(p, b, ctx, roll if roll >= 0.0 else randf())
	if String(r["resultado"]) == "portazo":
		pulse_walkout(index)
		return r
	var offer: Dictionary = pending_offers[index]
	var c: Dictionary = r["concedido"]
	offer["clausulas"] = c
	offer["clausulas_hechas"] = true
	offer["seasons"] = int(c["anos"])
	_save()
	changed.emit()
	return r





