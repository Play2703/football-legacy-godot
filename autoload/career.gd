func _mi_llegada(club: String, sello: String) -> Dictionary:
	if transfers.is_empty():
		return {}
	var ult: Dictionary = transfers.back()
	if int(ult.get("season", -1)) != GameState.season_num or String(ult.get("id", "")) != club:
		return {}
	if not sello.begins_with("%d|" % GameState.season_num):
		return {}




	var origen: String = start_club
	for j in range(transfers.size() - 2, -1, -1):
		var prev: Dictionary = transfers[j]
		if bool(prev.get("loan", false)):
			continue
		origen = String(prev.get("id", ""))
		break
	var fee: int = int(ult.get("fee", 0))
	var cedido: bool = bool(ult.get("loan", false))
	return {
		"name": player_name, "pos": Squad.USER_POS, "media": ovr_shown(),
		"from": origen, "fee": fee, "free": fee <= 0 and not cedido, "loan": cedido,
		"number": GameState.shirt_number_now(), "tu": true,
	}






