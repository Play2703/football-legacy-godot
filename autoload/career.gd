func is_league_won() -> bool:



	if GameState.liguilla_activa():
		return false
	var rows: Array = GameState.league_standings()
	if rows.size() < 2:
		return false
	var first: Dictionary = rows[0]
	if String(first.get("key", "")) != GameState.YOU_KEY:
		return false
	var second: Dictionary = rows[1]
	var left: int = maxi(GameState.league_schedule.size()
		- int(second.get("pj", 0)), 0)


	if left <= 0:
		return false
	return int(first.get("pts", 0)) - int(second.get("pts", 0)) > left * 3
































static func cierra_hoy(rows: Array, total: int, you_key: String, pdiv: int,
		floor_div: int, exchange: int, con_titulo: bool = true) -> Dictionary:
	var n: int = rows.size()
	if n < 2 or total <= 0:
		return {}
	var yo: Dictionary = {}
	for r in rows:
		if String((r as Dictionary).get("key", "")) == you_key:
			yo = r
			break

	if yo.is_empty() or int(yo.get("pj", 0)) >= total:
		return {}
	var tipos: Array = [["titulo", 1]] if con_titulo else []
	if n >= 2 * exchange + 1:
		if pdiv > 1:
			tipos.append(["ascenso", mini(exchange, n - 1)])
		if pdiv < floor_div and _peleas_abajo(rows, you_key, yo, exchange):
			tipos.append(["salvacion", n - exchange])
	for t in tipos:
		var k: int = int(t[1])
		if k < 1 or _acabas_entre(rows, total, you_key, yo, 0, k):
			continue
		for pts in [1, 3]:
			if _acabas_entre(rows, total, you_key, yo, pts, k):
				return {"tipo": String(t[0]), "basta": pts}
	return {}




static func _acabas_entre(rows: Array, total: int, you_key: String, yo: Dictionary,
		hoy: int, k: int) -> bool:
	var mio: int = int(yo.get("pts", 0)) + hoy
	var alcanzan: int = 0
	for r in rows:
		var row: Dictionary = r
		if String(row.get("key", "")) == you_key:
			continue
		var quedan: int = maxi(total - int(row.get("pj", 0)), 0)
		if int(row.get("pts", 0)) + quedan * 3 >= mio:
			alcanzan += 1
			if alcanzan >= k:
				return false
	return true





const SALVACION_PELEA_PTS: int = 3









static func _peleas_abajo(rows: Array, you_key: String, yo: Dictionary,
		exchange: int) -> bool:
	var n: int = rows.size()
	var mio: int = int(yo.get("pts", 0))
	var todos: Array = []
	var encima: int = 0
	for r in rows:
		var p: int = int((r as Dictionary).get("pts", 0))
		todos.append(p)
		if String((r as Dictionary).get("key", "")) != you_key and p > mio:
			encima += 1
	if encima >= n - 2 * exchange:
		return true
	todos.sort()
	todos.reverse()

	return mio - int(todos[n - exchange]) <= SALVACION_PELEA_PTS










func jornada_decisiva() -> Dictionary:
	if retired or free_agent:
		return {}
	if String(GameState.current_fixture().get("comp", "")) != "league":
		return {}
	return cierra_hoy(GameState.league_standings(), GameState.league_rounds_yours(),
		GameState.YOU_KEY, GameState.player_div(),
		Teams.max_div(Teams.country_of(GameState.player_team_id)),
		GameState.DIV_EXCHANGE, not GameState.liguilla_activa())













static func condena_hoy(rows: Array, total: int, you_key: String, pdiv: int,
		floor_div: int, exchange: int) -> int:
	var n: int = rows.size()
	if n < 2 * exchange + 1 or total <= 0 or pdiv >= floor_div:
		return -1
	var yo: Dictionary = {}
	for r in rows:
		if String((r as Dictionary).get("key", "")) == you_key:
			yo = r
			break
	if yo.is_empty() or int(yo.get("pj", 0)) >= total:
		return -1
	if _condenado(rows, total, you_key, yo, 3, exchange):
		return -1
	for pts in [1, 0]:
		if _condenado(rows, total, you_key, yo, pts, exchange):
			return pts
	return -1



static func _condenado(rows: Array, total: int, you_key: String, yo: Dictionary,
		hoy: int, exchange: int) -> bool:
	var despues: int = maxi(total - int(yo.get("pj", 0)) - 1, 0)
	var techo: int = int(yo.get("pts", 0)) + hoy + despues * 3
	var encima: int = 0
	for r in rows:
		var row: Dictionary = r
		if String(row.get("key", "")) == you_key:
			continue
		if int(row.get("pts", 0)) > techo:
			encima += 1
	return encima >= rows.size() - exchange




func jornada_condena() -> int:
	if retired or free_agent:
		return -1
	if String(GameState.current_fixture().get("comp", "")) != "league":
		return -1
	return condena_hoy(GameState.league_standings(), GameState.league_rounds_yours(),
		GameState.YOU_KEY, GameState.player_div(),
		Teams.max_div(Teams.country_of(GameState.player_team_id)),
		GameState.DIV_EXCHANGE)



















