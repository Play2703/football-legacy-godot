func _restituye_desaparecidos(season: int) -> int:
	var club: String = GameState.player_team_id
	if club.is_empty() or Teams.is_free(club):
		return 0
	var candidatos: Array = TransferBook.desaparecidos(club)
	if candidatos.is_empty():
		return 0
	var ya: Dictionary = {}
	for fa in free_agents:
		if not (fa is Dictionary):
			continue
		ya[TransferBook.firma_nombre(String((fa as Dictionary).get("name", "")))] = true
		if String((fa as Dictionary).get("o_from", "")) == club:
			ya["#%d" % int((fa as Dictionary).get("o_idx", -1))] = true
	for p in Squad.of(club):
		ya[TransferBook.firma_nombre(String((p as Dictionary).get("name", "")))] = true
	var vueltos: int = 0
	for k in candidatos:
		var i: int = int(k)
		var nombre: String = Squad.base_name(club, i)
		if ya.has(TransferBook.firma_nombre(nombre)) or ya.has("#%d" % i):
			continue
		var base: Dictionary = TransferBook._ficha_base(club, i)
		if base.is_empty():
			continue
		var pos: String = String(base.get("pos", "MC"))
		var edad0: int = SquadEdits.age_of(club, i)
		if edad0 <= 0:
			edad0 = WorldAging._factory_age(club, i, pos)
		var edad: int = edad0 + maxi(season - 1, 0)
		if edad >= WorldAging.retire_age_of(club, i, pos, 0):
			continue
		var ficha: Dictionary = WorldAging.proyecta(base, pos, edad0, edad, 0)
		var row: Dictionary = {"name": nombre.substr(0, TransferBook.NAME_MAX),
			"age": edad, "season": season}
		for s in TransferBook.STAT_KEYS:
			row[s] = clampi(int(ficha.get(s, 70)), TransferBook.STAT_MIN, TransferBook.STAT_MAX)
		for s2 in TransferBook.STAT_KEYS_EXTRA:
			if ficha.has(s2):
				row[s2] = clampi(int(ficha[s2]), TransferBook.STAT_MIN, TransferBook.STAT_MAX)
		var nat: String = SquadEdits.nation_of(club, i)
		if nat.is_empty():
			nat = String(base.get("nat", ""))
		row["nation"] = nat.substr(0, TransferBook.NATION_MAX)
		row["from"] = club
		row["o_from"] = club
		row["o_idx"] = i
		row["pos"] = pos
		row["media"] = SquadMeta.media_of(ficha, pos)
		row["since"] = season
		var pasado: Dictionary = Squad.base_pasado(club, i)
		var etapas: Array = TransferBook.sanea_carrera(pasado.get("carrera", null))
		etapas.append({"club": club, "desde": int(pasado.get("etapa_desde", 0)),
			"hasta": season, "via": TransferBook.VIA_LIBRE})
		if etapas.size() > TransferBook.CARRERA_MAX:
			etapas = etapas.slice(etapas.size() - TransferBook.CARRERA_MAX)
		row["carrera"] = TransferBook.sanea_carrera(etapas)
		free_agents.push_front(row)
		ya[TransferBook.firma_nombre(nombre)] = true
		vueltos += 1
	return vueltos





func _cierra_desalojos() -> int:
	TransferBook.desaloja_fuera_de_rango()
	return _drena_desalojados(maxi(GameState.season_num, 1))












func _drena_desalojados(season: int) -> int:
	var lista: Array = TransferBook.saca_desalojados()
	if lista.is_empty():
		return 0
	var ya: Dictionary = {}
	for fa in free_agents:
		if fa is Dictionary:
			ya[TransferBook.firma_nombre(String((fa as Dictionary).get("name", "")))] = true
	var entran: int = 0
	for e in lista:
		var club: String = String((e as Dictionary).get("club", ""))
		var idx: int = int((e as Dictionary).get("idx", -1))
		var fila: Dictionary =(e as Dictionary).get("row", {})
		var nombre: String = String(fila.get("name", ""))
		var firma: String = TransferBook.firma_nombre(nombre)
		if nombre.is_empty() or club.is_empty() or ya.has(firma):
			continue
		var pos: String = _pos_de_desalojado(fila)
		var escrita: int = int(fila.get("season", season))
		var edad0: int = int(fila.get("age", 24))
		var edad: int = edad0 + maxi(season - escrita, 0)
		if edad >= WorldAging.retire_age_of(club, idx, pos, 0):
			continue
		var ficha: Dictionary = WorldAging.proyecta(fila, pos, edad0, edad, 0)
		var row: Dictionary = {"name": nombre.substr(0, TransferBook.NAME_MAX),
			"age": edad, "season": season}
		for s in TransferBook.STAT_KEYS:
			row[s] = clampi(int(ficha.get(s, 70)), TransferBook.STAT_MIN, TransferBook.STAT_MAX)
		for s2 in TransferBook.STAT_KEYS_EXTRA:
			if ficha.has(s2):
				row[s2] = clampi(int(ficha[s2]), TransferBook.STAT_MIN, TransferBook.STAT_MAX)
		row["nation"] = String(fila.get("nation", "")).substr(0, TransferBook.NATION_MAX)
		row["from"] = club
		var f_idx: int = int(fila.get("f_idx", TransferBook.SIN_ORIGEN))
		if f_idx >= 0 and not String(fila.get("from", "")).is_empty():
			row["o_from"] = String(fila["from"])
			row["o_idx"] = f_idx
		row["pos"] = pos
		row["media"] = SquadMeta.media_of(ficha, pos)
		row["since"] = season




		var etapas: Array = TransferBook.carrera_de_fila(fila, club)
		etapas.append({"club": club, "desde": int(fila.get("etapa_desde", escrita)),
			"hasta": season, "via": TransferBook.VIA_LIBRE})
		if etapas.size() > TransferBook.CARRERA_MAX:
			etapas = etapas.slice(etapas.size() - TransferBook.CARRERA_MAX)
		row["carrera"] = TransferBook.sanea_carrera(etapas)
		free_agents.push_front(row)
		ya[firma] = true
		entran += 1
	if free_agents.size() > FREE_AGENTS_MAX:
		free_agents = free_agents.slice(0, FREE_AGENTS_MAX)
	if entran > 0:
		print("Career: %d se quedaron sin asiento y pasan a la bolsa de libres" % entran)
	return entran







func _pos_de_desalojado(fila: Dictionary) -> String:
	var org: String = String(fila.get("from", ""))
	var f: int = int(fila.get("f_idx", TransferBook.SIN_ORIGEN))
	if not org.is_empty() and f >= 0:
		var pos_org: String = String(TransferBook._ficha_base(org, f).get("pos", ""))
		if not pos_org.is_empty():
			return pos_org
	var sin_media: Dictionary = fila.duplicate()
	sin_media.erase("media")
	var mejor: String = "MC"
	var tope: float = -1.0
	for p in Squad.OVR_WEIGHTS:
		var v: float = SquadMeta.media_of_f(sin_media, String(p))
		if v > tope:
			tope = v
			mejor = String(p)
	return mejor





func _sigma_cura(rep: Dictionary) -> Dictionary:
	var clubes: Dictionary = {}
	for c in (rep["mudanzas"] as Dictionary):
		clubes[c] = true
	for c2 in (rep["frescos"] as Dictionary):
		clubes[c2] = true
	var out: Dictionary = {}
	for c3 in clubes:
		var club: String = String(c3)
		var n: int = Squad.of_nominal(club).size()
		var sigma: Array = []
		for h in n:
			sigma.append(h)
		var mudan: Dictionary =(rep["mudanzas"] as Dictionary).get(club, {})
		var destino: Dictionary = {}
		for f in mudan:
			var hf: int = TransferBook.casa_de_libro(club, int(f))
			var hs: int = TransferBook.casa_de_libro(club, int(mudan[f]))
			if hf >= 0 and hs >= 0 and hf < n and hs < n:
				destino[hf] = hs
		for hf2 in destino:
			if not destino.has(destino[hf2]):
				sigma[destino[hf2]] = -1
		for hf3 in destino:
			sigma[hf3] = destino[hf3]
		for k in ((rep["frescos"] as Dictionary).get(club, {}) as Dictionary):
			var hk: int = TransferBook.casa_de_libro(club, int(k))
			var quien: int = sigma.find(hk)
			if hk >= 0 and quien >= 0:
				sigma[quien] = -1
		out[club] = sigma
	return out
















func _sigma_tamano() -> Dictionary:
	var out: Dictionary = {}
	for c in squad_meta:
		var club: String = String(c)
		if not (squad_meta[c] is Array) or Teams.by_id(club).is_empty():
			continue


		var n_nuevo: int = _filas_base(club)
		var n_casa: int = RosterDelta.mapa_fabrica(club, false, n_nuevo).size() \
				if RosterDelta.tiene_carrera(club) else n_nuevo
		var d: int = n_casa -(squad_meta[c] as Array).size()
		if d <= 0 or n_nuevo - d <= 0:
			continue
		var pi: Array = []
		for i in n_nuevo - d:
			pi.append(i)
		out[club] = RosterDelta.reancla_carrera(club, pi, n_nuevo - d, n_nuevo)
	if not out.is_empty():
		Squad.invalidate()
	return out



func _compone_sigmas(primero: Dictionary, despues: Dictionary) -> Dictionary:
	var out: Dictionary = despues.duplicate()
	for c in primero:
		var a: Array = primero[c]
		if not despues.has(c):
			out[c] = a
			continue
		var compuesta: Array = []
		for h in a.size():
			compuesta.append(_por_sigma(despues[c], int(a[h])))
		out[c] = compuesta
	return out





func _reancla_casa(sigmas: Dictionary, pis: Dictionary) -> void:
	if sigmas.is_empty():
		return
	Squad.invalidate()


	TransferBook.reancla_contratos(sigmas)
	for c in sigmas:
		if squad_meta.has(c):
			_remeta(String(c), sigmas[c])
		if bajas_liga.has(c):
			var nuevas: Dictionary = {}
			for h in (bajas_liga[c] as Dictionary):
				var j: int = _por_sigma(sigmas[c], int(h))
				if j >= 0:
					nuevas[j] =(bajas_liga[c] as Dictionary)[h]
			if nuevas.is_empty():
				bajas_liga.erase(c)
			else:
				bajas_liga[c] = nuevas
	var rumor: PackedStringArray = String(squad_rumor.get("seat", "")).split("#")
	if rumor.size() == 2 and sigmas.has(rumor[0]):
		var jr: int = _por_sigma(sigmas[rumor[0]], int(rumor[1]))
		if jr < 0:
			squad_rumor = {}
		else:
			squad_rumor["seat"] = "%s#%d" % [rumor[0], jr]


	var se_van: Array = []
	for m in _ai_plan:
		for lado in [["to", "to_idx"], ["from", "from_idx"]]:
			var club: String = String((m as Dictionary).get(lado[0], ""))
			var i: int = int((m as Dictionary).get(lado[1], -1))
			if sigmas.has(club) and i >= 0 and _por_sigma(sigmas[club], i) < 0:
				se_van.append("%s#%d" % [club, i])
	_plan_sin_cadena(se_van)
	for m2 in _ai_plan:
		var mm: Dictionary = m2
		for lado2 in [["to", "to_idx"], ["from", "from_idx"]]:
			var club2: String = String(mm.get(lado2[0], ""))
			var i2: int = int(mm.get(lado2[1], -1))
			if sigmas.has(club2) and i2 >= 0:
				mm[lado2[1]] = _por_sigma(sigmas[club2], i2)
		var org: Variant = mm.get("origen", null)
		if org is Dictionary and pis.has(String((org as Dictionary).get("from", ""))):
			var pi: Array = pis[String((org as Dictionary)["from"])]["pi"]
			var f: int = int((org as Dictionary).get("f_idx", -1))
			if f >= 0:
				var j2: int = int(pi[f]) if f < pi.size() else -1
				if j2 >= 0:
					(org as Dictionary)["f_idx"] = j2
				else:
					mm["origen"] = {"f_idx": TransferBook.NADIE}
	_push_seat_dev()


func _por_sigma(sigma: Array, h: int) -> int:
	return int(sigma[h]) if h >= 0 and h < sigma.size() else -1





func _remeta(team_id: String, sigma: Array) -> void:
	var viejo: Variant = squad_meta.get(team_id, null)
	if not (viejo is Array):
		return
	var squad: Array = Squad.of_nominal(team_id)
	if squad.is_empty():
		return
	squad_meta.erase(team_id)
	_ensure_squad_meta(team_id, squad)
	var nuevo: Array = squad_meta[team_id]
	for h in (viejo as Array).size():
		var j: int = _por_sigma(sigma, h)
		if j >= 0 and j < nuevo.size():
			nuevo[j] =(viejo as Array)[h]





