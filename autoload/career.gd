func gerencia_caja() -> int:
	var mio: String = GameState.player_team_id
	if mio.is_empty():
		return 0
	var clave: String = "%s|%s|%d" % [mio, _ger_memo_base(), int(club_cash.get(mio, 0))]
	if clave == _caja_memo_clave:
		return _caja_memo
	_seed_cash(mio, {})
	var cash: int = int(club_cash.get(mio, 0))
	var income: int = club_income_of(mio)
	var bill: int = ClubFinance.bill_of(mio)






	var invierno: bool = String(_ventana_proxima()["id"]) == Market.WINDOW_WINTER
	var apuro: int = ClubFinance.distress_amount(cash, bill, income)
	_caja_apuro_memo = apuro > 0



	_caja_memo = ClubFinance.window_budget(cash, income, invierno, apuro)
	_caja_memo_clave = "%s|%s|%d" % [mio, _ger_memo_base(), int(club_cash.get(mio, 0))]
	return _caja_memo







