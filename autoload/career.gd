func _tick_fair_play() -> void:
	var hoy: int = GameState.season_num
	for raw in club_ffp.keys():
		var f0: Variant = club_ffp[raw]
		if f0 is Array and int((f0 as Array)[1]) == hoy:
			return
	for raw in ffp_sancion.keys():
		if (ffp_sancion[raw] as Array).has(hoy):
			return
	var mi_pais: String = Teams.country_of(GameState.player_team_id)
	var filas: Array = []
	var nueva_sancion: bool = false
	for raw in club_cash.keys():
		var id: String = String(raw)
		var racha: int = 0
		var f: Variant = club_ffp.get(id, null)
		if f is Array:
			racha = int((f as Array)[0])
		var paso: Array = ClubFinance.ffp_paso(racha,
			ClubFinance.ffp_rompe(int(club_cash[id]), club_income_of(id)))
		var nueva: int = int(paso[0])
		var sanciona: bool = bool(paso[1])
		if sanciona:
			if not ffp_sancion.has(id):
				ffp_sancion[id] = []
			(ffp_sancion[id] as Array).append(hoy)
			club_ffp.erase(id)
			nueva_sancion = true



			if id == GameState.player_team_id and not free_agent:
				queue_ceremony(Ceremonies.FFP_SANCION, {"pts": ClubFinance.FFP_PUNTOS,
					"caja": int(club_cash[id]), "club": id})
		elif nueva > 0:
			club_ffp[id] = [nueva, hoy]
		else:
			club_ffp.erase(id)


		if (sanciona or nueva > 0) and Teams.country_of(id) == mi_pais:
			var fila: Dictionary = WorldNews.fila_fairplay(hoy - 1, GameState.season_day,
				id, sanciona)
			if not fila.is_empty():
				filas.append(fila)


	if nueva_sancion:
		SimLeague.invalida()
	_push_world_news(filas)





func sancion_pts(id: String) -> int:
