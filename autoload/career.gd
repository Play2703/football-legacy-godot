const PRENSA_ESCALON_DESDE: Array[int] = [0, 20, 45, 65, 85]



const PRENSA_ESCALON_NOMBRE: Array[String] = [
	"DESCONOCIDO", "LOCAL", "CONOCIDO", "CARA CONOCIDA", "ESTRELLA"]





const PRENSA_HISTERESIS: int = 5







const PRENSA_ESTRELLA_SALE: int = 75



const PRENSA_OLVIDO: float = 0.8











const ESTRELLA_COLCHON: int = 3











static func prensa_escalon_de(valor: int, previo: int) -> int:
	var crudo: int = 0
	for i in PRENSA_ESCALON_DESDE.size():
		if valor >= PRENSA_ESCALON_DESDE[i]:
			crudo = i

	if previo <= crudo or previo >= PRENSA_ESCALON_DESDE.size():
		return crudo
	var t: int = previo
	while t > crudo:



		var aguanta: bool = valor >= PRENSA_ESTRELLA_SALE \
				if t == PRENSA_ESCALON_DESDE.size() - 1 \
				else valor > PRENSA_ESCALON_DESDE[t] - PRENSA_HISTERESIS
		if aguanta:
			break
		t -= 1
	return t







func prensa_escalon() -> int:
	return prensa_escalon_de(rel_eff("prensa"), prensa_escalon_visto)



