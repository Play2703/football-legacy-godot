	if not (Mensajes.RESPUESTAS.get(String(f.get("tipo", "")), {}) as Dictionary).has(k):
		return {}

	if not mensaje_vivo(f):
		return {}
	match String(f.get("tipo", "")):
		Mensajes.RUMOR:
			var fx: Dictionary =((_rumor_press_event()[k] as Dictionary)["fx"] as Dictionary)
			if _court_cost_waived(fx):
				fx = fx.duplicate(true)
				fx.erase("rel")
			return fx
		Mensajes.COMPANERO:
			return {"rel": {"equipo": 1.0}}
	return {}











func mensaje_responde(i: int, k: String) -> String:
	if GameState.readonly_save or i < 0 or i >= mensajes.size():
		return ""
	var f: Dictionary = mensajes[i]
	var tipo: String = String(f.get("tipo", ""))
	if not Mensajes.pendiente(f) or not (Mensajes.RESPUESTAS.get(tipo, {}) as Dictionary).has(k):
		return ""
	if not mensaje_vivo(f):
		return ""
	var club: String = String(f.get("club", ""))
	var out: String = ""
	match tipo:
		Mensajes.RUMOR:
			if free_agent:
				return ""
			Telemetry.count("decision_contestada")
			Achievements.ingest_decision()
			var fx: Dictionary =((_rumor_press_event()[k] as Dictionary)["fx"] as Dictionary)
			var risked: String = _cobra_fx_decision(fx, club)
			_muro_escribe("rumor_abre" if k == "a" else "rumor_corta", 0, -2, "", "", club)
			if bool(fx.get("palabra", false)):
				out = I18n.t("Diste tu palabra: si te vas esta ventana o la siguiente, tu grada te lo cobrará.")
			elif bool(fx.get("rumor_fan", false)):
				out = I18n.tf("Le abriste la puerta a {0}. Atento al mercado.",
					[mensaje_quien(f)])
			else:
				out = risked
		Mensajes.COMPANERO:
			var nombre: String = String(f.get("quien", ""))
			_apply_delta("equipo", 1.0)
			_bump_socio(nombre, 2, GameState.player_team_id,
				Squad.of_nominal(GameState.player_team_id))
			mensajes_gracias[nombre] = GameState.season_num
			_muro_escribe("gracias_pase", 0)
			out = mensaje_tu_texto(f.merged({"resp": k}, true))
		Mensajes.HINCHA:
			out = mensaje_tu_texto(f.merged({"resp": k}, true))
	f["resp"] = k
	f["visto"] = true
	_save()
	changed.emit()
	return out







