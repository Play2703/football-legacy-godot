func can_renew() -> bool:

	if club_gave_up:
		return false


	if impago_carta():
		return false


	if on_loan():
		return false

	if not pending_precontract.is_empty():
		return false


	if concurso_tuyo():
		return false
	return int(contract["seasons_left"]) <= 1 and int(rel["tecnico"]) >= 30














const RENEW_MAX_SEASONS: int = ContractTerms.YEARS_MAX
const RENEW_PERF_MIN_MATCHES: int = ContractTerms.PERF_MIN_MATCHES




















func renewal_offer() -> Dictionary:
	var o: Dictionary = _renewal_post(_offer_from_terms(ContractTerms.Table.RENOVACION))


	var c: Dictionary = _clausulas_club_vigentes("renov")
	if not c.is_empty() and clausulas_club_pack() == "equilibrio":
		_aplica_clausulas_club(o, c)
	return o










func _renewal_post(o: Dictionary) -> Dictionary:



	var w: int = _talks_wage(int(round(float(o.get("wage", 0)) * rasgo_club("oferta"))))
	w = int(round(float(w) * Market.project_wage_factor(_project_cuts)))





	var ahora: int = int(o.get("wage_now", int(contract["wage"])))




	var negociado: bool = int(contract.get("talks_season", -1)) == GameState.season_num \
			and int(contract.get("talks_wage", 0)) > 0
	if negociado:
		o["floored"] = false
	elif bool(o.get("floored", false)) and ahora > 0 and w < ahora:
		w = ahora
	o["wage"] = w
	o["delta"] = w - ahora
	return o














func renewal_packages() -> Array:
	var out: Array = _renewal_packages_raw()




	var c: Dictionary = _clausulas_club_vigentes("renov")
	if c.is_empty() or out.is_empty():
		return out
	var pack: String = clausulas_club_pack()
	var elegido: Dictionary = out[0]
	for o in out:
		if String((o as Dictionary).get("pack", "")) == pack:
			elegido = o
	_aplica_clausulas_club(elegido, c)
	return [elegido]


func _renewal_packages_raw() -> Array:
	var negotiated: bool = int(contract.get("talks_season", -1)) == GameState.season_num \
			and int(contract.get("talks_wage", 0)) > 0
	var eq: Dictionary = renewal_offer()
	eq["pack"] = "equilibrio"
	_annotate_clause(eq, false)
	if negotiated:
		return [eq]
	var out: Array = []
	for t in ContractTerms.packages(contract_ctx(), ContractTerms.Table.RENOVACION):
		var pack: String = String(t["pack"])
		if pack == "equilibrio":
			out.append(eq)
			continue
		var o: Dictionary = _renewal_post(_offer_from_terms(
			ContractTerms.Table.RENOVACION, t))
		o["pack"] = pack
		_annotate_clause(o, bool(t.get("clause_free", false)),
			bool(t.get("clause_flag", false)))
		if pack == "dinero" and int(o["wage"]) <= int(eq["wage"]):
			continue
		if pack == "seguridad" and int(o["seasons"]) <= int(eq["seasons"]):
			continue


		if pack == "bandera" and int(o["wage"]) <= int(eq["wage"]) \
				and int(o.get("signing_bonus", 0)) <= int(eq.get("signing_bonus", 0)):
			continue
		out.append(o)
	return out






func _annotate_clause(o: Dictionary, libre: bool, bandera: bool = false) -> void:
	o["clause_free"] = libre
	o["clause_flag"] = bandera and not libre
	o["clause"] = Market.release_clause(market_value(),
		Teams.rating(GameState.player_team_id), libre, bandera and not libre)














func _offer_from_terms(mesa: ContractTerms.Table, t_in: Dictionary = {}) -> Dictionary:
	var st: Dictionary = standing()
	var t: Dictionary = t_in if not t_in.is_empty() \
			else ContractTerms.terms(contract_ctx(), mesa)
	var left: int = int(contract["seasons_left"])
	var years: int = int(t["seasons"])
	var wage: int = int(t["wage"])
	var wage_now: int = int(contract["wage"])
	var role: Standing.ContractRole = Standing.contract_role_of(float(st["edge"]))
	return {
		"seasons": years,
		"left": left,
		"total": left + years,
		"wage": wage,
		"wage_now": wage_now,
		"delta": wage - wage_now,
		"role": Standing.contract_role_key(role),
		"role_name": Standing.contract_role_name(role),



		"perf": float(t["perf"]),
		"perf_pct": int(round(ContractTerms.PERF_SPAN * float(t["perf"]) * 100.0)),
		"capped": bool(t["capped"]),


		"anchored": bool(t.get("anchored", false)),


		"floored": bool(t.get("floored", false)),



		"signing_bonus": int(t["signing_bonus"]),
		"obj_bonus": int(t["obj_bonus"]),
		"stature": float(t["stature"]),
		"why": t["why"],
	}



















func renewal_performance() -> float:
	return ContractTerms.season_perf(season_avg(), season_matches)


func renew_contract(pack: String = "equilibrio") -> void:
	if not can_renew():
		return




	var offer: Dictionary = renewal_offer()


	if not _clausulas_club_vigentes("renov").is_empty():
		offer = renewal_packages()[0]
	elif pack != "equilibrio":
		for p in renewal_packages():
			if String(p.get("pack", "")) == pack:
				offer = p
				break




	_cobra_firma(int(offer.get("signing_bonus", 0)))
	contract["wage"] = int(offer["wage"])

	_tifo_deber("renovacion")


	contract["seasons_left"] = int(offer["total"])





	contract["role"] = String(offer["role"])
	_role_climb = 0


	contract["talks_wage"] = 0




	contract["last_talks_season"] = GameState.season_num
	contract["talks_open_season"] = -1



	_stamp_clause(GameState.player_team_id, bool(offer.get("clause_free", false)),
		bool(offer.get("clause_flag", false)))

	_stamp_clausulas_club(offer)
	rel["aficion"] = mini(100, int(rel["aficion"]) + 8)
	pending_offers = []



	counter_offer = {}
	unsettled = false




	_forced_sale_refused = 0
	_refuse_paid = false


	var left: int = int(contract["seasons_left"])




	queue_ceremony(Ceremonies.PRESSER, {
		"mode": "renewal", "seasons": left, "wage": int(contract["wage"]),
	})



	_offer_contract_shirt(SHIRT_MODE_RENEW)
	_save()
	changed.emit()
















const RENEG_TECNICO_MIN: int = 40


const RENEG_AVG_MIN: float = 7.0
const RENEG_AVG_MIN_TITULAR: float = 6.7










const RENEG_MAX_LEFT: int = 3




const RENEG_SETTLE_SEASONS: int = 1










const RENEG_SIT_BASE: float = 0.45
const RENEG_SIT_TECNICO: float = 0.35
const RENEG_SIT_STATURE: float = 0.2
const RENEG_SIT_MAX: float = 0.92












const RENEG_CLUB_MAX_LEFT: int = 4
const RENEG_CLUB_EXTRA: float = 0.3
const RENEG_CLUB_P_BASE: float = 0.35
const RENEG_CLUB_P_STATURE: float = 0.45



static func _es_decimal(x: float) -> String:
	return ("%.1f" % x).replace(".", ",")






func renegotiation_gate() -> Dictionary:




	if renegotiation_open():
		return {"ok": true, "why": "", "missing": []}



	if free_agent:
		return {"ok": false, "why": "Eres agente libre: negocia con un club nuevo.", "missing": ["free_agent"]}
	if on_loan():
		return {"ok": false, "why": "Estás cedido: tu contrato lo lleva el club dueño.", "missing": ["loan"]}
	if not pending_precontract.is_empty():
		return {"ok": false, "why": "Ya firmaste un precontrato con otro club.", "missing": ["precontract"]}
	if club_gave_up:
		return {"ok": false, "why": "El club te dio por perdido; no hay mesa.", "missing": ["gave_up"]}
	if transfer_requested or unsettled:
		return {"ok": false, "why": "Pediste salir: arréglalo con el club antes de negociar.", "missing": ["leaving"]}


	if concurso_tuyo():
		return {"ok": false, "why": "Tu club está en concurso: hasta el mercado de invierno no se toca un contrato.", "missing": ["concurso"]}

	if int(contract.get("last_talks_season", -1)) == GameState.season_num:



		if int(contract.get("talks_refused_season", -1)) == GameState.season_num:
			return {"ok": false, "why": "El club no se sentó contigo este año. Vuelve la temporada que viene.", "missing": ["refused"]}
		return {"ok": false, "why": "Ya renegociaste esta temporada. Vuelve el año que viene.", "missing": ["cooldown"]}




	if can_renew():
		return {"ok": false, "why": "Es tu último año: el club ya te ofrece renovar.", "missing": ["renewal"]}

	if GameState.season_num - _contract_signed_season < RENEG_SETTLE_SEASONS:
		return {"ok": false, "why": "Acabas de firmar: cumple una temporada antes de pedir mejora.", "missing": ["fresh"]}

	if int(contract.get("seasons_left", 0)) > RENEG_MAX_LEFT:
		return {"ok": false, "why": "Te queda mucho contrato: el club no tiene por qué moverlo.", "missing": ["long"]}















	var mer: Dictionary = _reneg_merito()
	if bool(mer["corta"]):
		return {"ok": false, "why": "Aún no jugaste lo suficiente esta temporada.", "missing": ["matches"]}
	var media: float = float(mer["media"])
	var need: float = float(mer["need"])
	var revienta: bool = bool(mer["revienta"])
	if media < need and not revienta:




		return {"ok": false, "why": I18n.tf("Sube tu media a {0} para sentarte a negociar.", [_es_decimal(need)]), "missing": ["avg"]}
	if int(rel["tecnico"]) < RENEG_TECNICO_MIN:
		return {"ok": false, "why": "Gánate al técnico antes de pedir mejora.", "missing": ["tecnico"]}






	if not Market.window_open(GameState.season_day, GameState.winter_day()):
		return {"ok": false, "why": "El club no negocia fichas con el mercado cerrado.", "missing": ["window"]}
	return {"ok": true, "why": "", "missing": []}





func _reneg_merito() -> Dictionary:
	var muestra: int = season_matches
	var media: float = season_avg()
	var juzga_cerrada: bool = false
	if muestra < ContractTerms.PERF_MIN_MATCHES:
		var cerrada: Dictionary = _temporada_cerrada()
		if int(cerrada.get("apps", 0)) >= ContractTerms.PERF_MIN_MATCHES:
			muestra = int(cerrada["apps"])
			media = float(cerrada.get("avg", media))
			juzga_cerrada = true
	if muestra < ContractTerms.PERF_MIN_MATCHES:
		return {"corta": true, "media": media, "need": 0.0, "revienta": false}
	var cr: Standing.ContractRole = Standing.contract_role_from_key(String(contract.get("role", "rotacion")))
	var need: float = RENEG_AVG_MIN_TITULAR if cr >= Standing.ContractRole.TITULAR else RENEG_AVG_MIN















	var revienta: bool = false
	if juzga_cerrada:
		var od: Variant = last_report.get("obj_done", {})
		if od is Dictionary and int((od as Dictionary).get("target", 0)) > 0 \
				and String((od as Dictionary).get("type", "")) != "position":
			revienta = float(int((od as Dictionary).get("progress", 0))) \
					/ float((od as Dictionary)["target"]) >= Market.DELIVERY_UP_FROM
	else:
		var pa: Dictionary = objective_pace()
		revienta = int(pa.get("target", 0)) > 0 and int(pa.get("projected", -1)) > 0 \
				and float(pa["projected"]) / float(pa["target"]) >= Market.DELIVERY_UP_FROM
	return {"corta": false, "media": media, "need": need, "revienta": revienta}




func renegotiation_club_offered() -> bool:
	return renegotiation_open() \
			and int(contract.get("club_ofrece_season", -1)) == GameState.season_num





func _club_ofrece_mejora(window: String) -> bool:
	var sello: String = "%d|%s" % [GameState.season_num, window]
	if String(contract.get("club_ofrece_tirada", "")) == sello:
		return false
	if free_agent or on_loan() or not pending_precontract.is_empty() or club_gave_up \
			or transfer_requested or unsettled or for_sale or renegotiation_open() \
			or can_renew() or concurso_tuyo():
		return false
	if int(contract.get("last_talks_season", -1)) == GameState.season_num:
		return false
	if GameState.season_num - _contract_signed_season < RENEG_SETTLE_SEASONS:
		return false
	if int(contract.get("seasons_left", 0)) > RENEG_CLUB_MAX_LEFT:
		return false
	var mer: Dictionary = _reneg_merito()
	if bool(mer["corta"]):
		return false


	if float(mer["media"]) < float(mer["need"]) + RENEG_CLUB_EXTRA \
			and not bool(mer["revienta"]):
		return false
	contract["club_ofrece_tirada"] = sello
	var st: float = float(ContractTerms.terms(contract_ctx(),
		ContractTerms.Table.RENOVACION).get("stature", 0.0))
	var p: float = RENEG_CLUB_P_BASE + RENEG_CLUB_P_STATURE * clampf(st, 0.0, 1.0)
	if randf() >= p:
		return true

	contract["talks_open_season"] = GameState.season_num
	var o: Dictionary = renegotiation_offer()
	if int(o.get("delta", 0)) <= 0 and not bool(o.get("role_up", false)) \
			and float(o.get("goal_bonus_add", 0.0)) <= 0.0 \
			and float(o.get("assist_bonus_add", 0.0)) <= 0.0:
		contract["talks_open_season"] = -1
		return true
	contract["club_ofrece_season"] = GameState.season_num
	return true






func renegotiation_open() -> bool:
	return int(contract.get("talks_open_season", -1)) == GameState.season_num










func renegotiation_sit_p() -> float:
	if peldano() >= Gerencia.PELDANO_MESA:
		return 1.0
	var st: float = float(ContractTerms.terms(contract_ctx(),
		ContractTerms.Table.RENOVACION).get("stature", 0.0))
	var p: float = RENEG_SIT_BASE \
			+ RENEG_SIT_TECNICO *(float(rel["tecnico"]) / 100.0) \
			+ RENEG_SIT_STATURE * clampf(st, 0.0, 1.0)
	return minf(p, RENEG_SIT_MAX)










func request_renegotiation() -> Dictionary:
	if renegotiation_open():
		return {"ok": true, "p": 1.0}
	if not bool(renegotiation_gate()["ok"]):
		return {"ok": false, "p": 0.0}
	var p: float = renegotiation_sit_p()
	if randf() < p:
		contract["talks_open_season"] = GameState.season_num
		_save()
		changed.emit()
		return {"ok": true, "p": p}



	contract["last_talks_season"] = GameState.season_num
	contract["talks_refused_season"] = GameState.season_num



