		if k != "signing" and k != "loan":
			continue
		var idx: int = int(mm.get("from_idx", -1))
		if idx < 0 or idx == yo:
			continue
		if int(mm.get("cae", -1)) <= GameState.season_day:
			continue
		cands.append(mm)
	if cands.is_empty():
		return












	var tope: int = 0
	for c in cands:
		tope = maxi(tope, int((c as Dictionary).get("fee", 0)))
	var suelo: int = int(round(float(tope) * RUMOR_FEE_BAND))
	var mejor: Dictionary = {}
	var mejor_v: int = -1
	for c in cands:
		var cc: Dictionary = c
		var fee: int = int(cc.get("fee", 0))
		if fee < suelo:
			continue
		var v: int = socio_v(String(cc.get("name", "")))
		if mejor.is_empty() or v > mejor_v \
				or (v == mejor_v and fee > int(mejor.get("fee", 0))):
			mejor = cc
			mejor_v = v
	if mejor.is_empty():
		return
	squad_rumor = {
		"name": String(mejor.get("name", "")),
		"pos": String(mejor.get("pos", "MC")),
		"media": int(mejor.get("media", 0)),
		"to": String(mejor.get("to", "")),
		"fee": int(mejor.get("fee", 0)),
		"cae": int(mejor.get("cae", 0)),





		"idx": int(mejor.get("from_idx", -1)),
		"seat": "%s#%d" % [mine, int(mejor.get("from_idx", -1))],
		"season": GameState.season_num,
		"hablado": false,
		"encolado": false,
	}









func _maybe_squad_talk() -> void:
	if squad_rumor.is_empty() or free_agent or on_loan() or retired:
		return
	if bool(squad_rumor.get("hablado", false)) \
			or bool(squad_rumor.get("encolado", false)):
		return
	if int(squad_rumor.get("season", -1)) != GameState.season_num:
		return
	if int(squad_rumor.get("cae", 0)) <= GameState.season_day:
		return
	squad_rumor["encolado"] = true
	queue_ceremony(Ceremonies.SQUAD_TALK, {
