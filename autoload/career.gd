func _board_tu_lista() -> String:
	match String(estatus_club().get("salida", "")):
		"EN VENTA", "PEDISTE SALIR":
			return "venta"
		"EN CESIÓN":
			return "cesion"
		"NO TE VENDEN":
			return "intocables"
	return ""















func _board_intocables(fuera: Dictionary, cupo: int) -> Array:
	if cupo <= 0:
		return []
	var cands: Array = []
	for r in squad_roster():
		var row: Dictionary = r
		if bool(row.get("is_you", false)):
			continue
		var nombre: String = String(row.get("name", ""))
		if nombre.is_empty() or fuera.has(nombre):
			continue
		if int(row.get("injury_weeks", 0)) >= 12:
			continue
		var media: int = int(row.get("media", 0))
		var peso: float = float(media)
		if int(row.get("gp", 0)) >= 5:
			peso +=(float(row.get("avg", 6.5)) - 6.5) * 4.0
		cands.append({"row": row, "peso": peso})
	cands.sort_custom(func(a, b): return float(a["peso"]) > float(b["peso"]))
	var out: Array = []
	for c in cands.slice(0, cupo):
		var row: Dictionary = c["row"]
		out.append({
			"name": String(row.get("name", "")),
			"pos": String(row.get("pos", "MC")),
			"media": int(row.get("media", 0)),
			"club": "",
			"fee": 0,
			"kind": "intocable",
			"rumor": false,
		})
	return out












