func _fx_reincide_fx(fx: Dictionary) -> Dictionary:
	if float(fx.get("multa", 0.0)) <= 0.0 or bool(fx.get("reincide", false)):
		return fx
	var c: Dictionary = Comunicado.castigo(_comunicado_marca_viva(), Comunicado.PRENSA)
	if not Comunicado.cobra(c):
		return fx
	var out: Dictionary = fx.duplicate(true)
	out["reincide"] = true
	if float(c["factor"]) > 1.0:
		out["multa"] = float(fx["multa"]) * float(c["factor"])
		out["multa_doble"] = true
	var tec: int = int(c["tec"])
	if tec != 0:
		out["reincide_tec"] = tec
		var pts: Dictionary = {}
		var rels: Dictionary = Dictionary(fx.get("rel", {}))
		for k in rels:
			var n: int = projected_delta(String(k), float(rels[k]))
			if n != 0:
				pts[String(k)] = n
		pts["tecnico"] = int(pts.get("tecnico", 0)) + tec
		out["rel_pts"] = pts
	return out




func _fx_reincide(e: Dictionary) -> Dictionary:
	if e.is_empty() or _comunicado_marca_viva().is_empty():
		return e
	var out: Dictionary = e
	for k in ["a", "b", "c"]:
		if not (out.get(k) is Dictionary) or not (Dictionary(out[k]).get("fx") is Dictionary):
			continue
		var fx: Dictionary = Dictionary(out[k])["fx"]
		var nuevo: Dictionary = _fx_reincide_fx(fx)
		if nuevo == fx:
			continue
		if out == e:
			out = e.duplicate(true)
		(out[k] as Dictionary)["fx"] = nuevo
	return out






