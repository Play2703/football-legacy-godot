func _compute_counter_offer() -> void:


	var had: bool = not counter_offer.is_empty()
	counter_offer = {}









	if pending_offers.is_empty() or transfer_requested or unsettled or for_sale \
			or int(contract["seasons_left"]) > 1 or not _club_values_you() or concurso_tuyo():
		return
	var now_wage: int = int(contract["wage"])
	var best: int = now_wage
	for o in pending_offers:
		best = maxi(best, int(o.get("wage", 0)))






	var o_ret: Dictionary = _offer_from_terms(ContractTerms.Table.RETENCION)







	var techo: int = Market.wage_cap(GameState.player_team_id,
		Teams.rating(GameState.player_team_id), float(o_ret.get("stature", 0.0)))
	var suelo: int = int(float(best) * 0.85)










	var mesa_ret: int = int(round(float(o_ret["wage"]) * rasgo_club("oferta")))
	var base_ret: int = mini(maxi(mesa_ret, suelo), maxi(techo, now_wage))
	var wage_ret: int = _talks_wage(base_ret)
	counter_offer = {
		"wage": wage_ret,
		"seasons": int(o_ret["seasons"]),
		"bonus": int(o_ret["signing_bonus"]),
		"stature": float(o_ret["stature"]),
	}



	if not had:
		pass




func accept_counter() -> void:
	if counter_offer.is_empty():
		return



	if int(contract["seasons_left"]) > 1:
		counter_offer = {}
		changed.emit()
		return



	_cobra_firma(int(counter_offer.get("bonus", 0)))
	contract["wage"] = int(counter_offer.get("wage", contract["wage"]))



	contract["seasons_left"] = mini(RENEW_MAX_SEASONS,
		int(contract["seasons_left"]) + int(counter_offer.get("seasons", 3)))
	_stamp_clause(GameState.player_team_id)





	if salida_motivo.has(Salida.VIA_TRASPASO):
		var motivo_ret: String = String(Dictionary(
			salida_motivo[Salida.VIA_TRASPASO]).get("motivo", ""))
		_salida_aplica(Salida.retract_fx(motivo_ret))
	rel["aficion"] = mini(100, int(rel["aficion"]) + 8)
	rel["tecnico"] = mini(100, int(rel["tecnico"]) + 5)

	contract["talks_wage"] = 0
	counter_offer = {}
	pending_offers = []
	transfer_requested = false
	_cierra_motivo(Salida.VIA_TRASPASO, Salida.RETIRADO)


	_offer_contract_shirt(SHIRT_MODE_RENEW)
	_save()
	changed.emit()

















func _ensure_rival() -> void:
	var my_id: String = GameState.player_team_id
	if my_id == "":
		return
	var canon: String = Rivalries.rival_of(my_id)
	if canon != "" and GameState.div_of(canon) == GameState.player_div():
		rival_id = canon
		return




	for e in Rivalries.extras_of(my_id):
		if GameState.div_of(String(e)) == GameState.player_div():
			rival_id = String(e)
			return



	var my_div: int = GameState.player_div()
	var my_rating: int = Teams.rating(my_id)
	var best: String = ""
	var best_gap: int = 1<<30
	for t in Teams.teams_of_country(Teams.country_of(my_id)):
		var tid: String = String(t["id"])
		if tid == my_id or tid == canon or GameState.div_of(tid) != my_div:
			continue
		var gap: int = absi(int(t.get("rating", 62)) - my_rating)

		if gap < best_gap or (gap == best_gap and tid < best):
			best_gap = gap
			best = tid
	rival_id = best






func is_derby(opponent_id: String) -> bool:
