func _ahijado_del_adios(casa: String) -> Dictionary:
	var planteles: Dictionary = {}
	for c: String in [casa, GameState.player_team_id]:
		if not c.is_empty() and not planteles.has(c):
			planteles[c] = Squad.of_nominal(c)
	return Juveniles.ahijado_en(juveniles, planteles)















func _club_de_mas_anos() -> Dictionary:
	var cuenta: Dictionary = {}
	var orden: Array[String] = []
	for row in season_history:
		var r: Dictionary = row as Dictionary
		if bool(r.get("loan", false)):
			continue
		var c: String = String(r.get("club", ""))
		if c.is_empty():
			continue
		if not cuenta.has(c):
			orden.append(c)
		cuenta[c] = int(cuenta.get(c, 0)) + 1








	var mejor: String = ""
	var n: int = 0
	for c in orden:
		if int(cuenta[c]) > n:
			mejor = String(c)
			n = int(cuenta[c])
	if mejor.is_empty():
		return {"club": GameState.player_team_id, "seasons": 0}
	return {"club": mejor, "seasons": n}















func _cifras_en_club(club: String) -> Dictionary:
	var pj: int = 0
	var g: int = 0
	var a: int = 0
	for row in season_history:
		var r: Dictionary = row as Dictionary
		if bool(r.get("loan", false)) or String(r.get("club", "")) != club:
			continue
		pj += int(r.get("apps", 0))
		g += int(r.get("goals", 0))
		a += int(r.get("assists", 0))
	return {"matches": pj, "goals": g, "assists": a}





func _club_de_debut() -> String:
	for row in season_history:
		var c: String = String((row as Dictionary).get("club", ""))
		if not c.is_empty():
			return c
	return GameState.player_team_id


















func _top_flight_line() -> Dictionary:
	var apps: int = 0
	var goals: int = 0
	var assists: int = 0
	var rating_sum: float = 0.0
	var clubs: Array = []
	for row in season_history:
		var h: Dictionary = row
		if int(h.get("div", 1)) != 1:
			continue
		var n: int = int(h.get("apps", 0))
		apps += n
		goals += int(h.get("goals", 0))
		assists += int(h.get("assists", 0))
		rating_sum += float(h.get("avg", 0.0)) * float(n)
		var cid: String = String(h.get("club", ""))
		if not cid.is_empty() and not clubs.has(cid):
			clubs.append(cid)
	if GameState.player_div() == 1:
		apps += season_matches
		goals += season_goals
		assists += season_assists
		rating_sum += season_avg() * float(season_matches)
		if not GameState.player_team_id.is_empty() \
				and not clubs.has(GameState.player_team_id):
			clubs.append(GameState.player_team_id)
	return {
		"matches": apps,
		"goals": goals,
		"assists": assists,
		"clubs": clubs.size(),
		"avg":(rating_sum / float(apps)) if apps > 0 else 0.0,
	}













