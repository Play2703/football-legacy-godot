	_decision_recent.erase(id)
	_decision_recent.push_front(id)
	while _decision_recent.size() > DECISION_MEMORY:
		_decision_recent.pop_back()












func _decision_ctx(base: Dictionary) -> Dictionary:
	var ctx: Dictionary = base.duplicate()



	ctx["shirt"] = _coveted_shirt() > 0





	ctx["socio"] = not socios_top(1).is_empty()


	ctx["reconversion"] = not puesto_que_te_pide().is_empty()



	ctx["veto"] = scene_veto.keys()

	ctx["newcomer"] = club_matches < NEW_AT_CLUB_MATCHES



	ctx["captain"] = is_captain





	ctx["captain_blocked"] = _captain_blocked_season == GameState.season_num




	ctx["casi_capitan"] = peldano() == Gerencia.PELDANO_CAPITAN - 1 \
			and peldano_puede_capitan() and gerencia_relacion() \
			>= Gerencia.peldano_umbral(Gerencia.PELDANO_CAPITAN) - Gerencia.PELDANO_BAJA



	ctx["played"] = int(base.get("minutes", 0)) > 0
	ctx["scored"] = int(base.get("goals", 0)) > 0



	ctx["standout"] = ctx["played"] and float(base.get("rating", 0.0)) >= 7.5



	ctx["benched"] = int(base.get("minutes", 0)) < 45


	ctx["slumping"] = slump_active() or form <= -2


	ctx["last_year"] = int(contract.get("seasons_left", 9)) <= 1 \
			and loan.is_empty() and not free_agent


	ctx["famous"] = _es_famoso()


	ctx["estrella"] = es_estrella()













	ctx["tecnico_harto"] = rel_eff("tecnico") <= ULTIMATUM_REL \
			and bool(ctx["slumping"]) and not ultimatum_activo()




	ctx["equipo_roto"] = rel_eff("equipo") <= 20











	ctx["aficion_idolo"] = rel_eff("aficion") >= 90
	ctx["equipo_unido"] = rel_eff("equipo") >= 85
	ctx["tecnico_padre"] = rel_eff("tecnico") >= 90


	ctx["tecnico_frio"] = rel_eff("tecnico") <= 20
	ctx["ultimatum_win"] = last_ultimatum == "win"
	ctx["ultimatum_fail"] = last_ultimatum == "fail"
	var _prox: String = String(GameState.next_fixture().get("opp", ""))
	ctx["pre_derby"] = not _prox.is_empty() and is_derby(_prox) \
			and not spicy_at(_prox)

	ctx["spicy_vivo"] = not _prox.is_empty() and spicy_at(_prox)




	var _prox_fx: Dictionary = GameState.next_fixture()
	ctx["tifo_derbi_libre"] = bool(_prox_fx.get("home", false)) \
			and String(_prox_fx.get("comp", "")) != "nat" \
			and GameState.player_div() < 3 \
			and club_number(GameState.player_team_id) > 0 \
			and (tifo_pagado.is_empty()
			or int(tifo_pagado.get("temp", -9)) != GameState.season_num)



	ctx["arranque_temporada"] = GameState.season_day <= 3





	ctx["house_owner"] = house_level >= 1
	ctx["house_top"] = house_level >= House.count() - 1
	ctx["house_pet"] = not House.pet_owned(house_extras).is_empty()
	ctx["house_pool"] = house_extras.has("piscina")
	ctx["house_grill"] = house_extras.has("asador")




	ctx["broke"] = loan.is_empty() and club_distress() > 0


	ctx["hurt"] = injury_weeks > 0



	ctx["final_next"] = _final_ahead()




	ctx["wants_out"] = transfer_requested and loan.is_empty() and not free_agent





	ctx["for_sale"] =(for_sale or forced_sale or unsettled) \
			and loan.is_empty() and not free_agent and not transfer_requested







	ctx["rival"] = not rival_striker_info().is_empty()



	ctx["rival_rompible"] = _rival_rompible()
	ctx["capitan_otro"] = not captain_name().is_empty()

	ctx["capitan_penales_pide"] = is_captain and not capitan_penales \
			and not _is_team_specialist("penal", GameState.player_team_id) \
			and season_pen_cedidos_fallados >= PEN_CEDIDOS_FALLADOS

	ctx["nueve_del_tecnico"] = nueve_del_tecnico()






	ctx["top_flight"] = _player_div() == 1
	ctx["lower_league"] = _player_div() == 3



	ctx["nat_debut"] = nat_caps <= 1







	ctx["soltero"] = not pareja_activa()
	ctx["con_pareja"] = pareja_activa()



	ctx["pareja_formal"] = pareja_activa() \
			and String(pareja.get("estado", "")) in CONVIVEN




	ctx["pareja_baja"] = pareja_activa() and int(rel["pareja"]) < 35
	ctx["pareja_alta"] = pareja_activa() and int(rel["pareja"]) > 75


	ctx["pareja_mudable"] = pareja_activa() \
			and int(rel["pareja"]) > PAREJA.mudanza_de(String(pareja.get("id", "")))


	ctx["cita_1"] = pareja_activa() and citas_hechas == 0
	ctx["cita_2"] = pareja_activa() and citas_hechas == 1
	ctx["cita_3"] = pareja_activa() and citas_hechas == 2



	ctx["citas_hechas"] = citas_hechas >= 3



	ctx["pareja_interesada"] = pareja_activa() and pareja_pago <= 0.0 \
			and PAREJA.interes_de(String(pareja.get("id", ""))) >= PAREJA.INTERES_PIDE















	ctx["puede_pedirselo"] = String(pareja.get("estado", "")) == "pareja" \
			and int(rel["pareja"]) > PAREJA.BODA_BARRA and not pareja_lejos() \
			and (GameState.season_num - int(pareja.get("juntos",
			pareja.get("desde", GameState.season_num))) >= PAREJA.BODA_TEMPORADAS
			or GameState.season_num - int(pareja.get("desde", GameState.season_num))
				>= PAREJA.BODA_ANOS_PAREJA)
	ctx["prometido"] = String(pareja.get("estado", "")) == "prometido"



	ctx["caza"] = pareja_activa() and PAREJA.arruina(String(pareja.get("id", "")))
	ctx["no_caza"] = not bool(ctx["caza"])
	ctx["casado"] = pareja_casada()



	ctx["aniversario"] = pareja_activa() \
			and String(pareja.get("estado", "")) in CONVIVEN \
			and pareja_anios() >= 1 and pareja_aniv_visto() < GameState.season_num


	ctx["hubo_ex"] = not (pareja.get("historial", []) as Array).is_empty()









	var _casado_frio: bool = pareja_casada()





	ctx["pareja_enfria"] = _casado_frio and pareja_frio < PAREJA.FRIO_PASOS \
			and (pareja_frio > 0 or bool(pareja.get("enfria", false))
			or int(rel["pareja"]) < 30)


	for _i in range(PAREJA.FRIO_PASOS):
		ctx["pareja_frio_%d" % _i] = pareja_frio == _i




	ctx["divorcio_cerca"] = _casado_frio and pareja_frio >= PAREJA.FRIO_PASOS


	ctx["caza_tasa"] = pareja_casada() and bool(pareja.get("tasa", false))

	ctx["pareja_viaje"] = pareja_activa() and bool(pareja.get("viaje", false))

	ctx["pareja_lesion"] = pareja_activa() and bool(pareja.get("lesion", false))




	var _cand: String = pareja_candidata() if not pareja_activa() else ""
	var _sitio: String = PAREJA.sitio_de(_cand) if not _cand.is_empty() else ""
	for _s in ["cena", "bar", "galeria", "calle"]:
		ctx["cand_" + _s] = _sitio == _s


	var _perfil: Dictionary = pareja_perfil()




	var _rasgo: String = String(_perfil.get("rasgo", ""))
	for p in PAREJA.PERFILES:
		ctx["pareja_" + String(p["rasgo"])] = _rasgo == String(p["rasgo"])
	return ctx













func captain_name() -> String:
	if is_captain or GameState.player_team_id.is_empty():
		return ""
	return Squad.captain_name(GameState.player_team_id)






func club_distress() -> int:
	var id: String = GameState.player_team_id
	if id.is_empty():
		return 0









	var inc: int = club_income_of(id)
	_seed_cash(id, {})
	return ClubFinance.distress_amount(int(club_cash.get(id, 0)),
		ClubFinance.bill_of(id), inc)






func _final_ahead() -> bool:
	for f in [GameState.next_fixture(), GameState.current_fixture()]:
		if f.is_empty():
			continue
		if GameState.fixture_is_knockout(f) \
				and Competitions.FINAL_ROUNDS.has(String(f.get("round", ""))):
			return true
	return false












func _is_final(fx: Dictionary) -> bool:
	if fx.is_empty():
		return false
	return GameState.fixture_is_knockout(fx) and Competitions.stage_of(fx) == "FINAL"


func _roll_post_match_decision(ctx: Dictionary) -> void:
	pending_decision_club = ""
	pending_decision_club_b = ""




	if bool(ctx.get("newcomer", false)) and not bool(ctx.get("nat", false)):
		var arrival: String = WeekEvents.roll_arrival(randf(), randf(), ctx,
			_arrival_seen)
		if not arrival.is_empty():
			pending_decision = arrival
			_arrival_seen.append(arrival)
			return
	pending_decision = WeekEvents.roll_post_match(not sponsors.is_empty(),
		randf(), randf(), ctx, _decision_recent)










	if pending_decision.is_empty() and not market_open() and _rumor_press_club() != "" \
			and _irse_hace >= IRSE_HUECO and randf() < RUMOR_PRESS_P:



		if prensa_escalon() >= 3 and _msj_rumor_buzon(_rumor_press_club()):
			return
		pending_decision = RUMOR_PRESS_EVENT_ID
		pending_decision_club = _rumor_press_club()
		_rumor_asked.append(pending_decision_club)
		_irse_hace = 0
		return
	if pending_decision.is_empty() and _market_scene_open() \
			and _irse_hace >= IRSE_HUECO and randf() < MARKET_INTEREST_P:
		var club: String = _pick_courting_club()
		if not club.is_empty():
			pending_decision = MARKET_EVENT_ID
			pending_decision_club = club
			_irse_hace = 0



			if randf() < DUAL_MARKET_P:
				var other: String = _pick_courting_club(club)
				if not other.is_empty():
					pending_decision = DUAL_MARKET_EVENT_ID
					pending_decision_club_b = other













func _seed_punishment(id: String) -> bool:





	if retired or must_retire() or WeekEvents.punish_by_id(id).is_empty():
		return false
	pending_decision = id
	pending_decision_club = ""
	pending_decision_club_b = ""
	decision_cooldown = DECISION_COOLDOWN
	return true













func _seed_award(id: String) -> bool:



	if retired or WeekEvents.award_by_id(id).is_empty():
		return false
	if WeekEvents.is_punish(pending_decision):
		return false



	if WeekEvents.award_rank(id) < WeekEvents.award_rank(pending_decision):
		return false
	pending_decision = id
	pending_decision_club = ""
	pending_decision_club_b = ""
	decision_cooldown = DECISION_COOLDOWN
	return true








const THRASHED_MARGIN: int = 4



const UPSET_RATING_GAP: int = 9













func _match_punishment(base: Dictionary, match_ctx: Dictionary) -> bool:


	if bool(match_ctx.get("nat", false)):
		return false


















	if not bool(base.get("titular", false)):
		return false
	var ko_lost: bool = bool(match_ctx.get("ko_lost", false))
	var round_name: String = String(match_ctx.get("round", ""))
	var margin: int = int(match_ctx.get("margin", 0))
	var gap: int = int(match_ctx.get("rival_gap", 0))
	if ko_lost and round_name == "Final":
		return _seed_punishment("castigo_final")


	if ko_lost and gap >= UPSET_RATING_GAP:
		return _seed_punishment("castigo_ridiculo")
	if bool(base.get("lost", false)) and margin <= - THRASHED_MARGIN:
		return _seed_punishment("castigo_goleada")
	if bool(base.get("lost", false)) and bool(base.get("derby", false)):
		return _seed_punishment("castigo_derbi")
	return false
















const MARKET_INTEREST_RATING: float = 6.5


func _market_scene_open() -> bool:
	if _market_settled or free_agent or on_loan():
		return false





	if transfer_requested or for_sale or forced_sale or unsettled:
		return false
	if not seeded_rumors().is_empty():
		return false



	if not _rumor_asked.is_empty():
		return false
	return last_rating >= MARKET_INTEREST_RATING



















func _pick_courting_club(exclude: String = "") -> String:
	var cands: Array = Market.candidates(scout_profile(), GameState.player_team_id,
		_market_floor())
	var pool: Array = []
	for cand in cands.slice(0, RUMOR_POOL):
		var id: String = String(cand.get("id", ""))



		if id.is_empty() or id == GameState.player_team_id or id == exclude \
				or club_vetado(id):
			continue
		pool.append(id)
	if pool.is_empty():
		return ""
	return String(pool[randi() % pool.size()])



















