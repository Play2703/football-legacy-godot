	GameState.legend_goals += goals
	GameState.legend_assists += assists

	money += con_doble_paga(nat_match_pay(goals))


	var rel_before: Dictionary = rel.duplicate()
	if minutes > 0:



		if rating >= 7.5:
			form = mini(5, form + 1)
		elif rating < 5.5 and pending_injury_weeks <= 0:
