const PREMIOS_MAX: int = 4
const PREMIO_CADA: int = 6






















func _world_news_premios(result: Dictionary) -> void:
	var temporada: int = GameState.season_num - 1
	var dia: int = GameState.season_day
	var cand: Array = []
	var liga: Array = league_race(true, result)
	_premio(cand, temporada, dia, "goleo", liga, "goals", 0, true)
	_premio(cand, temporada, dia, "asistencias", liga, "assists", 0, true)




	if not liga.is_empty():
		var mejor: Dictionary = Race.leader(liga, "avg")
		if _club_arriba(String(mejor.get("team", ""))):
			_premio(cand, temporada, dia, "mvp", liga, "avg", 0, true)


	for e in [["ucl", 1], ["eul", 2], ["conf", 3]]:
		if (GameState.last_season_snap.get(String(e[0]), []) as Array).is_empty():
			continue
		var r: Array = ucl_race(true) if int(e[1]) == 1 \
				else (eul_race(true) if int(e[1]) == 2 else conf_race(true))
		_premio(cand, temporada, dia, "goleo", r, "goals", int(e[1]), true)





	for ac in Continental.AMER_COMPS:
		if not bool(result.get("played_%s" % ac, false)):
			continue
		var idx: int = WorldNews.COMPS.find(Continental.marca(ac))
		if idx < 0:
			continue
		_premio(cand, temporada, dia, "goleo", _cont_race(ac, true), "goals", idx, true)
	_push_world_news(WorldNews._corta(cand, PREMIOS_MAX))












func _world_news_premios_en_curso() -> void:
	var total: int = GameState.league_rounds_yours()
	var jugadas: int = int(Dictionary(GameState.league_table.get(
		GameState.YOU_KEY, {})).get("pj", 0))



	if jugadas <= 0 or jugadas >= total or jugadas % PREMIO_CADA != 0:
		return
	var race: Array = league_race_blend(GameState.season_num, jugadas, total)
	var cand: Array = []



	var primero: String = "goleo" if (jugadas / PREMIO_CADA) % 2 == 1 \
			else "asistencias"
	_premio(cand, GameState.season_num, GameState.season_day, primero, race,
		"goals" if primero == "goleo" else "assists", 0, false)
	if cand.is_empty():
		return





	var f: Dictionary = cand[0]
	for vieja in world_news:
		var v: Dictionary = vieja
		if str(v.get("kind", "")) != str(f.get("kind", "")):
			continue
		if str(v.get("name", "")) == str(f.get("name", "")) \
				and int(v.get("n", 0)) == int(f.get("n", 0)):
			return
		break
	_push_world_news([f])
	_save()
	changed.emit()







func _club_arriba(club: String) -> bool:
	if club.is_empty():
		return false
	var orden: Array = GameState.last_league_order
	if orden.is_empty():
		return true
	for i in mini(3, orden.size()):
		if String(orden[i]) == club or String(orden[i]) == GameState.YOU_KEY \
				and club == GameState.player_team_id:
			return true
	return false




func _premio(cand: Array, temporada: int, dia: int, kind: String, race: Array,
		clave: String, comp: int, definitivo: bool) -> void:
	if race.is_empty():
		return
	var lider: Dictionary = Race.leader(race, clave)
	if lider.is_empty():
		return
	var valor: int = int(round(float(lider.get(clave, 0)) * 10.0)) \
			if clave == "avg" else int(lider.get(clave, 0))
	var f: Dictionary = WorldNews.fila_premio(temporada, dia, kind, lider, valor,
		comp, definitivo)
	if f.is_empty():
		return
	cand.append(WorldNews._cand(f, Teams.rating(str(f.get("club", "")))))


func _world_news_close_season() -> void:
	var temporada: int = GameState.season_num - 1
	var sello: String = str(temporada)
	if _world_news_close == sello:
		return
	_world_news_close = sello
	var filas: Array = WorldNews.filas_cierre(temporada, GameState.season_day,
		_legends_activas)




	_legends_activas = WorldNews.activas_hoy()
	_push_world_news(filas)




























func _rating_antes(a: Variant, b: Variant) -> bool:



	var ra: int = Teams.rating(str(a))
	var rb: int = Teams.rating(str(b))
	if ra != rb:
		return ra > rb
	return str(a) < str(b)










func _estaturas_de(censo: Array) -> Dictionary:






	var orden: Array = []
	for t in censo:
		orden.append(str((t as Dictionary).get("id", "")) if t is Dictionary else str(t))
	orden.sort_custom(_rating_antes)
	var out: Dictionary = {}
	for i in orden.size():
		out[str(orden[i])] = Coach.expected_pos(i, orden.size())
	return out









func _liga_jugada(pais: String, div: int, temporada: int) -> Array:
	var censo: Array = GameState.teams_in_div_jugada(pais, div)
	if censo.size() < 2:
		return [{}, {}]
	var tabla: Array = SimLeague.table(pais, div, temporada, 1.0, censo)
	var pos: Dictionary = {}
	for i in tabla.size():
		pos[str((tabla[i] as Dictionary).get("id", ""))] = i + 1
	return [pos, _estaturas_de(censo)]









func _banquillo_suena(club_id: String) -> bool:
	if club_id == GameState.player_team_id:
		return true
	var mio: String = Teams.country_of(GameState.player_team_id)
	if not mio.is_empty() and Teams.country_of(club_id) == mio:
		return true
	return Teams.rating(club_id) >= WorldNews.FAMA





func _al_paro(club_origen: String, term: int, temporada: int,
		ultimo: String = "", cred: int = 0) -> void:
	if club_origen.is_empty():
		return



	coach_paro.append([club_origen, term, temporada,
		ultimo if not ultimo.is_empty() else club_origen, cred])



	while coach_paro.size() > COACH_PARO_MAX:
		var fuera: int = 0
		for i in coach_paro.size():
			var e: Array = coach_paro[i]
			var id_e: String = Coach.face_seed(String(e[0]), int(e[1])) if e.size() >= 2 else ""


			if e.size() >= 2 and not coach_trophies.has(id_e) \
					and CoachEdits.trofeos_of_id(id_e).is_empty():
				fuera = i
				break
		coach_paro.remove_at(fuera)












func _siembra_libres_del_pack() -> void:
	for i in range(coach_paro.size() - 1, -1, -1):
		var e: Array = coach_paro[i]
		if e.size() >= 2 and CoachEdits.es_term_libre(int(e[1])) \
				and CoachEdits.name_of_id(Coach.face_seed(String(e[0]), int(e[1]))).is_empty():
			coach_paro.remove_at(i)
	for f in CoachEdits.libres():
		var d: Dictionary = f
		var club: String = String(d.get("club", ""))
		var term: int = int(d.get("term", 0))
		var id: String = Coach.face_seed(club, term)
		if id.is_empty() or coach_libres_sembrados.has(id) or Teams.by_id(club).is_empty():
			continue
		coach_libres_sembrados[id] = true


		coach_paro.append([club, term, GameState.season_num, club, 0])




func _orden_de_tu_liga(result: Dictionary) -> Array:
	var filas: Variant = result.get("standings", [])
	if filas is Array and (filas as Array).size() >= 2:
		var out: Array = []
		for r in filas:
			var k: String = String((r as Dictionary).get("key", ""))
			out.append(GameState.player_team_id if k == GameState.YOU_KEY else k)
		return out
	return GameState.last_league_order





















func _roba_tecnico(club_id: String, temporada: int, rng: RandomNumberGenerator,
		robados: Dictionary) -> Dictionary:
	if Teams.rating(club_id) < Coach.ROBO_LADRON_MIN or rng.randf() >= Coach.ROBO_P:
		return {}
	var rat_ladron: int = Teams.rating(club_id)


	var del_libro: Dictionary = {}
	for f in coach_book:
		var donde: String = String((f as Dictionary).get("ahora", ""))
		if not donde.is_empty():
			del_libro[donde] = true




	var mejor: String = ""
	var mejor_niv: int = -1
	var mejor_rat: int = 9999
	for t in Teams.all():
		var vid: String = String((t as Dictionary).get("id", ""))
		if vid.is_empty() or vid == club_id or vid == GameState.player_team_id:
			continue
		if robados.has(vid) or del_libro.has(vid):
			continue

		if int(GameState.last_div_moves.get(vid, 0)) == 1:
			continue
		var rat_v: int = Teams.rating(vid)


		if rat_ladron - rat_v < Coach.ROBO_SALTO_MIN:
			continue
		var s: Dictionary = Coaches.seat(vid)

		if s.is_empty() or String(s.get("club", "")) == club_id:
			continue


		var anos: int = temporada - int(s.get("desde", Coaches.DESDE_BASE)) + 1
		var niv: int = Coaches.nivel_of(vid)
		if not Coach.puede_ser_robado(rat_v, rat_ladron, niv, anos):
			continue






		if niv > mejor_niv or (niv == mejor_niv and (rat_v < mejor_rat
				or (rat_v == mejor_rat and vid < mejor))):
			mejor = vid
			mejor_niv = niv
			mejor_rat = rat_v
	if mejor.is_empty():
		return {}



	_fija_nombre(mejor)
	var s2: Dictionary = Coaches.seat(mejor)
	var out: Dictionary = {"club": String(s2.get("club", mejor)),
		"term": int(s2.get("term", Coaches.TERM_BASE)), "ultimo": mejor,
		"cred": int(s2.get("cred", 0))}
	coach_seats[mejor] = Coaches.fila(int(s2.get("mandato", Coaches.TERM_BASE)) + 1,
		temporada + 1, 0, "", 0)
	robados[mejor] = true
	return out











func _ficha_del_paro(club_id: String, rng: RandomNumberGenerator) -> Dictionary:
	if coach_paro.is_empty() or rng.randf() >= Coach.RECOLOCA_P:
		return {}
	for i in range(coach_paro.size() - 1, -1, -1):
		var e: Array = coach_paro[i]
		if e.size() < 2:
			coach_paro.remove_at(i)
			continue
		var origen: String = String(e[0])

		var ultimo: String = String(e[3]) if e.size() > 3 else origen
		if origen.is_empty() or origen == club_id or ultimo == club_id:
			continue



		var cred_p: int = int(e[4]) if e.size() > 4 else 0




		if not Coach.puede_entrenar(Coach.rating_de(ultimo), club_id, Coach.con_trofeos(
				Coach.nivel_vivo(Coach.nivel_base(origen, int(e[1]), Coach.rating_de(origen),
				world_seed), cred_p), coach_trophies.get(Coach.face_seed(origen, int(e[1])),
				{}))):
			continue
		coach_paro.remove_at(i)
		return {"club": origen, "term": int(e[1]), "ultimo": ultimo, "cred": cred_p}
	return {}







func _cubre_banquillos(cand: Array) -> void:
	if cand.is_empty():
		return
	_push_world_news(WorldNews._corta(cand, COACH_NEWS_MAX))
















func _tick_tecnicos_del_mundo(result: Dictionary = {}) -> void:
	var temporada: int = GameState.season_num - 1
	var sello: String = str(temporada)




	if _coach_world_close == sello:
		return
	_coach_world_close = sello
	var ambito: Array = _ai_scope()
	if ambito.is_empty():
		return





	var mi_pais: String = Teams.country_of(GameState.player_team_id)
	var en_ambito: Dictionary = {}
	for x in ambito:
		en_ambito[String(x)] = true
	for t in Teams.all():
		var tid: String = String((t as Dictionary).get("id", ""))
		if tid.is_empty() or en_ambito.has(tid) or Teams.country_of(tid) == mi_pais:
			continue
		if int(GameState.last_div_moves.get(tid, 0)) == 1 and GameState.div_of(tid) - 1 == 1 \
				and int((t as Dictionary).get("rating", 62)) >= AiMarket.SCOPE_MIN_RATING:
			ambito.append(tid)
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("coachmundo|%d" % temporada)









	var mi_pos: Dictionary = {}
	var mi_esperado: Dictionary = {}
	var orden: Array = _orden_de_tu_liga(result)
	if orden.size() >= 2:
		for i in orden.size():
			mi_pos[String(orden[i])] = i + 1
		mi_esperado = _estaturas_de(orden)

	var ligas: Dictionary = {}
	var ocupados: Dictionary = {}




	var robados: Dictionary = {}
	for f in coach_book:
		var donde: String = String((f as Dictionary).get("ahora", ""))
		if not donde.is_empty():
			ocupados[donde] = true
	var cand: Array = []
	for raw in ambito:
		var id: String = String(raw)




		if id == GameState.player_team_id or ocupados.has(id) or robados.has(id):
			continue
		var pos: int = 0
		var esperado: int = 0
		if mi_pos.has(id):
			pos = int(mi_pos[id])
			esperado = int(mi_esperado.get(id, 0))
		else:



			var pais: String = Teams.country_of(id)
			var jugada: int = clampi(GameState.div_of(id)
				- int(GameState.last_div_moves.get(id, 0)), 1, 3)
			var clave: String = "%s|%d" % [pais, jugada]
			if not ligas.has(clave):
				ligas[clave] = _liga_jugada(pais, jugada, temporada)
			var par: Array = ligas[clave]
			pos = int((par[0] as Dictionary).get(id, 0))
			esperado = int((par[1] as Dictionary).get(id, 0))
		if pos <= 0 or esperado <= 0:
			continue
		var s: Dictionary = Coaches.seat(id)
		var mandato: int = int(s.get("mandato", Coaches.TERM_BASE))
		var mal: int = int(s.get("mal", 0))
		var descendio: bool = int(GameState.last_div_moves.get(id, 0)) == 1
		var racha: int = int(s.get("racha", 0))



		var niv_s: int = Coaches.nivel_of(id) if pos > esperado and not descendio \
				else Coach.NIV_REF
		var cae: bool = Coaches.cae(pos, esperado, mal, temporada, descendio, racha, niv_s)



		var ciclo: bool = false
		if not cae:
			var antig: int = Coaches.antiguedad(id, s, temporada)
			if antig > Coach.ciclo(Coach.NIV_MIN):
				var niv_c: int = niv_s if pos > esperado else Coaches.nivel_of(id)
				ciclo = rng.randf() < Coach.p_ciclo(antig, niv_c)
		if not cae and not ciclo:




			var nmal: int = temporada if pos > esperado else 0
			var nracha: int = Coaches.racha_de(mal, racha, temporada) if nmal > 0 else 0
			if nmal == mal and nracha == racha:
				continue
			var fila_no: Array = Coaches.fila(mandato, int(s.get("desde",
				Coaches.DESDE_BASE)), nmal, String(s.get("src", "")), int(s.get("cred", 0)),
				nracha)
			if Coaches.es_default(fila_no):
				coach_seats.erase(id)
			else:
				coach_seats[id] = fila_no
			continue


		var suena: bool = _banquillo_suena(id)
		var saliente: String = Coaches.name_of(id) if suena else ""



		var robo: bool = false
		var vuelve: Dictionary = _roba_tecnico(id, temporada, rng, robados)
		if vuelve.is_empty():
			vuelve = _ficha_del_paro(id, rng)
		else:
			robo = true


		_fija_nombre(id)
		_al_paro(String(s.get("club", id)), int(s.get("term", Coaches.TERM_BASE)),
			temporada, id, int(s.get("cred", 0)))
		var src: String = ""
		if not vuelve.is_empty():
			src = "%s|%d" % [String(vuelve["club"]), int(vuelve["term"])]


		coach_seats[id] = Coaches.fila(mandato + 1, temporada + 1, 0, src,
			int(vuelve.get("cred", 0)))
		Coaches.bump()
		if not suena:
			continue





		var fila_n: Dictionary = {}
		if vuelve.is_empty() and ciclo:

			fila_n = WorldNews.fila_tecnico(temporada, GameState.season_day, id,
				Coaches.name_of(id), "", true)
		elif vuelve.is_empty():
			fila_n = WorldNews.fila_tecnico(temporada, GameState.season_day, id,
				saliente, "", false)
		else:
			fila_n = WorldNews.fila_tecnico(temporada, GameState.season_day, id,
				Coaches.name_of(id), String(vuelve.get("ultimo", vuelve["club"])),
				true, robo)
		if not fila_n.is_empty():
			cand.append(WorldNews._cand(fila_n, Teams.rating(id)))
	_cubre_banquillos(cand)















func _tick_seleccionadores() -> void:
	var temporada: int = GameState.season_num - 1
	var kind: String = NatTeam.season_kind(temporada)
	if kind != "wc" and kind != "cont":
		return
	var sello: String = str(temporada)
	if _coach_nat_close == sello:
		return
	_coach_nat_close = sello
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("coachnat|%d" % temporada)
	var campeon: String = Nations.canon_id(_nat_campeon_cierre) \
			if not _nat_campeon_cierre.is_empty() else ""
	var mia: String = Nations.canon_id(nationality) if not nationality.is_empty() else ""


	var tomados: Dictionary = {}
	var cand: Array = []
	for pais in Coaches.selecciones():
		if pais == mia or pais == campeon:
			continue
		var sitio: String = Coach.origen_nat(pais)


		var tirada: float = rng.randf()
		if tirada >= Coach.p_sale_seleccion(kind, Coaches.nivel_of(sitio)):
			continue
		var s: Dictionary = Coaches.seat(sitio)
		var saliente: String = Coaches.name_of(sitio)
		var llega: Dictionary = _elige_seleccionador(pais, temporada, rng, tomados)
		_al_paro(String(s.get("club", sitio)), int(s.get("term", Coaches.TERM_BASE)),
			temporada, sitio, int(s.get("cred", 0)))


		nat_seats[pais] = Coaches.fila_nat(int(s.get("mandato", Coaches.TERM_BASE)) + 1,
			temporada + 1, String(llega.get("src", "")), int(llega.get("cred", 0)))
		Coaches.bump()


		var fila_n: Dictionary = {}
		if llega.has("ultimo"):
			fila_n = WorldNews.fila_seleccion(temporada, GameState.season_day, pais,
				Coaches.name_of(sitio), String(llega["ultimo"]), true)
		else:
			fila_n = WorldNews.fila_seleccion(temporada, GameState.season_day, pais,
				saliente, "", false)
		if not fila_n.is_empty():
			cand.append(WorldNews._cand(fila_n, Nations.strength(pais)))
	_cubre_banquillos(cand)










func _elige_seleccionador(pais: String, temporada: int, rng: RandomNumberGenerator,
		tomados: Dictionary) -> Dictionary:
	var fuerza: int = Nations.strength(pais)
	if rng.randf() < Coach.SEL_DE_CLUB_P:
		var de_club: Dictionary = _seleccionador_de_club(pais, fuerza, temporada, rng,
			tomados)
		if not de_club.is_empty():
			return de_club
	if rng.randf() < Coach.SEL_PARO_P:
		return _seleccionador_del_paro(pais, fuerza, temporada)
	return {}











func _seleccionador_de_club(pais: String, fuerza: int, temporada: int,
		rng: RandomNumberGenerator, tomados: Dictionary) -> Dictionary:
	var ocupados: Dictionary = {}
	for f in coach_book:
		var donde: String = String((f as Dictionary).get("ahora", ""))
		if not donde.is_empty():
			ocupados[donde] = true
	var mejor: String = ""
	var mejor_niv: int = -1
	var mejor_rat: int = -1
	for raw in _ai_scope():
		var club: String = String(raw)
		if club == GameState.player_team_id or ocupados.has(club) or tomados.has(club):
			continue
		var rat: int = Teams.rating(club)
		if rat - Coach.SEL_BAJA_MAX > fuerza:
			continue
		var s: Dictionary = Coaches.seat(club)


		if temporada - int(s.get("desde", Coaches.DESDE_BASE)) + 1 < 1:
			continue
		var org: String = String(s.get("club", club))
		var term: int = int(s.get("term", Coaches.TERM_BASE))

		if Nations.canon_id(Coaches.nacion_de_id(org, term)) != pais:
			continue
		var niv: int = Coaches.nivel_of(club)
		if not Coach.puede_seleccionar(rat, fuerza, niv):
			continue
		if niv > mejor_niv or (niv == mejor_niv and (rat > mejor_rat
				or (rat == mejor_rat and club < mejor))):
			mejor = club
			mejor_niv = niv
			mejor_rat = rat
	if mejor.is_empty():
		return {}
	var s2: Dictionary = Coaches.seat(mejor)

	_fija_nombre(mejor)
	var out: Dictionary = {"src": "%s|%d" % [String(s2.get("club", mejor)),
		int(s2.get("term", Coaches.TERM_BASE))], "cred": int(s2.get("cred", 0)),
		"ultimo": mejor}
	tomados[mejor] = true
	var vuelve: Dictionary = _ficha_del_paro(mejor, rng)
	var src: String = ""
	if not vuelve.is_empty():
		src = "%s|%d" % [String(vuelve["club"]), int(vuelve["term"])]
	coach_seats[mejor] = Coaches.fila(int(s2.get("mandato", Coaches.TERM_BASE)) + 1,
		temporada + 1, 0, src, int(vuelve.get("cred", 0)))
	return out











func _seleccionador_del_paro(pais: String, fuerza: int, temporada: int = -1) -> Dictionary:
	var sitio: String = Coach.origen_nat(pais)
	for pasada in 2:
		for i in range(coach_paro.size() - 1, -1, -1):
			var e: Array = coach_paro[i]
			if e.size() < 2:
				continue
			var origen: String = String(e[0])
			var term: int = int(e[1])
			var ultimo: String = String(e[3]) if e.size() > 3 else origen
			if origen.is_empty() or ultimo == sitio or origen == sitio:
				continue
			if Coach.es_nat(ultimo) and int(e[2]) >= temporada and temporada >= 0:
				continue
			var suyo: bool = Nations.canon_id(Coaches.nacion_de_id(origen, term)) == pais
			if suyo !=(pasada == 0):
				continue
			var cred_p: int = int(e[4]) if e.size() > 4 else 0
			var niv: int = Coach.con_trofeos(Coach.nivel_vivo(Coach.nivel_base(origen, term,
				Coach.rating_de(origen), world_seed), cred_p),
				coach_trophies.get(Coach.face_seed(origen, term), {}))
			if not Coach.puede_seleccionar(Coach.rating_de(ultimo), fuerza, niv):
				continue
			coach_paro.remove_at(i)
			return {"src": "%s|%d" % [origen, term], "cred": cred_p, "ultimo": ultimo}
	return {}
















