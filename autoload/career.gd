	return vivas
















func _restore_offers(previas: Array) -> void:
	if previas.is_empty():
		return
	var ids: Dictionary = {}

	var out: Array = []
	for o in previas:




		var pid: String = String(o.get("id", ""))
		if ids.has(pid):
			continue
		ids[pid] = true
		out.append(o)
	for o in pending_offers:
		if ids.has(String(o.get("id", ""))):
			continue
		ids[String(o.get("id", ""))] = true
		out.append(o)
	pending_offers = out









