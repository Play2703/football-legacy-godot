func poker_ficha(nombre: String) -> Dictionary:
	var mio: String = GameState.player_team_id
	var ids: Array[String] = [mio]



	for t in GameState.teams_in_div(Teams.country_of(mio), GameState.div_of(mio)):
		var tid: String = String(t.get("id", t))
		if not ids.has(tid):
			ids.append(tid)
	for tid in ids:
		var plantel: Array = Squad.of(tid)
		for seat in plantel.size():
			var p: Dictionary = plantel[seat]
			var crudo: String = String(p.get("name", ""))
			if crudo.is_empty() or Competitions.demarca(crudo) != nombre:
				continue
			var club: Dictionary = Teams.by_id(tid)
			return {
				"clave": crudo,





				"ovr": SquadMeta.media_of(p, String(p.get("pos", ""))),
				"pos": String(p.get("pos", "")),





















				"nat": String(p.get("nat", "")) if not String(p.get("nat", "")).is_empty()
					else SquadMeta.nation_at(tid, Teams.country_of(tid), seat,
						String(p.get("pos", "MC"))),
				"club_id": tid,
				"club": String(club.get("abbrev", club.get("name", tid))),
			}
	return {}


func poker_invitados(mesa_id: String) -> Array:
	var out: Array = []
	var mio: String = GameState.player_team_id
	if mesa_id == "vestuario":
		for p in Squad.of(mio):
			var nom: String = String(p.get("name", ""))
			if nom.is_empty() or nom == name:
				continue
			out.append(Competitions.demarca(nom))
			if out.size() >= 3:
				break
	elif mesa_id == "famosos":
















		for leg in WorldLegends.emerged():
			var lnom: String = String((leg as Dictionary).get("name", ""))
			if lnom.is_empty() or lnom == name:
				continue
			out.append(Competitions.demarca(lnom))
			if out.size() >= 3:
				break
		if out.size() < 3:
			var mi_pais: String = Teams.country_of(mio)
			var fuera: Array = Teams.all().filter(func(t: Dictionary) -> bool:
				return String(t.get("country", "")) != mi_pais and GameState.div_of(String(t.get("id", ""))) == 1)
			fuera.sort_custom(func(a, b): return int(a["rating"]) > int(b["rating"]))
			for t in fuera:
				for p in Squad.of(String(t.get("id", ""))):
					var fnom: String = Competitions.demarca(String(p.get("name", "?")))
					if not out.has(fnom):
						out.append(fnom)
					break
				if out.size() >= 3:
					break
	else:









		for t in GameState.teams_in_div(Teams.country_of(mio), GameState.div_of(mio)):
			var tid: String = String(t.get("id", t))
			if tid == mio:
				continue
			for p in Squad.of(tid):
				out.append(Competitions.demarca(String(p.get("name", "?"))))
				break
			if out.size() >= 3:
				break
	while out.size() < 3:
		out.append(I18n.t("INVITADO"))
	return out









func settle_poker(mesa_id: String, devuelto: int, saldo: int) -> void:
	money += maxi(0, devuelto)
	var m: Dictionary = House.poker_mesa_by_id(mesa_id)
	var quien: String = String(m.get("rel", "equipo"))
	var fuerte: bool = absi(saldo) >= int(m.get("fichas", 100)) * 500
	var mueve: Dictionary = {}
	if quien == "equipo":




		mueve["equipo"] = 2 if (saldo < 0 and fuerte) else 1
	if int(m.get("prensa", 0)) > 0 and fuerte:


		mueve["prensa"] = -2 if saldo < 0 else 1
	for key in Shop.LIFESTYLE_KEYS:
		var d: int = int(mueve.get(key, 0))
		if d != 0:
			rel[key] = clampi(int(rel[key]) + d, 0, 100)
	_save()
	changed.emit()





