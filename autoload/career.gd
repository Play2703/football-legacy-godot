func captain_race() -> Dictionary:
	var out: Dictionary = {"best": -1.0, "name": "", "full": "", "min_gp": 0}
	var team_id: String = GameState.player_team_id
	if team_id.is_empty():
		return out
	var squad: Array = Squad.of_nominal(team_id)
	if squad.is_empty():
		return out
	var meta: Array = _ensure_squad_meta(team_id, squad)


	var min_gp: int = mini(CAPTAIN_MIN_GP,
		ceili(CAPTAIN_MIN_GP_FRAC * float(season_matches)))
	out["min_gp"] = min_gp
	var mio: int = Squad.user_index(squad)
	for i in mini(squad.size(), meta.size()):
		if i == mio or String((squad[i] as Dictionary).get("pos", "")) == "POR":
			continue
		var pm: Dictionary = meta[i]
		if int(pm.get("gp", 0)) < min_gp:
			continue
		var su_media: float = SquadMeta.season_avg(pm)
		if su_media > float(out["best"]):
			out["best"] = su_media


			out["full"] = String((squad[i] as Dictionary).get("name", ""))
			out["name"] = CareerUi.surname(String(out["full"]))
	return out










