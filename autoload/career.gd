func _reco_precio(f: Dictionary) -> int:
	var p: int = _reco_precio_base(f)
	if p > 0 and gerencia_fuerza(f):
		var v: Dictionary = _precio_memo.get(_precio_clave(String(f.get("club", "")),
			int(f.get("seat", -1)), String(f.get("name", ""))), {})
		return Gerencia.fuerza_precio(int(v.get("p_traspaso", p)), p)
	return p





func gerencia_fuerza(f: Dictionary) -> bool:
	if _reco_precio_base(f) <= 0:
		return false
	var mk: String = _precio_clave(String(f.get("club", "")), int(f.get("seat", -1)),
		String(f.get("name", "")))
	if not bool((_precio_memo.get(mk, {}) as Dictionary).get("clausula", false)):
		return false
	return gerencia_interes(f) >= Gerencia.FUERZA_INTERES



func _reco_precio_base(f: Dictionary) -> int:
	var club: String = String(f.get("club", ""))
	var seat_idx: int = int(f.get("seat", -1))







	var base: String = _ger_memo_base()
	if base != _precio_memo_clave:
		_precio_memo.clear()
		_precio_memo_clave = base




	var mk: String = _precio_clave(club, seat_idx, String(f.get("name", "")))
	if _precio_memo.has(mk):
		return int((_precio_memo[mk] as Dictionary)["p"])









	var v: Dictionary = _reco_precio_calc(club, seat_idx, f)
	_precio_memo[mk] = v

	if int(f.get("seat", -1)) != seat_idx:
		_precio_memo[_precio_clave(club, int(f["seat"]), String(f.get("name", "")))] = v
	return int(v["p"])


func _precio_clave(club: String, seat: int, nombre: String) -> String:
	return "%s#%d#%s" % [club, seat, nombre]







func _reco_causa(f: Dictionary) -> String:
	if _reco_precio_base(f) >= 0:
		return ""
	var mk: String = _precio_clave(String(f.get("club", "")), int(f.get("seat", -1)),
		String(f.get("name", "")))
	if not _precio_memo.has(mk):
		return "ido"
	return String((_precio_memo[mk] as Dictionary).get("causa", "ido"))







func gerencia_clausula(f: Dictionary) -> bool:
	if _reco_precio_base(f) < 0:
		return false
	var mk: String = _precio_clave(String(f.get("club", "")), int(f.get("seat", -1)),
		String(f.get("name", "")))

	return bool((_precio_memo.get(mk, {}) as Dictionary).get("clausula", false)) \
			and not gerencia_fuerza(f)






func gerencia_ex(f: Dictionary) -> int:
	if _reco_precio_base(f) < 0:
		return 0


	var mk: String = _precio_clave(String(f.get("club", "")), int(f.get("seat", -1)),
		String(f.get("name", "")))
	return int((_precio_memo.get(mk, {}) as Dictionary).get("ex", 0))









func _ex_de(club: String, h: int, etapas: Array) -> int:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or etapas.is_empty():
		return 0
	if not club.is_empty() and h >= 0 \
			and String(TransferBook.loan_in_at(club, _libro_idx(club, h, {})).get("lender",
				"")) == mio:
		return 0
	return Gerencia.ex_temporadas(TransferBook.vuelta_a(etapas, mio, GameState.season_num))


func _reco_precio_calc(club: String, seat_idx: int, f: Dictionary) -> Dictionary:





	if Teams.is_free(club):
		var fa: Dictionary = _libre_de(seat_idx)
		if fa.is_empty():
			return {"p": -1, "causa": "ido"}
		var edad: int = int(AiMarket._free_identity(fa, GameState.season_num).get("age", 26))
		if edad > AiMarket.MAX_BUY_AGE:
			return {"p": -1, "causa": "edad"}




		var etapas_l: Array = TransferBook.sanea_carrera(fa.get("carrera", null))
		var oj_l: Dictionary = {"probado": true, "cesiones": 0} if etapas_l.is_empty() \
				else Gerencia.ojeo_de(etapas_l, "",
				Teams.country_of(GameState.player_team_id), GameState.season_num)


		return {"p": 0, "causa": "", "bajada": 1.0,
			"probado": bool(oj_l["probado"]), "cesiones": int(oj_l["cesiones"]),
			"ojeo": Gerencia.ojeo_factor(bool(oj_l["probado"]), int(oj_l["cesiones"])),
			"ex": _ex_de("", -1, etapas_l), "edad": edad}
	var squad: Array = Squad.of(club)
	var p: Dictionary = squad[seat_idx] if seat_idx >= 0 and seat_idx < squad.size() else {}
	if p.is_empty() or String(p.get("name", "")) != String(f.get("name", "")):







		var nombre: String = String(f.get("name", ""))
		var nueva: int = -1
		if not nombre.is_empty():
			for i in squad.size():
				if String((squad[i] as Dictionary).get("name", "")) == nombre:
					nueva = i
					break
		if nueva < 0:
			return {"p": -1, "causa": "ido"}
		f["seat"] = nueva
		seat_idx = nueva
		p = squad[nueva]







	var h: int = Squad.home_seat(squad, seat_idx)





	var meta: Array = _meta_viva(club, squad)
	if h < 0 or h >= meta.size():
		return {"p": -1, "causa": "ido"}






	var b_c: int = _libro_idx(club, h, {})
	if b_c >= 0 and TransferBook.asientos_en_cesion().has("%s#%d" % [club, b_c]):
		return {"p": -1, "causa": "cedido"}
	var pm: Dictionary = meta[h]
	var pos: String = String(p.get("pos", "MC"))
	var seat: Dictionary = {
		"idx": h, "pos": pos, "media": SquadMeta.media_of(p, pos),
		"age": int(pm.get("age", 26)), "contract": int(pm.get("contract", 3)),
		"name": String(p.get("name", "")), "nation": String(pm.get("nation", "")),
		"signed": int(pm.get("signed", -9999)), "player": p, "pm": pm,
	}





















	var rating: int = Teams.rating(club)
	if int(seat["age"]) > AiMarket.MAX_BUY_AGE:
		return {"p": -1, "causa": "edad"}


	var retiro: int = WorldAging.retire_age_casa(club, h, pos)
	if maxi(retiro - int(seat["age"]), 0) < AiMarket.temporadas_minimas(int(seat["age"])):
		return {"p": -1, "causa": "edad"}












	var blindado: bool = AiMarket._seller_blocks(seat, rating)
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()



	rng.seed = hash("reco_precio|%s|%d|%d" % [club, h, GameState.season_num])
	var fee: int = int(AiMarket._price(seat, rating, rng)["fee"])






	var mio: String = GameState.player_team_id
	var tray: Dictionary = TransferBook.trayectoria_ficha(club, h, pos, GameState.season_num)
	var oj: Dictionary = Gerencia.ojeo_de(tray.get("etapas", []), Teams.country_of(club),
		Teams.country_of(mio), GameState.season_num)




	var bajada: float = Gerencia.bajada_mult(rating, Teams.rating(mio))





	var ex: int = _ex_de(club, h, tray.get("etapas", []))





	var tm: Dictionary = Market.trayectoria_mult(tray.get("etapas", []))
	var out: Dictionary = {
		"p": int(float(fee) * float(tm["mult"]) * bajada *(1.0 - Gerencia.ex_rebaja(ex))),
		"causa": "",
		"bajada": bajada,
		"probado": bool(oj["probado"]), "cesiones": int(oj["cesiones"]),
		"ojeo": Gerencia.ojeo_factor(bool(oj["probado"]), int(oj["cesiones"])),
		"ex": ex,
		"edad": int(seat["age"]),
		"tray": float(tm["mult"]),
		"tray_info": {"grandes": int(tm["grandes"]), "cesiones": int(tm["cesiones"]),
			"clubes": int(tm["clubes"])},
		"clausula": false}
	if blindado:











		var clausula: int = int(float(Market.release_clause(AiMarket._seat_value(seat),
			rating)) * bajada)
		if clausula > int(out["p"]):

			out["p_traspaso"] = int(out["p"])
			out["p"] = clausula
			out["tray"] = 1.0
			out["tray_info"] = {}
			out["clausula"] = true
	return out
















const FAM_NATURAL: int = 100


const FAM_NUEVO: int = 20
const FAM_POR_PARTIDO: float = 6.0
const FAM_CONVOCADO: float = 1.2
const FAM_OXIDO: float = 1.2


const FAM_SUELO_APRENDIDO: int = 25
const FAM_SUELO_NATURAL: int = 40


const FAM_EDAD_JOVEN: int = 26
const FAM_EDAD_MEDIA: int = 30


const AJUSTE_MIN: float = 0.75


func familiaridad(pos: String) -> int:
	if pos == puesto_natural():
		return int(pos_fam.get(pos, FAM_NATURAL))
	return int(pos_fam.get(pos, FAM_NUEVO))




func escalon_familiaridad(pos: String) -> int:
	var f: int = familiaridad(pos)
	if f >= 95:
		return 3
	if f >= 65:
		return 2
	if f >= 35:
		return 1
	return 0


















func ajuste_puesto(pos: String = "") -> float:
	var p: String = pos if not pos.is_empty() else puesto_hoy()
	return AJUSTE_MIN +(1.0 - AJUSTE_MIN) *(float(familiaridad(p)) / 100.0)



func _freno_edad() -> float:
	if age <= FAM_EDAD_JOVEN:
		return 1.0
	return 0.6 if age <= FAM_EDAD_MEDIA else 0.35


func _suelo_fam(pos: String) -> int:
	return FAM_SUELO_NATURAL if pos == puesto_natural() else FAM_SUELO_APRENDIDO







func _tick_familiaridad(pos: String, minutos: int) -> void:
	if not Squad.puesto_elegible(pos):
		return
	var gana: float = FAM_CONVOCADO
	if minutos > 0:
		gana = FAM_POR_PARTIDO * clampf(float(minutos) / 90.0, 0.0, 1.0)
		gana = maxf(gana, FAM_CONVOCADO)
	pos_fam[pos] = clampi(roundi(float(familiaridad(pos)) + gana * _freno_edad()),
		0, 100)



	for otro in puestos():
		var o: String = String(otro)
		if o == pos:
			continue
		pos_fam[o] = maxi(_suelo_fam(o), roundi(float(familiaridad(o)) - FAM_OXIDO))




func aprende_puesto(pos: String) -> bool:
	if not Squad.puesto_elegible(pos) or sabe_jugar(pos):
		return false
	if poss.size() >= Squad.POS_MAX:
		return false
	poss.append(pos)
	pos_fam[pos] = FAM_NUEVO
	return true


























const COSTE_PUESTO: int = 6




func coste_puesto(pos: String) -> int:
	if not Squad.puesto_elegible(pos) or sabe_jugar(pos):
		return 0
	if puestos().size() >= Squad.POS_MAX:
		return 0
	return COSTE_PUESTO













func compra_puesto(pos: String) -> bool:
	var cost: int = coste_puesto(pos)
	if cost <= 0 or skill_points < cost:
		return false
	if not aprende_puesto(pos):
		return false
	skill_points -= cost
	_spent_stack.append(POS_UNDO_PREFIX + pos)
	_save()
	changed.emit()
	return true

















func _undo_puesto(pos: String) -> String:
	poss.erase(pos)
	pos_fam.erase(pos)
	if pos_fav == pos:
		pos_fav = ""
	skill_points += COSTE_PUESTO
	_save()
	changed.emit()
	return POS_UNDO_PREFIX + pos




func skills_avg() -> float:
	var total: float = 0.0
	for k in SKILL_KEYS:
		total += _skill_or_seed(k)
	return total / float(SKILL_KEYS.size())





































const PROY_NIVELES_MAX: int = 500


const PROY_TEMPORADA_MIN: float = 0.25





func xp_acumulada() -> int:
	var total: int = xp
	for l in range(1, maxi(level, 1)):
		total += xp_needed_at(l)
	return total



func _puntos_por_xp(extra: int) -> int:
	var l: int = maxi(level, 1)
	var bolsa: int = xp + maxi(extra, 0)
	var pts: int = 0
	var vueltas: int = 0
	while bolsa >= xp_needed_at(l) and vueltas < PROY_NIVELES_MAX:
		bolsa -= xp_needed_at(l)
		l += 1
		pts += SKILL_POINTS_PER_LEVEL
		vueltas += 1
	return pts






func _media_gastando(bolsa: int) -> float:
	var s: Dictionary = {}
	for k in SKILL_KEYS:
		s[k] = int(round(_skill_or_seed(k)))
	var quedan: int = maxi(bolsa, 0)
	for corte in [80, 90, SKILL_CAP]:
		for k in SKILL_KEYS:
			while int(s[k]) < int(corte):
				var c: int = point_cost_for(int(s[k]))
				if quedan < c:
					break
				quedan -= c
				s[k] = int(s[k]) + 1
	var total: float = 0.0
	for k in SKILL_KEYS:
		total += float(int(s[k]))
	return total / float(SKILL_KEYS.size())





func peak_skills_avg() -> float:
	var hoy: float = skills_avg()
	var faltan: int = maxi(RETIRE_AGE - age, 0)
	if faltan <= 0:
		return hoy
	var jugadas: float = float(season_history.size()) \
			+ maxf(GameState.season_progress(), 0.0)
	var ritmo: float = float(xp_acumulada()) / maxf(jugadas, PROY_TEMPORADA_MIN)











	if jugadas < 1.0:
		ritmo = maxf(ritmo, float(maxi(GameState.calendar.size(), 1)) * XP_MATCH_BASE
			* xp_mult())
	return maxf(hoy, _media_gastando(
		skill_points + _puntos_por_xp(int(ritmo * float(faltan)))))

















