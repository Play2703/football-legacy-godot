	encargos_ok = 0


func _apply_relations(rating: float, goals: int, assists: int, result: int,
		minutes: int, is_derby: bool, passes: int = 0, shots: int = 0,
		chances: int = 0, boys_hit: int = 0, ko_perdida: bool = false,
		rotado: bool = false) -> void:








	if minutes <= 0:





		var pacto: String = pactado_hoy()
		if injury_weeks <= 0 and pacto.is_empty():












			if int(rel["tecnico"]) > REL_TECNICO_RESCUE:
				if not rotado:
					rel["tecnico"] = clampi(int(rel["tecnico"]) - 2, 0, 100)
			else:
				rel["tecnico"] = mini(REL_TECNICO_RESCUE, int(rel["tecnico"]) + 1)


		if peldano() < Gerencia.PELDANO_LEYENDA:
			rel["aficion"] = clampi(int(rel["aficion"]) - 1, 0, 100)
		var d_prensa: int = -1
		if pacto == DescansoPactado.DESCANSO:
			d_prensa = DescansoPactado.PRENSA_DESCANSO
		elif pacto == DescansoPactado.BANCA:
			d_prensa = DescansoPactado.PRENSA_BANCA
		rel["prensa"] = clampi(int(rel["prensa"]) + d_prensa, 0, 100)
		return







	var plays: int = chances
	if plays <= 0:
		plays = maxi(shots, roundi(float(minutes) / 13.0))
	var expected: float = float(plays) * REL_XG_PER_CHANCE



	var produced: float = float(goals) + float(assists) * REL_ASSIST_WORTH

	var over: float = produced - expected
	var scored: float = over *(REL_OVER_GAIN if over > 0.0 else REL_UNDER_GAIN)





	var zero: float = REL_TECNICO_ZERO_BASE \
			+ float(rel["tecnico"]) / 100.0 * REL_TECNICO_ZERO_SPAN
	var d_tecnico: float =(rating - zero) * 3.0
	d_tecnico += 2.0 if result > 0 else (-1.5 if result < 0 else 0.0)


	d_tecnico += scored * 1.2











	if _spend_match_fx("coach_meeting") and d_tecnico < 0.0:
		d_tecnico *= 2.0
	if pending_hook:
		d_tecnico -= REL_HOOK_PENALTY
		pending_hook = false




		pending_hook_min = 0
		pending_hook_wasted = 0
		pending_hook_reason = ""
		pending_hook_shown = false








	var sub_welcome_fans: float = 0.0
	if pending_sub_request:
		var sub_pts: float = pending_sub_request_pts
		if sub_pts <= 0.0:
			sub_pts = REL_SUB_REQUEST_PENALTY
		d_tecnico -= sub_pts
		pending_sub_request = false
		pending_sub_request_pts = 0.0





	if pending_sub_welcome:
		d_tecnico += REL_SUB_WELCOME_COACH
		sub_welcome_fans = REL_SUB_WELCOME_FANS
		pending_sub_welcome = false







	var d_equipo: float = 0.0
	if shots > 0:
		var share: float = clampf(float(passes) / float(shots), 0.0, 1.0)
		d_equipo =(share - REL_SHARE_ZERO) * REL_SHARE_GAIN




		var cap: float = REL_SHARE_HOG_CAP if d_equipo < 0.0 else 1.0
		d_equipo *= clampf(float(shots) / 5.0, 0.25, cap)
	else:



		d_equipo = -1.0
	d_equipo += float(assists) * 0.8




	d_equipo += 0.5 if result > 0 else (-0.5 if result < 0 else 0.0)



	if d_equipo < 0.0:
		var indulto: float = 0.0
		if result > 0:
			indulto += REL_TEAM_PARDON_WIN
		indulto += clampf((rating - 7.0) / 2.0, 0.0, 1.0) * REL_TEAM_PARDON_RATING
		d_equipo *= 1.0 - clampf(indulto, 0.0, REL_TEAM_PARDON_CAP)

























	if int(rel["equipo"]) < Standing.BAND_MALA:
		d_equipo = maxf(d_equipo, 0.0)








	var d_aficion: float = scored * 3.2
	d_aficion += sub_welcome_fans
	d_aficion += 2.0 if result > 0 else (-1.5 if result < 0 else 0.0)
	if is_derby and result > 0:
		d_aficion += 2.0





	var d_aficion_cameo: float = 1.0 if minutes < 25 else 0.0




	var d_prensa: float = scored * 2.2 - PRENSA_OLVIDO
















	d_prensa += clampf((rating - 6.5) * 2.0, 0.0, 3.0)












	var estrella_hoy: bool = es_estrella()
	if estrella_hoy and d_prensa < 0.0 and pending_injury_weeks <= 0:
		if colchon_perdona(d_prensa, estrella_hoy, estrella_flojos):
			d_prensa = minf(d_prensa + PRENSA_OLVIDO, 0.0)
		estrella_flojos += 1





	var d_prensa_boys: float = DAMAGE_BOY_PRESS * float(boys_hit) if boys_hit > 0 else 0.0




	var d_agente: float = clampf((rating - 7.0) * 1.2, -2.0, 2.0)












	var corto: float = clampf(float(minutes) / REL_SHORT_FULL, REL_SHORT_KEEP, 1.0)
	if corto < 1.0:
		d_tecnico = _corta_si_baja(d_tecnico, corto)
		d_aficion = _corta_si_baja(d_aficion, corto)
		d_prensa = _corta_si_baja(d_prensa, corto)
		d_agente = _corta_si_baja(d_agente, corto)
		if shots <= 0:
			d_equipo = _corta_si_baja(d_equipo, corto)
	d_aficion -= d_aficion_cameo





















	if pending_injury_weeks > 0:
		d_tecnico = maxf(d_tecnico, 0.0)
		d_equipo = maxf(d_equipo, 0.0)
		d_aficion = maxf(d_aficion, 0.0)
		d_prensa = maxf(d_prensa, 0.0)
		d_agente = maxf(d_agente, 0.0)











	if result < 0 or ko_perdida:
		var culpa: float = rasgo_partido("culpa")
		d_aficion = _corta_si_baja(d_aficion, culpa)
		d_prensa = _corta_si_baja(d_prensa, culpa)

	d_prensa -= d_prensa_boys














	d_tecnico *= Coach.afinidad_mult(coach_idea, age, d_tecnico > 0.0, coach_nivel())



	d_tecnico = _corta_si_baja(d_tecnico, rasgo_partido("bronca"))


	d_aficion = Gerencia.grada_fiel(d_aficion, peldano())
	_apply_delta("tecnico", d_tecnico)
	_apply_delta("equipo", d_equipo)
	_apply_delta("aficion", d_aficion)
	_apply_delta("prensa", d_prensa)
	_apply_delta("agente", d_agente)





func _corta_si_baja(delta: float, factor: float) -> float:
	return delta * factor if delta < 0.0 else delta














































const CESION_EQUIPO: float = 3.0
const CESION_PRENSA: float = 2.0
const CESION_TECNICO: float = -2.5
const CESION_DESENLACE: float = 1.5






const CEDIDO_FALLO: float = -1.0


func cesion_penal_resolve(stake: Dictionary) -> void:
	if stake.is_empty():
		return
	if String(stake.get("tipo", "")) == "cedido":
		if not bool(stake.get("gol", false)):
			_apply_delta("equipo", CEDIDO_FALLO)
			_apply_delta("tecnico", CEDIDO_FALLO)
		return
	var base: Dictionary = {}
	if String(stake.get("tipo", "")) == "cesion":
		base = {"equipo": CESION_EQUIPO, "prensa": CESION_PRENSA,
			"tecnico": CESION_TECNICO}


	var extra: float = CESION_DESENLACE if bool(stake.get("gol", false)) \
			else - CESION_DESENLACE
	for key in ["equipo", "prensa", "tecnico"]:
		_apply_delta(key, float(base.get(key, 0.0)) + extra)

















const PEDIDO_EXITO: int = 2
const PEDIDO_FALLO: int = -1


func pedido_tiro_resolve(saldo: Dictionary, nacional: bool = false) -> void:
	var d: int = int(saldo.get("exitos", 0)) * PEDIDO_EXITO \
			+ int(saldo.get("fallos", 0)) * PEDIDO_FALLO
	if d == 0:
		return
	for key in ["tecnico", "equipo", "prensa", "aficion"]:
		if nacional and key != "prensa":
			nat_rel[key] = clampi(int(nat_rel.get(key, 50)) + d, 0, 100)
		else:
			rel[key] = clampi(int(rel.get(key, 50)) + d, 0, 100)





















func trivia_resolve(stake: Dictionary) -> float:
	if stake.is_empty() or not bool(stake.get("acierto", false)):
		return 0.0
	var antes: float = energy
	energy = minf(energy_cap(), energy + TRIVIA_ENERGY)
	return maxf(energy - antes, 0.0)


func senalado_resolve(stake: Dictionary) -> void:
	var quien: String = String(stake.get("name", ""))
	var eleccion: String = String(stake.get("choice", ""))
	if quien.is_empty() or eleccion.is_empty():
		return
	var ev: Dictionary = WeekEvents.moment_by_id("momento_senalado")
	if ev.is_empty() or not ev.has(eleccion):
		return
	var sello: String = _socio_escena
