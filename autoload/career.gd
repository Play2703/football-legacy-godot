func gerencia_renueva_prob(idx: int, nombre: String) -> float:
	var seat: Dictionary = _gerencia_asiento(idx, nombre)
	if seat.is_empty():
		return -1.0
	seat.erase("dec")
	var modo: String = AiMarket.modo_pedida(seat, GameState.season_num, false)
