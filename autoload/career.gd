func ballon_year(vivo_pais: String, vivo_div: int) -> Dictionary:
	var tramos: Array = _tramos_del_anio()
	for t in tramos:
		t["vota"] = BallonDor.eligible(vivo_pais, vivo_div) if bool(t["vivo"]) \
				else BallonDor.eligible(String(t["pais"]), int(t["div"]))
	var g: int = 0
	var a: int = 0
	var ucl_g: int = 0
	var ucl_a: int = 0
	var pen: int = 0
	var pen_ucl: int = 0
	var apps_vota: int = 0
	var notas: float = 0.0







	var entera: bool = true
	for t in tramos:
		if not bool(t["vota"]) and (bool(t["vivo"]) or int(t["apps"]) > 0):
			entera = false
	for t in tramos:
		ucl_g += int(t["ucl_g"])
		ucl_a += int(t["ucl_a"])
		pen_ucl += int(t["pen_ucl"])
		if not bool(t["vota"]):
			continue
		g += int(t["g"])
		a += int(t["a"])

		pen += maxi(int(t["pen"]) - int(t["pen_ucl"]), 0)
		apps_vota += int(t["apps"])
		notas += float(t["notas"])
	return {
		"goals": g, "assists": a, "ucl_goals": ucl_g, "ucl_assists": ucl_a,
		"pen_goals": pen, "ucl_pen_goals": pen_ucl,

		"avg": notas / float(apps_vota) if apps_vota > 0 else 6.0,
		"apps": apps_vota,
		"entera": entera,
	}












func _tramos_del_anio() -> Array:
	var tramos: Array = [{
		"vivo": true, "pais": "", "div": 0,
		"g": season_goals_league, "a": season_assists_league,
		"pj": season_matches_in("league"),
		"ucl_g": season_goals_ucl, "ucl_a": season_assists_ucl,
		"pen": season_pen_goals, "pen_ucl": season_pen_goals_ucl,
		"apps": season_matches, "notas": season_rating_sum,
	}]
	for r in season_history:
		if not bool(r.get("partial", false)) \
				or int(r.get("season", 0)) != anio_vivo():
			continue
		var ucl: Dictionary =(r.get("comps", {}) as Dictionary).get("ucl", {})
		var apps: int = int(r.get("apps", 0))
		tramos.append({
			"vivo": false, "pais": Teams.country_of(String(r.get("club", ""))),
			"div": int(r.get("div", 1)),
			"g": int(r.get("goals_league", 0)), "a": int(r.get("assists_league", 0)),
			"pj": int(r.get("apps_league", 0)),
			"ucl_g": int(ucl.get("g", 0)), "ucl_a": int(ucl.get("a", 0)),
			"pen": int(r.get("pen_goals", 0)), "pen_ucl": int(r.get("pen_goals_ucl", 0)),
			"apps": apps, "notas": float(r.get("avg", 0.0)) * float(apps),
		})
	return tramos
















func liga_del_anio(pais: String, div: int) -> Dictionary:
	var g: int = 0
	var a: int = 0
	var pj: int = 0
	var apps: int = 0
	var notas: float = 0.0
	for t in _tramos_del_anio():
		if not bool(t["vivo"]) and (String(t["pais"]) != pais or int(t["div"]) != div):
			continue
		g += int(t["g"])
		a += int(t["a"])
		pj += int(t["pj"])
		apps += int(t["apps"])
		notas += float(t["notas"])
	return {"g": g, "a": a, "pj": pj, "apps": apps,
		"avg": notas / float(apps) if apps > 0 else 6.0}




