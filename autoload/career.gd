func resolve_shirt_choice(n: int) -> String:

	decision_abierta = {}
	var mine: int = GameState.player_number
	var msg: String = ""
	var cede: String = ""
	if _shirt_mode == SHIRT_MODE_NIVEL and n > 0 and n != mine:
		gerencia["dorsal"] = {"season": GameState.season_num,
			"club": GameState.player_team_id}
		var dueno: Dictionary = _dorsal_dueno(n)
		if not dueno.is_empty():
			var rng: RandomNumberGenerator = RandomNumberGenerator.new()
			rng.seed = hash("dorsal_nivel|%s|%d|%d|%s" % [GameState.player_team_id,
				GameState.season_num, n, String(dueno["name"])])
			cede = CareerUi.surname(String(dueno["name"]))
			if rng.randf() >= dorsal_cede_p(n):
				msg = I18n.tf("{0} no te cede el {1}. Sigues con el {2}.", [cede, n, mine])
				n = mine
			else:

				_rel_golpe("equipo", dorsal_coste(n))
		Telemetry.count("dorsal_nivel_si" if n != mine else "dorsal_nivel_no")
	if n > 0 and n != mine:
		_set_shirt(n)
		msg = I18n.tf("{0} te cede el {1}.", [cede, n]) if not cede.is_empty() \
				else I18n.tf("Te pones el {0}.", [n])
	elif msg.is_empty():
		msg = I18n.tf("Sigues con el {0}.", [mine])
	pending_decision = ""
	pending_decision_club = ""
	pending_decision_club_b = ""
	pending_shirt_offer = []
	_shirt_mode = SHIRT_MODE_LIBRE
	_save()
	changed.emit()
	return msg





func _dorsal_dueno(n: int) -> Dictionary:
	var club: String = GameState.player_team_id
	var nominal: Array = Squad.of_nominal(club)
	var meta: Array = _ensure_squad_meta(club, nominal)
	for i in nominal.size():
		var p: Dictionary = nominal[i]
		if int(p.get("number", 0)) != n:
			continue
		var edad: int = int((meta[i] as Dictionary).get("age", 26)) if i < meta.size() else 26
		return {"name": String(p.get("name", "")), "age": edad}
	return {}




func dorsal_cede_p(n: int) -> float:
	var dueno: Dictionary = _dorsal_dueno(n)
	if dueno.is_empty():
		return 1.0
	return Gerencia.prob_dorsal(peldano(), int(dueno["age"]))









