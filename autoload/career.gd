	if injury_weeks >= GRAVE_WEEKS:
		var foto: Dictionary = _tele.get("foto", {})
		if int(foto.get("season", -1)) != GameState.season_num:
			var fila: Dictionary = GameState.league_table.get(GameState.YOU_KEY, {})
			_tele["foto"] = {"season": GameState.season_num, "pj": int(fila.get("pj", 0)),
				"pts": int(fila.get("pts", 0)), "puesto": GameState.league_position()}
	if injury_weeks < ProgramasTele.PARTE_MIN:
		return
	var d: Dictionary = tele_parte_payload()
	_tele_encola(Ceremonies.PARTE_MEDICO, ProgramasTele.PARTE, d,
		[str(int(d["semanas"])), str(int(d["perdidos"]))])





func tele_parte_payload() -> Dictionary:
	var semana: float = GameState.fixture_week(GameState.current_fixture())
	var proximos: Array = []
	for i in range(GameState.season_day + 1, GameState.calendar.size()):
		var fx: Dictionary = GameState.calendar[i]
		if bool(fx.get("dead", false)) or String(fx.get("comp", "")) == "nat" \
				or String(fx.get("opp", "")).is_empty():
			continue
		proximos.append(fx)
	var filas: Array = []
	var gordos: int = 0
	for fx in ProgramasTele.perdidos(proximos, semana, injury_weeks):
		var opp: String = String(fx.get("opp", ""))
		var gordo: String = ""
		if String(fx.get("round", "")) == "Final":
			gordo = "FINAL"
		elif Rivalries.is_main_derby(GameState.player_team_id, opp):
			gordo = "DERBI"
		if not gordo.is_empty():
			gordos += 1
		filas.append({"opp": opp, "home": bool(fx.get("home", true)), "gordo": gordo})
	var d: Dictionary = _tele_base()
	d["semanas"] = injury_weeks
	d["perdidos"] = filas.size()
	d["gordos"] = gordos
	d["partidos"] = filas.slice(0, ProgramasTele.PARTE_FILAS)
	return d





func _tele_vuelta() -> void:
	var foto: Dictionary = _tele.get("foto", {})
	_tele.erase("foto")
	if int(foto.get("season", -1)) != GameState.season_num:
		return
	var fila: Dictionary = GameState.league_table.get(GameState.YOU_KEY, {})
	var pj_con: int = int(foto.get("pj", 0))
	var pj_sin: int = int(fila.get("pj", 0)) - pj_con
	if pj_con < ProgramasTele.VUELTA_MIN_PJ or pj_sin < ProgramasTele.VUELTA_MIN_PJ:
		return
	var d: Dictionary = _tele_base()
	d["pj_con"] = pj_con
	d["pj_sin"] = pj_sin
	d["ppp_con"] = ProgramasTele.ppp(int(foto.get("pts", 0)), pj_con)
	d["ppp_sin"] = ProgramasTele.ppp(int(fila.get("pts", 0)) - int(foto.get("pts", 0)), pj_sin)
	d["puesto_antes"] = int(foto.get("puesto", 0))
	d["puesto"] = GameState.league_position()
	_tele_encola(Ceremonies.TELE_VUELTA, ProgramasTele.VUELTA, d,
		[String.num(float(d["ppp_con"]), 1), String.num(float(d["ppp_sin"]), 1)])






func _tele_tras_partido(goals: int, minutes: int, comp: String, ctx: Dictionary,
		roja: bool) -> void:
	if comp == "nat" or minutes <= 0:
		return
	var fx: Dictionary = GameState.current_fixture()
	var reg: Array = _tele.get("goles", [])
	reg.append(goals)
	while reg.size() > ProgramasTele.REGISTRO_MAX:
		reg.pop_front()
	_tele["goles"] = reg
	var r: Dictionary = ProgramasTele.racha(reg, Squad.line_of(Squad.USER_POS) == "DEL")
	var tipo: String = String(r["tipo"])
	if tipo.is_empty():
		_tele["racha_avisada"] = ""
	elif tipo != String(_tele.get("racha_avisada", "")):
		var cuenta: Dictionary = _tele.get("rachas", {})
		if int(cuenta.get("season", -1)) != GameState.season_num:
			cuenta = {"season": GameState.season_num, "n": 0}
		if int(cuenta["n"]) < ProgramasTele.RACHAS_TEMPORADA:
			cuenta["n"] = int(cuenta["n"]) + 1
			_tele["rachas"] = cuenta
			_tele["racha_avisada"] = tipo
			var d: Dictionary = _tele_base()
			d["n"] = int(r["n"])
			d["goles"] = reg.slice(maxi(reg.size() - int(r["n"]), 0))
			_tele_encola(Ceremonies.RACHA_TELE, tipo, d, [str(int(r["n"]))])
	var caso: String = ""
	if roja:
		caso = ProgramasTele.ROJA
	elif int(ctx.get("penal_misses", 0)) > 0:
		caso = ProgramasTele.PENAL
	elif bool(ctx.get("gol_final", false)):
		caso = ProgramasTele.GOL_FINAL
	if caso.is_empty() or not ctx.has("gf"):
		return
	var ultima: int = int(_tele.get("moviola", -999))
	if GameState.matches_played - ultima < ProgramasTele.MOVIOLA_HUECO:
		return
	_tele["moviola"] = GameState.matches_played
	var d: Dictionary = _tele_base()
	d["caso"] = caso
	d["opp"] = String(fx.get("opp", ""))
	d["home"] = bool(fx.get("home", true))
	d["gf"] = int(ctx.get("gf", 0))
	d["ga"] = int(ctx.get("ga", 0))
	_tele_encola(Ceremonies.MOVIOLA, caso, d, ["%d-%d" % [int(d["gf"]), int(d["ga"])]])




func _tele_once(fila: Dictionary) -> void:
	var xi: Array = fila.get("xi", [])
	if xi.is_empty():
		return
	var d: Dictionary = _tele_base()
	d["season"] = int(fila.get("season", GameState.season_num))
	d["xi"] = xi.duplicate(true)
	d["you_in"] = bool(fila.get("you_in", false))
	d["div"] = int(fila.get("div", 1))
	_tele_encola(Ceremonies.ONCE_TELE,
		ProgramasTele.ONCE_DENTRO if bool(d["you_in"]) else ProgramasTele.ONCE_FUERA, d, [])





func _tele_lista() -> void:
	if nationality.is_empty() or int(_tele.get("lista", 0)) == GameState.season_num:
		return
	if String(GameState.current_fixture().get("comp", "")) != "nat":
		return
	var cu: Dictionary = nat_callup()
	if cu.is_empty() or bool(cu.get("retired", false)):
		return
	var lista: Array = nat_squad_list()
	if lista.is_empty():
		return
	_tele["lista"] = GameState.season_num
	var estado: String = nat_role()
	var linea: String = Squad.line_of(Squad.USER_POS)
	var filas: Array = []
	for x in lista:
		var e: Dictionary = x
		if bool(e.get("is_you", false)):
