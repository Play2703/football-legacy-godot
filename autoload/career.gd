func _cambios_simulados(squad: Array, meta: Array, once: Array, banca: Array) -> Array:
	if once.is_empty() or banca.is_empty():
		return []
	var veta: Dictionary = {}
	var mio: int = Squad.user_index(squad)
	if mio >= 0:
		veta[mio] = true




	for s in once:
		if int(s) >= 0 and int(s) < squad.size() and Squad.es_yo_hoy(squad[int(s)]):
			veta[int(s)] = true
	var sombra: int = Squad.user_index_en(squad, puesto_hoy(), false)
	if sombra >= 0:
		veta[sombra] = true


	var huecos: Dictionary = Cambios.huecos_de(once,
		Squad.formation_slots(GameState.player_team_id).slice(0, Squad.STARTING_XI))
	var plan: Array = Cambios.plan(squad, meta, once, banca, factor_de_hoy(), veta,
		Cambios.ENERGIA_MIN_DEFECTO, huecos)
	if plan.is_empty():
		plan = Cambios.plan_por_nivel(squad, meta, once, banca, veta,
			Cambios.ENERGIA_MIN_DEFECTO, huecos)
	return plan





