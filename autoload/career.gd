const SOCIO_MAX: int = 40



const SOCIO_UMBRAL: int = 12









const SOCIO_PRESENCIA_TOPE: int = SOCIO_UMBRAL - 1


const SOCIO_DECAY: float = 0.75


const SOCIO_TOPE: int = 120







const SEMILLA_EX: int = SOCIO_UMBRAL



const SEMILLA_CLUB: int = 6


const SEMILLA_RIVAL: int = - SOCIO_UMBRAL




const SEMILLA_TOPE: int = 4










func record_socio(entries: Dictionary, comp: String, you_played: bool) -> void:
	var key: String = "league" if comp == "" else comp
	if not MATE_COMPS.has(key):
		return
	var team_id: String = GameState.player_team_id
	var squad: Array = Squad.of_nominal(team_id)
	if squad.is_empty():
		return
	var puntos: Dictionary = {}
	for nm in entries:
		var name: String = String(nm)
		if name.is_empty() or name == player_name:
			continue
		puntos[name] = int(puntos.get(name, 0)) + int(entries[nm])




	if you_played:
		for i in club_lineup():
			var idx: int = int(i)
			if idx < 0 or idx >= squad.size() or idx == Squad.user_index(squad):
				continue
			var nm2: String = String((squad[idx] as Dictionary).get("name", ""))
			if nm2.is_empty() or nm2 == player_name:
				continue











			if int((socios.get(nm2, {}) as Dictionary).get("v", 0)) >= SOCIO_PRESENCIA_TOPE:
				continue
			puntos[nm2] = int(puntos.get(nm2, 0)) + 1
	last_socios = puntos
	if puntos.is_empty():
		return
	for nm in puntos:
		_bump_socio(String(nm), int(puntos[nm]), team_id, squad)




	_save()




func _bump_socio(person: String, d: int, team_id: String, squad: Array) -> void:
	var idx: int = -1
	for i in squad.size():
		if String((squad[i] as Dictionary).get("name", "")) == person:
			idx = i
			break
	if idx < 0:


		return
	var ficha: Dictionary = socios.get(person, {})
	if ficha.is_empty():
		var pos: String = String((squad[idx] as Dictionary).get("pos", "MC"))
		ficha = {
			"v": 0, "club": team_id, "idx": idx, "alta": GameState.season_num,
			"edad": WorldAging.seat_age(team_id, idx, pos, GameState.season_num),
			"estado": "vivo",
		}
	ficha["v"] = clampi(int(ficha.get("v", 0)) + d, - SOCIO_MAX, SOCIO_MAX)
	socios[person] = ficha



















func semilla_socio(mias: Array, desde_mia: int, club_hoy: String, suyas: Array,
		season: int) -> Dictionary:
	var out: Dictionary = {"v": 0, "ex": "", "club": "", "rival": ""}
	var v: int = 0
	var juntos: Array = []
	for t in TransferBook.solapan(mias, desde_mia, club_hoy, suyas, season, "", season):
		if String((t as Dictionary).get("club", "")) != club_hoy:
			juntos.append(t)
	if TransferBook.temporadas_juntos(juntos) > 0:

		out["ex"] = String((juntos[juntos.size() - 1] as Dictionary).get("club", ""))
		v += SEMILLA_EX
	else:
		var comunes: Array = TransferBook.clubes_comunes(mias, "", suyas, "")
		comunes.erase(club_hoy)
		if not comunes.is_empty():
			out["club"] = String(comunes[comunes.size() - 1])
			v += SEMILLA_CLUB
	var origen: String = TransferBook.ultimo_club(suyas)
	if Rivalries.are_rivals(origen, club_hoy):
		out["rival"] = origen
		v += SEMILLA_RIVAL
	out["v"] = clampi(v, - SOCIO_UMBRAL, SOCIO_UMBRAL)
	return out















func _siembra_vestuario(person: String, suyas: Array) -> void:
	var team_id: String = GameState.player_team_id
	if team_id.is_empty() or person.is_empty() or person == player_name \
			or socios.has(person):
		return
	var season: int = GameState.season_num
	var hechas: int = 0
	for nm in socios:
		var f: Variant = socios[nm]
		if not (f is Dictionary):
			continue
		var sem: Variant =(f as Dictionary).get("semilla", null)
		if sem is Dictionary and int((sem as Dictionary).get("s", -1)) == season:
			hechas += 1
	if hechas >= SEMILLA_TOPE:
		return
	var mia: Dictionary = TransferBook.trayectoria_propia(start_club, transfers, team_id,
		not loan.is_empty())
	var s: Dictionary = semilla_socio(mia.get("etapas", []), int(mia.get("desde", 1)),
		team_id, suyas, season)
	if String(s["ex"]).is_empty() and String(s["club"]).is_empty() \
			and String(s["rival"]).is_empty():
		return


	_bump_socio(person, int(s["v"]), team_id, Squad.of_nominal(team_id))
	if not socios.has(person):
		return
	(socios[person] as Dictionary)["semilla"] = {"ex": String(s["ex"]),
		"club": String(s["club"]), "rival": String(s["rival"]), "s": season}
	_save()






func socio_semilla(person: String) -> Dictionary:
