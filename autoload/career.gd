func ex_para_mercado() -> Dictionary:
	var out: Dictionary = {}
	var carino: Dictionary = ex_clubes_de_tu_carrera()
	if carino.is_empty():
		return out
	var hoy: String = GameState.player_team_id
	var cedido: bool = not loan.is_empty()
	var dueno: String = String(loan.get("parent", "")) if cedido else ""
	var etapas: Array = TransferBook.trayectoria_propia(start_club, transfers, hoy,
		cedido).get("etapas", []) as Array
	for id in carino:
		var cid: String = String(id)
		if cid.is_empty() or cid == hoy or cid == dueno:
			continue
		var temporadas: int = TransferBook.temporadas_en(etapas, cid)
		var en_historial: bool = false
		for row in season_history:
			if String((row as Dictionary).get("club", "")) == cid:
				en_historial = true
				break
		if temporadas <= 0 and not en_historial:
			continue
		out[cid] = {"casa": clampf(float(carino[id]) / 100.0, 0.0, 1.0),
			"temporadas": temporadas}
	return out


