func _settle_transfer_money(seller: String, buyer: String, amount: int) -> void:
	if amount <= 0:
		return


	var para_vendedor: int = amount
	var due: int = sell_on_due(amount)
	if due > 0:
		var acreedor: String = String(sell_on.get("club", ""))
		para_vendedor -= due
		_club_cash_add(acreedor, due)
		_market_note(TAG_SELL_ON,
			Competitions.demarca(String(Teams.by_id(acreedor).get("name", ""))),
			acreedor)


	sell_on = {}
	_club_cash_add(seller, para_vendedor)
	_club_cash_add(buyer, - amount)




func sell_on_due(amount: int) -> int:
	if sell_on.is_empty() or amount <= 0:
		return 0
	return int(float(amount) * clampf(float(sell_on.get("pct", 0.0)), 0.0, 1.0))











func _club_cash_add(club_id: String, delta: int) -> void:
	if club_id.is_empty() or Teams.by_id(club_id).is_empty():
		return
	_seed_cash(club_id, {})
	club_cash[club_id] = int(club_cash[club_id]) + delta


















func _stamp_sell_on(seller: String, buyer: String, paid: int, pacto: bool = false) -> void:
	sell_on = {}
	buyback = {}
	if seller.is_empty() or seller == buyer:
		return
	var sr: int = Teams.rating(seller)
	var br: int = Teams.rating(buyer)
	var pct: float = Market.sell_on_pct(seller, buyer, GameState.season_num, sr, br)
	if pacto:
		pct = maxf(pct, Salida.PACTO_SELL_ON)
	if pct > 0.0:
		sell_on = {"club": seller, "pct": pct}
	var bb: int = Market.buyback_fee(seller, buyer, GameState.season_num, paid, sr, br)
	if pacto and bb <= 0 and paid > 0:
		bb = int(float(paid) * Market.BUYBACK_MULT)
	if bb > 0:
		buyback = {"club": seller, "fee": bb,
			"until": GameState.season_num + Market.BUYBACK_SEASONS}


func _exclub_reacts(exclub: String) -> void:
	if exclub.is_empty() or Teams.by_id(exclub).is_empty():
		return
	if not _ai_scope().has(exclub):
		return




	var squad: Array = Squad.home_of(exclub)
	var idx: int = -1
	var ocupados: Dictionary = {}






	var hueco: String = puesto_en(exclub)
	for i in squad.size():
		ocupados[String(squad[i].get("name", ""))] = true




	idx = Squad.user_index_en(squad, hueco, false)
	if idx < 0:
		return
	var ident: Dictionary = AiMarket.youth_identity(exclub, hueco,
		Teams.rating(exclub), Teams.country_of(exclub), GameState.season_num,
		hash("relevo|%s|%d" % [exclub, GameState.season_num]), ocupados)



	if not _asienta(exclub, idx, ident, GameState.season_num, "", TransferBook.SIN_ORIGEN, {}):
		return
	_patch_squad_meta(exclub, idx, ident)
	TransferBook.invalidate_caches()


	market_news.push_front({"season": GameState.season_num,
		"day": GameState.season_day, "kind": "youth",
		"name": String(ident.get("name", "")), "pos": Squad.USER_POS,
		"from": "", "to": exclub, "fee": 0, "free": true,



		"media": SquadMeta.ovr_of(ident, Squad.USER_POS),
		"nation": String(ident.get("nation", ""))})
	market_news_total += 1
	if market_news.size() > MARKET_NEWS_MAX:
		market_news = market_news.slice(0, MARKET_NEWS_MAX)





func _via_de_move(m: Dictionary) -> String:
	match String(m.get("kind", "")):
		"loan":
			return TransferBook.VIA_CESION
		"exit":
			return TransferBook.VIA_LIBRE
	return TransferBook.VIA_FICHAJE








func _carrera_de_move(m: Dictionary, season: int, mapas: Dictionary) -> Array:
	var pre: Variant = m.get("carrera", null)
	if pre is Array and not (pre as Array).is_empty():
		return TransferBook.sanea_carrera(pre)
	var ident: Dictionary = m.get("identity", {})
	if ident.get("carrera", null) is Array:
		return TransferBook.sanea_carrera(ident["carrera"])
	return _salida_de(String(m.get("from", "")), int(m.get("from_idx", -1)), season,
		_via_de_move(m), String(m.get("pos", "")), mapas)["carrera"]

















func _mapa_libro(team_id: String) -> Array:
	return TransferBook.mapa_libro(team_id)




func _filas_base(team_id: String) -> int:
	var seats: int = WorldAging._factory_seats(team_id)
	var mapa_base: Array = RosterDelta.mapa_fabrica(team_id, true, seats)
	return seats if mapa_base.is_empty() else mapa_base.size()





func _libro_idx(team_id: String, h: int, mapas: Dictionary) -> int:
	if h < 0:
		return h
	if not mapas.has(team_id):
		mapas[team_id] = _mapa_libro(team_id)
	var mapa: Array = mapas[team_id]
	if mapa.is_empty():
		return h
	return int(mapa[h]) if h < mapa.size() else -1







func _salida_de(team_id: String, h: int, season: int, via: String, pos: String,
		mapas: Dictionary) -> Dictionary:
	var b: int = _libro_idx(team_id, h, mapas)
	if h >= 0 and b < 0:


		return {"origen": {"f_idx": TransferBook.NADIE},
			"carrera": _carrera_de_alta(team_id, h, season, via)}
	return {"origen": TransferBook.origin_of(team_id, b),
		"carrera": TransferBook.carrera_al_salir(team_id, b, season, via, pos)}





func _carrera_de_alta(team_id: String, h: int, season: int, via: String) -> Array:
	var casa: Array = Squad.home_of(team_id)
	if h < 0 or h >= casa.size():
		return []
	var row: Dictionary = casa[h]
	var etapas: Array = TransferBook.sanea_carrera(row.get("carrera", null))
	etapas.append({"club": team_id, "desde": int(row.get("etapa_desde", season)),
		"hasta": maxi(season, 0),
		"via": via if TransferBook.VIAS.has(via) else TransferBook.VIA_FICHAJE})
	if etapas.size() > TransferBook.CARRERA_MAX:
		etapas = etapas.slice(etapas.size() - TransferBook.CARRERA_MAX)
	return etapas







func _asienta(team_id: String, h: int, ident: Dictionary, season: int, from_id: String,
		from_idx: int, mapas: Dictionary) -> bool:
	var b: int = _libro_idx(team_id, h, mapas)
	if b >= 0:
		TransferBook.record(team_id, b, ident, season, from_id, from_idx, h)
		return true
	if h < 0:
		return false
	var fila: Dictionary = ident.duplicate()

	fila["etapa_desde"] = season
	if not RosterDelta.reidentifica(team_id, h, _filas_base(team_id), fila):
		return false
	TransferBook.olvida_contrato(team_id, h)
	return true











func _aplica_contratos_npc(moves: Array, window_id: String) -> Array:
	moves = _gerencia_avisos(moves)
	var s: int = GameState.season_num
	var resto: Array = []
	var tocados: Dictionary = {}
	var filas: Array = []
	var pre_news: Array = []
	var fuera: Array = []
	for raw in moves:
		var m: Dictionary = raw
		if String(m.get("kind", "")) != AiMarket.KIND_CONTRATO:
			resto.append(m)
			continue
		var tid: String = String(m.get("club", ""))
		var idx: int = int(m.get("idx", -1))
		if tid.is_empty() or idx < 0:
			continue
		if String(m.get("que", "")) == "precontrato":
			TransferBook.precontrata(tid, idx, String(m.get("pre", "")))
		else:
			TransferBook.marca_contrato(tid, idx, m.get("fila", {}))
		tocados[tid] = true
		var f: Dictionary = _fila_contrato_de(m, s)
		if f.is_empty():
			continue
		if String(m.get("que", "")) == "precontrato":
			pre_news.append({"f": f, "media": int(m.get("media", 0))})
		elif not WorldNews.es_tuya(f):
			fuera.append({"f": f, "media": int(m.get("media", 0)),
				"se_va": String(m.get("que", "")) == "se_va"})
		elif not WorldNews.ya_contrato(world_news + filas, s, tid):
			filas.append(f)
	fuera.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if bool(a["se_va"]) != bool(b["se_va"]):
			return bool(a["se_va"])
		return int(a["media"]) > int(b["media"]))
	pre_news.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a["media"]) > int(b["media"]))
	for lote in [[fuera, CONTRATO_NOTICIAS_MAX], [pre_news, PRECONTRATO_NOTICIAS_MAX]]:
		var puestas: int = 0
		for p in (lote[0] as Array):
			if puestas >= int(lote[1]):
				break
			var fp: Dictionary = p["f"]
			if not WorldNews.ya_contrato(world_news + filas, s, String(fp.get("club", ""))):
				filas.append(fp)
				puestas += 1
	for tid in tocados:
		if squad_meta.get(tid) is Array:
			TransferBook.apply_contratos(tid, squad_meta[tid], s)
	_push_world_news(filas)
	if window_id == Market.WINDOW_SUMMER:
		contratos_npc_v = CONTRATOS_NPC_V
	return resto




func _fila_contrato_de(m: Dictionary, s: int) -> Dictionary:
	var kind: String = ""
	var relevante: bool = false
	match String(m.get("que", "")):
		"renueva":
			kind = "renueva"
			relevante = bool(m.get("estrella", false))
		"se_va":



			kind = "no_renueva"
			relevante = bool(m.get("estrella", false))
		"precontrato":
			kind = "precontrato"
			relevante = true
		_:
			return {}
	var fila: Dictionary = m.get("fila", {})
	var fin: int = TransferBook.anio_de(int(fila.get("dec", s)) + int(fila.get("c", 1)) - 1) + 1
	var pre: String = String(m.get("pre", "")) if kind == "precontrato" else ""
	return WorldNews.fila_contrato(s, GameState.season_day, kind, String(m.get("club", "")),
		pre, String(m.get("name", "")), fin, relevante)


func _apply_ai_moves(moves: Array) -> void:
	var season: int = GameState.season_num


	var huella: Dictionary = TransferBook.huella_clubes()




	moves = moves.filter(func(mv: Variant) -> bool:
		return not String((mv as Dictionary).get("kind", "")) in [AiMarket.KIND_CONTRATO,
			AiMarket.KIND_AVISO])






	var rotos: Array = _asientos_rotos(moves)
	if not rotos.is_empty():
		moves = _sin_cadenas(moves, rotos)


	var mapas: Dictionary = {}








	moves = moves.filter(func(mv: Variant) -> bool:
		var d: Dictionary = mv
		if String(d.get("kind", "")) != "loan":
			return true
		return _libro_idx(String(d.get("from", "")), int(d.get("from_idx", -1)), mapas) >= 0 \
				and _libro_idx(String(d.get("to", "")), int(d.get("to_idx", -1)), mapas) >= 0)





	var origenes: Array = []
	for m in moves:




		var o_pre: Variant =(m as Dictionary).get("origen", null)
		if o_pre is Dictionary:
			origenes.append(o_pre)
			continue
		origenes.append(_salida_de(String(m.get("from", "")), int(m.get("from_idx", -1)),
			season, _via_de_move(m), String(m.get("pos", "")), mapas)["origen"])







	var carreras: Array = []
	for m in moves:
		var etapas_m: Array = _carrera_de_move(m as Dictionary, season, mapas)
		carreras.append(etapas_m)
		if not etapas_m.is_empty() and not (m as Dictionary).has("carrera"):
			(m as Dictionary)["carrera"] = etapas_m
	for mi in moves.size():
		var m: Dictionary = moves[mi]
		var origen: Dictionary = origenes[mi]
		var to_id: String = String(m.get("to", ""))
		var idx: int = int(m.get("to_idx", -1))
		if to_id.is_empty() or idx < 0:
			continue


		var ident: Dictionary =(m.get("identity", {}) as Dictionary).duplicate()
		var etapas: Array = carreras[mi]
		if not etapas.is_empty():
			ident["carrera"] = etapas
		if String(m.get("kind", "")) == "loan":


			var lender: String = String(m.get("from", ""))
			var l_idx: int = int(m.get("from_idx", -1))



			var l_b: int = _libro_idx(lender, l_idx, mapas)
			var b_b: int = _libro_idx(to_id, idx, mapas)


			var desplazado: Dictionary =(m.get("displaced", {}) as Dictionary).duplicate()
			var o_desp: Dictionary = TransferBook.origin_of(to_id, b_b)
			if not o_desp.is_empty():
				desplazado["from"] = String(o_desp.get("from", ""))
				desplazado["f_idx"] = int(o_desp.get("f_idx", -1))




			var apartado: Dictionary = TransferBook.carrera_al_apartar(to_id, b_b,
				String(m.get("pos", "")), season)
			desplazado["etapa_desde"] = int(apartado["etapa_desde"])
			if not (apartado["carrera"] as Array).is_empty():
				desplazado["carrera"] = apartado["carrera"]



			TransferBook.record_loan(lender, l_b, to_id, b_b, ident,
				m.get("cover", {}), desplazado, season, season + 1, origen,
				int(m.get("buy_fee", 0)), int(m.get("vuelta", 0)), l_idx, idx)
			_patch_squad_meta(to_id, idx, ident)
			_patch_squad_meta(lender, l_idx, m.get("cover", {}))
			continue


		if not _asienta(to_id, idx, ident, season,
				String(origen.get("from", "")), int(origen.get("f_idx", -1)), mapas):
			continue
		_patch_squad_meta(to_id, idx, ident)
	TransferBook.invalidate_cambiados(huella)



	var income: Dictionary = _ai_income(_ai_scope())
	for m in moves:
		var fee: int = int(m.get("fee", 0))
		if fee <= 0:
			continue
		var to_id: String = String(m.get("to", ""))
		var from_id: String = String(m.get("from", ""))













		if Teams.is_free(to_id) or Teams.is_free(from_id):
			continue
		_seed_cash(to_id, income)
		club_cash[to_id] = int(club_cash[to_id]) - fee
		_seed_cash(from_id, income)
		club_cash[from_id] = int(club_cash[from_id]) + fee
	_push_market_news(moves)




	for m in moves:
		_apunta_llegada_de_move(m)


		_siembra_de_move(m)



	_take_free_agents(moves)
	_park_free_agents(moves)
	_maybe_star_gone(moves)

















func _maybe_star_gone(moves: Array) -> void:



	if _star_gone_done:
		return
	var club: String = GameState.player_team_id
	if club.is_empty() or retired or on_loan():
		return
	var rating: int = Teams.rating(club)
	var mejor: Dictionary = {}
	for m in moves:
		if String(m.get("kind", "")) == "loan":
			continue


		if bool(m.get("mesa", false)):
			continue
		if String(m.get("from", "")) != club:
			continue
		var pos: String = String(m.get("pos", "MC"))
		if not AiMarket.is_star(int(m.get("media", 0)), pos, rating):
			continue
		if mejor.is_empty() or int(m.get("fee", 0)) > int(mejor.get("fee", 0)):
			mejor = m
	if mejor.is_empty():
		return




	var llega: String = ""
	for m in moves:
		if String(m.get("kind", "")) != "signing" or String(m.get("to", "")) != club:
			continue
		if String(m.get("pos", "")) != String(mejor.get("pos", "")):
			continue
		llega = String(m.get("name", ""))
		break




	var destino: String = String(mejor.get("to", ""))
	_star_gone_done = true
	if not destino.is_empty() and Rivalries.are_rivals(club, destino):
		queue_ceremony(Ceremonies.AL_RIVAL, {


			"club": destino,
			"from": club,
			"name": String(mejor.get("name", "")),
			"media": _ovr_de_move(mejor),
			"fee": int(mejor.get("fee", 0)),
		})
		return
	queue_ceremony(Ceremonies.STAR_GONE, {
		"club": club,
		"name": String(mejor.get("name", "")),
		"pos": String(mejor.get("pos", "")),
		"media": _ovr_de_move(mejor),
		"fee": int(mejor.get("fee", 0)),
		"to": destino,
		"in_name": llega,
	})
























func _seed_cash(team_id: String, income: Dictionary) -> void:
	if club_cash.has(team_id):
		return
	var inc: int = int(income[team_id]) if income.has(team_id) \
			else club_income_of(team_id)
	club_cash[team_id] = ClubFinance.starting_cash(inc)






func _patch_squad_meta(team_id: String, idx: int, ident: Dictionary) -> void:
	var meta: Variant = squad_meta.get(team_id, null)
	if not (meta is Array) or idx < 0 or idx >=(meta as Array).size():
		return
	var pm: Dictionary =(meta as Array)[idx]
	pm["age"] = int(ident.get("age", 24))
	pm["nation"] = String(ident.get("nation", pm.get("nation", "")))
	pm["contract"] = int(ident.get("contract", 3))




	for k in ["se_va", "pre", "resiste", "dec", "gp_prev"]:
		pm.erase(k)




	pm["signed"] = int(ident.get("season", GameState.season_num))
	pm["gp"] = 0
	pm["goals"] = 0
	pm["rating_sum"] = 0.0







func _close_ai_loans() -> void:

	var huella: Dictionary = TransferBook.huella_clubes()
	var comprados: Dictionary = _loan_options_taken()
	var closed: Array = TransferBook.return_due(GameState.season_num, comprados)
	if closed.is_empty():
		return

	_drena_desalojados(GameState.season_num)
	TransferBook.invalidate_cambiados(huella)
	var mine: String = GameState.player_team_id
	for l in closed:
		var lender: String = String(l.get("lender", ""))
		var borrower: String = String(l.get("borrower", ""))
		var ficha: Dictionary = l.get("back_lender", {})




		var l_casa: int = TransferBook.casa_de_libro(lender, int(l.get("l_idx", -1)))
		var b_casa: int = TransferBook.casa_de_libro(borrower, int(l.get("b_idx", -1)))
		if bool(l.get("bought", false)):




			_patch_squad_meta(borrower, b_casa, ficha)
			_settle_transfer_money(lender, borrower, int(l.get("buy_fee", 0)))



			if lender == mine:
				_market_note(TAG_LOAN_BUY, String(ficha.get("name", "")), borrower)
			continue
		_patch_squad_meta(lender, l_casa, ficha)
		_patch_squad_meta(borrower, b_casa, l.get("back_borrower", {}))


		if lender == mine:
			_market_note(TAG_LOAN_BACK, String(ficha.get("name", "")))



















func _loan_options_taken() -> Dictionary:
	var out: Dictionary = {}
	var due: Array = TransferBook.due_loans(GameState.season_num)
	if due.is_empty():
		return out
	var cand: Array = []
	for l in due:
		var fee: int = int(l.get("buy_fee", 0))
		if fee <= 0:
			continue
		var borrower: String = String(l.get("borrower", ""))
		if borrower.is_empty() or Teams.by_id(borrower).is_empty():
			continue





		var b_casa: int = TransferBook.casa_de_libro(borrower, int(l.get("b_idx", -1)))
		var plantel: Array = Squad.home_of(borrower)
		if b_casa < 0 or b_casa >= plantel.size():
			continue
		var pos: String = String((plantel[b_casa] as Dictionary).get("pos", "MC"))










		var media: int = SquadMeta.media_of(_ficha_loan(l), pos) + TransferBook.loan_dev_bonus(l)
		if media < AiMarket.pos_bar(Teams.rating(borrower), pos) + AiMarket.LOAN_BUY_EDGE:
			continue
		if int(club_cash.get(borrower, 0)) < fee:
			continue
		cand.append({"key": TransferBook.loan_key(l), "fee": fee})
	cand.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a["fee"]) > int(b["fee"]))
	for i in mini(cand.size(), AiMarket.MAX_LOAN_BUYS):
		out[String(cand[i]["key"])] = true
	return out





func _ficha_loan(l: Dictionary) -> Dictionary:
	var f: Variant = l.get("back_lender", null)
	return f if f is Dictionary else {}























func _take_free_agents(moves: Array) -> void:
	for m in moves:
		if String(m.get("from", "")) != Teams.FREE_ID:
			continue
		var nom: String = String(m.get("name", ""))



		var pos: String = String(m.get("free_pos", m.get("pos", "")))
		for i in free_agents.size():
			var f: Dictionary = free_agents[i]
			if String(f.get("name", "")) == nom and String(f.get("pos", "")) == pos:
				free_agents.remove_at(i)
				break













func _park_free_agents(moves: Array) -> void:
	var season: int = GameState.season_num
	var mapas: Dictionary = {}
	for m in moves:
		if String(m.get("kind", "")) != "exit":
			continue
		var ident: Dictionary = m.get("identity", {})
		if ident.is_empty():
			continue
		var row: Dictionary = ident.duplicate()


		row["from"] = String(m.get("from", ""))







		var o_pre_libre: Variant = m.get("origen", null)
		var o_libre: Dictionary = {}
		if o_pre_libre is Dictionary:
			o_libre = o_pre_libre
		else:
			o_libre = _salida_de(String(m.get("from", "")), int(m.get("from_idx", -1)),
				season, _via_de_move(m), String(m.get("pos", "")), mapas)["origen"]
		if not o_libre.is_empty():
			row["o_from"] = String(o_libre.get("from", ""))
			row["o_idx"] = int(o_libre.get("f_idx", -1))
		row["pos"] = String(m.get("pos", "MC"))
		row["media"] = int(m.get("media", 0))
		row["since"] = season




		var etapas: Array = _carrera_de_move(m, season, mapas)
		if not etapas.is_empty():
			row["carrera"] = etapas
		free_agents.push_front(row)



	var vivos: Array = []
	for f in free_agents:
		if season - int((f as Dictionary).get("since", season)) < FREE_AGENT_SEASONS:
			vivos.append(f)
	free_agents = vivos
	if free_agents.size() > FREE_AGENTS_MAX:
		free_agents = free_agents.slice(0, FREE_AGENTS_MAX)













func _ovr_de_move(m: Dictionary) -> int:
	var ident: Variant = m.get("identity", null)
	if ident is Dictionary and not (ident as Dictionary).is_empty():
		return SquadMeta.ovr_of(ident, String(m.get("pos", "MC")))
	return int(m.get("media", 0))


func _push_market_news(moves: Array) -> void:
	for m in moves:
		var k: String = String(m.get("kind", ""))
		if k == "signing" or k == "exit" or k == "loan":
			var noticia: Dictionary = {
				"season": GameState.season_num, "day": GameState.season_day,
				"kind": k,
				"name": String(m.get("name", "")), "pos": String(m.get("pos", "")),
				"from": String(m.get("from", "")), "to": String(m.get("to", "")),
				"fee": int(m.get("fee", 0)), "free": bool(m.get("free", false)),
				"clausula": bool(m.get("clausula", false)),







				"media": _ovr_de_move(m),
				"nation": String((m.get("identity", {}) as Dictionary).get("nation", "")),



				"poss": Squad.poss_of({"pos": String(m.get("pos", "")),
					"name": String(m.get("name", "")),
					"poss":(m.get("identity", {}) as Dictionary).get("poss", m.get("poss"))}),
			}




			if k == "loan" and int(m.get("vuelta", 0)) >= 1:
				noticia["vuelta"] = int(m.get("vuelta", 0))



			if bool(m.get("precontrato", false)):
				noticia["precontrato"] = true
			market_news.push_front(noticia)
			market_news_total += 1
	if market_news.size() > MARKET_NEWS_MAX:
		market_news = market_news.slice(0, MARKET_NEWS_MAX)




func market_news_unseen() -> int:
	return maxi(0, market_news_total - market_news_seen)
















func club_news_unseen() -> Dictionary:
	var out: Dictionary = {"in": 0, "out": 0}
	var mine: String = GameState.player_team_id
	if mine.is_empty():
		return out
	var pend: int = mini(market_news_unseen(), market_news.size())
	for i in pend:
		var n: Dictionary = market_news[i]
		if String(n.get("to", "")) == mine:
			out["in"] = int(out["in"]) + 1
		elif String(n.get("from", "")) == mine:
			out["out"] = int(out["out"]) + 1
	return out




