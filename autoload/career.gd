func _crece_solar(nuevo: int) -> void:
	nuevo = House.clamp_tier(nuevo)
	var antes: int = House.clamp_tier(land_tier)
	if nuevo <= antes:
		return


	var key: String = House.layout_key(house_level)
	var pl_viejo: Dictionary = House.plan_of(house_level)


	if house_extras.has("cochera"):
		pl_viejo = pl_viejo.duplicate(true)
