func _resolve_haggles() -> void:
	var kept: Array = []
	for o in pending_offers:
		if not o.has("haggle"):
			kept.append(o)
			continue
		var kind: String = String(o["haggle"])
		o.erase("haggle")
		var res: Dictionary = Market.haggle_resolve(o, int(rel["agente"]), kind, randf())

		var club: String = Market.club_name(o, "El club")
		match String(res["outcome"]):
			"up":
				var better: Dictionary = res["offer"]

				better["expires"] = o.get("expires", better.get("expires", GameState.season_day))
				kept.append(better)







				_market_note(TAG_WAGE_UP if kind == "wage" else TAG_ROLE_UP,
					club, String(o.get("id", "")))
				haggle_results.append({"tag": TAG_WAGE_UP if kind == "wage"
					else TAG_ROLE_UP, "name": club})
			"walk":


				_market_note(TAG_WALK, club, String(o.get("id", "")), true)
				haggle_results.append({"tag": TAG_WALK, "name": club})


				_remember_missed(String(o.get("id", "")))
			_:
				kept.append(res["offer"])
				_market_note(TAG_HOLD, club, String(o.get("id", "")))
				haggle_results.append({"tag": TAG_HOLD, "name": club})
	pending_offers = kept















func _maybe_hot_rumor() -> void:
	if _market_settled or on_loan():
		return
	if _hot_rumor_day == GameState.season_day:
		return
	_hot_rumor_day = GameState.season_day

	if last_rating < MARKET_HOT_RATING or _rumor_plazas() >= HOT_RUMOR_MAX:
		return
	if randf() >= HOT_RUMOR_P:
		return


	var pool: Array = Market.candidates(scout_profile(), GameState.player_team_id,
		_market_floor())
	if pool.is_empty():
		return
	pool = pool.slice(0, RUMOR_POOL)
	pool.shuffle()
	for cand in pool:
		var id: String = String(cand.get("id", ""))


		if id.is_empty() or _market_rumors.has(id) or _rumor_asked.has(id) \
				or club_vetado(id):
			continue
		_market_rumors.append(id)


		_maybe_ojeador(id)
		break
	_save()
	changed.emit()




