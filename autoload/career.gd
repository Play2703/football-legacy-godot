func selfie_publica(tomas: Array) -> Array:
	if GameState.readonly_save:
		return []
	var temporada: int = GameState.season_num - 1
	var dia: int = GameState.season_day
	var partido: int = dia if _muro_noche == dia else dia - 1
	var escritas: Array = []

	var club: Dictionary = Teams.by_id(GameState.player_team_id)
	var pool: String = String(club.get("surnames", club.get("league", "España")))


	var pub: Array = SelfieMotor.a_publicar(tomas)
	pub.reverse()
	for t in pub:
		var id: String = SelfieFotos.id_de("%s|%d|%d" % [String(t.get("semilla", "")),
			temporada, dia], int(t.get("k", escritas.size())))
		var foto: String = id if SelfieFotos.guarda(t.get("img") as Image, id) else ""
		var nombre: String = MuroRedes.nombre_fan("%s|%d" % [id, int(t.get("k", 0))],
			String(t.get("tipo", "el")) == "ella", pool)
		var f: Dictionary = MuroRedes.fila(temporada, dia,
			SelfieMotor.hecho_de(int(t["estrellas"])), MuroRedes.FAN,
			GameState.player_team_id, int(t["estrellas"]), partido, "", nombre, "", "", foto)

		if t.get("cara") is Vector2:
			var cara: Vector2 = t["cara"]
			f["cara"] = [cara.x, cara.y]
		muro_redes = MuroRedes.empuja(muro_redes, f)
		escritas.push_front(f)
	if not escritas.is_empty():
		SelfieFotos.poda(muro_redes)
		_save()
	return escritas





