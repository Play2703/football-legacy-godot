func title_stats(award: String, torneo: int = -1) -> Dictionary:
	var key: String = String((Ceremonies.TROPHIES.get(award, {}) as Dictionary)
		.get("stats", "league"))
	if key.begins_with("nat_"):
		var cell: Dictionary = season_nat_by_comp.get(key.substr(4), {})
		return {"goals": int(cell.get("g", 0)), "assists": int(cell.get("a", 0)),
			"matches": int(cell.get("ap", 0))}




	if key == "league" and torneo >= 0:
		var clau: Dictionary = {"goals": int(season_clausura.get("g", 0)),
			"assists": int(season_clausura.get("a", 0)),
			"matches": int(season_clausura.get("pj", 0))}
		if torneo == Liguilla.CLAUSURA:
			return clau
		var ano: Dictionary = title_stats(award)
		for k in ano:
			ano[k] = maxi(0, int(ano[k]) - int(clau[k]))
		return ano
	if key == "league":
		return {"goals": season_comp_now("league", "g") + season_comp_now("liguilla", "g"),
			"assists": season_comp_now("league", "a") + season_comp_now("liguilla", "a"),
			"matches": season_apps_now("league") + season_apps_now("liguilla")}
	return {"goals": season_comp_now(key, "g"), "assists": season_comp_now(key, "a"),
		"matches": season_apps_now(key)}













static func decisor_de_final(orden: Array) -> String:
	var goles: Dictionary = {}
	var ultimo: Dictionary = {}
	for i in orden.size():
		var n: String = String(orden[i])
		if n.is_empty():
			continue
		goles[n] = int(goles.get(n, 0)) + 1
		ultimo[n] = i
	var mejor: String = ""
	for n in goles:
		var g: int = int(goles[n])
		if mejor.is_empty() or g > int(goles[mejor]) \
				or (g == int(goles[mejor]) and int(ultimo[n]) > int(ultimo[mejor])):
			mejor = String(n)
	return mejor







func _persona_rival(club_id: String, quien: String) -> Dictionary:
	if quien.is_empty() or club_id.is_empty():
		return {}
	var fila: Dictionary = {}
	for row in Squad.of(club_id):
		if String((row as Dictionary).get("name", "")) == quien:
			fila = row
			break
	if fila.is_empty():
		return {}
	var out: Dictionary = {"name": quien, "nombre": Competitions.demarca(quien),
		"cara": quien, "number": int(fila.get("number", 0))}
	var key: String = Legends.clave_activa(fila)
	if not key.is_empty() and String(Legends.asiento_de(key).get("team", "")) == club_id:
		var ley: Dictionary = leyenda_para_acto(key)
		if not ley.is_empty():
			out["nombre"] = String(ley.get("nombre", out["nombre"]))
			out["cara"] = String(ley.get("cara", quien))
	return out



static func _pen_de(tanda: Dictionary) -> Array:
	if tanda.is_empty() or not tanda.has("for"):
		return []
	return [int(tanda.get("for", 0)), int(tanda.get("against", 0))]















func anota_final_perdida(club_id: String, comp: String, ctx: Dictionary,
		tanda: Dictionary = {}) -> Dictionary:
	if club_id.is_empty():
		return {}
	var orden: Array = ctx.get("rival_goles_orden", [])
	var quien: String = ""
	var como: String = ""
	var dorsal: int = 0
	var goles: int = 0
	if not tanda.is_empty():
		var kind: String = String(tanda.get("kind", ""))
		if kind == "taker" and not bool(tanda.get("mine", true)):
			como = "tanda"
		elif kind == "keeper" and bool(tanda.get("save", false)):
			como = "parada"
		if not como.is_empty():
			quien = String(tanda.get("name", ""))
			dorsal = int(tanda.get("number", 0))
	else:
		quien = decisor_de_final(orden)
		if not quien.is_empty():
			como = "gol"
			goles = orden.count(quien)
	var e: Dictionary = {"club": club_id, "season": anio_vivo(), "comp": comp,
		"gf": int(ctx.get("gf", 0)), "ga": int(ctx.get("ga", 0)), "pen": _pen_de(tanda),
		"name": "", "nombre": "", "cara": "", "number": 0, "como": "", "goles": 0,
		"vengada": 0}
	if not quien.is_empty():
		var p: Dictionary = _persona_rival(club_id, quien)
		e["name"] = quien
		e["nombre"] = String(p.get("nombre", Competitions.demarca(quien)))
		e["cara"] = String(p.get("cara", quien))
		e["number"] = int(p.get("number", dorsal)) if int(p.get("number", 0)) > 0 else dorsal
		e["como"] = como
		e["goles"] = goles
	finales_perdidas.append(e)
	if quien.is_empty():
		return {}
	return {"name": quien, "nombre": e["nombre"], "cara": e["cara"],
		"number": e["number"], "como": como, "goles": goles}




