	var casero: String = prestado_de(mio)
	if not casero.is_empty():
		payload["prestado"] = casero
	queue_ceremony(Ceremonies.CONCURSO, payload)










const ASAMBLEA_EVENT_ID: String = "club_asamblea"

const FIN_SOCIOS_EVENT_ID: String = "club_fin_socios"

const ACCIONES_EVENT_ID: String = "club_acciones"




func socios_de(id: String) -> bool:
	if club_socios.is_empty() or not club_socios.has(id):
		return false
	return Concurso.socios_activo(int(club_socios[id]), GameState.season_num)



func socios_quedan(id: String) -> int:
	if not socios_de(id):
		return 0
	return int(club_socios[id]) + Concurso.SOCIOS_TEMPORADAS - GameState.season_num







func _socios_en_camino(id: String) -> bool:
	if id.is_empty():
		return false
	return socios_de(id) or Concurso.rescatan(int(club_concurso.get(id, -1)), GameState.season_num) \
			or Concurso.fin_era(int(club_socios.get(id, -1)), GameState.season_num)










func _tick_socios() -> bool:
	var hoy: int = GameState.season_num
	var mio: String = GameState.player_team_id

	if pending_decision == FIN_SOCIOS_EVENT_ID:
		pending_decision = ""
	for raw in club_socios.keys():
		if int(club_socios[raw]) == hoy:
			return int(club_socios.get(mio, -1)) == hoy
	var mi_pais: String = Teams.country_of(mio)
	var filas: Array = []
	var tuyo: bool = false







	for raw in club_socios.keys():
		var id: String = String(raw)
		var desde: int = int(club_socios[raw])
		if not Concurso.fin_era(desde, hoy) or Teams.is_free(id):
			continue
		var voto: String = ""
		if str(fin_socios.get("club", "")) == id and int(fin_socios.get("temporada", -1)) == hoy - 1:
			voto = str(fin_socios.get("voto", ""))
		var pct: int = Concurso.venta_pct(Concurso.venta_sondeo(id, desde, WorldAging.world_seed()),
			voto, tienes_acciones(id))
		var vende: bool = Concurso.vende(pct)
		if vende:
			club_socios.erase(raw)
			club_projects[id] = [ClubFinance.PROYECTO_DUENO, hoy]
		else:
			club_socios[id] = hoy
			tuyo = tuyo or id == mio
		if Teams.country_of(id) == mi_pais:
			var fin: Dictionary = WorldNews.fila_fin_socios(hoy - 1, GameState.season_day, id, pct, vende)
			if not fin.is_empty():
				filas.append(fin)
	for raw in club_socios.keys():
		if not Concurso.socios_activo(int(club_socios[raw]), hoy):
			club_socios.erase(raw)
	for raw in club_concurso.keys():
		var id: String = String(raw)
		if not Concurso.rescatan(int(club_concurso[raw]), hoy) or Teams.is_free(id):
			continue



		if club_cash.has(id) and int(club_cash[id]) == 0:
			continue
		if club_cash.has(id):
			club_cash[id] = 0

		club_projects.erase(id)
		var fila: Dictionary = {}
		match _salida_concurso(id):
			Concurso.SALE_SOCIOS:
				club_socios[id] = hoy
				tuyo = tuyo or id == mio
				fila = WorldNews.fila_socios(hoy - 1, GameState.season_day, id,
					Concurso.votos_a_favor(id, hoy, WorldAging.world_seed()))
			Concurso.SALE_DUENO:


				club_projects[id] = [ClubFinance.PROYECTO_DUENO, hoy]
				fila = WorldNews.fila_proyecto(hoy - 1, GameState.season_day, id,
					ClubFinance.PROYECTO_DUENO, ClubFinance.proyecto_dura(ClubFinance.PROYECTO_DUENO),
					dueno_perfil(id))
			_:
				fila = WorldNews.fila_convenio(hoy - 1, GameState.season_day, id)
		if Teams.country_of(id) == mi_pais and not fila.is_empty():
			filas.append(fila)
	_push_world_news(filas)
	return tuyo




func _salida_concurso(id: String) -> String:
	var desde: int = int(club_concurso.get(id, -1))
	if not Concurso.rescatan(desde, GameState.season_num):
		return ""
	return Concurso.salida(WorldAging.world_seed(), id, desde)



func _asamblea_vigente() -> bool:
	return str(asamblea.get("club", "")) == GameState.player_team_id \
			and int(asamblea.get("temporada", -1)) == GameState.season_num






func _check_asamblea() -> bool:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty() or forced_sale:
		return false
	if int(club_socios.get(mio, -1)) != GameState.season_num or _asamblea_vigente():
		return false


	if not Concurso.rescatan(int(club_concurso.get(mio, -1)), GameState.season_num):
		return false
	if _decision_no_caduca(pending_decision):
		return false
	asamblea = {"club": mio, "temporada": GameState.season_num, "eleccion": ""}
	pending_decision = ASAMBLEA_EVENT_ID
	pending_decision_club = ""
	pending_decision_club_b = ""
	decision_cooldown = DECISION_COOLDOWN
	return true




func _asamblea_event() -> Dictionary:
	var id: String = str(asamblea.get("club", GameState.player_team_id))
	var club: String = String(Teams.by_id(id).get("name", "?"))
	return {
		"id": ASAMBLEA_EVENT_ID,
		"title": "LA ASAMBLEA DE SOCIOS",
		"desc": I18n.tf("El juez cerró el concurso y {0} es de sus socios: la asamblea votó la"
			+ " compra a mano alzada, un {1}% a favor. No hay dueño que ponga dinero, así que"
			+ " piden a la plantilla que entre con una acción. La grada mira a sus jugadores.",
			[club, Concurso.votos_a_favor(id, int(asamblea.get("temporada", GameState.season_num)),
				WorldAging.world_seed())]),
		"a": {"label": I18n.t("COMPRO ACCIONES"),
			"fx": {"asamblea_accion": true, "money_wage": - Concurso.APORTE_SEMANAS,
				"rel": Concurso.ACCION_FX}},
		"b": {"label": I18n.t("SÓLO VOTO"),
			"fx": {"asamblea_voto": true, "rel": Concurso.VOTO_FX}},
	}









func tienes_acciones(id: String) -> bool:
	if id.is_empty() or str(asamblea.get("club", "")) != id \
			or str(asamblea.get("eleccion", "")) != Concurso.ACCION:
		return false
	var que: String = str(asamblea.get("acciones", ""))
	return que != Concurso.ACC_VENDIDAS and que != Concurso.ACC_PERDIDAS








func _check_fin_socios() -> bool:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty() or forced_sale:
		return false
	if socios_quedan(mio) != 1 or GameState.season_day < Market.winter_first(GameState.winter_day()):
		return false
	if str(fin_socios.get("club", "")) == mio and int(fin_socios.get("temporada", -1)) == GameState.season_num:
		return false
	if _decision_no_caduca(pending_decision):
		return false
	fin_socios = {"club": mio, "temporada": GameState.season_num, "voto": ""}
	pending_decision = FIN_SOCIOS_EVENT_ID
	pending_decision_club = ""
	pending_decision_club_b = ""
	decision_cooldown = DECISION_COOLDOWN
	return true




func fin_socios_sondeo() -> int:
	var id: String = str(fin_socios.get("club", GameState.player_team_id))
	return Concurso.venta_sondeo(id, int(club_socios.get(id, GameState.season_num)),
		WorldAging.world_seed())




func _fin_socios_event() -> Dictionary:
	var id: String = str(fin_socios.get("club", GameState.player_team_id))
	var club: String = String(Teams.by_id(id).get("name", "?"))
	var desc: String
