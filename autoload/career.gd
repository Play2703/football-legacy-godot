const CAMISETA_GRADA_NOTA: float = 7.5
const CAMISETA_GRADA_HUECO: int = 9
const CAMISETA_GRADA_DESDE: int = 3


func camiseta_grada_toca(result: int, rating: float, goals: int, minutos: int,
		en_casa: bool, jugados: int) -> bool:
	if not en_casa or result <= 0 or minutos <= 0:
		return false
	if goals <= 0 and rating < CAMISETA_GRADA_NOTA:
		return false
	if jugados < CAMISETA_GRADA_DESDE:
		return false
	if _firmas_grada_ultimo >= 0 and absi(jugados - _firmas_grada_ultimo) <= 1:
		return false
	return _camiseta_grada_ultimo < 0 or jugados - _camiseta_grada_ultimo >= CAMISETA_GRADA_HUECO


func _maybe_camiseta_grada(result: int, rating: float, goals: int, minutes: int,
		ctx: Dictionary) -> void:
	var fx: Dictionary = GameState.current_fixture()
	if fx.is_empty() or String(fx.get("comp", "")) == "nat":
		return
	if not camiseta_grada_toca(result, rating, goals, minutes, bool(fx.get("home", false)),
			GameState.matches_played):
		return
	_camiseta_grada_ultimo = GameState.matches_played
	_camiseta_grada_n += 1
	queue_ceremony(Ceremonies.CAMISETA_LANZADA, {
		"div": GameState.player_div(),
		"n": _camiseta_grada_n,
		"club": String(GameState.you_team().get("id", "")),
		"rival": String(GameState.current_rival().get("id", "")),
		"gf": int(ctx.get("gf", 0)),
		"ga": int(ctx.get("ga", 0)),
	})


func _maybe_chant(rating: float, goals: int, minutes: int) -> void:
	if minutes <= 0:
		return
	if rating >= CHANT_RATING:
		_chant_streak += 1
	else:
		_chant_streak = 0
	if chant_seen or _chant_streak < CHANT_STREAK or goals > 0:
		return
	var fx: Dictionary = GameState.current_fixture()
	if fx.is_empty() or String(fx.get("comp", "")) == "nat" \
			or not bool(fx.get("home", false)):
		return
	chant_seen = true
	queue_ceremony(Ceremonies.CHANT, {
		"div": GameState.player_div(),
		"streak": _chant_streak,
		"rating": rating,
		"aficion": int(rel.get("aficion", 0)),
	})

























const PANCARTA_P: float = 0.3
const PANCARTA_CINTA_P: float = 0.2



const PANCARTA_CINTA_TEMPORADAS: int = 3
const PANCARTA_CINTA_HUECO: int = 2





func _maybe_pancarta(goals: int, minutes: int, dado: float = -1.0) -> void:
	if goals <= 0 or minutes <= 0:
		return
	var club: String = GameState.player_team_id
	if club.is_empty():
		return


	var fx: Dictionary = GameState.current_fixture()
	if fx.is_empty() or String(fx.get("comp", "")) == "nat" \
			or not bool(fx.get("home", false)) or GameState.host_id() != club:
		return


	if hate_banner:
		return





	if int(GameState.club_matches.get(club, 0)) == 0:
		return
	if not _comico_cabe():
		return
	var ape: String = PancartaErrata.apellido_de(player_name)
	var sello: Variant = pancarta_clubs.get(club, {})
	if not (sello is Dictionary) or (sello as Dictionary).is_empty():
		_pancarta_estreno(club, ape, dado)
	elif not bool((sello as Dictionary).get("sale", false)) \
			and GameState.season_num > int((sello as Dictionary).get("season", GameState.season_num)):


		_pancarta_estreno(club, ape, dado)
	else:
		_pancarta_cinta(club, ape, sello as Dictionary, dado)


func _pancarta_estreno(club: String, ape: String, dado: float) -> void:


	var err: Dictionary = PancartaErrata.errata(ape, hash(club + "|" + ape))
	if err.is_empty():
		return
	if dado < 0.0:
		var r: RandomNumberGenerator = RandomNumberGenerator.new()
		r.seed = hash("pancarta|%s|%d|%d" % [club, GameState.season_num,
			GameState.season_day])
		dado = r.randf()
	var entrada: Dictionary = err.duplicate()
	entrada["season"] = GameState.season_num
	entrada["sale"] = dado < PANCARTA_P
	pancarta_clubs[club] = entrada
	if not bool(entrada["sale"]):
		return
	queue_ceremony(Ceremonies.PANCARTA, _pancarta_payload(entrada, false))
	_comico_apunta()


func _pancarta_cinta(club: String, ape: String, sello: Dictionary, dado: float) -> void:
	if pancarta_cinta_vista or not bool(sello.get("sale", false)):
		return


	if String(sello.get("ape", "")) != ape:
		return
	if club_seasons(club).size() < PANCARTA_CINTA_TEMPORADAS:
		return
	if GameState.season_num - int(sello.get("season", GameState.season_num)) \
			< PANCARTA_CINTA_HUECO:
		return
	if dado < 0.0:
		var r: RandomNumberGenerator = RandomNumberGenerator.new()
		r.seed = hash("pancarta_cinta|%s|%d|%d" % [club, GameState.season_num,
			GameState.season_day])
		dado = r.randf()
	if dado >= PANCARTA_CINTA_P:
		return
	pancarta_cinta_vista = true


	sello["cinta"] = true
	pancarta_clubs[club] = sello
	queue_ceremony(Ceremonies.PANCARTA, _pancarta_payload(sello, true))
	_comico_apunta()





func _pancarta_payload(sello: Dictionary, cinta: bool) -> Dictionary:
	return {
		"div": GameState.player_div(),
		"cinta": cinta,
		"texto": String(sello.get("texto", "")),
		"tipo": String(sello.get("tipo", "")),
		"idx": int(sello.get("idx", 0)),
		"n": int(sello.get("n", 1)),
		"buena": String(sello.get("buena", "")),
		"ape": String(sello.get("ape", "")),
		"nombre": player_name,
		"hueco": GameState.season_num - int(sello.get("season", GameState.season_num)),
	}













