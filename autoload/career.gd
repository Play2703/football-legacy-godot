func idolo_para_acto() -> Dictionary:
	if idolo.is_empty():
		return {}
	var key: String = String(idolo.get("key", ""))
	var nombre: String = String(idolo.get("name", key))
	if not idolo_escenas.has("_hilo") or not (idolo_escenas["_hilo"] is Dictionary):
		idolo_escenas["_hilo"] = {}
	var hilo: Dictionary = idolo_escenas["_hilo"]
	if String(idolo.get("tipo", "")) != "activo":

		var a: Dictionary = Legends.asiento_de(key)
		if not a.is_empty():
			var club_v: String = String(a.get("team", ""))
			var d_v: int = int(a.get("number", 0))
			if d_v <= 0:
				d_v = IdoloEscenas.dorsal_historico(key, club_v, hilo)
			return {"key": key, "nombre": nombre, "cara": Legends.cara_de(key, nombre),
				"club": club_v, "dorsal": d_v, "retirado": false}
		var club_l: String = IdoloEscenas.club_de_leyenda(key)
		return {"key": key, "nombre": nombre,
			"cara": Legends.cara_de(key, nombre), "club": club_l,
			"dorsal": IdoloEscenas.dorsal_historico(key, club_l, hilo), "retirado": true}
	var donde: Dictionary = IdoloEscenas.localiza(idolo, anio_vivo(), "", hilo)
	if not donde.is_empty():
		var p: Dictionary = donde.get("p", {})
		var dorsal: int = int(p.get("number", 0))
		if dorsal <= 0:
			dorsal = IdoloEscenas.dorsal_historico(key, String(donde.get("club", "")), hilo)
		return {"key": key, "nombre": nombre, "cara": String(p.get("name", key)),
			"club": String(donde.get("club", "")), "dorsal": dorsal,
			"retirado": bool(hilo.get("retirado", false))}



	var club_a: String = String(hilo.get("club_hoy", idolo.get("club", "")))
	return {"key": key, "nombre": nombre, "cara": String(idolo.get("crudo", key)),
		"club": club_a, "dorsal": IdoloEscenas.dorsal_historico(key, club_a, hilo),
		"retirado": bool(hilo.get("retirado", false))}




const COMICOS_POR_TEMPORADA: int = 2














func _comico_cabe() -> bool:
	for e in pending_ceremonies:
		var kind: String = String((e as Dictionary).get("kind", ""))
		if not Ceremonies.COMICOS.has(kind) and not Ceremonies.RUTINA_PARTIDO.has(kind):
			return false
	var en_temporada: int = 0
	for m in _comicos_log:
		if not (m is Array) or (m as Array).size() < 2:
			continue
		if int(m[0]) != GameState.season_num:
			continue
		en_temporada += 1
		if int(m[1]) == GameState.matches_played:
			return false
	return en_temporada < COMICOS_POR_TEMPORADA



func _comico_apunta() -> void:
	_comicos_log.append([GameState.season_num, GameState.matches_played])




