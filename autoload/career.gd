	})




func en_concurso(id: String) -> bool:
	if id.is_empty() or not club_concurso.has(id):
		return false
	return Concurso.activo(int(club_concurso[id]), GameState.season_num,
		GameState.season_day, GameState.winter_day())





func concurso_tuyo() -> bool:
	return not free_agent and en_concurso(GameState.player_team_id)




func _concursos_vivos() -> Dictionary:
	var out: Dictionary = {}
	for raw in club_concurso.keys():
		if en_concurso(String(raw)):
			out[String(raw)] = true
	return out















func _tick_concurso() -> bool:
	var hoy: int = GameState.season_num
	var mio: String = GameState.player_team_id
	for raw in club_concurso.keys():
		if int(club_concurso[raw]) == hoy:
			return int(club_concurso.get(mio, -1)) == hoy
	for raw in club_concurso.keys():
		if Concurso.puede_repetir(int(club_concurso[raw]), hoy):
			club_concurso.erase(raw)
			club_prestado.erase(raw)
	var mi_pais: String = Teams.country_of(mio)
	var filas: Array = []
	var tuyo: bool = false
	var nuevos: Array[String] = []
	for raw in club_cash.keys():
		var id: String = String(raw)
		if club_concurso.has(id) or Teams.is_free(id):
			continue


		if ClubFinance.gigante(id):
			continue
		if not Concurso.entra(int(club_cash[id]), club_income_of(id)):
			continue


		if not Concurso.juez(WorldAging.world_seed(), id, hoy):
			continue
		club_concurso[id] = hoy
		nuevos.append(id)
		tuyo = tuyo or id == mio


		if tienes_acciones(id):
			asamblea["acciones"] = Concurso.ACC_PERDIDAS
			asamblea["perdidas"] = hoy
			if pending_decision == ACCIONES_EVENT_ID:
				pending_decision = ""


	for id in nuevos:
		var casero: String = _embarga_estadio(id, hoy)
		if Teams.country_of(id) == mi_pais:
			var fila: Dictionary = WorldNews.fila_concurso(hoy - 1, GameState.season_day, id,
				casero)
			if not fila.is_empty():
				filas.append(fila)
	_push_world_news(filas)
	return tuyo







func _embarga_estadio(id: String, hoy: int) -> String:
	var semilla: int = WorldAging.world_seed()
	if ClubFinance.gigante(id) or not Concurso.embarga(semilla, id, hoy):
		return ""
	var casero: String = Concurso.anfitrion(semilla, id, hoy, _caseros_de(id, hoy))
	if not casero.is_empty():
		club_prestado[id] = [hoy, casero]
	return casero




func _caseros_de(id: String, hoy: int) -> Array:
	var pais: String = Teams.country_of(id)
	var div: int = GameState.div_of(id)
	var out: Array = []
	for t in Teams.all():
		var x: String = str(t.get("id", ""))
		if x.is_empty() or x == id or Teams.is_free(x) or str(t.get("country", "")) != pais:
			continue
		var d: int = GameState.div_of(x)
		if d != div and d != div + 1:
			continue
		if int(club_concurso.get(x, -1)) == hoy or Rivalries.are_rivals(id, x) \
				or ClubFinance.gigante(x):
			continue
		out.append(x)
	return out







func prestado_de(id: String, season: int = -1) -> String:
	if club_prestado.is_empty() or not club_prestado.has(id):
		return ""
	var fila: Array = club_prestado[id]
	var s: int = GameState.season_num if season < 0 else season
	return str(fila[1]) if int(fila[0]) == s else ""






func sin_casa_prestada(he: Dictionary, season: int) -> void:
	if club_prestado.is_empty():
		return
	for raw in club_prestado.keys():
		if he.has(raw) and not prestado_de(str(raw), season).is_empty():
			he[raw] = 0.0





func _acto_concurso() -> void:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty():
		return
	if int(club_concurso.get(mio, -1)) != GameState.season_num:
		return
	for c in pending_ceremonies:
		if String((c as Dictionary).get("kind", "")) == Ceremonies.CONCURSO:
			return
	var payload: Dictionary = {
		"club": mio,
		"caja": int(club_cash.get(mio, 0)),
		"ingreso": club_income_of(mio),
		"div": GameState.player_div(),
	}

	if str(asamblea.get("club", "")) == mio and int(asamblea.get("perdidas", -1)) == GameState.season_num:
