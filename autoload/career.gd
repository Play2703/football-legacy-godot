const PALOMAS_P_REPITE: float = 0.25


func _maybe_palomas(match_ctx: Dictionary, opp: String, home: bool,
		dado: float = -1.0) -> void:
	if not bool(match_ctx.get("pigeon_hit", false)) \
			or bool(match_ctx.get("nat", false)):
		return


	if _palomas_season >= 0 and GameState.season_num - _palomas_season < 2:
		return
	if not _comico_cabe():
		return
	if _palomas_n > 0:
		if dado < 0.0:
			var r: RandomNumberGenerator = RandomNumberGenerator.new()
			r.seed = hash("palomas|%d|%d|%s" % [GameState.season_num,
				GameState.matches_played, GameState.player_team_id])
			dado = r.randf()
		if dado >= PALOMAS_P_REPITE:
			return
	_palomas_season = GameState.season_num
	_palomas_n += 1
	queue_ceremony(Ceremonies.PALOMAS, {"opp": opp, "home": home,
		"div": GameState.player_div(), "number": GameState.shirt_number_now(),
		"first": _palomas_n == 1})
	_comico_apunta()



















func _maybe_trueno(match_ctx: Dictionary, minutes: int, dado: float = -1.0) -> void:
	if bool(match_ctx.get("nat", false)):
		return
	for e in pending_ceremonies:
		if not Ceremonies.RUTINA_PARTIDO.has(String((e as Dictionary).get("kind", ""))):
			return
	var club: String = GameState.player_team_id
	if club.is_empty():
		return
	var fx: Dictionary = GameState.current_fixture()
	var en_casa: bool = not fx.is_empty() and String(fx.get("comp", "")) != "nat" \
			and bool(fx.get("home", false)) and GameState.host_id() == club
	var gf: int = int(match_ctx.get("gf", 0))
	var ga: int = int(match_ctx.get("ga", 0))
	if dado < 0.0:
		dado = Trueno.dado_de(club, GameState.season_num, GameState.matches_played)
	if not Trueno.sale(minutes, gf, ga, en_casa, trueno_temporada, GameState.season_num, dado):
		return
	var primera: bool = trueno_temporada < 0
	trueno_temporada = GameState.season_num
	queue_ceremony(Ceremonies.TRUENO, {"gf": gf, "ga": ga, "opp": String(fx.get("opp", "")),
		"div": GameState.player_div(), "number": GameState.shirt_number_now(),
		"first": primera})





