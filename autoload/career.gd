func _month_rival(month_idx: int) -> Dictionary:
	var lr: Array = league_race()
	if lr.is_empty():
		return {"bar": 8.0, "ficha": {}}
	var top: Array = lr.duplicate()
	top.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return float(a.get("avg", 6.5)) > float(b.get("avg", 6.5)))
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("potm|%s|%d|%d|%d" % [Teams.country_of(GameState.player_team_id),
		GameState.player_div(), GameState.season_num, month_idx])


	var bar: float = 0.0
	var quien: Dictionary = {}
	for i in mini(4, top.size()):
		var e: Dictionary = top[i]
		var mes: float = float(e.get("avg", 6.5)) + rng.randf_range(-0.5, 0.85)
		if mes > bar:
			bar = mes
			quien = e




	if not quien.is_empty() and String(quien.get("team", "")) == GameState.player_team_id:
		var nm: String = String(quien.get("name", ""))
		var gm: Dictionary = season_mate_goals.get("league", {})
		var am: Dictionary = season_mate_assists.get("league", {})
		if gm.has(nm) or am.has(nm):
			quien = quien.duplicate()
			quien["goals"] = int(gm.get(nm, 0))
			quien["assists"] = int(am.get(nm, 0))
	return {"bar": bar, "ficha": quien}
















func _award_number(team_id: String, name: String) -> int:
	for p in Squad.of(team_id):
		if String((p as Dictionary).get("name", "")) == name:
			return int((p as Dictionary).get("number", 0))
	return 0

























func _match_figure(ctx: Dictionary, my_goals: int, my_assists: int,
		sin_ti: bool = false) -> Dictionary:
	var mios: Dictionary = ctx.get("mate_scorers", {}) as Dictionary
	var suyos: Dictionary = ctx.get("rival_scorers", {}) as Dictionary
	var asis: Dictionary = ctx.get("mate_assisters", {}) as Dictionary
	var gane: bool = int(ctx.get("gf", 0)) > int(ctx.get("ga", 0))
	var perdi: bool = int(ctx.get("ga", 0)) > int(ctx.get("gf", 0))



	var mejor: Dictionary = {"mia": true,
		"nota": - INF if sin_ti else _figure_score(my_goals, my_assists),
		"gano": gane}

	for nom in mios:
		var f: Dictionary = {"mia": false, "club": GameState.player_team_id,
			"name": String(nom), "goals": int(mios[nom]),
			"assists": int(asis.get(nom, 0)), "gano": gane}
		f["nota"] = _figure_score(int(f["goals"]), int(f["assists"]))
		mejor = _figure_mejor(mejor, f)
	for nom in suyos:
		var r: Dictionary = {"mia": false,
			"club": String(GameState.current_rival().get("id", "")),
			"name": String(nom), "goals": int(suyos[nom]),

			"assists": 0, "gano": perdi}
		r["nota"] = _figure_score(int(r["goals"]), 0)
		mejor = _figure_mejor(mejor, r)





	var paradas: Dictionary = ctx.get("gk_saves", {}) as Dictionary
	for nom in paradas:
		var club_gk: String = _club_de(String(nom))
		if club_gk.is_empty():
			continue
		var g: Dictionary = {"mia": false, "club": club_gk, "name": String(nom),
			"goals": 0, "assists": 0, "paradas": int(paradas[nom]),



			"portero": true,
			"gano": gane if club_gk == GameState.player_team_id else perdi}
		var suya_a_cero: bool =(int(ctx.get("ga", 0)) == 0) \
				if club_gk == GameState.player_team_id else (int(ctx.get("gf", 0)) == 0)
		g["nota"] = MatchRating.score({}) \
				+ MatchRating.GK_SAVE * MatchRating.GAIN * float(int(paradas[nom])) \
				+(MatchRating.CLEAN_SHEET_GK if suya_a_cero else 0.0)
		mejor = _figure_mejor(mejor, g)
	if not bool(mejor.get("mia", true)) and String(mejor.get("club", "")).is_empty():

		return {"mia": true}
	return mejor




func pasa_liston_mvp(rating: float, goals: int) -> bool:
	return rating >= 8.3 or goals >= 3














func figura_del_partido(ctx: Dictionary, goals: int, assists: int, rating: float,
		jugaste: bool) -> Dictionary:
	var figura: Dictionary = _match_figure(ctx, goals, assists)
	if not bool(figura.get("mia", true)):
		return figura
	if jugaste and pasa_liston_mvp(rating, goals):
		return figura
	return _match_figure(ctx, goals, assists, true)





func _club_de(nombre: String) -> String:
	var rival: String = String(GameState.current_rival().get("id", ""))
	for club in [GameState.player_team_id, rival]:
		if String(club).is_empty():
			continue
		for p in Squad.of(String(club)):
			if String((p as Dictionary).get("name", "")) == nombre:
				return String(club)
	return ""





func _figure_score(goals: int, assists: int) -> float:
	return MatchRating.score({"goal": goals, "assist": assists})




func _figure_mejor(a: Dictionary, b: Dictionary) -> Dictionary:
	if float(b.get("nota", 0.0)) > float(a.get("nota", 0.0)):
		return b
	if is_equal_approx(float(b.get("nota", 0.0)), float(a.get("nota", 0.0))) \
			and bool(b.get("gano", false)) and not bool(a.get("gano", false)):
		return b
	return a








