var _ingresos_ano: Dictionary = {}






func _apunta_ingreso(fuente: String, monto: int) -> void:
	if monto <= 0:
		return
	_ingresos_ano[fuente] = int(_ingresos_ano.get(fuente, 0)) + monto











var cobros_sueltos: Dictionary = {}


func _apunta_suelto(fuente: String, monto: int) -> void:
	if monto <= 0:
		return
	cobros_sueltos[fuente] = int(cobros_sueltos.get(fuente, 0)) + monto





func _cobra_firma(prima: int) -> int:
	var neto: int = agent_signing_net(prima)
	money += neto
	_apunta_suelto("firma", neto)
	return neto









func _paga_prima_premio(award: String) -> int:
	if retired or free_agent or _team_title(award) or AwardPoints.REPEATABLE.has(award):
		return 0
	var raw: float = AwardPoints.raw_for(award, GameState.player_div(),
		Teams.country_of(GameState.player_team_id))
	var prima: int = con_doble_paga(ContractTerms.award_bonus(int(contract.get("wage", 0)), raw))
	if prima <= 0:
		return 0
	money += prima
	_apunta_suelto("premios", prima)
	_season_award_prima[award] = prima
	return prima





var _season_award_prima: Dictionary = {}


func award_prima_of(award: String) -> int:
	var prima: int = int(_season_award_prima.get(award, 0))
	_season_award_prima[award] = 0
	return prima






const PRIMAS_PREMIOS: Array[String] = ["Balón de Oro", "Mejor Jugador de la Liga",
	"Pichichi de la Liga", "Mejor Jugador del Club"]













func primas_vista() -> Dictionary:
	if retired or free_agent or GameState.player_team_id.is_empty():
		return {}
	var wage: int = int(contract.get("wage", 0))
	var kinds: Array[String] = ["liga", "copa"]
	var euro: String = Continental.marca(_euro_comp_now())
	if not euro.is_empty():
		kinds.append(euro)
	var titulos: Array = []
	for k in kinds:
		var m: float = prima_titulo_mult(Clausulas.titulo_pactado(k))
		titulos.append({"kind": k, "mult": m,
			"monto": con_doble_paga(ContractTerms.title_bonus(wage, k, m))})
	var div: int = GameState.player_div()
	var pais: String = Teams.country_of(GameState.player_team_id)
	var premios: Array = []
	for a in PRIMAS_PREMIOS:
		premios.append({"award": a,
			"monto": con_doble_paga(ContractTerms.award_bonus(wage, AwardPoints.raw_for(a, div, pais)))})
	var unit: float = float(wage) * 0.5 * paga_mult()
	var gb: float = float(contract.get("goal_bonus", 0.0))
	var ab: float = float(contract.get("assist_bonus", 0.0))
	var cobrado: Dictionary = {}
	for f in ["firma", "goles", "premios"]:
		cobrado[f] = int(cobros_sueltos.get(f, 0))
	return {
		"ficha": wage, "titulos": titulos, "premios": premios,
		"gol": int(unit *(0.6 + gb)), "gol_pactada": int(unit * gb),
		"asist": int(unit *(0.28 + ab)), "asist_pactada": int(unit * ab),
		"objetivo": con_doble_paga(int(contract.get("obj_bonus", 0))),
		"club": con_doble_paga(prima_club_tope()),
		"cobrado": cobrado,
	}













