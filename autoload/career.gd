func _idolo_lo_pediste(crudo: String, club: String) -> bool:
	if crudo.is_empty():
		return false
	for e: Variant in gerencia_tuyos():
		if e is Dictionary and String(e.get("name", "")) == crudo \
				and String(e.get("club", "")) == club \
				and int(e.get("season", -1)) >= int(idolo.get("season", 0)):
			return true
	return false








func _idolo_siembra(person: String, club: String) -> void:
	if person.is_empty():
		return
	var f0: Variant = socios.get(person, {})
	var v0: int = int((f0 as Dictionary).get("v", 0)) if f0 is Dictionary else 0
	_bump_socio(person, maxi(0, mini(v0 + SEMILLA_CLUB, SOCIO_UMBRAL) - v0), club,
		Squad.of_nominal(club))
	if not socios.has(person):
		return
	var f: Dictionary = socios[person]
	var sem: Dictionary =(f["semilla"] as Dictionary) if f.get("semilla", null) is Dictionary \
			else {"ex": "", "club": "", "rival": "", "s": GameState.season_num}
	sem["idolo"] = true
	f["semilla"] = sem


func _maybe_idolo_rival() -> void:
	if idolo.is_empty() or String(idolo.get("tipo", "")) != "activo" or not _pre_match_act_ok():
		return
	if GameState.tutorial_active or not GameState.practice_kind.is_empty():
		return
	var fx: Dictionary = GameState.current_fixture()
	var opp: String = String(fx.get("opp", ""))
	var temporada: int = anio_vivo()
	var peso: bool = GameState.fixture_is_knockout(fx) or _rival_de_arriba(opp)
	var titular: bool = last_role == String(Standing.STATUS_LABEL[Standing.STATUS_TITULAR])
	if not IdoloEscenas.rival_toca(idolo, temporada, idolo_escenas,
			idolo_escena_temporada_libre(temporada), fx, is_derby(opp), _is_final(fx), titular,
			season_avg(), peso, pending_ceremonies):
		return
	if not (idolo_escenas.get("_hilo", null) is Dictionary):
		idolo_escenas["_hilo"] = {}
	var hilo: Dictionary = idolo_escenas["_hilo"]



	var jornada: String = "%d|%d" % [GameState.season_num, GameState.season_day]
	if String(hilo.get("rival_mirado", "")) == jornada:
		return
	hilo["rival_mirado"] = jornada
	var donde: Dictionary = IdoloEscenas.localiza(idolo, temporada, opp, hilo)
	var asiento: int = int(donde.get("seat", -1))
	if String(donde.get("club", "")) != opp or asiento < 0 or asiento >= Squad.STARTING_XI:
		return
	var squad: Array = Squad.of(opp)
	if asiento >= squad.size():
		return
	var p: Dictionary = donde.get("p", {})
	var su_media: int = _media_npc(squad[asiento])
	_encola_idolo(Ceremonies.IDOLO_RIVAL, IdoloEscenas.payload_rival(idolo, temporada, p, opp,
		bool(fx.get("home", true)), GameState.player_team_id, GameState.player_div(),
		ovr_shown(), su_media, IdoloEscenas.vs_hoy(fx, opp, p, asiento, su_media)))


	hilo["rival_pendiente"] = {"opp": opp, "who": String(p.get("name", "")), "seat": asiento,
		"number": int(p.get("number", 0)), "ovr": su_media}
	_save()




func _rival_de_arriba(opp: String) -> bool:
	if opp.is_empty():
		return false
	var filas: Array = GameState.league_standings()
	for i in mini(filas.size(), IdoloEscenas.RIVAL_ARRIBA):
		if String((filas[i] as Dictionary).get("key", "")) == opp:
			return true
	return false











