func _historia_trofeos() -> Array:
	var counts: Dictionary = {}
	for a in elite_awards():
		var k: String = String(a)
		if Trophies.CATALOG.has(k):
			counts[k] = int(counts.get(k, 0)) + 1
	var out: Array = []
	for key in Trophies.ORDER:
		if not counts.has(key):
			continue
		var e: Dictionary = Trophies.CATALOG[key]
		out.append({"type": String(e["type"]), "count": int(counts[key])})
		if out.size() >= 10:
			break
	return out














func _historia_payload(g_rows: Array, mine: int) -> Dictionary:
	var top: Dictionary = g_rows[0] if not g_rows.is_empty() else {}
	var seats: Array = []



	var caras: Dictionary = {}
	for r in g_rows:
		var e: Dictionary = r
		var key: String = String(e.get("key", e.get("name", "")))
		if legends_passed.has(key):
			seats.append(String(e.get("name", "")))
			caras[String(e.get("name", ""))] = Legends.cara_de(key, String(e.get("name", "")))
		if seats.size() >= 10:
			break
	if not top.is_empty():
		var top_key: String = String(top.get("key", top.get("name", "")))
		caras[String(top.get("name", ""))] = Legends.cara_de(top_key, String(top.get("name", "")))
	var clubs: Array = clubs_history()
	var nums: Dictionary = {}
	for c in clubs:
		nums[String(c)] = club_number(String(c))
	return {
		"legend": String(top.get("name", "")),
		"nat": String(top.get("nat", "")),
		"mine": mine,
		"theirs": int(float(top.get("value", 0.0))),
		"legends": seats,
		"caras": caras,
		"clubs": clubs,
		"numbers": nums,


		"line": LEGEND_PASS.LINE_LAST,
	}








func _month_rival_bar(month_idx: int) -> float:
