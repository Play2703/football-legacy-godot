func precontract_hits(dest_id: String) -> Dictionary:
	var mio: String = GameState.player_team_id
	var clase: String = "fuera"
	if Rivalries.are_rivals(mio, dest_id):
		clase = "rival"
	else:
		var pais: String = Teams.country_of(mio)
		if not pais.is_empty() and Teams.country_of(dest_id) == pais:
			clase = "liga" if GameState.div_of(dest_id) == GameState.div_of(mio) \
					else "pais"
	var base: Array = PRECONTRACT_HITS[clase]
	var al_rival: bool = clase == "rival"
	return {
		"clase": clase,
		"tecnico": _precontract_hit(int(base[0]), rel_eff("tecnico"), al_rival),
		"aficion": _precontract_hit(int(base[1]), rel_eff("aficion"), al_rival),
	}





static func _precontract_hit(base: int, relacion: int, al_rival: bool) -> int:
	var t: float = clampf((float(relacion) - 50.0) / 50.0, -1.0, 1.0)
	var k: float = PRE_HIT_ESCALA_ARRIBA if t >= 0.0 else PRE_HIT_ESCALA_ABAJO
	var f: float = 1.0 + k * t if al_rival else 1.0 - k * t
	return maxi(1, roundi(float(base) * f))



































func precontract_presser_split(key: String) -> Dictionary:
	if pending_precontract.is_empty():
		return {}
	var pag_t: int = maxi(0, int(pending_precontract.get("pago_tecnico", 0)))
	var pag_a: int = maxi(0, int(pending_precontract.get("pago_aficion", 0)))
	var prensa: int = int(rel.get("prensa", 0))
	var aficion: int = int(rel.get("aficion", 0))
	if key == "a":
		var ma: int = mini(pag_t, prensa)
		return {"tecnico": ma, "prensa": - ma} if ma > 0 else {}
	if key == "b":
		var mb: int = mini(pag_a, prensa)
		return {"aficion": mb, "prensa": - mb} if mb > 0 else {}
	if key == "c":
		var mc: int = mini(pag_t, aficion)
		return {"tecnico": mc, "aficion": - mc} if mc > 0 else {}
	return {}













func resolve_precontract_presser(key: String) -> bool:
	if pending_precontract.is_empty():
		return false
	if not String(pending_precontract.get("presser", "")).is_empty():
		return false
	var d: Dictionary = precontract_presser_split(key)
	var mueve: bool = false
	for k in d:
		if int(d[k]) != 0:
			mueve = true


	if not mueve:
		return false
	for k in d:
		var rk: String = String(k)
		if not rel.has(rk):
			continue
		rel[rk] = clampi(int(rel[rk]) + int(d[k]), 0, 100)








	if int(d.get("aficion", 0)) < 0 and pending_precontract.has("golpe_aficion"):
		pending_precontract["golpe_aficion"] = \
				int(pending_precontract["golpe_aficion"]) - int(d["aficion"])
	pending_precontract["presser"] = key
	_save()
	changed.emit()
	return true






