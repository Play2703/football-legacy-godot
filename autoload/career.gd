func floor_paint_of() -> Dictionary:
	var capa: Variant = floor_paint.get("0", {})
	return capa if capa is Dictionary else {}




func set_floor_paint(capa: Dictionary) -> void:
	floor_paint["0"] = capa



func _paint_a_cfg() -> Dictionary:
	var out: Dictionary = {}
	for k in floor_paint:
		var capa: Variant = floor_paint[k]


		if not (capa is Dictionary):
			out[k] = capa
			continue
		var mem: Variant = _paint_cfg_mem.get(k, null)
		if mem is Array and (mem as Array).size() == 2 \
				and is_same((mem as Array)[0], capa):
			out[k] =(mem as Array)[1]
			continue
		var lista: PackedStringArray = House.pintura_a_lista(capa)
		_paint_cfg_mem[k] = [capa, lista]
		out[k] = lista
	return out





















func migrar_capas_casa() -> void:


	var capas_viejas: Array = []
	for k in house_layout:
		if House.layout_key_vieja(String(k)):
			capas_viejas.append(String(k))
	for k in capas_viejas:


		var destino: String = House.layout_key(String(k).to_int())
		if not house_layout.has(destino):
			house_layout[destino] = house_layout[k]
		house_layout.erase(k)






	var viva: String = House.layout_key(house_level)
	if not house_layout.has(viva) or (house_layout[viva] as Dictionary).is_empty():
		var previa: Variant = house_layout.get("%d|0" % House.clamp_level(house_level), null)
		if previa is Dictionary and not (previa as Dictionary).is_empty():
			house_layout[viva] = previa
	for k2 in house_layout.keys():
		if String(k2) != viva:
			house_layout.erase(k2)





	var pintura_vieja: bool = false
	for k in floor_paint:
		if not (floor_paint[k] is Dictionary):
			pintura_vieja = true
			break
	if pintura_vieja:
		floor_paint = {"0": floor_paint.duplicate(true)}
































func canjear_pared_camisetas() -> void:
	var paredes: Array = []
	for it in house_items:
		if String((it as Dictionary).get("kind", "")) == "camisetas":
			paredes.append(it)
	if paredes.is_empty():
		return
	var quedan: Array = []
	for otro in house_items:
		if String((otro as Dictionary).get("kind", "")) != "camisetas":
			quedan.append(otro)
	house_items = quedan
	var tpl: Dictionary = House.blueprint_prop("camisetas")
	var talla: Vector2 = House.blueprint_of("playera")





	var adicion_puesta: bool = house_extras.has("mueble_playera")
	for p in paredes:
		var pd: Dictionary = p as Dictionary
		var iid: String = String(pd.get("iid", ""))
		for k in house_layout:
			(house_layout[k] as Dictionary).erase(iid)



		var ancho: Vector2 = pd.get("size", Vector2.ZERO)
		var cabe: int = int(floor(ancho.x / House.JERSEY_PASO)) \
				if ancho.x > 0.0 else 1
		var n: int = maxi(1, mini(int(tpl.get("cap", 1)), cabe))
		for _i in n:
			_add_house_item("playera", "mueble_playera", talla, adicion_puesta)
			adicion_puesta = true
	if not house_extras.has("mueble_playera"):
		house_extras.append("mueble_playera")
	house_extras.erase("mueble_camisetas")












