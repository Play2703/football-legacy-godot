func pide_cese_apoyos() -> Array:
	if int(rel.get("equipo", 50)) < Gerencia.CESE_VESTUARIO_REL:
		return []
	var sq: Array = Squad.of(GameState.player_team_id)
	var yo: int = Squad.user_index(sq)
	var orden: Array = []
	for i in sq.size():
		if i == yo:
			continue
		var s: Dictionary = sq[i]
		orden.append([SquadMeta.media_of(s, String(s.get("pos", "MC"))), i])
	orden.sort_custom(func(a: Array, b: Array) -> bool: return int(a[0]) > int(b[0]))
	var out: Array = []
	for k in mini(orden.size(), Squad.STARTING_XI):
		var i: int = int(orden[k][1])
		var nm: String = String((sq[i] as Dictionary).get("name", ""))




		var fuera: bool = i >= Squad.STARTING_XI and k < Gerencia.CESE_ESTRELLAS \
				and String((sq[i] as Dictionary).get("pos", "")) != "POR"
		if fuera or socio_v(nm) >= SOCIO_UMBRAL:
			out.append(nm)
	return out




func pide_cese_capricho_aplica() -> bool:
	return _club_winless < Gerencia.CESE_RACHA and pide_dt_capricho_aplica()




func pide_cese_prob() -> float:
	if not pide_cese_motivo().is_empty():
		return 0.0
	return _pide_cese_p(pide_cese_apoyos().size())


func _pide_cese_p(apoyos: int) -> float:
	var presion: float = Coach.p_invierno(_coach_ctx(), coach_nivel(),
		coach_desde == GameState.season_num)
	return Gerencia.prob_pide_cese(
		maxi(Gerencia.relacion_sin_tecnico(gerencia_ctx()) - gerencia_deuda()
			- gerencia_cobros(), 0),
		int(rel["tecnico"]), presion, is_captain, peldano(), apoyos, _club_winless)



func pide_cese_pon() -> bool:
	if not pide_cese().is_empty():
		gerencia.erase("pide_cese")
	else:
		if not pide_cese_motivo().is_empty():
			return false
		if pide_cese_capricho_aplica():
			_gerencia_cobra("dt_capricho", Gerencia.DT_CAPRICHO)
		gerencia.erase("pide_dt")
		gerencia["pide_cese"] = {"coach": Coaches.id_of(GameState.player_team_id),
			"name": coach_name(), "club_mio": GameState.player_team_id,
			"season": GameState.season_num}
		Telemetry.count("pide_cese")
	_save()
	changed.emit()
	return true





func _pide_cese_resuelve(cae: bool, invierno: bool) -> bool:
	var req: Dictionary = pide_cese()
	gerencia.erase("pide_cese")
	if req.is_empty():
		return false
	var mio: String = GameState.player_team_id
	var apoyos: int = pide_cese_apoyos().size()
	var racha: bool = _club_winless >= Gerencia.CESE_RACHA
	var sale: String = "no"
	if String(req.get("coach", "")) != Coaches.id_of(mio) \
			or not pide_cese_motivo().is_empty():
		sale = "ya_no"
	elif cae:
		sale = "cae"
	else:

		var rng := RandomNumberGenerator.new()
		rng.seed = hash("pidecese|%d|%s|%s" % [GameState.season_num,
			String(req["coach"]), str(invierno)])
		if rng.randf() < _pide_cese_p(apoyos):
			sale = "si"
	match sale:
		"si":
			if invierno:
				_apunta_campana_liga()
			_replace_coach({}, invierno)
			Telemetry.count("pide_cese_si")
		"no":
			_rel_golpe("tecnico", Gerencia.CESE_CASTIGO_RACHA if racha
				else Gerencia.DT_CASTIGO)
			if apoyos >= Gerencia.CESE_APOYOS:
				_rel_golpe("equipo", Gerencia.CESE_VESTUARIO_NO)
			Telemetry.count("pide_cese_no")
		"cae":
			Telemetry.count("pide_cese_cae")
		_:
			Telemetry.count("pide_cese_ya_no")


	gerencia["pide_dt_ult"] = {"name": String(req.get("name", "")), "sale": sale,
		"cese": true, "season": GameState.season_num, "club_mio": mio}
	return sale == "si"







