func _tick_sharpness(played_ratio: float) -> void:
	if played_ratio > 0.0:
		sharpness = minf(SHARP_MAX, sharpness + SHARP_GAIN * played_ratio)
	else:
		sharpness = maxf(0.0, sharpness - SHARP_DECAY)






func _tick_load(played_ratio: float, comp: String) -> void:
	var gain: float = LOAD_GAIN_MIDWEEK if LOAD_MIDWEEK_COMPS.has(comp) else 0.0
	match_load = clampf(match_load * LOAD_DECAY + gain * clampf(played_ratio, 0.0, 1.0),
		0.0, 1.0)




func is_congested() -> bool:
	return match_load >= 0.5


func sharp01() -> float:
	return clampf(sharpness / SHARP_MAX, 0.0, 1.0)







func sharp_factor() -> float:
	if sharpness >= SHARP_FULL:
		return 1.0
	var t: float = clampf(sharpness / SHARP_FULL, 0.0, 1.0)
	return lerpf(SHARP_FLOOR_FACTOR, 1.0, t)





func is_rusty() -> bool:
	return sharpness < SHARP_FULL


func energy_cap() -> float:
	if age <= DECLINE_AGE:
		return 100.0
	return 100.0 - 3.5 * float(age - DECLINE_AGE)


func _energy_factor() -> float:
	if energy >= LOW_ENERGY:
		return 1.0
	var t: float = clampf(energy / LOW_ENERGY, 0.0, 1.0)
	return lerpf(TIRED_LEGS_FLOOR, 1.0, t)









func energy_dom_mult() -> float:
	return 1.0 + ENERGY_DOM_SPAN * Settings.dif_energy_dom_mult() * dominion01()















func energy_fit_mult() -> float:
	return lerpf(FIT_SPEND_MAX, FIT_SPEND_MIN, stat_norm("fisico")) \
			* investment_value("gasto", 1.0) * rasgo_partido("gasto")








func projected_match_spend(minutes: int, intensity_val: int) -> float:
	if minutes <= 0:
		return 0.0
	var ratio: float = clampf(float(minutes) / 90.0, 0.0, 1.0)
	return MATCH_ENERGY_COST * maxf(ratio, 0.3) * MatchPlan.energy_mult(intensity_val) \
			* energy_dom_mult() * energy_fit_mult()

























var _live_open: bool = false

var _live_spent: float = 0.0


var _live_minutes: float = 0.0
var _live_injury_acc: float = 0.0



func begin_live_match() -> void:
	_live_open = true
	_live_spent = 0.0
	_live_minutes = 0.0
	_live_injury_acc = 0.0







	pending_injury_weeks = 0
	pending_injury_min = 0
	pending_injury_trauma = false


func live_match_open() -> bool:
	return _live_open







func accrue_live_spend(minutes: float) -> void:
	if not _live_open or minutes <= 0.0:
		return
	var per_min: float = MATCH_ENERGY_COST / 90.0 * MatchPlan.energy_mult(intensity) \
			* energy_dom_mult() * energy_fit_mult()
	_live_spent += per_min * minutes
	_live_minutes += minutes
	_live_injury_acc += minutes * MatchPlan.injury_mult(intensity)
	energy = maxf(0.0, energy - per_min * minutes)











func live_minute_cost() -> float:
	return MATCH_ENERGY_COST / 90.0 * MatchPlan.energy_mult(intensity) \
			* energy_dom_mult() * energy_fit_mult()


func live_spent_total() -> float:
	if _live_minutes <= 0.0:
		return 0.0
	var floor_cost: float = MATCH_ENERGY_COST * 0.3 * _live_energy_mult()
	return maxf(_live_spent, floor_cost)












func live_injury_exposure() -> float:
	var ahora: float = injury_risk(1.0, live_injury_mult())
	return clampf((ahora - INJURY_RISK_CALM)
		/ maxf(INJURY_RISK_HOT - INJURY_RISK_CALM, 0.001), 0.0, 1.0)


func live_injury_mult() -> float:
	if _live_minutes <= 0.0:
		return MatchPlan.injury_mult(intensity)
	return _live_injury_acc / _live_minutes















func live_injury_minute_p(minute: int) -> float:
	return injury_risk(1.0 / 90.0, MatchPlan.injury_mult(intensity)) \
			* MatchSim.goal_rate(float(minute)) \
			*(1.0 - INJURY_TRAUMA_SHARE - INJURY_STEAL_SHARE)








func live_injury_trauma_p() -> float:
	return injury_risk(1.0, live_injury_mult()) * INJURY_TRAUMA_SHARE






func live_injury_steal_p() -> float:
	return injury_risk(1.0, live_injury_mult()) * INJURY_STEAL_SHARE




func _live_energy_mult() -> float:
	if _live_minutes <= 0.0:
		return MatchPlan.energy_mult(intensity)
	return _live_spent /(MATCH_ENERGY_COST / 90.0 * _live_minutes)




func _settle_live_match() -> float:
	var total: float = live_spent_total()
	energy = maxf(0.0, energy - maxf(0.0, total - _live_spent))
	_live_open = false
	return total





func abort_live_match() -> void:

	_bajas_en_vivo = {}
	_bajas_propias_en_vivo = []
	if not _live_open:
		return
	energy = clampf(energy + _live_spent, 0.0, energy_cap())
	_live_open = false
	_live_spent = 0.0
	_live_minutes = 0.0
	_live_injury_acc = 0.0




