			+ " lo vota al cierre. Los sondeos dan un {1}% a favor de vender. Tienes acciones:"
			+ " tu voto arrastra a la grada.", [club, fin_socios_sondeo()])
	else:
		desc = I18n.tf("Tres temporadas después, un inversor quiere comprar {0} y la asamblea"
			+ " lo vota al cierre. Los sondeos dan un {1}% a favor de vender. Tu voto es uno"
			+ " más, pero la grada escucha a sus jugadores.", [club, fin_socios_sondeo()])
	return {
		"id": FIN_SOCIOS_EVENT_ID,
		"title": "LA ASAMBLEA VOTA LA VENTA",
		"desc": desc,
		"a": {"label": I18n.t("VOTO VENDER"),
			"fx": {"fin_socios_vender": true, "rel": Concurso.VENDER_FX}},
		"b": {"label": I18n.t("VOTO SEGUIR"),
			"fx": {"fin_socios_seguir": true, "rel": Concurso.SEGUIR_FX}},
	}










func acciones_aporte() -> int:
	if asamblea.has("aporte"):
		return int(asamblea["aporte"])
	return int(float(contract.get("wage", 0)) * Concurso.APORTE_SEMANAS)



func acciones_oferta() -> int:
	return Concurso.plusvalia(acciones_aporte(), dueno_perfil(str(asamblea.get("club", ""))))







func _check_acciones() -> bool:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty() or forced_sale:
		return false
	if not tienes_acciones(mio) or not str(asamblea.get("acciones", "")).is_empty():
		return false
	if proyecto_de(mio) != ClubFinance.PROYECTO_DUENO or _decision_no_caduca(pending_decision):
		return false


	asamblea["acciones"] = Concurso.ACC_TUYAS
	pending_decision = ACCIONES_EVENT_ID
	pending_decision_club = ""
	pending_decision_club_b = ""
	decision_cooldown = DECISION_COOLDOWN
	return true




func _acciones_event() -> Dictionary:
	var id: String = str(asamblea.get("club", GameState.player_team_id))
	var club: String = String(Teams.by_id(id).get("name", "?"))
	var perfil: String = dueno_perfil(id)
	var oferta: int = acciones_oferta()
	var como: String
	match perfil:
		Duenos.JEQUE:
			como = I18n.t("No regatea: el dinero no es su problema.")
		Duenos.MAGNATE:
			como = I18n.t("Sabe lo que vale cada parte y lo paga.")
		_:
			como = I18n.t("Su fondo regatea cada céntimo.")
	return {
		"id": ACCIONES_EVENT_ID,
		"title": "EL DUEÑO QUIERE TUS ACCIONES",
		"desc": I18n.tf("{0} tiene dueño nuevo y lo quiere entero: te ofrece ${1} por la parte que"
			+ " compraste en la asamblea, que te costó ${2}.", [club, CareerUi.money(oferta),
