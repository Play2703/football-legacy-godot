func _cancel_plan_seat(seat: String) -> void:
	if seat.is_empty():
		return
	var parts: PackedStringArray = seat.split("#")
	if parts.size() != 2:
		return
	var club: String = String(parts[0])
	var idx: int = int(parts[1])
	var quedan: Array = []
	for m in _ai_plan:
		var mm: Dictionary = m
		if String(mm.get("from", "")) == club and int(mm.get("from_idx", -1)) == idx:
			continue
		if String(mm.get("to", "")) == club and int(mm.get("to_idx", -1)) == idx:
			continue
		quedan.append(m)
	_ai_plan = quedan










func _plan_corre_asiento(team_id: String, h: int) -> void:
	_plan_sin_cadena(["%s#%d" % [team_id, h]])
	for m in _ai_plan:
		var mm: Dictionary = m
		if String(mm.get("to", "")) == team_id and int(mm.get("to_idx", -1)) > h:
			mm["to_idx"] = int(mm["to_idx"]) - 1
		if String(mm.get("from", "")) == team_id and int(mm.get("from_idx", -1)) > h:
			mm["from_idx"] = int(mm["from_idx"]) - 1
	var rumor: PackedStringArray = String(squad_rumor.get("seat", "")).split("#")
	if rumor.size() == 2 and String(rumor[0]) == team_id:
		if int(rumor[1]) == h:
			squad_rumor = {}
		elif int(rumor[1]) > h:
			squad_rumor["seat"] = "%s#%d" % [team_id, int(rumor[1]) - 1]







func _cedidos_en_casa() -> Dictionary:
	var crudo: Dictionary = TransferBook.asientos_en_cesion()
	var mapas: Dictionary = {}
	var out: Dictionary = {}
	for k in crudo:
		var parts: PackedStringArray = String(k).split("#")
		if parts.size() != 2:
			continue
		var club: String = String(parts[0])
		if not mapas.has(club):
			mapas[club] = _mapa_libro(club)
		var mapa: Array = mapas[club]
		if mapa.is_empty():
			out[k] = true
			continue
		var h: int = mapa.find(int(parts[1]))
		if h >= 0:
			out["%s#%d" % [club, h]] = true
	return out




