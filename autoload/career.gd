func estatus_club() -> Dictionary:


	var rol: int = Standing.contract_role_from_key(String(contract.get("role", "rotacion")))
	var sitio: String = Standing.contract_role_name(rol)
	var sitio_malo: bool = club_gave_up or _obj_bench_left > 0 or forced_loan
	if sitio_malo:
		sitio = "FUERA DEL PLAN"
	elif rol == Standing.ContractRole.TITULAR and _club_values_you():


		sitio = "INDISCUTIBLE"

	var salida: String = "TE ESCUCHAN"
	var salida_mala: bool = false
