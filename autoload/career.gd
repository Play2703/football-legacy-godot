func _gerencia_ventana_apunta() -> void:
	if not gerencia_ventana_abierta():
		return
	_gerencia_tope_sella()
	var t: Dictionary = gerencia_tope()
	var mio: String = GameState.player_team_id
	var id: String = Market.window_id(GameState.season_day, GameState.winter_day())
	var wd: int = GameState.winter_day()
	var ventas: int = 0
	for n in market_news:
		var nd: Dictionary = n
		if String(nd.get("kind", "")) != "signing" or String(nd.get("from", "")) != mio:
			continue
		if int(nd.get("season", -1)) != GameState.season_num \
				or Market.window_id(int(nd.get("day", -1)), wd) != id:
			continue
		ventas += maxi(int(nd.get("fee", 0)), 0)
	var fila: Dictionary = {"season": GameState.season_num, "ventana": id, "club": mio,
		"total": int(t["base"]), "gastado": int(t["gastado"]), "ventas": ventas}
	var libro: Array = gerencia.get("ventanas", []) if gerencia.get("ventanas", []) is Array else []
	if not libro.is_empty() and int((libro[0] as Dictionary).get("season", -1)) == fila["season"] \
			and String((libro[0] as Dictionary).get("ventana", "")) == id:
		libro[0] = fila
	else:
		libro.push_front(fila)
	gerencia["ventanas"] = libro.slice(0, VENTANAS_MAX)




