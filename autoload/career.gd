func _seed_market_board() -> void:
	_market_board = {}
	_board_stamp = ""
	var mine: String = GameState.player_team_id
	if mine.is_empty() or free_agent or on_loan() or retired:
		return





	var yo: int = Squad.user_index(Squad.home_of(mine))



	var salen: Array = []
	for m in _ai_plan:
		var mm: Dictionary = m
		var k: String = String(mm.get("kind", ""))
		if k != "signing" and k != "loan" and k != "exit":
			continue
		if String(mm.get("from", "")) != mine:
			continue
		var fi: int = int(mm.get("from_idx", -1))
		if fi >= 0 and fi == yo:
			continue


		var fee: int = 0 if bool(mm.get("free", false)) else int(mm.get("fee", 0))
		salen.append({
			"name": String(mm.get("name", "")),
			"pos": String(mm.get("pos", "MC")),
			"media": int(mm.get("media", 0)),


			"club": String(mm.get("to", "")),
			"fee": fee,


			"kind": "loan" if k == "loan" else "exit",



			"clausula": bool(mm.get("clausula", false)),
			"rumor": false,
		})



	var rn: String = String(squad_rumor.get("name", ""))
	if not rn.is_empty():
		for f in salen:
			var ff: Dictionary = f
			if String(ff.get("name", "")) == rn:
				ff["rumor"] = true
				break






	var venta: Array = []
	var cesion: Array = []
	for f in salen:
		var ff: Dictionary = f
		if String(ff.get("kind", "")) == "loan":
			cesion.append(ff)



		elif int(ff.get("fee", 0)) > 0 and not bool(ff.get("clausula", false)):
			venta.append(ff)









	var salen_todos: Array = []
	for f in salen:
		salen_todos.append(String((f as Dictionary).get("name", "")))
	_market_board = {
		"venta": Market.board_orden(venta),
		"cesion": Market.board_orden(cesion),
		"salen_todos": salen_todos,
	}
	_board_stamp = _board_sello()





