func _amer_draw_rows(comp: String) -> Array:
	var out: Array = []
	var vistos: Dictionary = {}
	for e in GameState.calendar:
		if String(e.get("comp", "")) != comp or String(e.get("round", "")) != "grupo":
			continue
		var opp: String = String(e.get("opp", ""))
		if opp.is_empty() or bool(e.get("dead", false)):
			continue
		var r: int = int(e.get("euro_round", 0))
		if vistos.has(opp) and int(vistos[opp]["round"]) <= r:
			continue
		if not vistos.has(opp):
			vistos[opp] = {"opp": opp, "round": r, "pot": -1, "you": false}
			out.append(vistos[opp])
		vistos[opp]["round"] = r
	out.sort_custom(func(a, b): return int(a["round"]) < int(b["round"]))
	if out.is_empty():
		return out
	out.push_front({"opp": GameState.player_team_id, "round": -1, "pot": -1, "you": true})
	return out


























