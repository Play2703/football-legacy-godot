func _schedule_ai_moves(moves: Array) -> Array:
	var out: Array = []
	if moves.is_empty():
		return out
	var hoy: int = GameState.season_day

	var mapas: Dictionary = {}









	for m in moves:
		var mm: Dictionary =(m as Dictionary).duplicate()
		var sal: Dictionary = _salida_de(String(mm.get("from", "")),
			int(mm.get("from_idx", -1)), GameState.season_num, _via_de_move(mm),
			String(mm.get("pos", "")), mapas)
		mm["origen"] = sal["origen"]
		mm["carrera"] = sal["carrera"]
		mm["cae"] = hoy
		out.append(mm)
	var ultimo: int = Market.window_last_day(hoy, GameState.winter_day())

	if ultimo <= hoy:
		return out
	var padres: Dictionary = {}
	for i in out.size():
		var claves: Array = _move_seats(out[i] as Dictionary)
		if claves.size() < 2:
			continue
		var raiz: String = _uf_find(padres, String(claves[0]))
		for j in range(1, claves.size()):
			var otra: String = _uf_find(padres, String(claves[j]))
			if otra != raiz:
				padres[otra] = raiz


	var cadenas: Dictionary = {}
	var sueltos: Array = []
	for i2 in out.size():
		var cl2: Array = _move_seats(out[i2] as Dictionary)
		if cl2.is_empty():
			sueltos.append(i2)
			continue
		var r: String = _uf_find(padres, String(cl2[0]))
		if not cadenas.has(r):
			cadenas[r] = {"idx": [], "peso": 0}
		var c: Dictionary = cadenas[r]
		(c["idx"] as Array).append(i2)
		c["peso"] = maxi(int(c["peso"]), int((out[i2] as Dictionary).get("fee", 0)))
	var orden: Array = cadenas.keys()


	orden.sort_custom(func(a: Variant, b: Variant) -> bool:
		var ca: Dictionary = cadenas[a]
		var cb: Dictionary = cadenas[b]
		if int(ca["peso"]) != int(cb["peso"]):
			return int(ca["peso"]) < int(cb["peso"])
		return int((ca["idx"] as Array)[0]) < int((cb["idx"] as Array)[0]))
	var dias: int = ultimo - hoy + 1
	var total: int = orden.size()
	for gi in total:
		var cad: Dictionary = cadenas[orden[gi]]
		var dia: int = hoy + Market.chain_day(gi, total, dias)
		for k in (cad["idx"] as Array):
			(out[int(k)] as Dictionary)["cae"] = dia



	for k2 in sueltos:
		(out[int(k2)] as Dictionary)["cae"] = hoy
	var idxs: Array = []
	for i3 in out.size():
		idxs.append(i3)
	idxs.sort_custom(func(a: Variant, b: Variant) -> bool:
		var da: int = int((out[int(a)] as Dictionary)["cae"])
		var db: int = int((out[int(b)] as Dictionary)["cae"])
		if da != db:
			return da < db
		return int(a) < int(b))
	var final: Array = []
	for i4 in idxs:
		final.append(out[int(i4)])
	return final






func _move_seats(m: Dictionary) -> Array:
	var out: Array = []
	var to_id: String = String(m.get("to", ""))
	var to_idx: int = int(m.get("to_idx", -1))
	if to_idx >= 0 and not Teams.is_free(to_id):
		out.append("%s#%d" % [to_id, to_idx])
	var from_id: String = String(m.get("from", ""))
	var from_idx: int = int(m.get("from_idx", -1))
	if from_idx >= 0 and not Teams.is_free(from_id):
		out.append("%s#%d" % [from_id, from_idx])
	return out






func _asientos_rotos(moves: Array) -> Array:
	var tamanos: Dictionary = {}
	var out: Array = []
	for m in moves:
		for lado in [["to", "to_idx"], ["from", "from_idx"]]:
			var club: String = String((m as Dictionary).get(lado[0], ""))
			var i: int = int((m as Dictionary).get(lado[1], -1))
			if i < 0 or club.is_empty() or Teams.is_free(club):
				continue
			if not tamanos.has(club):
				tamanos[club] = Squad.home_of(club).size()
			if int(tamanos[club]) > 0 and i >= int(tamanos[club]):
				out.append("%s#%d" % [club, i])
	return out




func _uf_find(padres: Dictionary, k: String) -> String:
	var r: String = k
	while String(padres.get(r, r)) != r:
		r = String(padres[r])
	var c: String = k
	while c != r:
		var sig: String = String(padres.get(c, c))
		padres[c] = r
		c = sig
	return r









func _drain_ai_plan(todo: bool = false) -> bool:
