const ONCE_IDEAL_PREMIO: String = "Once Ideal de la Liga"

func _elige_once_ideal(result: Dictionary, played_club: String, played_div: int,
		race_full: Array, lines: Array[String]) -> void:
	if played_club.is_empty():
		return
	var season: int = GameState.season_num - 1
	var country: String = Teams.country_of(played_club)
	var div: int = clampi(played_div, 1, 3)
	var censo: Array = GameState.teams_in_div_jugada(country, div)
	var ataque: Array = race_full.duplicate(true) if not race_full.is_empty() \
			else league_race(true, result)
	blend_mate_stats(ataque, "league", played_club)







	var con_nota: Array = []
	for e in ataque:
		if not str(e.get("pos", "")).is_empty():
			con_nota.append(e)
	ataque = con_nota


	var skip: String = "" if Race.RACE_POS.has(Squad.USER_POS) else Squad.USER_POS
	var cands: Array = ataque + Race.once_defensa(country, div, season, played_club,
		censo, skip)
	var en_liga: Dictionary = liga_del_anio(country, div)
	if int(en_liga["apps"]) > 0:
		cands.append({"name": player_name, "team": played_club, "pos": Squad.USER_POS,
			"apps": int(en_liga["apps"]), "avg": float(en_liga["avg"]),
			"goals": int(en_liga["g"]), "assists": int(en_liga["a"]),
			"you": true})

	var apps_ref: int = int(Race.leader(ataque, "avg").get("apps", 0))
	var apps_min: int = int(ceil(float(apps_ref) * 0.6 - 0.0001)) if apps_ref > 0 else 0
	var once: Dictionary = OnceIdeal.elige(cands, apps_min)
	var fila: Dictionary = {"season": season, "country": country, "div": div,
		"formation": once.get("formation", OnceIdeal.FORMACION_NOMBRE),
		"xi": once.get("xi", []), "you_in": bool(once.get("you_in", false))}
	var reemplazada: bool = false
	for i in once_history.size():
		if int((once_history[i] as Dictionary).get("season", -1)) == season:
			once_history[i] = fila
			reemplazada = true
			break
	if not reemplazada:
		once_history.append(fila)

	if int(en_liga["apps"]) > 0:
		_tele_once(fila)
	if bool(fila["you_in"]):


		_win(ONCE_IDEAL_PREMIO, ONCE_IDEAL_PREMIO.to_upper(), lines)
		if not season_history.is_empty():
			var row: Dictionary = season_history.back()
			if int(row.get("season", -1)) == season:
				var row_awards: Array = row.get("awards", [])
				if not row_awards.has(ONCE_IDEAL_PREMIO):
					row_awards.append(ONCE_IDEAL_PREMIO)
					row["awards"] = row_awards





