func _nat_comp_add(box: Dictionary, kind: String, goals: int, assists: int,
		minutes: int, rating: float = -1.0) -> void:
	var k: String = kind if NAT_COMPS.has(kind) else "qual"
	var cell: Dictionary = box.get(k, {"g": 0, "a": 0, "ap": 0, "min": 0})
	cell["g"] = int(cell.get("g", 0)) + goals
	cell["a"] = int(cell.get("a", 0)) + assists






	cell["min"] = int(cell.get("min", 0)) + maxi(minutes, 0)





	cell["ap"] = int(cell.get("ap", 0)) + 1





	if minutes > 0 and rating >= 0.0:
		cell["rs"] = float(cell.get("rs", 0.0)) + rating
		cell["rn"] = int(cell.get("rn", 0)) + 1
	box[k] = cell




