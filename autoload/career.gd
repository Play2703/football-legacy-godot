func _invierno_tecnicos_del_mundo() -> void:
	var ambito: Array = _ai_scope()
	if ambito.is_empty():
		return
	var temporada: int = GameState.season_num
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("coachinvierno|%d" % temporada)

	var rows: Array = GameState.league_standings()
	var jugadas: int = 0
	var mi_orden: Array = []
	var mi_forma: Dictionary = {}
	for r in rows:
		var k: String = String((r as Dictionary).get("key", ""))
		var cid: String = GameState.player_team_id if k == GameState.YOU_KEY else k
		mi_orden.append(cid)
		mi_forma[cid] = "".join(PackedStringArray(GameState.league_form.get(k, [])))
		if k == GameState.YOU_KEY:
			jugadas = int((r as Dictionary).get("pj", 0))
	var rondas: int = GameState.league_rounds_yours()
	var frac: float = clampf(float(jugadas) / float(rondas), 0.0, 1.0) if rondas > 0 else 0.5
	var ligas: Dictionary = {}
	if mi_orden.size() >= 2:
		var mi_pais: String = Teams.country_of(GameState.player_team_id)
		ligas["%s|%d" % [mi_pais, GameState.div_of(GameState.player_team_id)]] = \
				_liga_de_hoy(mi_orden, mi_forma)

	var ocupados: Dictionary = {}
	for f in coach_book:
		var donde: String = String((f as Dictionary).get("ahora", ""))
		if not donde.is_empty():
			ocupados[donde] = true
	var cand: Array = []
	for raw in ambito:
		var id: String = String(raw)
		if id == GameState.player_team_id or ocupados.has(id):
			continue


		var pais: String = Teams.country_of(id)
		var div: int = GameState.div_of(id)
		var clave: String = "%s|%d" % [pais, div]
		if not ligas.has(clave):
			var censo: Array = GameState.teams_in_div(pais, div)
			ligas[clave] = _liga_de_hoy(SimLeague.table(pais, div, temporada, frac, censo)
				if censo.size() >= 2 else [], {})
		var liga: Dictionary = ligas[clave]
		var pos: int = int((liga["pos"] as Dictionary).get(id, 0))
		var n: int = int(liga["n"])
		if pos <= 0 or n < 2:
			continue
		var rank: int = int((liga["rank"] as Dictionary).get(id, 0))
		var esperado: int = Coach.expected_pos(rank, n)
		var zona_roja: bool = n > 3 and pos > n - 3


		if pos <= esperado and not zona_roja:
			continue
		var s: Dictionary = Coaches.seat(id)
		var niv: int = Coaches.nivel_of(id)




		var recien: bool = Coaches.antiguedad(id, s, temporada) <= 1
		var ctx: Dictionary = {


			"matches": jugadas,
			"gracia": Coach.gracia_de(niv),
			"winless": int((liga["sin_ganar"] as Dictionary).get(id, 0)),
			"pos": pos,
			"expected": Coach.expected_pos(rank, n, niv),
			"expected_club": esperado,
			"zona_roja": zona_roja,
			"relegating": zona_roja and div < Teams.max_div(pais),
		}
		if rng.randf() >= Coach.p_invierno(ctx, niv, recien):
			continue


		var suena: bool = _banquillo_suena(id)
		var saliente: String = Coaches.name_of(id) if suena else ""
		var vuelve: Dictionary = _ficha_del_paro(id, rng)
		_fija_nombre(id)
		_al_paro(String(s.get("club", id)), int(s.get("term", Coaches.TERM_BASE)),
			temporada, id, int(s.get("cred", 0)))
		var src: String = ""
		if not vuelve.is_empty():
			src = "%s|%d" % [String(vuelve["club"]), int(vuelve["term"])]


		coach_seats[id] = Coaches.fila(int(s.get("mandato", Coaches.TERM_BASE)) + 1,
			temporada, 0, src, int(vuelve.get("cred", 0)))
		Coaches.bump()
		if not suena:
			continue
		var fila_n: Dictionary = {}
		if vuelve.is_empty():
			fila_n = WorldNews.fila_tecnico(temporada, GameState.season_day, id,
				saliente, "", false)
		else:
			fila_n = WorldNews.fila_tecnico(temporada, GameState.season_day, id,
				Coaches.name_of(id), String(vuelve.get("ultimo", vuelve["club"])), true)
		if not fila_n.is_empty():
			cand.append(WorldNews._cand(fila_n, Teams.rating(id)))
	_cubre_banquillos(cand)





func _liga_de_hoy(orden: Array, forma: Dictionary) -> Dictionary:
	var pos: Dictionary = {}
	var ids: Array = []
	var sg: Dictionary = {}
	for k in forma:
		sg[k] = Coach.sin_ganar_de_forma(str(forma[k]))
	for i in orden.size():
		var o: Variant = orden[i]
		var id: String = str((o as Dictionary).get("id", "")) if o is Dictionary else str(o)
		pos[id] = i + 1
		ids.append(id)

		if o is Dictionary:
			var d: Dictionary = o
			sg[id] = int(d["sin_ganar"]) if d.has("sin_ganar") \
					else Coach.sin_ganar_de_forma(str(d.get("form", "")))
	ids.sort_custom(_rating_antes)
	var rank: Dictionary = {}
	for i in ids.size():
		rank[str(ids[i])] = i
	return {"pos": pos, "rank": rank, "sin_ganar": sg, "n": orden.size()}











































const SIGNING_REF_FEE: float = 20000000.0
const SIGNING_REF_BONUS: float = 86000.0
const SIGNING_EXP: float = 0.53



















const SIGNING_CAP: int = 1000000






static func signing_bonus_gross(precio: int) -> int:
	if precio <= 0:
		return 0
	return mini(int(SIGNING_REF_BONUS
		* pow(float(precio) / SIGNING_REF_FEE, SIGNING_EXP)), SIGNING_CAP)













