func _replace_coach(fuente: Dictionary = {}, invierno: bool = false) -> void:
	var salido: String = coach_name()


	_book_add(fuente.get("ficha", null))
	coach_term += 1



	var vuelve: Dictionary = {}
	if fuente.has("ficha"):
		vuelve = fuente["ficha"]
	elif fuente.is_empty():
		vuelve = _repesca_coach()











	var del_paro: Dictionary = {}
	if not fuente.is_empty() and not fuente.has("ficha"):
		del_paro = fuente
	elif vuelve.is_empty():
		var rng_paro := RandomNumberGenerator.new()
		rng_paro.seed = randi()
		del_paro = _ficha_del_paro(GameState.player_team_id, rng_paro)
	if not vuelve.is_empty():



		coach_char = Coach.caracter_a_tu_nivel(String(vuelve.get("char", "neutral")),
			coach_tier())



		coach_idea = Coaches.idea_de(String(vuelve.get("club", "")), int(vuelve.get("term", 1)))
		coach_src = "%s|%d" % [String(vuelve.get("club", "")),
			int(vuelve.get("term", 1))]




		coach_cred = int(vuelve.get("cred", 0))
