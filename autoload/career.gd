func gerencia_renueva_lista() -> Array:
	var mio: String = GameState.player_team_id
	var out: Array = []
	var raw: Variant = gerencia.get("renueva", [])
	if mio.is_empty() or not (raw is Array) or peldano() < Gerencia.PELDANO_MESA:
		return out
	var casa: Array = Squad.home_of(mio)
