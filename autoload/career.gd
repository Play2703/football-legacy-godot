const CURA_SIN_TAPA_V: int = 1



const CURA_CANTERANOS_V: int = 1




func _reancla_al_cargar(cfg: ConfigFile) -> void:
	TransferBook.load_parches(cfg.get_value("career", "tray_parches", {}))
	TransferBook.load_huella(cfg.get_value("career", "huella_asientos", {}))
	if cfg.has_section_key("career", "huella_asientos"):
		reancla_asientos()
	else:


		var crece: Dictionary = _sigma_tamano()
		var rep: Dictionary = TransferBook.cura_desanclados(GameState.player_team_id,
			maxi(GameState.season_num, 1))
		_vidas_de_la_cura(rep)
		_reancla_casa(_compone_sigmas(crece, _sigma_cura(rep)), {})

		var vueltos: int = _restituye_desaparecidos(maxi(GameState.season_num, 1))


		vueltos += _cierra_desalojos()
		_reancla_socios(true)
		if int(rep["repuntadas"]) + int(rep["refotos"]) + int(rep["nadie"]) + vueltos > 0:
			print("Career: fichajes desanclados curados al cargar (%s · %d vuelven libres)"
				% [str(rep), vueltos])







	TransferBook.remap_to_pack()


	if int(cfg.get_value("career", "cura_sin_tapa", 0)) < CURA_SIN_TAPA_V:
		var sin_tapa: int = TransferBook.cura_origen_sin_tapa()
		if sin_tapa > 0:
			print("Career: %d fichajes con origen inventado curados al cargar" % sin_tapa)



	if int(cfg.get_value("career", "cura_canteranos", 0)) < CURA_CANTERANOS_V:
		var bajados: int = TransferBook.cura_canteranos_inflados(GameState.player_team_id)
		if bajados > 0:
			print("Career: %d canteranos inflados bajan a su nivel al cargar" % bajados)


	var herederas: int = TransferBook.cura_propias_herederas()
	if herederas > 0:
		print("Career: %d filas de herederos dejan de pintar al retirado" % herederas)


	_cura_duplicados()
	fija_huella_asientos()







func _cura_duplicados() -> int:
	var sobran: Array = TransferBook.duplicados(GameState.player_team_id)
	for d in sobran:
		var club: String = String(d["club"])
		var fila: int = int(d["idx"])
		var ident: Dictionary = AiMarket.youth_identity(club, String(d["pos"]),
			Teams.rating(club), Teams.country_of(club), GameState.season_num,
			hash("duplicado|%s|%d|%d" % [club, fila, GameState.season_num]))
		var h: int = TransferBook.casa_de_libro(club, fila)
		TransferBook.record(club, fila, ident, GameState.season_num, "", TransferBook.NADIE, h)
		_patch_squad_meta(club, h, ident)
		print("Career: %s vivía dos veces; %s#%d pasa a un canterano" % [
			String(d["nombre"]), club, fila])
	if not sobran.is_empty():
		TransferBook.invalidate_caches()
	return sobran.size()





