func _maybe_fichajes_verano(cerrada: String) -> bool:
	var habia: bool = not llegadas_ventana.is_empty()
	var filas: Array = llegadas_ventana
	llegadas_ventana = []
	if cerrada != Market.WINDOW_SUMMER:
		return habia
	if free_agent or retired:
		return habia
	var club: String = GameState.player_team_id
	if club.is_empty() or filas.is_empty():
		return habia
	var sello: String = "%d|%s" % [GameState.season_num, cerrada]
	var mia: Dictionary = _mi_llegada(club, sello)





	if not mia.is_empty():
		_llegadas_desde_noticias()
		var nombres: Dictionary = {}
		for r in filas:
			nombres[String((r as Dictionary).get("name", ""))] = true
		for r in llegadas_ventana:
			if not nombres.has(String((r as Dictionary).get("name", ""))):
				filas.append(r)
		llegadas_ventana = []






	var dorsal: Dictionary = {}
	for row in Squad.of(club):
		dorsal[String((row as Dictionary).get("name", ""))] = \
				int((row as Dictionary).get("number", 0))
	var out: Array = []
	for r in filas:
		var rd: Dictionary = r
		var nm: String = String(rd.get("name", ""))
		if String(rd.get("club", "")) != club or String(rd.get("ventana", "")) != sello:
			continue
		if not dorsal.has(nm):
			continue
		var f: Dictionary = rd.duplicate()
		f.erase("club")
		f.erase("ventana")
		f["number"] = int(dorsal[nm])
		out.append(f)
	if out.is_empty():
		return habia
	if not mia.is_empty():
		out.append(mia)



	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if int(a.get("media", 0)) != int(b.get("media", 0)):
			return int(a.get("media", 0)) > int(b.get("media", 0))
		return int(a.get("fee", 0)) > int(b.get("fee", 0)))
	queue_ceremony(Ceremonies.FICHAJES_VERANO, {
		"club": club,


		"llegadas": out.slice(0, FICHAJES_PAYLOAD_MAX),
		"total": out.size(),
	})
	return true




