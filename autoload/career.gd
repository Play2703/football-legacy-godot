func _uefa_noticias(temporada: int, fallo: bool) -> Array:
	var mi_pais: String = Teams.country_of(GameState.player_team_id)
	var n: int = 2 if fallo else 1
	var out: Array = []
	for raw in club_projects.keys():
		var id: String = str(raw)
		var fila: Variant = club_projects[raw]
		if not _uefa_investiga(id, fila) \
				or Duenos.uefa_fallo(int((fila as Array)[1])) != temporada \
				or Teams.country_of(id) != mi_pais:
			continue
		var contada: bool = false
		for f in world_news:
			if str((f as Dictionary).get("kind", "")) == "uefa" \
					and str((f as Dictionary).get("club", "")) == id \
					and int((f as Dictionary).get("season", -1)) == temporada \
					and int((f as Dictionary).get("n", 0)) == n:
				contada = true
				break
		if contada:
			continue
		var noticia: Dictionary = WorldNews.fila_uefa(temporada, GameState.season_day, id, fallo)
		if not noticia.is_empty():
			out.append(noticia)
	return out






