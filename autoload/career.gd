		for m in caen:
			var mm: Dictionary = m
			if "%s#%d" % [String(mm.get("from", "")),
					int(mm.get("from_idx", -1))] == seat:
				squad_rumor = {}
				_tirar_charla_pendiente()
				break
	return true





















