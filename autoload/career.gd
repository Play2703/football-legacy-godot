func _queue_goodbye(club_id: String = "", order: int = -1) -> void:
	if club_id.is_empty():
		club_id = GameState.player_team_id
	if club_id.is_empty() or retired:
		return
	var apps: int = season_matches
	var goals: int = season_goals
	for row in season_history:
		var r: Dictionary = row
		if String(r.get("club", "")) != club_id:
			continue
		apps += int(r.get("apps", 0))
		goals += int(r.get("goals", 0))
	if apps < GOODBYE_MIN_APPS:
		return
	var pay: Dictionary = {




		"mode": "goodbye", "club": club_id,
		"div": clampi(GameState.div_of(club_id), 1, 3),
		"matches": apps, "goals": goals,
	}




	if order >= 0:
		pay["order"] = order
	queue_ceremony(Ceremonies.PRESSER, pay)


















