func _once_con_relevo(squad: Array, meta: Array, slots: Array, factor: float, k: int,
		habituales: Dictionary = {}) -> Array:
	var sin_mio: Array = slots.duplicate()
	sin_mio.remove_at(k)
	var diez: Array = Rotation.lineup(squad, meta, sin_mio, factor, {}, {},
		Standing.TIRED_BENCH_ENERGY, habituales)
	if diez.is_empty():
		return []
	var fuera: Dictionary = {}
	for i in diez:
		fuera[int(i)] = true
	var relevo: Array = Rotation.lineup(squad, meta, [slots[k]], factor, {}, fuera,
		Standing.TIRED_BENCH_ENERGY)
	if relevo.is_empty():
		return []
	var once: Array = diez.duplicate()
	once.insert(k, relevo[0])
	return once


















func lineup_media() -> int:
	var team_id: String = GameState.player_team_id
	if team_id.is_empty():
		return 0

	var squad: Array = Squad.of_nominal(team_id)
	if squad.is_empty():
		return 0
	var once: Array = club_lineup()
	if once.is_empty():
		return 0




	var slots: Array = Squad.formation_slots(team_id).slice(0, Squad.STARTING_XI)



	var mio: int = Squad.user_index(squad)
	var suma: float = 0.0
	var n: int = 0
	for j in once.size():
		var i: int = int(once[j])
		if i < 0 or i >= squad.size():
			continue
		if i == mio:


			suma += float(Squad.ovr_scale(skills_avg()))
		else:
			var pos: String = String(slots[j]) if j < slots.size() \
					else String((squad[i] as Dictionary).get("pos", "MC"))
			suma += float(SquadMeta.media_of(squad[i], pos))
		n += 1
	if n == 0:
		return 0
	return int(round(suma / float(n)))




















