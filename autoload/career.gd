func _tally_jersey_season(lines: Array[String] = []) -> void:
	var club: String = GameState.player_team_id
	if club.is_empty() or not loan.is_empty():
		return
	var rows: Array = squad_roster()
	if rows.is_empty():
		return
	var t: Array = JerseySales.table(rows, _jersey_ctx())
	for i in t.size():
		if not bool(t[i].get("is_you", false)):
			continue
		var share: float = float(t[i].get("share", 0.0))
		var units: int = JerseySales.units_of(share,
			Teams.rating(club), GameState.player_div())
		jersey_history.append({
			"season": GameState.season_num,
			"club": club,
			"rank": i + 1,
			"of": t.size(),
			"share": share,



			"units": units,
		})






		var top: float = float(t[0].get("share", 0.0))
		var norm: float = 0.0 if top <= 0.0 else clampf(share / top, 0.0, 1.0)
		var royalty: int = int(round(float(contract.get("wage", 0))
			* JERSEY_ROYALTY_WAGES * norm * norm))
		royalty = con_doble_paga(royalty)
		if royalty > 0:
			money += royalty
			_apunta_ingreso("camiseta", royalty)



			if i == 0:
				lines.append(I18n.tf(
					"LA CAMISETA DEL CLUB ES LA TUYA: {0} unidades", [units]))
			else:
				lines.append(I18n.tf(
					"Camisetas: {0} unidades, el nº{1} del vestuario", [units, i + 1]))
		break
	while jersey_history.size() > JERSEY_HISTORY_MAX:
		jersey_history.remove_at(0)










