func _archiva_puestos_del_mundo(result: Dictionary, div_jugada: int) -> void:
	var temporada: int = GameState.season_num - 1
	var mio: String = GameState.player_team_id

	var mi_pais: String = Teams.country_of(mio) if not mio.is_empty() else ""
	var mi_tabla: Array = result.get("standings", []) as Array
	var mis_campeones: Array =(result.get("league_champions", []) as Array).duplicate()
	if mis_campeones.is_empty() and not String(result.get("league_champion", "")).is_empty():
		mis_campeones = [String(result["league_champion"])]
	var out: Dictionary = {}
	var titulos: Dictionary = {}
	for c in Nations.PLAYABLE:
		var pais: String = String(c)
		for div in range(1, 4):
			var orden: Array = []
			var mia: bool = pais == mi_pais and div == div_jugada and mi_tabla.size() >= 2
			var censo: Array = []
			if mia:
				for row in mi_tabla:
					var k: String = String((row as Dictionary).get("key", ""))
					orden.append(mio if k == GameState.YOU_KEY else k)
			else:
				censo = GameState.teams_in_div_jugada(pais, div)
				if censo.size() < 2:
					continue
				for r in SimLeague.table(pais, div, temporada, 1.0, censo):
					orden.append(String((r as Dictionary).get("id", "")))
			for i in orden.size():
				if not String(orden[i]).is_empty():
					out[String(orden[i])] = [i + 1, orden.size()]
			var campeones: Array = []
			if mia and not mis_campeones.is_empty():
				campeones = mis_campeones
			elif div == 1 and not _fila_liga(pais, temporada).is_empty():
				var fila: Dictionary = _fila_liga(pais, temporada)
				campeones = [String(fila.get("champion", "")), String(fila.get("champion_ap", ""))]
			elif Liguilla.aplica(pais, div):
				for t in [Liguilla.APERTURA, Liguilla.CLAUSURA]:
					campeones.append(String(SimLeague.liguilla(pais, div, temporada,
						censo if not censo.is_empty() else GameState.teams_in_div_jugada(pais, div),
						t).get("winner", "")))
			else:
				campeones = [String(orden[0])]
			for w in campeones:
				var id: String = GameState._euro_sim_id(String(w))
				if not id.is_empty():
					titulos[id] = int(titulos.get(id, 0)) + 1
	if int(GameState.last_orden_1a.get("season", -1)) == temporada:
		var copas: Dictionary = GameState.last_orden_1a.get("copa", {}) as Dictionary
		for p in copas:
			var id: String = GameState._euro_sim_id(String(copas[p]))
			if not id.is_empty():
				titulos[id] = int(titulos.get(id, 0)) + 1
	club_puesto_ano = out
	club_titulos_ano = titulos
	club_puesto_temporada = temporada








func _club_titulos(club_id: String, puesto: int) -> int:
	var n: int = int(club_titulos_ano.get(club_id, 0)) if _archivo_vivo() \
			else (1 if puesto == 1 else 0)
	if GameState.last_ucl_winner == club_id:
		n += 1
	if GameState.last_eul_winner == club_id:
		n += 1

	if GameState.last_lib_winner == club_id:
		n += 1
	if GameState.last_sud_winner == club_id:
		n += 1
	if GameState.last_cca_winner == club_id:
		n += 1

	if GameState.last_ace_winner == club_id:
		n += 1
	if GameState.last_ac2_winner == club_id:
		n += 1

	if GameState.last_caf_winner == club_id:
		n += 1
	if GameState.last_cf2_winner == club_id:
		n += 1

	if GameState.last_ofc_winner == club_id:
		n += 1
	return n





