const OBJ_RISK_FROM: float = 0.66










const OBJ_PROJ_FROM: float = 0.15





















func objective_pace() -> Dictionary:
	var typ: String = String(contract.get("obj_type", ""))
	var target: int = int(contract.get("obj_target", 0))
	var done: int = int(contract.get("obj_progress", 0))
	var t: float = clampf(GameState.season_progress(), 0.0, 1.0)
	var out: Dictionary = {"type": typ, "target": target, "done": done, "t": t,
		"expected": target, "projected": -1, "on_track": true, "met": false}
	if target <= 0 or typ.is_empty():
		return out
	match typ:
		"position":
			var pos: int = GameState.league_position()
			out["done"] = pos
			out["projected"] = pos
			out["met"] = pos > 0 and pos <= target
			out["on_track"] = pos <= 0 or pos <= target
		"rating":

			out["projected"] = done if season_matches > 0 else -1
			out["met"] = season_matches > 0 and done >= target
			out["on_track"] = season_matches <= 0 or done >= target
		_:
			out["expected"] = ceili(float(target) * t)
			if t >= OBJ_PROJ_FROM:
				out["projected"] = roundi(float(done) / t)
			out["met"] = done >= target
			out["on_track"] = bool(out["met"]) or done >= int(out["expected"])
	return out





func objective_at_risk() -> bool:
	if free_agent or retired or not loan.is_empty():
		return false
	if GameState.season_progress() < OBJ_RISK_FROM:
		return false
	var p: Dictionary = objective_pace()
	return int(p["target"]) > 0 and not bool(p["on_track"])





func objective_done_early() -> bool:
	if free_agent or retired or not loan.is_empty():
		return false
	if GameState.season_progress() >= 1.0:
		return false
	var p: Dictionary = objective_pace()
	return int(p["target"]) > 0 and bool(p["met"])





