func auto_recovery(played_ratio: float, dias: float = Rotation.DIAS_DEFECTO) -> float:
	return float(recovery_detail(played_ratio, dias)["total"])















func recovery_detail(played_ratio: float, dias: float = Rotation.DIAS_DEFECTO) -> Dictionary:










	var d: float = Rotation.dias_validos(dias)
	var escala: float = d / Rotation.DIAS_DEFECTO
	var base: float = REST_BASE * escala
	var comprado: float = rest_bonus_soft(rest_bought_raw()) * escala
	var pareja: float = pareja_descanso() * escala
	var items: Array = []
	for it in rest_bought_items():
		var copia: Dictionary =(it as Dictionary).duplicate()
		copia["amount"] = float(copia.get("amount", 0.0)) * escala
		items.append(copia)
	var det: Dictionary = {
		"base": base, "bench": 0.0, "fisico": 0.0, "congestion": 0.0,
		"pareja": pareja, "comprado": comprado, "items": items,
		"tecnico": 0.0, "total": 0.0, "dias": d,
	}











	if injury_weeks > 0:
		det["total"] = maxf(0.0, base + comprado + pareja)
		return det
	var bench: float = REST_BENCH_BONUS * escala *(1.0 - clampf(played_ratio, 0.0, 1.0))




	var congestion: float = - LOAD_RECOVERY_CUT * clampf(match_load, 0.0, 1.0)


	var fisico: float = FIT_REST_BONUS * escala * stat_norm("fisico")





	var tecnico: float =(base + bench) *(rasgo_partido("repone") - 1.0)
	det["bench"] = bench
	det["congestion"] = congestion
	det["fisico"] = fisico
	det["tecnico"] = tecnico
	det["total"] = maxf(0.0, base + bench + comprado + congestion + fisico
		+ pareja + tecnico)
	return det















func rest_bought_items() -> Array:
	var items: Array = []


	var casa: float = House.rest_raw(house_level)
	if casa > 0.0:
		items.append({"id": "casa", "raw": casa,
			"label": String(House.level_data(house_level).get("name", "CASA"))})





	for e in House.extras_for(house_level):
		var raw_e: float = float(e.get("rest_raw", 0.0))
		if raw_e > 0.0 and house_extras.has(String(e["id"])):
			items.append({"id": String(e["id"]), "raw": raw_e,
				"label": String(e.get("name", ""))})






	for inv_id in investments:
		var v: Dictionary = Shop.investment_by_id(String(inv_id))
		if float(v.get("rest", 0.0)) > 0.0:
			items.append({"id": String(inv_id), "raw": float(v["rest"]),
				"label": String(v.get("name", ""))})





	for merch_id in club_merch_owned():
		var m: Dictionary = Shop.merch_by_id(String(merch_id))
		var raw_m: float = float(m.get("rest", 0.0))
		if raw_m > 0.0:
			items.append({"id": String(merch_id), "raw": raw_m,
				"label": String(m.get("name", ""))})
	var total_raw: float = 0.0
	for it in items:
		total_raw += float(it["raw"])
	var factor: float = 0.0 if total_raw <= 0.0 \
			else rest_bonus_soft(total_raw) / total_raw
	for it in items:
		it["amount"] = float(it["raw"]) * factor
	items.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return float(a["amount"]) > float(b["amount"]))
	return items





func rest_bought_raw() -> float:
	var comprado: float = 0.0
	for it in rest_bought_items():
		comprado += float(it["raw"])
	return comprado





func rest_delta_for(raw: float) -> float:
	var actual: float = rest_bought_raw()
	return rest_bonus_soft(actual + raw) - rest_bonus_soft(actual)















func rest_bonus_soft(raw: float) -> float:
	if raw <= 0.0:
		return 0.0
	return REST_BUY_SOFT_CAP *(1.0 - exp(- raw / REST_BUY_SOFT_CAP))


















