func _tick_squad_energy(meta: Array, jugaron: Dictionary, squad: Array = [],
		minutos: Dictionary = {}) -> void:
	if squad.is_empty():
		squad = Squad.of_nominal(GameState.player_team_id)
	var unico_por: int = _portero_unico(squad, meta)
	var dias: float = Rotation.dias_validos(GameState.dias_descanso(true))





	var banca: Dictionary = {}
	for i in club_matchday().get("banca", []):
		banca[int(i)] = true



	var gasto: float = rasgo_club("gasto")
	var repone: float = rasgo_club("repone")
	for i in meta.size():


		if i == unico_por:
			Rotation.clava(meta[i])
			continue
		var mins: int = 90 if jugaron.has(i) else 0
		if not minutos.is_empty():
			mins = int(minutos.get(i, 0))
		Rotation.tick(meta[i], mins, dias,
			mins <= 0 and not jugaron.has(i) and not banca.has(i), gasto, repone)













