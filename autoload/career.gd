func house_use_block_reason(id: String) -> String:
	var u: Dictionary = House.use_by_id(id)
	var kind: String = String(u.get("kind", ""))






	if (kind == "gimnasio" or kind == "cinta") and injury_weeks > 0:
		return I18n.t("Espera al alta médica para entrenar.")
	if not HOUSE_SESSION_KINDS.has(kind):
		return ""
	var colocado: bool = false
	for prop in House.props_of(house_level):
		if String(prop.get("kind", "")) == kind and not bool(prop.get("guardado", false)):
			var req: String = String(prop.get("req", ""))
			if req.is_empty() or house_extras.has(req):
				colocado = true
				break
	if not colocado:
		return I18n.t("Coloca este mueble para usarlo.")
	if kind == "bici_estatica" and injury_weeks > 0:
		return I18n.t("Espera al alta médica para pedalear.")
	var fx: String = String(u.get("next_match", ""))


	if fx == HOUSE_BOOT_FX:
		if int(Shop.boots_by_id(boots).get("life", 0)) <= 0:
			return I18n.t("Con las botas de cantera no hay nada que cuidar.")
		return I18n.t("Tus botas ya están listas para el próximo partido.") \
				if has_match_fx(fx) else ""
	if not fx.is_empty():
		return I18n.t("La preparación táctica ya está lista para el próximo partido.") \
				if has_match_fx(fx) else ""
	if float(u.get("energy", 0.0)) > 0.0 and energy < energy_cap():
		return ""
	if int(u.get("form", 0)) > 0 and form < 5:
		return ""
	for k in u.get("rel", {}):
		if float(u["rel"][k]) > 0.0 and int(rel.get(k, 0)) < 100:
			return ""
	return I18n.t("Ahora mismo no necesitas esta sesión.")













