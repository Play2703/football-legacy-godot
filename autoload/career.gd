	return Gerencia.nivel_factor(gerencia_gap(f)) * gerencia_puesto_factor(f)











var _once_asientos_memo: Array = []
var _once_asientos_clave: String = ""

func _gerencia_once_asientos() -> Array:
	var clave: String = "%s|%s" % [GameState.player_team_id, _ger_memo_base()]
	if clave == _once_asientos_clave:
		return _once_asientos_memo
	var out: Array = []
	var squad: Array = Squad.of(GameState.player_team_id)
	for i in mini(squad.size(), Squad.STARTING_XI):
		var p: Dictionary = squad[i]
		var pos: String = String(p.get("pos", "MC"))
		out.append({"name": String(p.get("name", "")), "pos": pos,
			"ovr": SquadMeta.ovr_of(p, pos)})
	_once_asientos_memo = out
