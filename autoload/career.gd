func _pareja_viaje(pedirselo: bool) -> bool:
	pareja.erase("viaje")
	if not pareja_activa():
		return false
	var viene: bool = pedirselo and PAREJA.viene(String(pareja.get("id", "")),
		int(rel["pareja"]))
	if viene:
		pareja.erase("viaje_de")
		_apply_delta("pareja", PAREJA.VIAJE_SI, REL_BRAKE_EXP_DECISION)
		_pareja_noticia(WorldNews.PAREJA_SE_VIENE)
		return true
	if pedirselo:
		_apply_delta("pareja", PAREJA.VIAJE_NO, REL_BRAKE_EXP_DECISION)


	var pais: String = String(pareja.get("viaje_de", ""))
	pareja.erase("viaje_de")
	if pais.is_empty() or pais == Teams.country_of(GameState.player_team_id):
		return false
	pareja["lejos"] = pais
	pareja["lejos_temp"] = GameState.season_num
	_pareja_noticia(WorldNews.PAREJA_SE_QUEDA)
	return false


