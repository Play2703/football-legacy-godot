	return (raw as Array).duplicate() if raw is Array else []

















func _club_rank_in_league(club_id: String) -> int:



	if Teams.by_id(club_id).is_empty():
		club_id = GameState.player_team_id
		if Teams.by_id(club_id).is_empty():
			return 0
	var div: int = GameState.div_of(club_id)





	var pais: String = Teams.country_of(club_id)
	var mine: int = Squad.strength(club_id)
	var rank: int = 0
	for t in GameState.teams_in_div(pais, div):
		var tid: String = String(t.get("id", ""))
		if tid == club_id:
			continue
		if Squad.strength(tid) > mine:
			rank += 1
	return rank

















func _club_rank_in_cup(club_id: String) -> Dictionary:
	var pais: String = Teams.country_of(club_id)
	var rondas: Array = FormatoCopa.plan(pais, FormatoCopa.COPA, GameState.cup_sembrado(pais),
		club_id).get("rondas", [])
	var mine: int = Squad.strength(club_id)
	var rank: int = 0
	var field: int = 0
	var entra: int = rondas.size()
	for r in rondas.size():
		for tid in (rondas[r] as Dictionary).get("nuevos", []):
			field += 1
			if String(tid) == club_id:
				entra = r
			elif Squad.strength(String(tid)) > mine:
				rank += 1
	return {"rank": rank, "field": maxi(field, 1), "rounds": rondas.size() - entra}






func _club_rank_in_euro(club_id: String, comp: String) -> Dictionary:
	var field: Array = []
	match comp:
		"ucl":
			field = GameState.ucl_field(GameState.UCL_FIELD)
		"eul":
			field = GameState.eul_field(GameState.EUL_FIELD)
		"lib", "sud", "cca", "ace", "ac2", "caf", "cf2", "ofc":



			for aid in GameState.amer_field(comp):
				field.append({"id": String(aid)})
		_:
			field = GameState.conf_field(GameState.CONF_FIELD)
	var mine: int = Squad.strength(club_id)
	var rank: int = 0
	for t in field:
		var tid: String = String(t.get("id", ""))
		if tid != club_id and Squad.strength(tid) > mine:
			rank += 1
	return {"rank": rank, "field": maxi(field.size(), 1)}






func _euro_comp_now() -> String:
	if GameState.qualified_ucl:
		return "ucl"
	if GameState.qualified_eul:
		return "eul"
	if GameState.qualified_conf:
		return "conf"




	var cupo: Dictionary = GameState._amer_tu_cupo()
	if not cupo.is_empty():
		return String(cupo.get("comp", ""))
	return ""














func _euro_rondas_meta(comp: String) -> int:
	if Continental.es_americana(comp):
		var kn: Array[String] = Continental.ko_names(comp)
		if not kn.is_empty():
			var playoff: int = 1 if kn[0] == GameState.UCL_KO_NAMES[0] else 0
			return maxi(kn.size() - playoff, 1)
	return GameState.UCL_KO_NAMES.size() - 1







const PALMARES_TITULO: int = 2
const PALMARES_SUBE: Array[String] = ["ucl", "eul", "conf", "top"]


func _assign_club_goals(club_id: String) -> void:
	club_goals = []








	var cid: String = club_id if not Teams.by_id(club_id).is_empty() \
			else GameState.player_team_id
	if cid.is_empty() or Teams.by_id(cid).is_empty():
		return
	club_id = cid
	var div: int = GameState.div_of(club_id)
	var teams_n: int = Teams.teams_in(Teams.country_of(club_id), div).size()
	if teams_n <= 1:
		teams_n = GameState.LEAGUE_SIZE





	var cuts: Dictionary = GameState.euro_qualification(1, 99,
		Teams.country_of(club_id), false, false, false, false, 1)













	var con_liguilla: bool = Liguilla.aplica(Teams.country_of(club_id), div) \
			and teams_n >= Liguilla.CLUBES_MIN
	var meta_liga: Dictionary = ClubGoals.league_goal(_club_rank_in_league(club_id), teams_n,
		div, [int(cuts.get("ucl_cut", 0)), int(cuts.get("eul_cut", 0)),
		int(cuts.get("conf_cut", 0))], ClubGoals.inertia_from(_club_expect)
		+ Duenos.sube(dueno_perfil(club_id)), con_liguilla)






	if div == 1 and not con_liguilla and champions_con(club_id) >= PALMARES_TITULO \
			and String(meta_liga.get("kind", "")) in PALMARES_SUBE:
		meta_liga = {"comp": "league", "kind": "title", "target": 1}
	club_goals.append(meta_liga)




	var copa: Dictionary = _club_rank_in_cup(club_id)
	if int(copa["rounds"]) > 0:
		club_goals.append(ClubGoals.knockout_goal("cup", int(copa["rank"]),
			int(copa["field"]), int(copa["rounds"])))
	var euro: String = _euro_comp_now()
	if not euro.is_empty():
		var eu: Dictionary = _club_rank_in_euro(club_id, euro)



		club_goals.append(ClubGoals.knockout_goal(euro, int(eu["rank"]),
			int(eu["field"]), _euro_rondas_meta(euro), true))


	_club_goals_avisadas = []
	if club_id == GameState.player_team_id and loan.is_empty():
		var cu: Dictionary = club_cuentas()
		if not cu.is_empty():
			var bg: Dictionary = ClubGoals.board_goal(int(cu.get("salud", 0)),
				String(cu.get("dueno", "")))
			if not bg.is_empty():
				club_goals.append(bg)





func _ensure_club_goals() -> void:
	if club_goals.is_empty() and not GameState.player_team_id.is_empty():
		_assign_club_goals(GameState.player_team_id)
	_sella_meta_previa()








func _sella_meta_previa() -> void:
	if not GameState.previas_vivas() or GameState.player_team_id.is_empty():
		return
	var donde: int = -1
	for i in club_goals.size():
		var g: Dictionary = club_goals[i]
		if not GameState.EURO_COMPS.has(String(g.get("comp", ""))):
			continue
		if g.has("entrada"):
			return
		donde = i
	var e: Dictionary = GameState._europa_tu_entrada()
	if donde >= 0:
		club_goals.remove_at(donde)
	else:

		donde = club_goals.size()
		for i in club_goals.size():
			if String(club_goals[i].get("comp", "")) == "board":
				donde = i
				break
	if e.is_empty():
		return
	var comp: String = String(PreviaUefa.COMP_JUEGO[String(e["comp"])])
	var ronda: String = String(e["ronda"])
	var cid: String = GameState.player_team_id
	var eu: Dictionary = _club_rank_in_euro(cid, comp)
	var meta: Dictionary = ClubGoals.knockout_goal(comp, int(eu["rank"]), int(eu["field"]),
		_euro_rondas_meta(comp), true)
	if ronda == "LP":
		meta["entrada"] = ronda
	else:


		var mine: int = Squad.strength(cid)
		var bombo: int = 0
		var mejores: int = 0
		var directos: int = 0
		for x in GameState.europa_cupos().get("clubes", []):
			if String(x["comp"]) != String(e["comp"]):
				continue
			if String(x["ronda"]) == "LP":
				directos += 1
				continue
			bombo += 1
			if String(x["id"]) != cid and Squad.strength(String(x["id"])) > mine:
				mejores += 1
		meta = ClubGoals.previa_goal(meta, mejores, bombo,
			maxi(GameState.UCL_FIELD - directos, 0), ronda)
	club_goals.insert(mini(donde, club_goals.size()), meta)





func club_goals_live() -> Array:
	_ensure_club_goals()
	var out: Array = []
	for g in club_goals:
		var comp: String = String(g.get("comp", "league"))
		var row: Dictionary = g.duplicate()
		match comp:
			"league":
				var pos: int = GameState.league_position()
				row["now"] = pos
				row["started"] = GameState.league_started()


				row["done"] = bool(row["started"]) and pos > 0 and pos <= int(g.get("target", 1))
				row["failed"] = false




				if GameState.liguilla_activa() and (bool(g.get("liguilla", false))
						or String(g.get("kind", "")) == "title"):



					var ls: Dictionary = GameState.liguilla_del_ano()
					var sembrada: bool = bool(ls["sembrada"])
					var kind_l: String = String(g.get("kind", ""))
					var ronda_l: int = int(ls["ronda"])
					row["done"] = sembrada and (bool(ls["champion"])
						if kind_l == "title"
						else ronda_l >= ClubGoals.liguilla_need(kind_l))
					row["failed"] = sembrada and not bool(row["done"]) \
							and not bool(ls["viva"])


					row["liguilla_vivo"] = true
					row["sembrada"] = sembrada
					row["ronda"] = ronda_l
			"board":



				var cu: Dictionary = club_cuentas()
				row["now"] = int(cu.get("salud", 0))
				row["started"] = true
				row["done"] = false
				row["failed"] = false
			"cup":
				row["now"] = int(GameState.cup_state.get("idx", 0))
				row["rounds"] = _club_goal_rounds(g)
				row["done"] = bool(GameState.cup_state.get("champion", false)) \
						or int(row["now"]) >= int(g.get("target", 1))



				row["failed"] = not bool(GameState.cup_state.get("alive", true)) \
						and not bool(row["done"])
			_:
				var st: Dictionary = GameState.euro_state(comp)
				var won: int = GameState.euro_rounds_won(comp)
				row["now"] = won
				row["rounds"] = _club_goal_rounds(g)
				row["advanced"] = bool(st.get("advanced", false))
				var vivo: Dictionary = {
					comp + "_champion": bool(st.get("champion", false)),
					comp + "_advanced": bool(st.get("advanced", false)),
					comp + "_won_rounds": won,
					"played_" + comp: bool(st.get("playing", false)),
				}


				if g.has("entrada"):
					vivo.merge(GameState.europa_resumen_previas())
					var pv: Dictionary = st.get("previa", {})
					row["previa_ronda"] = String(pv.get("ronda", "")) \
							if bool(st.get("playing", false)) else ""
					if String(g.get("kind", "")) == "previa":
						row["now"] = int(vivo.get(comp + "_previa_won", 0))
				row["done"] = ClubGoals.met(g, vivo)
				row["failed"] = not bool(st.get("alive", true)) and not bool(row["done"])
		out.append(row)
	return out





func _club_goal_rounds(goal: Dictionary) -> int:
	var comp: String = String(goal.get("comp", "cup"))
	if comp == "cup":
		var n: int = int((GameState.cup_state.get("names", []) as Array).size())
		return n if n > 0 else GameState.CUP_NAMES.size()
	var kn: int = int((GameState.euro_state(comp).get("ko_names", []) as Array).size())
	return maxi(kn - 1, 1) if kn > 0 else GameState.UCL_KO_NAMES.size() - 1













func _club_goals_report(result: Dictionary) -> Array:
	var out: Array = []
	for g in club_goals:
		var row: Dictionary = g.duplicate()
		row["met"] = ClubGoals.met(g, result)
		out.append(row)
	return out


















const OBJ_DELIVERY_CAP: float = 2.5

func _seal_season_memory() -> void:
	_obj_delivery = 0.0
	_obj_out_bias = 0.0
	if free_agent or not loan.is_empty():
		return
	var typ: String = String(contract.get("obj_type", ""))
	var target: int = objective_target_judged()
	if not typ.is_empty() and typ != "position" and target > 0:
		_obj_delivery = clampf(float(int(contract.get("obj_progress", 0)))
			/ float(target), 0.0, OBJ_DELIVERY_CAP)




	var prod: int = season_goals + season_assists
	if prod >= BIAS_MIN_PROD:
		_obj_out_bias = clampf(float(season_assists - season_goals) / float(prod),
			-1.0, 1.0)




const BIAS_MIN_PROD: int = 6








func objective_trend() -> int:
	if _obj_delivery <= 0.0:
		return 0
	var m: float = Market.delivery_scale(_obj_delivery)
	if m > 1.001:
		return 1
	return -1 if m < 0.999 else 0





const CLUB_BONUS_SHARE: float = 0.5





func prima_club_tope() -> int:
	if not loan.is_empty() or free_agent or club_goals_live().is_empty():
		return 0
	return roundi(float(int(contract.get("obj_bonus", 0))) * CLUB_BONUS_SHARE)




const CLUB_FIRE_GAP: int = 5


const CLUB_FIRE_MISSED: int = 2
















func _judge_club_goals(result: Dictionary, lines: Array[String]) -> void:
	_club_goals_score = 0.0
	if GameState.player_team_id.is_empty() or retired:
		return
	_ensure_club_goals()
	if club_goals.is_empty():
		return



	var cu_cierre: Dictionary = club_cuentas()
	if not cu_cierre.is_empty():
		result["salud"] = int(cu_cierre.get("salud", 0))
	var score: float = ClubGoals.season_score(club_goals, result)
	_club_goals_score = score
	var gap: int = ClubGoals.league_gap(club_goals, result)


	var salva: int = ClubGoals.salvacion(club_goals, result)





	var cid_e: String = GameState.player_team_id
	_club_expect = ClubGoals.update_expectation(_club_expect,
		ClubGoals.league_delta(_club_rank_in_league(cid_e),
			maxi(int(result.get("teams", GameState.LEAGUE_SIZE)), 4), result))








	var arraigo: int = Coach.arraigo(coach_nivel())
	var habria_caido: bool = gap >= CLUB_FIRE_GAP + arraigo - CLUB_FIRE_MISSED \
			or (gap > 0 and _club_goals_missed + 1 >= arraigo)





	if gap <= 0 or salva == ClubGoals.SALVA:
		_club_goals_missed = 0
	elif salva == ClubGoals.NADA:
		_club_goals_missed += 1



	if score > 0.0 and loan.is_empty() and not free_agent:
		var extra: int = con_doble_paga(roundi(float(int(contract.get("obj_bonus", 0)))
			* CLUB_BONUS_SHARE * score))

		if extra > 0:
			money += extra
			_apunta_ingreso("club", extra)


	var swing: int = roundi((score - 0.5) * 16.0)


	rel["aficion"] = clampi(int(rel["aficion"])
		+ roundi(Gerencia.grada_fiel(float(swing), peldano())), 0, 100)
	rel["prensa"] = clampi(int(rel["prensa"]) + swing, 0, 100)













	var cae: bool = false
	if bool(result.get("relegated", false)):
		cae = true
	elif salva != ClubGoals.NADA:
		cae = false
	else:
		cae = habria_caido


	var pedido: bool = _pide_dt_resuelve(cae, false)

	var cesado: bool = not pedido and _pide_cese_resuelve(cae, false)
	if pedido:
		_club_goals_missed = 0
		lines.append(I18n.tf("El club te hace caso: llega {0} al banquillo",
			[String(pide_dt_ultimo().get("name", ""))]))
	elif cesado:
		_club_goals_missed = 0
		lines.append(I18n.t("El club te hace caso: destituye al técnico"))
	elif cae:
		_club_goals_missed = 0
		lines.append(I18n.t("El club destituye al técnico"))


		_replace_coach()
	elif salva == ClubGoals.SALVA and habria_caido:


		lines.append(I18n.t("Las copas le salvan el puesto al técnico"))
	elif salva == ClubGoals.CERCA and habria_caido:


		lines.append(I18n.t("El club le mantiene la confianza al técnico"))


	if score < 0.5 and _obj_missed == 0:
		_club_flop_boost = true






	if loan.is_empty() and not free_agent:
		if score >= CLUB_ANO_BUENO:
			_apply_delta("tecnico", CLUB_ANO_TECNICO, REL_BRAKE_EXP_DECISION)
			_apply_delta("equipo", CLUB_ANO_EQUIPO, REL_BRAKE_EXP_DECISION)
			lines.append(I18n.t("Año redondo del club: el técnico cuenta más contigo"))
		elif score < CLUB_ANO_MALO and _obj_missed > 0:
			_apply_delta("tecnico", - CLUB_ANO_TECNICO, REL_BRAKE_EXP_DECISION)
			lines.append(I18n.t("Año para olvidar: el club escucharía ofertas por ti"))





const CLUB_ANO_BUENO: float = 0.75
const CLUB_ANO_MALO: float = 0.25
const CLUB_ANO_TECNICO: float = 3.0
const CLUB_ANO_EQUIPO: float = 2.0








func _revisa_metas_invierno() -> void:
	if _club_goals_revisada == GameState.season_num:
		return
	_club_goals_revisada = GameState.season_num
	if GameState.player_team_id.is_empty() or not GameState.league_started() \
			or not loan.is_empty() or free_agent:
		return
	_ensure_club_goals()
	var cid: String = GameState.player_team_id
	var div: int = GameState.div_of(cid)
	var teams_n: int = Teams.teams_in(Teams.country_of(cid), div).size()
	if teams_n <= 1:
		teams_n = GameState.LEAGUE_SIZE
	var cuts: Dictionary = GameState.euro_qualification(1, 99,
		Teams.country_of(cid), false, false, false, false, 1)
	var slots: Array = [int(cuts.get("ucl_cut", 0)), int(cuts.get("eul_cut", 0)),
		int(cuts.get("conf_cut", 0))]
	for i in club_goals.size():
		var g: Dictionary = club_goals[i]
		var nueva: Dictionary = ClubGoals.revision(g, GameState.league_position(),
			teams_n, div, slots)
		if nueva.is_empty():
			continue
		club_goals[i] = nueva
		var sube: bool = String(nueva["revision"]) == ClubGoals.REVISION_SUBE
		var fila: Dictionary = WorldNews.fila_directiva(GameState.season_num - 1,
			GameState.season_day, cid, WorldNews.DIRECTIVA_SUBE if sube
			else WorldNews.DIRECTIVA_BAJA, int(nueva.get("target", 1)))
		if not fila.is_empty():
			_push_world_news([fila])
		return







const CLUB_KO_PRENSA: float = 6.0

func _vigila_metas_ko() -> bool:
	if GameState.player_team_id.is_empty() or club_goals.is_empty() or retired:
		return false
	var canto: bool = false
	for row in club_goals_live():
		var comp: String = String(row.get("comp", ""))
		if comp in ["league", "board"] or not bool(row.get("failed", false)) \
				or _club_goals_avisadas.has(comp):
			continue
		_club_goals_avisadas.append(comp)
		canto = true
		var golpe: int = roundi(CLUB_KO_PRENSA * float(ClubGoals.WEIGHTS.get(comp, 0.15)))
		rel["prensa"] = clampi(int(rel["prensa"]) - maxi(golpe, 1), 0, 100)
		var fila: Dictionary = WorldNews.fila_directiva(GameState.season_num - 1,
			GameState.season_day, GameState.player_team_id, WorldNews.DIRECTIVA_KO, 0, comp)
		if not fila.is_empty():
			_push_world_news([fila])
	return canto


func club_goal_at_risk() -> Dictionary:
	if GameState.player_team_id.is_empty() or not GameState.league_started():
		return {}
	if GameState.season_progress() < OBJ_RISK_FROM:
		return {}
	_ensure_club_goals()
	for g in club_goals:
		if String(g.get("comp", "")) != "league":
			continue
		var pos: int = GameState.league_position()





		var corte: int = int(g.get("target", 1))
		if GameState.liguilla_activa() and (bool(g.get("liguilla", false))
				or String(g.get("kind", "")) == "title"):


			var ls: Dictionary = GameState.liguilla_del_ano()
			var kind_l: String = String(g.get("kind", ""))
			if bool(ls["sembrada"]) and (bool(ls["champion"]) if kind_l == "title"
					else int(ls["ronda"]) >= ClubGoals.liguilla_need(kind_l)):
				continue
			corte = Liguilla.CLUBES_MIN
			pos = GameState.torneo_position()


		if pos > 0 and pos > corte:
			var out: Dictionary =(g as Dictionary).duplicate()
			out["pos"] = pos
			return out
	return {}










