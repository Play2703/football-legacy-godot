func gerencia_renueva_motivo(idx: int, nombre: String) -> String:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent:
		return "club"
	if peldano() < Gerencia.PELDANO_MESA:
		return "peldano"
	if transfer_requested:
		return "pediste"
	var sq: Array = Squad.of(mio)
	if idx == Squad.home_seat(sq, Squad.user_index(sq)):
		return "yo"
	if gerencia_renueva_pedida(idx, nombre):
		return ""
	if concurso_tuyo():
		return "concurso"
	var seat: Dictionary = _gerencia_asiento(idx, nombre)
	if seat.is_empty():
		return "club"
	if not String(seat.get("pre", "")).is_empty():
		return "pre"
	if not bool(seat.get("se_va", false)) and int(seat.get("contract", 3)) > 2:
		return "contrato"
	if gerencia_renueva_lista().size() >= Gerencia.RENUEVA_MAX:
		return "lleno"
	return ""



func gerencia_pon_renueva(idx: int, nombre: String) -> bool:
	var mio: String = GameState.player_team_id
	var vivas: Array = gerencia_renueva_lista()
	for i in vivas.size():
		if int(vivas[i]["idx"]) == idx and String(vivas[i]["name"]) == nombre:
			vivas.remove_at(i)
			gerencia["renueva"] = vivas.map(func(v): return {"club": mio,
				"idx": int(v["idx"]), "name": String(v["name"])})
			_save()
			changed.emit()
			return true
	if not gerencia_renueva_motivo(idx, nombre).is_empty():
		return false
	_gerencia_cobra("renueva_veterano", gerencia_renueva_coste(idx, nombre))
	vivas.append({"idx": idx, "name": nombre})
	gerencia["renueva"] = vivas.map(func(v): return {"club": mio,
		"idx": int(v["idx"]), "name": String(v["name"])})
	Telemetry.count("renueva_pide")
	_save()
	changed.emit()
	return true



