func _fx_de_ella(e: Dictionary, fx: Dictionary) -> Dictionary:
	if not pareja_activa() or not fx.has("rel"):
		return fx
	var rels: Dictionary = fx["rel"]
	var nuevo: Dictionary = PAREJA.rel_de_escena(String(pareja.get("id", "")), e, rels)
	if is_same(nuevo, rels):
		return fx
	var out: Dictionary = fx.duplicate(true)
	out["rel"] = nuevo
	return out


func _personalize(e: Dictionary) -> Dictionary:
	var names: Array = e.get("names", [])
	if names.is_empty():
		return e
	var args: Array = []
	for k in names:
		match String(k):
			"rival":
				args.append(String(rival_striker_info().get("name", "")))




			"derbi":
				args.append(Competitions.demarca(String(
					Teams.by_id(String(GameState.next_fixture()
						.get("opp", ""))).get("name", ""))))
			"capitan":
				args.append(captain_name())

			"lanzador":
				args.append(_taker_name("penal", GameState.player_team_id))

			"pos_fav":
				args.append(I18n.t(pos_fav))







			"socio":
				var top: Array = socios_top(1)
				_socio_escena = "" if top.is_empty() \
						else String((top[0] as Dictionary)["name"])
				args.append("" if _socio_escena.is_empty() \
						else CareerUi.display_name(CareerUi.surname(_socio_escena)))
			"dorsal":
				args.append(_coveted_shirt_owner())



			"puesto_nuevo":
				_pos_pedido = puesto_que_te_pide()




				args.append(CareerUi.pos_rotulo(_pos_pedido))




			"pareja":
				args.append(pareja_nombre().split(" ", false)[0] \
						if not pareja_nombre().is_empty() else "")




			"candidata":
				args.append(pareja_candidata_nombre().split(" ", false)[0] \
						if not pareja_candidata_nombre().is_empty() else "")



			"ex":
				args.append(pareja_ex_nombre().split(" ", false)[0] \
						if not pareja_ex_nombre().is_empty() else "")






			"rival_prox":
				var vivo: bool = not week_event_club.is_empty() \
						and WeekEvents.prensa_vigente(e, week_event_club)
				args.append(Competitions.demarca(str(Teams.by_id(week_event_club)
					.get("name", ""))) if vivo else "")
			"tecnico_rival":
				args.append(Coaches.name_of(week_event_club))
			"fichaje_rival":
				var fich: String = WeekEvents.fichaje_estrella(week_event_club)
				args.append(CareerUi.display_name(fich) if not fich.is_empty() else "")
			"campeon_pais":
				var camp: String = WeekEvents.campeon_de_casa(false)
				args.append(Competitions.demarca(str(Teams.by_id(camp).get("name", ""))) \
						if not camp.is_empty() else "")
			_:
				args.append("")




	for a in args:
		if String(a).is_empty():
			return {}
	var out: Dictionary = e.duplicate(true)



	out["desc"] = I18n.tf(WeekEvents.desc_por_fama(e, prensa_escalon()), args)
	out["title"] = I18n.tf(String(e.get("title", "")), args)
	for key in ["a", "b", "c"]:
		if out.has(key):
			var opt: Dictionary = out[key]
			opt["label"] = I18n.tf(String(opt.get("label", "")), args)
			if opt.has("fx"):
				opt["fx"] = _fx_de_ella(e, opt["fx"])
	return out













func _court_cost_waived(fx: Dictionary) -> bool:
	var courts: bool = bool(fx.get("court", false)) \
			or int(fx.get("court_slot", 0)) > 0 or bool(fx.get("rumor_fan", false))
	return courts and (for_sale or forced_sale or unsettled)
















func _cobra_fx_decision(fx: Dictionary, club: String, risk_roll: float = -1.0) -> String:
	if bool(fx.get("rumor_fan", false)):
		if courting_club.is_empty():
			courting_club = club
	if bool(fx.get("rumor_cut", false)):
		_market_rumors.erase(club)
	if bool(fx.get("palabra", false)):
		_da_palabra()
	if _court_cost_waived(fx):
		fx = fx.duplicate(true)
		fx.erase("rel")
	return _apply_event_fx(fx, risk_roll)


