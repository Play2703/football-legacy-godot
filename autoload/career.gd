	entry["season"] = int(entry.get("season", anio_vivo()))
	if not entry.has("club"):
		entry["club"] = GameState.player_team_id
	pending_ceremonies.append(entry)
	pending_ceremonies = Ceremonies.sort_queue(pending_ceremonies)








func idolo_escena_temporada_libre(season: int) -> bool:
	if idolo.is_empty():
		return false
	if season <= int(idolo.get("season", 0)):
		return false
	for k: String in idolo_escenas:
		if k.begins_with("_") or IdoloEscenas.FUERA_DEL_TOPE.has(k):
			continue
		if int(idolo_escenas[k]) == season:
			return false
	return true









