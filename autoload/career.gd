func rasgos_ctx() -> Dictionary:
	var f: Dictionary = GameState.current_fixture()
	var out: Dictionary = {}
	for r in rasgos_en_juego(String(f.get("comp", "")) == "nat"):
		var efecto: Dictionary = Coach.RASGO_PARTIDO.get(r, {})
		match String(efecto.get("solo", "")):
			"derbi":
				if not is_derby(String(f.get("opp", ""))):
					continue
			"fuera":

				if bool(f.get("home", true)) or Competitions.is_neutral(f):
					continue
		for k in efecto:
			match String(k):
				"solo":
					pass
				"parado":
					out[k] =(efecto[k] as Array).duplicate()
				"dieta", "tramos":
					out[k] =(out.get(k, []) as Array) +(efecto[k] as Array)
				"ocasiones":
					out[k] = int(out.get(k, 0)) + int(efecto[k])
				"primera":
					out[k] = maxi(int(out.get(k, 0)), int(efecto[k]))
				_:
					out[k] = float(out.get(k, 1.0)) * float(efecto[k])
	return out















