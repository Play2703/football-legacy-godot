func _stadium_honor_reason(club_id: String) -> String:
	if club_id.is_empty() or not stadium_rename_club.is_empty():
		return ""
	if not stadium_honor_clubs.is_empty():
		return ""
	if _user_club_rank(club_id) != 1:
		return ""
	if club_seasons(club_id).size() < STADIUM_HONOR_SEASONS:
		return ""
	var elite: Dictionary = your_club_titles(club_id)
	if Legacy.is_club_immortal(int(elite["total"]), 1, int(elite["cont"])):
		return "inmortal"


	var all: Dictionary = your_club_titles(club_id, false)
	var mine: int = int(all["total"]) + int(all["ascensos"])
	if mine < STADIUM_HITO_MIN:
		return ""
	var h: Dictionary = Palmares.historic(club_id)
	var theirs: int = int(h["liga"]) + int(h["copa"]) + int(h["champions"])
	return "hito" if mine >= theirs else ""










