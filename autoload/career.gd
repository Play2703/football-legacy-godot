const LAST_TITLE_ORDER: Array[String] = ["champions", "clubes", "liga", "copa",
	"europa", "sudamericana", "conference"]

func last_titles_of(club_id: String, cap: int = 4) -> Array:
	if club_id.is_empty():
		return []
	var won: Array = last_season_titles.get(club_id, [])
	if won.is_empty():
		return []
	var out: Array = []


	for k in LAST_TITLE_ORDER:
		for w in won:
			if String(w) != k:
				continue
			out.append(k)
			if out.size() >= cap:
				return out
	return out








