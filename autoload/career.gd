func _oferta_por_clausula_del_balon(vetados: Array) -> void:
	if last_ballon != 1 or on_loan() or free_agent or int(contract.get("clause", 0)) <= 0:
		return
	if Market.window_id(GameState.season_day, GameState.winter_day()) != Market.WINDOW_SUMMER:
		return
	var en_mesa: Array = []
	for o in pending_offers:
		en_mesa.append(String(o.get("id", "")))
	var mejor: Dictionary = {}
	for c in Market.candidates(scout_profile(), GameState.player_team_id, 0.0, false):
		var cid: String = String(c.get("id", ""))
		if vetados.has(cid) or en_mesa.has(cid):
			continue
		if mejor.is_empty() or int(c.get("rating", 0)) > int(mejor.get("rating", 0)):
			mejor = c
	if mejor.is_empty():
		return
	var clausula: int = int(contract["clause"])
	mejor["fee"] = maxi(int(mejor.get("fee", 0)), clausula)
	mejor["bid"] = clausula
	mejor["clausulazo_balon"] = true
	mejor["deal_told"] = true
	pending_offers.insert(0, mejor)



	queue_ceremony(Ceremonies.CARA_A_CARA, {
		"mode": "presidente",
		"pretendiente": Competitions.demarca(String(mejor.get("name", ""))),
		"clausula": clausula,
		"temporadas": club_seasons(GameState.player_team_id).size(),
		"balones": balones_de_oro(),
		"age": age,
	})







