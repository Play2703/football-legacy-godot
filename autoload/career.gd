const EX_TUNEL_TEMPORADAS: int = 2




























func ex_en_el_tunel(rival_id: String) -> Dictionary:
	if rival_id.is_empty() or GameState.player_team_id.is_empty():
		return {}
	var yo: Dictionary = TransferBook.trayectoria_propia(start_club, transfers,
		GameState.player_team_id, not loan.is_empty())
	yo["club"] = GameState.player_team_id
	var plantel: Array = Squad.of(rival_id)
	var ex: Dictionary = EX_COMPANERO.de_plantel(rival_id, plantel, yo,
		GameState.season_num)
	var aptos: Dictionary = {}
	for seat in ex:
		var e: Dictionary = ex[seat]
		var i: int = int(e.get("i", Squad.STARTING_XI))
		if i < 0 or i >= Squad.STARTING_XI or i >= plantel.size():
			continue
		if int(e.get("temporadas", 0)) < EX_TUNEL_TEMPORADAS:
			continue
		var fila: Dictionary = plantel[i]
		if not Legends.clave_activa(fila).is_empty():
			continue
		if ex_tunel_vistos.has(_ex_tunel_llave(String(e.get("nombre", "")),
				String(e.get("club", "")))):
			continue
		aptos[seat] = e
	var elegido: Dictionary = EX_COMPANERO.del_once(aptos)
	if elegido.is_empty():
		return {}
	var fila_el: Dictionary = plantel[int(elegido["i"])]
	var crudo: String = String(elegido.get("nombre", ""))
	var pintado: String = Competitions.demarca(crudo)
	return {"name": crudo, "nombre": pintado, "apellido": Espalda.apellido_de(pintado),
		"cara": crudo, "number": int(fila_el.get("number", 0)),
		"pos": String(fila_el.get("pos", "")),
		"temporadas": int(elegido.get("temporadas", 0)),
		"club_juntos": String(elegido.get("club", "")),
		"desde": int(elegido.get("desde", 0)), "hasta": int(elegido.get("hasta", 0)),
		"llave": _ex_tunel_llave(crudo, String(elegido.get("club", "")))}






static func _ex_tunel_llave(nombre: String, club_juntos: String) -> String:
	return "%s|%s" % [nombre, club_juntos]
















func _maybe_ex_en_el_tunel() -> void:
	if _ex_tunel_seen == GameState.season_num or not _pre_match_act_ok():
		return
	if GameState.tutorial_active or not GameState.practice_kind.is_empty():
		return
	var fx: Dictionary = GameState.current_fixture()
	if fx.is_empty() or String(fx.get("comp", "")) == "nat":
		return
	var opp: String = String(fx.get("opp", ""))
	if opp.is_empty() or is_derby(opp) or _is_final(fx):
		return
	if _ex_tunel_aplazo == GameState.matches_played:
		return


	var ex: Dictionary = ex_en_el_tunel(opp)
	if ex.is_empty():
		return
	if not pending_ceremonies.is_empty():
		_ex_tunel_aplazo = GameState.matches_played
		return
	_ex_tunel_seen = GameState.season_num
	ex_tunel_vistos.append(String(ex["llave"]))
	var payload: Dictionary = ex.duplicate()
	payload.erase("llave")
	payload.merge({
		"club": GameState.player_team_id,
		"div": GameState.player_div(),
		"opp": opp,
		"home": bool(fx.get("home", true)),



		"n": ex_tunel_vistos.size(),
	})
	queue_ceremony(Ceremonies.EX_TUNEL, payload)
	_save()












