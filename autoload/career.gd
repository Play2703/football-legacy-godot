func leyenda_en_club(club_id: String) -> String:
	if club_id.is_empty():
		return ""
	var mejor: String = ""
	var mejor_i: int = 1<<30
	for p in Squad.of(club_id):
		var key: String = Legends.clave_activa(p as Dictionary)
		if key.is_empty():
			continue
		if String(Legends.asiento_de(key).get("team", "")) != club_id:
			continue
		for i in Legends.ALL.size():
			if String((Legends.ALL[i] as Dictionary).get("name", "")) == key:
				if i < mejor_i:
					mejor_i = i
					mejor = key
				break
	return mejor












