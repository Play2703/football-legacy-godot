func xp_needed() -> int:
	return xp_needed_at(level)






static func xp_needed_at(lvl: int) -> int:
	var l: int = maxi(lvl, 1)
	return (72 + l * 24 + l * l * 8 / 25) * 4 / 5


func add_xp(amount: int) -> void:
	xp += amount
	while xp >= xp_needed():
		xp -= xp_needed()
		level += 1




		if not skills_maxed():
			skill_points += SKILL_POINTS_PER_LEVEL
		leveled_up.emit(level)
	changed.emit()




const SKILL_CAP: int = 99

















const SKILL_TOPE_EDAD: Array = []










const SIGUEN_SUBIENDO: Array[String] = ["vision", "penal", "parado"]



func skill_en_declive(skill: String) -> bool:
	if skill.is_empty() or SIGUEN_SUBIENDO.has(skill):
		return false
	if WorldAging.FISICAS.has(skill):
		return age >= int(DECLINE_FIS.keys().min())
	if SKILL_KEYS.has(skill):
		return age >= int(DECLINE_TEC.keys().min())
	return false





func skill_tope(skill: String = "") -> int:
	if skill_en_declive(skill):
		return mini(SKILL_CAP, int(skills.get(skill, SKILL_CAP)))
	for par in SKILL_TOPE_EDAD:
		if age <= int(par[0]):
			return int(par[1])
	return SKILL_CAP




func skills_maxed() -> bool:
	for k in skills:
		if int(skills[k]) < SKILL_CAP:
			return false
	return true















func xp_for_skill_points(pts: int) -> int:
	if pts <= 0:
		return 0
	return maxi(1, xp_needed() * pts / SKILL_POINTS_PER_LEVEL)








func drain_skill_points() -> int:
	if skill_points <= 0 or not skills_maxed():
		return 0
	var pts: int = skill_points
	skill_points = 0
	var gain: int = xp_for_skill_points(pts)
	add_xp(gain)
	return gain










func grant_skill_points(pts: int) -> int:
	if pts <= 0:
		return 0
	skill_points += pts
	return drain_skill_points()





