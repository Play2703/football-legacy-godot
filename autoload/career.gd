func note_nemesis(club: String, who: String) -> void:
	if club == "" or who.strip_edges().is_empty() or not is_derby(club):
		return
	if String(nemesis.get("club", "")) != club:
		nemesis = {"club": club, "name": who, "goals": 1, "tally": {who: 1}, "orden": [who]}
		return
	var tally: Dictionary = _nemesis_tally(nemesis)
	var n: int = int(tally.get(who, 0)) + 1
	tally[who] = n




	var orden: Array = _nemesis_orden(nemesis, tally)
	orden.erase(who)
	orden.append(who)
	nemesis["tally"] = tally
	nemesis["orden"] = orden
	var lider: Dictionary = _nemesis_lider(tally, orden, {})
	nemesis["name"] = String(lider.get("name", who))
	nemesis["goals"] = int(lider.get("goals", n))














func nemesis_at(club: String) -> Dictionary:
	if club == "" or String(nemesis.get("club", "")) != club:
		return {}
	var tally: Dictionary = _nemesis_tally(nemesis)
	var lider: Dictionary = _nemesis_lider(tally, _nemesis_orden(nemesis, tally),
		_nombres_de_mi_club())
	if String(lider.get("name", "")).is_empty():
		return {}





	if int(lider.get("goals", 0)) < NEMESIS_MIN_GOLES:
		return {}
	return {"club": club, "name": String(lider["name"]), "goals": int(lider["goals"])}







static func _nemesis_tally(d: Dictionary) -> Dictionary:
	var t: Variant = d.get("tally", null)
	if t is Dictionary:
		return (t as Dictionary).duplicate()
	var out: Dictionary = {}
	var nom: String = String(d.get("name", ""))
	var g: int = int(d.get("goals", 0))
	if not nom.strip_edges().is_empty() and g > 0:
		out[nom] = g
	return out





static func _nemesis_orden(d: Dictionary, tally: Dictionary) -> Array:
	var o: Variant = d.get("orden", null)
	if o is Array:
		return (o as Array).duplicate()
	var out: Array = []
	var nom: String = String(d.get("name", ""))
	for k in tally:
		if String(k) != nom:
			out.append(String(k))
	if tally.has(nom):
		out.append(nom)
	return out








static func _nemesis_lider(tally: Dictionary, orden: Array, fuera: Dictionary) -> Dictionary:
	var fila: Array = []
	for k in tally:
		if not orden.has(String(k)):
			fila.append(String(k))
	for k in orden:
		if tally.has(String(k)) and not fila.has(String(k)):
			fila.append(String(k))
	var best: String = ""
	var best_g: int = 0
	for nom in fila:
		var g: int = int(tally[nom])
		if g <= 0 or fuera.has(nom):
			continue
		if g >= best_g:
			best = nom
			best_g = g
	if best.is_empty():
		return {}
	return {"name": best, "goals": best_g}




