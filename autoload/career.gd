		return 0
	var sello: String = "reto_" + kind
	if house_used_now().has(sello):
		return 0
	house_used = house_used_now().duplicate()
	house_used.append(sello)
	house_used_stamp = _house_week_stamp()
	var antes: int = int(rel["equipo"])



