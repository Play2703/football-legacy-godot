	if int(archivado[0]) > 0:
		return archivado
	var pais: String = Teams.country_of(club_id)
	if pais.is_empty():
		return [0, 0]

	var t: Array = SimLeague.table(pais, div, maxi(GameState.season_num - 1, 0))
