func pide_dt_prob() -> float:
	var req: Dictionary = pide_dt()
	if req.is_empty():
		return 0.0
	var f: Dictionary = _pide_dt_fila(String(req["id"]))
	if f.is_empty() or not pide_dt_motivo(f).is_empty():
		return 0.0
	return _pide_dt_p(f)


func _pide_dt_p(f: Dictionary) -> float:
	var niv: int = coach_nivel()
	var presion: float = Coach.p_invierno(_coach_ctx(), niv,
		coach_desde == GameState.season_num)
	return Gerencia.prob_pide_dt(
		maxi(Gerencia.relacion_sin_tecnico(gerencia_ctx()) - gerencia_deuda()
			- gerencia_cobros(), 0),
		int(f.get("nivel", niv)) - niv, not String(f.get("club", "")).is_empty(),
		presion, is_captain, pide_dt_palmares(f), pide_dt_encaje(f))





func pide_dt_palmares(f: Dictionary) -> int:
	var suyo: Dictionary = f.get("trofeos", {}) if f.has("trofeos") \
			else CoachMarket.trofeos_de(String(f.get("id", "")))
	var tuyo: Dictionary = CoachMarket.trofeos_de(Coaches.id_of(GameState.player_team_id))
	return Coach.puntos_trofeos(suyo) - Coach.puntos_trofeos(tuyo)





func pide_dt_encaje(f: Dictionary) -> float:
	var suya: String = String(CoachMarket.detalle(f).get("idea", ""))

	if suya.is_empty() and not String(f.get("org", "")).is_empty():
		suya = Coaches.idea_de(String(f["org"]), int(f.get("term", 1)))
	var tuya: String = Coaches.idea_of(GameState.player_team_id)
	if suya.is_empty() or suya == tuya:
		return 0.0
	return _encaje_plantilla(suya) - _encaje_plantilla(tuya)


func _encaje_plantilla(idea: String) -> float:
	var club: String = GameState.player_team_id
	var squad: Array = Squad.of_nominal(club)
	var meta: Array = _ensure_squad_meta(club, squad)
	var orden: Array = []
	for i in mini(squad.size(), meta.size()):
		var s: Dictionary = squad[i]
		orden.append([SquadMeta.media_of(s, String(s.get("pos", "MC"))),
			int((meta[i] as Dictionary).get("age", 25))])
	orden.sort_custom(func(a: Array, b: Array) -> bool: return int(a[0]) > int(b[0]))
	var n: int = mini(orden.size(), Squad.STARTING_XI)
	if n <= 0:
		return 0.0
	var suma: float = 0.0
	for k in n:
		suma += Coach.encaje_edad(idea, int(orden[k][1]))
	return suma / float(n)







func _pide_dt_resuelve(cae: bool, invierno: bool) -> bool:
	var req: Dictionary = pide_dt()
	gerencia.erase("pide_dt")
	if req.is_empty():
		return false
	var id: String = String(req["id"])
	var f: Dictionary = _pide_dt_fila(id)
	var sale: String = "no_cae" if cae else "no"
	if f.is_empty() or not pide_dt_motivo(f).is_empty():
		sale = "ya_no"
	elif not invierno and _pide_dt_recien_sentado(f):



		sale = "ya_no"
	else:
		var p: float = _pide_dt_p(f)
		if cae:
			p = maxf(p, Gerencia.DT_CAE_P)


		var rng := RandomNumberGenerator.new()
		rng.seed = hash("pidedt|%d|%s|%s" % [GameState.season_num, id, str(invierno)])
		if rng.randf() < p:
			sale = "si"
	if sale == "si":
		if invierno:
			_apunta_campana_liga()
		_replace_coach(_pide_dt_saca(f), invierno)
		rel["tecnico"] = clampi(int(rel["tecnico"]) + Gerencia.DT_DEBE, 0, 100)
	elif sale == "no":
		rel["tecnico"] = clampi(int(rel["tecnico"]) - Gerencia.DT_CASTIGO, 0, 100)
	gerencia["pide_dt_ult"] = {"name": String(req.get("name", "")), "sale": sale,
		"season": GameState.season_num, "club_mio": GameState.player_team_id}
	Telemetry.count("pide_dt_" + sale)
	return sale == "si"






func _pide_dt_saca(f: Dictionary) -> Dictionary:
	var sitio: Dictionary = _pide_dt_sitio(f)
	if sitio.has("paro"):
		var e: Array = coach_paro[int(sitio["paro"])]
		coach_paro.remove_at(int(sitio["paro"]))
		return {"club": String(e[0]), "term": int(e[1]),
			"cred": int(e[4]) if e.size() > 4 else 0}
	if sitio.has("ficha"):
		return {"ficha": sitio["ficha"]}
	var club: String = String(sitio.get("club", ""))
	if club.is_empty():
		return {}
	_fija_nombre(club)
	var h: Dictionary = Coaches._hombre(club)
	if Coach.es_nat(club):


		var pais: String = Coach.pais_nat(club)
		var sn: Dictionary = Coaches.seat(club)
		nat_seats[pais] = Coaches.fila_nat(int(sn.get("mandato", Coaches.TERM_BASE)) + 1,
			GameState.season_num)
		Coaches.bump()
		return {"club": String(h["org"]), "term": int(h["term"]), "cred": int(h["cred"])}
	var raw: Variant = coach_seats.get(club, null)
	var mandato: int = int((raw as Array)[0]) \
			if raw is Array and (raw as Array).size() >= 1 else Coaches.TERM_BASE
	coach_seats[club] = Coaches.fila(mandato + 1, GameState.season_num, 0, "", 0)
	if h["ficha"] != null:
		return {"ficha": h["ficha"]}
	return {"club": String(h["org"]), "term": int(h["term"]), "cred": int(h["cred"])}









