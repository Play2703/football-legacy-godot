func _cierra_motivo_firma(offer: Dictionary, cobrar: bool = true) -> Dictionary:
	if not salida_motivo.has(Salida.VIA_TRASPASO):
		return {}
	if forced_sale:
		_cierra_motivo(Salida.VIA_TRASPASO, Salida.ANULADO)
		return {}
	var dest: String = String(offer.get("id", ""))
	var rec: Dictionary = Dictionary(salida_motivo[Salida.VIA_TRASPASO])


	var estado: String = Salida.veredicto(rec,
		Standing.contract_role_from_key(String(offer.get("role", "rotacion"))),
		Teams.rating(dest) if not dest.is_empty() else 0,
		Market.pacto_veta(dest, String(rec.get("club", ""))))
	_cierra_motivo(Salida.VIA_TRASPASO, estado, {"dest": dest})
	var coh: Dictionary = {"motivo": String(rec.get("motivo", "")), "estado": estado}
	if cobrar:
		_cobra_coherencia(coh)
	return coh







func _cobra_coherencia(coh: Dictionary, golpe_previo: int = 0) -> void:
	var fx: Dictionary = Salida.coherencia_fx(String(coh.get("motivo", "")),
		String(coh.get("estado", "")))
	if fx.is_empty():
		return
	var af0: int = int(rel.get("aficion", 0))
	_salida_aplica(fx)
	if golpe_previo > 0:
		var suelo: int = af0 - maxi(0, Salida.TOPE_AFICION_PRE - golpe_previo)
		if int(rel.get("aficion", 0)) < suelo:
			rel["aficion"] = suelo
			rel_frac["aficion"] = 0.0












