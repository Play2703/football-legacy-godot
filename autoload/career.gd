		})









		queue_ceremony(Ceremonies.WELCOME, {
			"club": club_id,
			"div": div,
			"route": String(data["route"]),
		})





	if String(data["route"]) == "loan":
		data["order"] = -5
	queue_ceremony(Ceremonies.SIGNING, data)







	match String(data.get("tier", "")):
		"historico":
			rel["aficion"] = 48
		"lleno":
			rel["aficion"] = 40
		"tibio":
			rel["aficion"] = 32



	if int(data.get("fans", 0)) > int(best_presentation.get("fans", 0)):
		best_presentation = {
			"fans": int(data.get("fans", 0)),
			"club": club_id,
			"club_name": String(team.get("name", club_id)),
			"season": GameState.season_num,
			"age": age,
			"tier": String(data.get("tier", "")),
		}


	Achievements.ingest_presentation(data)




	if kind != Presentation.KIND_LOAN:
		if String(data.get("tier", "")) == "historico":
			_offer_bomb_shirt()
		else:
			_offer_contract_shirt(SHIRT_MODE_SIGN)








