func _end_loan(avg: float, lines: Array[String]) -> void:
	var parent: String = String(loan.get("parent", ""))

	var dest: String = GameState.player_team_id
	var buy_fee: int = int(loan.get("buy_fee", 0))

	var rel_parent: Dictionary = Dictionary(loan.get("rel_parent", {}))


	var coach_parent: Variant = loan.get("coach_parent", null)
	loan = {}

	_loan_encore = {}
	if parent.is_empty() or Teams.by_id(parent).is_empty():
		_cierra_motivo(Salida.VIA_CESION, Salida.ANULADO)
		return










	var media_cedido: float = season_avg() if season_matches > 0 else avg
	var ejecuta: bool = buy_fee > 0 and media_cedido >= Market.LOAN_BUY_AVG \
			and not Teams.by_id(dest).is_empty()




	var dicho_cesion: Dictionary = Dictionary(salida_motivo.get(Salida.VIA_CESION, {})).duplicate()
	_cierra_motivo(Salida.VIA_CESION, Salida.CUMPLIDO if ejecuta else Salida.NEUTRO,
		{"dest": dest})
	if ejecuta:
		_option_offer = {"id": dest, "fee": buy_fee}
		lines.append(I18n.tf("{0} ejecuta la opción de compra pactada",
			[String(Teams.by_id(dest)["name"])]))
	lines.append(I18n.tf("Fin de la cesión: vuelves a {0}",
		[String(Teams.by_id(parent)["name"])]))













	_farewell_locker(parent)
	GameState.player_team_id = parent
	_sync_user_pos()






	_relocate(22, dest, true, 12, true)
	rel["tecnico"] = clampi(22 + int(maxf(avg - 5.5, 0.0) * 16.0), 22, 70)
	rel["equipo"] = 38


	_seed_contract_role()












	var mismo_tecnico: bool = coach_parent == null \
			or (not String(coach_parent).is_empty() and String(coach_parent) == coach_name())
	for k in ["aficion", "equipo", "tecnico"]:
		if k == "tecnico" and not mismo_tecnico:
			continue
		rel[k] = maxi(int(rel_parent.get(k, 0)), int(rel.get(k, 0)))





	if String(dicho_cesion.get("motivo", "")) == Salida.PROYECTO and not ejecuta \
			and not coach_name().is_empty() \
			and String(dicho_cesion.get("coach", "")) == coach_name():
		_salida_aplica(Salida.VUELTA_FRIA_FX)















	queue_ceremony(Ceremonies.WELCOME, {
		"club": parent,
		"div": clampi(GameState.div_of(parent), 1, 3),
		"route": "loan_back",
	})




	if not ejecuta:
		_seed_loan_encore(dest, lines)

	Achievements.ingest_loan_end()






















func _seed_loan_encore(host: String, lines: Array[String]) -> void:
	var club: Dictionary = Teams.by_id(host)
	if club.is_empty() or host == GameState.player_team_id:
		return




	if must_retire() or int(contract.get("seasons_left", 1)) <= 0 \
			or not pending_precontract.is_empty():
		return
	var estrella: bool = current_season_awards().has(ClubGala.AWARD_BEST)
	if not estrella and (season_matches < Market.LOAN_ENCORE_APPS
			or season_avg() < Market.LOAN_BUY_AVG):
		return
	var compra: bool = Market.affords(club, scout_profile())
	var repite: bool = Standing.contract_role_from_key(
		String(contract.get("role", "rotacion"))) < Standing.ContractRole.TITULAR
	var nombre: String = String(club["name"])
	if not compra and not repite:
		lines.append(I18n.tf("{0} quería que volvieras, pero tu club cuenta contigo",
			[nombre]))
		return
	_loan_encore = {"id": host, "buy": compra, "loan": repite, "offered": false,
		"parent": GameState.player_team_id}
	if compra and repite:
		lines.append(I18n.tf("{0} quiere que vuelvas: pide repetir la cesión y puja por ti",
			[nombre]))
	elif repite:
		lines.append(I18n.tf("{0} quiere que vuelvas: pide repetir la cesión", [nombre]))
	else:
		lines.append(I18n.tf("{0} quiere que vuelvas: intentará comprarte", [nombre]))











func _inject_loan_encore() -> void:
	if _loan_encore.is_empty():
		return




	var host: String = String(_loan_encore.get("id", ""))
	if on_loan() or free_agent or retired or Teams.by_id(host).is_empty() \
			or host == GameState.player_team_id \
			or String(_loan_encore.get("parent", "")) != GameState.player_team_id:
		_loan_encore = {}
		return
	if bool(_loan_encore.get("buy", false)):
		var ya: bool = false
		for o in pending_offers:
			if String(o.get("id", "")) == host:
				o["encore"] = true
				ya = true
		if not ya and not bool(_loan_encore.get("offered", false)):
			var puja: Dictionary = Market.forced_offer(host, scout_profile())
			if not puja.is_empty():
				puja["encore"] = true
				pending_offers.insert(0, puja)
		_loan_encore["offered"] = true
	if bool(_loan_encore.get("loan", false)):
		var otras: Array = pending_loans.filter(func(d: Dictionary) -> bool:
			return String(d.get("id", "")) != host)
		var repetir: Dictionary = Market.loan_dest(scout_profile(), host)
		repetir["encore"] = true
		otras.insert(0, repetir)
		pending_loans = otras




