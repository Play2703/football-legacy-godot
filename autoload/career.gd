func match_scene_target() -> String:
	if GameState.next_minutes <= 0:
		return ""




	if rival_guard_due():
		return _acto_o_partido(Ceremonies.scene_of(Ceremonies.RIVAL_GUARD))






	if enemy_return_due():
		return _acto_o_partido(Ceremonies.scene_of(Ceremonies.ENEMY_RETURN))




	var fx: Dictionary = GameState.current_fixture()
	var is_nat: bool = String(fx.get("comp", "")) == "nat"






	if not Flashback.sale(is_nat, nationality, String(fx.get("opp", "")),
			flashbacks_vistos, GameState.player_team_id).is_empty():
		return _acto_o_partido(Ceremonies.scene_of(Ceremonies.FLASHBACK))














	if not GameState.next_starter and not (is_nat and nat_caps <= 0) \
			and BancaJuego.sale(player_name, bench_open_n):
		return _acto_o_partido(Ceremonies.scene_of(
			Ceremonies.banca_juego_de(player_name, bench_open_n)))





	if Himno.sale(is_nat, GameState.next_starter, nat_caps,
			Competitions.id_of(fx) if is_nat else "", _is_final(fx), himno_temporada,
			GameState.season_num, Himno.dado_de(nationality, GameState.season_num, nat_caps)):
		return _acto_o_partido(Ceremonies.scene_of(Ceremonies.HIMNO))






	var mode: String = Ceremonies.cold_open_for(is_nat, nat_caps,
		(not is_nat) and is_derby(String(fx.get("opp", ""))),
		"" if is_nat else Competitions.id_of(fx),
		GameState.retro_kit_on(), _is_final(fx),
		Competitions.id_of(fx) if is_nat else "",
		GameState.next_starter,(not is_nat) and not sombra_a_tiro().is_empty(),
		(not is_nat) and not GoleoVivo.para_previa(String(fx.get("comp", "")),
			season_matches, String(fx.get("opp", ""))).is_empty(),
		(not is_nat) and not Pronostico.para_previa(fx, season_matches).is_empty())
	if not mode.is_empty():
		return _acto_o_partido(Ceremonies.COLD_OPEN_SCENE)





	if not is_nat and PechoVolea.sale(GameState.next_starter, mode,
			Ceremonies.protocol_previa(false, Competitions.id_of(fx), ""),
			PechoVolea.dado_de(GameState.player_team_id, GameState.season_num,
				GameState.matches_played)):
		return _acto_o_partido(Ceremonies.scene_of(Ceremonies.PREVIA_PECHO_VOLEA))
	return MATCH_SCENE




