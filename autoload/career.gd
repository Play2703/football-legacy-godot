func _juveniles_verano() -> void:
	if retired or GameState.player_team_id.is_empty():
		return
	var pr: Dictionary = juveniles["promesa"]
	if not pr.is_empty():
		juveniles["promesa"] = {}
		if loan.is_empty():
			var llega: Dictionary = _juvenil_llega(GameState.player_team_id, pr)
			if not llega.is_empty():
				var pay: Dictionary = _juvenil_payload(llega)
				pay["promesa"] = true
				pay["pais"] = String(pr.get("nation", ""))
				(juveniles["contrato"] as Array).append(String(llega["name"]))
				queue_ceremony(Ceremonies.JUVENIL_CONTRATO, pay)


				queue_ceremony(Ceremonies.JUVENIL_PRESENTA, pay.duplicate())
				return
	if not Juveniles.toca_contrato(GameState.season_num):
		return
	var row: Dictionary = Juveniles.para_contrato(squad_roster(),
		juveniles["contrato"] as Array)
	if row.is_empty():
		return
	(juveniles["contrato"] as Array).append(String(row["name"]))
	queue_ceremony(Ceremonies.JUVENIL_CONTRATO, _juvenil_payload(row))






func _juvenil_llega(mio: String, pr: Dictionary) -> Dictionary:
	var squad_mio: Array = Squad.home_of(mio, true)
	if squad_mio.is_empty():
		return {}
	var _mia: Array = squad_meta_of(mio)
	var salida: int = -1
	if squad_mio.size() >= Squad.SQUAD_SIZE:
		salida = _gerencia_descarte(mio, squad_mio)
		if salida < 0:
			return {}
	var ocupados: Dictionary = {}
	for fila in squad_mio:
		ocupados[String((fila as Dictionary).get("name", ""))] = true
	var pos: String = String(pr.get("pos", "MC"))
	var nacion: String = String(pr.get("nation", Teams.country_of(mio)))
	var ident: Dictionary = AiMarket.youth_identity(mio, pos, Teams.rating(mio),
		String(pr.get("pool", "")) if not String(pr.get("pool", "")).is_empty() else nacion,
		GameState.season_num, int(pr.get("seed", 0)), ocupados)


	ident["name"] = String(pr["name"])
	ident["age"] = Juveniles.EDAD_NINO + 1
	ident["nation"] = nacion


	var nace: int = GameState.season_num -(Juveniles.EDAD_NINO + 1)
	(juveniles["nacidos"] as Dictionary)[String(pr["name"])] = nace
	PlayerLooks.apunta_regen(String(pr["name"]), nace)



	ident = WorldAging.a_medalla(ident, pos, Juveniles.AHIJADO_LLEGA)
	ident["pot"] = Juveniles.AHIJADO_POT
	ident["poss"] = Squad.poss_of(ident)
	ident["etapa_desde"] = GameState.season_num
	var dorsal: int = Squad.free_number(squad_mio, pos, mio)
	var idx: int = RosterDelta.add_seat(mio, pos, dorsal,
		SquadEdits.snapshot_identity(ident), false, squad_mio.size())
	if idx < 0:
		return {}
	editor_add_meta(mio, {
		"age": Juveniles.EDAD_NINO + 1,
		"nation": nacion,
		"contract": AiMarket.SIGNED_CONTRACT_MIN,
		"signed": GameState.season_num,
		"gp": 0, "goals": 0, "assists": 0, "rating_sum": 0.0,
	})
	if salida >= 0:
		salida = Squad.home_seat(squad_mio, salida)
	if salida >= 0 and not _gerencia_suelta(mio, salida, squad_mio.size() + 1):
		RosterDelta.reset_last(mio, false)
		editor_drop_meta(mio, squad_mio.size())
		return {}




	TransferBook.invalidate_caches()
	return {"name": String(pr["name"]), "number": dorsal, "pos": pos,
		"age": Juveniles.EDAD_NINO + 1}





