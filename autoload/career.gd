func _veredicto_liga_ucl(result: Dictionary, avg: float, closing: bool) -> Dictionary:
	var pos: int = int(result.get("league_pos", 99))
	var won_league: bool = bool(result.get("won_league", false))
	var played_ucl: bool = bool(result.get("played_ucl", false))
	var ucl_adv: bool = bool(result.get("ucl_advanced", false))
	var lr: Array = league_race(closing, result)
	var ur: Array = ucl_race(closing)





	blend_mate_stats(lr, "league")
	blend_mate_stats(ur, "ucl")







	var hay_liga: bool = not lr.is_empty()
	var hay_ucl: bool = not ur.is_empty()








	var anio: Dictionary = season_comps()





	var liga_carrera: Dictionary = liga_de_la_carrera(closing, result)
	var en_liga: Dictionary = liga_del_anio(String(liga_carrera["pais"]),
		int(liga_carrera["div"]))
	var g_liga: int = int(en_liga["g"])
	var a_liga: int = int(en_liga["a"])
	var g_ucl: int = int((anio["ucl"] as Dictionary)["g"])
	var a_ucl: int = int((anio["ucl"] as Dictionary)["a"])

	var top_g: Dictionary = Race.leader(lr, "goals")
	var top_a: Dictionary = Race.leader(lr, "assists")
	var top_r: Dictionary = Race.leader(lr, "avg")










	var apps_anio: int = season_matches + _season_stashed("apps")
	var apps_ref: int = int(top_r.get("apps", 0))
	var jugo_el_ano: bool = apps_ref <= 0 or float(apps_anio) >= float(apps_ref) * 0.6


	var jugo_la_liga: bool = apps_ref <= 0 \
			or float(int(en_liga["apps"])) >= float(apps_ref) * 0.6
	var bar_g: int = int(top_g.get("goals", 15))
	var ucl_g: Dictionary = Race.leader(ur, "goals")
	var ganados: Array[String] = []


	if hay_liga and g_liga >= bar_g:
		ganados.append("Pichichi de la Liga")
	if hay_liga and a_liga >= int(top_a.get("assists", 12)):
		ganados.append("Máximo Asistente de la Liga")


	if jugo_la_liga and hay_liga and float(en_liga["avg"]) >= float(top_r.get("avg", 7.6)) \
			and (won_league or pos <= 3):
		ganados.append("Mejor Jugador de la Liga")


	if played_ucl and ucl_adv:

		if hay_ucl and g_ucl >= int(ucl_g.get("goals", 22)):
			ganados.append("Bota de la Champions")
		if hay_ucl and a_ucl >= int(Race.leader(ur, "assists").get("assists", 15)):
			ganados.append("Máximo Asistente de la Champions")
		if jugo_el_ano and hay_ucl and avg >= float(Race.leader(ur, "avg").get("avg", 7.8)):
			ganados.append("Mejor de la Champions")
	return {"ganados": ganados, "anio": anio, "jugo_el_ano": jugo_el_ano,
		"top_g": top_g, "bar_g": bar_g, "g_liga": g_liga, "a_liga": a_liga,
		"avg_liga": float(en_liga["avg"]),
		"g_ucl": g_ucl, "bar_g_ucl": int(ucl_g.get("goals", 22))}















func _season_awards(result: Dictionary, avg: float, lines: Array[String]) -> void:
	if season_matches <= 0:
		return



	var v: Dictionary = _veredicto_liga_ucl(result, avg, true)
	var ganados: Array = v["ganados"]
	var anio: Dictionary = v["anio"]
	var jugo_el_ano: bool = bool(v["jugo_el_ano"])
	var g_liga: int = int(v["g_liga"])
	var a_liga: int = int(v["a_liga"])
	var g_ucl: int = int(v["g_ucl"])
	var g_eul: int = int((anio["eul"] as Dictionary)["g"])
	var a_eul: int = int((anio["eul"] as Dictionary)["a"])
	var g_conf: int = int((anio["conf"] as Dictionary)["g"])
	var a_conf: int = int((anio["conf"] as Dictionary)["a"])
	var g_cup: int = int((anio["cup"] as Dictionary)["g"])
	var a_cup: int = int((anio["cup"] as Dictionary)["a"])
	var g_cwc: int = int((anio["cwc"] as Dictionary)["g"])
	var a_cwc: int = int((anio["cwc"] as Dictionary)["a"])
	var top_g: Dictionary = v["top_g"]
	var bar_g: int = int(v["bar_g"])
	if ganados.has("Pichichi de la Liga"):
		_win("Pichichi de la Liga", "PICHICHI DE LA LIGA (%d goles · superaste los %d de %s)"
			% [g_liga, bar_g, String(top_g.get("name", "tu rival"))], lines)
	elif not top_g.is_empty():

		lines.append("Pichichi: %s (%d goles · tú: %d)" % [
			String(top_g["name"]), bar_g, g_liga])
	if ganados.has("Máximo Asistente de la Liga"):
		_win("Máximo Asistente de la Liga",
			"MÁXIMO ASISTENTE DE LA LIGA (%d)" % a_liga, lines)
	if ganados.has("Mejor Jugador de la Liga"):
		_win("Mejor Jugador de la Liga",
			"MEJOR JUGADOR DE LA LIGA (%.1f)" % float(v["avg_liga"]), lines)
	if ganados.has("Bota de la Champions"):
		_win("Bota de la Champions", "BOTA DE LA CHAMPIONS (%d goles · el listón era %d)"
			% [g_ucl, int(v["bar_g_ucl"])], lines)
	if ganados.has("Máximo Asistente de la Champions"):
		_win("Máximo Asistente de la Champions",
			"MÁXIMO ASISTENTE DE LA CHAMPIONS", lines)
	if ganados.has("Mejor de la Champions"):
		_win("Mejor de la Champions",
			"MEJOR DE LA CHAMPIONS (%.1f)" % avg, lines)



	if bool(result.get("played_eul", false)) and bool(result.get("eul_advanced", false)):
		var er: Array = eul_race(true)
		blend_mate_stats(er, "eul")
		var hay_eul: bool = not er.is_empty()
		var eul_g: Dictionary = Race.leader(er, "goals")
		if hay_eul and g_eul >= int(eul_g.get("goals", 14)):
			_win("Bota de la Europa League",
				"BOTA DE LA EUROPA LEAGUE (%d goles · el listón era %d)"
				% [g_eul, int(eul_g.get("goals", 14))], lines)
		if hay_eul and a_eul >= int(Race.leader(er, "assists").get("assists", 10)):
			_win("Máximo Asistente de la Europa League",
				"MÁXIMO ASISTENTE DE LA EUROPA LEAGUE", lines)
		if jugo_el_ano and hay_eul and avg >= float(Race.leader(er, "avg").get("avg", 7.7)):
			_win("Mejor de la Europa League",
				"MEJOR DE LA EUROPA LEAGUE (%.1f)" % avg, lines)



	if bool(result.get("played_conf", false)) and bool(result.get("conf_advanced", false)):
		var cr: Array = conf_race(true)
		blend_mate_stats(cr, "conf")
		var hay_conf: bool = not cr.is_empty()
		var conf_g: Dictionary = Race.leader(cr, "goals")
		if hay_conf and g_conf >= int(conf_g.get("goals", 11)):
			_win("Bota de la Conference",
				"BOTA DE LA CONFERENCE (%d goles · el listón era %d)"
				% [g_conf, int(conf_g.get("goals", 11))], lines)
		if hay_conf and a_conf >= int(Race.leader(cr, "assists").get("assists", 8)):
			_win("Máximo Asistente de la Conference",
				"MÁXIMO ASISTENTE DE LA CONFERENCE", lines)
		if jugo_el_ano and hay_conf and avg >= float(Race.leader(cr, "avg").get("avg", 7.6)):
			_win("Mejor de la Conference",
				"MEJOR DE LA CONFERENCE (%.1f)" % avg, lines)


	for ac in Continental.AMER_COMPS:
		_premios_continentales(ac, result, avg, jugo_el_ano, lines, anio)





	if bool(result.get("played_cup", false)) and bool(result.get("cup_final", false)):
		var cpr: Array = cup_race(true, int(result.get("cup_rounds", 4)))
		blend_mate_stats(cpr, "cup")
		var hay_cup: bool = not cpr.is_empty()
		var cup_g: Dictionary = Race.leader(cpr, "goals")
		if hay_cup and g_cup >= int(cup_g.get("goals", 6)):
			_win("Bota de la Copa", "BOTA DE LA COPA (%d goles · el listón era %d)"
				% [g_cup, int(cup_g.get("goals", 6))], lines)
		if hay_cup and a_cup >= int(Race.leader(cpr, "assists").get("assists", 4)):
			_win("Máximo Asistente de la Copa", "MÁXIMO ASISTENTE DE LA COPA", lines)
		if jugo_el_ano and hay_cup and avg >= float(Race.leader(cpr, "avg").get("avg", 7.5)):
			_win("Mejor de la Copa", "MEJOR DE LA COPA (%.1f)" % avg, lines)




	if bool(result.get("played_cwc", false)) and bool(result.get("cwc_final", false)):
		var wr: Array = cwc_race(true)
		blend_mate_stats(wr, "cwc")
		var hay_cwc: bool = not wr.is_empty()
		var cwc_g: Dictionary = Race.leader(wr, "goals")
		if hay_cwc and g_cwc >= int(cwc_g.get("goals", 4)):
			_win("Bota del Mundial de Clubes",
				"BOTA DEL MUNDIAL DE CLUBES (%d goles · el listón era %d)"
				% [g_cwc, int(cwc_g.get("goals", 4))], lines)
		if hay_cwc and a_cwc >= int(Race.leader(wr, "assists").get("assists", 3)):
			_win("Máximo Asistente del Mundial de Clubes",
				"MÁXIMO ASISTENTE DEL MUNDIAL DE CLUBES", lines)
		if jugo_el_ano and hay_cwc and avg >= float(Race.leader(wr, "avg").get("avg", 7.8)):
			_win("Mejor del Mundial de Clubes",
				"MEJOR DEL MUNDIAL DE CLUBES (%.1f)" % avg, lines)
















func gano_continental(result: Dictionary, comp: String) -> bool:
	return bool(result.get("won_%s" % comp, false)) \
			or bool(result.get("%s_champion" % comp, false))















func _premios_continentales(comp: String, result: Dictionary, avg: float,
		jugo_el_ano: bool, lines: Array[String], anio: Dictionary = {}) -> void:
	if not bool(result.get("played_%s" % comp, false)) \
			or not bool(result.get("%s_advanced" % comp, false)):
		return
	if anio.is_empty():
		anio = season_comps()
	var cell: Dictionary = anio.get(comp, {})
	var g: int = int(cell.get("g", 0))
	var a: int = int(cell.get("a", 0))
	var umb: Dictionary = Continental.umbral(comp)
	var rr: Array = _cont_race(comp, true)
	blend_mate_stats(rr, comp)
	var hay: bool = not rr.is_empty()
	var bar_g: int = int(Race.leader(rr, "goals").get("goals", int(umb.get("g", 12)))) \
			if hay else int(umb.get("g", 12))
	var bar_a: int = int(Race.leader(rr, "assists").get("assists", int(umb.get("a", 8)))) \
			if hay else int(umb.get("a", 8))
	var bar_avg: float = float(Race.leader(rr, "avg").get("avg", float(umb.get("avg", 7.8)))) \
			if hay else float(umb.get("avg", 7.8))


	if g > 0 and g >= bar_g:
		var bota: String = Continental.bota(comp)
		_win(bota, "%s (%d goles · el listón era %d)" % [bota.to_upper(), g, bar_g], lines)
	if a > 0 and a >= bar_a:
		var asis: String = Continental.asistente(comp)
		_win(asis, asis.to_upper(), lines)
	if jugo_el_ano and avg >= bar_avg:
		var mejor: String = Continental.mejor(comp)
		_win(mejor, "%s (%.1f)" % [mejor.to_upper(), avg], lines)





