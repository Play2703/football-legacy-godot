func sponsor_income(ev: Dictionary, minutes: int = 90) -> int:
	var total: int = 0
	for s in sponsors:



		if not Sponsors.pays_this_match(s, minutes):
			continue




		var n: int = Sponsors.event_count(Sponsors.per_kind_of(s), ev)
		total += Sponsors.term(s, "pay") + Sponsors.term(s, "per_goal") * n
	return total












