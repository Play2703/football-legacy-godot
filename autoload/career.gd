func pide_puesto(pos: String) -> bool:
	if not puede_pedir_puesto() or not sabe_jugar(pos) or pos == puesto_hoy():
		return false
	pos_req = {"season": GameState.season_num,
		"window": Market.window_id(GameState.season_day, GameState.winter_day())}

	var gana: bool = pacto_puestos(GameState.player_team_id).has(pos) \
			or randf() < PROB_PETICION[lectura_peticion(pos)]
	if gana:
		fija_puesto(GameState.player_team_id, pos)
		_apply_delta("tecnico", 2.0, REL_BRAKE_EXP_DECISION)
	else:

		_apply_delta("tecnico", -4.0, REL_BRAKE_EXP_DECISION)
	_save()
	changed.emit()
	return gana











