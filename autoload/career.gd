func _stamp_offer_life() -> void:
	if free_agent:
		return
	var left: int = Market.window_days_left(GameState.season_day, GameState.winter_day())
	if left <= 0:
		return






	var last: int = Market.window_last_day(GameState.season_day, GameState.winter_day())
	for o in pending_offers:
		if bool(o.get("pre", false)):
			o["expires"] = last
		else:
			o["expires"] = GameState.season_day + Market.offer_life(left, randf()) - 1







