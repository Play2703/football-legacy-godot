func nat_standing() -> Dictionary:


	var status: String = nat_role()





	if status == "fuera":
		return {"minutes": 0, "chances": 0, "starter": false,
			"status": Standing.STATUS_FUERA, "role_name": "NO CONVOCADO"}
	var starter: bool = status == "titular"


	var base: int = 85 if starter else (25 if status == "banca" else 0)




	var mins: int = 0
	if base > 0:
		base += int(round(Standing.FIT_MINUTES_SPAN * stat_norm("fisico")))
		mins = clampi(int(round(float(base) * Standing.energy_factor(energy))),
			Standing.MIN_PLAY_MINUTES, 90)
	var ch: int = 0
	if mins > 0:






		ch = Standing.chances(mins, 60, 60, form, level, false, puesto_seleccion())




		ch = maxi(1, roundi(float(ch) * ajuste_puesto(puesto_seleccion())))









		ch = maxi(1, ch + nat_aficion_balones())
		if int(nat_rel["equipo"]) < NAT_COACH_BAD:
			ch = mini(ch, NAT_COLD_CHANCES)
	return {"minutes": mins, "chances": ch, "starter": starter,
		"role_name": "TITULAR" if starter \
				else ("SUPLENTE" if status == "banca" else "RESERVA")}





const NAT_AFICION_BUENA: int = 65

func nat_aficion_balones() -> int:
	var f: Dictionary = GameState.current_fixture()
	if String(f.get("comp", "")) != "nat" or not bool(f.get("home", false)):
		return 0
	var a: int = int(nat_rel["aficion"])
	if a >= NAT_AFICION_BUENA:
		return 1
	if a < NAT_COACH_BAD:
		return -1
	return 0




const NAT_COLD_CHANCES: int = 2






func _queue_keepsake_balls(ball: Dictionary, goals: int, minutes: int,
		socio: Dictionary, extra: Dictionary) -> void:
	var plan: Dictionary = Keepsakes.plan_balls(ball,
		Keepsakes.earns_ball(goals, minutes), socio, minutes, goals)
	for k in plan["push"]:
		keepsakes = Keepsakes.push(keepsakes, k)
	var act: Dictionary = plan["act"]
	if act.is_empty():
		return
	act["div"] = GameState.player_div()
	act.merge(extra, true)
	queue_ceremony(Ceremonies.KEEPSAKE, act)


	if String(act.get("mode", "")) == "socio":
		Achievements.ingest_socio_hat_trick(bool(act.get("both", false)))












func on_nat_match_result(rating: float, goals: int, assists: int, result: int,
		minutes: int = 90, team_goals: int = -1, rival_goals: int = -1,
		socio: Dictionary = {}, pedido: Dictionary = {}) -> void:
	_spend_match_fx(HOUSE_TACTICAL_FX)

	_multa_roja_pend = false

	_comunicado_roja = {}







	pending_hook = false
	pending_hook_min = 0
	pending_hook_wasted = 0
	pending_hook_reason = ""
	pending_hook_shown = false




	last_spicy = {}



	_tick_familiaridad(puesto_seleccion(), minutes)
	var played_ratio: float = clampf(float(minutes) / 90.0, 0.0, 1.0)










	if nat_debut.is_empty() and minutes > 0:
		nat_debut = {
			"season": GameState.season_num,
			"age": age,
			"rival": String(GameState.current_fixture().get("opp", "")),
			"tg": team_goals, "rg": rival_goals,
			"goals": goals, "result": result,
		}


	last_milestones = Milestones.earned({
		"rating": rating, "goals": goals, "assists": assists,
		"minutes": minutes, "result": result, "derby": false,
	})

	last_match_xp = con_doble_xp(int((XP_MATCH_BASE
		+ maxf(rating - XP_RATING_FLOOR, 0.0) * XP_PER_RATING + goals * XP_PER_GOAL
		+ assists * XP_PER_ASSIST) * XP_NAT_MULT * played_ratio)
		+ Milestones.total_xp(last_milestones))
	var level_before: int = level
	add_xp(last_match_xp)
	last_level_up = level - level_before
	nat_caps += 1



	if not nat_is_friendly():
		nat_caps_official += 1
	nat_goals += goals


	nat_assists += assists


	_check_nat_record()

	if _nat_goals_season != GameState.season_num:
		_reset_nat_season_counters()
		_nat_goals_season = GameState.season_num
	season_nat_goals += goals
