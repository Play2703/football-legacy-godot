func _tick_role_promotion(edge: float) -> void:
	var current: int = Standing.contract_role_from_key(String(contract.get("role", "rotacion")))
	var merit_tier: int = Standing.contract_role_of(edge)
	if merit_tier <= current:
		_role_climb = 0
		return
	_role_climb += 1
	if _role_climb < ROLE_PROMOTE_MATCHES:
		return
	var next_role: int = current + 1
	contract["role"] = Standing.contract_role_key(next_role)
	_role_climb = 0








