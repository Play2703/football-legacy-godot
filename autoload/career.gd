static func _bajas_normaliza(raw: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for club in raw:
		if not (raw[club] is Dictionary):
			continue
		var d: Dictionary = {}
		for a in (raw[club] as Dictionary):
			var e: Variant =(raw[club] as Dictionary)[a]
			if e is Dictionary and int((e as Dictionary).get("w", 0)) > 0:
				d[int(a)] = e
		if not d.is_empty():
			out[String(club)] = d
	return out











