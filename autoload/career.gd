					[String(c["name"]), int(s["pay"])]))




			lines.append(I18n.tf("{0}: OBJETIVO CUMPLIDO", [String(c["name"])]))
			rel["prensa"] = mini(100, int(rel["prensa"]) + 5)
		else:

			rel["prensa"] = maxi(0, int(rel["prensa"]) - 4)
		s["seasons_left"] = int(s["seasons_left"]) - 1
		s["progress"] = 0



		s["played"] = 0
		s["paid"] = 0
		s["missed"] = 0


		s["avg"] = 0
		if int(s["seasons_left"]) <= 0:




			if met and not _sponsor_europa() and String(c["obj"]) == "euro_goals":
				sponsors.erase(s)
				lines.append(I18n.tf("{0} no renueva: tu club no juega en Europa",
