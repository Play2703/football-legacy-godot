func factor_de_hoy() -> float:
	var suerte: bool = _once_de_la_suerte()
	var llave: String = "%s|%d|%d|%s|%s|%s" % [GameState.player_team_id,
		GameState.season_num, GameState.season_day, coach_idea, _dt_llave(), suerte]
	if _factor_hoy_cache.has(llave):
		return float(_factor_hoy_cache[llave])
	var f: Dictionary = GameState.current_fixture()
	var factor: float = 1.0
	if not f.is_empty():







		var o: Dictionary = GameState.odds_fixture(f, false)
		var p_win: float = float(o.get("win", 0.0)) if not o.is_empty() else 0.0


		factor = Rotation.factor_frescura(peso_de_hoy(), peso_proximo(), p_win)
	factor = clampf(factor * float(Coach.idea_of(coach_idea)["rota"]) * rasgo_club("rota"),
		Rotation.FACTOR_MIN, Rotation.FACTOR_MAX)
	if suerte:
		factor = Rotation.FACTOR_MIN
	_factor_hoy_cache = {llave: factor}
	return factor















var _guarda_cache: Dictionary = {}
func _guarda_proximo() -> float:
	var hoy: Dictionary = GameState.current_fixture()
	var prox: Dictionary = GameState.next_fixture()
	if hoy.is_empty() or prox.is_empty():
		return 1.0
	var comp_prox: String = String(prox.get("comp", "league"))
	if comp_prox == "nat":
		return 1.0
	if suspension_matches > 0 and suspension_comp == comp_prox \
			and (String(hoy.get("comp", "")) != comp_prox or suspension_matches > 1):
		return 1.0
	var llave: String = "%s|%s|%s|%s|%s|%s|%s|%d|%s" % [_llave_jornada(),
		String(hoy.get("comp", "")), String(hoy.get("round", "")), String(hoy.get("opp", "")),
		comp_prox, String(prox.get("round", "")), String(prox.get("opp", "")),
		suspension_matches, suspension_comp]
	if _guarda_cache.has(llave):
		return float(_guarda_cache[llave])
	var mult: float = Rotation.mult_guardar(next_match_weight(), peso_proximo(),
		GameState.dias_descanso(), GUARDA_DIAS_MAX, GUARDA_GANANCIA)
	_guarda_cache = {llave: mult}
	return mult








