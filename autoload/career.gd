func _adopta_tecnico_de(club: String) -> void:
	var fila: Variant = coach_seats.get(club, null)
	var tiene: bool = fila is Array and (fila as Array).size() >= 3
	coach_term = int((fila as Array)[0]) if tiene else Coaches.TERM_BASE
	coach_desde = int((fila as Array)[1]) if tiene else Coaches.DESDE_BASE
	coach_src = String((fila as Array)[3]) if tiene and (fila as Array).size() > 3 else ""

	coach_cred = int((fila as Array)[4]) if tiene and (fila as Array).size() > 4 else 0
	for f in coach_book:
		var d: Dictionary = f
		if String(d.get("ahora", "")) == club:
			coach_src = "%s|%d" % [String(d.get("club", club)), int(d.get("term", 1))]
			coach_cred = int(d.get("cred", 0))
			break
	var org: String = club
	var term: int = coach_term
	if not coach_src.is_empty():
		var partes: Array = Coach.parte_src(coach_src)
		if not partes.is_empty():
			org = String(partes[0])
			term = int(partes[1])


	coach_idea = Coaches.idea_de(org, term)
	Coaches.bump()


func _book_add(guarda: Variant = null) -> void:

	_fija_nombre(GameState.player_team_id)
	var club: String = GameState.player_team_id
	var term: int = coach_term
	if not coach_src.is_empty():
		var partes: Array = Coach.parte_src(coach_src)
		if not partes.is_empty():
			club = String(partes[0])
			term = int(partes[1])
	if club.is_empty():
		return



	var cred_sale: int = coach_cred - Coach.CRED_CESE










	for f in coach_book:
		var d: Dictionary = f
		if String(d.get("ahora", "")) != GameState.player_team_id:
			continue
		if String(d.get("club", "")) == club and int(d.get("term", 0)) == term:



			d["ahora"] = ""
			d["desde"] = GameState.season_num
			d["cred"] = cred_sale
			return
	coach_book.append(Coach.ficha_libro(club, term, coach_char, coach_idea,
		GameState.season_num, cred_sale))








	while coach_book.size() > Coach.LIBRO_MAX:



		var fuera: int = -1
		for i in range(coach_book.size()):
			if guarda != null and is_same(coach_book[i], guarda):
				continue
			if not _ficha_con_palmares(coach_book[i]):
				fuera = i
				break
		if fuera < 0:
			fuera = 1 if guarda != null and is_same(coach_book[0], guarda) else 0
		coach_book.remove_at(fuera)







func _ficha_con_palmares(d: Dictionary) -> bool:
	var club: String = String(d.get("club", ""))
	if club.is_empty():
		return false




	var id_f: String = Coach.face_seed(club, int(d.get("term", 1)))
	return coach_trophies.has(id_f) or not CoachEdits.trofeos_of_id(id_f).is_empty()











func _nivel_de_ficha(d: Dictionary) -> int:
	var club: String = String(d.get("club", ""))
	if club.is_empty():
		return Coach.NIV_MIN


	return Coach.con_trofeos(Coach.nivel_vivo(Coach.nivel_base(club, int(d.get("term", 1)),
		Coach.rating_de(club), world_seed), int(d.get("cred", 0))),
		coach_trophies.get(Coach.face_seed(club, int(d.get("term", 1))), {}))


func _repesca_coach() -> Dictionary:
	if coach_book.is_empty() or randf() >= Coach.REPESCA_P:
		return {}
	var libres: Array = []
	for f in coach_book:
		var d: Dictionary = f
		if not String(d.get("ahora", "")).is_empty():
			continue
		if int(d.get("desde", 0)) >= GameState.season_num:
			continue
		if not Coach.puede_entrenar(Coach.rating_de(String(d.get("club", ""))),
				GameState.player_team_id, _nivel_de_ficha(d)):
			continue
		libres.append(d)
	if libres.is_empty():
		return {}
	return libres[randi() % libres.size()]







