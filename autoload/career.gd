func nat_race() -> Dictionary:
	var cu: Dictionary = nat_callup()
	if cu.is_empty() or bool(cu.get("retired", false)):
		return {}
	var status: String = nat_role_for(cu)
	for filtro in cu.get("filters", []):
		if bool(filtro["ok"]):
			continue
		match String(filtro["key"]):
			"div":
				return {"kind": "div", "trend": 0, "bad": true,
					"porque": I18n.tf("JUEGAS EN {0} · PIDE {1}",
						[I18n.ordinal_f(int(filtro["have"])),
							I18n.ordinal_f(int(filtro["need"]))])}
			"nota":


				return {"kind": "nota", "trend": 0, "bad": true,
					"porque": I18n.tf("NOTA {0} · PIDE {1}",
						[_nat_num(float(filtro["have"])),
							_nat_num(float(filtro["need"]))])}
			_:
				pass



	if status == "banca" and String(cu.get("status", "")) == "titular" \
			and int(nat_rel["tecnico"]) < NAT_COACH_BAD:
		return {"kind": "tecnico", "trend": 0, "bad": true,
			"porque": I18n.tf("TÉCNICO {0} · PIDE {1}",
				[int(nat_rel["tecnico"]), NAT_COACH_BAD]),
			"renglones": [I18n.tf("TÉCNICO {0}", [int(nat_rel["tecnico"])]),
				I18n.tf("PIDE {0}", [NAT_COACH_BAD])]}
	var rival: Dictionary = cu.get("rival", {})
	if rival.is_empty():
		return {}
	var gap: float = float(rival.get("gap", 0.0))
	var quien: String = CareerTheme.caps(String(rival.get("name", "")))
	var trend: int = 0
	if nat_race_last != NAT_RACE_NONE and nat_race_prev != NAT_RACE_NONE:
		var mov: float = nat_race_last - nat_race_prev
		if absf(mov) >= NAT_RACE_MIN_MOVE:


			trend = -1 if mov > 0.0 else 1





	var apellido: String = quien.get_slice(" ", quien.get_slice_count(" ") - 1)
	if status == "titular":

		if - gap >= NAT_RACE_HOT:
			return {}
		return {"kind": "sitio", "trend": trend, "bad": true,
			"porque": I18n.tf("{0} A {1} DE TU SITIO", [quien, _nat_num(- gap)]),
			"renglones": [I18n.tf("{0} A {1}", [apellido, _nat_num(- gap)]),
				I18n.t("DE TU SITIO")]}
	var texto: String = I18n.tf("A {0} DE {1}", [_nat_num(maxf(gap, 0.0)), quien])
	var renglones: Array = [I18n.tf("A {0} DE {1}", [_nat_num(maxf(gap, 0.0)), apellido])]
	if trend > 0:
		texto += " · " + I18n.t("TE ACERCAS")
		renglones.append(I18n.t("TE ACERCAS"))
	elif trend < 0:
