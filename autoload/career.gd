func _apply_division_wage_clause(from_div: int, lines: Array[String]) -> void:
	if not loan.is_empty():
		return
	var factor: float = ContractTerms.division_wage_factor(from_div,
		GameState.player_div())
	if is_equal_approx(factor, 1.0):
		return
	var antes: int = int(contract["wage"])
	var ahora: int = maxi(int(round(float(antes) * factor)), 1)
	if ahora == antes:
		return
	contract["wage"] = ahora
	if ahora > antes:
		lines.append(I18n.tf("Cláusula de ascenso: tu ficha sube a ${0}",
			[CareerUi.money(ahora)]))
	else:
