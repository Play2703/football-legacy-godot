func anota_goles_bellos(goles: Array, fx: Dictionary) -> void:
	var final: bool = String(fx.get("round", "")).to_lower() == "final"
	var comp: String = String(fx.get("comp", "league"))
	for g in goles:
		var fila: Dictionary = g
		var rival: String = String(fila.get("rival", fx.get("opp", "")))
		var n: float = GolDelAnio.nota(fila, final, is_derby(rival))
		if n <= float(season_gol_bello.get("nota", 0.0)):
			continue
		season_gol_bello = {"nota": n, "tipo": GolDelAnio.tipo(fila),
			"min": int(fila.get("min", 0)), "rival": rival, "comp": comp,
			"dist_m": snappedf(float(fila.get("dist_m", 0.0)), 0.1),
			"season": GameState.season_num, "club": GameState.player_team_id}







func _bump_dist_mark(goal: Dictionary, pass_m: float, rival: String) -> void:
	if not goal.is_empty():
		var gm: float = ShotBook.dist(goal)
		var mark: Dictionary = {
			"m": gm, "season": GameState.season_num,
			"club": GameState.player_team_id, "rival": rival,
		}
		if gm > float(best_goal_dist.get("m", 0.0)):
			best_goal_dist = mark.duplicate()
		if gm > float(season_best_goal_dist.get("m", 0.0)):
			season_best_goal_dist = mark.duplicate()
	if pass_m > 0.0:
		var pm: float = snappedf(pass_m, 0.1)
		var pmark: Dictionary = {
			"m": pm, "season": GameState.season_num,
			"club": GameState.player_team_id, "rival": rival,
		}
		if pm > float(best_pass_dist.get("m", 0.0)):
			best_pass_dist = pmark.duplicate()
		if pm > float(season_best_pass_dist.get("m", 0.0)):
			season_best_pass_dist = pmark.duplicate()






