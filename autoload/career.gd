const FORCED_LOAN_REFUSE_FX: Dictionary = {
	"tecnico": -16.0, "equipo": -6.0,
}






















func _loan_refuse_floor(step: int) -> int:
	if step >= 0:
		return step
	return maxi(step, mini(0, Standing.UNFIT_TECNICO - int(rel.get("tecnico", 0))))
























func _winter_objective_review(window_id: String) -> bool:
	if window_id != Market.WINDOW_WINTER or _obj_winter_season == GameState.season_num:
		return false
	if free_agent or retired or not loan.is_empty() or on_loan():
		return false


	if for_sale or _obj_bench_left > 0 or _obj_push_loan:
		return false
	var p: Dictionary = objective_pace()
	var target: int = int(p.get("target", 0))
	var proj: int = int(p.get("projected", -1))
	if target <= 0 or proj < 0:
		return false



	_obj_winter_season = GameState.season_num
	var rol: int = Standing.contract_role_from_key(String(contract.get("role", "rotacion")))
	var dests: Array = Market.build_loans(scout_profile(), GameState.player_team_id,
		age, rol)
	match Market.midseason_verdict(float(proj) / float(target), age,
			not dests.is_empty(), rol):
		"loan":











			_obj_push_loan = true
			if _check_forced_loan():
				return true
			_obj_push_loan = false
			return _bench_por_objetivo()
		"bench":
			return _bench_por_objetivo()
		_:
			return false






func _bench_por_objetivo() -> bool:
	_obj_bench_left = OBJ_BENCH_MATCHES
	for_sale = true
	rel["tecnico"] = maxi(0, int(rel["tecnico"]) - OBJ_BENCH_TECNICO)





	_market_note("TE SIENTAN POR NO CUMPLIR")
	return true



const OBJ_BENCH_TECNICO: int = 15


func _check_forced_loan() -> bool:
	if forced_loan or free_agent or _market_settled or retired:
		return false
	if not loan.is_empty() or _forced_loan_season == GameState.season_num:
		return false
	var st: Dictionary = standing()
	var cr: int = Standing.contract_role_from_key(String(contract.get("role", "rotacion")))



	var dests: Array = Market.build_loans(scout_profile(), GameState.player_team_id,
		age, cr)










	var forced: bool = Market.should_force_loan(age, cr, float(st["juicio"]),
		not dests.is_empty())
	if not forced and not (_obj_push_loan and age <= Market.FORCE_LOAN_AGE
			and not dests.is_empty()):
		return false
	_obj_push_loan = false
	_forced_loan_season = GameState.season_num
	forced_loan = true
	pending_loans = dests


	_inject_loan_encore()
	return true



func accept_forced_loan() -> void:
	if not forced_loan or pending_loans.is_empty():
		return


	if not loan_window_open():
		return
	forced_loan = false
	loan_refused = false
	loan_listed = false
	accept_loan(0)






func refuse_forced_loan() -> void:
	if not forced_loan:
		return


	forced_loan = false
	loan_listed = false


	_cierra_motivo(Salida.VIA_CESION, Salida.ANULADO)
	loan_refused = true
	var before: Dictionary = rel.duplicate()




	var suelo: int = int(before.get("tecnico", 0)) \
			+ int(forced_loan_cost().get("tecnico", 0))


	for key in FORCED_LOAN_REFUSE_FX:
		_apply_delta(String(key),
			_div_decision_scale(float(FORCED_LOAN_REFUSE_FX[key])),
			REL_BRAKE_EXP_DECISION)
	if int(rel.get("tecnico", 0)) < suelo:
		rel["tecnico"] = suelo
		rel_frac["tecnico"] = 0.0
	last_rel_delta = _rel_delta_since(before)
	_save()
	changed.emit()




func forced_loan_cost() -> Dictionary:
	var out: Dictionary = {}
	for key in FORCED_LOAN_REFUSE_FX:
		var step: int = projected_delta(String(key), float(FORCED_LOAN_REFUSE_FX[key]))


		out[key] = _loan_refuse_floor(step) if String(key) == "tecnico" else step
	return out























func _check_discard() -> bool:
	if descartado():
		return false
	if free_agent or retired or on_loan():
		return false
	if int(contract.get("seasons_left", 9)) > 1:
		return false

	if _market_settled or unsettled or transfer_requested \
			or not pending_precontract.is_empty():
		return false
	if int(contract.get("last_talks_season", -1)) == GameState.season_num:
		return false

	var puerta: bool = can_renew() or list_status() != LIST_NONE \
			or forced_sale or for_sale
	if not puerta:
		return false
	contract["discarded_season"] = GameState.season_num


	var before: Dictionary = rel.duplicate()
	_apply_delta("tecnico", _div_decision_scale(-10.0), REL_BRAKE_EXP_DECISION)
	_apply_delta("equipo", _div_decision_scale(-4.0), REL_BRAKE_EXP_DECISION)
	last_rel_delta = _rel_delta_since(before)
	return true








func _check_stagnation(lines: Array[String]) -> void:
	if free_agent or not loan.is_empty() or retired:
		return
	var before: Variant = _season_start.get("skills", null)
	if not (before is Dictionary):
		return
	var suma: float = 0.0
	for k in SKILL_KEYS:
		suma += float((before as Dictionary).get(k, 0))
	var antes: float = suma / float(SKILL_KEYS.size())
	var growth: float = skills_avg() - antes
	var edge: float = float(standing()["edge"])
	if growth >= Market.GIVE_UP_GROWTH or edge >= Standing.ROT_OUT_EDGE:
		_stagnant_seasons = 0
		return
	_stagnant_seasons += 1
	if not Market.gives_up(growth, edge, _stagnant_seasons):
		return
	club_gave_up = true
	for_sale = true
	_stagnant_seasons = 0
	lines.append(I18n.t("El club deja de contar contigo: buscan salida"))











