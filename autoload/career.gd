func invite_home(guest_id: String) -> int:
	var g: Dictionary = House.guest_by_id(guest_id)
	if g.is_empty() or not can_invite_home():
		return 0




	if int(g.get("level", 0)) > house_level:
		return 0
	var price: int = int(g.get("price", 0))
	if price > 0 and not can_afford(price):
		return 0
	var key: String = String(g["rel"])
	var before: int = int(rel[key])
	money -= price
	week_actions = maxi(0, week_actions - 1)
	house_used = house_used_now().duplicate()
	house_used.append("visita")
	house_used_stamp = _house_week_stamp()
	energy = clampf(energy - 3.0, 0.0, energy_cap())
	_apply_delta(key, _div_decision_scale(
		House.guest_value(guest_id, house_level, house_extras)),
		REL_BRAKE_EXP_DECISION)
	_save()
	changed.emit()
	return int(rel[key]) - before





func _settle_debt() -> void:
	while money < DEBT_FLOOR and not lifestyle.is_empty():
		var worst: String = ""
		var worst_price: int = -1
		for id in lifestyle:
			var price: int = int(Shop.lifestyle_by_id(String(id)).get("price", 0))
			if price > worst_price:
				worst_price = price
				worst = String(id)
		if worst.is_empty():
			return
		var l: Dictionary = Shop.lifestyle_by_id(worst)
		lifestyle.erase(worst)
		if House.COCHES.has(worst):

			var quedan_coches: Array = []
			for it_coche in house_items:
				if String(it_coche.get("kind", "")) != worst:
					quedan_coches.append(it_coche)
				else:
					for capa_coche in house_layout.values():
						(capa_coche as Dictionary).erase(String(it_coche.get("iid", "")))
			house_items = quedan_coches
		money += int(float(worst_price) * 0.4)

		for key in Shop.LIFESTYLE_KEYS:
			var delta: int = int(l.get(key, 0))
			if delta != 0:
				rel[key] = clampi(int(rel[key]) - delta / 2, 0, 100)
		rel["prensa"] = maxi(0, int(rel["prensa"]) - 6)




