func _tu_post(e: Dictionary) -> Dictionary:
	if String(e.get("id", "")) != "redes_triple":
		return e
	var micro: bool = _micro_esta_semana()
	var perdiste: bool = int(GameState.last_match.get("gf", 0)) \
			< int(GameState.last_match.get("gc", 0))
	if not micro and not perdiste:
		return e
	var out: Dictionary = e.duplicate(true)
	for k in ["a", "b", "c", "d", "e"]:
		if not out.has(k):
			continue
		var fx: Dictionary =(out[k] as Dictionary).get("fx", {})
		var rel_fx: Dictionary = fx.get("rel", {})
		if micro:
			fx.erase("titular")
			if float(rel_fx.get("prensa", 0.0)) > 0.0:
				rel_fx.erase("prensa")
		if perdiste and String(fx.get("post", "")) == "yo":
			rel_fx["aficion"] = float(rel_fx.get("aficion", 0.0)) - 4.0
		if rel_fx.is_empty():
			fx.erase("rel")
		else:
			fx["rel"] = rel_fx
	return out




