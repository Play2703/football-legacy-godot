const MAREA_TOP: int = 4
const MAREA_FONDO: int = 4








func _push_club_form(recalcular: bool = true) -> void:
	var pir: Dictionary = {}
	for id in GameState.club_div:
		var cid: String = String(id)

		var pasos: int = Teams.base_div(cid) - int(GameState.club_div[cid])
		if pasos != 0:
			pir[cid] = pasos
	ClubForm.set_pyramid(pir)



	if recalcular:
		_marea = _marea_del_mundo()
	ClubForm.set_perf(_marea)




















	if not recalcular:
		OvrCap.set_corte(_ovr_corte, _ovr_tope)
	_push_seat_dev()











	if recalcular:
		_push_ovr_cap()
		_forma_season = maxi(GameState.season_num, 1)











func _marea_del_mundo() -> Dictionary:
	var out: Dictionary = {}


	if GameState.season_num <= 1:
		return out
	for c in Nations.PLAYABLE:
		var pais: String = String(c)



		var mapa: Dictionary =(Race.table_pull(pais, 1,
			GameState.season_num - 1) as Dictionary).get("map", {})
		if mapa.size() < MAREA_TOP + MAREA_FONDO:
			continue
		var orden: Array = mapa.keys()
		orden.sort_custom(func(a: Variant, b: Variant) -> bool:
			return float(mapa[a]) > float(mapa[b]))
		for i in orden.size():
			if i < MAREA_TOP:
				out[String(orden[i])] = 1
			elif i >= orden.size() - MAREA_FONDO:
				out[String(orden[i])] = -1
	return out












func _push_ovr_cap() -> void:
