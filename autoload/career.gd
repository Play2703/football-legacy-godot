func _cobra_credito_coach(result: Dictionary) -> void:
	var pos: int = int(result.get("league_pos", 0))
	var teams: int = int(result.get("teams", 0))
	if pos <= 0 or teams <= 0 or GameState.player_team_id.is_empty():
		return
	var jornadas: int = maxi(Schedule.league_games(teams), 1)



	if coach_league_matches * 2 < jornadas:
		return








	var div_jugada: int = clampi(GameState.player_div()
		+(1 if bool(result.get("promoted", false)) else 0)
		-(1 if bool(result.get("relegated", false)) else 0), 1, 3)
	var rank: int = _rank_en_censo(GameState.teams_in_div_jugada(
		Teams.country_of(GameState.player_team_id), div_jugada))



	coach_cred += Coach.credito_temporada(pos, rank, teams, coach_nivel(),
		bool(result.get("won_league", pos == 1)), bool(result.get("promoted", false)),
		bool(result.get("relegated", false)), rank == 0)
	_niv_invalida()






func _rank_en_censo(censo: Array) -> int:
	var club: String = GameState.player_team_id
	if club.is_empty() or censo.is_empty():
		return 0
	var mine: int = Squad.strength(club)
	var rank: int = 0
	for raw in censo:
		var tid: String = str(raw) if not (raw is Dictionary) \
				else String((raw as Dictionary).get("id", ""))
		if tid.is_empty() or tid == club:
			continue
		if Squad.strength(tid) > mine:
			rank += 1
	return rank


