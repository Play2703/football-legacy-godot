func leyenda_de_ficha(ficha: Dictionary) -> String:
	if bool(ficha.get("you", false)):
		return ""
	var club: String = String(ficha.get("team", ""))
	var nombre: String = String(ficha.get("name", ""))
	if club.is_empty() or nombre.is_empty():
		return ""
	for p in Squad.of(club):
		var pd: Dictionary = p
		if String(pd.get("name", "")) != nombre:
			continue
		var key: String = Legends.clave_activa(pd)
		if key.is_empty():
			return ""
		var asiento: Dictionary = Legends.asiento_de(key)
		if String(asiento.get("team", "")) != club \
				or String(asiento.get("name", "")) != nombre:
			return ""
		return key
	return ""







func caras_de_gala(podium: Array) -> Dictionary:
	var out: Dictionary = {}
	for f in podium:
		if not (f is Dictionary):
			continue
		var key: String = leyenda_de_ficha(f as Dictionary)
