func _ensure_squad_meta(team_id: String, squad: Array) -> Array:
	var meta: Variant = squad_meta.get(team_id, null)
	if not (meta is Array) or (meta as Array).size() != squad.size():





		meta = SquadMeta.seed(team_id, Teams.country_of(team_id))















		SquadEdits.apply_meta(team_id, meta)









		for _i in maxi(GameState.season_num - 1, 0):
			SquadMeta.advance(meta)




		TransferBook.apply_meta(team_id, meta, GameState.season_num)




		WorldAging.apply_meta(team_id, meta, GameState.season_num)









		RosterDelta.apply_parallel(team_id, meta, false, RosterDelta.meta_de)




		TransferBook.apply_contratos(team_id, meta, GameState.season_num)
		CareerEdits.apply_meta(team_id, meta)
		squad_meta[team_id] = meta
	var en_orden: Array = _meta_en_orden(squad, squad_meta[team_id])









	if team_id == GameState.player_team_id:
		var unico: int = _portero_unico(squad, en_orden)
		if unico >= 0 and unico < en_orden.size():
			Rotation.clava(en_orden[unico])
	return en_orden
















func _portero_unico(squad: Array, meta: Array = []) -> int:
	var unico: int = -1
	for k in squad.size():
		if String((squad[k] as Dictionary).get("pos", "")) != "POR":
			continue
		if k < meta.size() and not Rotation.disponible(meta[k]):
			continue
		if unico >= 0:
			return -1
		unico = k
	if unico < 0 or unico == Squad.user_index(squad):
		return -1
	return unico


















func _meta_en_orden(squad: Array, meta: Array) -> Array:
	var mueve: bool = false
	for i in squad.size():
		if Squad.home_seat(squad, i) != i:
			mueve = true
			break
	if not mueve:
		return meta
	var out: Array = []
	for i in squad.size():
		var h: int = Squad.home_seat(squad, i)
		out.append(meta[h] if h >= 0 and h < meta.size() \
				else SquadMeta.fresh(24, ""))
	return out










