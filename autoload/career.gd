func peldano_jugado() -> float:
	var club: String = GameState.player_team_id
	if club.is_empty() or free_agent or retired:
		return 0.0
	var squad: Array = Squad.of_nominal(club)
	if squad.is_empty():
		return 0.0
	var meta: Array = _ensure_squad_meta(club, squad)
	var mio: int = Squad.user_index(squad)
	var tope: int = season_matches
	for i in mini(squad.size(), meta.size()):
		if i != mio:
			tope = maxi(tope, int((meta[i] as Dictionary).get("gp", 0)))
	if tope <= 0:
		return 0.0
	var titular: int = maxi(season_matches - season_sub_apps, 0)
	return clampf(float(titular) / float(maxi(tope - season_injury_lost, 1)), 0.0, 1.0)







func peldano_puede_capitan() -> bool:
	return _captain_blocked_season != anio_vivo() and not transfer_requested \
			and peldano_jugado() >= Gerencia.PELDANO_JUGADOS \
			and temporadas_en_club(GameState.player_team_id) >= Gerencia.PELDANO_CAPITAN_TEMPORADAS





func temporadas_en_club(club: String) -> int:
	if club.is_empty():
		return 0
	var vistas: Dictionary = {}
	for row in season_history:
		var r: Dictionary = row as Dictionary
		if String(r.get("club", "")) == club and not bool(r.get("loan", false)):
			vistas[int(r.get("season", -1))] = true
	vistas.erase(GameState.season_num)
	return vistas.size() + 1















func peldano_frenado() -> String:
	if free_agent or retired or on_loan() or GameState.player_team_id.is_empty():
		return ""
	if transfer_requested:
		return "pediste"
	if forced_sale or for_sale or unsettled:
		return "en_venta"
	return ""





func peldano_puede_leyenda() -> bool:
	var mio: String = GameState.player_team_id
	return not mio.is_empty() and _club_apps(mio) >= Gerencia.PELDANO_LEYENDA_PARTIDOS














func peldano_vista() -> Dictionary:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or Teams.is_free(mio) or free_agent or retired:
		return {}
	var cedido: bool = on_loan()
	var n: int = peldano()
	if cedido:
		var p: Variant = gerencia.get("peldano", null)
		n = clampi(int((p as Dictionary).get("n", 1)), 1, Gerencia.PELDANO_MAX) \
				if p is Dictionary else 1
	var falta: String = ""
	if n == Gerencia.PELDANO_CAPITAN - 1 and not cedido:
		if _captain_blocked_season == anio_vivo():
			falta = "freno"
		elif temporadas_en_club(mio) < Gerencia.PELDANO_CAPITAN_TEMPORADAS:
			falta = "anios"
		elif peldano_jugado() < Gerencia.PELDANO_JUGADOS:
			falta = "jugar"
	return {"n": n, "relacion": gerencia_relacion(), "cedido": cedido,
		"sube": Gerencia.peldano_umbral(n + 1) if n < Gerencia.PELDANO_MAX else 0,
		"baja": Gerencia.peldano_umbral(n) - Gerencia.peldano_baja(n) if n > 1 else 0,
		"revision": "cierre" if cedido or GameState.season_day >= GameState.winter_day()
			else "invierno",
		"falta_capitan": falta, "jugado": peldano_jugado(),
		"temporadas": 0 if cedido else temporadas_en_club(mio),
		"partidos": 0 if cedido else _club_apps(mio),
		"partidos_min": Gerencia.PELDANO_LEYENDA_PARTIDOS,
		"frenado": peldano_frenado()}













func _revisa_peldano(avg: float, lines: Array[String] = []) -> void:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or Teams.is_free(mio) or free_agent or retired or on_loan() \
			or not pending_precontract.is_empty() or Squad.of_nominal(mio).is_empty():
		return
	var race: Dictionary = captain_race()
	var antes: int = peldano()
	var ahora: int = Gerencia.peldano_revisa(antes, gerencia_relacion(),
		peldano_puede_capitan(), peldano_puede_leyenda())

	var frenado: String = peldano_frenado()
	if not frenado.is_empty():
		ahora = mini(ahora, antes)
	_peldano_fija(ahora)


	gerencia["peldano_foto"] = {"club": mio, "a": Gerencia.aportes(gerencia_ctx())}
	var cinta_perdida: bool = false













	var banca: bool = peldano_jugado() < Gerencia.PELDANO_JUGADOS
	if ahora >= Gerencia.PELDANO_CAPITAN and not is_captain and frenado != "pediste" \
			and not banca:
		is_captain = true
		record_captain_band("club")

		queue_ceremony(Ceremonies.CAPTAIN, {"avg": avg, "via": "nivel"})
	elif is_captain and (ahora < Gerencia.PELDANO_CAPITAN or banca):
		if ahora < Gerencia.PELDANO_CAPITAN:
			_note_captain_lost("nivel", {"nivel": ahora})
		else:
			_note_captain_lost("banca", {"jugado": peldano_jugado()})
		is_captain = false
		cinta_perdida = true

		_drop_queued_captain()
	_fija_capitan_npc(String(race["full"]))
	if ahora > antes and ahora != Gerencia.PELDANO_CAPITAN:
		queue_ceremony(Ceremonies.CLUB_LEVEL, {"mode": "nivel", "n": ahora, "club": mio,
			"rel": gerencia_relacion(), "season": GameState.season_num})
	if ahora < antes:


		if ahora < Gerencia.PELDANO_MESA:
			gerencia.erase("intocable")
			gerencia.erase("renueva")
			gerencia.erase("pide_cese")



		if ahora < Gerencia.PELDANO_CASA:
			gerencia.erase("pide_dt")


		gerencia["peldano_aviso"] = {"antes": antes, "n": ahora, "season": anio_vivo(),
			"day": 0 if GameState._closing_season else GameState.season_day}



	Telemetry.mark("peldano_max", ahora)


	if ahora != antes:
		Telemetry.count("peldano_sube" if ahora > antes else "peldano_baja")
		var nombre: String = I18n.t(Gerencia.peldano_nombre(ahora))
		if ahora > antes:
			lines.append(I18n.tf("Subes de nivel en el club: {0}.", [nombre]))
		else:
			lines.append(I18n.tf("Bajas de nivel en el club: {0}.", [nombre]))
	if cinta_perdida:
		lines.append(I18n.t("Pierdes el brazalete del club."))







