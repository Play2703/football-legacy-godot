			continue
		var pos: String = String(squad[i].get("pos", "MC"))








		var jugo: bool = jugaron.has(i)
		var mins: int = 90
		if not minutos.is_empty():
			mins = int(minutos.get(i, 90 if jugo else 0))
			jugo = jugo or mins > 0



		SquadMeta.tick_match(meta[i], SquadMeta.media_of(squad[i], pos), pos,
			GameState.season_num, team_id, i, jugo, mins)

	_sync_mate_meta_stats(meta, squad)
	_tick_squad_injuries(meta, squad, team_id)





















