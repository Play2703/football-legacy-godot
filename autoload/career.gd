const NPC_LIBRO_SUELO: int = 15


const NPC_LIBRO_OLVIDO: int = 4
const NPC_LIBRO_GUARDA: int = 100




func _npc_libro_suma(race: Array, pais: String, yr: int, liga: bool) -> void:
	var lider: String = String(Race.leader(race, "goals").get("name", "")) if liga else ""
	for e_raw in race:
		var e: Dictionary = e_raw
		var nombre: String = String(e.get("name", ""))
		if nombre.is_empty() or bool(e.get("you", false)) or nombre == player_name:
			continue
		var g: int = int(e.get("goals", 0))
		var a: int = int(e.get("assists", 0))
		if g + a < NPC_LIBRO_SUELO and nombre != lider:
			continue
		var club: String = String(e.get("team", ""))
		var f: Dictionary = npc_carrera.get(nombre, {"club": club, "g": 0, "a": 0,
			"gp": {}, "pich": {}, "t": 0, "ult": -1})
		f["g"] = int(f["g"]) + g
		f["a"] = int(f["a"]) + a
		if not pais.is_empty():
			f["gp"][pais] = int((f["gp"] as Dictionary).get(pais, 0)) + g
		if nombre == lider and not club.is_empty():
			f["pich"][club] = int((f["pich"] as Dictionary).get(club, 0)) + 1

		if int(f["ult"]) != yr:
			f["t"] = int(f["t"]) + 1
			f["ult"] = yr
		if liga and not club.is_empty():
			f["club"] = club
		npc_carrera[nombre] = f


func _npc_libro_poda(yr: int) -> void:
	for nombre in npc_carrera.keys():
		var f: Dictionary = npc_carrera[nombre]
		var g: int = int(f.get("g", 0))
		if g >= NPC_LIBRO_GUARDA:
			continue




		if yr - int(f.get("ult", yr)) >= NPC_LIBRO_OLVIDO \
				or (int(f.get("t", 0)) >= 2 and g < NPC_LIBRO_SUELO * int(f["t"])):
			npc_carrera.erase(nombre)



func _npc_euro_record(race: Array, metric: String, stat: String, yr: int,
		lines: Array) -> void:
	var lider: Dictionary = Race.leader(race, stat)
	var nombre: String = String(lider.get("name", ""))
	if nombre.is_empty() or nombre == player_name or bool(lider.get("you", false)):
		return
	var v: int = int(lider.get(stat, 0))
	var row_raw: Dictionary = Records.euro_row("ucl", metric)
	var key: String = String(row_raw["key"])
	var row: Dictionary = Records.overlay(row_raw, record_marks)
	if v <= int(row["value"]):
		return
	var chain: Array =((record_marks.get(key, {}) as Dictionary)
		.get("chain", []) as Array).duplicate()
	chain.append({"holder": String(row.get("holder", "")),
		"value": int(row.get("value", 0)), "year": int(row.get("year", 0))})
	var m: Dictionary = Records.mark_of(nombre, v, yr)
	m["chain"] = chain
	m["npc"] = true
	m["club"] = String(lider.get("team", ""))
	record_marks[key] = m
	lines.append(I18n.tf("{0} reescribió el libro: {1} ({2})",
		[nombre, String(row.get("label", "")), v]))






func _npc_record(race: Array, stat: String, key: String, country: String,
		yr: int, lines: Array) -> void:
	var lider: Dictionary = Race.leader(race, stat)
	var nombre: String = String(lider.get("name", ""))
	if nombre.is_empty() or nombre == player_name or bool(lider.get("you", false)):
		return
	var v: int = int(lider.get(stat, 0))
	for row_raw in Records.league(country):

		if String(row_raw["base"]) != Records.base_liga(key):
			continue
		key = String(row_raw["key"])
		var row: Dictionary = Records.overlay(row_raw, record_marks)
		if v <= int(row["value"]):
			return
		var chain: Array =((record_marks.get(key, {}) as Dictionary)
			.get("chain", []) as Array).duplicate()
		chain.append({"holder": String(row.get("holder", "")),
			"value": int(row.get("value", 0)), "year": int(row.get("year", 0))})
		var m: Dictionary = Records.mark_of(nombre, v, yr)
		m["chain"] = chain
		m["npc"] = true





		m["club"] = String(lider.get("team", ""))
		record_marks[key] = m
		lines.append(I18n.tf("{0} reescribió el libro: {1} ({2})",
			[nombre, I18n.t(String(row.get("label", ""))), v]))
		return































func _check_legends() -> void:
	if GameState.readonly_save:
		return


	var you: Dictionary = Legends.career_flat(Legends.user_entry())
	var t_mine: float = float(Legends.total(you))
	var t_rows: Array = LEGEND_PASS.trophy_rows(Legends.board_rivals())
	var t_new: Array = LEGEND_PASS.newly_passed(t_rows, t_mine,
		_legends_passed_in(LEGEND_PASS.TROPHIES))

	var g_mine: float = float(GameState.legend_goals + GameState.legend_assists)
	var g_rows: Array = LEGEND_PASS.scorer_rows(Legends.scorer_rivals())
	var g_new: Array = LEGEND_PASS.newly_passed(g_rows, g_mine,
		_legends_passed_in(LEGEND_PASS.GOALS))
	if t_new.is_empty() and g_new.is_empty():
		return





	_mark_legends_passed(LEGEND_PASS.TROPHIES, t_new)
	_mark_legends_passed(LEGEND_PASS.GOALS, g_new)
	t_new = t_new.filter(func(r): return not legends_passed.has(String(r.get("key", ""))))
	g_new = g_new.filter(func(r): return not legends_passed.has(String(r.get("key", ""))))
	for row in t_new + g_new:

		var who: String = String((row as Dictionary).get("key", ""))
		if not legends_passed.has(who):
			legends_passed.append(who)








	if _check_historia():
		return
	if _check_historia_trofeos():
		return


	if t_new.is_empty() and g_new.is_empty():
		return
	var goals: bool = t_new.is_empty()
	var hit: Dictionary = LEGEND_PASS.biggest(g_new if goals else t_new)
	var kind: String = LEGEND_PASS.GOALS if goals else LEGEND_PASS.TROPHIES
	var mine_shown: int = int(g_mine) if goals else Legends.total(you)
	var left: int = LEGEND_PASS.ahead(g_rows if goals else t_rows,
		g_mine if goals else t_mine)


	var key: String = String(hit.get("key", hit.get("name", "")))
	queue_ceremony(Ceremonies.LEGEND, LEGEND_PASS.payload(kind, hit, mine_shown, left,
		Legends.asiento_de(key), GameState.player_team_id,
		Legends.cara_de(key, String(hit.get("name", "")))))



	Achievements.check()
















