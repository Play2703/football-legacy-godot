const SHOT_REF_KMH: float =(3.459 + 47.026) * 0.5355 * 3.6

const SHOT_SPREAD_DEG_REF: float = 3.4

const HEADER_POWER_REF: float = 0.78


















const CHASE_MAX_REF: float = 4.55


const AIM_REF_DIST: float = 18.0



func shot_kmh() -> float:
	return SHOT_REF_KMH * power_mult()



func header_kmh() -> float:
	return SHOT_REF_KMH * HEADER_POWER_REF * header_mult()





func aim_spread_m() -> float:
	return AIM_REF_DIST * tan(deg_to_rad(SHOT_SPREAD_DEG_REF) *(1.0 - accuracy()))






func skill_gauge(key: String) -> String:
	match key:
		"potencia":
			return I18n.tf("TU TIRO: {0} KM/H", [roundi(shot_kmh())])
		"precision":
			var half: float = aim_spread_m()
			if half <= 0.005:
				return I18n.t("SIN ABANICO: EL BALÓN VA POR DONDE APUNTAS")
			return I18n.tf("A {0} M EL BALÓN SALE DENTRO DE ±{1} CM",
				[roundi(AIM_REF_DIST), roundi(half * 100.0)])
		"efecto":
			return I18n.tf("COMBA ×{0}", ["%.2f" % curve_mult()])
		"vision":
			if sees_offside_line():
				return I18n.t("VES LA LÍNEA DE FUERA DE JUEGO EN LA CANCHA")
			return I18n.tf("TE FALTAN {0} PARA VER LA LÍNEA DE FUERA DE JUEGO",
				[VISION_OFFSIDE_MIN - int(skills.get("vision", 0))])
		"fisico":
			return I18n.tf("TU CABEZAZO: {0} KM/H", [roundi(header_kmh())])
		"velocidad":








			return I18n.tf("CORRES A {0} M/S · EL DEFENSA MÁS RÁPIDO, {1}", [
				"%.1f" % Duel.run_speed(speed_norm()), "%.1f" % CHASE_MAX_REF])
		"aceleracion":


			return I18n.tf("DE PARADO A TU MÁXIMA EN {0} S", [
				"%.2f" %(Duel.run_speed(speed_norm()) / Duel.run_accel(accel_norm()))])
		"regate":
			return I18n.tf("TE ROBAN A {0} CM DEL BALÓN", [
				roundi(Duel.steal_radius(control_norm()) * 100.0)])
		"penal", "parado":
			var share: float = set_piece_share(key)
			if share >= 1.0:
				return I18n.t("LOS COBRAS TODOS")
			return I18n.tf("COBRAS {0} DE CADA 10", [roundi(share * 10.0)])
	return ""


























































