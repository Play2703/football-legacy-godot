func _archiva_ligas_del_mundo(result: Dictionary, div_jugada: int = -1) -> void:
	var temporada: int = GameState.season_num - 1
	var mio: String = String(result.get("league_champion", ""))

	var mi_pais: String = Teams.country_of(GameState.player_team_id)






	var mi_div: int = div_jugada if div_jugada > 0 else clampi(GameState.player_div()
		+(1 if bool(result.get("promoted", false)) else 0)
		-(1 if bool(result.get("relegated", false)) else 0), 1, 3)









	var ya_apuntados: Array = []
	if mi_div == 1:
		ya_apuntados =(result.get("league_champions", []) as Array).duplicate()
		if ya_apuntados.is_empty():
			ya_apuntados = [mio]

	var hay_foto: bool = GameState.last_season_snap.has("copas") \
			and int(GameState.last_season_snap.get("season", -1)) == temporada
	var copas_foto: Dictionary = GameState.last_season_snap.get("copas", {}) if hay_foto else {}


	var ligas_w: String = _ganador_ligas(temporada)
	for c in Nations.PLAYABLE:
		var pais: String = String(c)
		if not _fila_liga(pais, temporada).is_empty():
			continue
		var campeon: String = ""
		var sub: String = ""
		var colista: String = ""



		var superlider: String = ""


		var top: Array = []
		if pais == mi_pais and mi_div == 1 and not mio.is_empty():
			campeon = mio
			superlider = String(result.get("superlider", ""))


			var orden: Array = GameState.last_league_order
			if orden.size() >= 2:
				sub = String(orden[1])
				colista = String(orden[orden.size() - 1])
				top = orden.slice(0, SupercopaNacional.TOP)



			var ru: String = String(result.get("league_runner_up", ""))
			if not ru.is_empty():
				sub = ru



		if Liguilla.aplica(pais, 1) and (campeon.is_empty() or sub.is_empty()
				or superlider.is_empty()):
			var lg: Dictionary = SimLeague.liguilla(pais, 1, temporada,
				GameState.teams_in_div_jugada(pais, 1))
			if superlider.is_empty():
				superlider = String(lg.get("superlider", ""))
			if campeon.is_empty():
				campeon = String(lg.get("winner", ""))
			if sub.is_empty():
				sub = String(lg.get("runner_up", ""))
		if campeon.is_empty() or sub.is_empty() or colista.is_empty():
			var tabla: Array = SimLeague.table(pais, 1, temporada, 1.0,
				GameState.teams_in_div_jugada(pais, 1))
			if tabla.size() < 2:
				continue
			if campeon.is_empty():
				campeon = String((tabla[0] as Dictionary)["id"])
			if sub.is_empty():
				sub = String((tabla[1] as Dictionary)["id"])
			if top.is_empty():
				for fila_t in tabla.slice(0, SupercopaNacional.TOP):
					top.append(String((fila_t as Dictionary)["id"]))
			if colista.is_empty():
				colista = String((tabla[tabla.size() - 1] as Dictionary)["id"])
		var fila_liga: Dictionary = {"season": temporada, "country": pais,
			"champion": campeon, "runner_up": sub, "last": colista}
		if not superlider.is_empty():
			fila_liga["superlider"] = superlider




		var ap: Dictionary = _apertura_del_mundo(pais, temporada,
			pais == mi_pais and mi_div == 1 and not mio.is_empty(), result)
		fila_liga.merge(ap)



		if not ap.is_empty():
			fila_liga["anual"] = _anual_top(pais, temporada,
				pais == mi_pais and mi_div == 1 and not mio.is_empty())
		var cdc: String = _campeon_de_campeones(pais, temporada)
		if not cdc.is_empty():
			fila_liga["campeones"] = cdc
			_add_club_title(cdc, "campeones")










		var copa_cierre: Dictionary = copas_foto.get(pais, {})
		var copa_w: String = String(copa_cierre.get("w", "")) if hay_foto \
				else CopaMundo.campeon(pais)



		if pais == mi_pais and FormatoCopa.tiene(pais, FormatoCopa.COPA):
			var cw_mio: String = GameState._euro_sim_id(String(result.get("cup_winner_id", "")))
			if not cw_mio.is_empty():
				copa_w = cw_mio
		if not copa_w.is_empty():
			fila_liga["copa"] = copa_w


		if SupercopaNacional.es_f4(pais):
			var copa_s: String = String(copa_cierre.get("s", "")) if hay_foto \
					else CopaMundo.finalista(pais)


			if copa_s == copa_w:
				copa_s = ""
			if not copa_s.is_empty():
				fila_liga["copa_sub"] = copa_s
			if top.size() >= 2:
				fila_liga["top"] = top
		var sc: String = _ganador_supercopa(pais, temporada, fila_liga)
		if not sc.is_empty():
			fila_liga["supercopa"] = sc
			_add_club_title(sc, "supercopa")


		var cl: String = _ganador_copaliga(pais, temporada)
		if not cl.is_empty():
			fila_liga["copaliga"] = cl
			_add_club_title(cl, "copaliga")
		if not ligas_w.is_empty() and pais == Teams.country_of(ligas_w):
			fila_liga["ligas"] = ligas_w
			_add_club_title(ligas_w, "ligas")
		league_history.append(fila_liga)
		var titulos: Array = [campeon]
		if not String(ap.get("champion_ap", "")).is_empty():
			titulos.push_front(String(ap["champion_ap"]))
		for t in titulos:
			if ya_apuntados.has(t):
				ya_apuntados.erase(t)
			else:
				_add_club_title(String(t), "liga")








func _apertura_del_mundo(pais: String, temporada: int, mia: bool,
		result: Dictionary) -> Dictionary:
	if not Liguilla.aplica(pais, 1):
		return {}
	var lg: Dictionary = {}
	if mia:
		for x in result.get("liguillas", []):
			if int((x as Dictionary).get("torneo", -1)) == Liguilla.APERTURA:
				lg = x
	else:
		lg = SimLeague.liguilla(pais, 1, temporada,
			GameState.teams_in_div_jugada(pais, 1), Liguilla.APERTURA)
	if String(lg.get("winner", "")).is_empty():
		return {}
	return {"champion_ap": String(lg["winner"]),
		"runner_up_ap": String(lg.get("runner_up", "")),
		"superlider_ap": String(lg.get("superlider", ""))}






func _anual_top(pais: String, temporada: int, mia: bool) -> Array:
	var orden: Array = GameState.last_league_order if mia else []
	if orden.size() >= 2:
		return [String(orden[0]), String(orden[1])]
	var out: Array = []
	for r in SimLeague.table(pais, 1, temporada, 1.0,
			GameState.teams_in_div_jugada(pais, 1)).slice(0, 2):
		out.append(String((r as Dictionary)["id"]))
	return out







func campeones_de(pais: String, temporada: int) -> Array:
