					"continental":
						fila["icon"] = "seleccion"
						fila["label"] = I18n.t("CAMPEON CONTINENTAL")
					"bota_mundial":
						fila["icon"] = "tienda"
						fila["label"] = I18n.t("BOTA DEL MUNDIAL")
					"mejor_mundial":

