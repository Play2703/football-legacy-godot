func _resolve_bids(hot: bool) -> void:
	if pending_offers.is_empty():
		return


	var antes: Dictionary = {}
	for o in pending_offers:
		antes[String(o.get("id", ""))] = int(o.get("fee", 0))
	Market.apply_bidding(pending_offers)
	for o in pending_offers:
		var id: String = String(o.get("id", ""))
		if int(o.get("rivals", 0)) > 0 and antes.has(id) \
				and int(o.get("fee", 0)) > int(antes[id]):
			_market_note(TAG_BID_WAR, Market.club_name(o, ""), id)





	var vivas: Array = []
	for o in pending_offers:






		if bool(o.get("pre", false)):
			if pending_precontract.is_empty() and Market.pre_war_raise(o, pending_offers):
				_market_note(TAG_BID_WAR, Market.club_name(o, ""), String(o.get("id", "")))
			vivas.append(o)
			continue
		if bool(o.get("free", false)) \
				or bool(o.get("option", false)) or bool(o.get("buyback", false)) \
				or pays_clause(o):
			vivas.append(o)
			continue
		var nombre: String = Market.club_name(o, "")
		var id2: String = String(o.get("id", ""))
		var ask_o: int = ask_for(o)
		if int(o.get("bid", 0)) >= ask_o:



			if not bool(o.get("deal_told", false)):
				o["deal_told"] = true
				_market_note(TAG_BID_DEAL, nombre, id2)
			vivas.append(o)
			continue

		var roll: float = randf()
		if hot:
			roll *= 0.6
		if Market.bid_raises(o, roll):
			o["bid"] = Market.raised_bid(o)
			if int(o["bid"]) >= ask_o:
				o["deal_told"] = true
				_market_note(TAG_BID_DEAL, nombre, id2)
			else:
				_market_note(TAG_BID_UP, nombre, id2)
			vivas.append(o)
			continue


		if int(o.get("bid", 0)) >= int(float(int(o.get("fee", 0)))
				* Market.BID_CEILING):
			if not bool(o.get("stuck_told", false)):
				o["stuck_told"] = true
				_market_note(TAG_BID_STUCK, nombre, id2)




			if randf() < BID_WALK_P:
				_market_note(TAG_BID_OFF, nombre, id2, true)
				_remember_missed(id2)
				continue
		vivas.append(o)
	pending_offers = vivas






const BUYBACK_WORTH: float = 1.25






const BID_WALK_P: float = 0.085










func _market_newcomer(days_left: int, cap: int, prefer_country: String = "") -> bool:
	if pending_offers.size() >= cap:
		return false
	var seen: Dictionary = {}




	var by_league: Dictionary = {}
	for o in pending_offers:
		seen[String(o.get("id", ""))] = true
		var lg: String = String(o.get("league", ""))
		by_league[lg] = int(by_league.get(lg, 0)) + 1


	for id in _market_rejected:
		seen[String(id)] = true
	for id in _club_vetos.keys():
		if club_vetado(String(id)):
			seen[String(id)] = true





	var viejo_mister: String = coach_pull_club()
	var pool: Array = Market.candidates(scout_profile(), GameState.player_team_id,
		_market_floor(), false, viejo_mister,
		Market.EX_CLUB_PULL if not viejo_mister.is_empty() else Market.AGENT_PULL)







	if list_status() == LIST_SALE and _pool_exhausted(pool, seen, by_league):
		pool = Market.candidates(scout_profile(), GameState.player_team_id, 0.02, true)



	if not prefer_country.is_empty():
		var de_ahi: Array = []
		var resto: Array = []
		for cand in pool:
			if String(cand.get("league", "")) == prefer_country:
				de_ahi.append(cand)
			else:
				resto.append(cand)
		pool = de_ahi + resto
	for cand in pool:
		if seen.has(String(cand.get("id", ""))):
			continue





		var lg_c: String = String(cand.get("league", ""))
		var tope: int = Market.AGENT_LEAGUE_MAX \
				if not prefer_country.is_empty() and lg_c == prefer_country \
				else Market.OFFER_MAX_PER_LEAGUE
		if int(by_league.get(lg_c, 0)) >= tope:
			continue





		var fade: float = Market.reject_fade(_market_rejected.size())
		if fade < 1.0:
			var club_f: Dictionary = Teams.by_id(String(cand.get("id", "")))
			if not club_f.is_empty():
				cand = Market.offer_for(club_f, scout_profile(),
					float(cand.get("interest", 0.0)) * fade)
		cand["expires"] = GameState.season_day + Market.offer_life(days_left, randf()) - 1
		pending_offers.append(cand)
		if fade < 1.0:
			_market_note(TAG_FADE, Market.club_name(cand, ""),
				String(cand.get("id", "")))


		var por_encargo: bool = not prefer_country.is_empty() \
				and String(cand.get("league", "")) == prefer_country
		_market_note(TAG_AGENT_NEW if por_encargo else TAG_NEW,
			Market.club_name(cand, ""), String(cand.get("id", "")))


		if por_encargo:
			agent_result = {"ok": true, "name": Market.club_name(cand, ""),
				"tag": TAG_AGENT_NEW}
		return true
	return false





func _pool_exhausted(pool: Array, seen: Dictionary, by_league: Dictionary) -> bool:
	for cand in pool:
		if seen.has(String(cand.get("id", ""))):
			continue
		if int(by_league.get(String(cand.get("league", "")), 0)) \
				>= Market.OFFER_MAX_PER_LEAGUE:
			continue
		return false
	return true




const REPLACEMENT_BOOST: float = 1.5


const REPLACEMENT_MAX: int = 1








func _seed_market_replacements(window_id: String) -> void:
	var cap: int = _offer_cap()
	if pending_offers.size() >= cap:
		return

	var first_day: int = Market.SUMMER_DAY if window_id == Market.WINDOW_SUMMER \
			else Market.winter_first(GameState.winter_day())

	var lost: Dictionary = {}
	var refilled: Dictionary = {}
	for n in market_news:
		if int(n.get("season", -1)) != GameState.season_num \
				or int(n.get("day", -1)) < first_day:
			break






		var vecino: String = String((Squad.POS_AFFINITY.get(Squad.USER_POS, ["CAM"]) as Array)[0])
		var pos_n: String = String(n.get("pos", ""))
		if pos_n != Squad.USER_POS and pos_n != vecino:
			continue
		var to_id: String = String(n.get("to", ""))
		if not to_id.is_empty():
			refilled[to_id] = true
		var from_id: String = String(n.get("from", ""))
		if not from_id.is_empty():
			lost[from_id] = true
	if lost.is_empty():
		return
	var present: Dictionary = {}
	for o in pending_offers:
		present[String(o.get("id", ""))] = true
	for id in _market_rejected:
		present[String(id)] = true
	for id in _club_vetos.keys():
		if club_vetado(String(id)):
			present[String(id)] = true


	var seeded: int = 0
	for cand in Market.candidates(scout_profile(), GameState.player_team_id,
			_market_floor()):
		var id: String = String(cand.get("id", ""))
		if not lost.has(id) or refilled.has(id) or present.has(id):
			continue


		var club: Dictionary = Teams.by_id(id)
		var p: float = minf(float(cand.get("interest", 0.0)) * REPLACEMENT_BOOST, 0.95)
		var offer: Dictionary = Market.offer_for(club, scout_profile(), p)
		offer["gap"] = true
		offer["expires"] = GameState.season_day + Market.offer_life(
			Market.window_days_left(GameState.season_day, GameState.winter_day()),
			randf()) - 1
		pending_offers.append(offer)
		_market_note(TAG_GAP, Market.club_name(offer, ""), id)
		seeded += 1
		if seeded >= REPLACEMENT_MAX or pending_offers.size() >= cap:
			break







