func renegotiation_offer() -> Dictionary:
	var base: Dictionary = _offer_from_terms(ContractTerms.Table.RENOVACION)







	var wage_now: int = int(contract["wage"])
	var negotiated: bool = int(contract.get("talks_season", -1)) == GameState.season_num \
			and int(contract.get("talks_wage", 0)) > 0

	base["wage"] = _talks_wage(int(base["wage"])) if negotiated \
			else maxi(int(round(float(base["wage"]) * rasgo_club("oferta"))), wage_now)
	base["delta"] = int(base["wage"]) - wage_now

	var role_now: Standing.ContractRole = Standing.contract_role_from_key(String(contract.get("role", "rotacion")))
	var role_off: Standing.ContractRole = Standing.contract_role_from_key(String(base["role"]))
	var role_final: Standing.ContractRole = role_off if role_off > role_now else role_now
	base["role"] = Standing.contract_role_key(role_final)
	base["role_name"] = Standing.contract_role_name(role_final)
	base["role_up"] = role_final > role_now



	var grant: Dictionary = ContractTerms.perf_bonus_grant(float(base["stature"]))
	var goal_now: float = float(contract.get("goal_bonus", 0.0))
	var assist_now: float = float(contract.get("assist_bonus", 0.0))
	var goal_new: float = snappedf(maxf(goal_now, float(grant["goal"])), 0.01)
	var assist_new: float = snappedf(maxf(assist_now, float(grant["assist"])), 0.01)
	base["goal_bonus"] = goal_new
	base["assist_bonus"] = assist_new

	var cl: Dictionary = _clausulas_club_vigentes("reneg")
	if not cl.is_empty():
		_aplica_clausulas_club(base, cl)
	base["goal_bonus_add"] = snappedf(maxf(0.0, float(base["goal_bonus"]) - goal_now), 0.01)
	base["assist_bonus_add"] = snappedf(maxf(0.0, float(base["assist_bonus"]) - assist_now),
		0.01)
	return base






func accept_renegotiation() -> void:




	if not renegotiation_open():
		return
	if not bool(renegotiation_gate()["ok"]):
		return
	var offer: Dictionary = renegotiation_offer()
	contract["wage"] = int(offer["wage"])

	contract["seasons_left"] = int(offer["total"])
	contract["role"] = String(offer["role"])
	contract["goal_bonus"] = float(offer["goal_bonus"])
	contract["assist_bonus"] = float(offer["assist_bonus"])
	contract["last_talks_season"] = GameState.season_num
	contract["talks_open_season"] = -1

	contract["talks_wage"] = 0
	_role_climb = 0





	_stamp_clause(GameState.player_team_id, bool(contract.get("clause_libre", false)),
		bool(contract.get("clause_bandera", false)))

	_stamp_clausulas_club(offer)
	rel["aficion"] = mini(100, int(rel["aficion"]) + 5)

	counter_offer = {}


	queue_ceremony(Ceremonies.PRESSER, {
		"mode": "renewal", "seasons": int(contract["seasons_left"]),
		"wage": int(contract["wage"]),
	})

	_offer_contract_shirt(SHIRT_MODE_RENEW)
	_save()
	changed.emit()









