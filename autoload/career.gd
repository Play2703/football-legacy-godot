					[String(c["name"]), Sponsors.BURN_SEASONS]))
	_sync_sponsor_rel()


















func _apply_age_decline(lines: Array[String]) -> void:
	if age <= DECLINE_AGE:
		return




	var df: int = int(DECLINE_FIS.get(age, DECLINE_FIS[44] if age > 44 else 0))
	var dt: int = int(DECLINE_TEC.get(age, DECLINE_TEC[44] if age > 44 else 0))





	var real_f: int = 0
	var real_t: int = 0
	for k in SKILL_KEYS:
		var fis: bool = WorldAging.FISICAS.has(k)
		var drop: int = df if fis else dt
		var before: int = int(skills[k])
		var after: int = maxi(before - drop, 20)
		if after < before:
			skills[k] = after
			if fis:
				real_f = maxi(real_f, before - after)
			else:
				real_t = maxi(real_t, before - after)



	if real_f > 0 and real_t > 0:
		lines.append(I18n.tf("Los años pesan: -{0} en lo físico y -{1} en lo técnico",
			[real_f, real_t]))
	elif real_f > 0:
		lines.append(I18n.tf("Los años pesan: -{0} en lo físico", [real_f]))
	elif real_t > 0:
		lines.append(I18n.tf("Los años pesan: -{0} en lo técnico", [real_t]))


	energy = minf(energy, energy_cap())








const SECUELA_DROP: int = 6
func _apply_injury_secuela() -> void:
	for k in ["fisico", "velocidad"]:
		if skills.has(k):
			skills[k] = maxi(int(skills[k]) - SECUELA_DROP, 20)


	energy = minf(energy, energy_cap())






func _career_milestones() -> Array:
	var out: Array = []
	var checks: Array = [
		["partidos", GameState.matches_played, season_matches, 100],
		["goles", GameState.career_goals, season_goals, 50],
		["asistencias", GameState.career_assists, season_assists, 50],
	]
	for c in checks:
		var total: int = int(c[1])
		var antes: int = total - int(c[2])
		var step: int = int(c[3])
		if total / step > antes / step:
			out.append({"kind": String(c[0]), "mark":(total / step) * step})
	return out






