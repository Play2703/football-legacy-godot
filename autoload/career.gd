	}



























func tu_veredicto_mercado() -> Dictionary:
	var est: Dictionary = estatus_club()
	var st: Dictionary = standing()
	var cc: Dictionary = _coach_ctx()

	var avg: float = season_avg()
	var matches: int = season_matches
	if matches < ContractTerms.PERF_MIN_MATCHES and not season_history.is_empty():
		var fila: Dictionary = season_history.back()
		if int(fila.get("apps", 0)) > matches:
			matches = int(fila.get("apps", 0))
			avg = float(fila.get("avg", avg))




	var obj_ratio: float = -1.0
	var od: Variant = last_report.get("obj_done", {})
	if od is Dictionary and int((od as Dictionary).get("target", 0)) > 0 \
			and String((od as Dictionary).get("type", "")) != "position":
		obj_ratio = float(int((od as Dictionary).get("progress", 0))) \
				/ float(maxi(int((od as Dictionary).get("target", 1)), 1))
	else:
		var pace: Dictionary = objective_pace()
		if int(pace.get("target", 0)) > 0 and String(pace.get("type", "")) != "position":
			obj_ratio = float(int(pace.get("done", 0))) \
					/ float(maxi(int(pace.get("target", 1)), 1))

	var club_score: float = -1.0
	var club_pos: int = 0
	var club_expected: int = 0
	if not season_history.is_empty():
		club_score = _club_goals_score
	elif GameState.league_started():
		club_score = _club_goals_score_vivo()
	if GameState.league_started():
		club_pos = int(cc.get("pos", 0))
		club_expected = int(cc.get("expected", 0))

	var vctx: Dictionary = {
		"avg": avg,
		"matches": matches,
		"form": form,
		"edge": float(st.get("edge", 0.0)),
		"value": market_value(),
		"obj_ratio": obj_ratio,
		"club_score": club_score,
		"club_pos": club_pos,
		"club_expected": club_expected,
		"winless": int(cc.get("winless", 0)),
		"at_stake": _club_season_at_stake(),
		"blocks_sale": club_blocks_sale(),
		"list": list_status(),
		"loyalty": loyalty_seasons(),
	}
	var v: Dictionary = Market.veredicto_salida(vctx)
	return {
		"nivel": int(v.get("nivel", 1)),
		"por_que": String(v.get("por_que", "club_salvado")),
		"riesgo": float(v.get("riesgo", 0.25)),
		"etiqueta": String(est.get("sitio", "")),
		"mala": bool(est.get("sitio_malo", false)),



		"hundido": Market.club_hundido(vctx),
	}





func _club_goals_score_vivo() -> float:
	var filas: Array = club_goals_live()
	if filas.is_empty():
		return -1.0
	var hechas: float = 0.0
	for f in filas:
		if bool((f as Dictionary).get("done", false)):
			hechas += 1.0
	return hechas / float(filas.size())





const LOWLY_TABLE_FRACTION: float = 0.6


const LOWLY_TABLE_MIN_PJ: int = 4










func next_rival_lowly() -> bool:
	var f: Dictionary = GameState.current_fixture()
	if f.is_empty() or String(f.get("comp", "league")) != "league":
		return false
	var rival: Dictionary = GameState.current_rival()
	var rid: String = String(rival.get("id", ""))
	if rid.is_empty():
		return false
	var rows: Array = GameState.league_standings()
	if rows.is_empty():
		return false
	var played: int = 0
	for row in rows:
		played = maxi(played, int(row.get("pj", 0)))
	if played < LOWLY_TABLE_MIN_PJ:

		var mine: int = Squad.strength(GameState.player_team_id)
		var weaker: int = 0
		var total: int = 0
		for row in rows:
			var key: String = String(row.get("key", ""))
			var id: String = GameState.player_team_id if key == GameState.YOU_KEY else key
			if id == GameState.player_team_id:
				continue
			total += 1
			if Squad.strength(id) < Squad.strength(rid):
				weaker += 1
		if total <= 0:
			return false

		return float(weaker) / float(total) <= 1.0 - LOWLY_TABLE_FRACTION \
				and Squad.strength(rid) < mine
	for i in rows.size():
		if String(rows[i].get("key", "")) != rid:
			continue
		return float(i) >= float(rows.size()) * LOWLY_TABLE_FRACTION
	return false










