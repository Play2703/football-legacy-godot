func _apply_delta(key: String, delta: float,
		brake_exp: float = REL_BRAKE_EXP) -> void:










	if rel_derivada(key):
		if OS.is_debug_build():
			push_warning("rel['%s'] es DERIVADO: el delta %+.1f se ignora (ver Career.REL_DERIVADAS)"
				% [key, delta])
		return
	var r: Dictionary = _delta_step(key, delta, brake_exp)
	rel_frac[key] = float(r["frac"])
	rel[key] = int(r["value"])







func _apply_nat_delta(key: String, delta: float) -> void:
	var current: float = float(nat_rel.get(key, 50))
	delta = _dramatize(delta)
	var room: float =(100.0 - current) if delta > 0.0 else current
	var t: float = clampf(room / 50.0, 0.0, 1.0)
	var brake: float = pow(t, REL_BRAKE_EXP) if delta > 0.0 else maxf(t, REL_BRAKE_FLOOR)
	var raw: float = delta * brake + float(nat_rel_frac.get(key, 0.0))
	var step: int = int(raw)
	var wanted: int = int(current) + step
	var next: int = clampi(wanted, 0, 100)
	nat_rel[key] = next
	nat_rel_frac[key] =(raw - float(step)) if next == wanted else 0.0






const NAT_REL_STEP: float = 4.0


















