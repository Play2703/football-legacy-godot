	if Teams.by_id(opponent_id).is_empty() \
			and not Nations.by_id(Nations.canon_id(opponent_id)).is_empty():
		return Rivalries.nations_are_rivals(nationality, opponent_id)
	return opponent_id == rival_id \
			or Rivalries.are_rivals(GameState.player_team_id, opponent_id)




