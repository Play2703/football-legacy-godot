func salida_ventana_alcanzable(via: String) -> bool:
	if via == Salida.VIA_CESION:
		return loan_window_open()
	if _market_settled or on_loan():
		return false
	return GameState.season_day <= Market.winter_last(GameState.winter_day())






func salida_bloqueo(via: String) -> String:
	if retired or free_agent:
		return "libre"
	if on_loan():
		return "cedido"

	if not pending_precontract.is_empty():
		return "precontrato"

	if forced_sale or for_sale or unsettled:
		return "club"
	if via == Salida.VIA_TRASPASO:
		if transfer_requested:
			return "ya_pedida"
		if not salida_ventana_alcanzable(via):
			return "ventana"
		return ""
	if via == Salida.VIA_CESION:

		if transfer_requested:
			return "ya_pedida"
		if loan_listed or forced_loan:
			return "ya_pedida"
		if not salida_ventana_alcanzable(via):
			return "ventana"
		if Standing.contract_role_from_key(String(contract.get("role", "rotacion"))) \
				>= Standing.ContractRole.TITULAR:
			return "titular"
		return ""
	return "via"















func pacto_bloqueo() -> String:
	var club: String = GameState.player_team_id
	if club.is_empty() or transfer_requested:
		return "ya_pedida"
	if _market_settled or not _calendario_abierto() \
			or GameState.season_day > Market.summer_last():
		return "verano"
	if club_seasons(club).size() < 2:
