		round_id: String = "") -> bool:
	var hilo: Variant = idolo_escenas.get("_hilo", null)
	if not (hilo is Dictionary) or not (hilo as Dictionary).has("rival_pendiente"):
		return false
	var pend: Dictionary = hilo["rival_pendiente"]
	(hilo as Dictionary).erase("rival_pendiente")
	if opp.is_empty() or String(pend.get("opp", "")) != opp or minutes <= 0:
		return false
	var fx: Dictionary = GameState.current_fixture()
	var shirt: Dictionary = Keepsakes.make_shirt(
		GameState.season_num, String(GameState.you_team().get("id", "")), opp, comp,
		bool(fx.get("home", true)), int(match_ctx.get("gf", 0)), int(match_ctx.get("ga", 0)),
		String(pend.get("who", "")), int(pend.get("seat", -1)), int(pend.get("number", 0)),
		GameState.shirt_number_now(), round_id, "", int(pend.get("ovr", 0)), _is_final(fx),
		true)
	shirt = _suerte_playera(shirt, opp, int(pend.get("seat", -1)), true)
	keepsakes = Keepsakes.push(keepsakes, shirt)
	queue_ceremony(Ceremonies.KEEPSAKE, {
		"mode": "shirt", "keepsake": shirt, "div": GameState.player_div(),
	})
	return true








