func squad_roster() -> Array:
	var team_id: String = GameState.player_team_id
	var squad: Array = Squad.of_nominal(team_id)
	if squad.is_empty():
		return []
	var meta: Array = _ensure_squad_meta(team_id, squad)




	var pen_taker: String = _taker_name("penal", team_id)
	var set_taker: String = _taker_name("parado", team_id)
	var rows: Array = []



	var mio: int = Squad.user_index(squad)





	for i in Squad.plan_order(team_id):
		var p: Dictionary = squad[i]
		var pos: String = String(p.get("pos", "MC"))
		if i == mio:



			rows.append(_own_roster_row(p))
		var pm: Dictionary = meta[i]
		var media: int = SquadMeta.media_of(p, pos)
		var value: int = SquadMeta.value_of(pm, media, pos,
			float(SquadMeta.ovr_of(p, pos)))
		var contract: int = int(pm.get("contract", 1))
		rows.append({
			"name": String(p.get("name", "")),
			"pos": pos,
			"number": int(p.get("number", i + 1)),
			"media": media,
			"nation": String(pm.get("nation", Teams.country_of(team_id))),
			"age": int(pm.get("age", 26)),
			"contract": contract,
			"value": value,
			"fee": SquadMeta.fee_of(value, contract),


			"wage": SquadMeta.wage_of(media, int(pm.get("age", 26)),
				Teams.rating(team_id), team_id),
			"gp": int(pm.get("gp", 0)),
			"goals": int(pm.get("goals", 0)),
			"assists": int(pm.get("assists", 0)),
			"avg": SquadMeta.season_avg(pm),


			"injury_weeks": int(pm.get("injury_weeks", 0)),




			"se_va": bool(pm.get("se_va", false)),
			"pre": String(pm.get("pre", "")),
			"is_you": false,
		})
	for row in rows:
		row["takes_pen"] = String(row["name"]) == pen_taker
		row["takes_set"] = String(row["name"]) == set_taker





	return rows




