func use_item(id: String) -> bool:
	if int(stock.get(id, 0)) <= 0:
		return false
	var it: Dictionary = Shop.item_by_id(id)
	if it.is_empty():
		return false



	if not item_block_reason(id).is_empty():
		return false
	var heal: int = int(it.get("heal", 0))
	var gain: float = float(it.get("energy", 0.0))
	var form_up: int = int(it.get("form", 0))



	var fx: String = String(it.get("next_match", ""))
	var fx_useful: bool = not fx.is_empty() and not next_match_fx.has(fx)


	var rel_gain: Dictionary = it.get("rel", {}) as Dictionary
	var rel_useful: bool = false
	for k in rel_gain:



		if rel_derivada(str(k)):
			continue
		if int(rel.get(k, 0)) < 100:
			rel_useful = true
	var useful: bool =(gain > 0.0 and energy < energy_cap()) \
			or (heal > 0 and injury_weeks > 0) or (form_up > 0 and form < 5) \
			or fx_useful or rel_useful
	if not useful:
		return false
	if fx_useful:
		next_match_fx.append(fx)


	for k in rel_gain:


		if rel_derivada(str(k)):
			continue
		rel[k] = clampi(int(rel.get(k, 0)) + int(rel_gain[k]), 0, 100)


	var cd: int = int(it.get("cooldown", 0))
	if cd > 0:
		item_cooldown[id] = GameState.matches_played + cd
	energy = minf(energy_cap(), energy + gain)
	injury_weeks = maxi(0, injury_weeks - heal)
	if injury_weeks == 0 and heal > 0:
		injury_dias = 0
		_arm_eased_return(true)
	if injury_weeks == 0 and heal > 0 and _injury_was_grave:

		back_from_injury = true
		_injury_was_grave = false
	form = clampi(form + form_up, -5, 5)
	if id == "camara":
		_camara_season = GameState.season_num
	stock[id] = int(stock[id]) - 1
	if int(stock[id]) <= 0:
		stock.erase(id)
	_save()
	changed.emit()
	return true





























