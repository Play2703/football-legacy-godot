func next_match_weight() -> float:
	var f: Dictionary = GameState.current_fixture()
	if f.is_empty():
		return Standing.ROT_NEUTRAL
	var comp: String = String(f.get("comp", "league"))
	var round_name: String = String(f.get("round", ""))


	if comp == "nat":
		return Standing.match_weight(comp, 0, 0, round_name)
	var rival: Dictionary = GameState.current_rival()
	var opp_id: String = String(rival.get("id", ""))
	if opp_id.is_empty():
		return Standing.ROT_NEUTRAL
	return Standing.match_weight(comp, Squad.strength(opp_id),
		Squad.strength(GameState.player_team_id), round_name)

















func peso_proximo() -> float:
	var f: Dictionary = GameState.next_fixture()
	if String(f.get("comp", "")) == "nat":
		return 0.0
	if f.is_empty():
		return 0.0
	var comp: String = String(f.get("comp", "league"))
	var round_name: String = String(f.get("round", ""))
	var opp: String = String(f.get("opp", ""))






	var rs: int = Squad.strength(opp) if not opp.is_empty() else 0
	var ms: int = Squad.strength(GameState.player_team_id) if rs > 0 else 0
	var w: float = Standing.match_weight(comp, rs, ms, round_name)





	if not opp.is_empty() and is_derby(opp):
		w = minf(1.0, w + DERBY_WEIGHT)
	return w

const DERBY_WEIGHT: float = 0.14











func peso_de_hoy() -> float:
	var w: float = next_match_weight()
	var f: Dictionary = GameState.current_fixture()
	if f.is_empty() or String(f.get("comp", "")) == "nat":
		return w
	var rival: String = String(GameState.current_rival().get("id", ""))
	if not rival.is_empty() and is_derby(rival):
		w = minf(1.0, w + DERBY_WEIGHT)
	var ida: Array = GameState.your_first_leg(f)
	var ventaja: int = int(ida[0]) - int(ida[1]) if ida.size() >= 2 else 0
	return Rotation.peso_en_contexto(w, importancia_club(f), ventaja)







func importancia_club(f: Dictionary) -> String:
	var comp: String = String(f.get("comp", ""))
	var ronda: String = String(f.get("round", ""))
	var imp: String = DescansoPactado.importancia(comp, ronda, int(f.get("leg", 1)),
		GameState.fixture_is_knockout(f), GameState.liguilla_sin_eliminacion(f),
		comp == "league" and not GameState.league_stake().is_empty(),
		comp == "league" and GameState.liga_decidida(),
		ronda == "grupo" and GameState.euro_fase_decidida(comp))




	if ronda == "grupo" and imp == DescansoPactado.EN_JUEGO:
		return DescansoPactado.NORMAL
	return imp









