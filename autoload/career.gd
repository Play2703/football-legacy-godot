func _descanso_tecnico(call: Dictionary, edge: float = 0.0) -> String:

	if int(call.get("minutes", 0)) <= 0:
		return ""














	if Standing.role_of(edge) == Standing.Role.INDISCUTIBLE and rasgo_club("rota_min") <= 0.0:
		return ""




	if bool(call.get("oportunidad", false)):
		return ""










	if energy >= Coach.rest_energy(coach_idea, REST_ENERGY, Standing.UNFIT_ENERGY,
			rasgo_club("rota"), rasgo_club("rota_min")) or energy < Standing.UNFIT_ENERGY:
		return ""




	if next_match_weight() >= REST_MAX_WEIGHT:
		return ""




	var fx_hoy: Dictionary = GameState.current_fixture()
	if String(fx_hoy.get("comp", "")) != "nat" and is_derby(String(fx_hoy.get("opp", ""))):
		return ""

	var supl: Dictionary = rival_striker()
	if supl.is_empty():
		return ""


	var supl_energy: int = Rotation.MAX
	var team_id: String = GameState.player_team_id
	var squad: Array = Squad.of_nominal(team_id)
	var meta: Array = _ensure_squad_meta(team_id, squad)









	var casa: int = Squad.asiento_de_ficha(squad, supl)
	if casa >= 0 and casa < mini(squad.size(), meta.size()):
		supl_energy = Rotation.energia(meta[casa])



	var mi_media: int = roundi(skills_avg())
	var su_media: int = SquadMeta.media_of(supl, puesto_hoy())
	var mi_pm: Dictionary = {"energy": int(energy)}
	var su_pm: Dictionary = {"energy": supl_energy}
	if Rotation.nota(su_media, su_pm) > Rotation.nota(mi_media, mi_pm) + REST_MARGIN:
		return DESCANSO_CANSANCIO





	var mult: float = _guarda_proximo()
	if mult <= 1.0:
		return ""



	if DescansoPactado.te_pregunta(is_captain, int(rel["tecnico"])):
		return ""
	if Rotation.nota(su_media, su_pm, mult) > Rotation.nota(mi_media, mi_pm, mult) + REST_MARGIN:
		return DESCANSO_GUARDA
	return ""
















