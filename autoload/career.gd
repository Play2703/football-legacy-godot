func nat_match_squad() -> Array:














	var id: String = Nations.canon_id(nationality)



	Squad.invalidate(id)
	var out: Array = []
	for p in Squad.of(id):
		out.append((p as Dictionary).duplicate())
	if out.is_empty():
		return []









	if out.size() > NatTeam.SQUAD_SIZE:
		out.resize(NatTeam.SQUAD_SIZE)
	var yours: int = -1



	var cubiertos: Dictionary = {}
	for r in nat_squad_list():
		var row: Dictionary = r
		var i: int = int(row.get("rank", 0)) - 1
		if i < 0 or i >= out.size():
			continue
		var who: String = String(row.get("name", ""))
		var base: Dictionary = out[i]
		var ficha: Dictionary
















		var slot: String = String(row.get("slot", base.get("pos", "MC")))
		if bool(row.get("is_you", false)):
			ficha = Squad.user_slot(GameState.player_team_id).duplicate()
			slot = Squad.USER_POS
			yours = i








			ficha["media"] = int(round(skills_avg()))
			ficha["penal"] = int(skills.get("penal", 0))
			ficha["parado"] = int(skills.get("parado", 0))
		else:
			ficha = _nat_ficha(String(row.get("club_id", "")), who)
		ficha["name"] = who
		ficha["pos"] = slot
		ficha["number"] = int(row.get("number", int(base.get("number", 0))))
		out[i] = ficha
		cubiertos[i] = true
















	_nat_rellena_reales(out, cubiertos)
	var rol: String = nat_role_for(nat_callup())
	if yours < 0 and rol != "fuera":
		yours = _force_me_in(out)




	if yours >= 0:
		_only_one_user_pos(out, yours)
	_nat_dorsales_unicos(out, cubiertos, yours)
	return out












func _nat_dorsales_unicos(out: Array, cubiertos: Dictionary, yours: int = -1) -> void:
	var orden: Array = []
	if yours >= 0 and yours < out.size():
		orden.append(yours)
	for i in out.size():
		if i != yours and cubiertos.has(i):
			orden.append(i)
	for i in out.size():
		if i != yours and not cubiertos.has(i):
			orden.append(i)
	var usados: Dictionary = {}
	var pendientes: Array = []
	for i in orden:
		var row: Dictionary = out[i]
		var n: int = int(row.get("number", 0))


		if n <= 0 or n > 99 or usados.has(n) or not (cubiertos.has(i) or i == yours):
			pendientes.append(i)
			continue
		usados[n] = true
	for i in pendientes:
		var libre: int = 1
		while usados.has(libre):
			libre += 1
		(out[i] as Dictionary)["number"] = libre
		usados[libre] = true






















func _nat_rellena_reales(out: Array, cubiertos: Dictionary, country: String = "") -> void:




	var pais: String = nationality if country.is_empty() else country
	if pais.is_empty() or not NatReales.tiene(pais):
		return
	var usados: Dictionary = {}
	for i in out.size():
		usados[String((out[i] as Dictionary).get("name", "")).to_upper()] = true





	var forma: Array = NatTeam.squad_shape(pais) if country.is_empty() else []
	for i in out.size():
		if cubiertos.has(i):
			continue
		var f: Dictionary = out[i]
		if i < forma.size():
			f["pos"] = String(forma[i])
		var linea: String = Squad.line_of(String(f.get("pos", "MC")))
		var libres: Array = NatReales.libres_en(pais, linea, usados)






		if libres.is_empty():
			libres = NatReales.libres_en(pais, "", usados)
		if libres.is_empty():
			continue
		var real: Dictionary = libres[0]
		var nombre: String = String(real.get("n", ""))
		f["name"] = nombre



		if not String(real.get("c", "")).is_empty():
			f["club"] = String(real["c"])
		usados[nombre.to_upper()] = true





func _force_me_in(squad: Array) -> int:
	var idx: int = -1
	var peor: float = 1000000000.0
	for i in mini(Squad.STARTING_XI, squad.size()):
		var row: Dictionary = squad[i]
		var pos: String = String(row.get("pos", ""))
		if pos == "POR":
			continue

		var mio: bool = Squad.line_of(pos) == Squad.line_of(Squad.USER_POS)
		var val: float = Squad.ovr(row) -(100.0 if mio else 0.0)
		if val < peor:
			peor = val
			idx = i
	if idx < 0:
		return -1
	var mine: Dictionary = Squad.user_slot(GameState.player_team_id).duplicate()
	mine["name"] = player_name
	mine["pos"] = Squad.USER_POS
	var n: int = nat_number()
	mine["number"] = n if n > 0 else int((squad[idx] as Dictionary).get("number", 9))
	squad[idx] = mine
	return idx




















func _only_one_user_pos(squad: Array, yours: int) -> void:




	for i in squad.size():
