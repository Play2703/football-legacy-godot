func _market_tick() -> void:
	var wd: int = GameState.winter_day()
	var left: int = Market.window_days_left(GameState.season_day, wd)
	var deadline: bool = left == 1




	if String(agent_shot.get("kind", "")) == "hold":
		_resolve_agent_hold()


	var alive: Array = []
	for o in pending_offers:
		if int(o.get("expires", Market.window_last_day(GameState.season_day, wd))) \
				>= GameState.season_day:
			alive.append(o)
		else:


			_market_note(TAG_TIME, Market.club_name(o, ""),
				String(o.get("id", "")), true)


			_remember_missed(String(o.get("id", "")))
	pending_offers = alive



	_resolve_haggles()

	var hot: bool = last_rating >= MARKET_HOT_RATING
	var cold: bool = last_rating > 0.0 and last_rating < MARKET_COLD_RATING






	var drop_i: int = -1
	for i in range(pending_offers.size() - 1, -1, -1):
		if not bool(pending_offers[i].get("pre", false)):
			drop_i = i
			break
	if cold and drop_i >= 0 and randf() < Market.TICK_COLD_DROP:
		var dropped: Dictionary = pending_offers[drop_i]
		pending_offers.remove_at(drop_i)


		_market_note(TAG_COLD, String(dropped.get("name", "")),
			String(dropped.get("id", "")), true)






	if hot:
		for o in pending_offers:
			var boosted: int = int(float(o["wage"]) * Market.TICK_HOT_WAGE_BOOST)
			var cid_hot: String = String(o.get("id", ""))
			if not cid_hot.is_empty():
				boosted = mini(boosted, Market.wage_cap(cid_hot, Teams.rating(cid_hot),
					float(o.get("stature", 0.0))))
			o["wage"] = boosted




	_resolve_bids(hot)









	var cap: int = _offer_cap() +(1 if hot else 0)














	if not deadline and String(agent_shot.get("kind", "")) == "club":
		_resolve_agent_club(cap)
	var pushed: bool = String(agent_task.get("kind", "")) == "push" \
			or String(agent_task.get("kind", "")) == "league"
	var prefer: String = String(agent_task.get("target", "")) \
			if String(agent_task.get("kind", "")) == "league" else ""
	if _rejected_slots > 0 and not deadline:
		var filled: int = 0
		for _i in _rejected_slots:
			if _market_newcomer(left, cap):
				filled += 1
		_rejected_slots = 0



		if filled == 0:
			_market_note(TAG_NO_FILL)



	if not deadline and randf() < Market.tick_arrival_p(int(rel["agente"]), hot,
			pushed):
		_market_newcomer(left, cap, prefer)




	if deadline and (hot or form >= 1) \
			and randf() < Market.DEADLINE_BLOCKBUSTER_P:
		_market_blockbuster()

	if deadline and not pending_offers.is_empty():
		for o in pending_offers:
			o["wage"] = int(float(o["wage"]) * Market.DEADLINE_WAGE_BOOST)
			o["deadline"] = true











	for o in pending_offers:
		var cid_cap: String = String(o.get("id", ""))
		if cid_cap.is_empty():
			continue




		o["wage"] = mini(int(o.get("wage", 0)),
			Market.wage_cap(cid_cap, Teams.rating(cid_cap),
				float(o.get("stature", 0.0))))




	_queue_parte_mercado(left)



	_maybe_squad_talk()















func _queue_parte_mercado(left: int) -> void:
	if free_agent or on_loan() or _market_settled:
		return



	var sello: String = "%d|%d" % [GameState.season_num, GameState.season_day]
	if _parte_stamp == sello:
		return
	_parte_stamp = sello



	_tirar_partes_pendientes()

	var filas: Array = _parte_filas()
	if filas.is_empty():
		return
	queue_ceremony(Ceremonies.DEADLINE_NIGHT, {
		"cierre": false,
		"quedan": maxi(left, 1),
		"bids": filas,
		"suitors": pending_offers.size(),
		"fee": _parte_top(),


		"asking": asking_price(),
		"value": market_value(),
		"estado": market_state(),
		"partes": _parte_del_dia(),
		"to": "",
		"level": house_level,
	})











func _tirar_partes_pendientes() -> void:
	var limpias: Array = []
	for c in pending_ceremonies:
		if String(c.get("kind", "")) == Ceremonies.DEADLINE_NIGHT \
				and not bool(c.get("cierre", true)):
			continue
		limpias.append(c)
	pending_ceremonies = limpias





func _parte_filas() -> Array:
	const MAX: int = 4
	var out: Array = []
	var puestos: Dictionary = {}











	if not squad_rumor.is_empty() \
			and int(squad_rumor.get("season", -1)) == GameState.season_num:
		var destino: String = String(squad_rumor.get("to", ""))
		var t_dest: Dictionary = Teams.by_id(destino)
		if not t_dest.is_empty():
			puestos[destino] = true
			out.append({"id": destino, "rumor": true, "fee": 0,
				"abbrev": String(t_dest.get("abbrev", "")),
				"mate": String(squad_rumor.get("name", ""))})
	var mesa: Array = pending_offers.duplicate()
	mesa.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a.get("fee", 0)) < int(b.get("fee", 0)))
	for o in mesa:
		var oid: String = String(o.get("id", ""))
		var t_o: Dictionary = Teams.by_id(oid)
		puestos[oid] = true
		out.append({
			"id": oid,
			"abbrev": String(t_o.get("abbrev", Market.club_name(o, "").left(3))),
			"fee": int(o.get("fee", 0)),





			"asking": ask_for(o),
		})
		if out.size() >= MAX:
			return out







	for r in rumores_visibles(MAX):
		var rid: String = String(r.get("id", ""))
		if puestos.has(rid) or _market_rejected.has(rid):
			continue
		var t_r: Dictionary = Teams.by_id(rid)
		if t_r.is_empty():
			continue
		out.append({"id": rid, "rumor": true, "fee": 0,
			"abbrev": String(t_r.get("abbrev", ""))})
		if out.size() >= MAX:
			break
	return out










func _parte_del_dia() -> Array:
	var out: Array = []
