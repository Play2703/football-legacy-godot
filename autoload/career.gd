func _sin_cadenas(moves: Array, claves: Array) -> Array:
	if moves.is_empty() or claves.is_empty():
		return moves
	var padres: Dictionary = {}
	for m in moves:
		var cl: Array = _move_seats(m as Dictionary)
		if cl.size() < 2:
			continue
		var raiz: String = _uf_find(padres, String(cl[0]))
		for j in range(1, cl.size()):
			var otra: String = _uf_find(padres, String(cl[j]))
			if otra != raiz:
				padres[otra] = raiz
	var raices: Dictionary = {}
	for k in claves:
		raices[_uf_find(padres, String(k))] = true
	var quedan: Array = []
	for m2 in moves:
		var cl2: Array = _move_seats(m2 as Dictionary)
		if not cl2.is_empty() and raices.has(_uf_find(padres, String(cl2[0]))):
			continue
		quedan.append(m2)
	return quedan















