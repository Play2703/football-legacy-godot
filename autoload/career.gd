	return clampi(int((p as Dictionary).get("n", 1)), 1, Gerencia.PELDANO_MAX)



func _peldano_fija(n: int, club: String = "") -> void:
	var cid: String = GameState.player_team_id if club.is_empty() else club
	gerencia["peldano"] = {"club": cid, "n": clampi(n, 1, Gerencia.PELDANO_MAX)}



	if n >= Gerencia.PELDANO_LEYENDA and not cid.is_empty():
		var l: Array = Array(gerencia.get("leyendas", []))
		if not l.has(cid):
			l.append(cid)
			gerencia["leyendas"] = l




func fue_leyenda(club: String) -> bool:
	if club.is_empty():
		return false
	if Array(gerencia.get("leyendas", [])).has(club):
		return true
	var p: Variant = gerencia.get("peldano", null)
	if p is Dictionary and String((p as Dictionary).get("club", "")) == club \
			and int((p as Dictionary).get("n", 1)) >= Gerencia.PELDANO_LEYENDA:
		return true
	return int(Dictionary(gerencia.get("peldano_ex", {})).get(club, 0)) \
			>= Gerencia.PELDANO_LEYENDA









func _peldano_apunta_ex(p: Variant) -> void:
	if not (p is Dictionary):
		return
	var club: String = String((p as Dictionary).get("club", ""))
	if club.is_empty() or Teams.is_free(club):
		return
	var ex: Dictionary = Dictionary(gerencia.get("peldano_ex", {}))
	var n: int = clampi(int((p as Dictionary).get("n", 1)), 1, Gerencia.PELDANO_MAX)
