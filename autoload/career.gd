func _maybe_descanso_pactado() -> void:
	var llave: String = _llave_jornada()
	if String(descanso_pactado.get("llave", "")) == llave:
		return
	var f: Dictionary = GameState.current_fixture()
	if f.is_empty() or String(f.get("comp", "")) == "nat":
		return
	descanso_pactado = {"llave": llave, "toca": false}
	if pactado_cooldown > 0 or _repite_once() > 0:
		return
	var st: Dictionary = standing()
	if not bool(st.get("starter", false)) or int(st.get("minutes", 0)) <= 0 \
			or bool(st.get("oportunidad", false)):
		return
	var opp: String = String(f.get("opp", ""))
	if _is_final(f) or (not opp.is_empty() and is_derby(opp)):
		return
	var imp: String = pactado_importancia(f)
	var peso_hoy: float = next_match_weight()
	if peso_hoy >= REST_MAX_WEIGHT and imp != DescansoPactado.NADA:
		return


	var o: Dictionary = GameState.odds_fixture(f, false)
	var p_win: float = float(o.get("win", 0.0)) if not o.is_empty() else 0.0
	var peso_prox: float = peso_proximo()
	var p: float = DescansoPactado.probabilidad(p_win, int(energy), peso_hoy, peso_prox,
		rasgo_club("rota"))
	if DescansoPactado.tirada(llave) >= p:
		return
	var eleccion: String = ""
	var pregunta: bool = DescansoPactado.te_pregunta(is_captain, int(rel.get("tecnico", 0)))
	if not pregunta:
		eleccion = DescansoPactado.decision_tecnico(peso_hoy, peso_prox, int(energy),
			Coach.rest_energy(coach_idea, REST_ENERGY, Standing.UNFIT_ENERGY,
				rasgo_club("rota"), rasgo_club("rota_min")))
	descanso_pactado = {
		"llave": llave, "toca": true,
		"decide": "tu" if pregunta else "tecnico",
		"eleccion": eleccion,
		"importancia": imp,
		"rival": opp,

		"proximo": _pactado_proximo(peso_hoy, peso_prox),
	}
	pactado_cooldown = DescansoPactado.CADA




	if not pregunta:
		_encola_pactado()



func _encola_pactado() -> void:
	queue_ceremony(Ceremonies.PACTADO, {
		"club": GameState.player_team_id,
		"div": GameState.player_div(),
		"llave": String(descanso_pactado.get("llave", "")),
		"decide": String(descanso_pactado.get("decide", "")),
		"eleccion": String(descanso_pactado.get("eleccion", "")),
		"rival": String(descanso_pactado.get("rival", "")),
		"proximo": String(descanso_pactado.get("proximo", "")),
		"importancia": String(descanso_pactado.get("importancia", "")),
		"pedido": bool(descanso_pactado.get("pedido", false)),
	})


func _pactado_proximo(peso_hoy: float, peso_prox: float) -> String:
	if peso_prox - peso_hoy < DescansoPactado.SALTO_GRANDE:
		return ""
	return String(GameState.next_fixture().get("opp", ""))















func pactado_puede_pedir() -> bool:
	var f: Dictionary = GameState.current_fixture()
	if f.is_empty() or String(f.get("comp", "")) == "nat":
		return false
	_maybe_descanso_pactado()
	if pactado_vivo() or _repite_once() > 0:
		return false
	if String(descanso_pactado.get("llave", "")) != _llave_jornada() \
			or descanso_pactado.has("pedido_no"):
		return false
	var st: Dictionary = standing()
	return bool(st.get("starter", false)) and int(st.get("minutes", 0)) > 0 \
			and not bool(st.get("oportunidad", false))





func pactado_pide() -> String:
	if not pactado_puede_pedir():
		return DescansoPactado.NO_CONFIANZA
	var f: Dictionary = GameState.current_fixture()
	var opp: String = String(f.get("opp", ""))
	var imp: String = pactado_importancia(f)
	var peso_hoy: float = next_match_weight()
	var o: Dictionary = GameState.odds_fixture(f, false)
	var no: String = DescansoPactado.respuesta_peticion(
		_is_final(f) or (not opp.is_empty() and is_derby(opp)),
		peso_hoy >= REST_MAX_WEIGHT and imp != DescansoPactado.NADA,
		float(o.get("win", 0.0)) if not o.is_empty() else 0.0,
		int(energy), peso_proximo() - peso_hoy)
	if not no.is_empty():
		descanso_pactado["pedido_no"] = no
		_apply_delta("tecnico", DescansoPactado.TECNICO_NO)
		_save()
		return no
	descanso_pactado = {
		"llave": _llave_jornada(), "toca": true, "decide": "tu", "eleccion": "",
		"importancia": imp, "rival": opp, "pedido": true,
		"proximo": _pactado_proximo(peso_hoy, peso_proximo()),
	}
	pactado_cooldown = DescansoPactado.CADA
	_save()
	return ""




func pactado_pendiente() -> bool:
	return pactado_vivo() and String(descanso_pactado.get("decide", "")) == "tu" \
			and String(descanso_pactado.get("eleccion", "")).is_empty()





func pactado_abre() -> String:
	if not pactado_pendiente():
		return ""
	for c in pending_ceremonies:
		if String(c.get("kind", "")) == Ceremonies.PACTADO:
			return acto_o_suelo("")
	_encola_pactado()
	return acto_o_suelo("")











