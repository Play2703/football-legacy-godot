func club_feat_points(club_id: String) -> float:
	if club_id.is_empty():
		return 0.0
	var total: float = 0.0
	var ahora: int = GameState.season_num



	if GameState.player_team_id == club_id:
		total += _feat_points_of(current_season_awards(), GameState.player_div(),
			Teams.country_of(club_id)) * float(ContractTerms.CLUB_FEAT_DECAY[0])
	for row in season_history:
		var r: Dictionary = row
		if String(r.get("club", "")) != club_id:
			continue


		var atras: int = ahora - int(r.get("season", 0))
		if atras < 0 or atras >= ContractTerms.CLUB_FEAT_WINDOW:
			continue




		total += _feat_points_of(r.get("awards", []), int(r.get("div", 1)),
			Teams.country_of(club_id)) * float(ContractTerms.CLUB_FEAT_DECAY[atras])
	return total





func _feat_points_of(awards_list: Array, div: int, country: String) -> float:
	var total: float = 0.0
	for a in awards_list:
		total += AwardPoints.raw_for(String(a), div, country)
	return total






