func clausulas_mesa_oferta(index: int) -> Dictionary:
	if index < 0 or index >= pending_offers.size():
		return {"ok": false, "why": "SIN OFERTA"}
	var offer: Dictionary = pending_offers[index]
	if bool(offer.get("clausulas_hechas", false)):
		return {"ok": false, "why": "YA NEGOCIASTE LAS CLÁUSULAS"}
	if offer.has("haggle"):
		return {"ok": false, "why": "ESPERAS SU RESPUESTA"}
	if not market_open() and not free_agent:
		return {"ok": false, "why": "MERCADO CERRADO"}
	var club: String = String(offer.get("id", ""))
	var pos_club: String = String(offer.get("pos", ""))
	if pos_club.is_empty():
		pos_club = puesto_hoy()
	var b: Dictionary = clausulas_base_oferta(offer)
	var cap: int = mini(ContractTerms.YEARS_MAX, ContractTerms.max_seasons_for_age(age))
	var ctx: Dictionary = _clausulas_ctx(club, pos_club,
		Squad.muros_once(club, club == GameState.player_team_id),
		float(offer.get("interest", 0.5)), float(offer.get("stature", 0.0)), false,
		1, maxi(int(b["anos"]), cap))
	return {"ok": true, "why": "", "base": b, "ctx": ctx,
		"wage": int(offer.get("wage", 0))}






func clausulas_entra_oferta(index: int) -> bool:
