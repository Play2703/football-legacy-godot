						fila["label"] = I18n.t("MEJOR DEL MUNDIAL")
					"asist_mundial":


						fila["icon"] = "vision"
						fila["label"] = I18n.t("ASISTENTE DEL MUNDIAL")
					"premio_continental":


						fila["icon"] = "vitrina"
						fila["label"] = I18n.t("PREMIO CONTINENTAL")
					"champions":
