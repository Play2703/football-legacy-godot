func _assign_objective(club_id: String) -> void:



	var div: int = GameState.div_of(club_id)
	var teams_n: int = Teams.teams_in(Teams.country_of(club_id), div).size()
	if teams_n <= 1:
		teams_n = GameState.LEAGUE_SIZE



	var rating: int = Teams.rating(club_id)


	var tipo_club: int = maxi(Market.base_wage_of(club_id, rating), 1)
	var pay_ratio: float = float(int(contract["wage"])) / float(tipo_club)




	var club_tier: float = ClubGoals.percentile(_club_rank_in_league(club_id), teams_n)








	var bias: float = Market.skill_bias(skills, puesto_en(club_id))
	if not is_zero_approx(_obj_out_bias):
		bias = clampf((bias + _obj_out_bias) * 0.5, -1.0, 1.0)


	var obj: Dictionary = Market.build_objective(rating, skills_avg(),
		div, teams_n, randf(),
		Standing.contract_role_from_key(String(contract.get("role", "rotacion"))),
		bias, _obj_last_types(), pay_ratio, club_tier, _obj_delivery, puesto_en(club_id))




	var prev: Array = _obj_last_types()
	prev.push_front(String(contract.get("obj_type", "goals")))
	contract["obj_last"] = prev.slice(0, 2)
	contract["obj_type"] = String(obj["type"])
	contract["obj_target"] = int(obj["target"])
	contract["obj_progress"] = 0


	contract["obj_bonus"] = ContractTerms.objective_bonus(int(contract["wage"]),
		float(ContractTerms.stature(contract_ctx(club_id))["index"]))



	contract["obj_base_target"] = int(contract["obj_target"])
	contract["obj_base_bonus"] = int(contract["obj_bonus"])
	contract["obj_tier"] = 0
	contract["obj_talks_season"] = -1





