func goals_by_season() -> Array:
	var por_temp: Dictionary = {}
	var orden: Array = []
	for h in season_history:
		var s: int = int(h.get("season", 0))
		if not por_temp.has(s):
			por_temp[s] = {"season": s, "total": 0, "segs": []}
			orden.append(s)
		_add_goal_seg(por_temp[s], String(h.get("club", "")), int(h.get("goals", 0)))
	if season_matches > 0 or season_goals > 0:
		var s_now: int = GameState.season_num
		if not por_temp.has(s_now):
			por_temp[s_now] = {"season": s_now, "total": 0, "segs": []}
			orden.append(s_now)
		_add_goal_seg(por_temp[s_now], GameState.player_team_id, season_goals)
	var out: Array = []
	for s in orden:
		out.append(por_temp[s])
	return out





func _add_goal_seg(grupo: Dictionary, club: String, goals: int) -> void:
	grupo["total"] = int(grupo["total"]) + goals
	for seg in grupo["segs"]:
		if String(seg["club"]) == club:
			seg["goals"] = int(seg["goals"]) + goals
			return
	grupo["segs"].append({"club": club, "goals": goals})
















func _archive_season_report() -> void:
	if last_report.is_empty():
		return
	var fila: Dictionary = last_report.get("row", {}) as Dictionary
	var yr: int = int(fila.get("season", GameState.season_num - 1))
	var slim: Dictionary = last_report.duplicate(true)
	slim.erase("row")
	slim.erase("prev_row")



	season_reports[str(yr)] = {"report": slim, "tail": last_summary}





func has_season_report(season: int) -> bool:
	return season_reports.get(str(season), null) is Dictionary





func season_report(season: int) -> Dictionary:
	var raw: Variant = season_reports.get(str(season), null)
	if not (raw is Dictionary):
		return {}
	var entry: Dictionary = raw as Dictionary
	var rep: Dictionary =(entry.get("report", {}) as Dictionary).duplicate(true)
	rep["row"] = _closing_row_of(season)
	rep["prev_row"] = _closing_row_of(_season_before(season))
	return {"report": rep, "tail": String(entry.get("tail", ""))}






func _closing_row_of(season: int) -> Dictionary:
	var parcial: Dictionary = {}
	for i in range(season_history.size() - 1, -1, -1):
		var r: Dictionary = season_history[i]
		if int(r.get("season", 0)) != season:
			continue
		if not bool(r.get("partial", false)):
			return r
		if parcial.is_empty():
			parcial = r
	return parcial





func _season_before(season: int) -> int:
	var best: int = 0
	for r in season_history:
		var yr: int = int(r.get("season", 0))
		if yr < season and yr > best and not bool(r.get("partial", false)):
			best = yr
	return best


func _prev_closing_row() -> Dictionary:
	var this_season: int = GameState.season_num - 1
	for i in range(season_history.size() - 2, -1, -1):
		var r: Dictionary = season_history[i]
		if bool(r.get("partial", false)) or int(r.get("season", 0)) >= this_season:
			continue
		return r
	return {}







