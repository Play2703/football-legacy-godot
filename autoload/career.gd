func objective_target_judged() -> int:
	var target: int = int(contract["obj_target"])
	if season_injury_lost <= 0:
		return target
	match String(contract["obj_type"]):
		"goals", "assists", "matches":




			var total: int = season_matches + season_injury_lost
			return maxi(1, ceili(float(target)
				*(1.0 - float(season_injury_lost) / float(maxi(total, 1)))))
		_:
			return target











