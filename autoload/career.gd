const FORCED_SALE_REFUSE_FX: Dictionary = {
	"tecnico": -14.0, "equipo": -8.0, "aficion": -3.0,
}






const FORCED_SALE_SAFE_SEASONS: int = 3




const FORCED_SALE_SAFE_AGE: int = 1






const AT_STAKE_MIN_PLAYED: float = 0.34









func _club_season_at_stake() -> bool:
	var rows: Array = GameState.league_standings()
	if rows.is_empty():
		return false
	var played: int = 0
	for r in rows:
		if String((r as Dictionary).get("key", "")) == GameState.YOU_KEY:
			played = int((r as Dictionary).get("pj", 0))
			break
	var total: int = GameState.calendar.size()
	if total <= 0 or float(played) < float(total) * AT_STAKE_MIN_PLAYED:
		return false
	var pos: int = GameState.league_position()
	if pos <= 0:
		return false
	if GameState.in_promotion_zone():
		return true


	var pdiv: int = GameState.player_div()






	var pais: String = Teams.country_of(GameState.player_team_id)
	if pdiv == 1 and Continental.tiene_copas(pais):
		var zona: int = 0
		for f in Continental.franjas(pais, "anual"):
			zona += int((f as Array)[0])
		return pos <= zona
	var q: Dictionary = GameState.euro_qualification(pdiv, pos,
		Teams.country_of(GameState.player_team_id), false, false, false, false, pdiv)
	return bool(q.get("ucl", false)) or bool(q.get("eul", false)) \
			or bool(q.get("conf", false))
















const REFUSE_PAYBACK_FRAC: float = 0.6




const REFUSE_PAYBACK_AVG: float = 7.4





func _refusal_vindicated(result: Dictionary, avg: float) -> bool:
	return bool(result.get("promoted", false)) \
			or bool(result.get("won_league", false)) \
			or bool(result.get("ucl_champion", false)) \
			or bool(result.get("eul_champion", false)) \
			or bool(result.get("cup_champion", false)) \
			or avg >= REFUSE_PAYBACK_AVG










func _forced_sale_payback(result: Dictionary, avg: float, lines: Array[String]) -> void:
	if _forced_sale_refused <= 0 or _refuse_paid:
		return
	if not _refusal_vindicated(result, avg):
		return
	_refuse_paid = true
	for key in FORCED_SALE_REFUSE_FX:

		_apply_delta(String(key),
			_div_decision_scale(- float(FORCED_SALE_REFUSE_FX[key]) * REFUSE_PAYBACK_FRAC),
			REL_BRAKE_EXP_DECISION)
	lines.append(I18n.t("El club te quiso vender y te plantaste. Después de este año,"
		+ " te lo reconocen: el vestuario te lo devuelve."))
	queue_ceremony(Ceremonies.PRESSER, {"mode": "reconciliacion"})








