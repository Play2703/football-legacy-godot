		return
	var offer: Dictionary = pending_offers[index]
	var oid: String = String(offer.get("id", ""))
	var orat: int = Teams.rating(oid)
	var antes: int = int(offer.get("wage", 0))



	var suelo: int = Market.base_wage_of(oid, orat)
	var techo: int = maxi(suelo, ContractTerms.pulse_ceiling(antes,
		Market.wage_cap(oid, orat, float(offer.get("stature", 0.0)))))
	var final: int = clampi(wage, suelo, techo)
	offer["wage"] = final
	offer["haggled"] = true
	pulse_index = -1



	var club: String = Market.club_name(offer, "El club")
	var id: String = String(offer.get("id", ""))
	if final > antes:
		_market_note(TAG_WAGE_UP, club, id)
	elif final < antes:
		_market_note(TAG_PULSE_DOWN, club, id)



		offer["interest"] = maxf(Market.PULSE_COOL_FLOOR,
			float(offer.get("interest", 0.4)) - Market.PULSE_COOL_INTEREST)
	_save()
	changed.emit()











