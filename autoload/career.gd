	last_watch = {
		"rival": String(rival.get("name", "Rival")),
		"rival_id": String(rival.get("id", "")),
		"team_goals": team_goals, "rival_goals": rival_goals,
		"result": result, "scorers": sim["scorers"],
		"injured": injured,


		"pactado": pactado_hoy() == DescansoPactado.DESCANSO,
		"rested": rotado,
	}
	if bool(last_watch["pactado"]) and not injured and not suspended:


		var goles: Array = []
		for sc in sim.get("scorers", []):
			goles.append([int((sc as Dictionary).get("minute", 0)),
				String((sc as Dictionary).get("team", "")) == "you"])
		queue_ceremony(Ceremonies.DIA_LIBRE, {
			"club": GameState.player_team_id,
			"div": GameState.player_div(),
			"rival": String(rival.get("id", "")),
			"team_goals": team_goals, "rival_goals": rival_goals,
			"goles": goles,
			"result": result,
			"proximo": String(descanso_pactado.get("proximo", "")),
		})





	var fx_now: Dictionary = GameState.current_fixture()
	var opp: String = String(rival.get("id", ""))









	var prev: Array = GameState.your_first_leg(fx_now)
	var agg_gf: int = team_goals +(int(prev[0]) if not prev.is_empty() else 0)
	var agg_ga: int = rival_goals +(int(prev[1]) if not prev.is_empty() else 0)


	var desempate_perdido: bool = ko_desempate_perdido(fx_now, opp, team_goals, rival_goals)
	var lost_tie: bool = GameState.fixture_is_knockout(fx_now) \
			and not GameState.liguilla_sin_eliminacion(fx_now) \
			and (agg_gf < agg_ga or (agg_gf == agg_ga and desempate_perdido))



	var goles_rival: Array = []
	for sc in sim.get("scorers", []):
		if String((sc as Dictionary).get("team", "")) == "rival":
			goles_rival.append(sc)
	goles_rival.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a.get("minute", 0)) < int(b.get("minute", 0)))
	var orden_rival: Array = []
	for sc in goles_rival:
		orden_rival.append(String((sc as Dictionary).get("name", "")))
	on_match_result(0.0, 0, 0, result, false, 0, 0, 0, 0,
		String(fx_now.get("comp", "league")), {
		"round": String(fx_now.get("round", "")),
		"margin": team_goals - rival_goals,
		"gf": team_goals, "ga": rival_goals,
		"rival_goles_orden": orden_rival,
		"ko_lost": lost_tie,
		"rotado": rotado,
		"rival_gap":(0 if opp.is_empty()
			else Teams.rating(GameState.player_team_id) - Teams.rating(opp)),
	})


	var mate: Dictionary = {}
	var mate_a: Dictionary = {}
	for sc in sim.get("scorers", []):
		if String(sc.get("team", "")) == "you":
			var nm: String = String(sc.get("name", ""))
			if not nm.is_empty():
				mate[nm] = int(mate.get(nm, 0)) + 1
			var asr: String = String(sc.get("assist", ""))
			if not asr.is_empty():
				mate_a[asr] = int(mate_a.get(asr, 0)) + 1
	var wcomp: String = String(GameState.current_fixture().get("comp", "league"))
	record_mate_goals(mate, wcomp)
	record_mate_assists(mate_a, wcomp)
	GameState.record_match(0, 0, 0, -1.0, result, team_goals, rival_goals)
	if injured:


		last_role = "LESIONADO"
		_save()
	elif suspended:



		serve_suspension()
		last_role = "SANCIONADO"
		_save()



	changed.emit()












func _watch_nat_match(injured: bool, suspended: bool = false) -> void:

	_spend_match_fx(HOUSE_TACTICAL_FX)
	var f: Dictionary = GameState.current_fixture()
	var rival: Dictionary = GameState.rival_of(f)
	var sim: Dictionary = MatchSim.simulate_full(nationality, String(f.get("opp", "")),
		grada_marcador(nationality, String(f.get("opp", "")), f, true))
	var team_goals: int = int(sim["team_goals"])
	var rival_goals: int = int(sim["rival_goals"])
	var result: int = signi(team_goals - rival_goals)
	last_watch = {
		"rival": String(rival.get("name", "Rival")),
		"rival_id": String(rival.get("id", "")),
		"team_goals": team_goals, "rival_goals": rival_goals,
		"result": result, "scorers": sim["scorers"],
		"injured": injured, "nat": true,
	}
	if injured:
		_curar_dias(GameState.dias_descanso())


		injury_matches_lost += 1
	if suspended:
		serve_suspension()
	last_recovery = recovery_detail(0.0, GameState.dias_descanso())
	last_recovery["antes"] = energy
	energy = minf(energy_cap(), energy + float(last_recovery["total"]))
	last_recovery["aplicado"] = energy - float(last_recovery["antes"])
	last_minutes = 0
	last_role = "LESIONADO" if injured \
			else ("SANCIONADO" if suspended else "NO CONVOCADO")
	week_actions = WEEK_ACTIONS
	_save()


	GameState.record_match(0, 0, 0, -1.0, result, team_goals, rival_goals, true)






	changed.emit()











func _match_awards(rating: float, goals: int, assists: int = 0,
		shots: int = 0, passes: int = 0, ctx: Dictionary = {},
		comp: String = "league", sala: Dictionary = {}) -> void:
	last_match_mvp = false
	last_match_comp = comp



	var figura: Dictionary = _match_figure(ctx, goals, assists)
	var es_mia: bool = bool(figura.get("mia", true))
	if es_mia and pasa_liston_mvp(rating, goals):
		last_match_mvp = true
		muro_pon("mvp")


		grant_award("Jugador del Partido")





		if goals >= 2:
			pass
		else:
			pass











		queue_ceremony(Ceremonies.MVP, {
			"rating": rating, "goals": goals, "assists": assists,
			"shots": shots, "passes": passes, "comp": comp,
			"socio": RuedaPrensa.socio_del_micro(ctx.get("te_asisten", {}), socios_top(3)),
			"gol_final": bool(ctx.get("gol_final", false)),

			"ambiente": String(sala.get("ambiente", "")), "rival": String(sala.get("rival", "")),
			"tela": sala.get("tela", {}),
		})
	elif not es_mia:




		if not _maybe_idolo_ahijado(figura, comp):
			_queue_rival_mvp(figura, comp)
	_month_ctr += 1
	_month_sum += rating
	_month_goals += goals
	_month_assists += assists



	if comp.is_empty() or comp == "league":
		_month_rounds += 1



	var _mg: Dictionary = ctx.get("mate_scorers", {}) as Dictionary
	for nom in _mg:
		_month_mate_g[nom] = int(_month_mate_g.get(nom, 0)) + int(_mg[nom])
	var _ma: Dictionary = ctx.get("mate_assisters", {}) as Dictionary
	for nom in _ma:
		_month_mate_a[nom] = int(_month_mate_a.get(nom, 0)) + int(_ma[nom])











	if _month_rounds >= 3:




		var my_avg: float = _month_sum / float(_month_ctr)
		var mr: Dictionary = _month_rival(_month_idx)
		var bar: float = float(mr.get("bar", 8.0))
		var need: float = bar +(0.3 if _month_won else 0.0)
		if my_avg >= need and my_avg >= 7.3:
			grant_award("Jugador del Mes")



			queue_ceremony(Ceremonies.MOTM, {
				"avg": my_avg, "bar": bar, "month": _month_idx + 1,
				"goals": _month_goals, "assists": _month_assists,
				"matches": _month_ctr,
				"pts": award_pts_of("Jugador del Mes"),
				"pts_xp": award_xp_of("Jugador del Mes"),
			})
			_maybe_pregunta_idolo(my_avg)
			_maybe_idolo_fan(my_avg)
			_month_won = true
		else:
			_month_won = false
			_queue_month_rival(mr.get("ficha", {}) as Dictionary, my_avg, bar)
		_month_ctr = 0
		_month_sum = 0.0
		_month_goals = 0
		_month_assists = 0
		_month_rounds = 0
		_month_mate_g.clear()
		_month_mate_a.clear()
		_month_idx += 1

















func _check_records() -> void:
	if GameState.readonly_save:
		return
	var club: String = GameState.player_team_id
	var country: String = Teams.country_of(club)
	if country.is_empty():
		return
	for row in Records.league(country):


		var base: String = String(row["base"])
		var mine: float = _season_record_mark(base, country)
		if mine < 0.0:
			continue
		var icon: String = "placa_partidos"
		match base:
			"goles_temp":
				icon = "placa_gol"
			"asis_temp":
				icon = "placa_asist"
		_maybe_record(row, mine, icon, base == "partidos_liga",
			Competitions.league_brand(country))

	var team: Dictionary = Teams.by_id(club)
	if team.is_empty():
		return
	_maybe_record(Records.club_apps(club, country, int(team.get("rating", 60))),
		float(Records.apps_at(club)), "placa_partidos", true,
		String(team.get("name", "")))



	_maybe_record(Records.club_goals(club, country, int(team.get("rating", 60))),
		float(goles_con_club(club)), "placa_gol", true, String(team.get("name", "")))





	_maybe_record(Records.club(club, country, int(team.get("rating", 60))),
		float(season_goals), "placa_gol", false, String(team.get("name", "")))













	var filas_cont: Array = [
			["ucl", "champions", season_goals_ucl, season_assists_ucl],
			["eul", "europa", season_goals_eul, season_assists_eul],
			["conf", "conference", season_goals_conf, season_assists_conf]]
	for ac in Continental.AMER_COMPS:
		filas_cont.append([ac, Continental.marca(ac), _cont_val(ac, "g"), _cont_val(ac, "a")])
	for e in filas_cont:
		var cmp: String = String(e[0])
		var scope: String = Competitions.comp_name(String(e[1]))
		_maybe_record(Records.euro_row(cmp, "g"),
			float(Records.comp_season_mark(season_history, cmp, "g",
				int(e[2]), GameState.season_num)), "placa_gol", false, scope)
		_maybe_record(Records.euro_row(cmp, "a"),
			float(Records.comp_season_mark(season_history, cmp, "a",
				int(e[3]), GameState.season_num)), "placa_asist", false, scope)


	_check_world_records()



const RECORD_NEAR_GAP: int = 4







func record_within_reach() -> Dictionary:
	if retired or GameState.season_progress() < OBJ_RISK_FROM:
		return {}
	var country: String = Teams.country_of(GameState.player_team_id)
	if country.is_empty() or GameState.player_div() != 1:
		return {}
	for row_raw in Records.league(country):
		var base: String = String(row_raw["base"])
		if base != "goles_temp" and base != "asis_temp":
			continue
		var row: Dictionary = Records.overlay(row_raw, record_marks)
		var falta: int = int(row["value"]) - int(_season_record_mark(base, country))
		if falta > 0 and falta <= RECORD_NEAR_GAP:
			return {"key": String(row_raw["key"]), "label": String(row["label"]),
				"falta": falta, "value": int(row["value"]), "goal": base == "goles_temp"}
	return {}




func _comps_snapshot(with_nat: bool) -> Dictionary:
	var out: Dictionary = {}
	var pares: Array = [
		["cup", season_goals_cup, season_assists_cup],
		["ucl", season_goals_ucl, season_assists_ucl],
		["eul", season_goals_eul, season_assists_eul],
		["conf", season_goals_conf, season_assists_conf],
		["cwc", season_goals_cwc, season_assists_cwc],


		["liguilla", season_goals_liguilla, season_assists_liguilla],
		["campeones", season_goals_campeones, season_assists_campeones],
	]


	for ac in Continental.AMER_COMPS + Supercopas.COMPS + [SupercopaNacional.COMP, CopaLiga.COMP,
			CopaLigas.COMP]:
		pares.append([ac, _cont_val(ac, "g"), _cont_val(ac, "a")])
	for p in pares:
		var comp: String = String(p[0])




		var avg_cell: Dictionary =(season_avg_by_comp.get(comp, {}) as Dictionary)
		var ap: int = int(avg_cell.get("ap", 0))



		var pj: int = int(season_apps_by_comp.get(comp, 0))
		if int(p[1]) > 0 or int(p[2]) > 0 or ap > 0 or pj > 0:
			var cell: Dictionary = {"g": int(p[1]), "a": int(p[2])}
			if pj > 0:
				cell["pj"] = pj
			if ap > 0:
				cell["rs"] = float(avg_cell.get("rs", 0.0))
				cell["ap"] = ap
			out[comp] = cell
	if with_nat and (season_nat_goals > 0 or season_nat_assists > 0):
		out["nat"] = {"g": season_nat_goals, "a": season_nat_assists}







		for k in NAT_COMPS:
			var cell: Dictionary = season_nat_by_comp.get(k, {})
			if int(cell.get("g", 0)) > 0 or int(cell.get("a", 0)) > 0:
				out["nat_%s" % k] = {"g": int(cell.get("g", 0)),
					"a": int(cell.get("a", 0))}
	return out










func _season_record_mark(key: String, country: String) -> float:
	var live: bool = GameState.player_div() == 1

	match Records.base_liga(key):
		"goles_temp":
			return float((season_goals_league if live else 0)
				+ _season_stashed("goals_league", "goals", country))
		"asis_temp":
			return float((season_assists_league if live else 0)
				+ _season_stashed("assists_league", "assists", country))
		"partidos_liga":



			return float(Records.apps_in_league(country))
	return -1.0








func _season_stashed(field: String, fallback: String = "", country: String = "") -> int:
	var n: int = 0
	for r in season_history:
		if not bool(r.get("partial", false)) \
				or int(r.get("season", 0)) != anio_vivo():
			continue
		if not country.is_empty():
			if Teams.country_of(String(r.get("club", ""))) != country:
				continue
			if int(r.get("div", 1)) != 1:
				continue
		if r.has(field):
			n += int(r[field])
		elif not fallback.is_empty():
			n += int(r.get(fallback, 0))
	return n

















func season_comps() -> Dictionary:
	var out: Dictionary = {
		"league": {"g": season_goals_league, "a": season_assists_league},
		"cup": {"g": season_goals_cup, "a": season_assists_cup},
		"ucl": {"g": season_goals_ucl, "a": season_assists_ucl},
		"eul": {"g": season_goals_eul, "a": season_assists_eul},
		"conf": {"g": season_goals_conf, "a": season_assists_conf},
		"cwc": {"g": season_goals_cwc, "a": season_assists_cwc},
		"liguilla": {"g": season_goals_liguilla, "a": season_assists_liguilla},
		"campeones": {"g": season_goals_campeones, "a": season_assists_campeones},
	}


	for ac in Continental.AMER_COMPS + Supercopas.COMPS + [SupercopaNacional.COMP, CopaLiga.COMP,
			CopaLigas.COMP]:
		out[ac] = {"g": _cont_val(ac, "g"), "a": _cont_val(ac, "a")}
	for r in season_history:
		if not bool(r.get("partial", false)) \
				or int(r.get("season", 0)) != anio_vivo():
			continue




		var lg: Dictionary = out["league"]
		lg["g"] = int(lg["g"]) + int(r.get("goals_league", 0))
		lg["a"] = int(lg["a"]) + int(r.get("assists_league", 0))
		var comps: Dictionary = r.get("comps", {})
		for c in comps:
			var k: String = String(c)
			if not out.has(k):
				continue
			var cell: Dictionary = out[k]
			cell["g"] = int(cell["g"]) + int((comps[c] as Dictionary).get("g", 0))
			cell["a"] = int(cell["a"]) + int((comps[c] as Dictionary).get("a", 0))
	return out




