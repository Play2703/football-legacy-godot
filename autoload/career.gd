func market_state() -> Dictionary:
	if free_agent or on_loan() or retired:
		return {}


	if unsettled:
		return {"estado": "TU CLUB TE VENDE", "urgente": true,
			"nota": "No renuevas: te ponen en el escaparate."}

	if forced_sale:
		return {"estado": "TU CLUB TE VENDE", "urgente": true,
			"nota": "Tu club te vende. Falta tu respuesta."}

	if forced_loan:
		return {"estado": "EL CLUB TE BUSCA MINUTOS", "urgente": true,
			"nota": "Quieren cederte. Falta tu respuesta."}

	if for_sale:
		return {"estado": "EN VENTA", "urgente": false,
			"nota": "Aceptaste salir: te ofrecen a quien pregunte."}


	if transfer_requested:
		return {"estado": "PEDISTE EL TRASPASO", "urgente": false,
			"nota": "Pediste salir: ya no te retienen."}
	if loan_listed:
		return {"estado": "EN LISTA DE CESIÓN", "urgente": false,
			"nota": "Pediste cesión: llegan destinos cada ventana."}





	if club_blocks_sale():
		return {"estado": "TU CLUB TE RETIENE", "urgente": true,
			"nota": "No te dejan salir: pide el traspaso primero."}
	return {}







func _offer_cap() -> int:
	var winter_cap: int = Market.WINTER_SLOTS \
			if Market.window_id(GameState.season_day, GameState.winter_day()) \
			== Market.WINDOW_WINTER else -1
	var slot_bonus: int = Market.LISTED_SLOTS if list_status() == LIST_SALE else 0



	return Market.table_cap(int(rel["agente"]), winter_cap, slot_bonus,
		Market.mesa_heat(scout_profile()))





func _market_floor() -> float:
	return 0.05 if list_status() == LIST_SALE else Market.MIN_INTEREST








func _market_blockbuster() -> void:
	var best: int = Teams.rating(GameState.player_team_id)
	var seen: Dictionary = {}
	for o in pending_offers:
		best = maxi(best, Teams.rating(String(o.get("id", ""))))
		seen[String(o.get("id", ""))] = true
	for id in _market_rejected:
		seen[String(id)] = true
	for id in _club_vetos.keys():
		if club_vetado(String(id)):
			seen[String(id)] = true
	var bomb: Dictionary = {}
	var bomb_rating: int = best
	for cand in Market.candidates(scout_profile(), GameState.player_team_id,
			_market_floor()):
		var r: int = Teams.rating(String(cand.get("id", "")))
		if r > bomb_rating and not seen.has(String(cand.get("id", ""))):
			bomb = cand
			bomb_rating = r
	if bomb.is_empty():
		return

	var offer: Dictionary = Market.offer_for(Teams.by_id(String(bomb["id"])),
		scout_profile(), 0.95)
	offer["expires"] = GameState.season_day






	offer["bid"] = maxi(int(offer.get("bid", 0)), ask_for(offer))
	offer["bid_war"] = true
	offer["deal_told"] = true
	pending_offers.append(offer)
	_market_note(TAG_BLOCKBUSTER, Market.club_name(offer, ""),
		String(offer.get("id", "")))















func agent_commission(kind: String, target: String = "") -> bool:
	if not market_open() or free_agent or on_loan():
		return false
	if agent_tasks_used >= Market.agent_tasks(int(rel["agente"])):
		return false


	if (kind == "push" or kind == "league") and not agent_task.is_empty():
		return false
	if (kind == "club" or kind == "hold") and not agent_shot.is_empty():
		return false




	if market_deadline():
		return false
	if kind != "push" and kind != "league" and kind != "club" and kind != "hold":
		return false
	if kind != "push" and target.is_empty():
		return false


	if kind == "hold" and _offer_index(target) < 0:
		return false




	if kind == "hold" and bool(pending_offers[_offer_index(target)].get("pre", false)):
		return false

	var fee: int = agent_fee(kind)
	if money < fee:
		return false
	if kind == "club" or kind == "hold":
		agent_shot = {"kind": kind, "target": target}
	else:
		agent_task = {"kind": kind, "target": target}
	agent_tasks_used += 1
	money -= fee
	_market_note(TAG_AGENT_ASK)
	_save()
	changed.emit()
	return true














func agent_target_status(club_id: String) -> Dictionary:
	var club: Dictionary = Teams.by_id(club_id)
	if club.is_empty():
		return {"ok": false, "why": "Ese club no existe."}
	if club_id == GameState.player_team_id:
		return {"ok": false, "why": "Ya juegas ahí."}
	if _offer_index(club_id) >= 0:
		return {"ok": false, "why": "Ya tienes su oferta sobre la mesa."}
	if _market_rejected.has(club_id):
		return {"ok": false, "why": "Les dijiste que no en esta ventana."}






	for cand in Market.candidates(scout_profile(), GameState.player_team_id,
			_market_floor(), false, club_id,
			Market.EX_CLUB_PULL if is_ex_club(club_id) else Market.AGENT_PULL):
		if String(cand.get("id", "")) == club_id:
			return {"ok": true, "why": ""}






	if _agent_pre_p(club_id) >= Market.MIN_INTEREST:
		return {"ok": true, "why": "", "pre": true}

	var prof: Dictionary = scout_profile()
	var rating: int = int(club.get("rating", 62))
	var mio: int = Teams.rating(GameState.player_team_id)
	if mio > 0 and rating < mio - Market.MAX_STEP_DOWN:
		return {"ok": false, "why": "Es un club muy por debajo del tuyo: no bajan a por ti."}
	var my_div: int = int(prof.get("div", 0))
	if my_div > 0:
		var top: int = my_div - Market.MAX_STEP_UP \
				-(Market.FEAT_STEP_UP if float(prof.get("feat", 0.0))
				>= Market.STEP_UP_FEAT_MIN else 0)



		if top > 0 and GameState.div_of(club_id) < top:
			return {"ok": false,
				"why": "Está demasiadas categorías por encima: se sube de una en una."}
	var cost: int = int(float(int(prof.get("value", 0))) * Market.fee_context_mult(prof))







	if mini(cost, Market.club_budget(Market.BUDGET_TOP_RATING)) \
			> Market.club_budget(rating):
		return {"ok": false, "why": "No pueden pagar lo que costaría sacarte."}


	var sc: Dictionary = Market.scouting(prof)




	return {"ok": false, "why": I18n.t("No les das el perfil todavía.")
		+ " " + I18n.t(String(sc["verdict"]))}







func _agent_pre_open() -> bool:
	return Market.window_id(GameState.season_day, GameState.winter_day()) \
			== Market.WINDOW_WINTER \
			and int(contract.get("seasons_left", 0)) <= 1 \
			and pending_precontract.is_empty() and age + 1 < RETIRE_AGE





















func _agent_pre_p(club_id: String) -> float:
	if not _agent_pre_open():
		return -1.0
	var club: Dictionary = Teams.by_id(club_id)
	if club.is_empty() or club_id == GameState.player_team_id:
		return -1.0
	var prof: Dictionary = scout_profile()
	if not Market.cortejo_cabe(int(club.get("rating", 62)),
			Market.cortejo_suelo(GameState.player_team_id)):
		return -1.0

	var techo: int = Market.escalera_techo(prof, Market.cortejo_suelo(GameState.player_team_id),
		GameState.player_team_id, true)
	if techo > 0 and GameState.div_of(club_id) < techo:
		return -1.0
	var pull_cap: float = Market.EX_CLUB_PULL if is_ex_club(club_id) else Market.AGENT_PULL
	return Market.precontract_interest(club, prof, GameState.player_team_id,
		Market.agent_pull(int(prof.get("agente", 0))), pull_cap)





func agent_pre_reach(club_id: String) -> bool:
	return _agent_pre_p(club_id) >= Market.MIN_INTEREST





func _offer_index(club_id: String) -> int:
	for i in pending_offers.size():
		if String(pending_offers[i].get("id", "")) == club_id:
			return i
	return -1










func _resolve_agent_hold() -> void:
	var target: String = String(agent_shot.get("target", ""))
	agent_shot = {}
	var idx: int = _offer_index(target)
	if idx < 0:


		_agent_outcome(false, String(Teams.by_id(target).get("name", "")),
			TAG_HOLD_FAIL)
		return
	var offer: Dictionary = pending_offers[idx]
	var club: String = Market.club_name(offer, "")
	if randf() >= Market.agent_hold_p(int(rel["agente"])):
		_agent_outcome(false, club, TAG_HOLD_FAIL, target)
		return

	var last: int = Market.window_last_day(GameState.season_day, GameState.winter_day())
	offer["expires"] = mini(GameState.season_day + 2, last)
	offer["held"] = true
	_agent_outcome(true, club, TAG_HOLD_OK, target)





