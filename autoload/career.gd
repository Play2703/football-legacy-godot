	var meta: Variant = squad_meta.get(team_id, null)
	if meta is Array:
		var casa: int = Squad.asiento_de_ficha(Squad.of_nominal(team_id), squad[i])
		if casa >= 0 and casa <(meta as Array).size() \
				and not Rotation.disponible((meta as Array)[casa]):
			return -1
	return i





