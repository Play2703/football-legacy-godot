			var k2: String = String(c2)


			if k2.begins_with("nat"):
				continue
			var cell2: Dictionary = out.get(k2, {"g": 0, "a": 0})
			cell2["g"] = int(cell2["g"]) + int((comps[c2] as Dictionary).get("g", 0))
			cell2["a"] = int(cell2["a"]) + int((comps[c2] as Dictionary).get("a", 0))
			out[k2] = cell2
	return out










func _maybe_record(row_raw: Dictionary, mine: float, icon: String, lifetime: bool,
		scope: String, year: int = -1, nation: bool = false) -> void:
	var yr: int = year if year > 0 else GameState.season_num


	var row: Dictionary = Records.overlay(row_raw, record_marks)
	if not Records.beaten(row, mine):
		return
	var key: String = String(row["key"])






	if not bool(row.get("mine", false)) or int(mine) > int(row["value"]):





		var chain: Array =((record_marks.get(key, {}) as Dictionary)
			.get("chain", []) as Array).duplicate()
		if String(row.get("holder", "")) != player_name or int(row.get("year", 0)) != yr:
			chain.append({"holder": String(row.get("holder", "")),
				"value": int(row.get("value", 0)), "year": int(row.get("year", 0))})
		var m: Dictionary = Records.mark_of(player_name, int(mine), yr)
		m["chain"] = chain
		record_marks[key] = m
	var tag: String = key if lifetime else "%s|%d" % [key, yr]
	if records_broken.has(tag):
		return
	records_broken.append(tag)




	queue_ceremony(Ceremonies.RECORD, {
		"mode": "record",
		"label": String(row["label"]),
		"mark": int(mine),
		"holder": String(row["holder"]),


		"persona": String(row.get("persona", "")),
		"prev": int(row["value"]),
		"year": int(row.get("year", 0)),
		"icon": icon,
		"scope": scope,



		"nation": scope if nation else "",
	})








