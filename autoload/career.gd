func _cierra_impago(lines: Array[String]) -> void:
	impago_cierre = {}
	if impago.is_empty():
		return
	if pending_decision == IMPAGO_EVENT_ID or pending_decision == HUELGA_EVENT_ID:
		pending_decision = ""
	var deuda: int = int(impago.get("deuda", 0))
	var club_i: String = str(impago.get("club", ""))
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("impago|%d|%d" % [WorldAging.world_seed(), int(impago.get("temporada", 0))])


	var sale: String = _salida_concurso(club_i)
	var r: float = rng.randf()
	if sale == Concurso.SALE_CONVENIO:
		r = 1.0
	var c: Dictionary = Impagos.cierre(deuda, str(impago.get("eleccion", "")), r)
	var pagado: int = int(c["pagado"])
	impago_cierre = {"deuda": deuda, "pagado": pagado, "rescate": bool(c["rescate"])}
	if deuda > 0:
		money += pagado
		_apunta_ingreso("impago", pagado)
		if bool(c["rescate"]) and (sale == Concurso.SALE_SOCIOS or socios_de(club_i)):

			lines.append(I18n.tf("Los socios te pagan lo que te debía el club: ${0}",
				[CareerUi.money(pagado)]))
		elif bool(c["rescate"]):
			lines.append(I18n.tf("El dueño nuevo te paga lo que te debía el club: ${0}",
				[CareerUi.money(pagado)]))
		else:
			lines.append(I18n.tf("El club te paga la mitad de lo que te debía: ${0} de ${1}",
				[CareerUi.money(pagado), CareerUi.money(deuda)]))
	_rescate_dueno = bool(c["rescate"]) and str(impago.get("club", "")) == GameState.player_team_id
	impago = {}



