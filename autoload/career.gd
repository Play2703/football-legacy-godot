func _mate_compare() -> Dictionary:
	if season_matches <= 0:
		return {}

	var ga: Dictionary = {}
	for comp in season_mate_goals:
		for nm in season_mate_goals[comp]:
			ga[nm] = ga.get(nm, [0, 0])
			ga[nm][0] += int(season_mate_goals[comp][nm])
	for comp in season_mate_assists:
		for nm in season_mate_assists[comp]:
			ga[nm] = ga.get(nm, [0, 0])
			ga[nm][1] += int(season_mate_assists[comp][nm])



	var by_name: Dictionary = {}
	for r in squad_roster():
		if not bool(r.get("is_you", false)):
			by_name[String(r.get("name", ""))] = r
	var mates: Array = []
	for nm in ga:
		var r: Dictionary = by_name.get(nm, {})
		mates.append({"name": nm, "g": int(ga[nm][0]), "a": int(ga[nm][1]),


			"pos": String(r.get("pos", "")),
			"ovr": int(r.get("media", 0)),
			"avg": float(r.get("avg", 0.0))})

	mates.sort_custom(func(x: Dictionary, y: Dictionary) -> bool:
		var gx: int = int(x["g"]) + int(x["a"])
		var gy: int = int(y["g"]) + int(y["a"])
		return gx > gy if gx != gy else int(x["ovr"]) > int(y["ovr"]))
	return {
		"you": {"g": season_goals, "a": season_assists, "avg": season_avg(),
			"ovr": int(round(skills_avg())), "pos": Squad.USER_POS},
		"mates": mates.slice(0, 5),
	}





