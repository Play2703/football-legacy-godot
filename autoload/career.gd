func _migrate_offer_bids() -> void:
	if pending_offers.is_empty():
		return


	for o in pending_offers:
		if o is Dictionary and not (o as Dictionary).has("bid"):
			o["bid"] = maxi(int(o.get("fee", 0)), ask_for(o))
			o["_migrated_bid"] = true












func _maybe_foto_equipo(cerrada: String) -> bool:
	if cerrada != Market.WINDOW_SUMMER or free_agent or retired:
		return false
	var club: String = GameState.player_team_id
	if club.is_empty():
		return false
	queue_ceremony(Ceremonies.FOTO_EQUIPO, {
		"club": club,
		"season": GameState.season_num,
		"trofeos": _foto_trofeos(club),
	})
	return true










func _foto_trofeos(club: String) -> Array:
	var out: Array = []
	for par in [[GameState.last_ucl_winner, "champions"], [GameState.last_eul_winner, "europa"],
			[GameState.last_lib_winner, "libertadores"], [GameState.last_sud_winner, "sudamericana"],
			[GameState.last_cca_winner, "concacaf"]]:
		if String(par[0]) == club:
			out.append(String(par[1]))
	if _archivo_vivo():
		var n: int = int(club_titulos_ano.get(club, 0))
		var copas: int = 0
		if int(GameState.last_orden_1a.get("season", -1)) == club_puesto_temporada:
			var pin: Dictionary = GameState.last_orden_1a.get("copa", {}) as Dictionary
			for p in pin:
				if GameState._euro_sim_id(String(pin[p])) == club:
					copas += 1
		copas = mini(copas, n)
		for i in n - copas:
			out.append("liga")
		for i in copas:
			out.append("copa")
	return out.slice(0, FOTO_TROFEOS_MAX)


const FOTO_TROFEOS_MAX: int = 3








static func ficha_guardable(v: Variant) -> Variant:
	match typeof(v):
		TYPE_OBJECT, TYPE_CALLABLE, TYPE_SIGNAL, TYPE_RID:
			return null
		TYPE_DICTIONARY:
			var d: Dictionary = {}
			for k in v:
				var x: Variant = ficha_guardable(v[k])
				if x != null:
					d[k] = x
			return d
		TYPE_ARRAY:
			var a: Array = []
			for e in v:
				var x: Variant = ficha_guardable(e)
				if x != null:
					a.append(x)
			return a
	return v
