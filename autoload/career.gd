func reencuentro(club_id: String) -> Dictionary:
	if club_id.is_empty() or club_id == GameState.player_team_id:
		return {}
	if not loan.is_empty() and String(loan.get("parent", "")) == club_id:
		return {}
	var etapas: Array = TransferBook.trayectoria_propia(start_club, transfers,
		GameState.player_team_id, not loan.is_empty())["etapas"]
	var salida: Dictionary = TransferBook.salida_de(etapas, club_id)
	if salida.is_empty():
		return {}
	var hace: int = TransferBook.salida_hace(etapas, club_id, GameState.season_num)
	if hace > REENCUENTRO_MEMORIA:
		return {}
	var via: String = String(salida.get("via", ""))
	var tono: String = "nada"
	if is_traitor_at(club_id):
		tono = "traidor"
	elif honored_at(club_id):
		tono = "honor"



	elif ex_pacto.has(club_id) and via == TransferBook.VIA_FICHAJE:
		tono = "carino"
	elif spurned_at(club_id) or via == TransferBook.VIA_FICHAJE:
		tono = "silba"
	elif via == TransferBook.VIA_VUELTA:
		tono = "carino"
	return {"via": via, "hasta": int(salida.get("hasta", 0)), "hace": hace,
		"tono": tono,
		"prima": int(reencuentro_cobros.get(club_id, -1)) != GameState.season_num}
















func reencuentro_cobra(club_id: String, goals: int, minutes: int, comp: String,
		unit: float) -> float:
	if comp == "nat" or minutes <= 0 or goals < 1:
		return 0.0
	var r: Dictionary = reencuentro(club_id)
	if r.is_empty() or not bool(r.get("prima", false)):
		return 0.0
	if not GameState.readonly_save:
		reencuentro_cobros[club_id] = GameState.season_num
	return unit * REENCUENTRO_PRIMA


