func gerencia_tuyos() -> Array:
	var r: Variant = gerencia.get("tuyos", [])
	return r if r is Array else []


func _tuyos_apunta(nombre: String, club: String, pos: String, fee: int) -> void:
	if nombre.is_empty():
		return
	var libro: Array = gerencia_tuyos().duplicate()
	libro.push_front({"name": nombre, "club": club, "season": GameState.season_num,
		"fee": fee, "pos": pos, "gp": 0, "g": 0, "a": 0, "rs": 0.0, "fuera": -1})


	while libro.size() > Gerencia.TUYOS_MAX:
		var peor: int = libro.size() - 1
		for i in range(1, libro.size()):
			if int((libro[i] as Dictionary).get("gp", 0)) \
					< int((libro[peor] as Dictionary).get("gp", 0)):
				peor = i
		libro.remove_at(peor)
	gerencia["tuyos"] = libro





func _tuyos_plantel() -> Dictionary:
	var mio: String = GameState.player_team_id
	var squad: Array = Squad.of_nominal(mio)
	var meta: Array = squad_meta.get(mio, [])
	var por_nombre: Dictionary = {}
	var notas: Array = []
	for i in mini(squad.size(), meta.size()):
		var pm: Dictionary = meta[i]
		por_nombre[String((squad[i] as Dictionary).get("name", ""))] = pm
		if int(pm.get("gp", 0)) >= Gerencia.OJO_MIN_PJ:
			notas.append(SquadMeta.season_avg(pm))
	notas.sort()
	var mediana: float = 0.0
	if not notas.is_empty():
		var m: int = notas.size() / 2
		mediana = float(notas[m]) if notas.size() % 2 == 1 \
				else (float(notas[m - 1]) + float(notas[m])) * 0.5
	return {"pm": por_nombre, "mediana": mediana}





func gerencia_mejor_tuyo() -> Dictionary:
	var mejor: Dictionary = {}
	var nota_mejor: float = -1.0
	for e in gerencia_tuyos():
		var t: Dictionary = e
		var gp: int = int(t.get("gp", 0))
		if gp < Gerencia.MEJOR_MIN_PJ:
			continue
		var nota: float = float(t.get("rs", 0.0)) / float(gp)
		if nota > nota_mejor:
			nota_mejor = nota
			mejor = t.duplicate()
			mejor["nota"] = nota
	return mejor





func gerencia_tuyos_vista() -> Array:
	var libro: Array = gerencia_tuyos()
	if libro.is_empty():
		return []
	var pm_de: Dictionary = _tuyos_plantel()["pm"]
	var out: Array = []
	for e in libro:
		var t: Dictionary = e
		if String(t.get("club", "")) != GameState.player_team_id:
			continue
		var fila: Dictionary = t.duplicate()
		var nombre: String = String(t.get("name", ""))
		if int(t.get("fuera", -1)) < 0 and pm_de.has(nombre):
			var pm: Dictionary = pm_de[nombre]
			fila["gp"] = int(t.get("gp", 0)) + int(pm.get("gp", 0))
			fila["g"] = int(t.get("g", 0)) + int(pm.get("goals", 0))
			fila["a"] = int(t.get("a", 0)) + int(pm.get("assists", 0))
			fila["rs"] = float(t.get("rs", 0.0)) + float(pm.get("rating_sum", 0.0))
		elif int(t.get("fuera", -1)) < 0:

			fila["fuera"] = GameState.season_num
		out.append(fila)
	return out






func _gerencia_juicio_anual(lines: Array) -> void:
	var libro: Array = gerencia_tuyos()
	if libro.is_empty():
		return
	var anio: int = anio_vivo()
	if int(gerencia.get("tuyos_cierre", -1)) == anio:
		return
	gerencia["tuyos_cierre"] = anio
	var plantel: Dictionary = _tuyos_plantel()
	var pm_de: Dictionary = plantel["pm"]
	var mediana: float = float(plantel["mediana"])
	var saldo: int = 0
	for e in libro:
		var t: Dictionary = e
		if String(t.get("club", "")) != GameState.player_team_id \
				or int(t.get("fuera", -1)) >= 0:
			continue
		var nombre: String = String(t.get("name", ""))
		if not pm_de.has(nombre):
			t["fuera"] = anio
			continue
		var pm: Dictionary = pm_de[nombre]
		var gp: int = int(pm.get("gp", 0))
		t["gp"] = int(t.get("gp", 0)) + gp
		t["g"] = int(t.get("g", 0)) + int(pm.get("goals", 0))
		t["a"] = int(t.get("a", 0)) + int(pm.get("assists", 0))
		t["rs"] = float(t.get("rs", 0.0)) + float(pm.get("rating_sum", 0.0))
		var nota: float = SquadMeta.season_avg(pm)
		var visto: String = Competitions.demarca(nombre)
		match Gerencia.ojo_veredicto(nota, mediana, gp):
			1:
				saldo += Gerencia.OJO_ACIERTO
				lines.append(I18n.tf("Tu ojo: {0} cerró el año con nota {1}",
					[visto, "%.1f" % nota]))
			-1:
				saldo += Gerencia.OJO_FALLO
				lines.append(I18n.tf("{0} no convenció al técnico", [visto]))
	saldo = clampi(saldo, - Gerencia.OJO_TOPE, Gerencia.OJO_TOPE)
	if saldo != 0:
		_apply_delta("tecnico", float(saldo))









