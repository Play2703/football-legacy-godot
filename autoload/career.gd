func _eleccion_jornada() -> void:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty():
		return
	if str(eleccion_club.get("club", "")) != mio \
			or int(eleccion_club.get("temporada", -1)) != GameState.season_num:
		var crisis: bool = proyecto_de(mio) == ClubFinance.PROYECTO_CRISIS
