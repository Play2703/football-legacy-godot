func firma_fx(escena: String, firmar: bool) -> Dictionary:
	var fila: Dictionary =(FIRMA_FX.get(escena, {}) as Dictionary).get(
		"si" if firmar else "no", {})
	var out: Dictionary = {}
	for k in fila:
		var key: String = String(k)
		if key == "pareja" and not pareja_activa():
			continue
		if not rel.has(key) or rel_derivada(key):
			continue
		out[key] = float(fila[k])
	return out






func firma_resuelve(escena: String, firmar: bool, firmas: int = 1) -> Dictionary:
	var fx: Dictionary = firma_fx(escena, firmar)
	var antes: Dictionary = {}
	for k in fx:
		antes[k] = int(rel.get(k, 0))
	for k in fx:
		_apply_delta(String(k), _div_decision_scale(float(fx[k])), REL_BRAKE_EXP_DECISION)
	var despues: Dictionary = {}
	for k in fx:
		despues[k] = int(rel.get(k, 0))
	if firmar and firmas > 0:
		autografos_total += firmas
		Achievements.ingest_firmas(firmas)


	if escena == "camiseta":
		muro_pon("camiseta")
	elif escena == "rival":
		if firmar:
			muro_pon("firma_rival")
	elif escena == "seguridad":

		if firmar:
			muro_pon("revendedor")
	elif escena == "reventa":
		muro_pon("reventa")
	elif escena != "pizarra":
		muro_pon("firma" if firmar else "no_firma")
	_save()
	return {"antes": antes, "despues": despues}







