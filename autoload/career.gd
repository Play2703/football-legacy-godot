func romper_relacion() -> bool:
	if not pareja_activa():
		return false


	var hist: Array = pareja_historial()
	var actual: String = String(pareja.get("id", ""))


	var antes: String = String(pareja.get("estado", ""))
	if antes == "casado":
		_pareja_noticia(WorldNews.PAREJA_DIVORCIO)
	elif antes in CONVIVEN:
		_pareja_noticia(WorldNews.PAREJA_RUPTURA)




	if not actual.is_empty():
		Achievements.ingest_pareja(actual, pareja_nombre())
		hist.append({"id": actual, "nat": String(pareja.get("nat", nationality))})
	pareja["historial"] = hist
	pareja["estado"] = "roto"

	for _k in ["lejos", "lejos_temp", "lejos_frac", "viaje", "viaje_de", "lesion"]:
		pareja.erase(_k)
	rel["pareja"] = 0
	rel_frac["pareja"] = 0.0



	pareja_pago = 0.0
	pareja_frio = 0
	pareja_rechazadas = {}
	pareja_prenup = false
	pareja_boda_season = -1
	citas_hechas = 0
	citas_cuenta = {}
	citas_aciertos = 0
	return true

























func dejarla() -> Dictionary:
	if not pareja_activa():
		return {}
	if not pareja_casada():

		romper_relacion()
		_save()
		changed.emit()
		return {"cuenta": {}, "casado": false, "pendiente": false}



	_apply_delta("prensa", _div_decision_scale(- PAREJA_DEJAR_PRENSA),
		REL_BRAKE_EXP_DECISION)
	for id in WeekEvents.CONOCER:
		scene_veto[String(id)] = RUPTURA_VETO








	if PAREJA.arruina(String(pareja.get("id", ""))):






		var ya_la_mando: bool = pending_decision == DIVORCE_EVENT_ID
		_seed_divorcio()
		if not ya_la_mando:
			pareja["la_dejas"] = true
		_save()
		changed.emit()
		return {"cuenta": {}, "casado": true, "pendiente": true}

	var cuenta: Dictionary = divorciarse()
	_save()
	changed.emit()
	return {"cuenta": cuenta, "casado": true, "pendiente": false}







