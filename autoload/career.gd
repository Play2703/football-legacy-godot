func _salida_cost_fx(fx: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for key in fx:
		var step: int = projected_delta(String(key), float(fx[key]))
		out[key] = _loan_refuse_floor(step) if String(key) == "tecnico" else step
	return out







func _salida_aplica(fx: Dictionary) -> void:
	var before: Dictionary = rel.duplicate()
	var suelo: int = int(before.get("tecnico", 0)) \
			+ int(_salida_cost_fx(fx).get("tecnico", 0))
	for key in fx:
		_apply_delta(String(key), _div_decision_scale(float(fx[key])),
			REL_BRAKE_EXP_DECISION)


	if fx.has("tecnico") and int(rel.get("tecnico", 0)) < suelo:
		rel["tecnico"] = suelo
		rel_frac["tecnico"] = 0.0
	last_rel_delta = _rel_delta_since(before)



