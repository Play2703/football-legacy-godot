func _entregar_lote(e: Dictionary, recibo: Dictionary) -> void:
	var dinero: int = int(e.get("dinero", 0))
	if dinero > 0:
		money += dinero
		recibo["dinero"] = int(recibo.get("dinero", 0)) + dinero
	var puntos: int = int(e.get("puntos", 0))
	if puntos > 0:
		var xp: int = grant_skill_points(puntos)
		recibo["xp"] = int(recibo.get("xp", 0)) + xp
		if xp == 0:
			recibo["puntos"] = int(recibo.get("puntos", 0)) + puntos


	var pares: Array = []
	for id in e.get("botas", []):
		var modelo: String = String(id)
		var b: Dictionary = Shop.boots_by_id(modelo)
		if String(b["id"]) != modelo or modelo == "cantera" or pares.has(modelo):
			continue
		if not owned.has(modelo):
			owned.append(modelo)
		boots_wear.erase(modelo)
		boots_cooldown.erase(modelo)
		pares.append(modelo)
	if not pares.is_empty():
		recibo["botas"] = pares
	var nuevas: Array = []
	for id in e.get("ediciones", []):
		var ed: String = String(id)
		if Iap.edicion(ed).is_empty() or boots_ediciones.has(ed):
			continue
		boots_ediciones.append(ed)
		nuevas.append(ed)
	if not nuevas.is_empty():
		boots_edicion = String(nuevas[0])
	recibo["ediciones"] = nuevas



