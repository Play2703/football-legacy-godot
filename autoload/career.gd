func _apply_rebirth_mods(ids: Array) -> void:
	active_mods = []





	var aplicados: Array = []

	var filtra_kits: bool = ids.has(Herencia.KITS_ELEGIDOS)
	for k in Herencia.kits_activos():
		if filtra_kits and not ids.has(String(k["id"])):
			continue
		aplicados.append(k)
		_aplica_mod(k)

	for raw in ids:
		var id: String = String(raw)
		if not Rebirth.is_unlocked(id):
			continue
		var m: Dictionary = Rebirth.by_id(id)
		if m.is_empty() or active_mods.has(id):
			continue




		active_mods.append(id)
		aplicados.append(m)
		_aplica_mod(m)


	for mf in aplicados:
		for key in mf.get("rel_floor", {}):





			var canal_r: String = str(key)
			if not rel.has(canal_r) or rel_derivada(canal_r):
				continue
			rel[canal_r] = maxi(int(rel.get(canal_r, 0)), int(mf["rel_floor"][key]))





func _aplica_mod(m: Dictionary) -> void:
	money += int(m.get("money_bonus", 0))
	skill_points += int(m.get("skill_points", 0))
	var raw_bonus = m.get("skill_bonus")
	if raw_bonus is Dictionary:
		for stat in raw_bonus:
			var stat_name: String = str(stat)
			if stat_name.is_empty() or not skills.has(stat_name):
				continue
			var delta: int = int(raw_bonus[stat])
			if delta > 0 and skill_en_declive(stat_name):
				continue
			skills[stat_name] = mini(90, int(skills.get(stat_name, 60)) + delta)



	if m.has("boots"):
		boots = String(m["boots"])
		boots_wear.erase(boots)



	agent_level = maxi(agent_level, int(m.get("agent_level", 0)))
	if int(m.get("house_level", 0)) > house_level:
		_inherit_house(int(m["house_level"]))



	if m.has("land_tier"):
		land_tier = maxi(land_tier, House.clamp_tier(int(m["land_tier"])))







	var life_id: String = String(m.get("shop_item", ""))
	if not life_id.is_empty() and not lifestyle.has(life_id):
		var l_mod: Dictionary = Shop.lifestyle_by_id(life_id)
		if not l_mod.is_empty():
			lifestyle.append(life_id)
			var kind_mod: String = House.lifestyle_kind(life_id)
			if not kind_mod.is_empty():
				_add_house_item(kind_mod, "", Vector2.ZERO)
			for key in Shop.LIFESTYLE_KEYS:
				var delta_mod: int = int(l_mod.get(key, 0))
				if delta_mod != 0 and rel.has(key):
					rel[key] = clampi(int(rel[key]) + delta_mod, 0, 100)




	var inv_id: String = String(m.get("invest_id", ""))
	if not inv_id.is_empty() and not investments.has(inv_id):
		if not Shop.investment_by_id(inv_id).is_empty():
			investments.append(inv_id)

	if m.has("nat_edge"):
		nat_edge = clampi(nat_edge + int(m["nat_edge"]),
			- NAT_EDGE_CAP, NAT_EDGE_CAP)







func _inherit_house(level: int) -> void:
	house_level = House.clamp_level(level)
	house_best = maxi(house_best, house_level)


	land_tier = maxi(land_tier, House.clamp_tier(
		mini(land_tier + house_level, House.TIER_TOPE_REGALO)))
	var bumps: Dictionary = House.level_data(house_level).get("rel", {})
	for key in Shop.LIFESTYLE_KEYS:
		var delta: int = int(bumps.get(key, 0))
		if delta != 0:
			rel[key] = clampi(int(rel.get(key, 0)) + delta, 0, 100)






func mods_have(key: String) -> bool:
	for raw in active_mods:
		var m: Dictionary = Rebirth.by_id(String(raw))
		if m.has(key):
			return true
	return false















func mods_shirt_pref() -> int:
	for m in Rebirth.all():
		if m.has("shirt_pref") and active_mods.has(String(m["id"])):
			return int(m["shirt_pref"])
	return 0













func _bump_contract_role() -> void:
	var ladder: Array = ["esporadico", "rotacion", "titular"]
	var i: int = ladder.find(String(contract.get("role", "esporadico")))
	var bumped: int = mini(maxi(i, 0) + 1, ladder.size() - 1)
	if bumped == i:
		return
	contract["role"] = String(ladder[bumped])





