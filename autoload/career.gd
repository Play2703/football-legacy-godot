const NAT_ROTA_P: float = 0.4

func _nat_rotacion(status: String, cu: Dictionary) -> String:


	if status != String(cu.get("status", "")) or not nat_rota_hoy(cu):
		return status
	return "banca" if status == "titular" else "titular"




func nat_rota_hoy(cu: Dictionary) -> bool:
	var status: String = String(cu.get("status", "fuera"))
	if status != "titular" and status != "banca":
		return false
	if String(cu.get("merito", "")) == "balon":
		return false
	var f: Dictionary = GameState.current_fixture()
	if String(f.get("comp", "")) != "nat" or not GameState.nat_fecha_decidida(f):
		return false
	var k: int = int(cu.get("line_rank", -1))
	var st: int = int(cu.get("line_starters", 0))
	var en_el_corte: bool =(status == "titular" and k == st - 1) \
			or (status == "banca" and k == st)
	if not en_el_corte:
		return false
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("rota|%d|%s|%d|%s" % [GameState.season_num, String(f.get("round", "")),
		int(f.get("nat_round", 0)), nationality])
	return rng.randf() < NAT_ROTA_P




func nat_role_motivo() -> String:
