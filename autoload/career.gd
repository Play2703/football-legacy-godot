func _juvenil_debut_hoy(squad: Array, meta: Array, minutos: Dictionary,
		cambios: Array = []) -> void:
	if retired or GameState.tutorial_active or not GameState.practice_kind.is_empty():
		return
	var en_campo: Dictionary = {}
	var rows: Array = []
	for i in mini(squad.size(), meta.size()):
		var p: Dictionary = squad[i]
		var nm: String = String(p.get("name", ""))
		if not (juveniles["nacidos"] as Dictionary).has(nm):
			continue
		if int(minutos.get(i, 0)) > 0:
			en_campo[nm] = true
		rows.append({"name": nm, "pos": String(p.get("pos", "MC")),
			"number": int(p.get("number", i + 1)),
			"age": int((meta[i] as Dictionary).get("age", 18)),
			"gp": int((meta[i] as Dictionary).get("gp", 0)), "seat": i})
	var row: Dictionary = Juveniles.debutante(rows, en_campo,
		juveniles["debut"] as Array, juveniles["nacidos"] as Dictionary)
	if row.is_empty():
		return
	(juveniles["debut"] as Array).append(String(row["name"]))
	var fx: Dictionary = GameState.current_fixture()
	var pay: Dictionary = _juvenil_payload(row)
	pay["home"] = bool(fx.get("home", true))
	pay["opp"] = String(fx.get("opp", ""))
	var sale: int = 0
	for c in cambios:
		var cd: Dictionary = c
		var s_i: int = int(cd.get("sale", -1))
		if int(cd.get("entra", -1)) == int(row["seat"]) and s_i >= 0 and s_i < squad.size():
			sale = int((squad[s_i] as Dictionary).get("number", s_i + 1))
			break
	pay["sale"] = sale
	queue_ceremony(Ceremonies.JUVENIL_DEBUT, pay)








func _juvenil_primer_gol(scorers: Dictionary, comp: String) -> void:
	var mio: String = GameState.player_team_id
	if retired or scorers.is_empty() or mio.is_empty() or comp == "nat":
		return
	var memo: Dictionary = juveniles["memoria"]
	if not memo.has(mio):
		memo[mio] = Juveniles.nueva_memoria(GameState.season_num,
			Juveniles.temporadas_en(mio, start_club, transfers, GameState.season_num))
	var marcaron: Dictionary =(juveniles["marcaron"] as Dictionary).get(mio, {})
	var nacidos: Dictionary = juveniles["nacidos"]
	var squad: Array = Squad.of_nominal(mio)
	var meta: Array = _ensure_squad_meta(mio, squad)
	var observados: Dictionary = {}
	for i in mini(squad.size(), meta.size()):
		var nm: String = String((squad[i] as Dictionary).get("name", ""))
		if nacidos.has(nm) or Juveniles.observado(memo[mio],
				int((meta[i] as Dictionary).get("signed", -9999))):
			observados[nm] = true
	var rows: Array = squad_roster()
	var row: Dictionary = Juveniles.goleador(rows, scorers,
		juveniles["gol"] as Array, marcaron, observados)
	for r in rows:
		var nm: String = String((r as Dictionary).get("name", ""))
		if Juveniles.es_juvenil(r) and int(scorers.get(nm, 0)) > 0:
			marcaron[nm] = true
	(juveniles["marcaron"] as Dictionary)[mio] = marcaron
	if row.is_empty():
		return
	(juveniles["gol"] as Array).append(String(row["name"]))
	var pay: Dictionary = _juvenil_payload(row)
	pay["comp"] = comp
	queue_ceremony(Ceremonies.JUVENIL_GOL, pay)







