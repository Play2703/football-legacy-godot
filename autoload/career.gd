func pareja_candidata() -> String:
	var sello: Dictionary = _cand_sellada()
	if not sello.is_empty():
		return String(sello["id"])
	var pais: String = Teams.country_of(GameState.player_team_id)
	if pais.is_empty():
		pais = nationality
	var pool: Array = PAREJA.pool_for(pais, world_seed + GameState.season_num, 3)
	if pool.is_empty():
		return ""





	var vivas: Array = []
	for c in pool:
		if int(pareja_rechazadas.get(String(c), -1)) != GameState.season_num:
			vivas.append(c)
	if vivas.is_empty():
		return ""
	pool = vivas



	var candidatas: Array = pool










	var vistas: Array = pareja_historial_ids()
	if not pareja.is_empty():
		var actual: String = String(pareja.get("id", ""))
		if not actual.is_empty():
			vistas.append(actual)
		var sin_ver: Array = []
		for cand in pool:
			if not vistas.has(String(cand)):
				sin_ver.append(cand)


		if not sin_ver.is_empty():
			candidatas = sin_ver














	for cand in candidatas:
		if _puerta_abierta(PAREJA.sitio_de(String(cand))):
			return String(cand)















	var larga: Array = PAREJA.pool_for(pais, world_seed + GameState.season_num,
		PAREJA.PERFILES.size())
	for cand in larga:
		var id_c: String = String(cand)
		if int(pareja_rechazadas.get(id_c, -1)) == GameState.season_num:
			continue
		if vistas.has(id_c):
			continue
		if _puerta_abierta(PAREJA.sitio_de(id_c)):
			return id_c
	return String(candidatas[0])










func _puerta_abierta(sitio: String) -> bool:
	for k in WeekEvents.puerta_pide(sitio):
		match String(k):
			"famous":
				if not _es_famoso():
					return false
			"sponsor":
				if sponsors.is_empty():
					return false
			_:
				return false
	return true





