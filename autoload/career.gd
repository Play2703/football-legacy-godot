			"promesa": Elecciones.promesa(crisis, rng.randf()), "partidos": 0, "apoyo": ""}
	if bool(eleccion_club.get("no", false)):
		return
	eleccion_club["partidos"] = int(eleccion_club.get("partidos", 0)) + 1
	if int(eleccion_club["partidos"]) < Elecciones.PARTIDO or not str(eleccion_club.get("apoyo", "")).is_empty():
		return
