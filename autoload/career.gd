func elegir_idolo(row: Dictionary, rank: int, tipo: String = "leyenda") -> bool:
	if not idolo.is_empty():
		return false
	var key: String = String(row.get("name", "")) if tipo == "activo" \
			else Legends.key_of(row)
	if key.is_empty():
		return false
	idolo = {"tipo": tipo, "key": key, "name": String(row.get("name", "")),
		"nat": Nations.canon_id(String(row.get("nat", ""))), "rank": rank,
		"season": GameState.season_num,
		"motm0": awards.count("Jugador del Mes")}


	var tabla: Array = WorldRanking.rows(1)
	var tu_rank: int = WorldRanking.rank_of_you(tabla)
	if tu_rank > 0:
		idolo["tu_rank"] = tu_rank
	if tipo == "activo":
		idolo["club"] = String(row.get("club", ""))
		idolo["pos"] = String(row.get("pos", ""))
		idolo["ovr"] = int(row.get("ovr", 0))




		if tu_rank > 0 and rank > 0:
			idolo["rank_con_yo"] = rank +(1 if rank >= tu_rank else 0)
		if row.has("age"):
			idolo["age"] = int(row.get("age", 0))



		var crudo: String = ""
		if row.get("libre", null) is Dictionary:
			crudo = String((row["libre"] as Dictionary).get("name", ""))
		else:
			var sq: Array = Squad.of(String(row.get("club", "")))
			var st: int = int(row.get("seat", -1))
			if st >= 0 and st < sq.size():
				crudo = String((sq[st] as Dictionary).get("name", ""))
		if not crudo.is_empty() and Competitions.demarca(crudo) == key:
			idolo["crudo"] = crudo


		var club: String = String(row.get("club", ""))
		var seat0: int = int(row.get("seat0", -1))
		if seat0 >= 0 and club != Teams.FREE_ID and not club.is_empty():
			idolo["seat0"] = seat0
			idolo["retiro_prev"] = GameState.season_num + WorldAging.retires_in_casa(
				club, seat0, String(row.get("pos", "MC")), int(row.get("age", -1)))
	_save()
	return true






func queue_ceremony(kind: String, payload: Dictionary = {}) -> void:
	var entry: Dictionary = payload.duplicate()
