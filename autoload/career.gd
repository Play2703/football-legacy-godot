func pide_dt_motivo(f: Dictionary) -> String:
	var mio: String = GameState.player_team_id
	if free_agent or mio.is_empty():
		return "sin_club"
	var id: String = String(f.get("id", ""))
	if bool(f.get("tuyo", false)) or id.is_empty() or id == Coaches.id_of(mio):
		return "tuyo"
	var club: String = String(f.get("club", ""))




	if Coach.es_nat(club) and not nationality.is_empty() \
			and Coach.pais_nat(club) == Nations.canon_id(nationality):
		return "seleccion"
	if peldano() < Gerencia.PELDANO_CASA:
		return "peldano"
	if transfer_requested:
		return "pediste"
	var sitio: Dictionary = _pide_dt_sitio(f)
	if sitio.is_empty():
		return "no_vendria"
	var antes: String = String(sitio.get("club", sitio.get("ultimo", "")))
	if not Coach.puede_entrenar(Coach.rating_de(antes), mio,
			int(f.get("nivel", Coach.NIV_REF))):
		return "no_vendria"
	return ""




func _pide_dt_sitio(f: Dictionary) -> Dictionary:
	var club: String = String(f.get("club", ""))
	if not club.is_empty():
		return {"club": club}
	var id: String = String(f.get("id", ""))
	for i in coach_paro.size():
		var e: Array = coach_paro[i]
		if e.size() >= 2 and Coach.face_seed(String(e[0]), int(e[1])) == id:
			return {"paro": i, "ultimo": String(e[3]) if e.size() > 3 else String(e[0])}
	for d in coach_book:
		var fd: Dictionary = d
		if String(fd.get("ahora", "")).is_empty() and Coach.face_seed(
				String(fd.get("club", "")), int(fd.get("term", 1))) == id:
			return {"ficha": fd, "ultimo": String(fd.get("club", ""))}
	return {}




func _pide_dt_recien_sentado(f: Dictionary) -> bool:
	var club: String = String(_pide_dt_sitio(f).get("club", ""))
	if club.is_empty():
		return false
	return int(Coaches.seat(club).get("desde", -1)) >= GameState.season_num



