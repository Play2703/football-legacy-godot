func _resolve_agent_club(cap: int) -> void:
	var target: String = String(agent_shot.get("target", ""))
	agent_shot = {}
	var club_name: String = String(Teams.by_id(target).get("name", ""))
	if target.is_empty() or pending_offers.size() >= cap:
		_agent_outcome(false, club_name, TAG_AGENT_FULL)
		return
	for o in pending_offers:
		if String(o.get("id", "")) == target:


			_agent_outcome(true, club_name, TAG_AGENT_DONE, target)
			return
	if _market_rejected.has(target):
		_agent_outcome(false, club_name, TAG_AGENT_VETO)
		return














	var homecoming: bool = is_ex_club(target)
	var pull_cap: float = Market.EX_CLUB_PULL if homecoming else Market.AGENT_PULL
	for cand in Market.candidates(scout_profile(), GameState.player_team_id,
			_market_floor(), false, target, pull_cap):
		if String(cand.get("id", "")) != target:
			continue





		var puerta: float = Market.agent_door_p(int(rel["agente"])) \
				* clampf(0.5 + float(cand.get("interest", 0.0)), 0.5, 1.0)
		if homecoming:
			puerta = clampf(puerta * Market.EX_CLUB_DOOR_MULT, 0.0, 0.95)
		if randf() >= puerta:






			agent_tasks_used = maxi(agent_tasks_used - 1, 0)
			_agent_outcome(false, club_name, TAG_AGENT_FAIL)
			return
		var wd: int = GameState.winter_day()
		cand["expires"] = GameState.season_day + Market.offer_life(
			Market.window_days_left(GameState.season_day, wd), randf()) - 1
		pending_offers.append(cand)
		_agent_outcome(true, Market.club_name(cand, ""), TAG_AGENT_NEW, target)
		return

















	var p_pre: float = _agent_pre_p(target)
	if p_pre >= Market.MIN_INTEREST:
		var puerta_pre: float = Market.agent_door_p(int(rel["agente"])) \
				* clampf(0.5 + p_pre, 0.5, 1.0)
		if homecoming:
			puerta_pre = clampf(puerta_pre * Market.EX_CLUB_DOOR_MULT, 0.0, 0.95)
		if randf() >= puerta_pre:
			agent_tasks_used = maxi(agent_tasks_used - 1, 0)
			_agent_outcome(false, club_name, TAG_AGENT_FAIL)
			return
		var pre: Dictionary = Market._free_offer(Teams.by_id(target), scout_profile(), p_pre)
		pre["pre"] = true


		pre["expires"] = Market.window_last_day(GameState.season_day, GameState.winter_day())
		pending_offers.append(pre)
		_agent_outcome(true, Market.club_name(pre, ""), TAG_AGENT_PRE, target)
		return
	_agent_outcome(false, club_name, TAG_AGENT_FAR)








func _agent_outcome(ok: bool, club_name: String, tag: String,
		club_id: String = "") -> void:
	_market_note(tag, club_name if not club_id.is_empty() else "", club_id)
	agent_result = {"ok": ok, "name": club_name, "tag": tag}





	if tag == TAG_AGENT_NEW or tag == TAG_AGENT_PRE:
		_apply_delta("agente", AGENT_REL_WIN)
	elif tag == TAG_AGENT_FAR:
		_apply_delta("agente", AGENT_REL_WASTE)





func agent_fee(kind: String) -> int:
	return int(float(contract.get("wage", 0)) * float(AGENT_FEE_WAGES.get(kind, 0.0)))













func agent_signing_rate() -> float:



	var base: float = AGENT_SIGNING_CUT *(agent_cut_now() / AGENT_CUT)
	var k: float = clampf(float(rel["agente"]) / 100.0, 0.0, 1.0)
	var banda: float = lerpf(AGENT_SIGNING_MAX, AGENT_SIGNING_MIN, k)
	return base * banda / AGENT_SIGNING_CUT





func agent_signing_cut(prima: int) -> int:
	return int(float(maxi(prima, 0)) * agent_signing_rate())






func agent_signing_net(prima: int) -> int:
	return maxi(prima, 0) - agent_signing_cut(prima)




