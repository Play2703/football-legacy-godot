	for i in keepsakes.size():
		var k: Dictionary = keepsakes[i]
		if String(k.get("kind", "")) != Keepsakes.SHIRT \
				or not Keepsakes.legend_key_of(k).is_empty():
			continue
		var seat: Dictionary = WorldLegends.seat_of(String(k.get("who", "")),
			String(k.get("rival", "")))
		if seat.is_empty():
			continue
		var hoy: int = SquadMeta.ovr_of(seat, String(seat.get("pos", "MC")))
		if hoy > maxi(int(k.get("who_pico", 0)), int(k.get("who_ovr", 0))):
			var nuevo: Dictionary = k.duplicate()
			nuevo["who_pico"] = hoy
			keepsakes[i] = Keepsakes.sanitize(nuevo)



func _dar_playera(opp: String, comp: String, match_ctx: Dictionary,
		round_id: String = "", nation: String = "", final: bool = false,
		rating: float = 0.0) -> void:
	var squad: Array = Squad.of(opp)
	if squad.is_empty():
		return
	var tirada: Dictionary = _quien_te_la_da(squad, rating, randf())
	var best: int = int(tirada["idx"])
	var el: Dictionary = squad[best]
	var mio: String = String(GameState.you_team().get("id", ""))
	if not nation.is_empty():
		mio = String(Nations.as_team(nation).get("id", nation))
	var shirt: Dictionary = Keepsakes.make_shirt(
		GameState.season_num, mio, opp, comp,
		bool(GameState.current_fixture().get("home", true)),
		int(match_ctx.get("gf", 0)), int(match_ctx.get("ga", 0)),
		String(el.get("name", "")), best,
		int(el.get("number", 0)), GameState.shirt_number_now(), round_id,
		"", _media_npc(el), final)
	shirt = _suerte_playera(shirt, opp, best, false, bool(tirada["crack"]))
	keepsakes = Keepsakes.push(keepsakes, shirt)
	var acto: Dictionary = {
		"mode": "shirt", "keepsake": shirt, "div": GameState.player_div(),
	}
	if not nation.is_empty():
		acto["nation"] = nation
	queue_ceremony(Ceremonies.KEEPSAKE, acto)






const PARTIDAZO_NOTA: float = 8.5
const PARTIDAZO_PROB: float = 0.33


func _maybe_more_shirt(opp: String, comp: String, match_ctx: Dictionary,
		minutes: int, rating: float, result: int, fx: Dictionary) -> bool:
	if opp.is_empty() or minutes <= 0:
		return false
	var final: bool = _is_final(fx) and result > 0
	if not final and not (rating >= PARTIDAZO_NOTA and randf() < PARTIDAZO_PROB):
		return false
	_dar_playera(opp, comp, match_ctx, String(fx.get("round", "")), "", final, rating)
	return true


const LEGEND_SHIRT_NOTA: float = 8.0




























func _maybe_legend_shirt(opp: String, comp: String, match_ctx: Dictionary,
		minutes: int, rating: float, round_id: String = "") -> bool:
	if opp.is_empty() or minutes <= 0 or rating < LEGEND_SHIRT_NOTA:
		return false
	var key: String = leyenda_en_club(opp)
	if key.is_empty() or Keepsakes.has_legend_shirt(keepsakes, key):
		return false
	var ley: Dictionary = leyenda_para_acto(key)
	if ley.is_empty():
		return false



	var idx: int = -1
	var squad: Array = Squad.of(opp)
	for i in squad.size():
		if Legends.clave_activa(squad[i] as Dictionary) == key:
			idx = i
			break
	var shirt: Dictionary = Keepsakes.make_shirt(
		GameState.season_num, String(GameState.you_team().get("id", "")), opp, comp,
		bool(GameState.current_fixture().get("home", true)),
		int(match_ctx.get("gf", 0)), int(match_ctx.get("ga", 0)),
		"", idx, int(ley.get("dorsal", 0)), GameState.shirt_number_now(), round_id,
		key, _media_npc(squad[idx]) if idx >= 0 else 90, _is_final(GameState.current_fixture()))
	shirt = _suerte_playera(shirt, opp, idx, true)
	keepsakes = Keepsakes.push(keepsakes, shirt)
	queue_ceremony(Ceremonies.KEEPSAKE, {
		"mode": "shirt", "keepsake": shirt, "div": GameState.player_div(),
	})
	return true











