func sign_sponsor(id: String) -> bool:
	if sponsors.size() >= Sponsors.MAX_ACTIVE or has_sponsor(id):
		return false



	var c: Dictionary = {}
	for o in sponsor_offers:
		if String(o["id"]) == id:
			c = o
			break
	if c.is_empty():
		return false






	sponsors.append({"id": id, "seasons_left": Sponsors.SEASONS, "progress": 0,
		"target": int(c["target"]), "obj": String(c["obj"]),
		"min_matches": int(c.get("min_matches", 0)), "played": 0, "paid": 0,
		"missed": 0,





		"min_rating": int(c.get("min_rating", 0)),
		"per_kind": String(c.get("per_kind", "goal")), "avg": 0,
		"pay": int(c["pay"]), "per_goal": int(c["per_goal"]),
		"reward": int(c["reward"])})

	_maybe_valla(id, int(c["pay"]))
	sponsor_offers = sponsor_offers.filter(func(o: Dictionary) -> bool:
		return String(o["id"]) != id)



	_apply_delta("prensa", 3.0, REL_BRAKE_EXP_DECISION)
	_sync_sponsor_rel()

	Achievements.ingest_sponsor()
	_save()
	changed.emit()
	return true




func sponsor_break_fee(id: String) -> int:
	for s in sponsors:
		if String(s["id"]) == id:
			return Sponsors.break_fee(s)
	return 0









func drop_sponsor(id: String) -> bool:
	if not has_sponsor(id):
		return false
	var fee: int = sponsor_break_fee(id)



	money -= fee




	sponsor_burned[id] = Sponsors.BURN_SEASONS
	sponsors = sponsors.filter(func(s: Dictionary) -> bool:
		return String(s["id"]) != id)



	_apply_delta("prensa", -8.0, REL_BRAKE_EXP_DECISION)
	_apply_delta("agente", -5.0, REL_BRAKE_EXP_DECISION)
	_sync_sponsor_rel()
	_save()
	changed.emit()
	return true


func _sponsor_progress(ev: Dictionary, minutes: int, injured: bool) -> void:
	var played: bool = minutes > 0





	last_sponsors = []
	for s in sponsors:
		var before: int = int(s.get("progress", 0))





		if played:
			s["played"] = int(s.get("played", 0)) + 1
		elif injured:




			s["missed"] = int(s.get("missed", 0)) + 1


		if Sponsors.pays_this_match(s, minutes):
			s["paid"] = int(s.get("paid", 0)) + Sponsors.term(s, "pay") \
					+ Sponsors.term(s, "per_goal") \
					* Sponsors.event_count(Sponsors.per_kind_of(s), ev)




		s["avg"] = int(season_avg() * 10.0)
		match String(s["obj"]):
			"matches":


				s["progress"] = int(s["progress"]) \
						+(1 if Sponsors.counts_as_matchday(minutes) else 0)
			"rating":
				s["progress"] = int(season_avg() * 10.0)
			_:




				s["progress"] = int(s["progress"]) + Sponsors.event_count(
					Sponsors.obj_event(String(s["obj"])), ev)
		last_sponsors.append({
			"id": String(s["id"]), "obj": String(s["obj"]),
			"gain": int(s.get("progress", 0)) - before,
			"contract": s.duplicate(),
		})
	_sync_sponsor_rel()





func _sync_sponsor_rel() -> void:
	if sponsors.is_empty():
		rel["patrocinador"] = 0
		return
	var total: float = 0.0
	for s in sponsors:
		total += Sponsors.progress_ratio(s)
	rel["patrocinador"] = int(total / float(sponsors.size()) * 100.0)









