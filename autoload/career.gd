func vender_playera(k: Dictionary, precio_pactado: int = -1) -> int:
	var clave: String = House.clave_playera({"club": String(k.get("rival", "")),
		"trade": {"who": k.get("who", ""), "legend_key": Keepsakes.legend_key_of(k)}})
	var idx: int = _idx_playera(k)
	if idx < 0:
		return 0
	var precio: int = precio_pactado if precio_pactado >= 0 else \
			Keepsakes.precio_playera(keepsakes[idx], GameState.season_num,
		is_derby(String(k.get("rival", ""))))
	keepsakes.remove_at(idx)
	for pid in jersey_picks.keys():
		var por: Dictionary = jersey_picks[pid]
		for i2 in por.keys():
			var pk: Dictionary = por[i2]
			if House.clave_playera(pk) == clave:
				por.erase(i2)
		if por.is_empty():
			jersey_picks.erase(pid)
	money += precio
	_save()
	return precio





func _idx_playera(k: Dictionary) -> int:
	for i in keepsakes.size():
		var o: Dictionary = keepsakes[i]
		if String(o.get("kind", "")) == Keepsakes.SHIRT \
				and int(o.get("season", 0)) == int(k.get("season", 0)) \
				and String(o.get("rival", "")) == String(k.get("rival", "")) \
				and String(o.get("who", "")) == String(k.get("who", "")) \
				and Keepsakes.legend_key_of(o) == Keepsakes.legend_key_of(k):
			return i
	return -1





