	if bool(fx.get("asamblea_voto", false)):
		asamblea["eleccion"] = Concurso.VOTO

	if bool(fx.get("fin_socios_vender", false)):
		fin_socios["voto"] = Concurso.VENDER
	if bool(fx.get("fin_socios_seguir", false)):
		fin_socios["voto"] = Concurso.SEGUIR

