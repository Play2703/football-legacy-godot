func _sin_fichajes_en_concurso(moves: Array) -> Array:
	var en: Dictionary = _concursos_vivos()
	if en.is_empty():
		return moves
	var claves: Array = []
	for m in moves:
		var d: Dictionary = m
		if Concurso.bloquea(d, en):
			claves.append("%s#%d" % [String(d.get("to", "")), int(d.get("to_idx", -1))])
	return _sin_cadenas(moves, claves)





func _sin_ofertas_en_concurso() -> void:
