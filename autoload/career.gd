		pl_viejo["props"] =(pl_viejo["props"] as Array).filter(func(p): return not p.get("fijo", false))

		var borde_expo: float = - House.lado_of(antes) * 0.5
		pl_viejo["aberturas"].append([Vector2(borde_expo, -1), Vector2(borde_expo, 1)])
	var l0: float = House.lado_of(antes)
	var l1: float = House.lado_of(nuevo)
	land_tier = nuevo
	house_layout[key] = House.crece_capa(house_layout.get(key, {}), pl_viejo,
		House.square_plan(nuevo))
	set_floor_paint(House.anillo_de_pasto(floor_paint_of(),
		Rect2(- l0 * 0.5, - l0 * 0.5, l0, l0), Rect2(- l1 * 0.5, - l1 * 0.5, l1, l1)))










