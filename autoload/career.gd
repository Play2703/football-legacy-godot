func _renueva_apunta(nombre: String, ok: bool, quien: String) -> void:
	var h: Array =(gerencia.get("renueva_hist", []) as Array).duplicate() \
			if gerencia.get("renueva_hist", []) is Array else []
	h.push_front({"name": nombre, "ok": ok, "quien": quien,
		"season": GameState.season_num})
	gerencia["renueva_hist"] = h.slice(0, 4)
	var mio: String = GameState.player_team_id
	gerencia["renueva"] = gerencia_renueva_lista().filter(func(v: Variant) -> bool:
		return String(v["name"]) != nombre).map(func(v): return {"club": mio,
			"idx": int(v["idx"]), "name": String(v["name"])})
	Telemetry.count("renueva_si" if ok else "renueva_no")






func _gerencia_avisos(moves: Array) -> Array:
	var mio: String = GameState.player_team_id
	var resto: Array = []
	for raw in moves:
		var m: Dictionary = raw
		var kind: String = String(m.get("kind", ""))
		if kind == AiMarket.KIND_AVISO:
			if String(m.get("club", "")) != mio:
				continue
			match String(m.get("que", "")):
				"intocable_no":
					gerencia["deuda"] = {"season": GameState.season_num, "club": mio,
						"n": gerencia_deuda() + Gerencia.INTOCABLE_DEUDA}
					gerencia["intocable_ult"] = {"name": String(m.get("name", "")),
						"sale": "rechazo", "fee": int(m.get("fee", 0)),
						"to": String(m.get("to", "")), "season": GameState.season_num}
					Telemetry.count("intocable_no")
				"renueva_no":
					_renueva_apunta(String(m.get("name", "")), false,
						String(m.get("quien", "")))
			continue
		if kind == "signing" and bool(m.get("intocable", false)) \
				and String(m.get("from", "")) == mio:
			gerencia["intocable_ult"] = {"name": String(m.get("name", "")),
				"sale": "vendido", "fee": int(m.get("fee", 0)),
				"to": String(m.get("to", "")), "season": GameState.season_num}
			gerencia.erase("intocable")
			Telemetry.count("intocable_vendido")
		elif kind == AiMarket.KIND_CONTRATO and bool(m.get("pedida", false)) \
				and String(m.get("club", "")) == mio:
			_renueva_apunta(String(m.get("name", "")), true, "")
		resto.append(m)
	return resto












