func use_house(id: String) -> bool:
	var u: Dictionary = House.use_by_id(id)
	if u.is_empty() or not can_use_house(id):
		return false


	if staff_libre(id).is_empty():
		week_actions = maxi(0, week_actions - 1)


	house_used = house_used_now().duplicate()
	house_used.append(House.use_sello(id))
	house_used_stamp = _house_week_stamp()
	energy = clampf(energy + float(u.get("energy", 0.0)), 0.0, energy_cap())


	form = clampi(form + int(u.get("form", 0)), -5, 5)
	var fx: String = String(u.get("next_match", ""))
	if not fx.is_empty() and not has_match_fx(fx):
		next_match_fx.append(fx)


	var bumps: Dictionary = house_use_rel(id)
	for k in bumps:
		_apply_delta(String(k), _div_decision_scale(float(bumps[k])),
			REL_BRAKE_EXP_DECISION)
	_save()
	changed.emit()
	return true




