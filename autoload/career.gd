func dominion01() -> float:
	if season_matches <= 0:
		return 0.0

	if slump >= 1:
		return 0.0


	var f_form: float = clampf(float(form) / 5.0, 0.0, 1.0)




	var f_obj: float = 0.0
	var typ: String = String(contract.get("obj_type", "goals"))
	var t: float = GameState.season_progress()
	if (typ == "goals" or typ == "assists") and t >= 0.12:
		var esperado: float = maxf(1.0, float(int(contract.get("obj_target", 0))) * t)
		var over: float = float(int(contract.get("obj_progress", 0))) / esperado
		f_obj = clampf((over - 1.0) / 0.6, 0.0, 1.0)
	elif typ == "rating":
		f_obj = clampf((season_avg() - 7.0) / 1.0, 0.0, 1.0)


	var f_avg: float = clampf((season_avg() - 6.8) / 1.4, 0.0, 1.0)

	return clampf(0.45 * f_form + 0.35 * f_obj + 0.2 * f_avg, 0.0, 1.0)











