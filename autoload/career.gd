const CASA_REVENTA: float = 0.5















func house_sell_value(iid: String) -> int:
	var it: Dictionary = _house_item(iid)
	if it.is_empty():
		return 0
	var extra: String = String(it.get("extra", ""))
	if extra.is_empty():
		return 0
	var e: Dictionary = House.extra_by_id(extra)
	if e.is_empty():
		return 0
	if House.item_puesto(iid):
		return 0


	if not staff_ata(extra).is_empty():
		return 0


	if not bool(it.get("copia", false)):
		for hermana in House.extra_items(extra):
			if House.item_puesto(String(hermana)):
				return 0
	return int(round(float(int(e.get("price", 0))) * CASA_REVENTA))





func house_sell_pieces(iid: String) -> int:
	var it: Dictionary = _house_item(iid)
	if it.is_empty() or bool(it.get("copia", false)):
		return 1
	return maxi(1, House.extra_items(String(it.get("extra", ""))).size())


func _house_item(iid: String) -> Dictionary:
	for it in house_items:
		if String((it as Dictionary).get("iid", "")) == iid:
			return it
	return {}








func sell_house_item(iid: String) -> int:
	var pago: int = house_sell_value(iid)
	if pago <= 0:
		return 0
	var it: Dictionary = _house_item(iid)
	var extra: String = String(it.get("extra", ""))
	var fuera: Array = [iid]
	if not bool(it.get("copia", false)):



		fuera = House.extra_items(extra)
		if not fuera.has(iid):
			fuera.append(iid)
		house_extras.erase(extra)
	var quedan: Array = []
	for otro in house_items:
		if not fuera.has(String((otro as Dictionary).get("iid", ""))):
			quedan.append(otro)
	house_items = quedan


	for k in house_layout:
		var capa: Dictionary = house_layout[k]
		for id_fuera in fuera:
			capa.erase(String(id_fuera))
	money += pago
	_save()
	return pago

















func _swap_fuera(extra_id: String) -> void:
	house_extras.erase(extra_id)
	var fuera: Array = []
	for it in house_items:
		if String((it as Dictionary).get("extra", "")) == extra_id:
			fuera.append(String((it as Dictionary).get("iid", "")))
	if fuera.is_empty():
		return
	var quedan: Array = []
	for otro in house_items:
		if not fuera.has(String((otro as Dictionary).get("iid", ""))):
			quedan.append(otro)
	house_items = quedan
	for k in house_layout:
		var capa: Dictionary = house_layout[k]
		for id_fuera in fuera:
			capa.erase(String(id_fuera))



func house_extra_space_ok(id: String) -> bool:
	return id != "cochera" or preload("res://features/career/cochera.gd").instalacion_libre(
		House.plan_of(house_level), land_tier)


func buy_house_extra(id: String) -> bool:
	var e: Dictionary = House.extra_by_id(id)

	if not e.is_empty() and house_extras.has(id) and bool(e.get("multi", false)):
		return buy_house_copy(id)
	if e.is_empty() or house_extras.has(id):
		return false
	if not house_extra_space_ok(id):
		return false



	var req_ex: String = String(e.get("req_extra", ""))
	if not req_ex.is_empty() and not house_extras.has(req_ex):
		return false


	if int(e["level"]) > House.catalog_gate():
		return false



	if House.es_fachada(id) and House.fachada_nivel(id) != House.clamp_level(house_level):
		return false



	var clash: Dictionary = House.excl_conflict(id, house_extras)

	if not clash.is_empty() and not staff_ata(String(clash["id"])).is_empty():
		return false
	if not clash.is_empty() \
			and not (bool(e.get("swap", false)) and bool(clash.get("swap", false))):
		return false
	var price: int = int(e["price"])
	if not can_afford(price):
		return false





	if not clash.is_empty():
		_swap_fuera(String(clash["id"]))
	money -= price
	house_extras.append(id)







	if not bool(e.get("pet", false)) and not ["estilo", "fachada"].has(
			String(e.get("excl", ""))):
		var piezas: Array = House.extra_kinds(id)







		var med: Variant = e.get("size", null)
		var propio: Vector2 =(med as Vector2) if med is Vector2 \
				and piezas.size() == 1 else Vector2.ZERO
		for kind_nuevo in piezas:
			_add_house_item(String(kind_nuevo), id, propio)


















	var estreno: bool = not house_extras_estrenados.has(id)
	if estreno:
		house_extras_estrenados.append(id)
	var bumps: Dictionary = e.get("rel", {}) if estreno else {}
	for key in bumps:
		var canal: String = str(key)
		var delta: int = int(bumps[key])






		if delta != 0 and rel.has(canal) and not rel_derivada(canal):
			rel[canal] = clampi(int(rel[canal]) + delta, 0, 100)



	var festejo: String = String(e.get("festejo", ""))
	if not festejo.is_empty():
		Settings.desbloquea_celeb(festejo)
	_save()
	changed.emit()
	return true











func quitar_house_extra(id: String) -> bool:
	if not house_extras.has(id):
