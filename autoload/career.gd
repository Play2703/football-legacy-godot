func season_avg_year() -> float:
	var suma: float = season_rating_sum
	var n: int = season_matches
	for r in season_history:
		if not bool(r.get("partial", false)) \
				or int(r.get("season", 0)) != anio_vivo():
			continue
		var apps: int = int(r.get("apps", 0))
		if apps <= 0:
			continue
		suma += float(r.get("avg", 0.0)) * float(apps)
		n += apps
	return suma / float(n) if n > 0 else 6.0



























const CONOCE_DESDE: int = 75
const CONOCE_HASTA: int = 99


func te_conocen01() -> float:
