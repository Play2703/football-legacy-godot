func ex_clubes_de_tu_carrera() -> Dictionary:
	var out: Dictionary = {}
	for row in season_history:
		var id: String = String((row as Dictionary).get("club", ""))
		if id.is_empty() or out.has(id):
			continue
		out[id] = float(ex_clubs.get(id, 50.0))
	if not GameState.player_team_id.is_empty():
