func bill_damages(cams: int, balls: int, boys: int = 0,
		glass: int = 0, glass_full: int = 0, street: int = 0) -> void:
	pending_cams = maxi(0, cams)
	pending_balls = maxi(0, balls)
	pending_boys = maxi(0, boys)
	pending_glass = maxi(0, glass)
	pending_glass_full = maxi(0, glass_full)


	pending_street = maxi(0, street)






func damage_bill() -> Dictionary:
	var wage: float = float(contract.get("wage", 0))
	var cam: int = maxi(DAMAGE_CAM_MIN, int(wage * DAMAGE_CAM_UNIT))
	var ball: int = maxi(DAMAGE_BALL_MIN, int(wage * DAMAGE_BALL_UNIT))
	var boy: int = maxi(DAMAGE_BOY_MIN, int(wage * DAMAGE_BOY_UNIT))
	var vidrio: int = maxi(DAMAGE_GLASS_MIN, int(wage * DAMAGE_GLASS_UNIT))
	var vidrion: int = maxi(DAMAGE_GLASS_FULL_MIN, int(wage * DAMAGE_GLASS_FULL_UNIT))
	var camaras: int = - cam * pending_cams
	var balones: int = - ball * pending_balls



	var calle: int = - ball * pending_street
	var ninos: int = - boy * pending_boys


	var cristal: int = - vidrio * pending_glass - vidrion * pending_glass_full
	return {"camaras": camaras, "balones": balones, "ninos": ninos,
		"cristal": cristal, "calle": calle,
		"total": camaras + balones + ninos + cristal + calle}






