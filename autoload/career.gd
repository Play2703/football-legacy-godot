		bajas_asientos(team_id))












func carga_liga(team_id: String, w: float = -1.0) -> Array:
	if team_id.is_empty() or team_id == GameState.player_team_id:
		return [1, 1, 0]
	var semana: int = int(floorf(w)) if w >= 1.0 else semana_liga_hoy()
	if semana < 1:
		return [1, 1, 0]
	return [CalendarioMundo.carga(team_id, float(semana)),
		CalendarioMundo.carga(team_id, float(semana - 1)),
		GameState.season_num * 1000 + semana]





func semana_liga_hoy() -> int:
	var w: float = GameState.fixture_week(GameState.current_fixture())
	return int(floorf(w)) if w >= 1.0 else -1







func _bajas_al_mudarte(club_nuevo: String) -> void:
	var d: Dictionary = bajas_liga.get(club_nuevo, {})
	if not d.is_empty():
		var squad: Array = Squad.of_nominal(club_nuevo)
		var meta: Array = _ensure_squad_meta(club_nuevo, squad)
		for a in d:
			var e: Dictionary = d[a]
			var ai: int = int(a)
			if String(e.get("k", "")) != "les" or ai < 0 \
					or ai >= mini(meta.size(), squad.size()):
				continue
			if String((squad[ai] as Dictionary).get("name", "")) != String(e.get("n", "")):
				continue

			if int(e.get("w", 0)) >= int((meta[ai] as Dictionary).get("injury_weeks", 0)):
				(meta[ai] as Dictionary)["injury_weeks"] = int(e.get("w", 0))
				(meta[ai] as Dictionary)["injury_dias"] = int(e.get("d", 0))
	_bajas_reset()









