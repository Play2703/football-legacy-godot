func toggle_vitrina_pick(prop_id: String, name: String, actuales: Array = []) -> bool:
	if prop_id.is_empty() or name.is_empty():
		return false
	var mia: Array =(vitrina_picks.get(prop_id, actuales) as Array).duplicate()
	var queda: bool = not mia.has(name)
	for pid in vitrina_picks.keys():
		var lista: Array = vitrina_picks[pid]
		lista.erase(name)
		if lista.is_empty():
			vitrina_picks.erase(pid)
	mia.erase(name)
	if queda:
		mia.push_front(name)
	if mia.is_empty():
		vitrina_picks.erase(prop_id)
	else:
		vitrina_picks[prop_id] = mia
	_save()
	return queda



