func _pizarra_en_tu_liga(club: String) -> bool:
	var mio: String = GameState.player_team_id
	if club == mio:
		return true
	return not mio.is_empty() and Teams.country_of(club) == Teams.country_of(mio) \
			and GameState.div_of(club) == GameState.div_of(mio)






func _pizarra_objetivo(club: String) -> String:
	if club == GameState.player_team_id:
		return String(coach_idea_ficha().get("forma", ""))
	var s: Dictionary = Coaches.seat(club)
	if int(s.get("mandato", Coaches.TERM_BASE)) <= Coaches.TERM_BASE \
			and String(s.get("src", "")).is_empty() and not bool(s.get("libro", false)):
		return ""
	return String(Coach.idea_of(Coaches.idea_of(club)).get("forma", ""))






func _pizarra_clubes() -> Array:
	var mio: String = GameState.player_team_id
	var out: Array = []
	for c in _ai_scope():
		var id: String = String(c)
		if id != mio and WorldDB.has(id):
			out.append(id)
	if not mio.is_empty():
		out.append(mio)
	return out






func _pizarra_barre(forzar: bool = false) -> bool:
	if Coaches.de_fabrica():
		return false
	if not forzar and _pizarra_ver == Coaches.version() \
			and pizarra.has(GameState.player_team_id):
		return false
	_pizarra_ver = Coaches.version()
	_pizarra_frescos.clear()
	var cambio: bool = false
	var mio: String = GameState.player_team_id
	var vivos: Dictionary = {}
	for c in _pizarra_clubes():
		var club: String = String(c)
		vivos[club] = true
		var obj: String = _pizarra_objetivo(club)
		var e: Array = pizarra.get(club, []) as Array



		if obj.is_empty():
			if not e.is_empty():
				pizarra.erase(club)
				cambio = true
			continue
		var tec: String = Coaches.id_of(club)
		if e.is_empty() and (_pizarra_asienta or club == mio):
			pizarra[club] = PizarraTecnico.entrada(tec, obj, 1.0, "")
			cambio = true
			continue
		if not e.is_empty() and PizarraTecnico.tecnico_de(e) == tec:



			if club == mio and PizarraTecnico.objetivo_de(e) != obj:
				pizarra[club] = PizarraTecnico.entrada(tec, obj, 1.0, "")
				cambio = true
			continue
		var antes: String = "" if e.is_empty() else PizarraTecnico.forma_hoy(e)
		if antes.is_empty():
			antes = Squad.base_formation_of(club)
		var hecho: bool = obj.is_empty() or antes == obj \
				or Squad.familia_idea(obj).has(antes)
		pizarra[club] = PizarraTecnico.entrada(tec, obj, 1.0 if hecho else 0.0, antes)
		_pizarra_frescos[club] = true
		cambio = true
	for k in pizarra.keys():
		if not vivos.has(k):
			pizarra.erase(k)
			cambio = true
	_pizarra_asienta = false
	return cambio






func _pizarra_tick() -> void:


	var nuevos: bool = _pizarra_barre()
	var mio: String = GameState.player_team_id
	var hechas: Array = []
	for k in pizarra:
		var e: Array = pizarra[k] as Array



		if PizarraTecnico.hecha(e) or _pizarra_frescos.has(k):
			continue
		var club: String = String(k)
		var forma: Array = GameState.form_of_any(club)
		var ultimo: String = String(forma[-1]) if not forma.is_empty() else ""
		var puestos: Array = []
		for p in Squad.home_of(club):
			puestos.append(String((p as Dictionary).get("pos", "")))
		var cansado: float = 1.0
		if club == mio:
			cansado = PizarraTecnico.FATIGA_TUYO if is_congested() else 1.0
		elif _pizarra_en_europa(club):
			cansado = PizarraTecnico.FATIGA_EUROPA



		var hombre: float = rasgo_club("pizarra") if club == mio \
				else Coach.efecto_carrera(Coaches.rasgos_of(club), "pizarra")
		var paso: float = PizarraTecnico.ritmo(ultimo,
			PizarraTecnico.nivel_cubre(puestos, PizarraTecnico.objetivo_de(e)), cansado, hombre)
		pizarra[club] = PizarraTecnico.entrada(PizarraTecnico.tecnico_de(e), PizarraTecnico.objetivo_de(e),
			PizarraTecnico.prog_de(e) + paso, PizarraTecnico.antes_de(e))
		if PizarraTecnico.hecha(pizarra[club] as Array):
			hechas.append(club)

	_pizarra_frescos.clear()
	if nuevos or not hechas.is_empty():
		_sync_coach_plan()
	if hechas.is_empty():
		return
	var filas: Array = []
	for c in hechas:
		var club: String = String(c)
		if _pizarra_en_tu_liga(club):



			var fila: Dictionary = WorldNews.fila_pizarra(GameState.season_num,
				GameState.season_day, club, Coaches.name_of(club),
				Coaches.idea_of(club) if club != mio else coach_idea)
			if not fila.is_empty():
				filas.append(fila)
	if not filas.is_empty():
		_push_world_news(filas)




