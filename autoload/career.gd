const DEATH_MARGIN: float = 1.03









func _nat_group_of_death() -> bool:
	var groups: Array = GameState.nat_state.get("groups", [])
	if groups.size() < 3:
		return false
	var mine: float = -1.0
	var total: float = 0.0
	var top: float = 0.0
	for g in groups:
		var keys: Array =(g as Dictionary).get("keys", [])
		var suma: float = 0.0
		for k in keys:
			var id: String = String(k)
			suma += float(Nations.strength(nationality if id == GameState.YOU_KEY else id))
		total += suma
		top = maxf(top, suma)
		if keys.has(GameState.YOU_KEY):
			mine = suma
	if mine < 0.0:
		return false
	return is_equal_approx(mine, top) \
			and mine >(total / float(groups.size())) * DEATH_MARGIN








