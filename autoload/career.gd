func gerencia_rival_puesto(f: Dictionary) -> Dictionary:
	var p: Dictionary = gerencia_ficha_de(f)
	var suyos: Array = Squad.poss_of(p) if not p.is_empty() \
			else [String(f.get("pos", "MC"))]
	var rival: Dictionary = {}
	for a in _gerencia_once_asientos():
		var asiento: Dictionary = a
		if not suyos.has(String(asiento["pos"])):
			continue
		if rival.is_empty() or int(asiento["ovr"]) < int(rival["ovr"]):
			rival = asiento
	return rival



func gerencia_puesto_factor(f: Dictionary) -> float:
	var rival: Dictionary = gerencia_rival_puesto(f)
	if rival.is_empty():
		return 1.0



	return Gerencia.ex_puesto(Gerencia.puesto_factor(gerencia_media_de(f) - int(rival["ovr"])),
		gerencia_ex(f))







func gerencia_ojeo(f: Dictionary) -> Dictionary:



	var neutro: Dictionary = {"factor": 1.0, "probado": true, "cesiones": 0, "bajada": 1.0,
		"tray": 1.0, "tray_info": {}}
	if _reco_precio_base(f) < 0:
		return neutro


	var mk: String = _precio_clave(String(f.get("club", "")), int(f.get("seat", -1)),
		String(f.get("name", "")))
	var v: Dictionary = _precio_memo.get(mk, {})
	if not v.has("ojeo"):
		return neutro
	return {"factor": float(v["ojeo"]), "probado": bool(v.get("probado", true)),
		"cesiones": int(v.get("cesiones", 0)), "bajada": float(v.get("bajada", 1.0)),
		"tray": float(v.get("tray", 1.0)), "tray_info": v.get("tray_info", {})}












func gerencia_once_media() -> int:
	var clave: String = "%s|%s" % [GameState.player_team_id, _ger_memo_base()]
	if clave == _once_memo_clave:
		return _once_memo
	var squad: Array = Squad.of(GameState.player_team_id)
	if squad.is_empty():
		_once_memo = 0
		_once_memo_clave = clave
		return 0
	var suma: int = 0
	var n: int = 0
	for i in mini(squad.size(), Squad.STARTING_XI):
		var p: Dictionary = squad[i]
		suma += SquadMeta.ovr_of(p, String(p.get("pos", "MC")))
		n += 1
	_once_memo = 0 if n == 0 else int(round(float(suma) / float(n)))
	_once_memo_clave = clave
	return _once_memo










func libre_seat(nombre: String, pos: String) -> int:
	return absi(hash("libre|%s|%s" % [nombre, pos])) % 1000000000




func _libre_de(seat: int) -> Dictionary:
	if seat < 0:
		return {}
	for fa in free_agents:
		if fa is Dictionary and libre_seat(String((fa as Dictionary).get("name", "")),
				String((fa as Dictionary).get("pos", ""))) == seat:
			return fa
	return {}





func gerencia_ficha_de(f: Dictionary) -> Dictionary:


	if Teams.is_free(String(f.get("club", ""))):
		var fa: Dictionary = _libre_de(int(f.get("seat", -1)))
		if fa.is_empty():
			return {}
		var ident: Dictionary = AiMarket._free_identity(fa, GameState.season_num)
		ident["pos"] = String(fa.get("pos", "MC"))
		return ident
	var squad: Array = Squad.of(String(f.get("club", "")))
	var i: int = int(f.get("seat", -1))
	if i < 0 or i >= squad.size():
		return {}
	var p: Dictionary = squad[i]
	if String(p.get("name", "")) != String(f.get("name", "")):
		return {}
	return p






func gerencia_media_de(f: Dictionary) -> int:
