func _month_window_line(ficha: Dictionary) -> Dictionary:
	var rondas: int = maxi(_month_rounds, 0)
	if rondas <= 0:
		return {"goals": int(ficha.get("goals", 0)),
			"assists": int(ficha.get("assists", 0)),
			"matches": int(ficha.get("apps", 0)), "anual": true}
	var nom: String = String(ficha.get("name", ""))
	if String(ficha.get("team", "")) == GameState.player_team_id \
			and (_month_mate_g.has(nom) or _month_mate_a.has(nom)):
		return {"goals": int(_month_mate_g.get(nom, 0)),
			"assists": int(_month_mate_a.get(nom, 0)), "matches": rondas}
	var total: int = maxi(GameState.league_schedule.size(), 1)
	var pj: int = int(Dictionary(GameState.league_table.get(
		GameState.YOU_KEY, {})).get("pj", 0))
	var f1: float = clampf(float(pj) / float(total), 0.0, 1.0)
	var f0: float = clampf(float(pj - rondas) / float(total), 0.0, 1.0)
	var apps: int = _window_delta(int(ficha.get("apps", 0)), f0, f1)
	return {
		"goals": _window_delta(int(ficha.get("goals", 0)), f0, f1),
		"assists": _window_delta(int(ficha.get("assists", 0)), f0, f1),


		"matches": apps if apps > 0 else rondas,
	}





func _window_delta(total_val: int, f0: float, f1: float) -> int:
	return maxi(int(floor(float(total_val) * f1))
		- int(floor(float(total_val) * f0)), 0)









func league_race(closing: bool = false, result: Dictionary = {}) -> Array:
	var liga: Dictionary = liga_de_la_carrera(closing, result)
	var div: int = int(liga["div"])
	var season: int = GameState.season_num -(1 if closing else 0)
	var country: String = String(liga["pais"])






	var censo: Array = GameState.teams_in_div_jugada(country, div) if closing else []


	return Race.league(country, div, season, GameState.player_team_id, censo)






func liga_de_la_carrera(closing: bool = false, result: Dictionary = {}) -> Dictionary:
	var div: int = GameState.player_div()
	if closing:








		div = clampi(div
			+(1 if bool(result.get("promoted", false)) else 0)
			-(1 if bool(result.get("relegated", false)) else 0), 1, 3)
	return {"pais": Teams.country_of(GameState.player_team_id), "div": div}





















func league_race_blend(season: int, played: int, total: int, div: int = -1) -> Array:
	var country: String = Teams.country_of(GameState.player_team_id)
	var jugada: int = GameState.player_div() if div < 0 else div
	if jugada != 1:
		return Race.prorate(Race.league(country, 1, season), played, total)
	var race: Array = Race.prorate(
		Race.league(country, 1, season, GameState.player_team_id), played, total)
	blend_mate_stats(race, "league")
	race.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a["goals"]) > int(b["goals"]))
	return race







