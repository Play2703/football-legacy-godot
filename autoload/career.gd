		return I18n.t("DESCANSO", "seleccion") if String(cu.get("status", "")) == "titular" \
				else I18n.t("ROTACIÓN")
	if cu.has("rol_sin_forma") and String(cu["rol_sin_forma"]) != String(cu["status"]) \
			and String(cu["status"]) != "fuera":
		return I18n.t("FORMA")
	return ""











