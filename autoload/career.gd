func injury_age_risk_mult() -> float:
	if age <= DECLINE_AGE:
		return 1.0
	return minf(INJURY_AGE_RISK_MAX,
		1.0 + INJURY_AGE_RISK_PER_YEAR * float(age - DECLINE_AGE))




func injury_age_weeks_mult() -> float:
	if age <= DECLINE_AGE:
		return 1.0
	return minf(INJURY_AGE_WEEKS_MAX,
		1.0 + INJURY_AGE_WEEKS_PER_YEAR * float(age - DECLINE_AGE))


func injury_fatigue() -> float:
	return smoothstep(INJURY_RAMP_TOP, INJURY_RAMP_FLOOR, energy)








func injury_risk(played_ratio: float, inj_mult: float) -> float:
	if played_ratio <= 0.0:
		return 0.0
	var raw: float = INJURY_BASE + INJURY_TIRED_ADD * injury_fatigue() \
			- float(skills["fisico"]) / 99.0 * INJURY_FIT_CUT





	return maxf(0.0, raw) * played_ratio * inj_mult * injury_age_risk_mult() \
			* investment_value("injury_mult", 1.0) * staff_mult("injury_mult") \
			* Rebirth.mult_of(active_mods, "injury_mult") * rasgo_partido("lesion")













func roll_injury_weeks(trauma: bool = false) -> int:



	var bands: Array = INJURY_TRAUMA_BANDS if trauma else INJURY_BANDS
	var total: int = 0
	for b in bands:
		total += int(b["w"])
	var pick: int = randi_range(1, total)
	var weeks: int = 1
	for b in bands:
		pick -= int(b["w"])
		if pick <= 0:
			weeks = randi_range(int(b["min"]), int(b["max"]))
			break
	return maxi(1, ceili(float(weeks) * injury_age_weeks_mult() / _injury_divisor()))




func _injury_divisor() -> float:
	return maxf(1.0, investment_value("injury_div", 1.0))








func injury_weeks_ceiling(trauma: bool = false) -> int:
	var top: int = int((INJURY_TRAUMA_BANDS if trauma else INJURY_BANDS).back()["max"])
	return maxi(1, ceili(float(top) * injury_age_weeks_mult() / _injury_divisor()))








































func _settle_injury_after_match(live: bool, played_ratio: float, inj_mult: float,
		nat: bool) -> void:
	var was_injured: bool = injury_weeks > 0
	var infiltrado: bool = _spend_match_fx("play_hurt")
	last_injury_new = 0
	last_injury_min = 0
	if pending_injury_weeks > 0:
		injury_weeks = pending_injury_weeks
		last_injury_new = injury_weeks
		last_injury_min = pending_injury_min
		injury_matches_lost = 0



		_notify_injury(nat, true)
		pending_injury_weeks = 0
		pending_injury_min = 0
		pending_injury_trauma = false

		injury_dias = 0
		_curar_dias(GameState.dias_descanso())
	elif not live and randf() < injury_risk(played_ratio, inj_mult):


		injury_weeks = roll_injury_weeks(randf() < INJURY_CONTACT_SIM_P)
		last_injury_new = injury_weeks
		injury_matches_lost = 0
		_notify_injury(nat)
		injury_dias = 0
		_curar_dias(GameState.dias_descanso())
	elif was_injured and infiltrado:
		injury_weeks += INFILTRACION_RELAPSE
		_injury_was_grave = true


		injury_peak_weeks = maxi(injury_peak_weeks, injury_weeks)
	elif was_injured:

		_curar_dias(GameState.dias_descanso())
		injury_matches_lost += 1
		if not nat:
			season_injury_lost += 1


func _tick_injury_week() -> void:
	if injury_weeks <= 0:
		return
	injury_weeks -= 1
	if injury_weeks == 0:
		_arm_eased_return()
	if injury_weeks == 0 and _injury_was_grave:

		back_from_injury = true
		_injury_was_grave = false







		_rehab_debido = injury_matches_lost


		_tifo_deber("lesion")

















func _curar_dias(d_calendario: float) -> void:
	if injury_weeks <= 0:
		injury_dias = 0
		return
	var r: Dictionary = reloj_baja(injury_weeks, injury_dias, dias_de_reloj(d_calendario))
	injury_dias = int(r["dias"])
	for _i in int(r["semanas"]):
		_tick_injury_week()
	if injury_weeks <= 0:
		injury_dias = 0





















func _verano_baja() -> void:
	if injury_weeks <= 0:
		return
	injury_weeks /= 2
	injury_dias = BAJA_DIAS_SEMANA if injury_weeks > 0 else 0
	if injury_weeks == 0:
		_arm_eased_return()
	if injury_weeks == 0 and _injury_was_grave:
		back_from_injury = true
		_injury_was_grave = false











func _verano_plantel() -> void:
	for tid in squad_meta:
		for pm_v in (squad_meta[tid] as Array):
			if not (pm_v is Dictionary):
				continue
			var pm: Dictionary = pm_v
			var w: int = int(pm.get("injury_weeks", 0))
			if w <= 0:
				continue
			w /= 2
			pm["injury_weeks"] = w
			if w > 0:
				pm["injury_dias"] = BAJA_DIAS_SEMANA
			else:
				pm.erase("injury_dias")



const BAJA_DIAS_SEMANA: int = 7





static func dias_de_reloj(d_calendario: float) -> int:
	if d_calendario < 0.0:
		return BAJA_DIAS_SEMANA
	return int(round(d_calendario))








static func reloj_baja(semanas: int, dias: int, d: int) -> Dictionary:
	var acum: int = maxi(0, dias) + maxi(0, d)
	var k: int = 0
	while k < semanas and acum > BAJA_DIAS_SEMANA:
		acum -= BAJA_DIAS_SEMANA
		k += 1
	return {"semanas": k, "dias": acum if k < semanas else 0}













static func dias_baja_de(semanas: int, dias: int) -> int:
	if semanas <= 0:
		return 0
	return maxi(1, semanas * BAJA_DIAS_SEMANA - maxi(0, dias) + 1)



func dias_baja() -> int:
	return dias_baja_de(injury_weeks, injury_dias)




static func dias_baja_ficha(pm: Dictionary) -> int:
	return dias_baja_de(int(pm.get("injury_weeks", 0)), int(pm.get("injury_dias", 0)))












func _arm_eased_return(shortcut: bool = false) -> void:
