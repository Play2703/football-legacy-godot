func _judge_nat_coach(cumplido: bool, lines: Array[String]) -> void:
	if nationality.is_empty():
		return
	if cumplido:
		nat_coach_fails = 0

		nat_coach_cred += Coach.CRED_TITULO * 2
		_niv_invalida()
		return
	nat_coach_fails += 1

	if not Coach.nat_fired(cumplido, nat_coach_fails, -1.0, nat_coach_nivel()):





		nat_coach_cred -= Coach.CRED_TITULO
		_niv_invalida()
		return
	var salido: String = nat_coach_name()




	var temporada: int = GameState.season_num - 1
	var sitio: String = Coach.origen_nat(nationality)
	var s: Dictionary = Coaches.seat(sitio)
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("coachnat|tuya|%d" % temporada)
	var llega: Dictionary = _elige_seleccionador(nationality, temporada, rng, {})
	_al_paro(String(s.get("club", sitio)), int(s.get("term", nat_coach_term)), temporada,
		sitio, nat_coach_cred)
	nat_coach_term += 1
	nat_coach_src = String(llega.get("src", ""))
	nat_coach_desde = GameState.season_num
	nat_coach_fails = 0

	nat_coach_cred = int(llega.get("cred", 0))
	_niv_invalida()
	Coaches.bump()






	nat_coach_char = Coach.roll_character(-1.0, nat_coach_tier())




	var p_src: Array = Coach.parte_src(nat_coach_src)
	nat_coach_idea = Coaches.idea_de(String(p_src[0]), int(p_src[1])) \
			if not p_src.is_empty() else Coaches.idea_de(Coach.origen_nat(nationality),
			nat_coach_term)
	nat_rel["tecnico"] = int(nat_coach_character()["rel"])
	nat_rel_frac["tecnico"] = 0.0


	nat_captain = false
	lines.append(I18n.tf("{0} destituye a {1}. Llega {2}.",
		[Nations.display_name(Nations.id_for_country(nationality)),
			CareerTheme.caps(salido),
			CareerTheme.caps(nat_coach_name())]))


func _apply_nat_match(rating: float, goals: int, result: int) -> void:
	var d_tec: float = NAT_REL_STEP * clampf((rating - 6.2) / 1.8, -1.0, 1.5)
	var vest: float = 0.5 if result > 0 else (-0.5 if result < 0 else 0.0)
	vest += clampf((rating - 6.5) / 2.0, -0.5, 0.5)
	var d_ves: float = NAT_REL_STEP * vest
	var d_afi: float = NAT_REL_STEP * clampf(
		float(goals) * 0.6 +(0.2 if result > 0 else -0.2), -1.0, 1.5)






	if pending_injury_weeks > 0:
		d_tec = maxf(d_tec, 0.0)
		d_ves = maxf(d_ves, 0.0)
		d_afi = maxf(d_afi, 0.0)



	d_tec *= Coach.afinidad_mult(nat_coach_idea, age, d_tec > 0.0, nat_coach_nivel())
	_apply_nat_delta("tecnico", d_tec)
	_apply_nat_delta("equipo", d_ves)
	_apply_nat_delta("aficion", d_afi)








func _dramatize(delta: float) -> float:
	return delta * REL_DRAMA_GAIN *(REL_LOSS_BIAS if delta < 0.0 else 1.0)









func _delta_step(key: String, delta: float,
		brake_exp: float = REL_BRAKE_EXP) -> Dictionary:
	var current: float = float(rel[key])






	if key == "pareja" and not pareja.is_empty():
		delta = PAREJA.escala(String(pareja.get("id", "")), delta)




		if delta < 0.0:
			delta *= PAREJA.poso_mult(pareja_poso())
	delta = _dramatize(delta)
	var room: float =(100.0 - current) if delta > 0.0 else current
	var t: float = clampf(room / 50.0, 0.0, 1.0)
	var brake: float = pow(t, brake_exp) if delta > 0.0 else maxf(t, REL_BRAKE_FLOOR)



	var raw: float = delta * brake + float(rel_frac.get(key, 0.0))
	var step: int = int(raw)
	var wanted: int = int(current) + step
	var next: int = clampi(wanted, 0, 100)


	return {"value": next, "step": next - int(current),
		"frac":(raw - float(step)) if next == wanted else 0.0}

















func projected_delta(key: String, delta: float) -> int:
	if not rel.has(key):
		return 0






	if rel_derivada(key):
		return 0



	return int(_delta_step(key, _div_decision_scale(delta),
		REL_BRAKE_EXP_DECISION)["step"])













