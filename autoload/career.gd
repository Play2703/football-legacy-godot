	if not ultimatum_activo() or minutes <= 0:
		return ""
	var faltan: int = maxi(int(ultimatum.get("goals", 0)) - maxi(goals, 0), 0)
	if faltan <= 0:
		if not GameState.readonly_save:
			ultimatum = {}
			_apply_delta("tecnico", ULTIMATUM_WIN)
		return "win"
	var left: int = int(ultimatum.get("left", 0)) - 1
	if left <= 0:
		if not GameState.readonly_save:
			ultimatum = {}
			_apply_delta("tecnico", ULTIMATUM_FAIL)
		return "fail"
	if not GameState.readonly_save:
		ultimatum = {"left": left, "goals": faltan}
	return ""




