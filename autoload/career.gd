func grant_award(award: String, repetir: bool = false, torneo: int = -1) -> bool:
	if not repetir and not AwardPoints.REPEATABLE.has(award) \
			and current_season_awards().has(award):
		return false
	awards.append(award)




	if Ceremonies.es_titulo_de_club(award):
		_fecha_titulo(award, torneo)






	if _team_title(award):





		var jugaste: bool = false
		if NAT_AWARDS.has(award):
			jugaste = nat_played_tournament(
				"wc" if award == "Campeón del Mundo"
				else "finalissima" if award == Finalissima.TITULO
				else "naciones" if award == LigaNaciones.TITULO
				else "olimpicos" if award == JuegosOlimpicos.TITULO else "cont")
		else:
			jugaste = season_matches + _season_stashed("apps") > 0
		var marcas: Array = titles_grada.get(award, [])
		marcas.append(not jugaste)
		titles_grada[award] = marcas
	var pts: int = _pay_award_points(award)
	if pts > 0:
		pass

	_paga_prima_premio(award)
	_telemetria_premio(award)


	Herencia.vitrina_vuelca()
	return true























func instante_titulo() -> float:
	if GameState._closing_season:
		return float(GameState.season_num - 1) + 0.999
	var cal: Array = GameState.calendar
	var s: float = float(GameState.season_num)
	if cal.is_empty():
		return s

	var f: Dictionary = cal[clampi(GameState.season_day, 0, cal.size() - 1)]
	var w: float = GameState.fixture_week(f)
	var ll: int = GameState.league_schedule.size()
	if not CalendarioMundo.semana_conocida(w) or ll < 1:


		return s + clampf(float(GameState.season_day) / float(cal.size()), 0.0, 0.998)
	return s + clampf(w /(float(ll) * 1.2), 0.0, 0.998)






const HAZANA_TRAMO_FINAL: float = 0.75








func _hazana_al_cierre() -> bool:
	if GameState._closing_season:
		return true
	var cal: Array = GameState.calendar
	var ll: int = GameState.league_schedule.size()
	if cal.is_empty() or ll < 1:
		return false
	var dia: int = clampi(GameState.season_day, 0, cal.size() - 1)
	var w: float = GameState.fixture_week(cal[dia])
	if not CalendarioMundo.semana_conocida(w):

		return float(dia) / float(cal.size()) >= HAZANA_TRAMO_FINAL
	return w >= float(ll) * HAZANA_TRAMO_FINAL




func _fecha_titulo(award: String, torneo: int) -> void:
	var ahora: float = instante_titulo()
	titulos_fechados.append({"t": award, "k": torneo, "a": ahora,
		"c": GameState.player_team_id})


	var vivos: Array = []
	for e in titulos_fechados:
		if e is Dictionary and float(e.get("a", -99.0)) > ahora - 2.0:
			vivos.append(e)
	titulos_fechados = vivos
	_mira_hazana(ahora)














func _mira_hazana(ahora: float) -> String:
	var ventana: Array[String] = Ceremonies.titulos_en_ventana(titulos_fechados, ahora,
		GameState.player_team_id)
	var n: int = ventana.size()
	if n < Ceremonies.SEXTETE_MIN:
		return ""


	if n <= hazana_n and ahora - hazana_a < 0.999:
		return ""
	hazana_n = n
	hazana_a = ahora
	var grito: String = Ceremonies.hazana_de(n)
	Achievements.ingest_sextete()
	if _hazana_al_cierre():
		hazana_pendiente = {"awards": ventana, "hazana": grito}
		return grito
	var div: int = GameState.player_div()
	queue_ceremony(Ceremonies.celebracion_de(div), {
		"club": GameState.player_team_id,
		"awards": ventana,
		"div": div,
		"div_name": Teams.div_name(div),
		"hazana": grito,
	})
	return grito









func _telemetria_premio(award: String) -> void:
	if award == "Jugador del Partido":
		Telemetry.count("jugador_partido")
		return
	if award == "Jugador del Mes":
		Telemetry.count("jugador_mes")
		return

	if AwardPoints.REPEATABLE.has(award):
		return
	if not _team_title(award):
		Telemetry.count("premio_individual")
		if award == "Balón de Oro":
			Telemetry.count("balon_oro")
			Telemetry.mark("balones_oro_max", awards.count("Balón de Oro"))
		return
	Telemetry.count("titulo_equipo")
	match String(CLUB_TITLE_KINDS.get(award, "")):
		"liga":
			Telemetry.count("titulo_liga")
		"copa":
			Telemetry.count("titulo_copa")
		"cont":
			Telemetry.count("titulo_continental")
	if award == "Ascenso":
		Telemetry.count("titulo_ascenso")
	elif award == "Campeón del Mundo":
		Telemetry.count("titulo_mundial")
	elif award == "Campeón continental":
		Telemetry.count("titulo_nat_cont")
	var n: int = 0
	for a in awards:
		if _team_title(String(a)):
			n += 1
	Telemetry.mark("titulos_carrera_max", n)






