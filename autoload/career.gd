	})








func _elige_chico_y_mundo(season: int, ctx: Dictionary, row: Dictionary,
		gala: Dictionary, lines: Array[String]) -> void:





	var ctx_chico: Dictionary = ctx.duplicate()
	var you: Dictionary =(ctx.get("you", {}) as Dictionary).duplicate()
	you["age"] = int(row.get("age", age)) - 1
	ctx_chico["you"] = you


	var lote: Dictionary = {}
	var chico: Dictionary = BallonDor.chico_de_oro(season, ctx_chico,
		func(nombre: String, club: String) -> int: return _edad_de_ficha(nombre, club,
			season, lote))



	var ctx_mundo: Dictionary = ctx.duplicate(true)
	var champs: Dictionary = ctx_mundo.get("champs", {})
	var ligas: Dictionary = champs.get("league", {})
	var censos: Dictionary = ctx_mundo.get("censos", {})
	for c in Nations.PLAYABLE:
		var pais: String = String(c)
		if not censos.has(pais):
			censos[pais] = GameState.teams_in_div_jugada(pais, 1)
		if not ligas.has(pais):
			ligas[pais] = league_champion_of(pais, season, 1, censos[pais])
	champs["league"] = ligas
	ctx_mundo["champs"] = champs
	ctx_mundo["censos"] = censos
	var mundo: Dictionary = BallonDor.premio_mundo(season, ctx_mundo)



	var bota: Dictionary = BallonDor.bota_europa(season, ctx)
	if not chico.is_empty():
		gala["chico"] = chico
	if not mundo.is_empty():
		gala["mundo"] = mundo
	if not bota.is_empty():
		gala["bota"] = bota
	for par in [[chico, BallonDor.CHICO_TITULO, "¡CHICO DE ORO! LA PROMESA DEL AÑO"],
			[mundo, BallonDor.MUNDO_TITULO, "¡PREMIO DEL MUNDO! EL MEJOR DEL PLANETA"],
			[bota, BallonDor.BOTA_EUROPA_TITULO, "¡BOTA DE ORO DE EUROPA! EL MÁXIMO GOLEADOR DEL CONTINENTE"]]:
		if not bool(((par[0] as Dictionary).get("winner", {}) as Dictionary).get("you", false)):
			continue
		_win(String(par[1]), String(par[2]), lines)
		var row_awards: Array = row.get("awards", [])
		if not row_awards.has(String(par[1])):
			row_awards.append(String(par[1]))
			row["awards"] = row_awards


	var censo: Array = []
	for pais in censos:
		censo.append_array(censos[pais] as Array)
	_elige_gol_del_anio(season, censo, row, gala, lines)






func _elige_gol_del_anio(season: int, censo: Array, row: Dictionary, gala: Dictionary,
		lines: Array[String]) -> void:
	var mio: Dictionary = season_gol_bello.duplicate()
	if not mio.is_empty():
		mio["name"] = player_name
	var res: Dictionary = GolDelAnio.elige(season, mio, censo)
	if (res.get("winner", {}) as Dictionary).is_empty():
		return
	gala["gol"] = res
	if not bool(res.get("you_win", false)):
		return
	var g: Dictionary = res["mio"]
	_win(GolDelAnio.TITULO, "¡GOL DEL AÑO! %s AL %d'" % [String(GolDelAnio.TIPO_NOMBRE.get(
		String(g.get("tipo", "")), "JUGADA")), int(g.get("min", 0))], lines)
	var row_awards: Array = row.get("awards", [])
	if not row_awards.has(GolDelAnio.TITULO):
		row_awards.append(GolDelAnio.TITULO)
		row["awards"] = row_awards






func _edad_de_ficha(nombre: String, club: String, season: int, lote: Dictionary) -> int:
	var squad: Array = Squad.of(club)
	var idx: int = -1
	for i in squad.size():
		if String((squad[i] as Dictionary).get("name", "")) == nombre:
			idx = i
			break
	if idx < 0:
		return -1
	var meta: Variant = squad_meta.get(club, null)
	if not (meta is Array) or (meta as Array).size() != squad.size():
		meta = lote.get(club, null)
		if not (meta is Array):
			meta = AiMarket.derive_meta(club, squad, season)
			lote[club] = meta
	var m: Array = meta
	return int((m[idx] as Dictionary).get("age", -1)) if idx < m.size() else -1




