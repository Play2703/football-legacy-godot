func finish_encargo(logrado: int, need: int, tries: int,
		modo: String = Encargo.MODO_TIRO, kind: String = "") -> Dictionary:
	var raw: float = Encargo.premio(logrado, need, tries, modo)
	var antes: int = int(rel["tecnico"])




	var record_antes: int = encargo_record(kind)
	var record: bool = false
	if modo == Encargo.MODO_DIANA and not kind.is_empty() and logrado > record_antes:
		encargo_records[kind] = logrado
		record = true
	if raw > 0.0:
		if modo == Encargo.MODO_DIANA:














			rel["tecnico"] = clampi(antes + int(raw), 0, 100)
			rel_frac["tecnico"] = 0.0
		else:
			_apply_delta("tecnico", raw, REL_BRAKE_EXP)
		encargos_ok += 1
	encargo_pendiente = false
	_save()
	changed.emit()
	return {
		"cumplido": raw > 0.0,


		"estrellas": Encargo.estrellas(logrado, need) if modo == Encargo.MODO_DIANA else 0,
		"pleno": is_equal_approx(raw, Encargo.PREMIO_PLENO),
		"logrado": logrado, "need": need, "tries": tries,
		"antes": antes, "ahora": int(rel["tecnico"]),
		"delta": int(rel["tecnico"]) - antes,


		"record": record,
		"record_antes": record_antes,
		"kind": kind,
	}






func standing() -> Dictionary:
	var club_rating: int = Teams.rating(GameState.player_team_id)




	var m: float = Standing.merit(skills_avg(), form, int(rel["tecnico"]),
		int(rel["equipo"]), energy) * ajuste_puesto()



	var edge: float = m - Standing.demand(club_rating) - rival_pressure()



	var contract_role: int = Standing.contract_role_from_key(
		String(contract.get("role", "rotacion")))






















	var sesgo: float = 0.0
	if age <= Coach.JOVEN_HASTA:
		sesgo += rasgo_club("joven")
	if int(rel["tecnico"]) < Coach.FAVORITO_REL:
		sesgo += rasgo_club("favorito")
	var repite: int = _repite_once()
	var call: Dictionary = Standing.callup(contract_role, edge, energy,
		int(rel["tecnico"]), is_frozen(), next_match_weight(), loan_refused,
		slump_active(), next_rival_lowly(), stat_norm("fisico"), eased_return,
		coach_opportunity(), descartado(), sesgo, repite)
	var mins: int = int(call["minutes"])










	var descanso: String = _descanso_tecnico(call, edge) if mins > 0 and repite <= 0 else ""
	var rested: bool = not descanso.is_empty()
	if rested:
		mins = 0






	var pacto: String = pactado_hoy() if mins > 0 else ""
	var status: String = String(call["status"])
	if pacto == DescansoPactado.BANCA:
		status = Standing.STATUS_BANCA
		mins = mini(mins, Standing.SUB_MAX_MINUTES)
	elif pacto == DescansoPactado.DESCANSO:
		rested = true
		mins = 0
	else:
		pacto = ""
	return {

		"pactado": pacto,
		"merit": m, "edge": edge,




		"juicio": edge + sesgo,


		"role": Standing.role_of(edge),
		"contract_role": contract_role,
		"contract_role_name": Standing.contract_role_name(contract_role),
		"status": status,


		"role_name": String(Standing.STATUS_LABEL[status]),
		"minutes": mins,







		"chances": maxi(0, roundi(Standing.chances(mins, int(rel["equipo"]),
			int(rel["tecnico"]), form, level, is_captain, puesto_hoy()) \
					* sharp_factor())),
		"starter": bool(call["starter"]) and not rested and pacto.is_empty(),



		"rested": rested,


		"descanso": descanso,


		"guarda": String(GameState.next_fixture().get("opp", "")) \
				if descanso == DESCANSO_GUARDA else "",


		"slump": slump_active(),


		"frio": int(rel["tecnico"]) < Standing.FRIO_TECNICO and mins > 0,




		"tired": bool(call.get("tired", false)) and mins > 0,



		"eased": bool(call.get("eased", false)) and mins > 0,





		"oportunidad": bool(call.get("oportunidad", false)) and mins > 0,
	}














