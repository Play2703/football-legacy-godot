func fuerza_de_hoy(team_id: String, f: Dictionary, con_once: bool = true) -> float:
	var liga: bool = String(f.get("comp", "")) == "league"
	var d: float = 0.0
	if con_once and team_id == GameState.player_team_id and GameState.es_fixture_de_hoy(f):
		d = delta_once_mio()
	if liga:
		return fuerza_liga(team_id, GameState.fixture_week(f), d)
