func _podio_liga(race_full: Array, key: String, mio: int) -> int:
	if race_full.is_empty() or mio <= 0:
		return 0
	var puesto: int = 1
	for e in race_full:
		if int(e.get(key, 0)) > mio:
			puesto += 1
	return puesto if puesto <= NAT_PODIO else 0



const NAT_PODIO: int = 3













func nat_merito() -> Dictionary:
	var out: Dictionary = {"balon": false, "mundial": false, "continental": false,
		"bota_mundial": false, "mejor_mundial": false, "premio_continental": false,
		"asist_mundial": false, "champions": false, "mejor_div": 0, "pichichi_div": 0,
		"asist_div": 0, "podio_div": 0}
	var anterior: int = GameState.season_num - 1
	for fila in season_history:
		if int(fila.get("season", -1)) != anterior:
			continue
		for premio in fila.get("awards", []):
			_apunta_merito(out, String(premio), int(fila.get("div", 0)))


		if int(fila.get("div", 0)) == 1 and (
				_en_podio(int(fila.get("podio_goles", 0)))
				or _en_podio(int(fila.get("podio_asist", 0)))):
			out["podio_div"] = 1
	for premio in _merito_en_curso():
		_apunta_merito(out, premio, GameState.player_div())
	return out


func _en_podio(puesto: int) -> bool:
	return puesto >= 1 and puesto <= NAT_PODIO





func _apunta_merito(out: Dictionary, premio: String, div: int) -> void:
	var casilla: String = String(NAT_MERITO_PREMIOS.get(premio, ""))
	if casilla.ends_with("_div"):
		if div > 0 and (int(out[casilla]) <= 0 or div < int(out[casilla])):
			out[casilla] = div
	elif not casilla.is_empty():
		out[casilla] = true













func _merito_en_curso() -> Array[String]:
	var nada: Array[String] = []
	if season_matches <= 0 or GameState._closing_season:
		return nada
	var cal: Array = GameState.calendar
	if cal.is_empty():
		return nada
	for i in range(GameState.season_day, cal.size()):
		var fx: Dictionary = cal[i]
		if String(fx.get("comp", "")) != "nat" and not bool(fx.get("dead", false)):
			return nada
	var pos: int = GameState.league_position()



	var campeon: bool = bool(GameState.liguilla_del_ano()["champion"]) \
			if GameState.liguilla_activa() else pos == 1
	var vivo: Dictionary = {"league_pos": pos, "won_league": campeon,
		"played_ucl": bool(GameState.ucl_state.get("playing", false)),
		"ucl_advanced": bool(GameState.ucl_state.get("advanced", false))}
	var firma: String = str([GameState.season_num, GameState.season_day,
		GameState.player_team_id, season_matches, season_rating_sum, season_comps(), vivo])
	if firma != _merito_vivo_firma:
		_merito_vivo = _veredicto_liga_ucl(vivo, season_avg_year(), false)["ganados"]
		_merito_vivo_firma = firma
	return _merito_vivo.duplicate()








