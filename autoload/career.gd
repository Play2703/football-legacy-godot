func clausulas_mesa_club(pack: String = "equilibrio") -> Dictionary:
	var tipo: String = _clausulas_mesa_club_tipo()
	if tipo.is_empty():
		return {"ok": false, "why": "SIN MESA ABIERTA"}
	if clausulas_club_hecha():
		return {"ok": false, "why": "YA NEGOCIASTE ESTE AÑO"}
	var o: Dictionary = {}
	if tipo == "renov":
		for p in renewal_packages():
			if String((p as Dictionary).get("pack", "")) == pack:
				o = p
		if o.is_empty():
			o = renewal_offer()
	else:
		o = renegotiation_offer()
	var club: String = GameState.player_team_id
	var b: Dictionary = _clausulas_base_club(o)
	var left: int = int(contract["seasons_left"])
	var cap: int = ContractTerms.max_seasons_for_age(age)
	var tope: int = maxi(0, mini(ContractTerms.YEARS_MAX, cap + left) - left)
	var st: float = float(o.get("stature", 0.0))

	var ctx: Dictionary = _clausulas_ctx(club, puesto_hoy(), Squad.muros_once(club, true),
		st, st, true, mini(1, int(b["anos"])), maxi(int(b["anos"]), tope))
	return {"ok": true, "why": "", "base": b, "ctx": ctx, "mesa": tipo,
		"pack": pack if tipo == "renov" else "",
		"wage": int(o.get("wage", contract["wage"]))}





