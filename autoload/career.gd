func nat_rival_squad(country: String) -> Array:
	var id: String = Nations.canon_id(country)
	if id.is_empty():
		return []


	Squad.invalidate(id)
	var out: Array = []
	for p in Squad.of(id):
		out.append((p as Dictionary).duplicate())
	if out.is_empty():
		return []
	if out.size() > NatTeam.SQUAD_SIZE:
		out.resize(NatTeam.SQUAD_SIZE)






	var cubiertos: Dictionary = {}
	for r in NatTeam.assign_shirts(NatTeam._build_squad(id, {}, "")):
		var row: Dictionary = r
		var i: int = int(row.get("rank", 0)) - 1
		if i < 0 or i >= out.size():
			continue
		var who: String = String(row.get("name", ""))
		if who.is_empty():
			continue
		var base: Dictionary = out[i]
		var ficha: Dictionary = _nat_ficha(String(row.get("club_id", "")), who)
		ficha["name"] = who







		ficha["pos"] = String(row.get("slot", base.get("pos", "MC")))
		ficha["number"] = int(row.get("number", int(base.get("number", 0))))
		out[i] = ficha
		cubiertos[i] = true




	var forma: Array = NatTeam.squad_shape(id)
	for i in mini(forma.size(), out.size()):
		if not cubiertos.has(i):
			(out[i] as Dictionary)["pos"] = String(forma[i])



	_nat_rellena_reales(out, cubiertos, id)
	_nat_dorsales_unicos(out, cubiertos)
	return out







