	if crudos.is_empty():


		OvrCap.invalidate()
		_ovr_corte = -1.0
		_ovr_tope = -1.0
		return
	_ovr_corte = OvrCap.corte()
	_ovr_tope = OvrCap.tope()










func _push_seat_dev() -> void:
	var por_club: Dictionary = {}
	for tid in squad_meta:
		var meta: Array = squad_meta[tid]
		var squad: Array = Squad.of_nominal(String(tid))
		var devs: Array = []
		for i in meta.size():
			var pm: Dictionary = meta[i]
			var dueno: String = String(squad[i].get("name", "")) if i < squad.size() else ""
			var mismo: bool = String(pm.get("dev_of", dueno)) == dueno
			devs.append(float(pm.get("dev", 0.0)) if mismo else 0.0)
		por_club[String(tid)] = devs
	ClubForm.set_seat_dev(por_club)






func specialist_gap(key: String) -> int:
	var best: Dictionary = Squad.best_specialist(equipo_lanzador(), key)
	if best.is_empty():
		return int(skills.get(key, 0))
	var gap: int = int(skills.get(key, 0)) - int(best.get(key, 0))


	if key == "penal" and capitan_decide_penales():
		return maxi(gap, 0)
	return gap









const STAT_FLOOR: float = 50.0




func stat_norm(key: String) -> float:
	return stat_frac(float(skills.get(key, 0)))












func stat_frac(value: float) -> float:
	return clampf((value - STAT_FLOOR) /(99.0 - STAT_FLOOR), 0.0, 1.0)




















const MORAL_ACC_SPAN: float = 0.04
const MORAL_POW_SPAN: float = 0.03



func moral01() -> float:
	return clampf((float(morale) - 50.0) / 50.0, -1.0, 1.0)




func moral_factor() -> float:
	return 1.0 + moral01() * MORAL_POW_SPAN


func power_mult() -> float:









	return (0.72 + stat_norm("potencia") * 0.53 + _boot("pot")) * _energy_factor() \
			* moral_factor() * 1.2


















func header_mult() -> float:
	var f: float = stat_norm("fisico") * 0.72 + stat_norm("efecto") * 0.28









	return (0.72 + f * 0.53 + _boot("pot")) * _energy_factor() * moral_factor() * 1.2


func curve_mult() -> float:
	return maxf(0.7 + float(skills["efecto"]) / 99.0 * 0.7 + _boot("efe"), 0.3)










































const REGATE_GAMMA: float = 1.7
func _regate_curve(n: float) -> float:
	return pow(clampf(n, 0.0, 1.0), REGATE_GAMMA)


func speed_norm() -> float:
	return _regate_curve(stat_norm("velocidad"))























func control_norm() -> float:



	if not skills.has("regate"):
		return _regate_curve(clampf(
			stat_norm("efecto") * 0.72 + stat_norm("fisico") * 0.28, 0.0, 1.0))
	return _regate_curve(stat_norm("regate"))





func accel_norm() -> float:
	if not skills.has("aceleracion"):
		return control_norm()
	return _regate_curve(stat_norm("aceleracion"))













func accuracy() -> float:



	return clampf(0.3 + stat_norm("precision") * 0.7 + float(form) * 0.02
		+ moral01() * MORAL_ACC_SPAN + _boot("pre") + house_tactical_bonus(), 0.0, 1.0)





func _boot(key: String) -> float:
	var b: Dictionary = Shop.boots_by_id(boots)
	var base: float = float(b.get(key, 0.0))
	if base == 0.0:
		return 0.0
	var life: int = int(b.get("life", 0))
	if life <= 0:
		return base
	return base * Shop.boot_wear_factor(float(boots_wear.get(boots, 0)), life)




func boots_life_frac() -> float:
	var b: Dictionary = Shop.boots_by_id(boots)
	var life: int = int(b.get("life", 0))
	if life <= 0:
		return 1.0
	return Shop.boot_wear_factor(float(boots_wear.get(boots, 0)), life)






func _wear_boots() -> void:
	if boots == "cantera":
		return



	if _spend_match_fx("boot_care"):
		return
	var b: Dictionary = Shop.boots_by_id(boots)
	var life: int = int(b.get("life", 0))
	if life <= 0:
		return




	var paso: float = 0.5 if _spend_match_fx(HOUSE_BOOT_FX) else 1.0
	var used: float = float(boots_wear.get(boots, 0)) + paso
	if used >= float(life):
		owned.erase(boots)
		boots_wear.erase(boots)
		boots_broke = String(b.get("name", ""))



		var cool: int = int(b.get("cool", 0))
		if cool > 0:
			boots_cooldown[boots] = GameState.matches_played + cool
		boots = "cantera"
	else:



		boots_wear[boots] = int(used) if is_equal_approx(used, roundf(used)) else used




