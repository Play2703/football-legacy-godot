func _cierra_eleccion(lines: Array[String], result: Dictionary, div_jugada: int,
		r: float = -1.0) -> void:
	eleccion_venta = {}
	var e: Dictionary = eleccion_club
	eleccion_club = {}
	if pending_decision == ELECCION_EVENT_ID:
		pending_decision = ""
	var mio: String = GameState.player_team_id
	if e.is_empty() or bool(e.get("no", false)) or str(e.get("club", "")) != mio \
			or int(e.get("temporada", -1)) != GameState.season_num - 1 or _rescate_dueno:
		return
	var t: float = -1.0
	var pos: int = int(result.get("league_pos", 0))
	var n: int = GameState.teams_in_div_jugada(Teams.country_of(mio), div_jugada).size()
	if pos > 0 and n > 1:
		t = float(pos - 1) / float(n - 1)
	var titulo: bool = bool(result.get("won_league", false)) or bool(result.get("promoted", false)) \
			or bool(result.get("cup_champion", false)) or bool(result.get("ucl_champion", false)) \
			or bool(result.get("eul_champion", false)) or bool(result.get("conf_champion", false))
	var apoyo: String = str(e.get("apoyo", ""))
	var p: float = Elecciones.p_candidato(bool(e.get("crisis", false)), t, titulo, apoyo)
	if r < 0.0:
		var rng: RandomNumberGenerator = RandomNumberGenerator.new()
		rng.seed = hash("eleccion|voto|%d|%d|%s" % [WorldAging.world_seed(),
			int(e["temporada"]), mio])
		r = rng.randf()
	var gana: bool = r < p
	var fx: Dictionary = Elecciones.fx_cierre(apoyo, gana)
	if not fx.is_empty():
		_apply_event_fx({"rel": fx})




	var rr: RandomNumberGenerator = RandomNumberGenerator.new()
	rr.seed = hash("eleccion|reparto|%d|%d|%s" % [WorldAging.world_seed(), int(e["temporada"]), mio])
	queue_ceremony(Ceremonies.NOCHE_ELECTORAL, {
		"gana": gana, "pct": Elecciones.reparto(p, gana, rr.randf()), "apoyo": apoyo,
		"promesa": str(e.get("promesa", "")), "presi": "presidente_%s" % mio,
		"cand": "candidato_%s_%d" % [mio, int(e["temporada"])],
	})
	if not gana:
		lines.append(I18n.t("El presidente gana las elecciones y sigue"))
	elif str(e.get("promesa", "")) == Elecciones.VENTA:
		eleccion_venta = {"club": mio, "temporada": GameState.season_num}
		lines.append(I18n.t("Gana el candidato: el presidente nuevo quiere venderte este verano"))
	else:
		var dinero: int = Elecciones.inyeccion(club_income_of(mio))
		_club_cash_add(mio, dinero)
		lines.append(I18n.tf("Gana el candidato: el presidente nuevo mete ${0} en la caja para fichar",
			[CareerUi.money(dinero)]))



