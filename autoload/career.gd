func _maybe_juvenil_vendido() -> void:
	if _juvenil_semana_ok().is_empty():
		return
	var mio: String = GameState.player_team_id
	var rows: Array = squad_roster()
	var f: Dictionary = juveniles["foto"]
	var nombres: Dictionary = f.get("nombres", {})
	var fueron: Array = Juveniles.se_fueron(nombres, rows) \
			if String(f.get("club", "")) == mio else []
	juveniles["foto"] = {"club": mio, "nombres": Juveniles.foto(rows)}
	for nm in fueron:
		var donde: String = _juvenil_donde(String(nm), mio)
		if donde.is_empty() or donde == mio:
			continue
		(juveniles["idos"] as Dictionary)[String(nm)] = donde
		var pay: Dictionary = _juvenil_payload({"name": String(nm)})
		pay["rival"] = donde
		queue_ceremony(Ceremonies.JUVENIL_VENDIDO, pay)
		break
	_save()


func _juvenil_donde(nm: String, mio: String) -> String:
	for fila in TransferBook.filas_con_etapa_en(mio):
		var tid: String = String((fila as Dictionary).get("team", ""))
		for p in Squad.of(tid):
			if String((p as Dictionary).get("name", "")) == nm:
				return tid
	return ""



func _maybe_juvenil_rival() -> void:
	var fx: Dictionary = _juvenil_semana_ok()
	if fx.is_empty():
		return
	var opp: String = String(fx.get("opp", ""))
	var idos: Dictionary = juveniles["idos"]
	for nm in idos:
		if String(idos[nm]) != opp or (juveniles["rival"] as Array).has(String(nm)):
			continue
		for p in Squad.of(opp):
			var pd: Dictionary = p
			if String(pd.get("name", "")) != String(nm):
				continue
			(juveniles["rival"] as Array).append(String(nm))
			var pay: Dictionary = _juvenil_payload(pd)
			pay["opp"] = opp
			pay["home"] = bool(fx.get("home", true))
			queue_ceremony(Ceremonies.JUVENIL_RIVAL, pay)
			_save()
			return






















