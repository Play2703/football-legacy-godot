	if String(row.get("estado", "")) != "vivo":
		return {}
	var sem: Variant = row.get("semilla", {})
	return (sem as Dictionary).duplicate() if sem is Dictionary else {}




func socio_v(person: String) -> int:
	var ficha: Dictionary = socio_row(person)
	return 0 if ficha.is_empty() or String(ficha.get("estado", "")) != "vivo" \
			else int(ficha.get("v", 0))






















func socio_row(person: String) -> Dictionary:
	var ficha: Variant = socios.get(person, null)
	if not (ficha is Dictionary):
		return {}
	var out: Dictionary =(ficha as Dictionary).duplicate()
	out["estado"] = "ex"
	var club: String = String(out.get("club", ""))
	var idx: int = int(out.get("idx", -1))
	if club.is_empty() or idx < 0:
		return out











	if club != GameState.player_team_id:
		return out
	var squad: Array = Squad.of_nominal(club)
	if idx >= squad.size():
		return out
	var fila: Dictionary = squad[idx]
	if String(fila.get("name", "")) != person:
		return out
	var esperada: int = mini(int(out.get("edad", 0))
		+(GameState.season_num - int(out.get("alta", GameState.season_num))),
		SquadMeta.AGE_CAP)
	var hoy: int = WorldAging.seat_age(club, idx, String(fila.get("pos", "MC")),
		GameState.season_num)
	if hoy == esperada:
		out["estado"] = "vivo"
	return out























func _migra_socios_a_titulo(crudo: Dictionary) -> Dictionary:
	var out: Dictionary = {}
	for nm in crudo:
		var nombre: String = String(nm)
		var ficha: Variant = crudo[nm]
		if ficha is Dictionary:
			var club: String = String((ficha as Dictionary).get("club", ""))
			var idx: int = int((ficha as Dictionary).get("idx", -1))
			if not club.is_empty() and idx >= 0:
				var squad: Array = Squad.of_nominal(club)
				if idx < squad.size():
					var hoy: String = String((squad[idx] as Dictionary).get("name", ""))
					if hoy != nombre and hoy.to_upper() == nombre.to_upper():
						nombre = hoy
		out[nombre] = ficha
	return out


func socios_top(n: int, solo_club: bool = true) -> Array:
	var out: Array = []
	for nm in socios:
		var ficha: Dictionary = socio_row(String(nm))
		if ficha.is_empty():
			continue
		if solo_club and String(ficha.get("estado", "")) != "vivo":
			continue
		var v: int = int(ficha.get("v", 0))
		if absi(v) < SOCIO_UMBRAL:
			continue
		out.append({"name": String(nm), "v": v,
			"estado": String(ficha.get("estado", "ex"))})
	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return absi(int(a["v"])) > absi(int(b["v"])))
	return out.slice(0, maxi(n, 0))




func _advance_socios() -> void:
	var vivos: Dictionary = {}
	for nm in socios:
		var ficha: Dictionary = socios[nm]
		var v: int = int(round(float(int(ficha.get("v", 0))) * SOCIO_DECAY))
		if absi(v) < 5 \
				and GameState.season_num - int(ficha.get("alta", 0)) >= 2:

			continue
		ficha["v"] = v
		vivos[nm] = ficha
	if vivos.size() > SOCIO_TOPE:
		var orden: Array = vivos.keys()
		orden.sort_custom(func(a: String, b: String) -> bool:
			return absi(int((vivos[a] as Dictionary).get("v", 0))) \
					> absi(int((vivos[b] as Dictionary).get("v", 0))))
		var podado: Dictionary = {}
		for nm2 in orden.slice(0, SOCIO_TOPE):
			podado[nm2] = vivos[nm2]
		vivos = podado
	socios = vivos




const MATE_AVG_DROP: float = 0.3
const MATE_AVG_JITTER: float = 0.4










func blend_mate_stats(race: Array, comp: String, club: String = "") -> void:
	var key: String = "league" if comp == "" else comp
	var g: Dictionary = season_mate_goals.get(key, {})
	var a: Dictionary = season_mate_assists.get(key, {})






	if g.is_empty() and a.is_empty():
		return
	var mine: String = club if not club.is_empty() else GameState.player_team_id












	var pj: Dictionary = season_mate_apps.get(key, {})
	if pj.is_empty() and key == "league" and mine == GameState.player_team_id:
		sync_mate_meta_stats()
		pj = season_mate_apps.get(key, {})
	var pj_reales: bool = not pj.is_empty() and (key == "league" or not mate_apps_parcial)
	var vistos: Dictionary = {}
	var apps: int = 0


	var avg_club: float = 0.0
	for e in race:
		if String(e.get("team", "")) != mine:
			continue
		var nm: String = String(e.get("name", ""))
		vistos[nm] = true
		apps = maxi(apps, int(e.get("apps", 0)))
		var avg_e: float = float(e.get("avg", 0.0))
		if avg_e > 0.0:
			avg_club = avg_e if avg_club <= 0.0 else minf(avg_club, avg_e)
		e["goals"] = int(g.get(nm, 0))
		e["assists"] = int(a.get(nm, 0))
		if pj_reales:
			e["apps"] = int(pj.get(nm, 0))








	for nm in g.keys() + a.keys():
		var name: String = String(nm)
		if vistos.has(name):
			continue
		vistos[name] = true

















		var nota: float = 7.0
		if avg_club > 0.0:
			var dado: RandomNumberGenerator = RandomNumberGenerator.new()
			dado.seed = hash(name)
			nota = snappedf(maxf(avg_club - MATE_AVG_DROP
				- dado.randf_range(0.0, MATE_AVG_JITTER), 6.0), 0.1)
		race.append({"name": name, "team": mine, "goals": int(g.get(name, 0)),
			"assists": int(a.get(name, 0)),
			"avg": nota, "apps": int(pj.get(name, 0)) if pj_reales else apps,
			"breakout": false})
















