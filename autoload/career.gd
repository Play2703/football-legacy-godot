func _amer_campo_cierre(comp: String) -> Array:
	var snap: Dictionary = GameState.last_season_snap
	var campo: Variant = snap.get(comp, [])
	if campo is Array and not (campo as Array).is_empty():
		return campo
	var rec: Dictionary =(snap.get("recorridos", {}) as Dictionary).get(comp, {})
	var out: Array = []
	for id in (rec.get("map", {}) as Dictionary):
		out.append(String(id))
	return out


















func cup_race(closing: bool = false, rounds: int = 4, hasta: int = -1) -> Array:
	var season: int = GameState.season_num -(1 if closing else 0)
	if not closing:
		return Race.cup_registrada(GameState.cup_state.get("bracket", []), season,
			GameState.player_team_id, hasta)
	var reg: Array = Race.cup_registrada(GameState.last_season_snap.get("cup_bracket", []),
		season, GameState.player_team_id, hasta)
	if not reg.is_empty():
		return reg
	return Race.cup(season, GameState.player_team_id, rounds,
		GameState.last_season_snap.get("cup", []))






func cup_race_registrada() -> bool:
	for ronda in GameState.cup_state.get("bracket", []):
		for tie in ronda:
			if not str((tie as Dictionary).get("winner", "")).is_empty():
