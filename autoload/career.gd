		return risked

	return "%s: %s" % [I18n.t(String(e["title"])),
		I18n.t(String(opt["label"])).capitalize()]




func _apply_event_fx(fx: Dictionary, risk_roll: float = -1.0) -> String:
	if fx.has("risk"):
		var risk: Dictionary = fx["risk"]



		var p: float = risk_chance(fx)
		var roll: float = risk_roll if risk_roll >= 0.0 else randf()
		var won: bool = roll < p
		_apply_event_fx(risk["win"] if won else risk["lose"])


		return I18n.t(String(risk.get("win_msg", "¡Salió bien!"))) if won \
				else I18n.t(String(risk.get("lose_msg", "Salió mal…")))




	if bool(fx.get("pos_switch", false)) and not _pos_pedido.is_empty():
		fija_puesto(GameState.player_team_id, _pos_pedido, true)
		_pos_pedido = ""
	if bool(fx.get("action", false)):
		week_actions = maxi(0, week_actions - 1)
	money += _event_money(fx)
	if float(fx.get("multa", 0.0)) > 0.0:
		_multa_apunta(Multas.K_PRENSA, Multas.monto(int(contract["wage"]), float(fx["multa"])))
	energy = clampf(energy + float(fx.get("energy", 0.0)), 0.0, energy_cap())









	var novia: String = String(fx.get("pareja_start", ""))
	if novia == "?":
		novia = pareja_candidata()
	var rels: Dictionary = fx.get("rel", {})


	var _com_antes: Dictionary = rel.duplicate() if float(fx.get("multa", 0.0)) > 0.0 else {}
	for k in rels:
		_apply_delta(String(k), _div_decision_scale(float(rels[k])),
			REL_BRAKE_EXP_DECISION)
	if not _com_antes.is_empty():
		_comunicado_tras_frase(fx, _com_antes)




	if bool(fx.get("shirt", false)):
		_take_coveted_shirt()








	var d_socio: int = int(fx.get("socio", 0))
	if d_socio != 0 and not _socio_escena.is_empty():
		var squad_soc: Array = Squad.of_nominal(GameState.player_team_id)
		_bump_socio(_socio_escena, d_socio, GameState.player_team_id, squad_soc)



	var take: int = int(fx.get("shirt_take", 0))
	if take > 0:
		_set_shirt(take)



	if bool(fx.get("tifo_pagar", false)):
		_tifo_pagar()








	var cut: float = float(fx.get("wage_cut", 0.0))
	if cut > 0.0:
		var before: int = int(contract["wage"])
		contract["wage"] = maxi(1, int(round(float(before) *(1.0 - cut))))


	if bool(fx.get("play_hurt", false)):
		if injury_weeks > 0 and _injury_was_grave:
			back_from_injury = true
			_injury_was_grave = false
		if injury_weeks > 0:
			_arm_eased_return(true)
		injury_weeks = 0
		injury_dias = 0



	var heal_w: int = int(fx.get("injury_heal", 0))
	if heal_w > 0 and injury_weeks > 0:
		injury_weeks = maxi(0, injury_weeks - heal_w)
		if injury_weeks == 0:
			injury_dias = 0
			_arm_eased_return(true)
		if injury_weeks == 0 and _injury_was_grave:
			back_from_injury = true
			_injury_was_grave = false




	if bool(fx.get("rival_baja", false)):
		_romper_rival()



	if bool(fx.get("retire_lesion", false)):
		retire("lesion")
		return ""





	if bool(fx.get("injury_secuela", false)):
		_apply_injury_secuela()



	if bool(fx.get("squad_rumor_stay", false)):
		_resolve_squad_rumor("stay")
	if bool(fx.get("squad_rumor_drop", false)):
		_resolve_squad_rumor("drop")









	if bool(fx.get("injury_relapse", false)):






		var reroll: int = maxi(roll_injury_weeks(), roll_injury_weeks())
		injury_weeks = maxi(injury_weeks, mini(maxi(GRAVE_WEEKS,
			maxi(injury_weeks + 1, reroll)), injury_weeks_ceiling()))
		_notify_injury()











	if not novia.is_empty():
		empezar_relacion(novia)


	if bool(fx.get("pareja_formal", false)):
		formalizar_relacion()



	if bool(fx.get("pareja_pedir", false)):
		comprometerse()


	if fx.has("capitan_penales"):
		capitan_penales = bool(fx["capitan_penales"])
		season_pen_cedidos_fallados = 0

	if fx.has("nueve_acepta"):
		nueve_ofrecido = true
		if bool(fx["nueve_acepta"]) and not pos_fav.is_empty():
			fija_puesto(GameState.player_team_id, pos_fav, true)
	if bool(fx.get("pareja_casar", false)):
		casarse(bool(fx.get("pareja_prenup_ok", false)),
			String(fx.get("pareja_titular", "")))




	if bool(fx.get("pareja_frio", false)):
		pareja_frio = mini(PAREJA.FRIO_PASOS, pareja_frio + 1)
	if bool(fx.get("pareja_calor", false)):
		pareja_frio = 0
		pareja.erase("enfria")



	if bool(fx.get("caza_sube", false)):
		var _pago: float = PAREJA.caza_compra(String(pareja.get("id", "")), pareja_pago)
		if _pago >= 0.0:
			pareja_pago = _pago
		pareja.erase("tasa")
	if bool(fx.get("caza_planta", false)):
		pareja.erase("tasa")
		_seed_divorcio()


	if bool(fx.get("pareja_no", false)):
		var _no: String = pareja_candidata()
		if not _no.is_empty():
			pareja_rechazadas[_no] = GameState.season_num







	if bool(fx.get("pareja_end", false)):
		terminar_relacion()


	if bool(fx.get("pareja_queda", false)):
		_pareja_viaje(false)
	if bool(fx.get("pareja_lesion_fin", false)):
		pareja.erase("lesion")
	if bool(fx.get("pareja_viaja", false)):
		return I18n.t("Se viene contigo.") if _pareja_viaje(true) \
				else I18n.t("No se viene. Os toca la distancia.")


	if bool(fx.get("captain_block", false)):
		_captain_blocked_season = GameState.season_num








	if bool(fx.get("captain_grant", false)):
		is_captain = true
		_peldano_fija(maxi(peldano(), Gerencia.PELDANO_CAPITAN))
		record_captain_band("club")




		queue_ceremony(Ceremonies.CAPTAIN, {"avg": season_avg(), "via": "voto"})







	if bool(fx.get("rename_stadium", false)):
		var honored: String = stadium_honor_club if not stadium_honor_club.is_empty() \
				else GameState.player_team_id
		stadium_rename_club = honored
		stadium_rename = "Estadio %s" % player_name
		_queue_stadium_act()








	if bool(fx.get("ultimatum", false)):
		ultimatum_start()
	if bool(fx.get("spicy", false)):
		spicy_add(bool(fx.get("spicy_gol", false)))
	if String(fx.get("spicy_off", "")) == "next":
		spicy_clear(String(GameState.next_fixture().get("opp", "")))




	if bool(fx.get("pique_frase", false)):
		spicy_add_pique(String(pique_red.get("club", "")))
		_muro_escribe("post_pique", 0, GameState.season_day)



	if not String(fx.get("post", "")).is_empty():
		muro_pon("post_" + String(fx["post"]))
	if not String(fx.get("titular", "")).is_empty():
		titular_pon(String(fx["titular"]))
	var edge: int = int(fx.get("rival_edge", 0))
	if edge != 0:
		rival_edge = clampi(rival_edge + edge, - RIVAL_EDGE_CAP, RIVAL_EDGE_CAP)



	var nedge: int = int(fx.get("nat_edge", 0))
	if nedge != 0:
		nat_edge = clampi(nat_edge + nedge, - NAT_EDGE_CAP, NAT_EDGE_CAP)
	return ""






func event_cash(fx: Dictionary) -> int:
	var cash: int = _event_money(fx)



	if bool(fx.get("pareja_casar", false)) \
			and String(pareja.get("estado", "")) == "prometido":
		cash -= boda_coste()
	return cash





func event_invita(fx: Dictionary) -> int:
	if not pareja_activa() or PAREJA.invita_de(String(pareja.get("id", ""))) <= 0.0:
		return 0
	var out: int = 0
	if bool(fx.get("con_ella", false)):
		var sin_ella: Dictionary = fx.duplicate()
		sin_ella.erase("con_ella")
		out += _event_money(fx) - _event_money(sin_ella)
	if bool(fx.get("pareja_casar", false)) \
			and String(pareja.get("estado", "")) == "prometido":
		out += boda_coste_bruto() - boda_coste()
	return out














func resolve_moment(id: String, choice: String, socio: String = "") -> String:
	var e: Dictionary = WeekEvents.moment_by_id(id)
	if e.is_empty() or not e.has(choice):
		return ""
	var out: String = ""
	if not socio.is_empty() and e.has(choice + "_socio"):
		var sello: String = _socio_escena
		_socio_escena = socio
		out = _apply_event_fx((e[choice + "_socio"] as Dictionary)["fx"])
		_socio_escena = sello
	else:
		out = _apply_event_fx((e[choice] as Dictionary)["fx"])
	if id in MICRO_MOMENTOS:
		_marca_micro()
	_save()
	changed.emit()
	return out









func risk_chance(fx: Dictionary) -> float:
	if not fx.has("risk"):
		return 0.0
	var risk: Dictionary = fx["risk"]


	var div_shift: float = float(_player_div() - 2) * DIV_RISK_SHIFT
	return clampf(float(risk.get("p", 0.5)) + div_shift
		+ clampf(float(form) * 0.03, -0.15, 0.15)
		+ _risk_socio_shift(risk), 0.05, 0.95)








const RISK_SOCIO_MAX: float = 0.12






const RUMOR_FEE_BAND: float = 0.75
















func _risk_socio_shift(risk: Dictionary) -> float:
	if squad_rumor.is_empty():
		return 0.0
	var win: Dictionary = risk.get("win", {})
	if not bool(win.get("squad_rumor_stay", false)):
		return 0.0
	var v: int = socio_v(String(squad_rumor.get("name", "")))
	if v == 0:
		return 0.0
	return clampf(float(v) / float(SOCIO_MAX), -1.0, 1.0) * RISK_SOCIO_MAX






func _player_div() -> int:
	if GameState.player_team_id.is_empty():
		return 2
	return clampi(GameState.player_div(), 1, 3)





func _div_decision_scale(delta: float) -> float:
	var ease: float = float(_player_div() - 2) * DIV_DECISION_EASE
