static func _media_npc(p: Dictionary) -> int:
	return SquadMeta.ovr_of(p, String(p.get("pos", "MC")))


func _rival_a_tu_nivel(squad: Array) -> int:
	var yo: float = float(ovr_shown())
	var mejor: int = -1
	var dist: float = INF
	var minimo: int = 0
	for i in squad.size():
		var o: float = float(_media_npc(squad[i]))
		if o < float(_media_npc(squad[minimo])):
			minimo = i
		if o > yo + 6.0:
			continue
		var d: float = absf(o -(yo + 3.0))
		if d < dist:
			dist = d
			mejor = i
	return mejor if mejor >= 0 else minimo











const P_CRACK: float = 0.05
const P_MEJOR: float = 0.2
const NOTA_CRACK: float = 9.0


func _quien_te_la_da(squad: Array, nota: float, tiro: float) -> Dictionary:
	var nivel: int = _rival_a_tu_nivel(squad)
	var p_crack: float = P_CRACK *(2.0 if nota >= NOTA_CRACK else 1.0)
	if tiro < p_crack:
		var top: int = 0
		for i in squad.size():
			if _media_npc(squad[i]) > _media_npc(squad[top]):
				top = i
		return {"idx": top, "crack": top != nivel}
	if tiro < p_crack + P_MEJOR:
		var yo: float = float(ovr_shown())
		var franja: Array[int] = []
		for i in squad.size():
			var o: float = float(_media_npc(squad[i]))
			if o > yo + 6.0 and o <= yo + 12.0:
				franja.append(i)
		if not franja.is_empty():


			var u: float =(tiro - p_crack) / P_MEJOR
			return {"idx": franja[mini(int(u * franja.size()), franja.size() - 1)], "crack": false}
	return {"idx": nivel, "crack": false}






func _suerte_playera(shirt: Dictionary, opp: String, idx: int, grande: bool,
		crack: bool = false, tiro: float = -1.0) -> Dictionary:
	var retira: bool = false
	if idx >= 0 and not Teams.by_id(opp).is_empty():
		var squad: Array = Squad.of(opp)
		var meta: Array = squad_meta_of(opp)
		if idx < squad.size():
			var edad: int = int((meta[idx] as Dictionary).get("age", -1)) \
					if idx < meta.size() else -1
			retira = WorldAging.retires_in_casa(opp, idx,
				String((squad[idx] as Dictionary).get("pos", "MC")), edad) == 0
	var out: Dictionary = shirt.duplicate()
	out["variante"] = Keepsakes.sortea_variante(randf() if tiro < 0.0 else tiro, retira,
		grande, WeatherWear.marks_on(GameState.next_weather))
	out["crack"] = crack
	return Keepsakes.sanitize(out)







