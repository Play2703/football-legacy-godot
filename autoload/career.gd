		return false
	return _reco_precio(f) > 0 and not gerencia_clausula(f) \
			and int(gerencia_trato(f)["pacto"]) < 0




func _ger_piso(f: Dictionary) -> int:
	var precio: int = _reco_precio(f)
	var h: int = posmod(hash("regateo|%s|%s|%d" % [String(f.get("club", "")),
		String(f.get("name", "")), GameState.season_num]), 2001)
	var minimo: int = 0
	if gerencia_fuerza(f):
		var mk: String = _precio_clave(String(f.get("club", "")), int(f.get("seat", -1)),
			String(f.get("name", "")))
		minimo = int((_precio_memo.get(mk, {}) as Dictionary).get("p_traspaso", 0))
	return Gerencia.regateo_piso(precio, gerencia_interes(f), float(h) / 1000.0 - 1.0, minimo)









func gerencia_ofrece(f: Dictionary, oferta: int) -> Dictionary:
	if not gerencia_regatea(f):
		var c: String = gerencia_mesa_no_compra(f)
		return {"ok": false, "causa": c if not c.is_empty() else "regateo"}
	var precio: int = _reco_precio(f)
	oferta = clampi(oferta, int(float(precio) * Gerencia.REGATEO_SUELO), precio)
	var piso: int = _ger_piso(f)
	var clave: String = _ger_mesa_no_clave(f)
	var m: Dictionary = _ger_mesa().duplicate(true)
	var tratos: Dictionary = m.get("tratos", {})
	var t: Dictionary =(tratos.get(clave, {}) as Dictionary).duplicate()
	t["ultima"] = oferta
	if oferta >= piso:
		t["pacto"] = oferta
		tratos[clave] = t
		m["tratos"] = tratos
		_ger_mesa_guarda(m)
		Telemetry.count("mesa_regateo_si")
		if not gerencia_mesa_compro(f):
			gerencia_mesa_compra(f)
		return {"ok": true, "pacto": oferta, "quedan": Gerencia.REGATEO_INTENTOS - int(t.get("n", 0))}
	var n: int = int(t.get("n", 0)) + 1
	t["n"] = n
	tratos[clave] = t
	m["tratos"] = tratos
	if n >= Gerencia.REGATEO_INTENTOS:
		var i: int = _ger_mesa_compra_i(m["compras"], f)
		if i >= 0:
			(m["compras"] as Array).remove_at(i)
		_ger_mesa_no_apunta(f)
		_ger_mesa_guarda(m)
		Telemetry.count("mesa_regateo_no")
		return {"ok": false, "causa": "club_no", "quedan": 0}
	t["contra"] = Gerencia.regateo_contra(precio, piso, n)
	_ger_mesa_guarda(m)
	return {"ok": false, "contra": int(t["contra"]), "quedan": Gerencia.REGATEO_INTENTOS - n}










