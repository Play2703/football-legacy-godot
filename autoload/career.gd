func gerencia_hueco() -> Dictionary:
	var id: String = GameState.player_team_id
	if id.is_empty():
		return {}
	var squad: Array = Squad.of(id)
	if squad.is_empty():
		return {}
	var yo: int = Squad.user_index(squad)
	var peor: Dictionary = {}
	for i in mini(squad.size(), Squad.STARTING_XI):
		if i == yo:
			continue
		var p2: Dictionary = squad[i]
		var pos: String = String(p2.get("pos", "MC"))
		var m: int = SquadMeta.media_of(p2, pos)
		if peor.is_empty() or m < int(peor["media"]):
			peor = {"idx": i, "pos": pos, "media": m}
	return peor


















func _gerencia_descarte(team_id: String, squad: Array) -> int:
	var meta: Array = squad_meta_of(team_id)
	var yo: int = Squad.user_index(squad)
	var por_puesto: Dictionary = {}
	for i in squad.size():
		var q: String = String((squad[i] as Dictionary).get("pos", "MC"))
		por_puesto[q] = int(por_puesto.get(q, 0)) + 1
	var peor: int = -1
	var peor_media: int = 1000
	for i in range(Squad.STARTING_XI, squad.size()):
		if i == yo:
			continue
		var s: Dictionary = squad[i]
		var pos: String = String(s.get("pos", "MC"))
		if SquadEdits.PROTECTED_POS.has(pos) and int(por_puesto.get(pos, 0)) <= 1:
			continue
		if i < meta.size() and int((meta[i] as Dictionary).get("signed", -9999)) \
				>= GameState.season_num:
			continue
		var m: int = SquadMeta.media_of(s, pos)
		if m < peor_media:
			peor_media = m
			peor = i
	return peor







func _gerencia_suelta(team_id: String, idx: int, squad_n: int) -> bool:
	if not RosterDelta.drop_seat(team_id, idx, false, squad_n):
		return false
	corre_asiento_carrera(team_id, idx)
	return true








func corre_asiento_carrera(team_id: String, idx: int) -> void:
	CareerEdits.drop_seat(team_id, idx)



	TransferBook.contratos_drop_seat(team_id, idx)
	editor_drop_meta(team_id, idx)




	_plan_corre_asiento(team_id, idx)
	if team_id == GameState.player_team_id:
		_gerencia_corre_asiento(team_id, idx)




	Squad.invalidate(team_id)






func _gerencia_corre_asiento(team_id: String, h: int) -> void:
	var t: Variant = gerencia.get("intocable", null)
	if t is Dictionary and String((t as Dictionary).get("club", "")) == team_id:
		var ti: int = int((t as Dictionary).get("idx", -1))
		if ti == h:
			gerencia.erase("intocable")
		elif ti > h:
			(t as Dictionary)["idx"] = ti - 1
	var ren: Variant = gerencia.get("renueva", null)
	if ren is Array:
		var quedan: Array = []
		for e in (ren as Array):
			if not (e is Dictionary):
				continue
			var ri: int = int((e as Dictionary).get("idx", -1))
			var suyo: bool = String((e as Dictionary).get("club", "")) == team_id
			if suyo and ri == h:
				continue
			if suyo and ri > h:
				(e as Dictionary)["idx"] = ri - 1
			quedan.append(e)
		gerencia["renueva"] = quedan



	var mesa: Variant = gerencia.get("mesa", null)
	if mesa is Dictionary and String((mesa as Dictionary).get("club", "")) == team_id \
			and (mesa as Dictionary).get("ventas", null) is Array:
		var vivas: Array = []
		for e2 in ((mesa as Dictionary)["ventas"] as Array):
			if not (e2 is Dictionary):
				continue
			var vi: int = int((e2 as Dictionary).get("idx", -1))
			if vi == h:
				continue
			if vi > h:
				(e2 as Dictionary)["idx"] = vi - 1
			vivas.append(e2)
		(mesa as Dictionary)["ventas"] = vivas






func _gerencia_ficha(arg: Dictionary) -> String:
	var mio: String = GameState.player_team_id
	var vende: String = String(arg.get("club", ""))
	var v_idx: int = int(arg.get("idx", -1))
	if mio.is_empty() or vende.is_empty() or v_idx < 0:
		return ""


	var ex: int = maxi(int(arg.get("ex", 0)), 0)
	if Teams.is_free(vende):
		return _gerencia_ficha_libre(v_idx, ex, bool(arg.get("acto", true)))
	var origen: Array = Squad.of(vende)
	if v_idx >= origen.size():
		return ""
	var p: Dictionary = origen[v_idx]


	if String(p.get("name", "")) != String(arg.get("name", "")):
		return ""









	var v_seat: int = Squad.home_seat(origen, v_idx)












	squad_meta_of(vende)
	var meta: Array = squad_meta.get(vende, [])
	if v_seat < 0 or v_seat >= meta.size():
		return ""
	var pm: Dictionary = meta[v_seat]
	var seat: Dictionary = {
		"idx": v_seat, "pos": String(p.get("pos", "MC")),
		"media": SquadMeta.media_of(p, String(p.get("pos", "MC"))),
		"age": int(pm.get("age", 26)), "contract": int(pm.get("contract", 3)),
		"name": String(p.get("name", "")), "nation": String(pm.get("nation", "")),
		"signed": int(pm.get("signed", -9999)), "player": p, "pm": pm,
	}
	var fee: int = int(arg.get("fee", 0))
	var ident: Dictionary = AiMarket._identity(seat, GameState.season_num,
		AiMarket.SIGNED_CONTRACT_MIN)




	var mapas: Dictionary = {}
	var suyas: Array = _salida_de(vende, v_seat, GameState.season_num,
		TransferBook.VIA_FICHAJE, String(p.get("pos", "")), mapas)["carrera"]






























	var squad_mio: Array = Squad.home_of(mio, true)
	if squad_mio.is_empty():
		return ""




	var _mia: Array = squad_meta_of(mio)


	var salida: int = -1
	if squad_mio.size() >= Squad.SQUAD_SIZE:
		salida = _gerencia_descarte(mio, squad_mio)
		if salida < 0:
			return ""
	var destino_pos: String = String(p.get("pos", "MC"))



	var suya: Dictionary = p.duplicate(true)
	suya["age"] = int(pm.get("age", 26))
	suya["nation"] = String(pm.get("nation", ""))
	suya["poss"] = Squad.poss_of(p)



	suya["carrera"] = suyas
	suya["etapa_desde"] = GameState.season_num



	var dorsal: int = Squad.free_number(squad_mio, destino_pos, mio)
	var nuevo_idx: int = RosterDelta.add_seat(mio, destino_pos, dorsal,
		SquadEdits.snapshot_identity(suya), false, squad_mio.size())
	if nuevo_idx < 0:
		return ""
	var ficha: Dictionary = {}
	if v_seat < meta.size():
		ficha =(meta[v_seat] as Dictionary).duplicate(true)
	ficha["age"] = int(pm.get("age", 26))
	ficha["nation"] = String(pm.get("nation", ""))
	ficha["contract"] = AiMarket.SIGNED_CONTRACT_MIN
	ficha["signed"] = GameState.season_num



	ficha["por_ti"] = GameState.season_num
	ficha["gp"] = 0
	ficha.erase("gp_prev")
	ficha["goals"] = 0
	ficha["assists"] = 0
	ficha["rating_sum"] = 0.0
	editor_add_meta(mio, ficha)






	if salida >= 0:
		salida = Squad.home_seat(squad_mio, salida)
	if salida >= 0 and not _gerencia_suelta(mio, salida, squad_mio.size() + 1):
		RosterDelta.reset_last(mio, false)
		editor_drop_meta(mio, squad_mio.size())
		return ""



	var ocupados: Dictionary = {}
	for fila in origen:
		ocupados[String((fila as Dictionary).get("name", ""))] = true
	var relevo: Dictionary = AiMarket.youth_identity(vende, String(seat["pos"]),
		Teams.rating(vende), Teams.country_of(vende), GameState.season_num,
		hash("ger_relevo|%s|%d|%d" % [vende, v_seat, GameState.season_num]), ocupados)



	_asienta(vende, v_seat, relevo, GameState.season_num, "", TransferBook.SIN_ORIGEN, mapas)










	_plan_sin_cadena(["%s#%d" % [vende, v_seat]])
	_patch_squad_meta(vende, v_seat, relevo)
	TransferBook.invalidate_caches()


	_siembra_vestuario(String(suya.get("name", "")), suyas)
	club_cash[mio] = int(club_cash.get(mio, 0)) - fee
	club_cash[vende] = int(club_cash.get(vende, 0)) + fee

	_gerencia_tope_gasta(fee)
	market_news.push_front({"season": GameState.season_num,
		"day": GameState.season_day, "kind": "signing",


		"name": String(ident.get("name", "")), "pos": destino_pos,
		"from": vende, "to": mio, "fee": fee, "free": fee <= 0,






		"media": SquadMeta.ovr_of(ident, destino_pos),
		"nation": String(ident.get("nation", "")),

		"ex": ex})
	market_news_total += 1
	if market_news.size() > MARKET_NEWS_MAX:
		market_news = market_news.slice(0, MARKET_NEWS_MAX)





	if bool(arg.get("acto", true)):
		queue_ceremony(Ceremonies.REFUERZO, {
			"name": String(ident.get("name", "")),


			"number": dorsal,






			"fee": fee,



			"media": SquadMeta.ovr_of(ident, destino_pos),
			"from": vende,


			"ex": ex,
		})



	_apunta_llegada({
		"name": String(ident.get("name", "")), "pos": destino_pos,
		"media": SquadMeta.ovr_of(ident, destino_pos), "from": vende,
		"fee": fee, "free": fee <= 0, "loan": false,



		"nation": String(ident.get("nation", "")), "age": int(suya.get("age", 0)),
	})
	Achievements.ingest_refuerzo()


	_tuyos_apunta(String(suya.get("name", "")), mio, destino_pos, fee)
	return String(ident.get("name", ""))










func _gerencia_ficha_libre(seat: int, ex: int = 0, acto: bool = true) -> String:
	var mio: String = GameState.player_team_id
	var fa: Dictionary = _libre_de(seat)
	if mio.is_empty() or fa.is_empty():
		return ""
	var season: int = GameState.season_num



	var ident: Dictionary = AiMarket._free_identity(fa, season)
	var destino_pos: String = String(fa.get("pos", "MC"))
	var squad_mio: Array = Squad.home_of(mio, true)
	if squad_mio.is_empty():
		return ""

	var _mia: Array = squad_meta_of(mio)
	var salida: int = -1
	if squad_mio.size() >= Squad.SQUAD_SIZE:
		salida = _gerencia_descarte(mio, squad_mio)
		if salida < 0:
			return ""
	var suya: Dictionary = ident.duplicate(true)
	suya["pos"] = destino_pos
	suya["poss"] = Squad.poss_of(suya)


	suya["etapa_desde"] = season
	var dorsal: int = Squad.free_number(squad_mio, destino_pos, mio)
	var nuevo_idx: int = RosterDelta.add_seat(mio, destino_pos, dorsal,
		SquadEdits.snapshot_identity(suya), false, squad_mio.size())
	if nuevo_idx < 0:
		return ""
	var edad: int = int(ident.get("age", 26))
	editor_add_meta(mio, {"age": edad, "nation": String(ident.get("nation", "")),
		"contract": AiMarket.SIGNED_CONTRACT_MIN, "signed": season, "por_ti": season,
		"gp": 0, "goals": 0, "assists": 0, "rating_sum": 0.0})
	if salida >= 0:
		salida = Squad.home_seat(squad_mio, salida)
	if salida >= 0 and not _gerencia_suelta(mio, salida, squad_mio.size() + 1):
		RosterDelta.reset_last(mio, false)
		editor_drop_meta(mio, squad_mio.size())
		return ""

	var nombre: String = String(fa.get("name", ""))
	free_agents.erase(fa)
	_cancel_plan_libre(nombre, destino_pos)
	TransferBook.invalidate_caches()


	_siembra_vestuario(String(suya.get("name", "")),
		TransferBook.sanea_carrera(ident.get("carrera", [])))
	var medalla: int = SquadMeta.ovr_of(ident, destino_pos)
	market_news.push_front({"season": season, "day": GameState.season_day,
		"kind": "signing", "name": String(ident.get("name", "")), "pos": destino_pos,
		"from": Teams.FREE_ID, "to": mio, "fee": 0, "free": true, "media": medalla,
		"nation": String(ident.get("nation", "")), "ex": ex})
	market_news_total += 1
	if market_news.size() > MARKET_NEWS_MAX:
		market_news = market_news.slice(0, MARKET_NEWS_MAX)

	if acto:
		queue_ceremony(Ceremonies.REFUERZO, {"name": String(ident.get("name", "")),
			"number": dorsal, "fee": 0, "media": medalla, "from": Teams.FREE_ID, "ex": ex})
	_apunta_llegada({"name": String(ident.get("name", "")), "pos": destino_pos,
		"media": medalla, "from": Teams.FREE_ID, "fee": 0, "free": true, "loan": false,
		"nation": String(ident.get("nation", "")), "age": edad})
	Achievements.ingest_refuerzo()
	_tuyos_apunta(String(suya.get("name", "")), mio, destino_pos, 0)
	return String(ident.get("name", ""))











func _cancel_plan_libre(nombre: String, pos: String) -> void:
	var claves: Array = []
	var quedan: Array = []
	for m in _ai_plan:
		var mm: Dictionary = m
		if Teams.is_free(String(mm.get("from", ""))) \
				and String(mm.get("name", "")) == nombre and String(mm.get("pos", "")) == pos:
			claves.append_array(_move_seats(mm))
			continue
		quedan.append(m)
	_ai_plan = quedan
	_plan_sin_cadena(claves)




































