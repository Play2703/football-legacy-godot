	if elegibles.is_empty() or _hay_lesion_propia_en_vivo():
		return



	if randf() >= 1.0 - pow(1.0 - SQUAD_INJURY_P * rasgo_club("lesion"),
			float(elegibles.size())):
		return
	var victima: int = elegibles[randi() % elegibles.size()]
	(meta[victima] as Dictionary)["injury_weeks"] = _roll_npc_injury_weeks()
	last_squad_injury = String(squad[victima].get("name", ""))










func _curar_plantel(meta: Array, d_calendario: float) -> void:
	var d: int = dias_de_reloj(d_calendario)
	for pm_v in meta:
		if not (pm_v is Dictionary):
			continue
		var pm: Dictionary = pm_v
		var w: int = int(pm.get("injury_weeks", 0))
		if w <= 0:
			pm.erase("injury_dias")
			continue
		var r: Dictionary = reloj_baja(w, int(pm.get("injury_dias", 0)), d)
		w -= int(r["semanas"])
		pm["injury_weeks"] = w
		if w <= 0:
			pm.erase("injury_dias")
		else:
			pm["injury_dias"] = int(r["dias"])














func _elegibles_sin_dejar_hueco(meta: Array, squad: Array, team_id: String,
		elegibles: Array[int]) -> Array[int]:
	if team_id.is_empty() or elegibles.is_empty():
		return elegibles
	var slots: Array = Squad.formation_slots(team_id).slice(0, Squad.STARTING_XI)
	var hoy: int = Rotation.huecos_sin_puesto(squad, meta, slots)
	var quedan: Array[int] = []
	for i in elegibles:
		var pm: Dictionary = meta[i]
		pm["injury_weeks"] = 1
		var si_cae: int = Rotation.huecos_sin_puesto(squad, meta, slots)
		pm["injury_weeks"] = 0
		if si_cae <= hoy:
			quedan.append(i)
	return quedan






func _roll_npc_injury_weeks() -> int:
	var r: Vector2i = banda_baja_npc(randf())
	return r.x if r.x == r.y else randi_range(r.x, r.y)






static func banda_baja_npc(u: float) -> Vector2i:
	if u < NPC_BAJA_CORTA_P:
		return Vector2i(NPC_BAJA_CORTA, NPC_BAJA_CORTA)
	u -= NPC_BAJA_CORTA_P
	if u < NPC_BAJA_TEMPORADA_P:
		return Vector2i(NPC_BAJA_TEMPORADA_MIN, NPC_BAJA_TEMPORADA_MAX)
	u -= NPC_BAJA_TEMPORADA_P
	if u < NPC_BAJA_GRAVE_P:
		return Vector2i(NPC_BAJA_GRAVE_MIN, NPC_BAJA_GRAVE_MAX)
	return Vector2i(NPC_BAJA_LARGA_MIN, NPC_BAJA_LARGA_MAX)












const NPC_BAJA_CORTA_P: float = 0.7
const NPC_BAJA_CORTA: int = 2
const NPC_BAJA_LARGA_MIN: int = 3
const NPC_BAJA_LARGA_MAX: int = 6
const NPC_BAJA_GRAVE_P: float = 0.06
const NPC_BAJA_GRAVE_MIN: int = 8
const NPC_BAJA_GRAVE_MAX: int = 15
const NPC_BAJA_TEMPORADA_P: float = 0.02
const NPC_BAJA_TEMPORADA_MIN: int = 20
const NPC_BAJA_TEMPORADA_MAX: int = 35


const BAJA_ROJA_PARTIDOS: int = 1


const BAJAS_SELLO_BASE: int = 1000




static func semanas_baja_npc(rng: RandomNumberGenerator) -> int:
	var r: Vector2i = banda_baja_npc(rng.randf())
	return r.x if r.x == r.y else rng.randi_range(r.x, r.y)





static func semilla_bajas(club: String, season: int, round_idx: int) -> int:
	return hash("bajas|%d|%s|%d|%d" % [WorldAging.world_seed(), club, season, round_idx])































func tick_bajas_liga(round_idx: int) -> void:
	var season: int = GameState.season_num
	var sello: int = season * BAJAS_SELLO_BASE + round_idx
	if sello <= bajas_sello:
		return
	bajas_sello = sello
	var mio: String = GameState.player_team_id
	var liga: Dictionary = GameState.league_table

	bajas_jornada_cerrada = {}
	for club in bajas_liga:
		var nombres: Array = []
		for a in (bajas_liga[club] as Dictionary):
			nombres.append(String(((bajas_liga[club] as Dictionary)[a] as Dictionary).get("n", "")))
		if not nombres.is_empty():
			bajas_jornada_cerrada[club] = nombres

	for club in bajas_liga.keys():
		if club == mio or not liga.has(club):
			bajas_liga.erase(club)

	var cruce: Dictionary = {}
	var sched: Array = GameState.league_schedule
	if round_idx >= 0 and round_idx < sched.size():
		for pair in (sched[round_idx] as Array):
			var pa: String = String(pair[0])
			var pb: String = String(pair[1])
			cruce[pa] = mio if pb == GameState.YOU_KEY else pb
			cruce[pb] = mio if pa == GameState.YOU_KEY else pa
	var vivas: Dictionary = _bajas_en_vivo
	_bajas_en_vivo = {}


	var hueco: int = dias_de_reloj(GameState.dias_entre_jornadas(round_idx))

	for club_v in liga:
		var club: String = String(club_v)
		if club == GameState.YOU_KEY or club == mio or club.is_empty():
			continue
		var d: Dictionary = bajas_liga.get(club, {})


		var ya: Dictionary = {}
		for a in d.keys():
			ya[int(a)] = true
			if not _descuenta_baja_rival(d[a], hueco):
				d.erase(a)
		var rng := RandomNumberGenerator.new()
		rng.seed = semilla_bajas(club, season, round_idx)
		var vs: String = String(cruce.get(club, ""))
		var suyas: Array = vivas.get(club, [])
		if suyas.is_empty():
			_sortea_baja_rival(club, d, ya, rng, vs)
		else:
			_anota_vivas_rival(club, d, suyas, rng, vs)




		for a in d.keys():
			var e: Dictionary = d[a]
			if String(e.get("k", "les")) == "les" and not e.has("d"):
				e["d"] = 0
				if not _descuenta_baja_rival(e, hueco):
					d.erase(a)
		if d.is_empty():
			bajas_liga.erase(club)
		else:
			bajas_liga[club] = d






static func _descuenta_baja_rival(e: Dictionary, hueco: int) -> bool:
	var w: int = int(e.get("w", 0))
	if String(e.get("k", "les")) == "roja":
		w -= 1
	else:
		var r: Dictionary = reloj_baja(w, int(e.get("d", BAJA_DIAS_SEMANA)), hueco)
		w -= int(r["semanas"])
		e["d"] = int(r["dias"])
	if w <= 0:
		return false
	e["w"] = w
	return true





func _sortea_baja_rival(club: String, d: Dictionary, ya: Dictionary,
		rng: RandomNumberGenerator, vs: String) -> void:
	var squad: Array = Squad.plantel_sin_once(club)
	var nombre_de: Dictionary = {}
	var elegibles: Array[int] = []
	for i in squad.size():
		var f: Dictionary = squad[i]
		if String(f.get("pos", "")) == "POR":
			continue
		var a: int = Squad.home_seat(squad, i)
		if ya.has(a):
			continue
		elegibles.append(a)
		nombre_de[a] = String(f.get("name", ""))
	if elegibles.is_empty():
		return
	elegibles.sort()
	if rng.randf() >= 1.0 - pow(1.0 - SQUAD_INJURY_P, float(elegibles.size())):
		return
	var victima: int = elegibles[rng.randi() % elegibles.size()]
	d[victima] = {"w": semanas_baja_npc(rng), "n": String(nombre_de[victima]),
		"k": "les", "vs": vs}






func _anota_vivas_rival(club: String, d: Dictionary, suyas: Array,
		rng: RandomNumberGenerator, vs: String) -> void:
	var squad: Array = Squad.plantel_sin_once(club)
	for e_v in suyas:
		var e: Dictionary = e_v
		var nombre: String = String(e.get("n", ""))
		var k: String = String(e.get("k", ""))
		for i in squad.size():
			var f: Dictionary = squad[i]
			if String(f.get("name", "")) != nombre or String(f.get("pos", "")) == "POR":
				continue
			var a: int = Squad.home_seat(squad, i)
			var w: int = semanas_baja_npc(rng) if k == "les" else BAJA_ROJA_PARTIDOS
			var prev: Dictionary = d.get(a, {})
			if int(prev.get("w", 0)) < w:
				d[a] = {"w": w, "n": nombre, "k": k, "vs": vs}
			break







func anota_baja_en_vivo(rival: String, nombre: String, kind: String) -> void:
	if rival.is_empty() or nombre.is_empty():
		return
	if String(GameState.current_fixture().get("comp", "")) != "league":
		return
	var k: String = ""
	match kind:
		"injury", "les":
			k = "les"
		"red", "roja":
			k = "roja"
	if k.is_empty():
		return
	var lista: Array = _bajas_en_vivo.get(rival, [])



	for e_v in lista:
		if e_v is Dictionary and String((e_v as Dictionary).get("n", "")) == nombre \
				and String((e_v as Dictionary).get("k", "")) == k:
			return
	lista.append({"n": nombre, "k": k})
	_bajas_en_vivo[rival] = lista







func anota_baja_propia_en_vivo(nombre: String, kind: String) -> void:
	if nombre.is_empty() or nombre == player_name:
		return
	var k: String = ""
	match kind:
		"injury", "les":
			k = "les"
		"red", "roja":
			k = "roja"
	if k.is_empty():
		return
	for e_v in _bajas_propias_en_vivo:
		if e_v is Dictionary and String((e_v as Dictionary).get("n", "")) == nombre \
				and String((e_v as Dictionary).get("k", "")) == k:
			return
	_bajas_propias_en_vivo.append({"n": nombre, "k": k})





func _hay_lesion_propia_en_vivo() -> bool:
	for e_v in _bajas_propias_en_vivo:
		if e_v is Dictionary and String((e_v as Dictionary).get("k", "")) == "les":
			return true
	return false





func _cumple_sanciones_plantel(meta: Array) -> void:
	for pm_v in meta:
		var pm: Dictionary = pm_v as Dictionary
		var s: int = int(pm.get("sancion", 0))
		if s > 0:
			pm["sancion"] = s - 1







func _vuelca_bajas_propias(meta: Array, squad: Array) -> void:
	if _bajas_propias_en_vivo.is_empty():
		return
	var mio: int = Squad.user_index(squad)
	for e_v in _bajas_propias_en_vivo:
		if not (e_v is Dictionary):
			continue
		var e: Dictionary = e_v
		for i in mini(meta.size(), squad.size()):
			if i == mio or String((squad[i] as Dictionary).get("name", "")) \
					!= String(e.get("n", "")):
				continue
			var pm: Dictionary = meta[i]
			if String(e.get("k", "")) == "les":
				pm["injury_weeks"] = maxi(int(pm.get("injury_weeks", 0)),
					_roll_npc_injury_weeks())
				pm.erase("injury_dias")
				last_squad_injury = String(e.get("n", ""))
			else:
				pm["sancion"] = maxi(int(pm.get("sancion", 0)), BAJA_ROJA_PARTIDOS)
			break
	_bajas_propias_en_vivo = []












func bajas_de(team_id: String) -> Array:
	var d: Dictionary = bajas_liga.get(team_id, {})
	if d.is_empty():
		return []
	var squad: Array = Squad.plantel_sin_once(team_id)
	var out: Array = []
	for i in squad.size():
		var e: Variant = d.get(Squad.home_seat(squad, i), null)
		if not (e is Dictionary):
			continue
		var f: Dictionary = squad[i]
		if String(f.get("name", "")) != String((e as Dictionary).get("n", "")):
			continue
		var pos: String = String(f.get("pos", "MC"))
		var dias: int = 0
		if String((e as Dictionary).get("k", "les")) == "les":
			dias = dias_baja_de(int((e as Dictionary).get("w", 0)),
				int((e as Dictionary).get("d", BAJA_DIAS_SEMANA)))
		out.append({
			"asiento": Squad.home_seat(squad, i),
			"nombre": String(f.get("name", "")),
			"semanas": int((e as Dictionary).get("w", 0)),
			"dias": dias,
			"motivo": String((e as Dictionary).get("k", "les")),
			"vs": String((e as Dictionary).get("vs", "")),
			"titular": i < Squad.STARTING_XI,
			"convocado": i < Squad.STARTING_XI + Squad.BENCH_SIZE,
			"pos": pos,
			"media": SquadMeta.media_of(f, pos),
			"dorsal": int(f.get("number", 0)),
		})
	return out




func nombres_de_baja(team_id: String) -> Array:
