func redeem_iap(pid: String) -> Dictionary:
	last_iap_receipt = {}
	var pack: Dictionary = Iap.by_product(pid)
	if pack.is_empty():
		return {}
	var recibo: Dictionary = {"dinero": 0, "puntos": 0, "xp": 0}
	var cuanto: int = int(pack.get("cuanto", 0))
	match String(pack.get("tipo", "")):
		Iap.TIPO_DINERO:
			money += cuanto
			recibo["dinero"] = cuanto
		Iap.TIPO_PUNTOS:
			recibo["xp"] = grant_skill_points(cuanto)
			recibo["puntos"] = cuanto if recibo["xp"] == 0 else 0
		Iap.TIPO_LOTE:
			_entregar_lote(pack.get("entrega", {}), recibo)
		_:


			push_error("Career: paquete de tipo desconocido (%s)" % pid)
			return {}

	var extra: int = int(pack.get("puntos_extra", 0))
	if extra > 0:
		var xp_extra: int = grant_skill_points(extra)
		recibo["xp"] = int(recibo["xp"]) + xp_extra
		if xp_extra == 0:
			recibo["puntos"] = int(recibo["puntos"]) + extra
	_save()
	Store.consumir(pid)



	last_iap_receipt = recibo
	changed.emit()
	return recibo

















static func point_cost_for(value: int) -> int:
	if value >= 90:
		return 3
	if value >= 80:
		return 2
	return 1





func point_cost(skill: String) -> int:
	return point_cost_for(int(skills.get(skill, 99)))





func spend_point(skill: String) -> bool:
	if int(skills.get(skill, SKILL_CAP)) >= skill_tope(skill):
		return false
	var cost: int = point_cost(skill)
	if skill_points < cost:
		return false
	var before: int = int(skills[skill])
	skills[skill] = before + 1
	skill_points -= cost
	_spent_stack.append(skill)
	_save()
	skill_changed.emit(skill, before, before + 1)
	changed.emit()
	return true






func can_spend_any() -> bool:
	if skill_points <= 0:
		return false
	for k in skills.keys():
		var v: int = int(skills[k])
		if v < skill_tope(String(k)) and skill_points >= point_cost_for(v):
			return true
	return false







var _spent_stack: Array[String] = []






const POS_UNDO_PREFIX: String = "pos:"


func can_undo_point() -> bool:
	return not _spent_stack.is_empty()









func undo_last_point() -> String:
	if _spent_stack.is_empty():
		return ""
	var entry: String = String(_spent_stack.pop_back())



	if entry.begins_with(POS_UNDO_PREFIX):
		return _undo_puesto(entry.substr(POS_UNDO_PREFIX.length()))
	var skill: String = entry
	var before: int = int(skills.get(skill, 0))
	skills[skill] = before - 1





	skill_points += point_cost_for(before - 1)
	_save()
	skill_changed.emit(skill, before, before - 1)
	changed.emit()
	return skill












func can_unspend_point(skill: String) -> bool:
	return _spent_stack.has(skill)



func pending_points(skill: String) -> int:
	return _spent_stack.count(skill)



func pending_count() -> int:
	return _spent_stack.size()


func unspend_point(skill: String) -> bool:
	var i: int = _spent_stack.rfind(skill)
	if i < 0:
		return false
	_spent_stack.remove_at(i)
	var before: int = int(skills.get(skill, 0))
	skills[skill] = before - 1
	skill_points += point_cost_for(before - 1)
	_save()
	skill_changed.emit(skill, before, before - 1)
	changed.emit()
	return true








func clear_spend_undo() -> void:
	_spent_stack.clear()
	if drain_skill_points() > 0:
		_save()










