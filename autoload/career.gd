func gerencia_atractivo() -> Dictionary:
	var mio: String = GameState.player_team_id
	var clave: String = "%s|%s" % [mio, _ger_memo_base()]
	if clave == _atractivo_clave:
		return _atractivo_memo
	var out: Dictionary = {"puntos": 0, "puesto": 0, "equipos": 0, "copa": "", "titulos": 0}
	if not mio.is_empty() and not Teams.is_free(mio):
		var puesto: int = Market._real_league_pos(mio)
		var equipos: int = Market._real_pos_map().size() if puesto > 0 else 0
		var pasada: Array = [0, 0]
		if GameState.season_num > 1:
			pasada = _club_puesto(mio, GameState.div_of(mio))
		if puesto <= 0:
			puesto = int(pasada[0])
			equipos = int(pasada[1])
		var copa: String = Market.club_europe(mio, GameState.season_num)
		var titulos: int = _club_titulos(mio, int(pasada[0])) if GameState.season_num > 1 else 0
		out = {"puntos": Gerencia.atractivo_puntos(puesto, equipos, copa, titulos),
			"puesto": puesto, "equipos": equipos, "copa": copa, "titulos": titulos}
	_atractivo_memo = out
	_atractivo_clave = clave
	return out













func gerencia_interes(f: Dictionary) -> float:
