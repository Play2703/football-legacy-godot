		"rival": String(club_debut.get("rival", "")),
		"age": int(club_debut.get("age", 17)),
		"since": since,
	})




















func _club_gala_close(result: Dictionary, played_club: String, played_div: int,
		lines: Array[String], played_loan: bool = false) -> void:
	_club_gala_this_season = {}
	if retired or played_club.is_empty() or Teams.by_id(played_club).is_empty():
		return






	var metas: Array = [] if played_loan else club_goals
	var veredicto: Dictionary = ClubGala.verdict(result, metas)
	var pay: Dictionary = {
		"club": played_club,
		"div": played_div,
		"suspended": bool(veredicto["suspended"]),
		"reason": String(veredicto["reason"]),
		"met": int(veredicto["met"]),
		"total": int(veredicto["total"]),
		"pos": int(result.get("league_pos", 0)),
		"teams": int(result.get("teams", 0)),
	}
	if bool(pay["suspended"]):


		lines.append(I18n.t("El club suspende sus premios del año por el mal rendimiento"))
		_club_gala_this_season = pay
		return
	var jornadas: int = maxi(2 *(int(result.get("teams", GameState.LEAGUE_SIZE)) - 1), 1)
	var picks: Dictionary = ClubGala.pick(squad_roster(), jornadas)
	if not picks.has("best"):
		return
	var pts: int = 0
	var xp: int = 0
	var prima: int = 0
	var ganadores: Array = []
	for key in ["DEF", "MED", "DEL", "best"]:
		if not picks.has(key):
			continue
		var f: Dictionary = picks[key]
		if bool(f.get("you", false)):
			var award: String = String(f["award"])



			_win(award, "%s (%.1f)" % [award.to_upper(), float(f.get("avg", 0.0))],
				lines)
			pts += award_pts_of(award)
			xp += award_xp_of(award)
			prima += award_prima_of(award)
		if key != "best":
			ganadores.append(f)
	pay["winners"] = ganadores
	pay["best"] = picks["best"]
	pay["pts"] = pts
	pay["pts_xp"] = xp

	pay["prima"] = prima



	pay["titulos"] = _club_titulos(played_club, int(pay["pos"]))
	_club_gala_this_season = pay



















const PREMIO_AFICION: String = "Premio de la Afición"
const PREMIO_AFI_APPS: int = 10
const PREMIO_AFI_IDOLO: int = 90


func _premio_aficion_close(played_club: String, lines: Array[String]) -> void:
	if retired or played_club.is_empty() or Teams.by_id(played_club).is_empty():
		return
	if season_matches < PREMIO_AFI_APPS:
		return
	var af: int = rel_eff("aficion")
	if af < TIFO_DORSAL_AFI:
		return
	if af < PREMIO_AFI_IDOLO and not fan_idol().is_empty():
		return


	_win(PREMIO_AFICION, PREMIO_AFICION.to_upper(), lines)












func _queue_league_gala(ganaste: bool, played_club: String, played_div: int,
		race_full: Array, result: Dictionary) -> void:
	var lr: Array = race_full.duplicate(true) if not race_full.is_empty() \
