		return comunicado_resuelve(accept)


	decision_abierta = {}
	var opt: Dictionary = e["a"] if accept else e["b"]


	var fx: Dictionary = _fx_de_ella(e, opt["fx"])


	fx = _fx_reincide_fx(fx)
	var risked: String = _apply_event_fx(fx, risk_roll)



	if not accept and int(e.get("veto_b", 0)) > 0:
		scene_veto[String(e["id"])] = int(e["veto_b"])
	week_event = ""


	_comunicado_siembra(true)
	_save()
	changed.emit()
	if not risked.is_empty():
		return risked





	var pila: PackedStringArray = pareja_nombre().split(" ", false)
	if accept and fx.has("pareja_start") and not pila.is_empty() \
			and String(pareja.get("estado", "")) == "saliendo":
		return I18n.tf("Empezáis a salir, {0} y tú. Si no es lo tuyo, se deja en RELACIONES y no cuesta nada.",
			[pila[0]])








	var named: Dictionary = _personalize(e)
	if not (e.get("names", []) as Array).is_empty() and not named.is_empty():
		return "%s: %s" % [String(named["title"]),
			String((named[("a" if accept else "b")] as Dictionary)
				.get("label", "")).capitalize()]
	return "%s: %s" % [I18n.t(String(e["title"])),
		I18n.t(String(opt["label"])).capitalize()]






