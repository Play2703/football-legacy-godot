func _tick_proyectos_club(_result: Dictionary, _div_jugada: int) -> void:
	var hoy: int = GameState.season_num
	var temporada: int = hoy - 1
	var mio: String = GameState.player_team_id
	var mi_pais: String = Teams.country_of(mio)

	for raw in club_projects.keys():
		var f0: Variant = club_projects[raw]
		if f0 is Array and (f0 as Array).size() >= 2 and int((f0 as Array)[1]) == hoy:
			return


	var filas: Array = []
	var resacas: Array = []
	for raw in club_projects.keys():
		var fila: Variant = club_projects[raw]
		if ClubFinance.proyecto_activo(fila, hoy) != 0:
			continue
		if fila is Array and (fila as Array).size() >= 2 \
				and int((fila as Array)[0]) == ClubFinance.PROYECTO_DUENO \
				and hoy == int((fila as Array)[1]) + ClubFinance.PROYECTO_TEMPORADAS:




			var desde: int = int((fila as Array)[1])
			if Duenos.perfil_de(str(raw), desde, WorldAging.world_seed()) == Duenos.JEQUE \
					and Duenos.resaca(str(raw), desde, WorldAging.world_seed()):
				resacas.append(str(raw))
			elif Teams.country_of(str(raw)) == mi_pais:
				var fin: Dictionary = WorldNews.fila_proyecto(temporada, GameState.season_day,
					str(raw), 0, 0)
				if not fin.is_empty():
					filas.append(fin)
		club_projects.erase(raw)





	for id in resacas:
		club_projects[id] = [ClubFinance.PROYECTO_CRISIS, hoy, Duenos.JEQUE]
		_seed_cash(id, {})
		var resaca: Dictionary = WorldNews.fila_proyecto(temporada, GameState.season_day,
			id, ClubFinance.PROYECTO_CRISIS,
			ClubFinance.proyecto_dura(ClubFinance.PROYECTO_CRISIS), Duenos.JEQUE)
		if not resaca.is_empty():
			filas.append(resaca)
	var semilla: int = WorldAging.world_seed()
	var euro: Dictionary = _euro_clubs()


	for p in Nations.PLAYABLE:
		var pais: String = str(p)
		for t in GameState.teams_in_div_jugada(pais, 1):
			var id: String = str((t as Dictionary).get("id", "")) if t is Dictionary else str(t)
			if id.is_empty() or id == GameState.YOU_KEY or id == mio:
				continue


			if club_projects.has(id) or int(GameState.last_div_moves.get(id, 0)) != 0:
				continue


			if _socios_en_camino(id):
				continue

			var rng: RandomNumberGenerator = RandomNumberGenerator.new()
			rng.seed = hash("proyecto|%d|%d|%s" % [semilla, temporada, id])


			var gigante: bool = ClubFinance.gigante(id)
			var tipo: int = proyecto_tipo(rng.randf(), ffp_racha(id) > 0,
				euro.has(id) or gigante, gigante)
			if tipo == 0:
				continue
			club_projects[id] = [tipo, hoy]
			if tipo == ClubFinance.PROYECTO_CRISIS:


				_seed_cash(id, {})


			var perfil: String = dueno_perfil(id)
			if pais != mi_pais and perfil != Duenos.JEQUE:
				continue
			var nueva: Dictionary = WorldNews.fila_proyecto(temporada, GameState.season_day,
				id, tipo, ClubFinance.proyecto_dura(tipo), perfil)
			if not nueva.is_empty():
				filas.append(nueva)
	_push_world_news(filas)























func _tick_proyecto_tuyo() -> void:


	var rescate: bool = _rescate_dueno
	_rescate_dueno = false
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty():
		return


	if club_projects.has(mio):
		return


	if _socios_en_camino(mio):
		return
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("proyecto_tuyo|%d|%d" % [WorldAging.world_seed(), GameState.season_num - 1])

	var gigante: bool = ClubFinance.gigante(mio)
	var tipo: int = proyecto_tipo(rng.randf(), ffp_racha(mio) > 0,
		_euro_clubs().has(mio) or gigante, gigante)



	if rescate:
		tipo = ClubFinance.PROYECTO_DUENO
	if tipo == 0:
		return
	club_projects[mio] = [tipo, GameState.season_num]
	var nueva: Dictionary = WorldNews.fila_proyecto(GameState.season_num - 1,
		GameState.season_day, mio, tipo, ClubFinance.proyecto_dura(tipo), dueno_perfil(mio))
	if not nueva.is_empty():
		_push_world_news([nueva])
	if tipo == ClubFinance.PROYECTO_CRISIS:

		_seed_cash(mio, {})















const PROYECTO_P_DUENO: float = 0.1
const PROYECTO_P_CRISIS: float = 0.015
const PROYECTO_P_CRISIS_APURO: float = 0.075
const PROYECTO_GIGANTE_DIV: float = 3.0







static func proyecto_tipo(r: float, avisado: bool, europa: bool, gigante: bool = false) -> int:
	var p_crisis: float = PROYECTO_P_CRISIS_APURO if avisado else PROYECTO_P_CRISIS
	if gigante:
		p_crisis /= PROYECTO_GIGANTE_DIV
	if r < p_crisis:
		return ClubFinance.PROYECTO_CRISIS
	if not europa and r < p_crisis + PROYECTO_P_DUENO:
		return ClubFinance.PROYECTO_DUENO
	return 0








func _acto_proyecto_tuyo() -> void:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty():
		return
	var f: Variant = club_projects.get(mio, null)
	if not (f is Array) or (f as Array).size() < 2 \
			or int((f as Array)[1]) != GameState.season_num:
		return
	for c in pending_ceremonies:
		var k: String = String((c as Dictionary).get("kind", ""))
		if k == Ceremonies.SALA_JUNTAS or (k == Ceremonies.CARA_A_CARA
				and int((c as Dictionary).get("proyecto", 0)) != 0):
			return
	var tipo: int = int((f as Array)[0])
	var c: Dictionary = club_cuentas()
	var ingreso: int = int(c.get("ingreso", 0))
	var payload: Dictionary = {
		"proyecto": tipo,
		"temporadas": ClubFinance.proyecto_dura(tipo),
		"ingreso": ingreso,
		"caja": int(c.get("caja", 0)),
		"raya": roundi(float(ingreso) * ClubFinance.FFP_CAJA),
	}
	if tipo == ClubFinance.PROYECTO_DUENO:


		payload["who"] = "dueno_%s_%d" % [mio, GameState.season_num]


		var perfil: String = dueno_perfil(mio)
		payload["perfil"] = perfil
		payload["ingreso_antes"] = roundi(float(ingreso) / Duenos.mult(perfil))



		queue_ceremony(Ceremonies.DUENO_PALCO, {"who": payload["who"]})

	if tipo == ClubFinance.PROYECTO_CRISIS and (f as Array).size() >= 3 \
			and str((f as Array)[2]) == Duenos.JEQUE:
		payload["resaca"] = true



	if tipo == ClubFinance.PROYECTO_CRISIS \
			and int(club_naming.get(mio, -1)) == GameState.season_num:
		payload["naming"] = naming_de(mio)


	queue_ceremony(Ceremonies.SALA_JUNTAS, payload)


	if tipo == ClubFinance.PROYECTO_CRISIS:
		queue_ceremony(Ceremonies.FOCOS_CRISIS, {})





func _aplica_crisis_de_caja() -> void:
	for raw in club_projects.keys():
		var id: String = str(raw)
		if proyecto_de(id) != ClubFinance.PROYECTO_CRISIS:
			continue
		_seed_cash(id, {})



		var ingreso: int = club_income_of(id)
		var extra: int = NombreComercial.pago(ingreso) \
				if int(club_naming.get(id, -1)) == GameState.season_num else 0
		club_cash[id] = ClubFinance.caja_en_crisis(int(club_cash.get(id, 0)) - extra,
			ingreso) + extra





func naming_de(id: String, season: int = -1) -> String:
	if not club_naming.has(id):
		return ""
	var desde: int = int(club_naming[id])
	var s: int = GameState.season_num if season < 0 else season
	if not NombreComercial.vigente(desde, s):
		return ""
	return NombreComercial.nombre(id, desde, WorldAging.world_seed())



func naming_enfado(id: String) -> bool:
	return club_naming.has(id) \
			and NombreComercial.enfado(int(club_naming[id]), GameState.season_num)








func _tick_naming() -> bool:
	var hoy: int = GameState.season_num
	for raw in club_naming.keys():
		if hoy >= int(club_naming[raw]) + NombreComercial.TEMPORADAS:
			club_naming.erase(raw)
	var seed_m: int = WorldAging.world_seed()
	var tuyo: bool = false
	var filas: Array = []
	for raw in club_projects.keys():
		var id: String = str(raw)
		var fila: Variant = club_projects[raw]
		if not (fila is Array) or (fila as Array).size() < 2 \
				or int((fila as Array)[0]) != ClubFinance.PROYECTO_CRISIS \
				or int((fila as Array)[1]) != hoy:
			continue
		if club_naming.has(id) or id == stadium_rename_club \
				or not NombreComercial.vende(id, hoy, seed_m):
			continue
		club_naming[id] = hoy
		_seed_cash(id, {})
		club_cash[id] = int(club_cash.get(id, 0)) + NombreComercial.pago(club_income_of(id))
		var noticia: Dictionary = WorldNews.fila_naming(hoy - 1, GameState.season_day, id,
			NombreComercial.nombre(id, hoy, seed_m))
		if not noticia.is_empty():
			filas.append(noticia)
		tuyo = tuyo or id == GameState.player_team_id
	_push_world_news(filas)
	return tuyo





func _acto_estadio_vendido() -> void:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or retired or not loan.is_empty():
