func gerencia_vende_coste(idx: int, nombre: String) -> int:
	var filas: Array = gerencia_mesa_plantilla()
	var medias: Array = []
	var suya: int = -1
	for r in filas:
		var row: Dictionary = r
		medias.append(int(row["ovr"]))
		if int(row["idx"]) == idx and String(row["name"]) == nombre:
			suya = int(row["ovr"])
	if suya < 0 or medias.is_empty():
		return 0
	medias.sort()
	medias.reverse()
	if suya < int(medias[mini(Gerencia.VENDE_TOP, medias.size()) - 1]):
		return 0
	var n: int = Gerencia.VENDE_TOP_EQUIPO
	if socio_v(nombre) >= SOCIO_UMBRAL:
		n += Gerencia.VENDE_TOP_SOCIO
	return n





func gerencia_intocable_coste(idx: int, nombre: String) -> int:
	if gerencia_cobro("intocable_suplente") > 0 or gerencia_es_intocable(idx, nombre) \
			or _ger_titular(nombre) or not gerencia_en_apuro():
		return 0
	return Gerencia.INTOCABLE_SUPLENTE





func gerencia_renueva_coste(idx: int, nombre: String) -> int:
	if gerencia_cobro("renueva_veterano") > 0 or gerencia_renueva_pedida(idx, nombre) \
			or _ger_titular(nombre):
		return 0
	var ctx: Dictionary = _ger_mesa_ctx()
	var casa: Array = ctx["casa"]
	if idx < 0 or idx >= casa.size() \
			or String((casa[idx] as Dictionary).get("name", "")) != nombre:
		return 0
	if int(_ger_mesa_asiento(idx, casa, ctx["meta"])["age"]) < Gerencia.RENUEVA_VETERANO_EDAD:
		return 0
	return Gerencia.RENUEVA_VETERANO





func gerencia_mesa_caja_coste() -> int:
	var s: Dictionary = gerencia_mesa_saldo()
	var total: int = int(s["base"]) + int(s["ventas"])
	if int(s["n_compras"]) == 0 or total <= 0 or gerencia_cobro("caja_vacia") > 0:
		return 0
	if float(s["queda"]) >= float(total) * Gerencia.CAJA_VACIA_FRAC:
		return 0
	return Gerencia.CAJA_VACIA





func gerencia_mesa_linea_coste() -> int:
	var linea: String = gerencia_linea()
	if linea.is_empty() or gerencia_linea_cumplida() \
			or linea != Squad.line_of(puesto_en(GameState.player_team_id)):
		return 0
	var compras: Array = gerencia_mesa_compras()
	if compras.is_empty() and gerencia_mesa_ventas().is_empty():
		return 0
	for e in compras:
		if gerencia_en_linea(e as Dictionary):
			return 0
	return Gerencia.LINEA_TUYA





func dorsal_coste(n: int) -> int:
	var dueno: Dictionary = _dorsal_dueno(n)
