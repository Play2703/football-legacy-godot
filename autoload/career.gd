		_apply_delta("prensa", float(goals) * 1.5 +(2.0 if rating >= 7.5 else 0.0))
		_apply_delta("aficion", float(goals) * 1.0 +(1.0 if result > 0 else 0.0))



		_apply_nat_match(rating, goals, result)


	pedido_tiro_resolve(pedido, true)
	last_rel_delta = _rel_delta_since(rel_before)

	_sella_prensa_escalon()








	var live: bool = live_match_open()
