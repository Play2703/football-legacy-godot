func _redecide_puesto_club(lines: Array[String]) -> void:
	var club: String = GameState.player_team_id
	if club.is_empty() or free_agent or not loan.is_empty():
		return
	var hoy: String = puesto_hoy()
	var cands: Array = [hoy]
	for p in puestos():
		if not cands.has(p):
			cands.append(p)
	if cands.size() < 2:
		return
	var muro: Dictionary = Squad.muros_once(club, true)
	var mejor: String = ""
	var mejor_m: int = 999
	for c in cands:
		var pc: String = String(c)
		if muro.has(pc) and int(muro[pc]) < mejor_m:
			mejor_m = int(muro[pc])
			mejor = pc
	var fav: String = puesto_favorito()
	if not fav.is_empty() and fav != mejor and muro.has(fav) \
			and int(muro[fav]) <= mejor_m + Squad.FAV_HOLGURA:
		mejor = fav
	if mejor.is_empty():
		return
	mejor = _puesto_dentro_del_pacto(club, mejor)
	if mejor == hoy or not fija_puesto(club, mejor):
		return
	lines.append(I18n.tf("El club te pasa a jugar de {0}.", [CareerUi.pos_rotulo(mejor)]))


