func _tick_coach_book_pase() -> void:
	for f in coach_book:
		var d: Dictionary = f
		var ahora: String = String(d.get("ahora", ""))
		if ahora == GameState.player_team_id and not coach_src.is_empty():
			continue
		if ahora.is_empty():
			if randf() < Coach.RECOLOCA_P:
				var destino: String = _club_para_tecnico(d)
				d["ahora"] = destino







				Coaches.reserva(destino, GameState.season_num)


		elif randf() < Coach.CAE_P * Coach.aguante(_nivel_de_ficha(d)):
			_fija_nombre(ahora)
			d["ahora"] = ""






func _club_para_tecnico(ficha: Dictionary) -> String:


	var rat: int = Coach.rating_de(String(ficha.get("club", "")))


	var ocupados_libro: Dictionary = {}
	for f in coach_book:
		var ah: String = String((f as Dictionary).get("ahora", ""))
		if not ah.is_empty():
			ocupados_libro[ah] = true
	for t in Teams.random_roster(8, GameState.player_team_id):
		var id: String = String((t as Dictionary).get("id", ""))
		if id.is_empty() or id == String(ficha.get("club", "")) or ocupados_libro.has(id):
			continue
		if Coach.puede_entrenar(rat, id, _nivel_de_ficha(ficha)):



			var caida: int = rat - Teams.rating(id)
			if caida >= Coach.RECOLOCA_BAJA_RATING:
				ficha["cred"] = int(ficha.get("cred", 0)) - Coach.CRED_ESCALON
			return id
	return ""











