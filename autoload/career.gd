const BAR_MIN_SEASONS: int = 5













func _maybe_bar() -> void:
	if bar_seen or retired or club_debut.is_empty():
		return
	if bool(club_debut.get("perdido", false)):
		return
	if int(club_debut.get("goals", 0)) <= 0:
		return
	var club: String = String(club_debut.get("club", ""))
