func _obj_base_target() -> int:
	return int(contract.get("obj_base_target", contract.get("obj_target", 0)))


func _obj_base_bonus() -> int:
	return int(contract.get("obj_base_bonus", contract.get("obj_bonus", 0)))




func can_negotiate_objective() -> bool:
	if free_agent or on_loan() or not pending_precontract.is_empty():
		return false
	if String(contract.get("obj_type", "")).is_empty():
		return false
	if int(contract.get("obj_talks_season", -1)) == GameState.season_num:
		return false
	return season_matches <= OBJ_TALKS_MAX_MATCHES





func objective_tiers() -> Array:
	var typ: String = String(contract.get("obj_type", "goals"))
	var base_t: int = _obj_base_target()
	var base_b: int = _obj_base_bonus()
	var teams: int = _league_teams_n()
	var out: Array = []
	for dir in [-1, 0, 1]:
		out.append({
			"dir": dir,
			"type": typ,
			"target": Market.scale_objective_target(typ, base_t, dir, teams),
			"bonus": int(round(float(base_b) * Market.OBJ_TIER_BONUS[dir + 1])),
		})
	return out





func set_objective_tier(dir: int) -> void:
	if not can_negotiate_objective():
		return
	var typ: String = String(contract.get("obj_type", "goals"))

	contract["obj_base_target"] = _obj_base_target()
	contract["obj_base_bonus"] = _obj_base_bonus()
	contract["obj_target"] = Market.scale_objective_target(typ, _obj_base_target(),
		dir, _league_teams_n())
	contract["obj_bonus"] = int(round(float(_obj_base_bonus())
		* Market.OBJ_TIER_BONUS[clampi(dir + 1, 0, 2)]))
	contract["obj_tier"] = dir
	contract["obj_talks_season"] = GameState.season_num
	_save()
	changed.emit()













const PERK_KEYS: Array[String] = ["anti_desc", "titular", "no_rival"]

const TITULAR_CLAUSE_MIN_MATCHES: int = 15



func perk() -> String:
	return String(contract.get("perk", ""))





func can_set_perk() -> bool:
	if free_agent or on_loan() or not pending_precontract.is_empty():
		return false
	return season_matches <= OBJ_TALKS_MAX_MATCHES




func set_perk(p: String) -> void:
	if not can_set_perk():
		return
	if not (p.is_empty() or PERK_KEYS.has(p)):
		return
	contract["perk"] = p
	_save()
	changed.emit()




func perk_blocks_rival(offer: Dictionary) -> bool:
	if perk() != "no_rival":
		return false
	return String(offer.get("id", "")) == Rivalries.rival_of(GameState.player_team_id)






func _apply_perk_clauses(result: Dictionary, lines: Array[String],
		on_loan_year: bool) -> void:
	if on_loan_year or free_agent or not pending_precontract.is_empty():
		return
	var p: String = perk()
	if p.is_empty():
		return
	var freed: bool = false
	if p == "anti_desc" and bool(result.get("relegated", false)):
		freed = true
		lines.append(I18n.t("CLÁUSULA ANTI-DESCENSO: el club bajó y quedas AGENTE LIBRE."))
	elif p == "titular" and season_matches < TITULAR_CLAUSE_MIN_MATCHES:
		freed = true
		lines.append(I18n.tf("PROMESA DE TITULARIDAD incumplida ({0} partidos): quedas"
			+ " AGENTE LIBRE.", [season_matches]))
	if not freed:
		return
	free_agent = true
	unsettled = false
	transfer_requested = false
	_cierra_motivo(Salida.VIA_TRASPASO, Salida.ANULADO)
