func _pareja_tension() -> void:
	if not pareja_activa():
		return
	var id: String = String(pareja.get("id", ""))
	var cal: int = PAREJA.calma_de(id)
	var b: int = int(rel["pareja"])
	if b <= cal:
		pareja.erase("tension_frac")
		return
	var acc: float = float(pareja.get("tension_frac", 0.0)) + PAREJA.tension(id, b)
	var baja: int = int(acc)
	pareja["tension_frac"] = acc - float(baja)
	rel["pareja"] = maxi(cal, b - baja)




func pareja_caida() -> bool:
	if not pareja_casada() or not pareja.has("tope"):
		return false
	return float(contract.get("wage", 0)) < PAREJA.CAZA_CAIDA * float(pareja["tope"])






func _caza_plazo() -> void:
	if retired or not pareja_casada():
		return
	var id: String = String(pareja.get("id", ""))
	if not PAREJA.arruina(id) or pending_decision == DIVORCE_EVENT_ID:
		return


	if bool(pareja.get("tasa", false)):
		if pending_decision != CAZA_EVENT_ID:
			_seed_tasacion()
		return
	var wage: int = int(contract.get("wage", 0))
	pareja["tope"] = maxi(int(pareja.get("tope", wage)), wage)
	var anios: int =(GameState.season_num - pareja_boda_season) \
			if pareja_boda_season >= 0 else pareja_anios()
	if randf() >= PAREJA.plazo_p(id, anios, pareja_caida(), pareja_prenup,
			String(pareja.get("titular", ""))):
		return
	if PAREJA.caza_compra(id, pareja_pago) >= 0.0:
		_seed_tasacion()


	elif pending_decision.is_empty():
		_seed_divorcio()











func _seed_tasacion() -> void:
	pareja["tasa"] = true
	if retired or _decision_no_caduca(pending_decision):
		return
	pending_decision = CAZA_EVENT_ID
	pending_decision_club = ""
	pending_decision_club_b = ""
	decision_cooldown = DECISION_COOLDOWN




func _decision_no_caduca(id: String) -> bool:
	return id == SHIRT_EVENT_ID or id == FORCED_SALE_EVENT_ID \
			or id == CONCURSO_SALE_EVENT_ID or id == PROJECT_EVENT_ID or id == DIVORCE_EVENT_ID or id == CAZA_EVENT_ID \
			or id == VIAJE_EVENT_ID or id == LESION_EVENT_ID \
			or id == IMPAGO_EVENT_ID or id == HUELGA_EVENT_ID or id == REBAJA_EVENT_ID or id == ASAMBLEA_EVENT_ID \
			or id == FIN_SOCIOS_EVENT_ID or id == ACCIONES_EVENT_ID \
			or id == ELECCION_EVENT_ID \
			or WeekEvents.is_forced(id)


func _check_pareja_suelo() -> void:
	if not pareja_activa():
		return
	if int(rel["pareja"]) > PAREJA_SUELO:
		return


	if not pending_decision.is_empty():
		return








	if pareja_casada():
		_seed_divorcio()
		return
	_seed_punishment("ruptura")





