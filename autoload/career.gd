func _ventana_proxima() -> Dictionary:
	var wd: int = GameState.winter_day()
	var hoy: String = Market.window_id(GameState.season_day, wd)
	if not hoy.is_empty():
		return {"id": hoy, "largo": _largo_de(hoy)}


	var dia: int = GameState.season_day
	for _i in 400:
		dia += 1
		var w: String = Market.window_id(dia, wd)
		if not w.is_empty():
			return {"id": w, "largo": _largo_de(w)}
	return {"id": Market.WINDOW_SUMMER, "largo": Market.SUMMER_DAYS}


func _largo_de(ventana: String) -> int:
	return Market.WINTER_DAYS if ventana == Market.WINDOW_WINTER else Market.SUMMER_DAYS












const CAJA_COMPAS: float = 2.6

























func gerencia_tope() -> Dictionary:
	var vivo: int = int(float(gerencia_caja()) * CAJA_COMPAS)
	var t: Dictionary = gerencia.get("tope", {})
	if not _gerencia_tope_es_de_hoy(t):
		return {"base": vivo, "ventas": 0, "gastado": 0, "total": vivo, "disponible": vivo,
			"sellado": false}
	var base: int = int(t.get("base", t.get("total", 0)))
	var ventas: int = int(t.get("ventas", 0))
	var gastado: int = int(t.get("gastado", 0))
	return {"base": base, "ventas": ventas, "gastado": gastado, "total": base + ventas,
		"disponible": maxi(base + ventas - gastado, 0), "sellado": true}


func _gerencia_tope_es_de_hoy(t: Dictionary) -> bool:
	if t.is_empty() or not gerencia_ventana_abierta():
		return false
	return int(t.get("season", -1)) == GameState.season_num \
			and String(t.get("ventana", "")) == Market.window_id(GameState.season_day,
			GameState.winter_day())






func _gerencia_tope_sella() -> void:
	if not gerencia_ventana_abierta() or _gerencia_tope_es_de_hoy(gerencia.get("tope", {})):
		return
	gerencia["tope"] = {"season": GameState.season_num,
		"ventana": Market.window_id(GameState.season_day, GameState.winter_day()),
		"base": int(float(gerencia_caja()) * CAJA_COMPAS), "ventas": 0, "gastado": 0}















func gerencia_linea() -> String:
	var l: Variant = gerencia.get("linea", {})
	if l is Dictionary and _gerencia_tope_es_de_hoy(l):
		return String((l as Dictionary).get("linea", ""))
	var linea: String = ""
	var piz: Dictionary = pizarra_de(GameState.player_team_id)
	if not piz.is_empty():
		var puestos: Array = []
		for p in Squad.home_of(GameState.player_team_id):
			puestos.append(String((p as Dictionary).get("pos", "")))
		var faltan: Array = PizarraTecnico.faltan(puestos, String(piz["objetivo"]))
		if not faltan.is_empty():
			linea = Squad.line_of(String(faltan[0]))
	if linea.is_empty():
		var hueco: Dictionary = gerencia_hueco()
		if hueco.is_empty():
			return ""
		linea = Squad.line_of(String(hueco.get("pos", "MC")))
	if gerencia_ventana_abierta():
		gerencia["linea"] = {"season": GameState.season_num,
			"ventana": Market.window_id(GameState.season_day, GameState.winter_day()),
			"linea": linea, "cumplida": false}
	return linea


func gerencia_linea_cumplida() -> bool:
	var l: Variant = gerencia.get("linea", {})
	return l is Dictionary and _gerencia_tope_es_de_hoy(l) \
			and bool((l as Dictionary).get("cumplida", false))


func gerencia_en_linea(f: Dictionary) -> bool:
	var linea: String = gerencia_linea()
	if linea.is_empty():
		return false
	var p: Dictionary = gerencia_ficha_de(f)
	if p.is_empty():
		return false
	return Squad.line_of(String(p.get("pos", "MC"))) == linea


func _gerencia_linea_cumple(f: Dictionary) -> void:
	var l: Variant = gerencia.get("linea", {})
	if not (l is Dictionary) or not _gerencia_tope_es_de_hoy(l) \
			or bool((l as Dictionary).get("cumplida", false)):
		return

	if String(f.get("pos_linea", "")) != String((l as Dictionary)["linea"]):
		return
	(l as Dictionary)["cumplida"] = true
	_apply_delta("tecnico", float(Gerencia.LINEA_REL))










