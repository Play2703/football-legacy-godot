const CRISIS_VENTA_RATIO: float = 1.0










func _administrador_vende() -> bool:
	if not concurso_tuyo() or not _calendario_abierto():
		return false
	var best_value: int = 0
	var best_wage: int = 0
	var mates: int = 0
	for row in squad_roster():
		if bool(row.get("is_you", false)):
			continue
		best_value = maxi(best_value, int(row.get("value", 0)))
		best_wage = maxi(best_wage, int(row.get("wage", 0)))
		mates += 1
	if mates == 0:
		return false
	return market_value() >= best_value or int(contract["wage"]) >= best_wage




func _forced_sale_eval(sella: bool) -> String:
	if forced_sale or for_sale or free_agent or unsettled or _market_settled:
		return ""
	if retired or not loan.is_empty():
		return ""
	if _forced_sale_season == GameState.season_num:
		return ""


	if project_seasons > 0:
		return ""




	if _administrador_vende():
		return FORCED_SALE_CONCURSO






	if club_matches < NEW_AT_CLUB_MATCHES:
		return ""
	var club: String = GameState.player_team_id
	if club.is_empty():
		return ""



	if int(contract["seasons_left"]) >= FORCED_SALE_SAFE_SEASONS \
			and GameState.season_num - _contract_signed_season <= FORCED_SALE_SAFE_AGE:
		return ""




	if _club_season_at_stake():
		return ""









	var hundida: bool = _sella_grada_hundida() if sella \
			else grada_hundida_de(rel_eff("aficion"), grada_hundida)
	var por_grada: bool = hundida \
			and club_seasons(club).size() >= GRADA_VENTA_SEASONS




	if _presidente_vende(club):
		return FORCED_SALE_CAJA

	var best_mate: int = 0
	var media_sum: float = 0.0
	var mates: int = 0
	for row in squad_roster():
		if bool(row.get("is_you", false)):
			continue
		best_mate = maxi(best_mate, int(row.get("value", 0)))
		media_sum += float(row.get("media", 0))
		mates += 1
	if mates == 0 and not por_grada:
		return ""







	var eff: int = Market.effective_rating(club, GameState.div_of(club))







	var bar: float = Market.sell_bar_mult(_forced_sale_refused,
		rel_eff("aficion"), jersey_share())





	var crecio: float = Market.club_growth(club, GameState.div_of(club))
	var por_caja: bool = mates > 0 and Market.must_sell(eff, club_income_of(club),
		market_value(), best_mate, skills_avg(), media_sum / float(mates), bar, crecio)








	var por_crisis: bool = mates > 0 \
			and proyecto_de(club) == ClubFinance.PROYECTO_CRISIS \
			and float(market_value()) >= float(best_mate) * CRISIS_VENTA_RATIO



	var por_fondo: bool = mates > 0 and _fondo_vende(club) \
			and float(market_value()) >= float(best_mate) * Duenos.FONDO_VENTA_RATIO

	if por_caja or por_crisis or por_fondo:
		return FORCED_SALE_CAJA
	return FORCED_SALE_GRADA if por_grada else ""





