func _pay_award_points(award: String) -> int:









	var fam: String = AwardPoints.family_of(award)
	var res: Array = AwardPoints.pay(award, GameState.player_div(),
		float(season_award_raw.get(fam, 0.0)), int(season_award_paid.get(fam, 0)),
		Teams.country_of(GameState.player_team_id))
