func encargo_disponible() -> bool:
	if retired or free_agent or GameState.season_close_pending:
		return false
	if injury_weeks > 0 or suspended_now():
		return false

	var fx: Dictionary = GameState.current_fixture()
	if fx.is_empty() or String(fx.get("comp", "")) == "nat":
		return false



	var st: Dictionary = standing()
	if int(st.get("minutes", 0)) > 0 or bool(st.get("rested", false)):
		return false
	if energy < ENCARGO_MIN_ENERGY:
		return false
	if int(rel["tecnico"]) >= ENCARGO_REL_TOPE:
		return false
	if encargos_temporada >= ENCARGO_MAX_TEMPORADA:
		return false

	if GameState.season_num == encargo_gastado_season \
			and GameState.season_day == encargo_gastado_day:
		return false
	return not String(encargo_hoy().get("kind", "")).is_empty()




