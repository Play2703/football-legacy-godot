		"name": String(squad_rumor.get("name", "")),
		"pos": String(squad_rumor.get("pos", "MC")),
		"media": int(squad_rumor.get("media", 0)),





		"idx": int(squad_rumor.get("idx", -1)),
		"to": String(squad_rumor.get("to", "")),
		"fee": int(squad_rumor.get("fee", 0)),
		"quedan": maxi(int(squad_rumor.get("cae", 0)) - GameState.season_day, 1),
	})














