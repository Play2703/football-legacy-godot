func _pareja_distancia() -> void:
	if not pareja_activa():
		return
	if bool(pareja.get("viaje", false)) and pending_decision != VIAJE_EVENT_ID:
		_seed_viaje()
	if not pareja_lejos():
		return
	if int(pareja.get("lejos_temp", GameState.season_num)) < GameState.season_num:
		pareja["lejos_temp"] = GameState.season_num
		if PAREJA.viene(String(pareja.get("id", "")), int(rel["pareja"])):
			_pareja_reune()
			return
	var acc: float = float(pareja.get("lejos_frac", 0.0)) + PAREJA.DISTANCIA_JORNADA
	var baja: int = int(acc)
	pareja["lejos_frac"] = acc - float(baja)
	rel["pareja"] = maxi(0, int(rel["pareja"]) - baja)







func divorcio_cuenta(frac_extra: float = 0.0) -> Dictionary:
	var frac: float = PAREJA.divorcio_de(String(pareja.get("id", ""))) + frac_extra
	if pareja_prenup:
		frac *=(1.0 - PAREJA.PRENUP_ESCUDO)
	frac = clampf(frac, 0.0, 0.9)
	var de_dinero: int = int(round(float(maxi(0, money)) * frac))
	var de_patrimonio: int = int(round(float(patrimonio_casa()) * frac))
	return {
		"frac": frac, "dinero": de_dinero, "patrimonio": de_patrimonio,
		"total": de_dinero + de_patrimonio,
	}
































func divorcio_ruina_cuenta() -> Dictionary:
	var escudo: float = PAREJA.PRENUP_ESCUDO if pareja_prenup else 0.0
	var frac: float = PAREJA.PENSION_FRAC *(1.0 - escudo)
	return {
		"prenup": pareja_prenup,
		"casa_dinero": int(round(float(patrimonio_casa()) *(1.0 - escudo))),
		"pension_frac": frac,
		"pension_cuota": int(round(float(contract.get("wage", 0)) * frac)),
		"temporadas": PAREJA.PENSION_TEMPORADAS,
		"titular": String(pareja.get("titular", "")),
		"mitad": int(round(float(maxi(0, money)) * PAREJA.TITULAR_DINERO_ELLA)),
	}




















func _vaciar_casa() -> void:
	for extra_id in house_extras.duplicate():
		_swap_fuera(String(extra_id))



	for inv in investments.duplicate():
		if bool(Shop.investment_by_id(String(inv)).get("en_casa", false)):
			investments.erase(inv)


			staff_nivel.erase(inv)
	house_level = 0
	house_extras = []
	house_finishes = []
	house_finish = {}
	house_layout = {}

	huerto = {}



	floor_paint = {}


func divorcio_ruina(elige_casa: bool) -> Dictionary:
	var c: Dictionary = divorcio_ruina_cuenta()
	var titular: String = String(c["titular"])
	var out: Dictionary = {"casa": elige_casa, "nivel": house_level,
		"prenup": bool(c["prenup"]), "dinero": 0,
		"frac": 0.0, "temporadas": 0, "cuota": 0, "titular": titular}


	if titular == PAREJA.TITULAR_MADRE:



		out["casa"] = true
		if not bool(pareja.get("la_dejas", false)):
			Achievements.ingest_ley_de_mama()
	elif titular == PAREJA.TITULAR_ELLA:


		out["casa"] = false
		money -= int(c["mitad"])
		out["dinero"] = int(c["mitad"])
	elif elige_casa:
		if bool(c["prenup"]):





			money -= int(c["casa_dinero"])
			out["dinero"] = int(c["casa_dinero"])
		else:


			_vaciar_casa()
	else:
		pareja_pension = float(c["pension_frac"])
		pareja_pension_hasta = GameState.season_num + PAREJA.PENSION_TEMPORADAS - 1
		out["frac"] = pareja_pension
		out["temporadas"] = PAREJA.PENSION_TEMPORADAS
		out["cuota"] = pension_cuota()
	romper_relacion()
	_save()
	changed.emit()
	return out























func divorcio_ahorro(frac_antes: float, frac_despues: float) -> int:
	return maxi(0, int(divorcio_cuenta(frac_antes)["total"])
		- int(divorcio_cuenta(frac_despues)["total"]))


func divorciarse(frac_extra: float = 0.0) -> Dictionary:
	var cuenta: Dictionary = divorcio_cuenta(frac_extra)
	money -= int(cuenta["total"])
	romper_relacion()
	_save()
	changed.emit()
	return cuenta





