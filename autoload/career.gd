var _tasa_memo: Dictionary = {}
var _tasa_memo_clave: String = ""

func _ger_mesa_tasa(seat: Dictionary, casa: Array) -> int:
	var mio: String = GameState.player_team_id
	var base: String = "%s|%s|%d" % [mio, _ger_memo_base(), Squad.cache_version()]
	if base != _tasa_memo_clave:
		_tasa_memo.clear()
		_tasa_memo_clave = base
	var k: String = "%d|%s" % [int(seat["idx"]), String(seat["name"])]
	if _tasa_memo.has(k):
		return int(_tasa_memo[k])
	var pos: String = String(seat["pos"])
	var contrato: int = int(seat["contract"])
	var fee: float = float(SquadMeta.fee_of(AiMarket._seat_value(seat), contrato)) \
			* AiMarket.star_fee_mult(int(seat["media"]), pos, Teams.rating(mio))
	if contrato <= AiMarket.BOSMAN_CONTRACT:
		fee *= AiMarket.BOSMAN_WINTER_DISCOUNT if _ger_mesa_invierno() \
				else AiMarket.BOSMAN_DISCOUNT


	var h: int = int(seat["idx"])
	var b: int = _libro_idx(mio, h, {})
	var etapas: Array = TransferBook.trayectoria_de(mio, b, pos, GameState.season_num) \
			if b >= 0 else TransferBook.sanea_carrera((casa[h] as Dictionary).get("carrera", null))
	fee *= float(Market.trayectoria_mult(etapas)["mult"])
	var tasa: int = maxi(int(fee), 0)
	_tasa_memo[k] = tasa
	return tasa









var _mesa_compradores_memo: Dictionary = {}
var _mesa_compradores_clave: String = ""

func _ger_mesa_compradores() -> Dictionary:
	var mio: String = GameState.player_team_id
	var clave: String = "%s|%d|%d|%d" % [mio, GameState.season_num, GameState.season_day,
		Squad.cache_version()]
	if clave == _mesa_compradores_clave:
		return _mesa_compradores_memo
	var out: Dictionary = {}
	var invierno: bool = _ger_mesa_invierno()
	var cedidos: Dictionary = _cedidos_en_casa()
	for id in _ai_scope():
		var cid: String = String(id)
		if cid == mio or Teams.is_free(cid):
			continue
		var casa: Array = Squad.home_of(cid)
		var rating: int = Teams.rating(cid)
		var seats: Array = []
		var por_pos: Dictionary = {}
		for h in casa.size():
			var p: Dictionary = casa[h]
			var pos: String = String(p.get("pos", "MC"))
			var media: int = SquadMeta.media_of(p, pos)
			seats.append({"media": media, "pos": pos})
			if cedidos.has("%s#%d" % [cid, h]):
				continue
			if not por_pos.has(pos):
				por_pos[pos] = []
			(por_pos[pos] as Array).append([h, media])
		for k in por_pos:
			(por_pos[k] as Array).sort_custom(func(a: Array, b: Array) -> bool:
				return int(a[1]) < int(b[1]))
		var inc: int = club_income_of(cid)
		var cash: int = int(club_cash.get(cid, ClubFinance.starting_cash(inc)))
		var bill: int = ClubFinance.wage_bill(seats, float(Squad.club_level(rating)))
		var caja: int = ClubFinance.window_budget(cash, inc, invierno,
			ClubFinance.distress_amount(cash, bill, inc))
		if caja <= 0:
			continue
		out[cid] = {"rating": rating, "caja": caja, "pos": por_pos}
	_mesa_compradores_memo = out
	_mesa_compradores_clave = clave
	return out











var _mesa_hay_comprador_memo: Dictionary = {}
var _mesa_hay_comprador_clave: String = ""

func _ger_mesa_hay_comprador(pos: String, media: int, edad: int, fee: int) -> bool:

	_ger_mesa_compradores()
	if _mesa_hay_comprador_clave != _mesa_compradores_clave:
		_mesa_hay_comprador_memo.clear()
		_mesa_hay_comprador_clave = _mesa_compradores_clave
	var k: String = "%s|%d|%d|%d" % [pos, media, edad, fee]
	if not _mesa_hay_comprador_memo.has(k):
		_mesa_hay_comprador_memo[k] = not _ger_mesa_pujas(pos, media, edad, fee, "",
			{}, {}).is_empty()
	return bool(_mesa_hay_comprador_memo[k])
















func _ger_mesa_pujas(pos: String, media: int, edad: int, tasa: int, nombre: String,
		excluye: Dictionary, ocupados: Dictionary) -> Array:


	if edad + 1 > AiMarket.MAX_BUY_AGE:
		return []
	var out: Array = []
	var piso: int = int(float(tasa) * Gerencia.OFERTA_PISO)
	var horquilla: float = float(maxi(AiMarket.FREE_LEVEL_BELOW, AiMarket.FREE_LEVEL_ABOVE) + 1)
	var clubes: Dictionary = _ger_mesa_compradores()
	for id in clubes:
		var cid: String = String(id)
		var c: Dictionary = clubes[cid]
		var caja: int = int(c["caja"])
		if excluye.has(cid) or caja < piso:
			continue
		var gap: int = media - AiMarket.pos_bar(int(c["rating"]), pos)
		if gap < - AiMarket.FREE_LEVEL_BELOW or gap > AiMarket.FREE_LEVEL_ABOVE:
			continue
		var hueco: int = -1
		for par in ((c["pos"] as Dictionary).get(pos, []) as Array):
			if ocupados.has("%s#%d" % [cid, int(par[0])]):
				continue


			if media >= int(par[1]) + AiMarket.FREE_BENCH_UPGRADE:
				hueco = int(par[0])
			break
		if hueco < 0:
			continue
		var encaje: float = 1.0 - float(absi(gap)) / horquilla
		var riqueza: float =(float(caja) / float(maxi(tasa, 1)) - 1.0) / 3.0
		var ruido: float = 0.0
		if not nombre.is_empty():
			ruido = float(posmod(hash("puja|%s|%s|%d" % [cid, nombre, GameState.season_num]),
				2001)) / 1000.0 - 1.0
		var fee: int = mini(int(float(tasa) * Gerencia.oferta_mult(encaje, riqueza, ruido)), caja)
		out.append({"id": cid, "h": hueco, "rating": int(c["rating"]), "fee": maxi(fee, 0),
			"encaje": encaje})
	out.sort_custom(func(x: Dictionary, y: Dictionary) -> bool:
		if not is_equal_approx(float(x["encaje"]), float(y["encaje"])):
			return float(x["encaje"]) > float(y["encaje"])
		if int(x["rating"]) != int(y["rating"]):
			return int(x["rating"]) > int(y["rating"])
		return String(x["id"]) < String(y["id"]))
	return out.slice(0, Gerencia.OFERTAS_MAX)




func _ger_mesa_ocupados() -> Dictionary:
	var ocupados: Dictionary = {}
	for e in gerencia_mesa_compras():
		var f: Dictionary = e
		var club_f: String = String(f.get("club", ""))
		if Teams.is_free(club_f):
			continue
		var sq_f: Array = Squad.of(club_f)
		var i_f: int = int(f.get("seat", -1))
		if i_f >= 0 and i_f < sq_f.size():
			ocupados["%s#%d" % [club_f, Squad.home_seat(sq_f, i_f)]] = true
	return ocupados








func gerencia_mesa_ofertas(idx: int, nombre: String) -> Array:
	var entrada: Dictionary = {}
	var otros: Dictionary = {}
	for v in gerencia_mesa_ventas():
		var d: Dictionary = v
		if int(d["idx"]) == idx and String(d["name"]) == nombre:
			entrada = d
		elif not String(d["club"]).is_empty():
			otros[String(d["club"])] = true
	if entrada.is_empty():
		return []
	var ctx: Dictionary = _ger_mesa_ctx()
	var casa: Array = ctx["casa"]
	var seat: Dictionary = _ger_mesa_asiento(idx, casa, ctx["meta"])
	var tasa: int = _ger_mesa_tasa(seat, casa)
	var pujas: Array = _ger_mesa_pujas(String(seat["pos"]), int(seat["media"]),
		int(seat["age"]), tasa, nombre, otros, _ger_mesa_ocupados())
	var tratos: Dictionary = entrada["tratos"]
	var llegadas: int = 1 + maxi(GameState.season_day - int(entrada["dia"]), 0) \
			/ maxi(Gerencia.OFERTA_CADA, 1)
	var aceptada: String = String(entrada["club"])
	var out: Array = []
	for i in pujas.size():
		var pj: Dictionary = pujas[i]
		var cid: String = String(pj["id"])
		if i >= llegadas and cid != aceptada:
			continue
		var t: Dictionary = tratos.get(cid, {})
		if bool(t.get("fuera", false)):
			continue
		var fee: int = int(float(pj["fee"]) *(1.0 + float(t.get("sube", 0.0))))
		if cid == aceptada:
			fee = int(entrada["fee"])
		var n: int = int(t.get("n", 0))
		out.append({"club": cid, "h": int(pj["h"]), "fee": fee,
			"pct": roundi(float(fee) * 100.0 / float(maxi(tasa, 1))), "n": n,
			"puede_pedir": n < Gerencia.PIDE_MAS_MAX and aceptada.is_empty(),
			"aceptada": cid == aceptada})
	out.sort_custom(func(x: Dictionary, y: Dictionary) -> bool:
		return int(x["fee"]) > int(y["fee"]))
	return out



func gerencia_mesa_ofertas_por_llegar(idx: int, nombre: String) -> int:
	var hoy: int = gerencia_mesa_ofertas(idx, nombre).size()
	var ctx: Dictionary = _ger_mesa_ctx()
	var casa: Array = ctx["casa"]
	if idx < 0 or idx >= casa.size():
		return 0
	var seat: Dictionary = _ger_mesa_asiento(idx, casa, ctx["meta"])
	var otros: Dictionary = {}
	var fuera: int = 0
	for v in gerencia_mesa_ventas():
		var d: Dictionary = v
		if int(d["idx"]) == idx and String(d["name"]) == nombre:
			for k in (d["tratos"] as Dictionary):
				if bool(((d["tratos"] as Dictionary)[k] as Dictionary).get("fuera", false)):
					fuera += 1
		elif not String(d["club"]).is_empty():
			otros[String(d["club"])] = true
	var todas: int = _ger_mesa_pujas(String(seat["pos"]), int(seat["media"]), int(seat["age"]),
		_ger_mesa_tasa(seat, casa), nombre, otros, _ger_mesa_ocupados()).size()
	return maxi(todas - fuera - hoy, 0)





func gerencia_mesa_acepta(idx: int, nombre: String, club: String) -> String:
	if not gerencia_mesa_abierta():
		return "cerrada"
	var vivas: Array = gerencia_mesa_ventas()
	var i: int = -1
	for j in vivas.size():
		if int(vivas[j]["idx"]) == idx and String(vivas[j]["name"]) == nombre:
			i = j
	if i < 0:
		return "no_venta"
	var e: Dictionary = vivas[i]
	if String(e["club"]) == club:
		e["club"] = ""
		e["fee"] = 0
	else:
		var oferta: Dictionary = {}
		for o in gerencia_mesa_ofertas(idx, nombre):
			if String(o["club"]) == club:
				oferta = o
		if oferta.is_empty():
			return "oferta"
		e["club"] = club
		e["fee"] = int(oferta["fee"])
	var m: Dictionary = _ger_mesa().duplicate(true)
	m["ventas"] = vivas
	_ger_mesa_guarda(m)
	return ""





func gerencia_mesa_pide_mas(idx: int, nombre: String, club: String) -> String:
	if not gerencia_mesa_abierta():
		return "cerrada"
	var oferta: Dictionary = {}
	for o in gerencia_mesa_ofertas(idx, nombre):
		if String(o["club"]) == club:
			oferta = o
	if oferta.is_empty():
		return "oferta" if gerencia_mesa_vendo(idx, nombre) else "no_venta"
	var vivas: Array = gerencia_mesa_ventas()
	var e: Dictionary = {}
	for v in vivas:
		if int(v["idx"]) == idx and String(v["name"]) == nombre:
			e = v
	if not String(e["club"]).is_empty():
		return "aceptada"
	var n: int = int(oferta["n"])
	if n >= Gerencia.PIDE_MAS_MAX:
		return "max"
	var t: Dictionary =((e["tratos"] as Dictionary).get(club, {}) as Dictionary).duplicate()
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("pide_mas|%s|%s|%d|%s|%s|%d" % [GameState.player_team_id,
		Market.window_id(GameState.season_day, GameState.winter_day()), GameState.season_num,
		nombre, club, n])
	var r: float = rng.randf()
	var p_sube: float = Gerencia.PIDE_MAS_SUBE[mini(n, Gerencia.PIDE_MAS_SUBE.size() - 1)]
	var res: String = "no"
	if r < p_sube:
		res = "sube"
		t["sube"] =(1.0 + float(t.get("sube", 0.0))) \
				*(1.0 + rng.randf_range(Gerencia.PIDE_MAS_MIN, Gerencia.PIDE_MAS_TOP)) - 1.0
	elif r < p_sube + Gerencia.PIDE_MAS_FUERA:
		res = "fuera"
		t["fuera"] = true
	t["n"] = n + 1
	(e["tratos"] as Dictionary)[club] = t
	var m: Dictionary = _ger_mesa().duplicate(true)
	m["ventas"] = vivas
	_ger_mesa_guarda(m)
	return res







var _mesa_reparto_memo: Array = []
var _mesa_reparto_clave: String = ""

func _ger_mesa_reparto() -> Array:
	var mio: String = GameState.player_team_id
	var clave: String = "%s|%s|%d|%d" % [mio, _ger_memo_base(), Squad.cache_version(),
		_ger_mesa_ver]
	if clave == _mesa_reparto_clave:
		return _mesa_reparto_memo
	var out: Array = []
	var ventas: Array = gerencia_mesa_aceptadas()
	if not ventas.is_empty():
		var ctx: Dictionary = _ger_mesa_ctx()
		var casa: Array = ctx["casa"]
		for v in ventas:
			var h: int = int(v["idx"])
			var club: String = String(v["club"])
			var seat: Dictionary = _ger_mesa_asiento(h, casa, ctx["meta"])
			var b_h: int = -1
			for o in gerencia_mesa_ofertas(h, String(v["name"])):
				if String(o["club"]) == club:
					b_h = int(o["h"])
			out.append({"idx": h, "name": String(seat["name"]), "pos": String(seat["pos"]),
				"media": int(seat["media"]), "ovr": int(seat["ovr"]), "age": int(seat["age"]),
				"fee": int(v["fee"]), "club": club if b_h >= 0 else "", "h": b_h})
	_mesa_reparto_memo = out
	_mesa_reparto_clave = clave
	return out

















func _ger_mesa_no_vende(idx: int, nombre: String, ctx: Dictionary, tasa: int = -1) -> String:
	var mio: String = GameState.player_team_id
	var casa: Array = ctx["casa"]
	if idx < 0 or idx >= casa.size() \
			or String((casa[idx] as Dictionary).get("name", "")) != nombre:
		return "ido"
	if idx == int(ctx["yo"]):
		return "tu"
	if peldano() < Gerencia.PELDANO_MESA:
		return "nivel"
	if (ctx["cedidos"] as Dictionary).has("%s#%d" % [mio, idx]):
		return "cedido"
	var seat: Dictionary = _ger_mesa_asiento(idx, casa, ctx["meta"])
	if int(seat["signed"]) >= GameState.season_num:
		return "nuevo"
	var pos: String = String(seat["pos"])
	if SquadEdits.PROTECTED_POS.has(pos):
		var vendidos: Dictionary = {}
		for v in gerencia_mesa_ventas():
			vendidos[int(v["idx"])] = true
		var quedan: int = 0
		for h in casa.size():
			if h != idx and not vendidos.has(h) \
					and String((casa[h] as Dictionary).get("pos", "")) == pos:
				quedan += 1
		if quedan == 0:
			return "puesto"
	if not _ger_mesa_hay_comprador(pos, int(seat["media"]), int(seat["age"]),
			tasa if tasa >= 0 else _ger_mesa_tasa(seat, casa)):
		return "comprador"
	return ""





func gerencia_mesa_vende(idx: int, nombre: String) -> String:
	if not gerencia_mesa_abierta():
		return "cerrada"
	var m: Dictionary = _ger_mesa().duplicate(true)
	var vivas: Array = gerencia_mesa_ventas()
	for i in vivas.size():
		if int(vivas[i]["idx"]) == idx and String(vivas[i]["name"]) == nombre:
			vivas.remove_at(i)
			m["ventas"] = vivas
			_ger_mesa_guarda(m)
			return ""
	var causa: String = _ger_mesa_no_vende(idx, nombre, _ger_mesa_ctx())
	if not causa.is_empty():
		return causa
	vivas.append({"idx": idx, "name": nombre, "dia": GameState.season_day, "club": "",
		"fee": 0, "tratos": {}})
	m["ventas"] = vivas

	if gerencia_es_intocable(idx, nombre):
		gerencia.erase("intocable")
	_ger_mesa_guarda(m)
	return ""








var _mesa_plantilla_memo: Array = []
var _mesa_plantilla_clave: String = ""

func gerencia_mesa_plantilla() -> Array:
	var mio: String = GameState.player_team_id
	var clave: String = "%s|%s|%d|%d" % [mio, _ger_memo_base(), Squad.cache_version(),
		_ger_mesa_ver]
	if clave == _mesa_plantilla_clave:
		return _mesa_plantilla_memo
	var out: Array = []
	if not mio.is_empty():
		var ctx: Dictionary = _ger_mesa_ctx()
		var casa: Array = ctx["casa"]
		var destino: Dictionary = {}
		for r in _ger_mesa_reparto():
			destino[int(r["idx"])] = r
		var en_venta: Dictionary = {}
		for v in gerencia_mesa_ventas():
			en_venta[int(v["idx"])] = true
		for h in casa.size():
			if h == int(ctx["yo"]):
				continue
			var seat: Dictionary = _ger_mesa_asiento(h, casa, ctx["meta"])
			var vendo: bool = en_venta.has(h)


			var fee: int = _ger_mesa_tasa(seat, casa)
			var causa: String = ""
			var n_of: int = 0
			var mejor: int = 0
			var club: String = ""
			var cobra: int = 0
			if vendo:
				var ofs: Array = gerencia_mesa_ofertas(h, String(seat["name"]))
				n_of = ofs.size()
				if n_of > 0:
					mejor = int(ofs[0]["fee"])
				var rep_h: Dictionary = destino.get(h, {})
				club = String(rep_h.get("club", ""))
				cobra = int(rep_h.get("fee", 0)) if not club.is_empty() else 0
				if n_of == 0 or (not rep_h.is_empty() and club.is_empty()):
					causa = "comprador"
			else:
				causa = _ger_mesa_no_vende(h, String(seat["name"]), ctx, fee)
			out.append({"idx": h, "name": String(seat["name"]), "pos": String(seat["pos"]),
				"ovr": int(seat["ovr"]), "edad": int(seat["age"]),
				"fee": fee, "causa": causa, "vendo": vendo, "club": club,
				"ofertas": n_of, "mejor": mejor, "cobra": cobra})
	_mesa_plantilla_memo = out
	_mesa_plantilla_clave = clave
	return out







func gerencia_mesa_compras() -> Array:
	return _ger_mesa().get("compras", []) as Array




func _ger_mesa_compra_i(compras: Array, fila: Dictionary) -> int:
	var club: String = String(fila.get("club", ""))
	var nombre: String = String(fila.get("name", ""))
	for i in compras.size():
		var f: Dictionary = compras[i]
		if String(f.get("club", "")) == club and String(f.get("name", "")) == nombre:
			return i
	return -1


func gerencia_mesa_compro(fila: Dictionary) -> bool:
	return _ger_mesa_compra_i(gerencia_mesa_compras(), fila) >= 0










func gerencia_mesa_no_compra(f: Dictionary) -> String:
	if not gerencia_mesa_abierta():
		return "cerrada"
	return _ger_mesa_no_compra_f(f)




func _ger_mesa_no_compra_f(f: Dictionary) -> String:
	if concurso_tuyo():
		return "concurso"
	if String(f.get("club", "")) == GameState.player_team_id:
		return "tuyo"
	if _ger_mesa_no().has(_ger_mesa_no_clave(f)):
		return "club_no"
	var causa: String = _reco_causa(f)
	if not causa.is_empty():
		return causa
	if gerencia_interes(f) < Gerencia.INTERES_MIN:
		return "interes"
	return ""






func gerencia_mesa_compra(fila: Dictionary) -> String:
	if not gerencia_mesa_abierta():
		return "cerrada"
	var m: Dictionary = _ger_mesa().duplicate(true)
	var compras: Array = m["compras"]
	var i: int = _ger_mesa_compra_i(compras, fila)
	if i >= 0:
		compras.remove_at(i)
		_ger_mesa_guarda(m)
		return ""
	var f: Dictionary = {"club": String(fila.get("club", "")),
		"seat": int(fila.get("seat", -1)), "name": String(fila.get("name", "")),
		"pos": String(fila.get("pos", "")), "ovr": int(fila.get("ovr", 0))}
	var causa: String = _ger_mesa_no_compra_f(f)
	if not causa.is_empty():
		return causa
	compras.append(f)
	_ger_mesa_guarda(m)
	return ""




func gerencia_edad(f: Dictionary) -> int:
	if _reco_precio_base(f) < 0:
		return -1
	var mk: String = _precio_clave(String(f.get("club", "")), int(f.get("seat", -1)),
		String(f.get("name", "")))
	return int((_precio_memo.get(mk, {}) as Dictionary).get("edad", -1))



















func gerencia_mesa_saldo() -> Dictionary:
	var mio: String = GameState.player_team_id
	var tope: Dictionary = gerencia_tope()
	var base: int = int(tope["disponible"])
	var ventas: int = 0
	var n_v: int = 0
	for r in _ger_mesa_reparto():
		if String((r as Dictionary)["club"]).is_empty():
			continue
		ventas += int(r["fee"])
		n_v += 1
	var compras: int = 0
	var n_c: int = 0
	for e in gerencia_mesa_compras():
		var f: Dictionary = e
		if not _ger_mesa_no_compra_f(f).is_empty():
			continue
		compras += gerencia_precio(f)
		n_c += 1

	var hoy: int = Squad.home_of(mio, true).size() if not mio.is_empty() else 0
	var final: int = hoy - n_v + n_c
	var queda: int = base + ventas - compras
	var falla: String = ""
	if not gerencia_mesa_abierta():
		falla = "cerrada"
	elif n_v + n_c == 0:
		falla = "vacia"
	elif queda < 0:
		falla = "caja"
	elif n_c > 0 and final > Gerencia.PLANTILLA_MAX:
		falla = "plantilla_max"
	elif n_v > 0 and final < Gerencia.PLANTILLA_MIN:
		falla = "plantilla_min"
	return {"base": base, "ventas": ventas, "compras": compras, "queda": queda,
		"plantilla": final, "hoy": hoy, "min": Gerencia.PLANTILLA_MIN,
		"max": Gerencia.PLANTILLA_MAX, "n_ventas": n_v, "n_compras": n_c,
		"sellado": bool(tope["sellado"]), "ok": falla.is_empty(), "falla": falla}
































var _mesa_pool_memo: Array = []
var _mesa_pool_clave: String = ""

func _ger_mesa_candidatos() -> Array:
	var mio: String = GameState.player_team_id


	var once: Array = _gerencia_once_asientos() if not mio.is_empty() else []
	var clave: String = "%s|%d|%d|%d|%d|%d" % [mio, GameState.season_num,
		GameState.season_day, Squad.cache_version(), free_agents.size(), once.hash()]
	if clave == _mesa_pool_clave:
		return _mesa_pool_memo
	var out: Array = []
	if not once.is_empty():

		var techo: int = Gerencia.interes_techo(gerencia_once_media()
			+ int(gerencia_atractivo()["puntos"]))
		var peor: int = 1<<30
		for a in once:
			peor = mini(peor, int((a as Dictionary)["ovr"]))
		var piso: int = peor - Gerencia.interes_piso_margen()
		var filas: Array = []
		var cedidos: Dictionary = _cedidos_en_casa()
		var exes: Dictionary = {}
		for c in Legends._pasaron_candidatos(mio):
			exes["%s#%d" % [String((c as Dictionary)["team"]), int((c as Dictionary)["idx"])]] = true
		for id in _ai_scope():
			var cid: String = String(id)
			if cid == mio or Teams.is_free(cid):
				continue
			var sq: Array = Squad.of(cid)
			for i in sq.size():
				var p: Dictionary = sq[i]
				var pos: String = String(p.get("pos", "MC"))
				var ovr: int = SquadMeta.ovr_of(p, pos)
				if ovr > techo:
					continue
				var h: int = Squad.home_seat(sq, i)
				if ovr < piso and not exes.has("%s#%d" % [cid, h]):
					continue


				if cedidos.has("%s#%d" % [cid, h]):
					continue
				filas.append({"club": cid, "seat": i, "name": String(p.get("name", "")),
					"pos": pos, "ovr": ovr})
		for fa in free_agents:
			if not (fa is Dictionary):
				continue
			var pos_l: String = String((fa as Dictionary).get("pos", "MC"))
			var ident: Dictionary = AiMarket._free_identity(fa, GameState.season_num)
			ident["pos"] = pos_l
			var ovr_l: int = SquadMeta.ovr_of(ident, pos_l)
			if ovr_l > techo:
				continue
			if ovr_l < piso and not TransferBook.jugo_en(
					TransferBook.sanea_carrera((fa as Dictionary).get("carrera", null)), mio):
				continue
			var nombre_l: String = String((fa as Dictionary).get("name", ""))
			filas.append({"club": Teams.FREE_ID, "seat": libre_seat(nombre_l, pos_l),
				"name": nombre_l, "pos": pos_l, "ovr": ovr_l})



		var orden: PackedInt64Array = PackedInt64Array()
		for k in filas.size():
			var fk: Dictionary = filas[k]
			orden.append((clampi(99 - int(fk["ovr"]), 0, 127)<<48) \
					|((hash("%s|%d" % [String(fk["name"]), GameState.season_num])&268435455)<<20) \
					|k)
		orden.sort()
		var aceptados: Dictionary = {}
		var evaluados: Dictionary = {}
		var total: int = 0
		_meta_viva_lote = {}
		for key in orden:
			if total >= Gerencia.MESA_EVALUA_MAX:
				break
			var f: Dictionary = filas[key&1048575]
			var estrato: String = "%s|%d" % [Squad.line_of(String(f["pos"])), int(f["ovr"])]
			if int(aceptados.get(estrato, 0)) >= Gerencia.MESA_POR_NIVEL \
					or int(evaluados.get(estrato, 0)) >= Gerencia.MESA_EVALUA_NIVEL:
				continue
			evaluados[estrato] = int(evaluados.get(estrato, 0)) + 1
			total += 1
			var interes: float = gerencia_interes(f)
			if interes < Gerencia.INTERES_MIN:
				continue
			var precio: int = _reco_precio(f)
			if precio < 0:
				continue
			aceptados[estrato] = int(aceptados.get(estrato, 0)) + 1
			f["precio"] = precio
			f["interes"] = interes
			f["ex"] = gerencia_ex(f)
			f["edad"] = gerencia_edad(f)
			out.append(f)
		_meta_viva_lote = null
	_mesa_pool_memo = out
	_mesa_pool_clave = clave
	return out







func gerencia_interesados(linea: String = "", solo_caben: bool = false) -> Array:
	var out: Array = []
	var queda: int = int(gerencia_mesa_saldo()["queda"]) if solo_caben else 0
	for e in _ger_mesa_candidatos():
		if out.size() >= Gerencia.MESA_LISTA_MAX:
			break
		var f: Dictionary = e
		if not linea.is_empty() and Squad.line_of(String(f["pos"])) != linea:
			continue
		var compro: bool = gerencia_mesa_compro(f)
		if solo_caben and not compro and int(f["precio"]) > queda:
			continue
		var fila: Dictionary = f.duplicate()
		fila["compro"] = compro
		out.append(fila)
	return out
















func gerencia_mesa_cierra() -> Dictionary:
	var res: Dictionary = {"vendidos": [], "fichados": [], "fallan": []}
	var saldo: Dictionary = gerencia_mesa_saldo()
	if not bool(saldo["ok"]):
		res["falla"] = String(saldo["falla"])
		return res
	var mio: String = GameState.player_team_id
	var season: int = GameState.season_num
	var reparto: Array = _ger_mesa_reparto().duplicate(true)



	var siguen: Array = gerencia_mesa_ventas().filter(func(v: Variant) -> bool:
		return String((v as Dictionary)["club"]).is_empty())



	var cuesta_venta: Dictionary = {}
	for r in reparto:
		cuesta_venta[String(r["name"])] = gerencia_vende_coste(int(r["idx"]), String(r["name"]))
	var cuesta_caja: int = gerencia_mesa_caja_coste()
	var cuesta_linea: int = gerencia_mesa_linea_coste()









	var compras: Array = []
	for e in gerencia_mesa_compras():
		var f: Dictionary =(e as Dictionary).duplicate()
		var causa0: String = _ger_mesa_no_compra_f(f)
		if not causa0.is_empty():
			(res["fallan"] as Array).append({"name": String(f.get("name", "")),
				"causa": causa0})
			continue






		if peldano() < Gerencia.PELDANO_MESA:
			var rng_voz: RandomNumberGenerator = RandomNumberGenerator.new()
			rng_voz.seed = hash("mesa_voz|%s|%s|%d|%s|%s" % [mio,
				Market.window_id(GameState.season_day, GameState.winter_day()), season,
				String(f.get("club", "")), String(f.get("name", ""))])
			if rng_voz.randf() >= Gerencia.prob_relacion(gerencia_relacion()):
				_ger_mesa_no_apunta(f)
				(res["fallan"] as Array).append({"name": String(f.get("name", "")),
					"causa": "club_no"})
				continue
		compras.append({"f": f, "p": gerencia_precio(f), "ex": gerencia_ex(f)})
	_gerencia_tope_sella()


	reparto.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a["idx"]) > int(b["idx"]))
	for r in reparto:
		var v: Dictionary = r
		var nombre: String = String(v["name"])
		var b_id: String = String(v["club"])
		if b_id.is_empty():
			(res["fallan"] as Array).append({"name": nombre, "causa": "comprador"})
			continue
		var h: int = int(v["idx"])
		squad_meta_of(mio)
		var casa: Array = Squad.home_of(mio)
		var n: int = Squad.home_of(mio, true).size()
		if h >= casa.size() or String((casa[h] as Dictionary).get("name", "")) != nombre:
			(res["fallan"] as Array).append({"name": nombre, "causa": "ido"})
			continue
		if n <= RosterDelta.MIN_SEATS:
			(res["fallan"] as Array).append({"name": nombre, "causa": "plantilla"})
			continue
		var seat: Dictionary = _ger_mesa_asiento(h, casa, squad_meta.get(mio, []))
		var fee: int = int(v["fee"])
		var b_h: int = int(v["h"])
		var rng: RandomNumberGenerator = RandomNumberGenerator.new()
		rng.seed = hash("mesa_venta|%s|%d|%d" % [mio, h, season])
		var mv: Dictionary = {"kind": "signing", "to": b_id, "to_idx": b_h,
			"from": mio, "from_idx": h, "pos": String(seat["pos"]), "name": nombre,
			"media": int(seat["media"]), "age": int(seat["age"]), "fee": fee,
			"free": false, "forced": true, "mesa": true,
			"identity": AiMarket._identity(seat, season,
				rng.randi_range(AiMarket.SIGNED_CONTRACT_MIN, AiMarket.SIGNED_CONTRACT_MAX))}



		_plan_sin_cadena(["%s#%d" % [b_id, b_h], "%s#%d" % [mio, h]])
		_apply_ai_moves([mv])
		_gerencia_suelta(mio, h, n)
		_gerencia_tope_ingresa(fee)
		_rel_golpe("equipo", int(cuesta_venta.get(nombre, 0)))
		Telemetry.count("mesa_venta")

		(res["vendidos"] as Array).append({"name": nombre, "club": b_id, "fee": fee,
			"pos": String(seat["pos"]), "ovr": int(seat["ovr"])})



	var hubo_acto: bool = false
	compras.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if (int(a["ex"]) > 0) !=(int(b["ex"]) > 0):
			return int(a["ex"]) > 0
		return int(a["p"]) > int(b["p"]))
	for c in compras:
		var f: Dictionary = c["f"]
		var p: int = int(c["p"])
		var nombre_c: String = String(f.get("name", ""))



		_ger_memo_invalida()
		if _reco_precio(f) < 0:
			(res["fallan"] as Array).append({"name": nombre_c, "causa": _reco_causa(f)})
			continue
		if p > int(gerencia_tope()["disponible"]):
			(res["fallan"] as Array).append({"name": nombre_c, "causa": "caja"})
			continue
		if Squad.home_of(mio, true).size() >= Gerencia.PLANTILLA_MAX:
			(res["fallan"] as Array).append({"name": nombre_c, "causa": "plantilla"})
			continue

		f["pos_linea"] = Squad.line_of(String(gerencia_ficha_de(f).get("pos", "MC")))

		var por_clausula: bool = gerencia_clausula(f)
		var quien: String = _gerencia_ficha({"club": String(f.get("club", "")),
			"idx": int(f.get("seat", -1)), "name": nombre_c, "fee": p,
			"ex": int(c["ex"]), "acto": not hubo_acto})
		if quien.is_empty():
			(res["fallan"] as Array).append({"name": nombre_c, "causa": "ido"})
			continue
		hubo_acto = true

		gerencia["fichados_total"] = gerencia_fichados_total() + 1
		_gerencia_linea_cumple(f)
		Telemetry.count("mesa_compra")
		if por_clausula:
			Telemetry.count("mesa_clausula")
		(res["fichados"] as Array).append({"name": quien,
			"club": String(f.get("club", "")), "fee": p,
			"pos": String(f.get("pos", "")), "ovr": int(f.get("ovr", 0))})
	if not (res["fichados"] as Array).is_empty():
		_gerencia_cobra("caja_vacia", cuesta_caja)

	if not gerencia_linea_cumplida():
		_rel_golpe("tecnico", cuesta_linea)
	Telemetry.count("mesa_confirma")
	gerencia.erase("mesa")
	if not siguen.is_empty():
		var casa_f: Array = Squad.home_of(mio)
		var quedan: Array = []
		for v in siguen:
			var d: Dictionary = v
			for h2 in casa_f.size():
				if String((casa_f[h2] as Dictionary).get("name", "")) == String(d["name"]):
					d["idx"] = h2
					quedan.append(d)
					break
		var resto: Dictionary = _ger_mesa().duplicate(true)
		resto["ventas"] = quedan
		gerencia["mesa"] = resto
	_gerencia_ventana_apunta()
	_save()
	changed.emit()
