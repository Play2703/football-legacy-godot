func gerencia_intocable() -> Dictionary:
	var mio: String = GameState.player_team_id
	var v: Variant = gerencia.get("intocable", null)
	if mio.is_empty() or not (v is Dictionary) or peldano() < Gerencia.PELDANO_MESA:
		return {}
	var d: Dictionary = v
	var idx: int = int(d.get("idx", -1))
	if String(d.get("club", "")) != mio:
		return {}
	var casa: Array = Squad.home_of(mio)
	if idx < 0 or idx >= casa.size() \
			or String((casa[idx] as Dictionary).get("name", "")) != String(d.get("name", "")):
		return {}
	return {"idx": idx, "name": String(d.get("name", ""))}


func gerencia_es_intocable(idx: int, nombre: String) -> bool:
	var t: Dictionary = gerencia_intocable()
	return not t.is_empty() and int(t["idx"]) == idx and String(t["name"]) == nombre





func gerencia_pon_intocable(idx: int, nombre: String) -> bool:
	var mio: String = GameState.player_team_id
	if mio.is_empty() or free_agent or peldano() < Gerencia.PELDANO_MESA \
			or transfer_requested:
		return false
	if gerencia_es_intocable(idx, nombre):
		gerencia.erase("intocable")
		_save()
		changed.emit()
		return true
	var sq: Array = Squad.of(mio)
	if idx < 0 or idx == Squad.home_seat(sq, Squad.user_index(sq)):
		return false
	_gerencia_cobra("intocable_suplente", gerencia_intocable_coste(idx, nombre))
	gerencia["intocable"] = {"club": mio, "idx": idx, "name": nombre}
	if gerencia_mesa_vendo(idx, nombre):
		var m: Dictionary = _ger_mesa().duplicate(true)
		m["ventas"] = gerencia_mesa_ventas().filter(func(v: Variant) -> bool:
			return not (int(v["idx"]) == idx and String(v["name"]) == nombre))
		gerencia["mesa"] = m
	Telemetry.count("intocable_pon")
	_save()
	changed.emit()
	return true




