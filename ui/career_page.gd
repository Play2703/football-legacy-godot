		_confirm(I18n.t("¿ACEPTAS SALIR?"),
			I18n.t("El club te ofrecerá a quien pregunte y verás más ofertas. Sigues"
			+ " jugando mientras tanto."),
			I18n.t("ACEPTO"), false, func() -> void: Career.accept_forced_sale())
