	var t: bool = UiKit.es_horizontal()
	if t:
		_torn_placa(true)
		_plantilla_en_uso = true
		var caja: HBoxContainer = HBoxContainer.new()
		caja.name = "Primas"
		caja.add_theme_constant_override("separation", int(PR_T_HUECO))
		caja.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		caja.size_flags_vertical = Control.SIZE_EXPAND_FILL
