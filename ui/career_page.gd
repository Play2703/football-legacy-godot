func _cal_rejilla(filas: Array) -> VBoxContainer:
	var ancho: float = _cal_ancho_retrato()
	var celda: Vector2 = Vector2(floorf((ancho - CAL_CANAL - 7.0 * CAL_CELDA_SEP) / 7.0),
		CAL_CELDA_H)
	var d: Dictionary = _cal_semanas(filas)
	var lista: VBoxContainer = VBoxContainer.new()
	lista.add_theme_constant_override("separation", CAL_CELDA_SEP)
	lista.mouse_filter = Control.MOUSE_FILTER_IGNORE
