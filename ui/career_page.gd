func _mesa_resultado(res: Dictionary) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	CareerUi.head(box, I18n.t("TRATOS CERRADOS"))

	var tratos: Array = []
	for e in res.get("vendidos", []):
		var d: Dictionary = e
		tratos.append({"vende": true, "name": String(d.get("name", "")),
			"pos": String(d.get("pos", "")), "ovr": int(d.get("ovr", 0)),
			"club": String(d.get("club", "")), "fee": int(d.get("fee", 0))})
	for e in res.get("fichados", []):
		var d: Dictionary = e
		tratos.append({"vende": false, "name": String(d.get("name", "")),
			"pos": String(d.get("pos", "")), "ovr": int(d.get("ovr", 0)),
			"club": String(d.get("club", "")), "fee": int(d.get("fee", 0))})
	if not tratos.is_empty():
		_mesa_tratos(box, tratos, I18n.t("VENDIDOS"), I18n.t("FICHADOS"))
	var fallan: Array = res.get("fallan", [])
	if not fallan.is_empty():
		_mesa_rotulo(box, I18n.t("NO SALIERON"))
		for e in fallan:
			var d: Dictionary = e
			var l: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.DANGER)
			l.text = "%s · %s" % [CareerUi.display_name(Competitions.demarca(
				String(d.get("name", "")))), _mesa_fallo_txt(String(d.get("causa", "")))]
			l.clip_text = true
			l.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
			box.add_child(l)

	CareerUi.kv(box, I18n.t("TE QUEDA"),
		CareerUi.money(int(Career.gerencia_tope().get("disponible", 0))), CareerTheme.MONEY)
	var cerrar: Button = CareerUi.accion("check", I18n.t("CERRAR"), _protege_col())
	cerrar.set_meta("atras", true)
	cerrar.pressed.connect(func() -> void: CareerUi.close_modal(box))
	box.add_child(cerrar)



func _mesa_fallo_txt(causa: String) -> String:
	match causa:
		"comprador": return I18n.t("SIN COMPRADOR")
		"ido": return I18n.t("YA NO JUGABA AHI")
		"plantilla": return I18n.t("NO CABIA NADIE")
		"caja": return I18n.t("SIN DINERO")
		"edad": return I18n.t("SE RETIRABA")
		"cedido": return I18n.t("CEDIDO")
		"interes": return I18n.t("NO QUISO VENIR")
		"tuyo": return I18n.t("YA ES TUYO")
		"club_no": return I18n.t("EL CLUB DIJO NO")
	return I18n.t("FALLIDO")



func _mesa_falla_txt(s: Dictionary) -> String:
	match String(s.get("falla", "")):
		"cerrada": return _mesa_cerrada_txt(Career.gerencia_mesa_cerrada_por())
		"caja": return I18n.tf("Te faltan {0}: vende a alguien o quita un fichaje.",
			[CareerUi.money(- int(s["queda"]))])
		"plantilla_max": return I18n.tf("La plantilla quedaría en {0}: el máximo es {1}.",
			[int(s["plantilla"]), int(s["max"])])
		"plantilla_min": return I18n.tf("La plantilla quedaría en {0}: el mínimo es {1}.",
			[int(s["plantilla"]), int(s["min"])])

	if not Career.gerencia_mesa_ventas().is_empty() \
			or not Career.gerencia_mesa_compras().is_empty():
		return I18n.t("Nada de lo marcado sale hoy: mira los avisos en rojo.")
	return I18n.t("Marca a quién vendes y a quién fichas.")

















func _gerencia_movimientos() -> void:
	var club: String = GameState.player_team_id
	var filas: Array = []
	for n in Career.market_news:
		var row: Dictionary = n
		if String(row.get("to", "")) != club and String(row.get("from", "")) != club:
			continue
		filas.append(row)
		if filas.size() >= GER_MOVS_VISIBLE:
			break
	if filas.is_empty():
		return
	CareerUi.head(_content, I18n.t("ALTAS Y BAJAS"))
	for r in filas:
		_gerencia_mov_row(r as Dictionary)








func _gerencia_mov_row(n: Dictionary) -> void:
	var club: String = GameState.player_team_id
	var entra: bool = String(n.get("to", "")) == club
	var cesion: bool = String(n.get("kind", "")) == "loan"
	var otro: String = String(n.get("from", "")) if entra else String(n.get("to", ""))
	var caja: PanelContainer = CareerUi.plate()
	_content.add_child(caja)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 18)
	caja.add_child(fila)
	var franja: ColorRect = ColorRect.new()
	franja.color = CareerTheme.accent() if entra else CareerTheme.DANGER
	franja.custom_minimum_size = Vector2(6, 0)
	fila.add_child(franja)


	var escudo: CrestView = CrestView.new()
	escudo.custom_minimum_size = Vector2(46, 46)
	escudo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	fila.add_child(escudo)
	escudo.set_team(Teams.by_id(otro) if not Teams.is_free(otro) else Teams.free_team())
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 8)
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	fila.add_child(col)
	var arriba: HBoxContainer = CareerUi.ovr_poss_row(_news_persona(n),
		int(n.get("media", 0)), 13)
	arriba.alignment = BoxContainer.ALIGNMENT_BEGIN
	arriba.add_theme_constant_override("separation", 10)
	col.add_child(arriba)
	var nom: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
	nom.text = CareerTheme.caps(String(n.get("name", "")))
	nom.clip_text = true
	nom.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	arriba.add_child(nom)
	var que: String = I18n.t("CEDIDO") if cesion \
			else (I18n.t("ALTA") if entra else I18n.t("BAJA"))
	var pie: Label = CareerUi.plain(CareerTheme.T_CAPTION,
		CareerTheme.TEXT_DIM if entra or cesion else CareerTheme.DANGER)
	pie.text = I18n.tf("{0} · {1}", [que,
		Competitions.demarca(String(Teams.by_id(otro).get("name", "?")))])
	pie.clip_text = true
	col.add_child(pie)


	var fee: int = int(n.get("fee", 0))
	if fee > 0:
		var cif: Label = CareerUi.plain(CareerTheme.T_VALUE, CareerTheme.MONEY)
		cif.text = CareerUi.money(fee)
		cif.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		fila.add_child(cif)



func _build_pos_request() -> void:
	var otros: Array = []
	for p in Career.puestos():
		if String(p) != Squad.USER_POS:
			otros.append(String(p))
	if otros.is_empty():
		return
	if not Career.puede_pedir_puesto():
		var gastada: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
		gastada.text = I18n.t("Ya le pediste un cambio de puesto en esta ventana.")
		gastada.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(gastada)
		return
	for pos in otros:
		var p2: String = String(pos)



		var b: Button = CareerUi.accion("once", CareerTheme.caps(I18n.tf("PEDIR JUGAR DE {0} · {1}",
			[I18n.t(p2), I18n.t(_texto_lectura(p2))])), CareerTheme.NAV_YO)
		b.pressed.connect(func() -> void:
			var dijo_si: bool = Career.pide_puesto(p2)
			if dijo_si:
				UiAudio.confirm()
			else:
				UiAudio.deny()
			_refresh())
		_content.add_child(b)




func _texto_lectura(pos: String) -> String:
	match Career.lectura_peticion(pos):
		3:
			return "LO VERA BIEN"
		2:
			return "PUEDE ESCUCHARTE"
		1:
			return "LO VERA DIFICIL"
		_:
			return "NI LO ESCUCHA"




























