func _ready() -> void:


	var want: String = GameState.career_page




	if MAP_ALIAS.has(want):
		_map_kind = String(MAP_ALIAS[want])
	var nav_route: Array = CareerNav.route_tumbada(want)
	if not nav_route.is_empty():
		want = String(nav_route[0])
		_apply_sub(want, String(nav_route[1]))
	elif PAGE_ALIAS.has(want):
		var alias: Array = PAGE_ALIAS[want]
		want = String(alias[0])
		_apply_sub(want, String(alias[1]))
	_page = want if TITLES.has(want) else "perfil"
	_vestidor_casa = abrir_vestidor_casa and _page == "aspecto"
	abrir_vestidor_casa = false
	if abrir_redes and _page == "noticias":
		_wnews_scope = "redes"
	abrir_redes = false

	if abrir_estado and _page == "mercado" and not (Career.free_agent or Career.on_loan()):
		_mt_vista = "estado"
	abrir_estado = false
	if _vestidor_casa:
		_look_tab = "casual"



	_sync_nav()
	_count_open()
	_build_bg()
	_build_ui()




	if _page == "mercado":
		Career.mark_market_news_seen()



		_offer_open = abrir_oferta
		if abrir_oferta >= 0 and not abrir_oferta_id.is_empty() and (abrir_oferta
				>= Career.pending_offers.size() or String((Career.pending_offers[abrir_oferta]
				as Dictionary).get("id", "")) != abrir_oferta_id):
			_offer_open = -1
		_offer_idx = maxi(_offer_open, 0)
		abrir_oferta = -1
		abrir_oferta_id = ""
		Career.mark_agent_result_seen()
		Career.mark_haggle_results_seen()






	if _page == "noticias":
		Career.mark_world_news_seen()


	if _page == "fichajes":
		Career.mark_market_news_seen()
	Career.changed.connect(_refresh)
	Career.skill_changed.connect(_on_skill_changed)



	Store.caja_lista.connect(_refresh)
	Store.intento_listo.connect(_on_caja_intento)
	_refresh()
















