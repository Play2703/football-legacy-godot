const CAL_PATRON: GDScript = preload("res://ui/patron_fondo.gd")





func _cal_sb_piel(fam: String, tint: Color, _k: float) -> StyleBoxFlat:
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.set_corner_radius_all(CareerTheme.RADIUS)
	sb.set_content_margin_all(4)
	sb.set_border_width_all(2)
	match fam:
		"copa":
			sb.bg_color = CareerTheme.SURFACE.lerp(tint, CAL_PIEL_COPA)
			sb.border_color = Color(tint, CAL_MARCO_LIGA)
		"continental":
			sb.bg_color = _cal_cielo(tint)[0]
			sb.border_color = Color(_cal_label_col(tint), CAL_NOCHE_MARCO)
		"nat":
			sb.bg_color = CareerTheme.SURFACE
			sb.border_color = _cal_label_col(tint)
			sb.set_border_width_all(3)
		_:
			sb.bg_color = CareerTheme.SURFACE.lerp(tint, CAL_PIEL_LIGA_B)
			sb.border_color = Color(tint, CAL_MARCO_LIGA)
	return sb





func _cal_cielo(tint: Color) -> Array[Color]:
	if CareerTheme.light_theme:
		return [CareerTheme.SURFACE.lerp(tint, CAL_PIEL_NOCHE),
			CareerTheme.SURFACE.lerp(tint, CAL_PIEL_NOCHE * 1.5)]
	var noche: Color = CareerTheme.PITCH_SKY_A.lerp(CareerTheme.RASGO_NOCHE, CAL_NOCHE_AZUL)
	return [noche.lerp(tint, CAL_NOCHE_TINTE), CareerTheme.PITCH_SKY_B.lerp(tint, CAL_NOCHE_TINTE * 0.5)]





func _cal_patron(fam: String, tint: Color, sb: StyleBoxFlat, semilla: int) -> Control:
	var p: CAL_PATRON = CAL_PATRON.new()
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var borde: float = float(sb.border_width_left)
	p.sangre = sb.content_margin_left - borde
	p.radio = CareerTheme.RADIUS - borde
	p.semilla = semilla
	match fam:
		"copa":
			p.forma = "rayas"
			p.base = sb.bg_color
			p.tinta = CareerTheme.SURFACE.lerp(tint, CAL_PIEL_COPA_B)
		"continental":
			var cielo: Array[Color] = _cal_cielo(tint)
			p.forma = "estrellas"
			p.base = cielo[0]
			p.tinta2 = cielo[1]
			p.tinta = _cal_label_col(tint) if not CareerTheme.light_theme else tint.darkened(0.3)
		"nat":
			p.forma = "bandera"
			p.base = sb.bg_color
			p.pais = Career.nationality
			p.alfa_bandera = CAL_PIEL_BANDERA
		_:
			p.forma = "cesped"
			p.base = sb.bg_color
			p.tinta = CareerTheme.SURFACE.lerp(tint, CAL_PIEL_LIGA)
	p.set_meta("cal_patron", p.forma)
	return p












func _cal_chip(f: Dictionary, ancho: float = 0.0) -> Control:
	if bool(f["jugado"]):
		return null
	var baja: String = String(f["baja"])
	if baja == "BAJA" or baja == "ALTA":
		var col: Color = CareerTheme.DANGER if baja == "BAJA" else CareerTheme.GOOD
		var p: PanelContainer = PanelContainer.new()
		p.add_theme_stylebox_override("panel", _cal_sb_chip(col))
		p.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		p.mouse_filter = Control.MOUSE_FILTER_IGNORE
		p.set_meta("cal_chip", baja)
		var ic: MenuIcon = MenuIcon.new()
		ic.custom_minimum_size = Vector2(CAL_CHIP_ICONO, CAL_CHIP_ICONO)
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ic.setup("cruz_medica", col)
		p.add_child(ic)
		return p
	var d: int = int(f["descanso"])
	if d < 0:
		return null
	var cd: Color = _cal_descanso_col(d)
	var texto: String = I18n.tf("{0}d", [d])
	var tag: PanelContainer = CareerUi.tint_tag({"text": texto, "ink": cd})


	tag.add_theme_stylebox_override("panel", _cal_sb_chip(cd))
	tag.set_meta("cal_chip", texto)
	if ancho > 0.0:
		var l: Label = tag.get_child(0) as Label
		if l != null:
			l.custom_minimum_size.x = maxf(0.0, ancho - 16.0)
			l.clip_text = true
			l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			CareerUi.autoshrink(l, 10)
	return tag





func _cal_sb_chip(col: Color) -> StyleBoxFlat:
	var sb: StyleBoxFlat = CareerTheme.tag(CareerTheme.SURFACE.lerp(col, CAL_CHIP_ALPHA))
	sb.content_margin_left = 8.0
	sb.content_margin_right = 8.0
	sb.content_margin_top = 3.0
	sb.content_margin_bottom = 3.0
	return sb










func _cal_detalle(f: Dictionary) -> void:
	if UiKit.es_horizontal():
		_cal_detalle_tumbado(f)
		return
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	_cal_fila(box, f, true)
	_cal_rachas(box, f)
	var datos: VBoxContainer = VBoxContainer.new()
	datos.add_theme_constant_override("separation", 6)
	box.add_child(datos)
	_cal_datos_partido(datos, f, box)
	var botones: HBoxContainer = HBoxContainer.new()
	botones.add_theme_constant_override("separation", 12)
	box.add_child(botones)
	var cerrar: Button = Button.new()
	cerrar.text = I18n.t("CERRAR")
	cerrar.custom_minimum_size = Vector2(0, CareerTheme.BTN_ROW_H)
	cerrar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerTheme.apply_button(cerrar, CareerTheme.Kind.GHOST, CareerTheme.T_BODY)
	cerrar.pressed.connect(func() -> void: CareerUi.close_modal(box))
	botones.add_child(cerrar)
	if bool(f["jugado"]) or String(f["comp"]) == "nat":
		return
	var plantilla: Button = Button.new()
	plantilla.text = I18n.t("PLANTILLA")
	plantilla.custom_minimum_size = Vector2(0, CareerTheme.BTN_ROW_H)
	plantilla.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerTheme.apply_button_tinted(plantilla, CareerTheme.NAV_PLANTILLA, CareerTheme.T_BODY)
	plantilla.pressed.connect(func() -> void:
		CareerUi.close_modal(box)
		_on_family("plantilla"))
	botones.add_child(plantilla)





func _cal_rachas(box: VBoxContainer, f: Dictionary) -> void:
	var comp: String = String(f["comp"])
	var tuyo: Dictionary = f["local"] if bool(f["you_home"]) else f["visita"]
	var rival: Dictionary = f["visita"] if bool(f["you_home"]) else f["local"]
	for lado in [[tuyo, true], [rival, false]]:
		var team: Dictionary = lado[0]
		var forma: Array = GameState.form_of_any(String(team.get("id", "")), comp)
		if forma.is_empty():
			continue
		var fila: HBoxContainer = HBoxContainer.new()
		fila.add_theme_constant_override("separation", 10)
		fila.set_meta("cal_racha", forma.size())
		box.add_child(fila)
		var nom: Label = CareerUi.plain(CareerTheme.T_CAPTION,
			_cal_you_col() if bool(lado[1]) else CareerTheme.TEXT)
		nom.text = Competitions.demarca(String(team.get("abbrev", team.get("name", ""))))
		nom.custom_minimum_size = Vector2(CAL_COMP_W, 0)
		nom.clip_text = true
		nom.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		CareerUi.autoshrink(nom, 11)
		fila.add_child(nom)
		for res in forma:
			var sq: ColorRect = ColorRect.new()
			sq.color = _cal_res_col(String(res))
			sq.custom_minimum_size = Vector2(CAL_CUADRO + 4.0, CAL_CUADRO + 4.0)
			sq.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			fila.add_child(sq)









func _cal_you_col() -> Color:
	var c: Color = CareerTheme.accent_text()
	if c.get_luminance() >= 0.6:
		return c
	return c.lerp(CareerTheme.TEXT, 0.45)




func _cal_muelle() -> Control:
	var s: Control = Control.new()
	s.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	s.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return s





func _cal_lado(r: HBoxContainer, team: Dictionary, tuyo: bool, izq: bool) -> void:
	var caja: HBoxContainer = HBoxContainer.new()
	caja.add_theme_constant_override("separation", 10)
	caja.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.add_child(caja)
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(38, 38)
	crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	crest.mouse_filter = Control.MOUSE_FILTER_IGNORE
	crest.set_team(team)





	var nom: Label = CareerUi.plain(16, _cal_you_col() if tuyo else CareerTheme.TEXT)


	nom.text = Competitions.demarca(String(team.get("abbrev", team.get("name", ""))))




	nom.custom_minimum_size = Vector2(74, 0)
	nom.vertical_alignment = VERTICAL_ALIGNMENT_CENTER


	nom.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT if izq \
			else HORIZONTAL_ALIGNMENT_LEFT
	CareerUi.autoshrink(nom, 11)
	if izq:
		caja.add_child(crest)
		caja.add_child(nom)
	else:
		caja.add_child(nom)
		caja.add_child(crest)






























const RANK_PICKER_INLINE_MAX: int = 8
const RANK_PICKER_MAX_H: int = 820












const RANK_ACT_W: int = 56


func _page_ranking() -> void:



	if not UiKit.es_horizontal():
		_content.add_child(CareerUi.segmented([I18n.t("JUGADORES"), I18n.t("TÉCNICOS"), I18n.t("UEFA")],
			2 if _rank_uefa else (1 if _rank_tecnicos else 0), _rank_elige_tipo))
	if _rank_uefa:

		if _tira_tumbada():
			RankingUefa.build(self)
		else:
			RankingUefa.build_retrato(self, _content)
		return
	if _rank_tecnicos:

		if _tira_tumbada():
			RankingTira.build_tecnicos(self, _refresh)
		else:
			CoachRankingView.build(_content, self, _refresh)
		return
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(34, 34)
	ic.setup("stats", CareerNav.FAMILY_COLORS["mundo"])
	if not UiKit.es_horizontal():
		CareerUi.head(_content, I18n.t("RANKING DE JUGADORES"), ic)
		CareerUi.dim(_content, I18n.t("Los jugadores del mundo, por liga y división,"
			+ " ordenados por su media. Tú entras en la misma lista."))
	else:
		ic.queue_free()



	var table: Array = WorldRanking.rows(1 if _rank_libres else _rank_div)
	var vistas: Array = WorldRanking.filtered(table, _rank_puestos, _rank_age,
		_rank_value, _rank_pais, _rank_libres, _rank_liga)
	_rank_vistas = vistas
	if _tira_tumbada():

		RankingTira.build(self, vistas)
		return
	if UiKit.es_horizontal():

		RankingTumbado.build(self, vistas)
		return



	var max_page: int = maxi((vistas.size() - 1) / WorldRanking.PER_PAGE, 0)
	_rank_page = clampi(_rank_page, 0, max_page)



	_rank_tu_sitio(WorldRanking.rows())
	_rank_cupo()
	_rank_filtros()
	if vistas.is_empty():



		var bolsa_vacia: bool = _rank_libres and Career.free_agents.is_empty()
		CareerUi.dim(_content, I18n.t("Ahora mismo no hay nadie sin club. La bolsa se"
			+ " llena al cerrar cada ventana de mercado.") if bolsa_vacia
			else I18n.t("Ningún jugador cumple estos filtros."
			+ " Prueba a soltar alguno."))
		return
	_rank_paginador(vistas.size())
	var desde: int = _rank_page * WorldRanking.PER_PAGE
	for i in range(desde, mini(desde + WorldRanking.PER_PAGE, vistas.size())):
		_rank_fila(vistas[i], i)
	_rank_paginador(vistas.size())


func _rank_elige_tipo(i: int) -> void:
	_rank_tecnicos = i == 1
	_rank_uefa = i == 2
	if _rank_uefa:
		RankingUefa.pagina = -1
	_refresh()




func _rk_t_modo(_m: int) -> void:
	if _page == "ranking" and is_inside_tree() and _tira_tumbada():
		_refresh()



func _fi_t_modo(_m: int) -> void:
	if _page == "fichajes" and is_inside_tree() and _tira_tumbada():
		_refresh()




func _ca_t_modo(_m: int) -> void:
	if _page == "legado" and is_inside_tree() and _tira_tumbada():
		_refresh()






func _rank_tu_sitio(table: Array) -> void:
	var plate: PanelContainer = CareerUi.plate()
	_content.add_child(plate)



	var pisos: VBoxContainer = VBoxContainer.new()
	pisos.add_theme_constant_override("separation", 12)
	plate.add_child(pisos)
	var box: HBoxContainer = HBoxContainer.new()
	box.add_theme_constant_override("separation", 18)
	pisos.add_child(box)
	var av: CrestView = CrestView.new()
	av.custom_minimum_size = Vector2(32, 32) if UiKit.es_horizontal() else Vector2(52, 52)
	av.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	av.set_team(Teams.by_id(GameState.player_team_id))
	box.add_child(av)
	var txt: VBoxContainer = VBoxContainer.new()
	txt.add_theme_constant_override("separation", 2)
	txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	box.add_child(txt)
	var rank: int = WorldRanking.rank_of_you(table)
	var l1: Label = CareerUi.plain(CareerTheme.T_CAPTION if UiKit.es_horizontal() else CareerTheme.T_BODY, CareerTheme.TEXT)
	l1.text = I18n.tf("TU SITIO: {0}° DE {1}", [maxi(rank, 1), table.size()])




	if UiKit.es_horizontal():
		l1.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	else:
		l1.clip_text = true
	txt.add_child(l1)





	var yo_ovr: int = Squad.ovr_scale(Career.skills_avg())
	if rank > 1:
		var arriba: Dictionary = table[rank - 2]
		var l2: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
		l2.text = I18n.tf("A {0} de media del {1}°",
			[int(arriba["ovr"]) - yo_ovr, rank - 1])
		if UiKit.es_horizontal():
			l2.add_theme_font_size_override("font_size", CareerTheme.T_CAPTION)
			l2.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		else:
			l2.clip_text = true
		txt.add_child(l2)
	var bg: OvrBadge = OvrBadge.new()
	bg.setup(yo_ovr, 14 if UiKit.es_horizontal() else 20)
	bg.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	box.add_child(bg)













func _rank_cupo() -> void:
	if not _rank_marca_hay():
		return
	var queda: int = int(Career.gerencia_mesa_saldo()["queda"])
	var ir: Button = CareerUi.menu_row(I18n.t("QUEDA EN LA MESA"), CareerUi.money(queda),
		CareerTheme.DANGER if queda < 0 else CareerTheme.MONEY, "contrato")
	if UiKit.es_horizontal():
		ir.custom_minimum_size.y = 72.0
	ir.pressed.connect(func() -> void:
		_mesa_ir = true
		_family = CareerNav.family_of_tab("gerencia")
		_on_tab("gerencia"))
	_content.add_child(ir)






func _rank_filtros() -> void:
	var tira: GridContainer = GridContainer.new()
	tira.columns = 2
	tira.add_theme_constant_override("h_separation", 12)
	tira.add_theme_constant_override("v_separation", 10)
	_content.add_child(tira)





	tira.add_child(_rank_chip(I18n.t("PUESTO"), _rank_puestos_label(),
		not _rank_puestos.is_empty(), _open_rank_puestos_picker,
		"camiseta", _rank_puestos_color()))
	tira.add_child(_rank_chip(I18n.t("EDAD"),
		_rank_age if not _rank_age.is_empty() else I18n.t("TODAS"),
		not _rank_age.is_empty(), _open_rank_age_picker,
		"reloj", CareerTheme.NAV_YO))
	tira.add_child(_rank_chip(I18n.t("VALOR"),
		_rank_value if not _rank_value.is_empty() else I18n.t("TODO"),
		not _rank_value.is_empty(), _open_rank_value_picker,
		"moneda", CareerTheme.MONEY))
	tira.add_child(_rank_chip(I18n.t("PAÍS"),
		Nations.display_name(_rank_pais) if not _rank_pais.is_empty()
			else I18n.t("TODOS"),
		not _rank_pais.is_empty(), _open_rank_country_picker,
		"seleccion", CareerTheme.NAV_GENTE))



	tira.add_child(_rank_chip(I18n.t("LIGA"), _rank_liga_label(_rank_liga),
		not _rank_liga.is_empty(), _open_rank_liga_picker,
		"torneos", CareerTheme.NAV_MUNDO))
	tira.add_child(_rank_chip(I18n.t("DIVISIÓN"), _rank_div_label(_rank_div),
		_rank_div != 1, _open_rank_div_picker,
		"stats", CareerTheme.div_color(_rank_div) if _rank_div > 0
			else CareerTheme.DIV_COLOR_DEEP))



	var libres: Control = _rank_chip(I18n.t("CLUB"),
		I18n.t("SIN CLUB") if _rank_libres else I18n.t("TODOS"), _rank_libres,
		func() -> void:
			_rank_libres = not _rank_libres
			_rank_page = 0
			_refresh(),
		"contrato", CareerTheme.NAV_PAPEL)
	_content.add_child(libres)





func _rank_puestos_label() -> String:
	if _rank_puestos.is_empty():
		return I18n.t("TODOS")
	if _rank_puestos.size() > 3:
		return I18n.tf("{0} PUESTOS", [_rank_puestos.size()])
	var rot: PackedStringArray = PackedStringArray()
	for p in SquadEdits.POS_KEYS:
		if _rank_puestos.has(p):
			rot.append(CareerUi.pos_rotulo(p))
	return ", ".join(rot)





func _rank_puestos_color() -> Color:
	var linea: String = ""
	for p in _rank_puestos:
		var l: String = Squad.line_pintada(String(p))
		if linea.is_empty():
			linea = l
		elif l != linea:
			return CareerTheme.NAV_PLANTILLA
	return CareerUi.line_color(linea) if not linea.is_empty() \
			else CareerTheme.NAV_PLANTILLA







func _rank_chip(campo: String, valor: String, activo: bool,
		on_press: Callable, icono: String = "", color: Color = CareerTheme.NAV_MUNDO) -> Control:
	var b: Button = Button.new()
	b.focus_mode = Control.FOCUS_NONE
	b.custom_minimum_size = Vector2(0, 56 if UiKit.es_horizontal() else 66)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	b.clip_contents = true
	var ink: Color = color
	var txt: Color = CareerTheme.TEXT
	if activo:
		CareerTheme.apply_button_accent(b, color, CareerTheme.T_DIM)
		ink = CareerTheme.on_color(color)
		txt = ink
	else:
		CareerTheme.apply_button_tinted(b, color, CareerTheme.T_DIM, 0.22)
	b.pressed.connect(on_press)
	var inner: HBoxContainer = HBoxContainer.new()
	inner.add_theme_constant_override("separation", 10)
	inner.set_anchors_preset(Control.PRESET_FULL_RECT)
	inner.offset_left = 14.0
	inner.offset_right = -14.0
	inner.mouse_filter = Control.MOUSE_FILTER_IGNORE
	b.add_child(inner)
	if not icono.is_empty():
		var ic: MenuIcon = MenuIcon.new()
		ic.custom_minimum_size = Vector2(28, 28)
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ic.setup(icono, ink)
		inner.add_child(ic)
	if UiKit.es_horizontal():

		var datos: VBoxContainer = VBoxContainer.new()
		datos.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		datos.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		datos.add_theme_constant_override("separation", 2)
		inner.add_child(datos)
		var clave: Label = CareerUi.plain(14, txt)
		clave.text = campo
		clave.clip_text = true
		clave.mouse_filter = Control.MOUSE_FILTER_IGNORE
		datos.add_child(clave)
		var dato: Label = CareerUi.plain(16, txt)
		dato.text = CareerTheme.caps(valor)
		dato.clip_text = true
		dato.mouse_filter = Control.MOUSE_FILTER_IGNORE
		datos.add_child(dato)
		b.tooltip_text = "%s: %s" % [campo, CareerTheme.caps(valor)]
		return b
	var l: Label = CareerUi.plain(CareerTheme.T_DIM, txt)





	l.text = "%s: %s" % [campo, CareerTheme.caps(valor)]
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER


	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	l.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	l.clip_text = true
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	inner.add_child(l)
	return b







func _open_rank_puestos_picker() -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var elegidos: Array = _rank_puestos.duplicate()
	var t: Label = CareerUi.plain(28, CareerTheme.TEXT)
	t.text = I18n.t("FILTRAR POR PUESTO")
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	var atajos: GridContainer = GridContainer.new()
	atajos.columns = 2
	atajos.add_theme_constant_override("h_separation", 8)
	atajos.add_theme_constant_override("v_separation", 8)
	box.add_child(atajos)
	var reja: HFlowContainer = HFlowContainer.new()
	reja.add_theme_constant_override("h_separation", 8)
	reja.add_theme_constant_override("v_separation", 8)
	box.add_child(reja)







	var pinta: Array = [null]
	pinta[0] = func() -> void:
		for c in reja.get_children():
			c.queue_free()
		for key in SquadEdits.POS_KEYS:
			var p: String = String(key)
			var chip: Button = CareerUi.pos_check(p, elegidos.has(p))
			chip.pressed.connect(func() -> void:
				if elegidos.has(p):
					elegidos.erase(p)
				else:
					elegidos.append(p)
				(pinta[0] as Callable).call())
			reja.add_child(chip)
	for l in WorldRanking.LINES:
		var linea: String = String(l)
		var b: Button = Button.new()
		b.text = _rank_line_label_of(linea)


		CareerTheme.apply_button_tinted(b, CareerUi.line_color(linea),
			CareerTheme.T_DIM, 0.3)
		for slot in ["font_color", "font_hover_color", "font_pressed_color",
				"font_focus_color"]:
			b.add_theme_color_override(slot, CareerUi.line_color(linea))
		b.custom_minimum_size = Vector2(0, 56)
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		b.clip_text = true
		b.pressed.connect(func() -> void:
			var suyos: Array = []
			for key in SquadEdits.POS_KEYS:

				if Squad.line_pintada(String(key)) == linea:
					suyos.append(String(key))
			var todos: bool = true
			for p in suyos:
				if not elegidos.has(p):
					todos = false
			for p in suyos:
				if todos:
					elegidos.erase(p)
				elif not elegidos.has(p):
					elegidos.append(p)
			(pinta[0] as Callable).call())
		atajos.add_child(b)
	(pinta[0] as Callable).call()
	var pie: HBoxContainer = HBoxContainer.new()
	pie.add_theme_constant_override("separation", 8)
	box.add_child(pie)
	var todos_b: Button = Button.new()
	todos_b.text = I18n.t("TODOS")
	todos_b.custom_minimum_size = Vector2(0, 78)
	todos_b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerTheme.apply_button(todos_b, CareerTheme.Kind.GHOST, 22)
	todos_b.pressed.connect(func() -> void:
		elegidos.clear()
		(pinta[0] as Callable).call())
	pie.add_child(todos_b)
	var listo: Button = Button.new()
	listo.text = I18n.t("LISTO")
	listo.custom_minimum_size = Vector2(0, 78)
	listo.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	UiKit.style_button(listo)
	listo.pressed.connect(func() -> void:
		CareerUi.close_modal(box)
		_rank_puestos = elegidos
		_rank_page = 0
		_refresh())
	pie.add_child(listo)



