	card.tree_exited.connect(det.queue_free)
	var hit: Button = CareerUi.hit_overlay(56.0,
		_rel_detalle_abre.bind(key, label_text, nivel, col, chip,
			chip_col if chip_col is Color else col))
	card.add_child(hit)











	if extra is BaseButton:










		card.move_child(hit, 0)
		_rel_deja_pasar(box, extra)
		hit.focus_neighbor_right = hit.get_path_to(extra)
		extra.focus_neighbor_left = extra.get_path_to(hit)
		extra.focus_entered.connect(func() -> void:
			if not is_instance_valid(hit) or not hit.is_inside_tree():
				return
			hit.focus_neighbor_right = NodePath()
			var sig: Control = hit.find_valid_focus_neighbor(SIDE_RIGHT)
