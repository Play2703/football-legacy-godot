func _en_t_recomendado(div: int) -> String:
	var stat: String = Encargo.critica(Career.skills, Career.puesto_hoy(), div)
	return Encargo.ejercicio(stat, div, Career.encargos_ok)




func _en_t_ejercicios(div: int) -> Array[String]:
	var out: Array[String] = []
	var rec: String = _en_t_recomendado(div)
	if TrainingGround.has_drill(div, rec) and rec != Practice.OPEN_FIELD:
		out.append(rec)
	for d in TrainingGround.drills_of(div):
		var id: String = String(d)
		if id == Practice.OPEN_FIELD or out.has(id):
			continue
		out.append(id)
	return out


func _en_t_icono(id: String) -> String:
	return String(EN_T_ICONOS.get(id, Encargo.icono(id)))




func _en_t_rejilla(div: int) -> GridContainer:
	var rej: GridContainer = GridContainer.new()
	rej.name = "Rejilla"
	rej.columns = EN_T_COLS
	rej.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rej.size_flags_vertical = Control.SIZE_EXPAND_FILL
	rej.add_theme_constant_override("h_separation", EN_T_AIRE)
	rej.add_theme_constant_override("v_separation", EN_T_AIRE)
	rej.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var vivos: Array[String] = _en_t_ejercicios(div)
	var rec: String = _en_t_recomendado(div)
	var a_la_vista: int = vivos.size()
	var mas: Array[String] = []
	if vivos.size() > EN_T_CELDAS:
		a_la_vista = EN_T_CELDAS - 1
		mas = vivos.slice(a_la_vista)
	for i in a_la_vista:
		rej.add_child(_en_t_celda(vivos[i], vivos[i] == rec, 0))
	if not mas.is_empty():
		rej.add_child(_en_t_mas(mas))
	var d: int = div
	while rej.get_child_count() < EN_T_CELDAS and d > 1:
		for id in TrainingGround.drills_unlocked_by(d):
			if rej.get_child_count() >= EN_T_CELDAS:
				break
			rej.add_child(_en_t_celda(String(id), false, d - 1))
		d -= 1








	var n: int = _en_t_celdas.size()
	var primera: int = -1
	for i in n:
		var b: Button = _en_t_celdas[i]
		var c: int = i % EN_T_COLS
		b.focus_neighbor_left = b.get_path_to(_en_t_celdas[i - 1] if c > 0 else b)
		b.focus_neighbor_right = b.get_path_to(_en_t_celdas[i + 1] if c < EN_T_COLS - 1 and i + 1 < n else b)
		b.focus_neighbor_bottom = b.get_path_to(_en_t_celdas[i + EN_T_COLS] if i + EN_T_COLS < n else b)
		if i >= EN_T_COLS:
			b.focus_neighbor_top = b.get_path_to(_en_t_celdas[i - EN_T_COLS])
		if b.disabled:
			b.set_meta(Entrada.SIN_FOCO_META, true)
			b.focus_mode = Control.FOCUS_NONE
			continue
		if primera < 0 or bool(b.get_meta("en_t_recomendada", false)):
			primera = i

	if primera >= 0:
		_en_t_celdas[primera].set_meta(Entrada.PRIMERO_META, true)
	return rej




func _en_t_celda(id: String, recomendada: bool, abre_div: int) -> Button:
	var candado: bool = abre_div > 0
	var b: Button = _en_t_boton_celda("Celda%d" % _en_t_celdas.size())
	b.disabled = candado
	b.set_meta("en_t_celda", id)
	if candado:
		b.set_meta("en_t_abre", abre_div)
	else:
		b.pressed.connect(_start_training.bind(id))
	if recomendada:
		b.set_meta("en_t_recomendada", true)
		for estado in ["normal", "hover", "focus", "pressed", "hover_pressed"]:
			var sb: StyleBoxFlat =(b.get_theme_stylebox(estado) as StyleBoxFlat).duplicate()
			sb.border_color = CareerTheme.NAV_YO
			sb.set_border_width_all(EN_T_BORDE)
			b.add_theme_stylebox_override(estado, sb)
	var col: Color = CareerTheme.TEXT_MID if candado else CareerTheme.TEXT
	var pila: VBoxContainer = _en_t_pila_celda(b, "candado" if candado else _en_t_icono(id),
		CareerTheme.TEXT_MID if candado else CareerTheme.NAV_YO,
		CareerTheme.caps(I18n.t(Practice.label_of(id))), col)
	if candado:
		pila.add_child(_en_t_chip_celda(I18n.ordinal_f(abre_div), CareerTheme.TEXT_MID))
	elif recomendada:
		pila.add_child(_en_t_chip_celda(I18n.t("HOY"), CareerTheme.NAV_YO))
	return b




