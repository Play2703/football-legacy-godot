func _palm_campeones(pais: String) -> void:
	CareerUi.head(_content, I18n.t("CAMPEONES"))
	var rows: Array = Palmares.league_rows(pais, Career.league_history)
	if rows.is_empty():

		CareerUi.dim(_content, I18n.t("Aún no se ha cerrado ninguna temporada."))
	else:
		var era: Dictionary = Palmares.era_of_country(pais, Career.league_history)
		if not era.is_empty():
			var era_l: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT)
			era_l.text = Competitions.demarca(String(Teams.by_id(str(era["club"])).get("name", ""))) \
					+ " · " + I18n.tf("{0} ligas en {1} años", [int(era["n"]), int(era["w"])])
			era_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			era_l.clip_text = true
			era_l.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
			_content.add_child(era_l)





		var con_torneos: bool = false
		for r in rows:
			if not str((r as Dictionary).get("champion_ap", "")).is_empty():
				con_torneos = true
		var cols: Array = [
			CareerUi.col("", 118.0 if con_torneos else 80.0),
			CareerUi.col("", 38.0),
			CareerUi.col(I18n.t("CAMPEÓN")),
			CareerUi.col("", 38.0),
			CareerUi.col(I18n.t("Subcampeón")),
		]
		CareerUi.table_head(_content, cols)
		for r in rows:
			var fila: Dictionary = r



			var tramos: Array = [[str(fila.get("champion", "")), str(fila.get("runner_up", "")),
				"CLAUSURA" if not str(fila.get("champion_ap", "")).is_empty() else ""]]
			if not str(fila.get("champion_ap", "")).is_empty():
				tramos.append([str(fila["champion_ap"]), str(fila.get("runner_up_ap", "")),
					"APERTURA"])
			for tr in tramos:
				var campeon: String = String(tr[0])
				var sub: String = String(tr[1])
