func _wnews_jugador(f: Dictionary, amplio: bool = false) -> Dictionary:
	var nombre: String = str(f.get("name", ""))


	if nombre.is_empty() or str(f.get("kind", "")) in ["naming", "tecnico", "pizarra"]:
		return {}
	var club: String = str(f.get("club", ""))
	if nombre == Career.player_name and club == GameState.player_team_id:
		return {"pos": Career.puesto_hoy(), "ovr": Squad.ovr_scale(Career.skills_avg())}
	var clubes: Array = [club]
	var pais: String = Teams.country_of(club) if amplio else ""
	if not pais.is_empty():
		for t in Teams.all():
			var id: String = String((t as Dictionary).get("id", ""))
			if id != club and String((t as Dictionary).get("country", "")) == pais:
				clubes.append(id)
	for id in clubes:
		if String(id).is_empty():
			continue
		for p in Squad.of(String(id)):
			var d: Dictionary = p
			if String(d.get("name", "")) == nombre:
				var pos: String = String(d.get("pos", ""))
				return {"pos": pos, "ovr": SquadMeta.ovr_of(d, pos)}



	return _wnews_indice_mundo().get(nombre, {})








var _wnews_mundo: Dictionary = {}
var _wnews_mundo_cuadro: int = -1
func _wnews_indice_mundo() -> Dictionary:
	var cuadro: int = Engine.get_process_frames()
	if cuadro == _wnews_mundo_cuadro:
		return _wnews_mundo
	_wnews_mundo_cuadro = cuadro
	_wnews_mundo = {}
	var repes: Dictionary = {}
	var ids: Array = [Teams.FREE_ID]
	for t in Teams.all():
		var id: String = String((t as Dictionary).get("id", ""))
		if not id.is_empty() and id != Teams.FREE_ID:
			ids.append(id)
	for id in ids:
		for p in Squad.of(String(id)):
			var d: Dictionary = p
			var n: String = String(d.get("name", ""))
			if n.is_empty() or repes.has(n):
				continue
			if _wnews_mundo.has(n):
				_wnews_mundo.erase(n)
				repes[n] = true
				continue
			var pos: String = String(d.get("pos", ""))
			_wnews_mundo[n] = {"pos": pos, "ovr": SquadMeta.ovr_of(d, pos)}
	return _wnews_mundo





