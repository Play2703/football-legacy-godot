const _COACH_MARKS: GDScript = preload("res://ui/coach_marks.gd")












func _maybe_start_tour() -> void:
	if GameState.readonly_save or _tour_open:
		return
	var tid: String = _tour_id()
	if not Tours.AUTO.has(tid) or Settings.tour_done(tid):
		return
	if CareerUi.modal_open(self):
		return
	_run_tour(true)




func _show_tour() -> void:
	if _tour_open or CareerUi.modal_open(self):
		return
	if not Tours.has(_tour_id()):
		return
	_run_tour(false)





func _tour_id() -> String:
	if not _tab_id.is_empty():
		return _tab_id
	return CareerNav.tab_of_page(_page, _current_sub())











func _run_tour(first_time: bool) -> void:
	_tour_open = true
	await get_tree().process_frame
	await get_tree().process_frame




	if not is_instance_valid(_header) or not is_instance_valid(_content):
		_tour_open = false
		return
	if first_time:
		Settings.mark_tour_done(_tour_id())
	var tour: Control = _COACH_MARKS.new()
	add_child(tour)
	tour.finished.connect(func() -> void: _tour_open = false)
	tour.start(_tour_steps())








func _tour_steps() -> Array:
	var out: Array = []
	for st in Tours.steps(_tour_id()):
		var key: String = String(st.get("anchor", ""))
		out.append({
			"target":(func() -> Control: return _tour_target(key)),
			"title": String(st.get("title", "")),
			"body": String(st.get("body", "")),
		})
	return out






func _tour_target(key: String) -> Control:
	match key:
		"":
			return null
		"@header":
			return _header if is_instance_valid(_header) else null
		"@tabs":
			return _tabs if is_instance_valid(_tabs) else null
		"@nav":
			return _nav if is_instance_valid(_nav) else null
	return _head_row(key)
















func _head_row(es_text: String) -> Control:
	if _content == null or not is_instance_valid(_content):
		return null
	var want: String = CareerTheme.caps(I18n.t(es_text))
	var l: Label = _find_label(_content, want)
	if l == null:
		return null
	var row: Control = l.get_parent() as Control
	var target: Control = row if row != null else l




	if _scroll != null and is_instance_valid(_scroll):
		_scroll.ensure_control_visible(target)
	return target




func _close_tour() -> void:
	_tour_open = false
	for c in get_children():
		var scr: Script = c.get_script()
		if scr != null and scr.resource_path == "res://ui/coach_marks.gd":
			c.queue_free()


func _find_label(node: Node, want: String) -> Label:
	if node is Label and (node as Label).text == want:
		return node as Label
	for c in node.get_children():
		var hit: Label = _find_label(c, want)
		if hit != null:
			return hit
	return null











