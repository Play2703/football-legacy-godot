func _torn_top_tumbado(col: VBoxContainer, race: Array, key: String, accent: Color,
		include_you: bool, you_val: float, show_apps: bool, you_apps: int,
		you_team: String, filas: int = 0) -> void:
	var mi_equipo: String = you_team if not you_team.is_empty() \
			else GameState.player_team_id
	var rows: Array = _torn_ranking(race, key, include_you, you_val, you_apps, you_team)


	col.set_meta("top_jugadores", rows.size())
	col.set_meta("top_clave", key)
	var cuenta: Dictionary = {}
	for r in rows:
		cuenta[String(r["name"])] = int(cuenta.get(String(r["name"]), 0)) + 1





	var indices: Array = _torn_top_estira(_torn_top_ventana_modal(rows, include_you, mi_equipo),
		rows.size(), filas)




	var ancho_pos: float = 0.0
	var fuente: Font = get_theme_font("font", "Label")
	var mide: Callable = func(t: String, tam: int) -> float:
		return 0.0 if fuente == null else ceilf(fuente.get_string_size(t,
			HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x)
	for i in indices:
		if int(i) >= 0:
			ancho_pos = maxf(ancho_pos, mide.call(str(int(i) + 1), CareerTheme.T_LEE_TUMBADO))
	if ancho_pos <= 0.0:
		ancho_pos = TORN_COL_POS









	ancho_pos += maxf(ceilf(float(CareerTheme.T_LEE_TUMBADO) / 8.0 / 2.0) * 2.0, TORN_TOP_AIRE_MARCO)



	var pj_mayor: String = "8"
	for i in indices:
		if int(i) >= 0:
			var pj_txt: String = str(int((rows[int(i)] as Dictionary).get("apps", 0)))
			if mide.call(pj_txt, CareerTheme.T_LEE_TUMBADO) > mide.call(pj_mayor,
					CareerTheme.T_LEE_TUMBADO):
				pj_mayor = pj_txt


	var ancho_pj: float = maxf(mide.call(I18n.t("PJ", "tabla_liga"), CareerTheme.T_LEE_TUMBADO),
		mide.call(pj_mayor, CareerTheme.T_LEE_TUMBADO))


	var sep: float = float(CareerUi.FILA_TUMBADA_SEP)



	var ancho_cifra: float = 0.0
	for i in indices:
		if int(i) >= 0:
			var v: float = float((rows[int(i)] as Dictionary)["val"])
			ancho_cifra = maxf(ancho_cifra, mide.call(("%.1f" % v) if key == "avg"
				else str(int(v)), CareerTheme.T_DATO_TUMBADO))


	var tipo_icono: String = String(TORN_TOP_ICONOS.get(key, "media"))
	var ancho_val: float = maxf(ancho_cifra, ceilf(TORN_TOP_ICONO *(1.0
		- float(TORN_TOP_ICONO_SANGRIA.get(tipo_icono, 0.0))) +(TORN_TOP_AIRE_ROTULOS - sep
		if show_apps else 0.0)))
	if ancho_pj <= 0.0:
		ancho_pj = TORN_COL_NUM
	if ancho_val <= 0.0:
		ancho_val = TORN_COL_PTS











	var ancho_val_holgado: float = ancho_val
	if show_apps:
		var aire_pj: float = TORN_TOP_AIRE_CIFRAS if key == "avg" else TORN_TOP_AIRE
		ancho_val_holgado += maxf(0.0, TORN_TOP_AIRE_CIFRAS - sep -(ancho_val - ancho_cifra))
		ancho_val += maxf(0.0, aire_pj - sep -(ancho_val - ancho_cifra))





	var icono: HBoxContainer = HBoxContainer.new()
	icono.name = "IconoCifra"
	icono.alignment = BoxContainer.ALIGNMENT_END
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(TORN_TOP_ICONO, TORN_TOP_ICONO)
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.setup(tipo_icono, accent)
	icono.add_child(ic)
	icono.set_meta("top_icono", tipo_icono)
	var cab: Array = [{"texto": "", "ancho": ancho_pos},
		{"texto": "", "ancho": TORN_ESCUDO},
		{"texto": I18n.t("JUGADOR"), "expand": true}]
	if show_apps:
		cab.append({"texto": I18n.t("PJ", "tabla_liga"), "ancho": ancho_pj,
			"derecha": true})
	cab.append({"nodo": icono, "ancho": ancho_val})





	var cabecera: HBoxContainer = CareerUi.cabecera_tumbada(cab)
	(cabecera.get_child(0) as Control).custom_minimum_size.x = 0.0



	for c in cabecera.get_meta("fila_celdas", []):
		if c is Label:
			(c as Label).add_theme_color_override("font_color", CareerTheme.TEXT_MID)
			(c as Label).add_theme_font_size_override("font_size", CareerTheme.T_LEE_TUMBADO)
	col.add_child(cabecera)


	col.set_meta("top_fijo", float(CareerUi.FILA_TUMBADA_CANAL) + ancho_pos + TORN_ESCUDO
		+ ancho_val +(ancho_pj + sep if show_apps else 0.0) + 3.0 * sep + sep)

	col.set_meta("top_val", ancho_val)
	col.set_meta("top_val_holgado", ancho_val_holgado)
	for i in indices:
		if int(i) == TORN_TOP_CORTE:
			col.add_child(_torn_top_corte())
			continue
		if int(i) < 0:
			var puntos: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_DIM)
			puntos.text = "···"
			puntos.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			puntos.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
			puntos.custom_minimum_size.y = TORN_FILA_H
			puntos.size_flags_vertical = Control.SIZE_EXPAND_FILL
			puntos.set_meta("top_fila", true)
			col.add_child(puntos)
			continue
		var row: Dictionary = rows[int(i)]
		var you: bool = bool(row["you"])
		var club: String = String(row["team"])
		var nombre: String = String(row["name"])
		if not you and int(cuenta.get(nombre, 0)) > 1:
			var team: Dictionary = Teams.by_id(club)
			if team.is_empty():
				team = Nations.as_team(club)
			nombre = "%s · %s" % [nombre, BRACKET_TREE.sigla_legible(team)]
		var celdas: Array = [
			{"texto": str(int(i) + 1), "ancho": ancho_pos, "derecha": true},
			{"nodo": _torn_escudo(club, TORN_ESCUDO)},
			{"texto": nombre, "expand": true, "color": accent if you else CareerTheme.TEXT}]
		if show_apps:
			celdas.append({"texto": str(int(row.get("apps", 0))), "ancho": ancho_pj,
				"derecha": true, "color": CareerTheme.TEXT_MID})
		celdas.append({"texto":("%.1f" % float(row["val"])) if key == "avg"
			else str(int(row["val"])), "ancho": ancho_val, "derecha": true,
			"tam": CareerTheme.T_DATO_TUMBADO, "color": accent})
		var f: PanelContainer = CareerUi.fila_tumbada(TORN_FILA_H, Color.TRANSPARENT, celdas,
			you, accent)
		var zona: Control = f.find_child("Zona", true, false) as Control
		if zona != null:
			zona.visible = false
		f.size_flags_vertical = Control.SIZE_EXPAND_FILL
		f.set_meta("torn_club", club)
		f.set_meta("top_fila", true)
		col.add_child(f)


		var nom: Label =(f.get_meta("fila_celdas") as Array)[2] as Label
		nom.set_meta("top_nombre", nombre)



		nom.set_meta("top_jugador", "%s|%s" % [String(row["name"]), club])







		var aire: float = TORN_TOP_AIRE
		if show_apps:
			aire = maxf(0.0, TORN_TOP_AIRE - sep)
		nom.set_meta("top_aire", aire)
		var raiz: Node = col.get_parent() if col.get_parent() != null else col
		nom.resized.connect(_torn_top_nombres_modal.bind(raiz))








