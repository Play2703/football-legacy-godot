func _caja_alcanza_pid(tipo: String) -> String:
	if tipo == Iap.TIPO_LOTE or _caja_motivo.is_empty() or String(_caja_motivo.get("tipo", "")) !=(
			"dinero" if tipo == Iap.TIPO_DINERO else "puntos"):
		return ""
	var falta: int = int(_caja_motivo.get("precio", 0)) - Career.money
	if tipo == Iap.TIPO_PUNTOS or falta <= 0:
		return ""
	var mejor: String = ""
	var menor: int = -1
	for p in Iap.de_tipo(tipo):
		var d: Dictionary = p as Dictionary
		var cuanto: int = int(d.get("cuanto", 0))
		if cuanto >= falta and (menor < 0 or cuanto < menor) \
				and not Store.precio_de(String(d["pid"])).is_empty():
			menor = cuanto
			mejor = String(d["pid"])
	return mejor







func _caja_linea(p: Dictionary, alcanza: bool) -> String:
	if String(p.get("tipo", "")) == Iap.TIPO_LOTE:
		var ent: Dictionary = p.get("entrega", {})
		if String(p.get("grupo", "")) == "coleccion":
			return I18n.t("YA LA TIENES: SE PONE EN TIENDA, EN BOTAS") if _caja_lote_tuyo(ent) \
					else I18n.t("SE PONE EN TIENDA, EN BOTAS")
		return I18n.tf("QUEDARÍAS CON ${0} Y {1} PUNTOS", [
			CareerUi.money(Career.money + int(ent.get("dinero", 0))),
			Career.skill_points + int(ent.get("puntos", 0))])
	var cuanto: int = int(p.get("cuanto", 0))
	if String(p.get("tipo", "")) == Iap.TIPO_PUNTOS:


		if Career.skills_maxed():
			return I18n.tf("TUS HABILIDADES ESTÁN AL MÁXIMO: ENTRARÍAN COMO ≈{0} XP",
				[Career.xp_for_skill_points(cuanto)])
		return I18n.tf("QUEDARÍAS CON {0} PUNTOS", [Career.skill_points + cuanto])
	var extra: int = int(p.get("puntos_extra", 0))
	if extra > 0:
		return I18n.tf("QUEDARÍAS CON ${0} Y {1} PUNTOS",
			[CareerUi.money(Career.money + cuanto), Career.skill_points + extra])
	if alcanza:
		return I18n.tf("ALCANZA PARA {0}", [String(_caja_motivo.get("que", ""))])

	var hasta: int = Career.money + cuanto
	var mejor: String = ""
	var mejor_p: int = -1
	for c in _comprables():
		var precio: int = int((c as Dictionary)["price"])
		if precio > Career.money and precio <= hasta and precio > mejor_p:
			mejor_p = precio
			mejor = String((c as Dictionary)["name"])
	if mejor.is_empty():
		return I18n.tf("QUEDARÍAS CON ${0}", [CareerUi.money(hasta)])
	return I18n.tf("TE ALCANZARÍA PARA: {0}", [mejor])





func _comprables() -> Array:
	var out: Array = []
	for b in Shop.BOOTS:
		var bid: String = String((b as Dictionary)["id"])
		if int((b as Dictionary).get("price", 0)) > 0 and not Career.owned.has(bid) \
				and Career.boots_wait(bid) == 0:
			out.append({"name": I18n.t(String(b["name"])),
				"price": Career.shop_price("boots", b)})
	for l in Shop.LIFESTYLE:
		var lid: String = String((l as Dictionary)["id"])
		var anual_gastada: bool = bool((l as Dictionary).get("season_once", false)) \
				and not Career.donacion_available()
		if (not Career.has_lifestyle(lid) or bool((l as Dictionary).get("repeat", false))) \
				and not anual_gastada and Career.lifestyle_house_ok(lid):
			out.append({"name": I18n.t(String(l["name"])),
				"price": Career.shop_price("lifestyle", l)})
	for v in Shop.INVESTMENTS:
		var vid: String = String((v as Dictionary)["id"])
		if not Career.has_investment(vid) and Career.investment_house_ok(vid):
			out.append({"name": I18n.t(String(v["name"])), "price": int(v["price"])})
	var sig: Dictionary = Shop.agent_next(Career.agent_level)
	if not sig.is_empty():
		out.append({"name": I18n.t(String(sig["name"])), "price": int(sig["price"])})
	if ClubStore.available():
		for m in Shop.merch_catalog(GameState.player_div()):
			if not Career.has_club_merch(String((m as Dictionary)["id"])):
				out.append({"name": I18n.t(String(m["name"])),
					"price": Career.shop_price("merch", m)})
	return out













