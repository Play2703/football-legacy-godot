func _legacy_ladder(score: int) -> Control:
	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	var cuts: Array = []
	for i in 4:
		cuts.append(int(Legacy.TIERS[i]["min"]))
	var seg_w: float =(700.0 - 6.0 * float(cuts.size() - 2)) / float(cuts.size() - 1)
	for i in cuts.size() - 1:
		var lo: int = int(cuts[i])
		var hi: int = int(cuts[i + 1])
		var frac: float = clampf(float(score - lo) / float(maxi(hi - lo, 1)), 0.0, 1.0)
		row.add_child(CareerUi.stat_bar(frac, CareerTheme.accent(), seg_w))
	return row




const RULES_MAX: int = 8









func _legacy_rules() -> void:
	CareerUi.head(_content, I18n.t("COMO SE SUBE"))
	CareerUi.dim(_content, I18n.t("Goles, asistencias y partidos con tu selección"
		+ " suman siempre — los primeros valen mucho y el volumen se aplana."
		+ " Los trofeos suman entero lo suyo:"))


	var steps: Array = []
	for i in range(1, 4):
		steps.append(I18n.tf("{0} a los {1}", [I18n.t(String(Legacy.TIERS[i]["name"])),
			int(Legacy.TIERS[i]["min"])]))
	CareerUi.dim(_content, " · ".join(steps))



	var awards: Array = []
	for a in Legacy.AWARD_POINTS:
		if String(a) in Legacy.FLAVOR_ONLY or String(a) in Legacy.REPEATABLE:
			continue
		if not Trophies.of(String(a)).is_empty():
			awards.append(String(a))
	awards.sort_custom(func(x, y): return int(Legacy.AWARD_POINTS[x]) > int(Legacy.AWARD_POINTS[y]))
	var grid: GridContainer = GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override("h_separation", 12)
	grid.add_theme_constant_override("v_separation", 8)
	_content.add_child(grid)
	for i in mini(RULES_MAX, awards.size()):
		var a: String = String(awards[i])
		var info: Dictionary = Trophies.of(a)
		var chip: PanelContainer = CareerUi.chip()
