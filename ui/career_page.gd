func _to_t_cruceta(ev: InputEvent, i: int) -> void:
	if Entrada.modo != Entrada.Modo.MANDO:
		return
	var d: int = 0
	if ev.is_action_pressed("ui_up", true):
		if i == 0:
			return
		d = -1
	elif ev.is_action_pressed("ui_down", true):
		d = 1 if i < _to_t_filas.size() - 1 else 0
	elif ev.is_action_pressed("ui_left", true):
		d = 0
	else:
		return
	get_viewport().set_input_as_handled()
	if d != 0:
		_to_t_mueve.call_deferred(i + d)


func _to_t_mueve(a: int) -> void:
	var filas: VBoxContainer = _to_t_caja_filas
	if filas == null or not is_instance_valid(filas) or _to_t_filas.is_empty():
		return
	_to_t_sel = clampi(a, 0, _to_t_filas.size() - 1)

	_to_t_pinta(filas, _to_t_plan_que_cabe(filas.size.y) if filas.size.y > 0.0 \
			else (filas.get_meta("to_t_plan", []) as Array))
	var b: Button = filas.find_child("Fila%d" % _to_t_sel, false, false) as Button
	if b != null:
		b.grab_focus()





func _to_t_vecinos() -> void:
	var filas: VBoxContainer = _to_t_caja_filas
	if filas == null or not is_instance_valid(filas):
		return
	var fila: Button = filas.find_child("Fila%d" % _to_t_sel, false, false) as Button
	if fila == null or not fila.is_inside_tree():
		return
	var pais: Button = _to_t_pais if is_instance_valid(_to_t_pais) else null
	var mas: Button = _to_t_mas if is_instance_valid(_to_t_mas) else null
	var goles: Button = _to_t_goles if is_instance_valid(_to_t_goles) else null
	var lig: Button = _to_t_liguilla if is_instance_valid(_to_t_liguilla) else null
	var der: Button = mas if mas != null else (goles if goles != null else lig)
	fila.focus_neighbor_right = fila.get_path_to(der if der != null else fila)
	fila.focus_neighbor_left = fila.get_path_to(fila)
	if _to_t_sel == 0:
		fila.focus_neighbor_top = fila.get_path_to(pais) if pais != null else NodePath()
	if _to_t_sel == _to_t_filas.size() - 1:
		fila.focus_neighbor_bottom = fila.get_path_to(fila)
	var bajo_mas: Button = goles if goles != null else lig
	if pais != null:
		pais.focus_neighbor_bottom = pais.get_path_to(mas if mas != null else fila)
		pais.focus_neighbor_left = pais.get_path_to(fila)
		pais.focus_neighbor_right = pais.get_path_to(pais)
	if mas != null:
		mas.focus_neighbor_left = mas.get_path_to(fila)
		mas.focus_neighbor_right = mas.get_path_to(mas)
		mas.focus_neighbor_top = mas.get_path_to(pais) if pais != null else NodePath()
		mas.focus_neighbor_bottom = mas.get_path_to(bajo_mas if bajo_mas != null else mas)
	if goles != null:
		goles.focus_neighbor_left = goles.get_path_to(fila)
		goles.focus_neighbor_right = goles.get_path_to(lig if lig != null else goles)
		goles.focus_neighbor_top = goles.get_path_to(mas if mas != null else goles)
		goles.focus_neighbor_bottom = goles.get_path_to(goles)
	if lig != null:
		lig.focus_neighbor_left = lig.get_path_to(goles if goles != null else fila)
		lig.focus_neighbor_right = lig.get_path_to(lig)
		lig.focus_neighbor_top = lig.get_path_to(mas if mas != null else lig)
		lig.focus_neighbor_bottom = lig.get_path_to(lig)





func _to_t_columna(accent: Color) -> VBoxContainer:
	var w: float = _torn_ancho_plantilla() - floorf(TO_T_TABLA_W * _to_t_k) \
			- float(roundi(TO_T_AIRE * _to_t_k))
	var col: VBoxContainer = VBoxContainer.new()
	col.name = "Columna"
	col.add_theme_constant_override("separation", TO_T_COL_SEP)
	col.custom_minimum_size.x = w
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.size_flags_vertical = Control.SIZE_EXPAND_FILL
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(_to_t_placa(accent, w))
	if not _to_t_filas.is_empty():
		var franjas: Array = []
		franjas.append_array(_to_t_franjas)
		_to_t_mas = _to_t_boton("Mas", "menu", I18n.t("MÁS"),
			_torn_lista_modal.bind(_torn_titulo_tabla(_to_t_vista), _to_t_filas, franjas, accent),
			_to_t_filas.size())
		col.add_child(_to_t_mas)
	var raw: Array = Career.league_race() if _to_t_mine \
			else Race.league(_torn_country, _torn_div, GameState.season_num)
	var race: Array = _torn_build_race(raw, _to_t_mine, "league")
	var tu: Dictionary = {"goals": float(Career.league_here("g")),
		"assists": float(Career.league_here("a")), "avg": Career.season_avg(),
		"pj": Career.league_here("pj")}
	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "Pie"
	fila.add_theme_constant_override("separation", TO_T_COL_SEP)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if not race.is_empty():
		_to_t_goles = _to_t_boton("Goleadores", "gol", I18n.t("GOLEADORES"),
			_torn_tops_modal.bind(race, _to_t_mine, tu, accent))
		fila.add_child(_to_t_goles)
	if Liguilla.aplica(_torn_country, _torn_div) and _to_t_vista != TORN_ANUAL:
		_to_t_liguilla = _to_t_boton("Liguilla", "torneos", I18n.t("LIGUILLA"),
			_torn_liguilla_modal.bind(accent, _to_t_mine, _to_t_vista))
		fila.add_child(_to_t_liguilla)
	if fila.get_child_count() > 0:
		col.add_child(fila)
	else:
		fila.free()
	return col



func _to_t_boton(nombre: String, icono: String, texto: String, cb: Callable,
		cuenta: int = -1) -> Button:
