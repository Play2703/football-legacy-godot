func _balon_galas(raiz: VBoxContainer, tumbado: bool) -> void:
	var hist: Array = Career.ballon_history
	if hist.is_empty():
		CareerUi.dim(raiz, I18n.t("Todavía no se ha entregado ninguno. Se"
			+ " falla al cerrar cada temporada, con los números de todo el mundo."))
		return

	var idx: int = -1
	for i in hist.size():
		if int((hist[i] as Dictionary).get("season", -1)) == _balon_season:
			idx = i
			break
	if idx < 0:
		idx = hist.size() - 1
		_balon_season = int((hist[idx] as Dictionary).get("season", -1))
	var gala: Dictionary = hist[idx]
	var izq: VBoxContainer = raiz
	var der: VBoxContainer = raiz
	if tumbado:
		var cols: Array = _balon_columnas(raiz)
		izq = cols[0]
		der = cols[1]
	_balon_selector(izq, idx, hist.size(), tumbado)
	_balon_ganador(izq, gala, tumbado)
	if tumbado:
		_balon_tu_puesto(izq, gala)
	_balon_gala_lista(der, gala, tumbado)



func _balon_selector(parent: VBoxContainer, idx: int, total: int, tumbado: bool) -> void:
	var row: HBoxContainer = HBoxContainer.new()
	row.name = "BalonSelector"
	row.add_theme_constant_override("separation", 8)
	parent.add_child(row)
	var prev: Button = _palm_arrow("<")
	prev.disabled = idx <= 0
	prev.pressed.connect(_cycle_balon.bind(-1))
	row.add_child(prev)
	var lbl: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, CareerTheme.TEXT)

	lbl.text = str(BallonDor.anio_de(_balon_season))
	lbl.clip_text = true
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(lbl)
	var next: Button = _palm_arrow(">")
	next.disabled = idx >= total - 1
	next.pressed.connect(_cycle_balon.bind(1))
	row.add_child(next)
	if tumbado:
		for b: Button in [prev, next]:
			b.custom_minimum_size = Vector2(CareerTheme.TOQUE_TUMBADO, CareerTheme.TOQUE_TUMBADO)


func _cycle_balon(dir: int) -> void:
	var hist: Array = Career.ballon_history
	for i in hist.size():
		if int((hist[i] as Dictionary).get("season", -1)) == _balon_season:
			var j: int = clampi(i + dir, 0, hist.size() - 1)
			_balon_season = int((hist[j] as Dictionary).get("season", -1))
			break
	_refresh()



func _balon_abre_gala(season: int) -> void:
	_balon_tab = "galas"
	_balon_season = season
	_balon_ver = "votacion"
	_refresh()






