func _hc_ventana(tabla: VBoxContainer, filas: Array, mundo: bool, med: Dictionary) -> void:
	var tu: int = -1
	for i in filas.size():
		if String((filas[i] as Dictionary)["club"]) == GameState.player_team_id:
			tu = i
	var caja: PanelContainer = PanelContainer.new()
