	return _torn_grupos_modal.bind(campo, accent)












func _torn_pais_por_clubes(baldosas: Array[Button], campo: Dictionary, accent: Color) -> void:
	var ip: int = -1
	for i in baldosas.size():
		if String(baldosas[i].get_meta("torn_dato", "")) == "pais":
			ip = i
	if ip < 0 or _torn_campo_tuyo(campo):
		return
	var lista: Button = _torn_baldosa_clubes_pais(campo, accent)
	if lista == null:
		return
	baldosas[ip].free()
	baldosas[ip] = lista
	if baldosas.size() < TORN_APOYO_BALDOSAS:
		var lider: Button = _torn_baldosa_lider(campo, accent)




		if lider != null and String(lider.get_meta("torn_club", "")) in \
				(lista.get_meta("torn_clubes", []) as Array):
			lider.free()
			lider = null
		if lider != null:
			baldosas.insert(ip, lider)



func _torn_campo_tuyo(campo: Dictionary) -> bool:
	for g in campo.get("groups", []):
		var t: Dictionary =(g as Dictionary).get("table", {})
		if t.has(GameState.YOU_KEY) or t.has(GameState.player_team_id):
			return true
	return false







func _torn_baldosa_clubes_pais(campo: Dictionary, accent: Color) -> Button:
