func _mt_cta_ajusta(cta: VBoxContainer) -> void:


	for b in cta.find_children("*", "Button", true, false):
		(b as Button).resized.connect(_mt_cta_letra.bind(b), CONNECT_DEFERRED)


	var fila: BoxContainer = cta.find_child("CtaPar", true, false) as BoxContainer
	if fila != null and fila.get_child_count() > 1:
		fila.resized.connect(_mt_cta_apila.bind(fila), CONNECT_DEFERRED)



func _mt_cta_apila(fila: BoxContainer) -> void:
	if not is_instance_valid(fila) or fila.size.x <= 0.0:
		return
	var n: int = fila.get_child_count()
	var medio: float =(fila.size.x - float(fila.get_theme_constant("separation")) *(n - 1)) / n
	var apila: bool = false
	for h in fila.get_children():
		var b: Button = h as Button
		if b == null:
			continue
		var f: Font = b.get_theme_font("font")
		var sb: StyleBox = b.get_theme_stylebox("normal")
		var hueco: float = medio -(sb.get_margin(SIDE_LEFT) + sb.get_margin(SIDE_RIGHT) if sb != null else 0.0)




		if f.get_string_size(b.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, CareerTheme.T_LEE_TUMBADO).x > hueco:
			apila = true
	if not apila or not fila is HBoxContainer:
		return

	var col: VBoxContainer = VBoxContainer.new()
	col.name = "CtaPila"
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
	var padre: Node = fila.get_parent()
	padre.add_child(col)
	padre.move_child(col, fila.get_index())
	for h in fila.get_children():
		h.reparent(col, false)
	fila.queue_free()




func _mt_cta_letra(b: Button) -> void:
	if not is_instance_valid(b) or b.size.x <= 0.0:
		return
	var px: int = CareerTheme.T_LEE_TUMBADO
	var par: Array = []
	for h in b.get_parent().get_children():
		if h is Button:
			par.append(h)
	for h in par:
		var o: Button = h as Button
		var f: Font = o.get_theme_font("font")
		var sb: StyleBox = o.get_theme_stylebox("normal")
		var hueco: float = o.size.x -(sb.get_margin(SIDE_LEFT) + sb.get_margin(SIDE_RIGHT) if sb != null else 0.0)
		if o.size.x > 0.0 and f.get_string_size(o.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x > hueco:
			px = CareerTheme.T_CAP_TUMBADO
	for h in par:
		if (h as Button).get_theme_font_size("font_size") != px:
			(h as Button).add_theme_font_size_override("font_size", px)




