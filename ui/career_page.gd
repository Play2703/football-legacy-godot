		var campo_c: Dictionary = cap.get("campo", {})
		baldosas.append(_torn_cuadro_baldosa(c["bracket"], c["names"], accent,
			c.get("team", {}), campo_c.get("seeds", [])))
	if cap.has("tops"):
		var t: Dictionary = cap["tops"]
		var race: Array = t["race"]
		var mine: bool = bool(t["mine"])
		var tu: Dictionary = t["tu"]
		var abre: Callable = _torn_tops_modal.bind(race, mine, tu, accent)

		var goles: Button = _torn_baldosa_top(race, "goals", "balon_rol", I18n.t("GOLES"),
			mine, tu, accent, abre)



		if goles != null:
			var plegados: bool = baldosas.size() + 3 > TORN_APOYO_MAX
			baldosas.append(goles)
			if not plegados:
				for spec in [["assists", "vision", "ASIST."], ["avg", "stats", "MEDIA"]]:
					var b: Button = _torn_baldosa_top(race, String(spec[0]), String(spec[1]),
						I18n.t(String(spec[2])), mine, tu, accent, abre)
					if b != null:
						baldosas.append(b)
	var clave: String = _torn_clave()
	var extras: Array[Callable] = []
	if (pa["contenido"] as Node).find_child("Camino", true, false) == null:

		extras.append(_torn_baldosa_proximo.bind(clave, accent, String(h[0])))
	elif clave in ["cup", CopaLiga.COMP, CopaLigas.COMP]:





		extras.append(_torn_baldosa_proximo.bind(clave, accent, TORN_SIN_SEMANA))
	if clave == "nat":



		var sel: Button = cap.get("seleccion") as Button
		extras.append(_torn_baldosa_goleador_nat.bind(accent,
			sel.get_meta("torn_abre") as Callable if sel != null and sel.has_meta("torn_abre")
			else Callable()))
	extras.append(_torn_baldosa_titulos.bind(clave, accent))
	extras.append(_torn_baldosa_vigente.bind(clave, accent))
	extras.append(_torn_baldosa_pais.bind(cap.get("campo", {}), accent))
	extras.append(_torn_baldosa_record.bind(clave, accent))
	for hace in extras:
		if baldosas.size() >= TORN_APOYO_BALDOSAS:
			break
		var extra: Button = hace.call() as Button
		if extra != null:
			baldosas.append(extra)
	_torn_pais_por_clubes(baldosas, cap.get("campo", {}), accent)


	apoyo.set_meta("torn_campo", cap.get("campo", {}))
	for b in baldosas:
		b.size_flags_vertical = Control.SIZE_EXPAND_FILL
		apoyo.add_child(b)


	CareerUi.baldosas_avance_juntas(baldosas)

	_torn_heroe_cabe(heroe, float(pa["ancho_apoyo"]))




const TORN_APOYO_BALDOSAS: int = 3


const TORN_SIN_SEMANA: String = "*"

const TORN_APOYO_MAX: int = 4




func _torn_clave() -> String:
	match _torn_comp:
		"champions":
			return "ucl"
		"europa":
			return "eul"
		"conference":
			return "conf"
		"copa":
			return "cup"
		"copaliga", "ligas", "cwc", "nat":
			return _torn_comp
	return Continental.comp_de_marca(_torn_comp)








func _torn_kind_palmares(clave: String, club: String) -> String:
	match clave:
		"cup":
			return "copa"
		"cwc":
			return "clubes"
		"ucl", "lib", "cca":
			if Teams.confed_of_country(Teams.country_of(club)) == Continental.confed_de(clave):
				return "champions"
	return ""











func _torn_baldosa_proximo(clave: String, accent: Color, sin_semana: String = "") -> Button:
	var b: Button = null
	if clave == "nat":
		b = _torn_baldosa_partido_nat(accent, sin_semana)
	else:
		b = _torn_baldosa_rival(clave, "jornada", I18n.t("SIGUIENTE"), accent,
			func() -> void: SceneFade.to_scene("res://ui/career_hub.tscn"), sin_semana)
	if b != null:
		b.name = "Proximo"
		b.set_meta("torn_dato", "proximo")
	return b






func _torn_baldosa_rival(clave: String, icon_type: String, rotulo: String, accent: Color,
		on_tap: Callable, sin_semana: String = "") -> Button:
	if clave.is_empty():
		return null
	for k in range(maxi(GameState.season_day, 0), GameState.calendar.size()):
		var f: Dictionary = GameState.calendar[k]
		if String(f.get("comp", "")) != clave or bool(f.get("dead", false)):
			continue
		if not _torn_fecha_del_torneo(clave, f):
			continue
		var opp: String = String(f.get("opp", ""))
		if opp.is_empty() or GameState.rival_of(f).is_empty():
			continue
		var semana: String = I18n.tf("S{0}", [k + 1])
		var b: Button = CareerUi.baldosa_avance(icon_type, rotulo, accent,
			_torn_escudo(opp, 48.0), _torn_nombre_de(opp),
			"" if semana == sin_semana or sin_semana == TORN_SIN_SEMANA else semana,
			I18n.t("LOCAL") if bool(f.get("home", false)) else I18n.t("FUERA"), on_tap)
		(b.get_meta("avance_cifra") as Label).add_theme_font_size_override("font_size",
			CareerTheme.T_LEE_TUMBADO)


		CareerUi.avance_corto(b, _torn_sigla_de(opp), true)


		b.set_meta("avance_tu_al_lado", true)
		return b
	return null







func _torn_baldosa_partido_nat(accent: Color, sin_semana: String = "") -> Button:
	if Career.nationality.is_empty():
		return null
	for k in range(maxi(GameState.season_day, 0), GameState.calendar.size()):
		var f: Dictionary = GameState.calendar[k]
		if String(f.get("comp", "")) != "nat" or bool(f.get("dead", false)):
			continue
		if not _torn_fecha_del_torneo("nat", f):
			continue
		var opp: String = String(f.get("opp", ""))
		if opp.is_empty() or GameState.rival_of(f).is_empty():
			continue
		var cruce: String = "%s - %s" % [Nations.display_name(Career.nationality),
			_torn_nombre_de(opp)]


		var semana: String = I18n.tf("S{0}", [k + 1])
		var donde: String = I18n.t("LOCAL") if bool(f.get("home", false)) else I18n.t("FUERA")
		var cuando: String = donde if semana == sin_semana else semana + " · " + donde








		var bandera: Control = Flags.make_rect(opp, 48.0) if Flags.has(opp) \
				else _torn_escudo(opp, 48.0)
		var b: Button = CareerUi.baldosa_avance("jornada", I18n.t("SIGUIENTE"), accent,
			bandera, cruce, "", cuando,
			func() -> void: SceneFade.to_scene("res://ui/career_hub.tscn"))
		var mia: String = _torn_sigla_de(Career.nationality)
		var suya: String = _torn_sigla_de(opp)
		if not mia.is_empty() and not suya.is_empty():


			CareerUi.avance_corto(b, "%s - %s" % [mia, suya], true)
		b.set_meta("torn_cruce_nat", true)

		b.set_meta("avance_tu_al_lado", true)
		return b
	return null













