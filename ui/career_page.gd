func _leg_reparto(contenido: VBoxContainer, cifras: Control, torneos: VBoxContainer,
		temporadas: VBoxContainer, n: int) -> void:
	if not is_instance_valid(contenido) or not is_instance_valid(temporadas) \
			or contenido.size.y <= 0.0:
		return
	var sep: float = float(contenido.get_theme_constant("separation"))
	var cab: Control = temporadas.get_meta("leg_cab") as Control
	var cab_h: float = cab.get_combined_minimum_size().y \
			+ float(temporadas.get_theme_constant("separation"))
	var libre: float = contenido.size.y - cifras.get_combined_minimum_size().y - sep



	if _scroll != null and is_instance_valid(_scroll) and _scroll.size.y > 0.0:
		libre -= maxf(contenido.get_global_rect().end.y - _scroll.get_global_rect().end.y, 0.0)
	if torneos != null:


		var en_linea: float = torneos.get_combined_minimum_size().y
		var plegar: bool = libre - en_linea - sep < cab_h + float(mini(n, 3)) * LEG_FILA_H
		var pliegue: Button = contenido.get_meta("leg_pliegue") as Button \
				if contenido.has_meta("leg_pliegue") else null
		if plegar and pliegue == null:
			pliegue = _leg_torneos_baldosa(torneos.get_meta("leg_filas", []))
			contenido.add_child(pliegue)
			contenido.move_child(pliegue, torneos.get_index() + 1)
			contenido.set_meta("leg_pliegue", pliegue)
		if pliegue != null and pliegue.visible != plegar:
			pliegue.visible = plegar
		if torneos.visible == plegar:
			torneos.visible = not plegar
		libre -=(CareerTheme.TOQUE_TUMBADO if plegar else en_linea) + sep



	var suelo: float = cab_h + LEG_FILA_H
	if not is_equal_approx(temporadas.custom_minimum_size.y, suelo):
		temporadas.custom_minimum_size.y = suelo
	var sobra: float = maxf(libre - suelo, 0.0)
	var para_t: float = clampf(cab_h + float(n) * LEG_FILA_IDEAL - suelo, 0.0, sobra)
	var r_t: float = maxf(para_t, 0.001)
	var r_c: float = maxf(sobra - para_t, 0.001)
	if not is_equal_approx(temporadas.size_flags_stretch_ratio, r_t):
		temporadas.size_flags_stretch_ratio = r_t
	if not is_equal_approx(cifras.size_flags_stretch_ratio, r_c):
		cifras.size_flags_stretch_ratio = r_c


	var a: Array = temporadas.get_meta("leg_llena", [])
	if a.size() == 4:
		_leg_temp_llena(a[0], a[1], a[2], a[3], suelo + para_t - cab_h)





