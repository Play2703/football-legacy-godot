func _torn_nat_linea(callup: Dictionary) -> String:
	if Career.nat_caps > 0:
		var linea: String = I18n.tf("{0} PARTIDOS", [Career.nat_caps])
		if Career.nat_goals > 0:
			linea += " · " + I18n.tf("{0} GOLES", [Career.nat_goals])
		return linea
	if Career.nat_retired:
		return I18n.t("RETIRADO")
	match Career.nat_role_for(callup):
		"titular":
			return I18n.t("TITULAR")
		"banca":
			return I18n.t("SUPLENTE")
		"reserva":
			return I18n.t("RESERVA")
	return I18n.t("NO CONVOCADO")























func _torn_nat_hoja_tumbada(nat_name: String, accent: Color) -> void:
	var pa: Dictionary = CareerUi.plantilla_a_modal(self, I18n.tf("SELECCIÓN DE {0}",
		[CareerTheme.caps(nat_name)]), 0.0, 1100.0, TORN_NAT_HOJA_APOYO)
	if pa.is_empty():
		return
	var box: VBoxContainer = pa["modal"]
	box.set_meta("torn_nat_hoja", true)
	box.set_meta("torn_bloques", true)

	var cab: HBoxContainer = pa["cabecera"]
	var i: int = 0
	for c in _torn_nat_identidad():
		(c as Control).size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cab.add_child(c as Control)
		cab.move_child(c as Control, i)
		i += 1

	var cu: Dictionary = Career.nat_callup()
	var n: Dictionary = Career.nat_notice()
	var contenido: VBoxContainer = pa["contenido"]
	var bloques: Array = []
	if Career.nat_retired or n.is_empty():
		bloques = _torn_nat_hoja_retirado(nat_name, box)
	else:
		bloques = [_torn_nat_hoja_requisitos(cu, n),
			_torn_nat_hoja_escalera(cu, accent, float(pa["ancho_contenido"])),
			_torn_nat_hoja_puesto(cu, n, box)]


	for k in bloques.size():
		if k > 0:
			var aire: Control = Control.new()
			aire.size_flags_vertical = Control.SIZE_EXPAND_FILL
			aire.mouse_filter = Control.MOUSE_FILTER_IGNORE
			contenido.add_child(aire)
		contenido.add_child(bloques[k] as Control)
	if not (Career.nat_retired or n.is_empty()):
		_torn_nat_hoja_crece(contenido)
	_torn_nat_hoja_apoyo(pa, cu, n, accent)




