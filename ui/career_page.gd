func _torn_top_nombres_modal(raiz: Node) -> void:
	if not is_instance_valid(raiz):
		return
	var celdas: Array = []
	var nivel: int = 0
	for n in raiz.find_children("*", "Label", true, false):
		var l: Label = n as Label
		if l == null or not l.has_meta("top_nombre"):
			continue
		var formas: Array[String] = _torn_nombres_niveles(String(l.get_meta("top_nombre")))
		celdas.append([l, formas])
		var f: Font = l.get_theme_font("font")
		if f == null or l.size.x <= 0.0:
			continue

		if not l.has_meta("top_tam"):
			l.set_meta("top_tam", l.get_theme_font_size("font_size"))
		var tam: int = int(l.get_meta("top_tam"))
		var cabe: float = l.size.x - float(l.get_meta("top_aire", TORN_TOP_AIRE))

		var k: int = formas.size() - 1
		for i in formas.size():
			if f.get_string_size(formas[i], HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x <= cabe:
				k = i
				break
		nivel = maxi(nivel, k)
	for c in celdas:
		var l: Label = c[0]
		var formas: Array[String] = c[1]
		var k: int = mini(nivel, formas.size() - 1)
		l.text = formas[k]



		if l.has_meta("top_tam") and l.size.x > 0.0:
			var tam: int = int(l.get_meta("top_tam"))
			var f: Font = l.get_theme_font("font")
			var cabe: float = l.size.x - float(l.get_meta("top_aire", TORN_TOP_AIRE))
			var no_cabe: bool = f != null and f.get_string_size(formas[k],
				HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x > cabe
			l.add_theme_font_size_override("font_size", CareerTheme.T_CAP_TUMBADO
				if no_cabe else tam)








func _torn_nombres_niveles(nombre: String) -> Array[String]:
	var cola: String = ""
	var base: String = nombre
	var corte: int = nombre.find(" · ")
	if corte > 0:
		base = nombre.substr(0, corte)
		cola = nombre.substr(corte)
	var partes: PackedStringArray = base.strip_edges().split(" ", false)
	var apellido: String = _torn_apellido_corto(base)
	var pila: int = partes.size() - _torn_apellido(base).split(" ", false).size()
	if pila <= 0:

		var corto: String = nombre if apellido == base.strip_edges() else apellido + cola
		return [nombre, corto, corto]
	return [nombre, "%s. %s%s" % [partes[0].left(1), apellido, cola], apellido + cola]




func _torn_nombres_cortos(nombre: String) -> Array[String]:
	var out: Array[String] = []
	for f in _torn_nombres_niveles(nombre):
		if not (f in out):
			out.append(f)
	return out





const TORN_SUFIJOS: Array[String] = ["júnior", "junior", "jr", "filho", "neto",
	"sobrinho", "ii", "iii"]
const TORN_SUFIJOS_JR: Array[String] = ["júnior", "junior", "jr"]




static func _torn_apellido_corto(nombre: String) -> String:
	var apellido: String = _torn_apellido(nombre)
	var partes: PackedStringArray = apellido.split(" ", false)
	if partes.size() >= 2 and partes[partes.size() - 1].to_lower().trim_suffix(".") \
			in TORN_SUFIJOS_JR:
		partes[partes.size() - 1] = "Jr."
		return " ".join(partes)
	return apellido




const TORN_PARTICULAS: Array[String] = ["mac", "mc", "van", "von", "der", "den", "de", "di",
	"da", "du", "le", "la", "les", "del", "della", "dello", "degli", "dos", "das", "do", "ten",
	"ter", "el", "al", "ben", "bin", "ibn", "abu", "o", "d", "st", "st.", "san", "santa", "y"]

const TORN_PARTICULAS_INICIO: Array[String] = ["mac", "mc", "van", "von", "der", "den", "de",
	"di", "da", "du", "le", "la", "les", "del", "della", "dello", "degli", "dos", "das", "do",
	"ten", "ter"]







static func _torn_apellido(nombre: String) -> String:
	var partes: PackedStringArray = nombre.strip_edges().split(" ", false)
	if partes.is_empty():
		return nombre.strip_edges()
	var desde: int = partes.size() - 1


	if desde > 0 and partes[desde].to_lower().trim_suffix(".") in TORN_SUFIJOS:
		desde -= 1
	while desde > 0:
		var p: String = partes[desde - 1].to_lower().trim_suffix("'").trim_suffix("’")


		if not (p in TORN_PARTICULAS) or (desde == 1 and not (p in TORN_PARTICULAS_INICIO)):
			break
		desde -= 1
	return " ".join(partes.slice(desde))










func _torn_top_indices(rows: Array, top_n: int, include_you: bool, _mi_equipo: String) -> Array:
	var n: int = rows.size()
	var out: Array = range(mini(top_n, n))
	if not include_you:
		return out
	var tu: int = -1
	for i in n:
		if bool(rows[i]["you"]):
			tu = i
			break
	if tu < top_n:
		return out
	var desde: int = maxi(tu - TORN_VENTANA_VECINAS, top_n)
	if desde > top_n:
		out.append(-1)
	out.append_array(range(desde, mini(tu + TORN_VENTANA_VECINAS + 1, n)))
	return out
















func _torn_top_ventana_modal(rows: Array, include_you: bool, mi_equipo: String) -> Array:
	var out: Array = _torn_top_indices(rows, TORN_TOP_N, include_you, mi_equipo)
	if out.size() > TORN_TOP_N and not out.has(-1):
		out.insert(TORN_TOP_N, TORN_TOP_CORTE)
	return out









func _torn_top_estira(indices: Array, total: int, filas: int) -> Array:
	if indices.has(-1) or indices.size() >= filas:
		return indices
	var out: Array = indices.duplicate()
	var sig: int = 0
	for i in out:
		sig = maxi(sig, int(i) + 1)
	if not out.has(TORN_TOP_CORTE):
		if sig < TORN_TOP_N or sig >= total or filas - out.size() < 2:
			return out
		out.append(TORN_TOP_CORTE)
	while out.size() < filas and sig < total:
		out.append(sig)
		sig += 1
	return out



