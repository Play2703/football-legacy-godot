		nom.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		club.add_child(nom)
		datos.add_child(club)




		if not Teams.is_free(String(id)):
			nom.set_meta("peldano_entero", nom.text)
			nom.set_meta("peldano_corto", CareerTheme.caps(_torn_sigla_de(String(id))))
		CareerUi.letra_por_peldanos(nom, [CareerTheme.T_LEE_TUMBADO])
	var h: VBoxContainer = CareerUi.heroe(_money_short(int(n.get("fee", 0))), I18n.t("EL MÁS CARO"), ficha)
	(h.get_meta("heroe_cifra") as Label).add_theme_color_override("font_color", CareerTheme.MONEY)
	h.set_meta("ft_caro", n)
	return h



