		var dz: Label = CareerUi.plain(22, CareerTheme.DANGER)
		dz.text = I18n.t("El club ya cuenta con tu salida: no te convoca.")
		dz.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(dz)
		CareerUi.dim(_content, I18n.t("Renueva o busca club, o no juegas."))
	elif not Career.pending_precontract.is_empty():








		CareerUi.head(_content, I18n.t("PRECONTRATO FIRMADO"))
		var pz: Label = CareerUi.plain(22, CareerTheme.DANGER)
