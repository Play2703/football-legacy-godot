func _ct_t_frase() -> String:
	if Career.on_loan():
		var owner_name: String = String(Teams.by_id(
			String(Career.loan.get("parent", ""))).get("name", I18n.t("tu club")))
		return I18n.tf("CEDIDO · el contrato es con {0}", [owner_name])
	if Career.descartado():
		return I18n.t("El club ya cuenta con tu salida: no te convoca.")
	if not Career.pending_precontract.is_empty():
		return I18n.tf("Ya firmaste con {0}: el técnico cuenta menos contigo.",
			[Market.club_name(Career.pending_precontract)])
	if Career.is_frozen():
		return I18n.t("No renuevas: el club te vende y juegas menos hasta que salgas.")
	if Career.can_renew():
		return I18n.t("Es tu último año: el club ya te ofrece renovar.")
	if not _reneg_oferta_viva().is_empty():
		return I18n.t("Tu temporada da para pedir mejora: siéntate con el club.")
	var why: String = String(Career.renegotiation_gate().get("why", ""))
	if not why.is_empty():
		return I18n.t(why)
	return I18n.t("El club está contento con lo firmado.")



func _ct_t_plazo() -> PanelContainer:
	var quedan: int = int(Career.contract.get("seasons_left", 1))
	var ultimo: bool = quedan <= 1
	var chip: PanelContainer = CareerUi.code_chip(
		I18n.t("ÚLTIMO AÑO") if ultimo else I18n.tf("QUEDAN {0} TEMPORADAS", [quedan]),
		CareerTheme.MONEY if ultimo else CareerTheme.TEXT_MID, CareerTheme.T_CAP_TUMBADO, 16.0, 8.0)
	chip.name = "Plazo"
	chip.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	chip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return chip




func _ct_t_renovar() -> Button:
	var b: Button = Button.new()
	b.name = "Renovar"
	b.custom_minimum_size = Vector2(0.0, CT_T_BOTON_H)
	b.clip_text = true
	b.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	var reneg: Dictionary = Career.renegotiation_gate()
	var falta: Array = reneg.get("missing", []) as Array
	var gastada: bool = falta.has("cooldown") or falta.has("refused")
	if Career.can_renew():
		b.text = I18n.t("RENOVAR")
		CareerTheme.apply_button(b, CareerTheme.Kind.PRIMARY, CareerTheme.T_LEE_TUMBADO)
		b.pressed.connect(func() -> void: _on_tab("mercado"))
	elif not _reneg_oferta_viva().is_empty():
		b.text = I18n.t("RENEGOCIAR")
		CareerTheme.apply_button(b, CareerTheme.Kind.PRIMARY, CareerTheme.T_LEE_TUMBADO)
		b.pressed.connect(func() -> void: _on_tab("mercado"))
	else:
		b.disabled = true
		CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, CareerTheme.T_LEE_TUMBADO)
		if Career.on_loan():
			b.text = I18n.t("CEDIDO · NO SE RENUEVA")
		elif Career.concurso_tuyo():
			b.text = I18n.t("CONTRATOS CONGELADOS")
		elif gastada:
			b.text = I18n.t("EL AÑO QUE VIENE")
		elif int(Career.contract.get("seasons_left", 1)) > 1:
			b.text = I18n.t("SOLO EN TU ÚLTIMO AÑO")
		else:
			b.text = I18n.t("EL TÉCNICO NO RENUEVA")
	return b





