func _cuentas_cuerpo(c: Dictionary) -> VBoxContainer:
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 12)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var dinero: int = int(c["caja"])
	var tinta: Color = CareerTheme.DANGER if dinero < 0 else CareerTheme.MONEY
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 12)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(fila)
	fila.add_child(CareerUi.icon_stat("moneda", CareerUi.money(dinero), tinta, 30.0))
	var salud: int = int(c["salud"])
	var palabra: Label = CareerUi.plain(CareerTheme.T_BODY,
		CareerTheme.MONEY if salud == ClubFinance.SALUD_SANA else CareerTheme.DANGER)
	palabra.text = I18n.t(_CUENTAS_SALUD[clampi(salud, 0, _CUENTAS_SALUD.size() - 1)])
	palabra.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT


	palabra.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	palabra.clip_text = true
	palabra.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	fila.add_child(palabra)
	var fill: ColorRect = CareerUi.bar(col, tinta, 14.0)
	CareerUi.set_bar(fill, float(c["frac"]))
	CareerUi.bar_mark(fill, float(c["raya"]), CareerTheme.DANGER, 4.0)



	match int(c.get("proyecto", 0)):
		ClubFinance.PROYECTO_DUENO:

			col.add_child(CareerUi.icon_stat("corona", _dueno_palabra(str(c.get("dueno", ""))),
				CareerTheme.MONEY, 30.0))
		ClubFinance.PROYECTO_CRISIS:
			col.add_child(CareerUi.icon_stat("mercado", I18n.t("EN CRISIS"),
				CareerTheme.DANGER, 30.0))


	if int(c.get("socios", 0)) > 0:
		col.add_child(CareerUi.icon_stat("aficion", I18n.t("DE LOS SOCIOS"),
			CareerTheme.TEXT, 30.0))
	var pts: int = int(c["sancion"])
	var racha: int = int(c["racha"])
	if pts > 0:
		col.add_child(CareerUi.icon_stat("tarjeta", I18n.tf("-{0} PTS", [pts]),
			CareerTheme.DANGER, 30.0))
	elif racha > 0:
		col.add_child(CareerUi.icon_stat("tarjeta", I18n.tf("AVISO {0}/{1}",
			[racha, ClubFinance.FFP_RACHA]), CareerTheme.DANGER, 30.0))
	for n in col.find_children("*", "Control", true, false):
		(n as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
	return col



const _CUENTAS_SALUD: Array[String] = ["SANAS", "EN APURO", "FAIR PLAY"]





func _cuentas_modal() -> void:
	var c: Dictionary = Career.club_cuentas()
	if c.is_empty():
		return
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var tit: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.TEXT)
	tit.text = I18n.t("CUENTAS DEL CLUB")
	tit.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(tit)
	box.add_child(_cuentas_cuerpo(c))
	var ingreso: int = int(c["ingreso"])
	CareerUi.kv(box, I18n.t("INGRESOS / AÑO"), CareerUi.money(ingreso), CareerTheme.MONEY)
	CareerUi.kv(box, I18n.t("NOMINA / AÑO"), CareerUi.money(int(c["nomina"])),
		CareerTheme.DANGER if float(c["nomina"]) > float(ingreso) * ClubFinance.WAGE_DANGER
		else CareerTheme.TEXT)
	CareerUi.kv(box, I18n.t("RAYA ROJA"),
		CareerUi.money(roundi(float(ingreso) * ClubFinance.FFP_CAJA)), CareerTheme.DANGER)


	match int(c.get("proyecto", 0)):
		ClubFinance.PROYECTO_DUENO:
			CareerUi.kv(box, _dueno_palabra(str(c.get("dueno", ""))),
				I18n.tf("{0} TEMP", [int(c.get("proyecto_quedan", 0))]), CareerTheme.MONEY)
		ClubFinance.PROYECTO_CRISIS:
			CareerUi.kv(box, I18n.t("EN CRISIS"), I18n.t("TOCA VENDER"), CareerTheme.DANGER)
	if int(c.get("socios", 0)) > 0:
		CareerUi.kv(box, I18n.t("DE LOS SOCIOS"),
			I18n.tf("{0} TEMP", [int(c["socios"])]), CareerTheme.TEXT)

	if int(c.get("te_debe", 0)) > 0:
		CareerUi.kv(box, I18n.t("TE DEBE"), CareerUi.money(int(c["te_debe"])),
			CareerTheme.DANGER)
	var regla: Label = CareerUi.plain(21, CareerTheme.TEXT_DIM)
	regla.text = I18n.tf("Cerrar la temporada con la caja bajo la raya roja es un aviso. Dos seguidas: la liga siguiente empieza con -{0} puntos.",
		[ClubFinance.FFP_PUNTOS])
	regla.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(regla)
	var cerrar: Button = Button.new()
	cerrar.text = I18n.t("CERRAR")
	cerrar.custom_minimum_size = Vector2(0, 76)
	cerrar.clip_text = true
	CareerTheme.apply_button(cerrar, CareerTheme.Kind.NEUTRAL, 26)
	cerrar.pressed.connect(func() -> void: CareerUi.close_modal(box))
	box.add_child(cerrar)





func _dueno_palabra(perfil: String) -> String:
	match perfil:
		Duenos.JEQUE:
			return I18n.t("UN JEQUE")
		Duenos.MAGNATE:
			return I18n.t("UN MAGNATE")
		Duenos.FONDO:
			return I18n.t("UN FONDO")
	return I18n.t("DUEÑO NUEVO")






func _mesa_baja_a(cab: Control) -> void:
	var previo: int = -1
	for i in 10:
		await get_tree().process_frame
		if not is_instance_valid(_scroll) or not is_instance_valid(cab):
			return

		var y: int = maxi(roundi(cab.global_position.y - _scroll.global_position.y)
			+ _scroll.scroll_vertical - 16, 0)
		_scroll.scroll_vertical = y
		if y == previo and _scroll.scroll_vertical == y:
			return
		previo = y






func _mesa_cuerpo() -> void:

	_mesa_cromos = null
	var por: String = Career.gerencia_mesa_cerrada_por()



	var dias: int = Career.gerencia_jornadas_ventana()



	if por.is_empty():
		_content.add_child(CareerUi.icon_stat("reloj", I18n.tf("{0} J", [dias]),
			CareerTheme.accent_text(), 30.0))
	elif por == "ventana":
		_content.add_child(CareerUi.icon_stat("candado", I18n.t("MERCADO CERRADO"),
			CareerTheme.TEXT_DIM, 30.0))
	else:


		CareerUi.dim(_content, _mesa_cerrada_txt(por))
		return
	var saldo: Dictionary = Career.gerencia_mesa_saldo()
	if por.is_empty():
		_mesa_saldo_panel(saldo)


		_mesa_cromos_block()
	else:



		CareerUi.kv(_content, I18n.t("PRESUPUESTO"), CareerUi.money(int(saldo["base"])),
			CareerTheme.MONEY)


	var linea: String = Career.gerencia_linea()

	if not linea.is_empty():
		var pide: HBoxContainer = CareerUi.icon_stat("tecnico", I18n.t("EL TECNICO PIDE"),
			CareerTheme.TEXT_DIM, 30.0)
		var rot: Label = pide.get_child(1) as Label
		rot.clip_text = true
		rot.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		if Career.gerencia_linea_cumplida():
			var hecho: MenuIcon = MenuIcon.new()
			hecho.custom_minimum_size = Vector2(30, 30)
			hecho.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			hecho.setup("check", CareerTheme.accent_text())
			pide.add_child(hecho)
		var lin: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.accent_text())
		lin.text = I18n.t(LINEA_NOMBRE.get(linea, "MEDIOS"))
		pide.add_child(lin)
		_content.add_child(pide)


		var sin_linea: int = Career.gerencia_mesa_linea_coste() if por.is_empty() else 0
		if sin_linea > 0:
			_content.add_child(CareerUi.coste_fila([["tecnico", sin_linea]],
				I18n.t("NADIE PARA TU PUESTO")))
	if not por.is_empty():
		return









	var con_voz: bool = Career.peldano() < Gerencia.PELDANO_MESA
	if con_voz:
		_gerencia_prob(_content, Gerencia.prob_relacion(Career.gerencia_relacion()))
	var ir: Button = CareerUi.menu_row(I18n.t("BUSCAR EN EL RANKING"), "",
		CareerTheme.TEXT_DIM, "stats")
	ir.pressed.connect(func() -> void:


		_family = CareerNav.family_of_tab("ranking")
		_on_tab("ranking"))
	_content.add_child(ir)



	if con_voz:
		_mesa_rotulo(_content, I18n.t("VENDER"))
		_content.add_child(CareerUi.icon_stat("candado", I18n.tf("NIVEL {0}/{1}",
			[Gerencia.PELDANO_MESA, Gerencia.PELDANO_MAX]), CareerTheme.TEXT_DIM, 30.0))
	else:
		_mesa_rotulo(_content, I18n.tf("VENDER ({0})",
			[Career.gerencia_mesa_ventas().size()]))
		_mesa_vender()
	_mesa_dock(saldo)







func _mesa_saldo_panel(s: Dictionary) -> void:
	var caja: PanelContainer = CareerUi.plate()
	_content.add_child(caja)
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 8)
	caja.add_child(col)
	CareerUi.kv(col, I18n.t("PRESUPUESTO"), CareerUi.money(int(s["base"])),
		CareerTheme.MONEY)
	CareerUi.kv(col, I18n.tf("VENTAS ({0})", [int(s["n_ventas"])]),
		"+" + CareerUi.money(int(s["ventas"])), CareerTheme.MONEY)

	CareerUi.kv(col, I18n.tf("FICHAJES ({0})", [int(s["n_compras"])]),
		"-" + CareerUi.money(int(s["compras"])), CareerTheme.TEXT)
	var raya: ColorRect = ColorRect.new()
	raya.color = CareerTheme.SURFACE_LINE
	raya.custom_minimum_size = Vector2(0, 1)
	raya.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(raya)
	var queda: int = int(s["queda"])
	CareerUi.kv(col, I18n.t("QUEDA"), CareerUi.money(queda),
		CareerTheme.DANGER if queda < 0 else CareerTheme.MONEY)


	var vacia: int = Career.gerencia_mesa_caja_coste()
	if vacia > 0:
		col.add_child(CareerUi.coste_fila([["relaciones", vacia]],
			I18n.t("DEJAS LA CAJA VACIA")))
	CareerUi.kv(col, I18n.t("PLANTILLA"), "%d/%d" % [int(s["plantilla"]), int(s["max"])],
		CareerTheme.DANGER if _mesa_plantilla_mal(s) else CareerTheme.TEXT)


	var tope: Dictionary = Career.gerencia_tope()
	if int(tope["gastado"]) > 0:
		CareerUi.dim(_content, I18n.tf("Gastado en esta ventana: {0} de {1}.",
			[CareerUi.money(int(tope["gastado"])), CareerUi.money(int(tope["total"]))]))





func _mesa_plantilla_mal(s: Dictionary) -> bool:
	var pl: int = int(s["plantilla"])
	return (int(s["n_compras"]) > 0 and pl > int(s["max"])) \
			or (int(s["n_ventas"]) > 0 and pl < int(s["min"]))







func _mesa_vender() -> void:


	var mio: String = GameState.player_team_id
	for r in Career.gerencia_mesa_plantilla():
		var row: Dictionary = r


		var sig: String = "v|" + str(row)
		if not _mesa_reusa(sig):
			_mesa_firma(_mesa_fila_vende(row, mio), sig)




const MESA_ESTADO_W: float = 300.0








func _mesa_fila_vende(row: Dictionary, mio: String) -> HBoxContainer:
	var idx: int = int(row["idx"])
	var nombre: String = String(row["name"])
	var pos: String = String(row["pos"])
	var vendo: bool = bool(row["vendo"])
	var causa: String = String(row["causa"])
	var club: String = String(row["club"])
	var n_of: int = int(row["ofertas"])
	var d: Dictionary = _mesa_ident(mio, _mesa_visible(idx), nombre, pos)
	d["valor"] = CareerUi.short_money(int(row["fee"]))
	d["edad"] = int(row["edad"])
	d["ovr"] = int(row["ovr"])
	var b: Button
	if vendo and not club.is_empty():

		d["lugar"] = I18n.tf("AL {0} · {1}", [_mesa_club_txt(club),
			CareerUi.short_money(int(row["cobra"]))])


		d["lugar_col"] = CareerTheme.TEXT
		b = CareerUi.accion_compacta("check", I18n.t("VENDIDO"), CareerTheme.MONEY, true)
	elif vendo and n_of > 0:
		d["lugar"] = I18n.tf("HASTA {0}", [CareerUi.short_money(int(row["mejor"]))])
		d["lugar_col"] = CareerTheme.MONEY
		b = CareerUi.accion_compacta("moneda", I18n.tf("{0} OFERTAS", [n_of])
			if n_of > 1 else I18n.t("1 OFERTA"), CareerTheme.MONEY)
	elif vendo:


		d["lugar"] = I18n.t("SIN OFERTAS AÚN")
		d["lugar_col"] = CareerTheme.TEXT_DIM
		b = CareerUi.accion_compacta("reloj", I18n.t("EN VENTA"), _protege_col())
	elif not causa.is_empty():
		d["lugar"] = _mesa_causa_venta_corta(causa, pos)
		d["lugar_col"] = CareerTheme.DANGER
		b = CareerUi.accion_compacta("candado", I18n.t("NO SE VENDE"), CareerTheme.TEXT_DIM)
	else:
		if Career.gerencia_vende_coste(idx, nombre) > 0:

			d["lugar"] = I18n.tf("DE TUS {0} MEJORES", [Gerencia.VENDE_TOP])
			d["lugar_col"] = CareerTheme.DANGER
		b = CareerUi.accion_compacta("mercado", I18n.t("PONER EN VENTA"), _protege_col())
	b.custom_minimum_size.x = MESA_ESTADO_W
	b.size_flags_horizontal = Control.SIZE_SHRINK_END
	b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	b.pressed.connect(func() -> void:
		if vendo:
			_mesa_ofertas_modal(idx, nombre, pos)
			return
		var marca: int = _mesa_toque_marca()
		var c: String = Career.gerencia_mesa_vende(idx, nombre)
		if not c.is_empty():
			UiAudio.deny()
			_toast(_mesa_causa_venta(c, pos), CareerTheme.DANGER)
			return
		UiAudio.toggle(true)
		_mesa_refresca(_mesa_toque_limpio(marca)))
	var fila: HBoxContainer = _fila_ranking(d, func() -> void: _mesa_ficha_compa(idx))
	fila.add_child(b)
	return fila



func _mesa_club_txt(club: String) -> String:
	return CareerTheme.caps(Competitions.demarca(String(Teams.by_id(club).get("name", "?"))))










func _mesa_ofertas_modal(idx: int, nombre: String, pos: String) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var row: Dictionary = _mesa_fila_venta(idx, nombre)
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 16)
	box.add_child(cab)
	var med: OvrBadge = OvrBadge.new()
	med.setup(int(row.get("ovr", 0)), 34)
	med.mouse_filter = Control.MOUSE_FILTER_IGNORE
	cab.add_child(med)
	var pc: PanelContainer = CareerUi.pos_chip(pos)
	pc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	cab.add_child(pc)
	var nom: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.TEXT)
	nom.text = CareerUi.display_name(Competitions.demarca(nombre))
	nom.clip_text = true
	nom.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	nom.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cab.add_child(nom)
	var valor: int = int(row.get("fee", 0))
	CareerUi.kv(box, I18n.t("SU VALOR"), CareerUi.money(valor), CareerTheme.MONEY)
	var lista: VBoxContainer = VBoxContainer.new()
	lista.add_theme_constant_override("separation", 14)
	box.add_child(lista)
	var pie: HBoxContainer = HBoxContainer.new()
	pie.add_theme_constant_override("separation", 14)
	box.add_child(pie)
	var quita: Button = CareerUi.accion_compacta("cerrar", I18n.t("QUITAR DE VENTA"),
		CareerTheme.DANGER)
	pie.add_child(quita)
	var espera: Button = CareerUi.accion_compacta("reloj", I18n.t("ESPERAR"), _protege_col())
	pie.add_child(espera)
	espera.set_meta("atras", true)
	espera.pressed.connect(func() -> void: CareerUi.close_modal(box))
	quita.pressed.connect(func() -> void:
		var marca: int = _mesa_toque_marca()
		var c: String = Career.gerencia_mesa_vende(idx, nombre)
		CareerUi.close_modal(box)
		if not c.is_empty():
			UiAudio.deny()
			_toast(_mesa_causa_venta(c, pos), CareerTheme.DANGER)
			return
		UiAudio.toggle(false)
		_mesa_refresca(_mesa_toque_limpio(marca)))
	var pinta: Callable = func(_self: Callable) -> void:
		for c in lista.get_children():
			c.queue_free()
		var ofertas: Array = Career.gerencia_mesa_ofertas(idx, nombre)
		var faltan: int = Career.gerencia_mesa_ofertas_por_llegar(idx, nombre)
		var rot: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
		rot.clip_text = true
		rot.text = I18n.t("SIN OFERTAS AÚN") if ofertas.is_empty() \
				else (I18n.tf("{0} OFERTAS", [ofertas.size()]) if ofertas.size() > 1
				else I18n.t("1 OFERTA"))
		if faltan > 0:
			rot.text += "  ·  " + I18n.tf("{0} MÁS EN CAMINO", [faltan])
		lista.add_child(rot)
		for o in ofertas:
			_mesa_oferta_tarjeta(lista, o, idx, nombre, pos, func() -> void:
				_self.call(_self))
	pinta.call(pinta)



func _mesa_oferta_tarjeta(lista: VBoxContainer, o: Dictionary, idx: int, nombre: String,
		pos: String, repinta: Callable) -> void:
	var club: String = String(o["club"])
	var aceptada: bool = bool(o["aceptada"])
	var card: PanelContainer = CareerUi.plate()
	lista.add_child(card)
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 10)
	card.add_child(v)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 14)
	v.add_child(fila)
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(64, 64)
	crest.set_team(Teams.by_id(club))
	fila.add_child(crest)


	var izq: VBoxContainer = VBoxContainer.new()
	izq.alignment = BoxContainer.ALIGNMENT_CENTER
	izq.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	fila.add_child(izq)
	var nom: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
	nom.text = _mesa_club_txt(club)
	nom.clip_text = true
	nom.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	izq.add_child(nom)
	var pct: int = int(o["pct"])
	var pl: Label = CareerUi.plain(CareerTheme.T_CAPTION,
		CareerTheme.MONEY if pct >= 100 else CareerTheme.DANGER)
	pl.text = I18n.tf("{0} DE SU VALOR", ["%+d %%" %(pct - 100)])
	pl.clip_text = true
	izq.add_child(pl)

	var fee: Label = CareerUi.plain(CareerTheme.T_MONEY, CareerTheme.MONEY)
	fee.text = CareerUi.short_money(int(o["fee"]))
	fee.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	fee.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(fee)


	var barra: ColorRect = CareerUi.bar(v, CareerTheme.MONEY, 10.0)
	CareerUi.set_bar(barra, float(pct) / 130.0)
	CareerUi.bar_notch(barra.get_parent(), 100.0 / 130.0)
	var btns: HBoxContainer = HBoxContainer.new()
	btns.add_theme_constant_override("separation", 14)
	v.add_child(btns)
	var acepta: Button = CareerUi.accion_compacta("check",
		I18n.t("ACEPTADA") if aceptada else I18n.t("ACEPTAR"), CareerTheme.MONEY, aceptada)
	btns.add_child(acepta)
	acepta.pressed.connect(func() -> void:
		var marca: int = _mesa_toque_marca()
		var c: String = Career.gerencia_mesa_acepta(idx, nombre, club)
		if not c.is_empty():
			UiAudio.deny()
			_toast(_mesa_oferta_fallo_txt(c, pos), CareerTheme.DANGER)
			return
		UiAudio.toggle(not aceptada)
		repinta.call()
		_mesa_refresca(_mesa_toque_limpio(marca)))
	var pide: Button = CareerUi.accion_compacta("moneda", I18n.t("PEDIR MÁS"), _protege_col())
	pide.disabled = not bool(o["puede_pedir"])
	btns.add_child(pide)
	pide.pressed.connect(func() -> void:
		var marca: int = _mesa_toque_marca()
		var c: String = Career.gerencia_mesa_pide_mas(idx, nombre, club)
		match c:
			"sube":
				UiAudio.confirm()
				_toast(I18n.t("¡Sube su oferta!"), CareerTheme.MONEY)
			"no":
				UiAudio.deny()
				_toast(I18n.t("Se planta: no pone más."), CareerTheme.TEXT_DIM)
			"fuera":
				UiAudio.deny()
				_toast(I18n.t("Se ofende y retira su oferta."), CareerTheme.DANGER)
			_:
				UiAudio.deny()
				_toast(_mesa_oferta_fallo_txt(c, pos), CareerTheme.DANGER)
				return
		repinta.call()
		_mesa_refresca(_mesa_toque_limpio(marca)))



func _mesa_oferta_fallo_txt(causa: String, pos: String) -> String:
	match causa:
		"oferta": return I18n.t("Esa oferta ya no está.")
		"max": return I18n.t("Ya le pediste más: no pondrá más.")
		"aceptada": return I18n.t("Ya aceptaste una oferta.")
		"no_venta": return I18n.t("Ya no está en venta.")
	return _mesa_causa_venta(causa, pos)



func _mesa_causa_compra_corta(causa: String) -> String:
	match causa:
		"tuyo": return I18n.t("YA ES TUYO")
		"ido": return I18n.t("YA NO ESTA")
		"edad": return I18n.t("SE RETIRA")
		"cedido": return I18n.t("CEDIDO")
		"interes": return I18n.t("NO QUIERE VENIR")
		"club_no": return I18n.t("EL CLUB DIJO NO")
	return ""











func _mesa_ident(club: String, seat: int, nombre: String, pos: String) -> Dictionary:
	var d: Dictionary = {"club": club, "persona": {"pos": pos},
		"nombre": CareerUi.display_name(Competitions.demarca(nombre))}
	var p: Dictionary = Career.gerencia_ficha_de({"club": club, "seat": seat,
		"name": nombre})
	if p.is_empty():
		return d
	var persona: Dictionary = p.duplicate()
	persona["pos"] = pos
	d["persona"] = persona



	if Teams.is_free(club):
		d["nat"] = Nations.canon_id(String(p.get("nation", "")))
		d["lugar"] = String(Teams.free_team().get("name", ""))
		return d
	var f: Dictionary = WorldRanking.ficha({"club": club, "seat": seat,
		"seat0": Squad.home_seat(Squad.of(club), seat), "pos": pos})
	d["nat"] = String(f.get("nat", ""))
	d["lugar"] = String(f.get("club_name", ""))
	return d





func _mesa_ficha_compa(idx: int) -> void:
	var s: int = _mesa_visible(idx)
	if s >= 0:
		_ficha_de_asiento(GameState.player_team_id, s)



func _mesa_visible(idx: int) -> int:
	var sq: Array = Squad.of(GameState.player_team_id)
	for s in sq.size():
		if Squad.home_seat(sq, s) == idx:
			return s
	return -1





