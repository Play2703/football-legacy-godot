func _fichas(infos: Array) -> void:
	var cerca: Dictionary = {}
	var menor: int = -1
	for inf in infos:
		var falta: int = int((inf as Dictionary).get("falta", 0))
		if falta > 0 and (menor < 0 or falta < menor):
			menor = falta
			cerca = inf
	if not cerca.is_empty() and not cerca.has("tag"):
		cerca["tag"] = {"text": I18n.t("EL MÁS CERCA"), "fill": CareerTheme.SURFACE_HI,
			"ink": CareerTheme.TEXT}
		cerca["state_color"] = CareerTheme.TEXT
	for inf in infos:
		_ficha(inf as Dictionary)







const FOTO_FICHA: float = 92.0

func _ficha(inf: Dictionary) -> void:
	var id: String = String(inf["id"])
	var fam: String = String(inf["fam"])
	var spec: Dictionary = inf.duplicate()


	if fam == "botas":


		spec["board"] = _tablero_bota(id, inf.get("vs", {}))
	else:
		spec["chips"] = _chips_de(inf.get("stats", []), String(inf.get("suffix", "")))
	if inf.has("merch"):
		spec["icon_ctrl"] = _merch_icon(String(inf["merch"]))
	elif ShopPhoto.tiene_modelo(id):



		var foto: Control = ShopPhoto.rect(self, id, FOTO_FICHA)
		if bool(inf.get("locked", false)):
			foto.modulate.a = 0.45
		spec["icon_ctrl"] = foto
		spec["icon_lado"] = FOTO_FICHA
	var card: PanelContainer = CareerUi.item_card(spec)



	CareerUi.tocable_mando(card)
	_content.add_child(card)
	_shop_fichas[id] = card
	_shop_infos[id] = inf
	var sb: StyleBoxFlat = card.get_meta("sb")
	card.set_meta("base", [sb.bg_color, sb.border_color, sb.border_width_left])
	_estilo_elegida(card, String(_shop_sel.get(fam, "")) == id)



	if id == _shop_bought and String(_shop_sel.get(fam, "")) != id:
		_shop_bought = ""
		_celebrate_purchase(card, _shop_price_of(id))
	var origen: Array = [Vector2.ZERO, false]
	card.gui_input.connect(func(ev: InputEvent) -> void:
		var mb: InputEventMouseButton = ev as InputEventMouseButton
		if mb == null or mb.button_index != MOUSE_BUTTON_LEFT:
			return
		if mb.pressed:
			origen[0] = mb.global_position
			origen[1] = true
			return
		var toque: bool = bool(origen[1]) \
				and (mb.global_position -(origen[0] as Vector2)).length() <= 12.0
		origen[1] = false
		if toque:
			_elegir(fam, id))





func _estilo_elegida(card: PanelContainer, on: bool) -> void:
	var sb: StyleBoxFlat = card.get_meta("sb")
	var base: Array = card.get_meta("base")
	if on:
		sb.bg_color = CareerTheme.SURFACE_HI
		sb.border_color = CareerTheme.TEXT
		sb.set_border_width_all(3)
	else:
		sb.bg_color = base[0]
		sb.border_color = base[1]
		sb.set_border_width_all(int(base[2]))





func _elegir(fam: String, id: String) -> void:
	var antes: String = String(_shop_sel.get(fam, ""))
	var ahora: String = "" if antes == id else id
	_shop_sel[fam] = ahora
	for k in [antes, ahora]:
		if _shop_fichas.has(k) and is_instance_valid(_shop_fichas[k]):
			_estilo_elegida(_shop_fichas[k], k == ahora and not k.is_empty())
	_shop_dock()
	_vitrina_de(fam, ahora)
	if fam == "botas" and _shop_band != null and is_instance_valid(_shop_band) \
			and _shop_band.has_method("preview_boots"):
		_shop_band.preview_boots(ahora if not ahora.is_empty() else Career.boots)













func _vs_botas(b: Dictionary) -> Dictionary:
	var mias: Dictionary = Shop.boots_by_id(Career.boots)
	var partes: PackedStringArray = PackedStringArray()
	var mejor: bool = false
	var peor: bool = false
	for kv in [["pot", "POTENCIA"], ["pre", "PUNTERÍA"], ["efe", "EFECTO"]]:
		var d: int = roundi((float(b.get(String(kv[0]), 0.0))
			- float(mias.get(String(kv[0]), 0.0))) * 100.0)
		if d == 0:
			continue
		mejor = mejor or d > 0
		peor = peor or d < 0


		partes.append("%s %s%d" % [I18n.t(String(kv[1])), "+" if d > 0 else "", d])






	var dv: int = int(b.get("life", 0)) - int(mias.get("life", 0))
	var nota: String = ""
	if dv != 0 and int(b.get("life", 0)) > 0 and int(mias.get("life", 0)) > 0:
		nota = I18n.tf("DURA {0} MÁS" if dv > 0 else "DURA {0} MENOS", [absi(dv)])
		partes.append(nota)
	var col: Color = CareerTheme.TEXT
	if mejor != peor:
		col = CareerTheme.accent_ink() if mejor else CareerTheme.DANGER
	return {"txt": " · ".join(partes) if not partes.is_empty() else I18n.t("LO MISMO"),
		"color": col, "nota": nota}






func _tablero_bota(id: String, vs: Dictionary) -> Control:
	var b: Dictionary = Shop.boots_by_id(id)
	var mias: Dictionary = Shop.boots_by_id(Career.boots)



	var comparar: bool = not vs.is_empty() and not String(vs.get("nota", "")).is_empty()
	for k in ["pot", "pre", "efe"]:
		comparar = comparar or (not vs.is_empty() and roundi(float(mias.get(k, 0.0)) * 100.0) != 0)
	var cols: Array = []
	for kv in [["pot", "POTENCIA", "potencia"], ["pre", "PUNTERÍA", "precision"],
			["efe", "EFECTO", "efecto"]]:
		var c: Dictionary = {"icon": String(kv[2]), "label": I18n.t(String(kv[1])),
			"value": roundi(float(b.get(String(kv[0]), 0.0)) * 100.0), "suffix": "%"}
		if comparar:
			c["mine"] = roundi(float(mias.get(String(kv[0]), 0.0)) * 100.0)
		cols.append(c)
	if not comparar:
		return CareerUi.stat_board(cols)
	return CareerUi.stat_board(cols, I18n.t("VS LAS TUYAS"), String(vs.get("nota", "")))


func _info_bota(b: Dictionary) -> Dictionary:
	var id: String = String(b["id"])
	var life: int = int(b.get("life", 0))
	var precio: int = Career.shop_price("boots", b)
	var stats: Array = []


	for kv in [["pot", "POTENCIA"], ["pre", "PUNTERÍA"], ["efe", "EFECTO"]]:
		var v: int = roundi(float(b.get(String(kv[0]), 0.0)) * 100.0)
		if v != 0:
			stats.append({"label": String(kv[1]), "value": v})
	var inf: Dictionary = {"fam": "botas", "id": id, "icon": Shop.icon_of(b, "tienda"),
		"title": I18n.t(String(b["name"])), "stats": stats, "suffix": "%"}



	if life > 0:
		inf["line"] = I18n.tf("${1} POR PARTIDO · DURA {0}",
			[life, CareerUi.short_money(ceili(float(precio) / float(life)))])
	else:
		inf["line"] = I18n.t("SIN DESGASTE  ·  las de pago dan más")
	if Career.boots == id:
		inf["tag"] = {"text": I18n.t("LLEVAS PUESTAS"), "fill": CareerTheme.accent_fill(),
			"ink": CareerTheme.TEXT}
		inf["price"] = ""
		if life > 0:
			var frac: float = Career.boots_life_frac()
			inf["state"] = I18n.tf("VIDA {0}%  ·  se gastan al jugar", [roundi(frac * 100.0)])
			inf["bar"] = frac
			inf["bar_color"] = _skill_color(frac)
		inf["dock"] = [I18n.t("LLEVAS PUESTAS"), String(inf.get("state", inf["line"]))]
		return inf


	inf["vs"] = _vs_botas(b)
	if Career.owned.has(id):
		inf["tag"] = _tag_tuyo()
		inf["price"] = ""
		inf["cta"] = {"text": I18n.t("EQUIPAR"), "ok": true,
			"do": func() -> void: Career.equip_boots(id)}
		inf["dock"] = [I18n.t("TUYO"), String(inf["line"])]
		return inf
	var wait: int = Career.boots_wait(id)
	if wait > 0:


		inf["price"] = "$ %s" % CareerUi.money(precio)
		inf["price_color"] = CareerTheme.TEXT_DIM
		inf["price_sub"] = I18n.tf("VUELVE EN {0}", [wait])
		inf["dock"] = ["%s %s" % [I18n.tf("VUELVE EN {0}", [wait]),
			I18n.plural(wait, "PARTIDO", "PARTIDOS")], String(inf["line"])]
		return inf
	if precio <= 0:

		inf["price"] = ""
		inf["cta"] = {"text": I18n.t("EQUIPAR"), "ok": true,
			"do": func() -> void: _buy(id, func() -> bool: return Career.buy_boots(id))}
		inf["dock"] = [String(inf["line"]), ""]
		return inf
	_precio_compra(inf, "boots", b, precio, func() -> bool: return Career.buy_boots(id))
	inf["dock"] = [I18n.tf("SE ESTRENA AL COMPRAR · ROTA, VUELVE EN {0}",
		[int(b.get("cool", 0))]), String(inf.get("state", inf.get("price_sub", "")))]
	return inf


func _info_estilo(l: Dictionary) -> Dictionary:
	var lid: String = String(l["id"])
	var mine: bool = Career.has_lifestyle(lid)
	var stats: Array = Shop.lifestyle_stats(l)


	var upk: int = roundi(float(l.get("upkeep", 0)) * Career._upkeep_div_mult())
	var inf: Dictionary = {"fam": "estilo", "id": lid, "icon": Shop.icon_of(l, "estilo"),
		"title": I18n.t(String(l["name"])), "stats": stats,
		"line": I18n.tf("MANTENIMIENTO  -${0} / PARTIDO", [CareerUi.money(upk)]) if upk > 0
			else I18n.t("SIN MANTENIMIENTO"),
		"line_color": CareerTheme.MONEY if upk > 0 else CareerTheme.TEXT_DIM}

	var nota: String = ""
	if Shop.CASUAL_UNLOCKS.has(lid):
		var atu: String = I18n.t(String(
			(Shop.CASUAL_UNLOCKS[lid] as Dictionary).get("outfit_name", "")))
		nota = I18n.tf("Ya vistes el atuendo {0} en ASPECTO." if mine
			else "Te pones el atuendo {0} en ASPECTO.", [atu])
	if mine and not bool(l.get("repeat", false)):
		inf["tag"] = _tag_tuyo()
		inf["price"] = ""
		inf["dock"] = [I18n.t("TUYO"), nota if not nota.is_empty() else String(inf["line"])]

		if House.COCHES.has(lid):
			inf["ghost"] = {"text": I18n.t("VER EN CASA"), "icon": "local", "col": CareerTheme.NAV_CASA,
				"do": func() -> void: _puente("puente_casa", "casa")}
		elif not nota.is_empty():
			inf["ghost"] = {"text": I18n.t("PONÉRTELO"), "icon": "camiseta",
				"col": CareerTheme.NAV_MUNDO,
				"do": func() -> void: _puente("puente_aspecto", "aspecto")}
		return inf
	if bool(l.get("season_once", false)) and not Career.donacion_available():
		inf["price"] = ""
		inf["price_sub"] = I18n.t("YA ESTE AÑO")
		inf["dock"] = [I18n.t("YA ESTE AÑO"), String(inf["line"])]
		return inf
	if not Career.lifestyle_house_ok(lid):
		var requisito: String = I18n.t("COCHERA DE COLECCIÓN")
		inf["locked"] = true
		inf["price"] = "$ %s" % CareerUi.money(Career.shop_price("lifestyle", l))
		inf["price_color"] = CareerTheme.TEXT_DIM
		inf["price_sub"] = I18n.tf("PIDE {0}", [requisito])
		inf["state"] = I18n.tf("Necesitas {0} en tu casa.", [requisito])
		inf["ghost"] = {"text": I18n.t("VER EN CASA"), "icon": "local", "col": CareerTheme.NAV_CASA,
			"do": func() -> void: _puente("puente_casa", "casa")}
		inf["dock"] = [String(inf["state"]), String(inf["line"])]
		return inf
	_precio_compra(inf, "lifestyle", l, Career.shop_price("lifestyle", l),
		func() -> bool: return Career.buy_lifestyle(lid))
	inf["confirm"] = upk > 0 or _tiene_contra(stats)
	inf["dock"] = [String(inf["line"]),
		String(inf.get("state", nota if not nota.is_empty() else inf.get("price_sub", "")))]
	return inf







func _info_agente(sig: Dictionary) -> Dictionary:
	var sid: String = String(sig["id"])
	var ahora: float = Career.agent_cut_now()
	var nuevo: float = float(sig.get("cut", ahora))
	var upk: int = roundi(float(sig.get("upkeep", 0)) * Career._upkeep_div_mult())
	var saldo: int = roundi(float(int(Career.contract.get("wage", 0))) *(ahora - nuevo)) - upk
	var inf: Dictionary = {"fam": "inversiones", "id": sid, "icon": Shop.icon_of(sig, "agente"),
		"title": I18n.t(String(sig["name"])),
		"stats": Shop.agent_stats(sig, Career.agent_level),
		"line": I18n.tf("COMISIÓN {0}% · HOY {1}%",
			[str(snappedf(nuevo * 100.0, 0.1)), str(snappedf(ahora * 100.0, 0.1))])}
	_precio_compra(inf, "agent", sig, int(sig["price"]),
		func() -> bool: return Career.buy_agent())


	if Career.agent_level == 1 and not inf.has("state"):
		inf["state"] = I18n.tf("Te pones el atuendo {0} en ASPECTO.", [I18n.t("DE OFICINA")])
	inf["confirm"] = true
	inf["dock"] = [I18n.tf("MANTENIMIENTO  -${0} / PARTIDO", [CareerUi.money(upk)]),
		I18n.tf("SOBRE TU SUELDO: {0} / PARTIDO", ["%s$%s" % ["+" if saldo >= 0 else "-",
			CareerUi.money(absi(saldo))]])]
	return inf


func _info_inversion(v: Dictionary) -> Dictionary:
	var vid: String = String(v["id"])
	var stats: Array = Shop.investment_stats(v)




	var upk_inv: int = roundi(float(v.get("upkeep", 0)) * Career._upkeep_div_mult())
	var inf: Dictionary = {"fam": "inversiones", "id": vid, "icon": Shop.icon_of(v, "estilo"),
		"title": I18n.t(String(v["name"])), "stats": stats,
		"line": I18n.tf("MANTENIMIENTO  -${0} / PARTIDO", [CareerUi.money(upk_inv)])
			if upk_inv > 0 else I18n.t("PARA SIEMPRE · SIN MANTENIMIENTO")}
	if Career.has_investment(vid):



		var nivel: int = Career.staff_level(vid)
		var tope: int = Shop.staff_levels(v)
		var sube: int = Career.staff_upgrade_price(vid)
		if sube > 0:
			return _info_mejora_staff(inf, v, nivel, tope, sube)
		inf["tag"] = _tag_tuyo()
		inf["price"] = ""
		if tope > 1:
			inf["stats"] = stats + Shop.staff_level_stats(v, nivel)
			inf["state"] = Shop.staff_level_line(v, nivel)
			inf["dock"] = [I18n.tf("TUYO · NIVEL {0}/{1}", [nivel, tope]), String(inf["line"])]
			return inf
		inf["dock"] = [I18n.t("TUYO"), String(inf["line"])]
		return inf
	var precio: int = int(v["price"])
	if not Career.investment_house_ok(vid):



		var casa: String = I18n.t(String(
			House.extra_by_id(String(v.get("req_house", ""))).get("name", "")))
		inf["locked"] = true
		inf["price"] = "$ %s" % CareerUi.money(precio)
		inf["price_color"] = CareerTheme.TEXT_DIM
		inf["price_sub"] = I18n.tf("PIDE {0}", [casa])
		inf["state"] = I18n.tf("Necesitas {0} en tu casa.", [casa])
		inf["ghost"] = {"text": I18n.t("VER EN CASA"), "icon": "local", "col": CareerTheme.NAV_CASA,
			"do": func() -> void: _puente("puente_casa", "casa")}
		inf["dock"] = [I18n.tf("Necesitas {0} en tu casa.", [casa]), String(inf["line"])]
		return inf
	_precio_compra(inf, "investment", v, precio,
		func() -> bool: return Career.buy_investment(vid))
	inf["confirm"] = true
	if not Career.can_afford(precio):


		inf["state"] = I18n.tf("Llevas ahorrado el {0}%.",
			[clampi(int(100.0 * float(Career.money) / float(precio)), 0, 99)]) \
					+ "  ·  " + _falta_txt(precio)
	inf["dock"] = [String(inf["line"]), String(inf.get("state", inf.get("price_sub", "")))]
	return inf





func _info_mejora_staff(inf: Dictionary, v: Dictionary, nivel: int, tope: int,
		precio: int) -> Dictionary:
	var vid: String = String(v["id"])
	var frase: String = Shop.staff_level_line(v, nivel + 1)
	inf["stats"] = Shop.staff_level_stats(v, nivel + 1)
	inf["line"] = I18n.tf("SUBE A NIVEL {0} · PAGO ÚNICO", [nivel + 1])
	_precio_compra(inf, "staff", v, precio,
		func() -> bool: return Career.upgrade_staff(vid))
	inf["tag"] = {"text": I18n.tf("NIVEL {0}/{1}", [nivel, tope]), "ink": CareerTheme.TEXT,
		"outline": true}
	if not inf.has("state"):
		inf["state"] = frase
	inf["confirm"] = true
	var upk: int = roundi(float(v.get("upkeep", 0)) * Career._upkeep_div_mult())


	inf["dock"] = [String(inf["line"]),
		I18n.tf("MANTENIMIENTO  -${0} / PARTIDO", [CareerUi.money(upk)])]
	inf["modal"] = [frase]
	return inf


func _info_merch(item: Dictionary) -> Dictionary:
	var mid: String = String(item["id"])


	var stats: Array = Shop.merch_stats(item)
	for st in stats:
		if String((st as Dictionary)["label"]) == "ENERGÍA":
			(st as Dictionary)["value"] = maxi(1,
				roundi(Career.rest_delta_for(float(item.get("rest", 0.0)))))


	var left: int = int(Career.contract.get("seasons_left", 0))
	var inf: Dictionary = {"fam": "club", "id": mid, "merch": mid,
		"title": I18n.t(String(item["name"])), "stats": stats,
		"line": I18n.tf("MIENTRAS SIGAS AQUÍ · TE QUEDAN {0} {1}",
			[left, I18n.plural(left, "TEMPORADA", "TEMPORADAS")])}
	if Career.has_club_merch(mid):
		inf["tag"] = _tag_tuyo()
		inf["price"] = ""
		inf["dock"] = [I18n.t("TUYO"), String(inf["line"])]
		return inf
	_precio_compra(inf, "merch", item, Career.shop_price("merch", item),
		func() -> bool: return Career.buy_club_merch(mid))
	inf["dock"] = [String(inf["line"]), String(inf.get("state", inf.get("price_sub", "")))]
	return inf







func _info_vestuario(it: Dictionary) -> Dictionary:
	var iid: String = String(it["id"])
	var stats: Array = []
	var rel: Dictionary = it.get("rel", {})
	for k in rel:
		stats.append({"label": String(Shop.LIFESTYLE_LABELS.get(k, String(k).to_upper())),
			"value": int(rel[k])})
	var inf: Dictionary = {"fam": "consumibles", "id": iid,
		"icon": Shop.icon_of(it, "consumible"), "title": I18n.t(String(it["name"])),
		"stats": stats, "line": I18n.t(String(it["desc"]))}
	var have: int = int(Career.stock.get(iid, 0))
	if have > 0:
		inf["tag"] = {"text": "x%d" % have, "fill": CareerTheme.accent_fill(),
			"ink": CareerTheme.TEXT}
	var comprar: Callable = func() -> bool:
		var hecho: bool = Career.buy_item(iid)
		if hecho:
			_shop_sel.erase("consumibles")
		return hecho
	_precio_compra(inf, "item", it, Career.shop_price("item", it), comprar)
	inf["confirm"] = true
	var motivo: String = Career.item_block_reason(iid)
	if not motivo.is_empty() and motivo != "NO DISPONIBLE" and not inf.has("falta"):
		var espera: int = Career.item_wait(iid)
		inf["state"] = I18n.tf("HOY NO SIRVE: {0}", [
			I18n.tf("EN {0} {1}", [espera, I18n.plural(espera, "PARTIDO", "PARTIDOS")])
			if espera > 0 else I18n.t(motivo)])
	inf["dock"] = [String(inf.get("state", inf.get("price_sub", ""))), ""]
	return inf








func _shop_dock() -> void:
	if _tira_tumbada() and _page == "tienda":
		_ti_t_dock_repinta()
		return
	for c in _dock.get_children():
		_dock.remove_child(c)
		c.queue_free()
	var sel: String = String(_shop_sel.get(_shop_tab, ""))
	var inf: Dictionary = _shop_infos.get(sel, {}) if not sel.is_empty() else {}
	var panel: PanelContainer = PanelContainer.new()
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = CareerTheme.SURFACE_HI
	sb.border_color = CareerTheme.SURFACE_LINE
	sb.border_width_top = 2
	sb.set_corner_radius_all(CareerTheme.RADIUS)
	sb.content_margin_left = 16.0
	sb.content_margin_right = 16.0
	sb.content_margin_top = 10.0
	sb.content_margin_bottom = 10.0
	panel.add_theme_stylebox_override("panel", sb)
	panel.custom_minimum_size = Vector2(0, 130)
	_dock_add(panel)
	if not inf.is_empty():
		_dock_eleccion(panel, inf)


		if sel == _shop_bought:
			_shop_bought = ""
			_celebrate_purchase(panel, _shop_price_of(sel))
	else:
		_dock_reposo(panel)


func _dock_fila(panel: PanelContainer, icon: Control, titulo: String,
		lineas: Array) -> HBoxContainer:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 16)
	panel.add_child(fila)
	if icon != null:
		icon.custom_minimum_size = Vector2(56, 56)
		icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		fila.add_child(icon)
	var txt: VBoxContainer = VBoxContainer.new()
	txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	txt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	txt.add_theme_constant_override("separation", 4)
	fila.add_child(txt)
	var t: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.TEXT)
	t.text = titulo
	t.clip_text = true
	txt.add_child(t)
	for i in lineas.size():
		if String(lineas[i]).is_empty():
			continue
		var l: Label = CareerUi.plain(CareerTheme.T_DIM,
			CareerTheme.TEXT_DIM if i == 0 else CareerTheme.TEXT)
		l.text = String(lineas[i])


		l.clip_text = true
		CareerUi.autoshrink(l, 13)
		txt.add_child(l)
	return fila


func _dock_icono(inf: Dictionary) -> Control:
	if inf.has("merch"):
		return _merch_icon(String(inf["merch"]))
	if ShopPhoto.tiene_modelo(String(inf.get("id", ""))):
		return ShopPhoto.rect(self, String(inf["id"]), 56.0)
	var ic: MenuIcon = MenuIcon.new()
	ic.setup(String(inf.get("icon", "")), CareerTheme.TEXT)
	return ic


func _dock_eleccion(panel: PanelContainer, inf: Dictionary) -> void:
	var fila: HBoxContainer = _dock_fila(panel, _dock_icono(inf), String(inf["title"]),
		inf.get("dock", []))
	var cta: Dictionary = inf.get("cta", {})


	if inf.has("ghost") and (cta.is_empty() or not bool(cta.get("ok", false))):
		var g: Dictionary = inf["ghost"]






		var gb: Button = CareerUi.accion_compacta(String(g["icon"]), String(g["text"]),
			g["col"] as Color)
		gb.custom_minimum_size = Vector2(360, 64)
		gb.size_flags_horizontal = Control.SIZE_FILL
		gb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		gb.pressed.connect(g["do"] as Callable)
		fila.add_child(gb)
		return
	if cta.is_empty():
		return
	var b: Button = Button.new()
	b.text = String(cta["text"])
	b.custom_minimum_size = Vector2(360, CareerTheme.BTN_CTA_H)
	b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	b.clip_text = true
	b.disabled = not bool(cta.get("ok", false))





	CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL if bool(cta.get("money", false))
		else CareerTheme.Kind.PRIMARY,
		CareerTheme.T_MONEY if b.text.length() <= 11 else CareerTheme.T_VALUE)
	if bool(cta.get("money", false)):
		UiKit.set_cue(b, "ui_coin")
		_cifra_dorada(b)
	if b.disabled:
		UiKit.deny_tap(b)
	else:
		b.pressed.connect(_shop_pagar.bind(inf))
	fila.add_child(b)




func _dock_reposo(panel: PanelContainer) -> void:
	match _shop_tab:
		"consumibles":
			_dock_tus_cosas(panel)
		"caja":
			var ic: MenuIcon = MenuIcon.new()
			ic.setup("moneda", CareerTheme.MONEY)


			var volver: String = String(_caja_motivo.get("volver", ""))
			var falta: int = int(_caja_motivo.get("precio", 0)) - Career.money
			var linea2: String = ""
			if not volver.is_empty():
				linea2 = I18n.tf("TE FALTAN ${0} PARA {1}", [CareerUi.short_money(falta),
					String(_caja_motivo.get("que", ""))]) if falta > 0 \
							else I18n.tf("YA TE ALCANZA PARA {0}", [String(_caja_motivo.get("que", ""))])
			var fila: HBoxContainer = _dock_fila(panel, ic,
				"%s · $ %s" % [I18n.t("TU CARTERA"), CareerUi.money(Career.money)],
				[I18n.tf("{0} PUNTOS LIBRES", [Career.skill_points]), linea2])
			if not volver.is_empty():
				var vb: Button = Button.new()
				vb.text = I18n.tf("VOLVER A {0}", [_rotulo_familia(volver)])
				vb.custom_minimum_size = Vector2(300, 56)
				vb.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				vb.clip_text = true
				CareerTheme.apply_button(vb, CareerTheme.Kind.GHOST, CareerTheme.T_CAPTION)
				vb.pressed.connect(_select_shop.bind(volver))
				fila.add_child(vb)
		"botas":
			var b: Dictionary = Shop.boots_by_id(Career.boots)
			var inf: Dictionary = _info_bota(b) if not b.is_empty() else {}
			var fila_b: HBoxContainer = _dock_fila(panel, _dock_icono(inf),
				String(inf.get("title", "")), inf.get("dock", []))
			fila_b.add_child(_dock_pista(I18n.t("TOCA UNA BOTA PARA PROBÁRTELA")))
		"estilo":
			var up: int = Career.upkeep_total()
			var ic_e: MenuIcon = MenuIcon.new()
			ic_e.setup("estilo", CareerTheme.TEXT)
			var fila_e: HBoxContainer = _dock_fila(panel, ic_e, I18n.t("TU TREN DE VIDA"),
				[I18n.tf("MANTENIMIENTO  -${0} / PARTIDO", [CareerUi.money(up)]) if up > 0
					else I18n.t("SIN MANTENIMIENTO"), ""])
			fila_e.add_child(_dock_pista(I18n.t("TOCA UNA FICHA PARA ELEGIRLA")))
		"inversiones":
			var n: int = 0
			for v in Shop.INVESTMENTS:
				if Career.has_investment(String((v as Dictionary)["id"])):
					n += 1
			var ic_i: MenuIcon = MenuIcon.new()
			ic_i.setup("contrato_firma", CareerTheme.TEXT)
			var actual: Dictionary = Shop.agent_current(Career.agent_level)
			var fila_i: HBoxContainer = _dock_fila(panel, ic_i, I18n.t("TU PERSONAL"),
				[I18n.tf("TE LLEVA: {0}", [I18n.t(String(actual["name"]))
					if not actual.is_empty() else I18n.t("EL DE SIEMPRE")]),
