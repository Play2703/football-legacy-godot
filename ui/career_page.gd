func _shop_action(text: String, kind: CareerTheme.Kind, blocked: bool,
		on_pressed: Callable) -> Button:
	var b: Button = Button.new()
	b.text = text
	b.custom_minimum_size = Vector2(220, CareerTheme.BTN_ROW_H)
	b.disabled = blocked
	CareerTheme.apply_button(b, kind, CareerTheme.BTN_ROW_FONT)



	if text.begins_with("$"):
		UiKit.set_cue(b, "ui_coin")
		if kind == CareerTheme.Kind.NEUTRAL:
			_cifra_dorada(b)
	if blocked:




		UiKit.deny_tap(b, true)
	else:
		b.pressed.connect(on_pressed)
	return b













func _cifra_dorada(b: Button) -> void:
	var cue: String = String(b.get_meta("ui_cue", "ui_coin"))
	var pitch: float = float(b.get_meta("ui_pitch", 1.0))
	CareerTheme.apply_button_peldano(b, CareerTheme.MONEY, false)
	UiKit.set_cue(b, cue, pitch)




