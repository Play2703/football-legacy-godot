func _cifras_grid(parent: Container, items: Array) -> void:
	var grid: GridContainer = GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override("h_separation", 12)
	grid.add_theme_constant_override("v_separation", 12)
	parent.add_child(grid)
	for it in items:
		var card: PanelContainer = CareerUi.chip()
		card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		grid.add_child(card)
		var box: VBoxContainer = VBoxContainer.new()
		box.add_theme_constant_override("separation", 4)
		card.add_child(box)
		var l: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
		l.text = CareerTheme.caps(String(it[0]))


		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		box.add_child(l)
		var v: Label = CareerUi.plain(CareerTheme.T_MONEY,
			it[2] if it.size() > 2 else CareerTheme.TEXT)
		v.text = String(it[1])
		CareerUi.autoshrink(v)
		box.add_child(v)


func _figures_col(items: Array) -> VBoxContainer:
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 10)
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	for it in items:
		var cell: VBoxContainer = VBoxContainer.new()
		cell.add_theme_constant_override("separation", 0)
		col.add_child(cell)
		var l: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
		l.text = CareerTheme.caps(String(it[0]))
		cell.add_child(l)
		var v: Label = CareerUi.plain(CareerTheme.T_BODY,
			it[2] if it.size() > 2 else CareerTheme.TEXT)
		v.text = String(it[1])
		v.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		cell.add_child(v)
	return col




const _WHY_LABELS: Dictionary = {
	"ovr": "tu nivel", "prestigio": "tu prestigio", "trofeos": "tus títulos",
	"aficion": "tu afición", "records": "tus récords", "interes": "su interés",
	"temporada": "tu temporada",
}







func _why_line(parent: Container, why: Array) -> void:
	var ejes: Array = why.filter(func(e): return int(e.get("pct", 0)) > 0)
	if ejes.is_empty():
		return
	ejes.sort_custom(func(a, b): return int(a["pct"]) > int(b["pct"]))
	var parts: PackedStringArray = PackedStringArray()
	for e in ejes.slice(0, 3):
		parts.append("%s %d" % [I18n.t(String(_WHY_LABELS.get(String(e["key"]),
			""))), int(e["pct"])])
	CareerUi.dim(parent, I18n.tf("La ficha sale de: {0}", [" · ".join(parts)]))













func _offer_pack_chips(parent: Container, offer: Dictionary, index: int) -> void:
	var paths: Array = offer.get("paths", []) as Array
	if paths.size() <= 1 or bool(offer.get("haggled", false)) \
			or bool(offer.get("clausulas_hechas", false)):
		return
	var actual: String = String(offer.get("pack", "equilibrio"))
	var labels: Array = []
	var idx: int = 0
	for i in range(paths.size()):
		var key: String = String((paths[i] as Dictionary).get("pack", "equilibrio"))
		labels.append(I18n.t(String(_PACK_LABELS.get(key, "EQUILIBRIO"))))
		if key == actual:
			idx = i
	CareerUi.tab_chips(parent, labels, idx, func(i: int) -> void:
		if Career.set_offer_pack(index, String((paths[i] as Dictionary)["pack"])):
			_refresh_keeping_scroll())


	if bool(offer.get("clause_free", false)):
		CareerUi.dim(parent, I18n.t("Cláusula baja: si un club la paga, el tuyo no puede negarse."))


