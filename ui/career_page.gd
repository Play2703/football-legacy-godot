func _en_la_mesa(club_id: String) -> bool:
	for o in Career.pending_offers:
		if String((o as Dictionary).get("id", "")) == club_id:
			return true
	return false


func _rumors_block(compacto: bool = false) -> void:











	if not Career.pending_precontract.is_empty():
		if compacto:
			return
		CareerUi.dim(_content, I18n.t("Ya elegiste: tu junio tiene dueño."
			+ " Ningún otro club puede moverte."))
		return
	var rumors: Array = Career.rumores_visibles(4, compacto)




	var pinned: Array = []
	for id in Career.seeded_rumors():
		var team: Dictionary = Teams.by_id(String(id))
		if team.is_empty():
			continue




		if compacto and _en_la_mesa(String(id)):
			continue
		pinned.append({"id": id, "name": team["name"],
			"league": team.get("country", team.get("league", "")), "seen": true})
		for i in rumors.size():
			if String(rumors[i]["id"]) == String(id):
				rumors.remove_at(i)
				break
	rumors = pinned + rumors
	if rumors.is_empty():


		if compacto:
			return
		CareerUi.dim(_content, I18n.t("Nadie suena por ti todavía. Rinde y hazte ver."))
		return
	var head: HBoxContainer = HBoxContainer.new()
	head.add_theme_constant_override("separation", 10)
	_content.add_child(head)
	var h: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	h.text = CareerTheme.caps(I18n.t("TE SIGUEN"))
	h.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	head.add_child(h)
	head.add_child(_help_button(I18n.t("LOS QUE TE SIGUEN"),
		I18n.t("Clubes que preguntan por ti de cara a la próxima ventana. Puedes darle"
		+ " pie a UNO para que apriete cuando abra: llegará con oferta y su distintivo."
		+ "\n\nNo sale gratis —el vestuario se entera de que miras fuera— y sólo se"
		+ " puede con un club por ventana.")))
	for r in rumors:
		_rumor_card(r, compacto)





