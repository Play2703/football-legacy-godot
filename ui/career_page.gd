func _torn_nat_goleadores_crece(filas: VBoxContainer) -> void:
	await get_tree().process_frame
	await get_tree().process_frame
	if not is_instance_valid(filas) or filas.get_child_count() == 0:
		return
	var col: Control = filas.get_parent().get_parent().get_parent() as Control
	if col == null:
		return
	_torn_nat_filas_crecen(col, filas.get_children(), TORN_NAT_FILA_MAX)






func _torn_nat_filas_crecen(col: Control, filas: Array, tope: float, reserva: float = 0.0) -> void:
	if not is_instance_valid(col) or filas.is_empty():
		return
	var sobra: float = col.size.y - col.get_combined_minimum_size().y - reserva
	var cada: float = floorf(sobra / float(filas.size()))
	if cada < 1.0:
		return
	for f in filas:
		var c: Control = SceneFade.vivo(f) as Control
		if is_instance_valid(c):
			c.custom_minimum_size.y = minf(maxf(c.custom_minimum_size.y, c.size.y) + cada,
				maxf(tope, c.custom_minimum_size.y))





func _torn_nat_hoja_crece(col: Control) -> void:
	await get_tree().process_frame
	await get_tree().process_frame
	if not is_instance_valid(col):
		return
	var filas: Array = []
	for c in col.find_children("*", "PanelContainer", true, false):
		if c.has_meta("fl_requisito") or c.name == "TuPuesto":
			filas.append(c)
	_torn_nat_filas_crecen(col, filas, 2.0 * CareerTheme.TOQUE_TUMBADO, 0.1 * col.size.y)



