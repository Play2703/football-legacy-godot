func _wnews_default_scope_tumbado() -> String:
	var mejor: String = "mundo"
	var mas: int = 0
	for sc in ["club", "liga", "mundo"]:
		if sc == "club" and Career.free_agent:
			continue
		var n: int = _wnews_rows(sc, WNEWS_T_FILAS).size()
		if n >= WNEWS_T_FILAS:
			return sc
		if n > mas:
			mas = n
			mejor = sc
	return mejor




