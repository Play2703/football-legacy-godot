func _torn_cwc(accent: Color) -> void:

	if not _torn_capturando:
		_torn_head(I18n.t("MUNDIAL DE CLUBES"), accent)
		_torn_nota(I18n.t("Contra los mejores clubes de otras confederaciones."))
	var cwc: Dictionary = GameState.cwc_state
	var playing: bool = not cwc.is_empty()
	var campo: Array = []
	if playing and _torn_capturando:
		var ko: Array = cwc.get("bracket", [])
		if bool(cwc.get("advanced", false)) and not ko.is_empty():


			_torn_camino(ko, cwc.get("ko_names", []), accent, int(cwc.get("ko_idx", 0)),
				bool(cwc.get("alive", true)), bool(cwc.get("champion", false)), "cwc",
				"ko_idx")
			_torn_grupos_baldosa(cwc, accent)
		else:
			_euro_groups(cwc, accent)
		_torn_cuadro(ko, cwc.get("ko_names", []), accent)
		_torn_heroe_euro(cwc)
	elif playing:
		_euro_groups(cwc, accent)
		_torn_cuadro(cwc.get("bracket", []), cwc.get("ko_names", []), accent)
		_club_verdict(bool(cwc.get("alive", true)),
			bool(cwc.get("champion", false)), I18n.t("¡CAMPEÓN DEL MUNDO DE CLUBES!"),
			I18n.t("Eliminado del Mundial de Clubes"))
	else:


		if not _torn_capturando:
			_torn_nota(I18n.t("Tu club no está esta temporada — así va en el mundo."))


		var proj: Dictionary = EURO_SIM.simulate("cwc", _cwc_field(),
			GameState.season_num, _world_upto())
		if proj.is_empty():
			_torn_apunta_heroe("-", I18n.t("Torneo en curso."))
			return
		_euro_groups(proj, accent)
		_torn_cuadro(proj.get("bracket", []), proj.get("ko_names", []), accent)
		_torn_heroe_fase(proj)
		_projected_champion(String(proj.get("winner", "")), accent)
		campo = proj.get("groups", [])







	var rec: Dictionary = Race.torneo_clubes("cwc", GameState.season_num,
		GameState.player_team_id)
	var w: float = float(rec.get("w", 0.0))
	var race: Array = []
	if w > 0.0:
		race = Race.prorate(Race.cwc(GameState.season_num, GameState.player_team_id, campo),
			int(round(w * 1000.0)), 1000)
		if playing:
			Career.blend_mate_stats(race, "cwc")
		race.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
			return int(a["goals"]) > int(b["goals"]))
	_torn_race_tables(race, playing, float(Career.season_goals_cwc),
		float(Career.season_assists_cwc), Career.season_avg_year(), accent,
		Career.season_matches_in("cwc"))








func _world_upto() -> float:
	var t: float = GameState.season_progress()
	return 1.0 if t < 0.0 else t








