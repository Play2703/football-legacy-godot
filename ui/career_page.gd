func _grupo_detalle(titulo: String, accent: Color, pinta: Callable, filas_t: Array = [],
		pasan: int = 0, tercero_pasa: bool = false) -> void:



	var sobre_grupos: bool = false
	for h in get_children():
		if h.is_in_group(CareerUi.MODAL_GROUP) and h.find_child("Grupos", true, false) != null:
			sobre_grupos = true
	var box: VBoxContainer = CareerUi.modal(self, not sobre_grupos)
	if box == null:
		return
	if UiKit.es_horizontal() and not filas_t.is_empty():
		box.set_meta("torn_grupo", filas_t.size())


		var caja: VBoxContainer = VBoxContainer.new()
		caja.name = "GrupoCaja"
		caja.add_theme_constant_override("separation", 16)
		box.add_child(caja)
		var tt: Label = CareerUi.plain(CareerTheme.T_TITULO_TUMBADO, accent)
		tt.text = CareerTheme.caps(titulo)
		tt.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		tt.clip_text = true
		caja.add_child(tt)
		var cab_t: HBoxContainer = _torn_cabecera(filas_t, 0.0, CareerTheme.T_LEE_TUMBADO)
		_torn_aire_der(cab_t, null)
		caja.add_child(cab_t)
		var filas: Array[PanelContainer] = []
		for i in filas_t.size():
			var fila: PanelContainer = _torn_fila(i + 1, filas_t[i],
				_grupo_franja(i, pasan, tercero_pasa, accent), TORN_FILA_H, accent)
			_torn_aire_der(null, fila)
			caja.add_child(fila)
			filas.append(fila)
		caja.add_child(_torn_boton(I18n.t("CERRAR"), CareerTheme.Kind.GHOST,
			func() -> void: CareerUi.close_modal(box)))
		_torn_grupo_ancho(caja, tt, filas)
		return
	var t: Label = CareerUi.plain(CareerTheme.T_BODY, accent)
	t.text = titulo
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	_pinta_en(box, pinta)
	var cerrar: Button = Button.new()
	cerrar.text = I18n.t("CERRAR")
	cerrar.custom_minimum_size = Vector2(0, CareerTheme.BTN_ROW_H)
	CareerTheme.apply_button(cerrar, CareerTheme.Kind.GHOST, CareerTheme.T_BODY)
	cerrar.pressed.connect(func() -> void: CareerUi.close_modal(box))
	box.add_child(cerrar)








func _torn_aire_der(cab: HBoxContainer, fila: PanelContainer) -> void:
	var extra: float = GRUPO_FILA_MARGEN_DER - float(CareerUi.FILA_TUMBADA_SEP)
	if fila != null:
		var sb: StyleBox = fila.get_theme_stylebox("panel")
		if sb != null:
			sb.content_margin_right = GRUPO_FILA_MARGEN_DER
	if cab != null and cab.get_child_count() > 0:
		var cola: Control = cab.get_child(cab.get_child_count() - 1) as Control
		if cola != null and not (cola is Label):
			cola.custom_minimum_size.x = maxf(cola.custom_minimum_size.x, extra)









func _torn_grupo_ancho(caja: VBoxContainer, titulo: Label, filas: Array[PanelContainer]) -> void:
	var vp: Viewport = caja.get_viewport()
	if vp == null:
		return
	var placa: float = CareerTheme.plate().get_minimum_size().x
	var base: float = 2.0 * CareerUi.MODAL_HALF_W - placa
	var tope: float = maxf(base, 2.0 *(vp.get_visible_rect().size.x * 0.5
		- UiKit.side_safe_inset(vp) - CareerUi.MODAL_MARGEN_V) - placa)
	var quiere: float = 0.0
	var f_t: Font = titulo.get_theme_font("font")
	if f_t != null:
		quiere = f_t.get_string_size(titulo.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0,
			titulo.get_theme_font_size("font_size")).x
	for fila in filas:
		var celdas: Array = fila.get_meta("fila_celdas", [])
		var nom: Label = celdas[2] as Label if celdas.size() > 2 else null
		if nom == null:
			continue
		var f: Font = nom.get_theme_font("font")
		if f == null:
			continue
		quiere = maxf(quiere, fila.get_combined_minimum_size().x + f.get_string_size(nom.text,
			HORIZONTAL_ALIGNMENT_LEFT, -1.0, nom.get_theme_font_size("font_size")).x + 8.0)
	caja.custom_minimum_size.x = clampf(ceilf(quiere), base, tope)


func _euro_groups(state: Dictionary, accent: Color) -> void:
	var groups: Array = state.get("groups", [])
	if groups.is_empty():



		if Continental.es_americana(String(state.get("comp", ""))):
			return
		_torn_nota_linea(I18n.t("Fase de liga"))
		return
	if bool(state.get("league_phase", false)):
		if _torn_capturando:
			_torn_fase_liga_ventana(groups[0], accent)

			_torn_leyenda(_torn_leyenda_fase(
				((groups[0] as Dictionary).get("table", {}) as Dictionary).size(), accent))
			return
		_torn_head(I18n.t("FASE DE LIGA"), accent)
		_euro_group_table(groups[0], accent, true)

		_torn_nota(I18n.tf(
			"Del 1 al {0}, a octavos. Del {1} al {2}, al playoff. El resto, fuera.",
			[GameState.EURO_DIRECT, GameState.EURO_DIRECT + 1, GameState.EURO_PLAYOFF]))
		return
	var cartas: Array = []
	for gi in groups.size():
		var letter: String = _torn_letra_grupo(gi)
		if UiKit.es_horizontal():
			var g: Dictionary = groups[gi]
			var table: Dictionary = g.get("table", {})
			var filas: Array = []
			for key in GameState.euro_group_order(g):
				var you: bool = String(key) == GameState.YOU_KEY
				filas.append({"team": Teams.by_id(GameState.player_team_id if you else String(key)),
					"you": you, "pts": int((table.get(key, {}) as Dictionary).get("pts", 0))})
			cartas.append({"titulo": I18n.tf("GRUPO {0}", [letter]), "filas": filas,
				"pasan": GameState.CWC_QUALIFY, "filas_t": _torn_filas_grupo(g),
				"detalle": _euro_group_table.bind(g, accent, false)})
			continue
		_torn_head(I18n.tf("GRUPO {0}", [letter]), accent)
		_euro_group_table(groups[gi], accent, false)
	_grupos_cartas(cartas, accent)


	if not _torn_leyenda(_torn_leyenda_grupos(groups.size(), GameState.CWC_QUALIFY, 0, accent)):
		_torn_nota(I18n.tf("Pasan los {0} primeros de cada grupo.", [GameState.CWC_QUALIFY]))











func _euro_group_table(g: Dictionary, accent: Color, league_phase: bool) -> void:
	var order: Array = GameState.euro_group_order(g)
	var table: Dictionary = g.get("table", {})
	_standings_header()
	for i in order.size():
		var key: String = String(order[i])
		var r: Dictionary = table.get(key, {})
		var you: bool = key == GameState.YOU_KEY
		var club_id: String = GameState.player_team_id if you else key
		var nm: String = String(Teams.by_id(club_id).get("name", key))
		var stripe: Color = Color(0, 0, 0, 0)
		if league_phase:
			if i < GameState.EURO_DIRECT:
				stripe = accent
			elif i < GameState.EURO_PLAYOFF:
				stripe = _torn_color_playoff()
		elif i < GameState.CWC_QUALIFY:
			stripe = accent
		_standings_row(i + 1, club_id, nm, you, stripe,
			[int(r.get("pj", 0)), int(r.get("w", 0)), int(r.get("d", 0)),
				int(r.get("l", 0))],
			int(r.get("pts", 0)), accent, 26.0)















func _torn_cuadro(bracket: Array, names: Array, accent: Color,
		you_team: Dictionary = {}) -> void:
	if bracket.is_empty() and UiKit.es_horizontal():
		return

	if _torn_capturando:
