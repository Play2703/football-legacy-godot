func _page_mercado() -> void:


	if UiKit.es_horizontal():
		await _mercado_tumbado()
		return


	if Career.free_agent:
		_free_agent_page()
		return








	if Career.on_loan():
		_loan_notice()


		return








	var mesa: bool = Career.mesa_abierta()
	if not mesa:







		_mercado_hero()
		_estado_directiva()


		_renovacion_agente()



		if not Career.pending_precontract.is_empty():
			CareerUi.head(_content, I18n.t("PRECONTRATO FIRMADO"))
			CareerUi.dim(_content, I18n.tf("Al cerrar la temporada te vas GRATIS a {0}."
				+ " Ya elegiste destino: tu mercado está resuelto y juegas menos"
				+ " mientras tanto.",
				[Market.club_name(Career.pending_precontract)]))
		if Career.forced_loan:
			_forced_loan_block()





		_loans_block()








		var cerrados: Array = Career.rumores_visibles(4, false)
		if cerrados.is_empty():



			CareerUi.dim(_content, I18n.t("Ya elegiste: tu junio tiene dueño."
				+ " Ningún otro club puede moverte.")
				if not Career.pending_precontract.is_empty()
				else I18n.t("Nadie suena por ti todavía. Rinde y hazte ver."))
		else:
			_te_siguen_card(cerrados)


		return








	if Career.pending_loans.is_empty() or not Career.loan_window_open():
		_loan_open = -1
	else:
		_loan_open = clampi(_loan_open, -1, Career.pending_loans.size() - 1)
	if _loan_open >= 0:
		_ficha_cesion(_loan_open)



		var gen_c: int = _build_gen
		var ces: Dictionary = Career.pending_loans[_loan_open] as Dictionary
		var mi_pos_c: String = String(ces.get("pos", ""))
		if mi_pos_c.is_empty():
			mi_pos_c = Career.puesto_hoy()
		await _offer_xi(String(ces.get("id", "")), mi_pos_c)
		if gen_c != _build_gen or not is_instance_valid(_content):
			return
		return

	_spread_log()


	_mercado_hero()




	_estado_directiva(true)
	_reject_strip()
	_agent_block()




	if Career.forced_sale:
		_forced_sale_block()
	if Career.forced_loan:
		_forced_loan_block()





	if Career.unsettled:
		_state_head("TU CLUB TE VENDE",
			"Dijiste que no renuevas: el club te ofrece para no"
			+ " perderte gratis. Mientras no salgas, juegas menos. Elige una salida:")
	elif Career.for_sale and Career.venta_por_grada():

		_state_head("ESTÁS EN VENTA",
			"Aceptaste salir: tu grada ya no te quiere y el club te ofrece a quien"
			+ " pregunte, más barato. Sigues jugando mientras llega tu destino.")
	elif Career.for_sale:
		_state_head("ESTÁS EN VENTA",
			"Aceptaste salir: el club te ofrece a quien pregunte"
			+ " para hacer caja. Sigues jugando mientras llega tu destino.")
	elif not Career.market_open():



		_state_head("EN LISTA DE VENTA",
			"Pediste salir: el club te ofrece a quien pregunte,"
			+ " también con el mercado cerrado. Estas ofertas no caducan con la ventana.")
	else:


		CareerUi.head(_content, I18n.t(
			Market.window_name(GameState.season_day, GameState.winter_day())))

	if not Career.counter_offer.is_empty():
		_counter_card()










	if Career.pending_offers.is_empty():
		_offer_open = -1
	else:
		_offer_open = clampi(_offer_open, -1, Career.pending_offers.size() - 1)
	if _offer_open >= 0:
		_offer_idx = _offer_open
		_ficha_topbar(_offer_open)
		_offer_card(Career.pending_offers[_offer_idx], _offer_idx)



		var gen: int = _build_gen


		var mi_pos_o: String = String((Career.pending_offers[_offer_idx] as Dictionary)
			.get("pos", ""))
		if mi_pos_o.is_empty():
			mi_pos_o = Career.puesto_hoy()
		await _offer_xi(String((Career.pending_offers[_offer_idx] as Dictionary)
			.get("id", "")), mi_pos_o)
		if gen != _build_gen or not is_instance_valid(_content):
			return


		return


	_renovacion_agente()
	if Career.pending_offers.is_empty():
		CareerUi.line(_content, I18n.t("Nadie ha preguntado por ti. Rinde y hazte ver."))
	else:









		var verdicto: String = _leave_verdict_txt()
		CareerUi.head(_content, I18n.t("TE HAN OFRECIDO"), null, verdicto)
		if verdicto.is_empty():
			_leave_verdict()
		var ejes: Dictionary = _offer_best_axes()
		for i in Career.pending_offers.size():
			_offer_row(Career.pending_offers[i] as Dictionary, i, ejes)













	_loans_block()













