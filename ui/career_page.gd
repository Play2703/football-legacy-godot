	return "VER"


func _ge_t_rotulo(key: String) -> String:
	if key == "tecnico" and _with_nat():
		return "SELECCIONADOR"
	if key == "equipo" and not _with_nat() and not Career.captain_name().is_empty():
		return "CAPITÁN"
	return String(GE_T_ROTULOS.get(key, key))




func _ge_t_nombre(key: String, label_text: String) -> String:
	if key == "equipo" and not _with_nat():
		var cap: String = Career.captain_name()
		if not cap.is_empty():
			return cap


	if (key == "equipo" or key == "aficion") and _with_nat():
		return Nations.display_name(Nations.id_for_country(Career.nationality))
	if key == "prensa":
		return I18n.t(Career.prensa_escalon_nombre(), "fama")
	return label_text


