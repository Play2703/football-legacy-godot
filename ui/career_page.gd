	ic.custom_minimum_size = Vector2(28, 28)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.setup(icono, col)
	fila.add_child(ic)
	var l: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	l.text = rotulo
	l.custom_minimum_size = Vector2(CAL_DATO_W, 0)
	l.clip_text = true
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	CareerUi.autoshrink(l, 10)
	fila.add_child(l)
	var val: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
	val.text = valor
	val.clip_text = true
	val.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	if frac < 0.0:
		val.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fila.add_child(val)
		return fila
	val.custom_minimum_size = Vector2(70, 0)
	val.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	fila.add_child(val)
	var carril: VBoxContainer = VBoxContainer.new()
	carril.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	carril.alignment = BoxContainer.ALIGNMENT_CENTER
	carril.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(carril)
	var fill: ColorRect = CareerUi.bar(carril, col, 14.0)
	fill.anchor_right = clampf(frac, 0.0, 1.0)
	var pista: Control = fill.get_parent() as Control
	pista.mouse_filter = Control.MOUSE_FILTER_IGNORE
	for c in pista.get_children():
		(c as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
	return fila








