func _club_goal_row(g: Dictionary) -> void:
	var comp: String = String(g.get("comp", "league"))
	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	_content.add_child(row)
	var brand: String = String(CLUB_GOAL_BRAND.get(comp, ""))
	var tint: Color = CareerTheme.TEXT_DIM
	if comp == "board":


		var mi: MenuIcon = MenuIcon.new()
		mi.custom_minimum_size = Vector2(26, 26)
		mi.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		mi.setup("mercado", CareerTheme.MONEY)
		row.add_child(mi)
	elif brand.is_empty():


		row.add_child(_comp_icon(Competitions.league_logo(
			Teams.country_of(GameState.player_team_id)), CareerTheme.TEXT_DIM))
	else:
		tint = Competitions.COMP_ACCENT.get(brand, CareerTheme.TEXT_DIM) as Color
		row.add_child(_comp_icon(brand, tint))


	var ask: Label = CareerUi.plain(20, CareerTheme.TEXT)
	ask.text = _club_goal_ask(g)
	ask.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	ask.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ask.clip_text = true
	row.add_child(ask)

	var state: Label = CareerUi.plain(18, CareerTheme.TEXT_DIM)
	if bool(g.get("done", false)):
		state.add_theme_color_override("font_color", CareerTheme.MONEY)
		state.text = I18n.t("CUMPLIDO")
	elif bool(g.get("failed", false)):
		state.add_theme_color_override("font_color", CareerTheme.DANGER)
		state.text = I18n.t("FALLADO")
	else:
		state.text = _club_goal_progress(g, comp)





		if ClubGoals.liga_en_rojo(g):
			state.add_theme_color_override("font_color", CareerTheme.DANGER)
	state.size_flags_vertical = Control.SIZE_SHRINK_CENTER






	row.add_child(state)










func _club_goal_ask(g: Dictionary) -> String:
	var kind: String = String(g.get("kind", ""))
	var puesto: String = _ordinal(int(g.get("target", 1)))
	if CLUB_GOAL_BRAND.has(kind):




		return I18n.tf("{0}: {1} o mejor",
			[I18n.t(String(Competitions.comp_name(String(CLUB_GOAL_BRAND[kind])))),
			puesto])
	if kind == "previa":
		puesto = CareerUi.ronda_rotulo(String(g.get("entrada", "")))
	return I18n.tf(String(CLUB_GOAL_TEXT.get(kind, "Competir")), [puesto])



func _club_goal_progress(g: Dictionary, comp: String) -> String:
	if comp == "board":

		match int(g.get("now", 0)):
			ClubFinance.SALUD_SANA:
				return I18n.t("CAJA SANA")
			ClubFinance.SALUD_APURO:
				return I18n.t("EN APURO")
		return I18n.t("FAIR PLAY")
	if comp == "league":
		var ronda: String = ClubGoals.liguilla_ronda_txt(g)
		if not ronda.is_empty():
			return I18n.t(ronda)
		if not bool(g.get("started", false)):
			return I18n.t("SIN EMPEZAR")
		var pos: int = int(g.get("now", 0))
		return I18n.tf("VAS {0}", [_ordinal(pos)]) if pos > 0 else I18n.t("SIN DATOS")

	var pv: String = String(g.get("previa_ronda", ""))
	if not pv.is_empty() and not bool(g.get("done", false)):
		return CareerUi.ronda_rotulo(pv)


	if int(g.get("target", 0)) <= 0:
		return I18n.t("EN FASE DE LIGA")
	return I18n.tf("{0}/{1} RONDAS", [int(g.get("now", 0)), int(g.get("target", 1))])


func _objective_block() -> void:
	var obj_type: String = String(Career.contract["obj_type"])
	var target: int = int(Career.contract["obj_target"])
	match obj_type:
		"position":
			CareerUi.line(_content, I18n.tf("Termina {0} o mejor en la liga.",
				[_ordinal(target)]))


			if not GameState.league_started():
				CareerUi.dim(_content, I18n.t("La liga aún no arranca."))
			else:
				var pos: int = _league_position()
				var on_track: bool = pos > 0 and pos <= target
				var l: Label = CareerUi.plain(24,
					CareerTheme.accent_text() if on_track else CareerTheme.DANGER)
				l.text = I18n.tf("Vas {0}{1}", [_ordinal(pos) if pos > 0
					else I18n.t("sin clasificar"), "  ✓" if on_track else ""])
				_content.add_child(l)
		"assists":
			var prog_a: int = int(Career.contract["obj_progress"])
			CareerUi.line(_content, I18n.tf("Da {0} asistencias  (llevas {1})",
				[target, prog_a]))
			_pace_bar(prog_a, target)
		"matches":
			var prog_m: int = int(Career.contract["obj_progress"])
			CareerUi.line(_content, I18n.tf("Juega {0} partidos  (llevas {1})",
				[target, prog_m]))
			_pace_bar(prog_m, target)
		"rating":


			var prog_r: int = int(Career.contract["obj_progress"])
			CareerUi.line(_content, I18n.tf("Promedia {0} de nota  (llevas {1})",
				["%.1f" %(float(target) / 10.0), "%.1f" %(float(prog_r) / 10.0)]))
			_pace_bar(prog_r, target)
		_:
			var prog_g: int = int(Career.contract["obj_progress"])
			CareerUi.line(_content, I18n.tf("Marca {0} goles  (llevas {1})",
				[target, prog_g]))
			_pace_bar(prog_g, target)



	var obj_bonus: int = int(Career.contract.get("obj_bonus", 0))
	if obj_bonus > 0:
		_chip_grid([["precision", I18n.t("PRIMA"), "+$ %s" % CareerUi.money(obj_bonus),
			CareerTheme.MONEY]])



	match Career.objective_trend():
		1:
			var sube: Label = CareerUi.plain(18, CareerTheme.MONEY)
			sube.text = I18n.t("Te lo suben: el año pasado diste más de lo pedido.")
			sube.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			_content.add_child(sube)
		-1:
			var baja: Label = CareerUi.plain(18, CareerTheme.TEXT_DIM)
			baja.text = I18n.t("Te lo bajan: el año pasado te quedaste corto.")
			baja.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			_content.add_child(baja)
		_:
			pass



	if Career.can_negotiate_objective():

		var neg: Button = CareerUi.accion("target", I18n.t("PACTAR OBJETIVO"),
			CareerTheme.NAV_YO)
		neg.custom_minimum_size = Vector2(0, 76)
		neg.pressed.connect(func() -> void: _negotiate_objective())
		_content.add_child(neg)
	elif int(Career.contract.get("obj_talks_season", -1)) == GameState.season_num:
		CareerUi.dim(_content, I18n.t("Ya pactaste tu objetivo esta temporada."))










func _pace_bar(done: int, target: int) -> void:
	var p: Dictionary = Career.objective_pace()
	var listón: int = int(p.get("expected", target))
	var color: Color = CareerTheme.accent() if bool(p.get("on_track", true)) \
			else CareerTheme.DANGER
	_content.add_child(CareerUi.stat_bar(float(done) / float(maxi(target, 1)),
		color, 700, float(listón) / float(maxi(target, 1))))
	var proj: int = int(p.get("projected", -1))
	if proj < 0:
		return
	var l: Label = CareerUi.plain(18, color)

	l.text = I18n.tf("A este ritmo: {0} de {1}",
		["%.1f" %(float(proj) / 10.0) if String(p.get("type", "")) == "rating"
			else str(proj),
		"%.1f" %(float(target) / 10.0) if String(p.get("type", "")) == "rating"
			else str(target)])
	_content.add_child(l)





func _negotiate_objective() -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(26, CareerTheme.TEXT)
	t.text = I18n.t("PACTAR EL OBJETIVO")
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	CareerUi.dim(box, I18n.t("Más exigente paga más prima; más cómodo, menos. Se pacta"
		+ " una vez, al arranque de la temporada."))
	var names: Dictionary = {-1: "CÓMODO", 0: "COMO ESTÁ", 1: "EXIGENTE"}
	for tier in Career.objective_tiers():
		var dir: int = int(tier["dir"])
		var label: String = "%s · %s · +$ %s" % [I18n.t(String(names[dir])),
			_obj_tier_goal(String(tier["type"]), int(tier["target"])),
			CareerUi.short_money(int(tier["bonus"]))]



		var col: Color = _protege_col() if dir < 0 \
				else (UiKit.BTN_AMBER["bg"] as Color if dir == 0 else CareerTheme.DANGER)
		box.add_child(_option_accion("target", label, col, box, _apply_obj_tier.bind(dir)))
	box.add_child(_option_button(I18n.t("VOLVER"), CareerTheme.Kind.GHOST, box,
		Callable()))




func _apply_obj_tier(dir: int) -> void:
	Career.set_objective_tier(dir)
	_toast(I18n.t("OBJETIVO PACTADO"), CareerTheme.MONEY)




func _obj_tier_goal(obj_type: String, target: int) -> String:
	match obj_type:
		"position":
			return I18n.tf("top {0}", [target])
		"assists":
			return I18n.tf("{0} asist.", [target])
		"matches":
			return I18n.tf("{0} part.", [target])
		"rating":
			return I18n.tf("nota {0}", ["%.1f" %(float(target) / 10.0)])
		_:
			return I18n.tf("{0} goles", [target])



