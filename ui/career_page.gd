func _casa_cifras(extras: Array) -> Dictionary:
	var muebles: int = 0
	for e in extras:
		if Career.house_extras.has(String((e as Dictionary)["id"])):
			muebles += 1
	var coches: int = 0
	for id in House.COCHES:
		if Career.has_lifestyle(id):
			coches += 1
	var acabados: int = 0
	var hay_acabados: int = 0
	for lista in [House.PISOS, House.PAREDES, House.CARPINTERIAS]:
		for a in lista:
			hay_acabados += 1
			if House.acabado_owned(String((a as Dictionary)["id"]), Career.house_finishes):
				acabados += 1
	var gente: int = 0
	for vid in PERSONAL_CASA:
		if Career.has_investment(String(vid)):
			gente += 1
	return {
		"muebles": "%d/%d" % [muebles, extras.size()],
		"cochera": "%d/%d" % [coches, House.COCHES.size()],
		"acabados": "%d/%d" % [acabados, hay_acabados],
		"terreno": "%d/%d" % [House.clamp_tier(Career.land_tier) + 1, House.TERRENOS.size()],
		"personal": "%d/%d" % [gente, PERSONAL_CASA.size()],
		"mudarse": "%d/%d" % [clampi(Career.house_level, 0, House.LEVELS.size() - 1) + 1,
			House.LEVELS.size()],
	}
















func _casa_secciones() -> void:
	var extras: Array = House.extras_for(Career.house_level)




	HouseScape.precarga(extras.filter(func(e: Dictionary) -> bool:
		return String(e.get("excl", "")) == "fachada").map(func(e: Dictionary) -> String:
			return String(e["id"])))
	extras = extras.filter(func(e: Dictionary) -> bool: return String(e["id"]) not in ["cochera", "simulador"])
	var nuevos: Array = _casa_nuevos(extras)









	var c: Dictionary = _casa_cifras(extras)
	var secciones: Array = []
	if not extras.is_empty():
		secciones.append({"id": "muebles", "icon": "sofa", "label": I18n.t("MUEBLES"),
			"color": CareerTheme.BENCH, "badge": c["muebles"]})
	secciones.append({"id": "cochera", "icon": "coche", "label": I18n.t("COCHERA"),
		"color": CareerTheme.NAV_PAPEL, "badge": c["cochera"]})
	secciones.append({"id": "acabados", "icon": "pincel", "label": I18n.t("ACABADOS"),
		"color": CareerTheme.RASGO_CIELO, "badge": c["acabados"]})
	secciones.append({"id": "terreno", "icon": "arbol", "label": I18n.t("TERRENO"),
		"color": CareerTheme.RASGO_OLIVA, "badge": c["terreno"]})
	secciones.append({"id": "personal", "icon": "perfil", "label": I18n.t("PERSONAL"),
		"color": CareerTheme.NAV_GENTE, "badge": c["personal"]})
	secciones.append({"id": "mudarse", "icon": "maletas", "label": I18n.t("MUDARSE"),
		"color": CareerTheme.NAV_CASA, "badge": c["mudarse"]})
	var ids: Array = []
	for s in secciones:
		ids.append(String((s as Dictionary)["id"]))


	if not ids.has(_casa_seccion):
		_casa_seccion = String(ids[0])
	var gap: Control = Control.new()
	gap.custom_minimum_size = Vector2(0, 14)
	_content.add_child(gap)
	_casa_tabs_row = CareerUi.tile_tabs(_content, secciones, ids.find(_casa_seccion),
		func(i: int) -> void: _casa_ir(String(ids[i]), -1, false))


	if not nuevos.is_empty() and ids.has("muebles"):
		CareerUi.punto_nuevo(_casa_tabs_row.get_child(ids.find("muebles")) as Control)
	_casa_nav_fin = _casa_tabs_row


	var aire: Control = Control.new()
	aire.custom_minimum_size = Vector2(0, 10)
	_content.add_child(aire)
	_casa_cajon_rotulos = []
	_casa_cajon_fichas = []
	_casa_cajon_puntos = []
	match _casa_seccion:
		"cochera":
			_casa_cochera()
		"acabados":
			_house_finishes_block()
		"terreno":
			_casa_terreno()
		"mudarse":
			_escaparate_casas()
		"personal":
			_casa_personal()
		_:
			_casa_muebles(extras, nuevos)
	_casa_pin_armar(secciones, ids, not nuevos.is_empty())



func _casa_cochera() -> void:
	_house_thumbs_batch()
	_house_extra_card(House.extra_by_id("cochera"))
	_house_extra_card(House.extra_by_id("simulador"))
	CareerUi.head(_content, I18n.t("COCHES"))
	for l in Shop.LIFESTYLE:
		var id: String = String(l["id"])
		if not House.COCHES.has(id):
			continue
		var inf: Dictionary = _info_estilo(l)
		var mine: bool = Career.has_lifestyle(id)
		var precio: int = Career.shop_price("lifestyle", l)
		var permitido: bool = Career.lifestyle_house_ok(id)
		var action: Control
		if mine:
			action = _shop_seal(I18n.t("TUYO"))
		else:
			action = _shop_action("$ %s" % CareerUi.money(precio), CareerTheme.Kind.NEUTRAL,
				not permitido or not Career.can_afford(precio), func() -> void: _shop_pagar(inf))
			if permitido:
				action = _con_falta(action, precio)
		var nota: String = ""
		if Shop.CASUAL_UNLOCKS.has(id):
			nota = I18n.tf("Ya vistes el atuendo {0} en ASPECTO." if mine
				else "Te pones el atuendo {0} en ASPECTO.",
				[I18n.t(String(Shop.CASUAL_UNLOCKS[id].get("outfit_name", "")))])
		var info: VBoxContainer = _shop_card(I18n.t(String(l["name"])), "coche",
			Shop.lifestyle_stats(l), I18n.t(String(l.get("desc", ""))), mine, action,
			roundi(float(l.get("upkeep", 0)) * Career._upkeep_div_mult()), id,
			"", nota, ShopPhoto.rect(self, id, 132))
		info.get_parent().get_parent().set_meta("coche_id", id)
		if not permitido and not mine:
			info.add_child(_casa_candado(I18n.tf("PIDE {0}", [I18n.t("COCHERA DE COLECCIÓN")])))












const PERSONAL_CASA: Array = ["chef", "nutricionista", "entrenador"]

func _casa_personal() -> void:
	CareerUi.dim(_content, I18n.t("Viven en tu casa y cobran cada jornada."))
	for vid in PERSONAL_CASA:
		var v: Dictionary = Shop.investment_by_id(vid)
		if v.is_empty():
			continue
		var inf: Dictionary = _info_inversion(v)
		var mine: bool = Career.has_investment(vid)
		var nivel: int = Career.staff_level(vid) if mine else 0
		var tope: int = Shop.staff_levels(v)
		var sube: int = Career.staff_upgrade_price(vid) if mine else 0



		var stats: Array = Shop.investment_stats(v)
		if mine and tope > 1:
			stats = stats + Shop.staff_level_stats(v, nivel)
		var action: Control
		var bloqueado: bool = bool(inf.get("locked", false))
		if mine and sube <= 0:
			action = _shop_seal(I18n.t("TUYO"))
		else:
			var precio: int = int(inf.get("precio", int(v["price"])))
			var cta: Dictionary = inf.get("cta", {})
			action = _shop_action("$ %s" % CareerUi.money(precio), CareerTheme.Kind.NEUTRAL,
				bloqueado or not bool(cta.get("ok", false)), func() -> void: _shop_pagar(inf))
			if not bloqueado:
				action = _con_falta(action, precio)
		var info: VBoxContainer = _shop_card(I18n.t(String(v["name"])),
			Shop.icon_of(v, "estilo"), stats, I18n.t(String(v.get("desc", ""))), mine, action,
			0, vid, "", "", _personal_retrato(vid))
		info.get_parent().get_parent().set_meta("personal_id", vid)
