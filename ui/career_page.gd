func _cal_datos_partido(v: VBoxContainer, f: Dictionary, marca: Node) -> void:
	if bool(f["jugado"]):
		return
	var d: int = int(f["descanso"])
	if d >= 0:
		_cal_dato(v, "reloj", I18n.t("DÍAS DE DESCANSO"), I18n.tf("{0}d", [d]),
			_cal_descanso_col(d), float(d) / CAL_DESCANSO_BARRA)
	var baja: String = String(f["baja"])
	var papel: String = ""
	var pcol: Color = CareerTheme.TEXT_DIM
	if baja == "BAJA" or baja == "ALTA":
		papel = baja
		pcol = CareerTheme.DANGER if baja == "BAJA" else CareerTheme.GOOD
		_cal_dato(v, "cruz_medica", I18n.t("TU PAPEL"), I18n.t(baja, "lesion"), pcol, -1.0)
	elif bool(f["proximo"]) and String(f["comp"]) != "nat":
		var e: float = Career.energy
		_cal_dato(v, "potencia", I18n.t("ENERGÍA"), str(roundi(e)),
			CareerTheme.energy_color(e), e / 100.0)
		papel = cal_papel(Career.standing())
		pcol = cal_papel_color(papel)
		_cal_dato(v, "equipo", I18n.t("TU PAPEL"), I18n.t(papel), pcol, -1.0)
	marca.set_meta("cal_papel", papel)








static func cal_papel(st: Dictionary) -> String:
	var mins: int = int(st.get("minutes", 0))
	if mins >= 60:
		return "TITULAR"
	if mins > 0:
		return "BANCA"
	if String(st.get("pactado", "")) == DescansoPactado.DESCANSO:
		return "DÍA LIBRE"
	if bool(st.get("rested", false)):
		return "DESCANSAS"
	return "NO CONVOCADO"




static func cal_papel_color(papel: String) -> Color:
	match papel:
		"TITULAR":
			return CareerTheme.GOOD
		"BANCA":
			return CareerTheme.CAUTION
		"DÍA LIBRE", "DESCANSAS":
			return CareerTheme.accent_text()
	return CareerTheme.DANGER






func _cal_dato(box: Container, icono: String, rotulo: String, valor: String, col: Color,
		frac: float) -> HBoxContainer:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 12)
	fila.custom_minimum_size = Vector2(0, 36)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
