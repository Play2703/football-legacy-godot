func _mesa_confirmar() -> void:
	var s: Dictionary = Career.gerencia_mesa_saldo()
	if not bool(s["ok"]):
		UiAudio.deny()
		_toast(_mesa_falla_txt(s), CareerTheme.DANGER)
		return
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	CareerUi.head(box, I18n.t("TU VENTANA"))




	var tratos: Array = []
	for r in Career.gerencia_mesa_plantilla():
		var row: Dictionary = r
		if bool(row["vendo"]) and not String(row["club"]).is_empty():
			tratos.append({"vende": true, "name": String(row["name"]), "pos": String(row["pos"]),
				"ovr": int(row["ovr"]), "club": String(row["club"]), "fee": int(row["cobra"])})
	for e in Career.gerencia_mesa_compras():
		var f: Dictionary = e
		if Career.gerencia_mesa_no_compra(f).is_empty():
			tratos.append({"vende": false, "name": String(f["name"]),
				"pos": String(f.get("pos", "")), "ovr": int(f.get("ovr", 0)),
				"club": String(f.get("club", "")), "fee": Career.gerencia_precio(f)})
	_mesa_tratos(box, tratos, I18n.t("VENDES"), I18n.t("FICHAS"))
	_mesa_cuentas(box, int(s["base"]), int(s["ventas"]), int(s["compras"]), int(s["queda"]))
	CareerUi.dim(box, I18n.t("No hay vuelta atrás: se mueve todo a la vez."))

	var si: Button = CareerUi.accion("check", I18n.t("CERRAR TRATOS"), CareerTheme.MONEY, true)
	si.custom_minimum_size.y = CareerTheme.BTN_CTA_H
	si.pressed.connect(func() -> void:
		var res: Dictionary = Career.gerencia_mesa_cierra()
		CareerUi.close_modal(box)



		if res.has("falla"):
			UiAudio.deny()
			_toast(_mesa_falla_txt(Career.gerencia_mesa_saldo()), CareerTheme.DANGER)
			return
		UiAudio.confirm()
		_mesa_resultado(res))
	box.add_child(si)
	var no: Button = CareerUi.accion("cerrar", I18n.t("VOLVER"), _protege_col())
	no.set_meta("atras", true)
	no.pressed.connect(func() -> void: CareerUi.close_modal(box))
	box.add_child(no)



const MESA_TRATO_W: float = 330.0






func _mesa_tratos(box: VBoxContainer, tratos: Array, rot_v: String, rot_f: String) -> void:
	var n_v: int = 0
	for t in tratos:
		n_v += 1 if bool((t as Dictionary)["vende"]) else 0
	var n_f: int = tratos.size() - n_v
	var filas: int = ceili(n_v / 2.0) + ceili(n_f / 2.0)
	var rotulos: int =(1 if n_v > 0 else 0) +(1 if n_f > 0 else 0)
	var lista: VBoxContainer = _mesa_lista_modal(box, 0)
	(lista.get_parent() as Control).custom_minimum_size.y = mini(filas * 196 + rotulos * 50, 860)
	for vende in [true, false]:
		if (n_v if vende else n_f) == 0:
			continue
		_mesa_rotulo(lista, rot_v if vende else rot_f)
		var grid: GridContainer = GridContainer.new()
		grid.columns = 2
		grid.add_theme_constant_override("h_separation", 14)
		grid.add_theme_constant_override("v_separation", 14)
		grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		lista.add_child(grid)
		for t in tratos:
			var d: Dictionary = t
			if bool(d["vende"]) == vende:
				_mesa_trato(grid, d)




func _mesa_trato(grid: GridContainer, d: Dictionary) -> void:
	var vende: bool = bool(d["vende"])
	var club: String = String(d["club"])
	var fee: int = int(d["fee"])
	var card: PanelContainer = CareerUi.plate()
	card.custom_minimum_size.x = MESA_TRATO_W
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	grid.add_child(card)
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 8)
	card.add_child(v)
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 10)
	v.add_child(cab)
	if int(d["ovr"]) > 0:
		var med: OvrBadge = OvrBadge.new()
		med.setup(int(d["ovr"]), 24)
		med.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cab.add_child(med)
	if not String(d["pos"]).is_empty():
		var pc: PanelContainer = CareerUi.pos_chip(String(d["pos"]))
		pc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cab.add_child(pc)
	var nom: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
	nom.text = CareerUi.display_name(Competitions.demarca(String(d["name"])))
	nom.clip_text = true
	nom.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	nom.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	nom.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	cab.add_child(nom)
	var linea: HBoxContainer = HBoxContainer.new()
	linea.add_theme_constant_override("separation", 8)
	v.add_child(linea)
	var libre: bool = Teams.is_free(club)
	if not libre and not club.is_empty():
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(36, 36)
		crest.set_team(Teams.by_id(club))
		linea.add_child(crest)
	var dest: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)

	dest.text = I18n.t("LIBRE") if libre else _mesa_club_txt(club)
	dest.clip_text = true
	dest.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	dest.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	dest.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	linea.add_child(dest)

	var cif: Label = CareerUi.plain(CareerTheme.T_MONEY,
		CareerTheme.MONEY if vende else CareerTheme.DANGER)
	cif.text = I18n.t("LIBRE") if fee <= 0 and not vende \
			else ("+ " if vende else "- ") + CareerUi.short_money(fee)
	v.add_child(cif)



