func _hc_heroe_crece(apoyo: VBoxContainer, heroe: Control, ancho: float) -> void:
	if not is_instance_valid(heroe) or apoyo.size.y <= 0.0:
		return
	var escudo: Control = heroe.get_meta("hc_heroe_escudo", null) as Control
	var rejilla: Control = heroe.get_meta("hc_heroe_rejilla", null) as Control
	var h: VBoxContainer = heroe.get_meta("hc_heroe_caja", null) as VBoxContainer
	if escudo == null or rejilla == null or h == null:
		return
	var sep: float = float(apoyo.get_theme_constant("separation"))
	var otros: float = 0.0
	var baldosas: Array[Control] = []
	for c in apoyo.get_children():
		if c != heroe and c is Control and (c as Control).visible:
			otros += sep
			if (c as Control).has_meta("hc_top"):
				baldosas.append(c as Control)
			else:
				otros +=(c as Control).get_combined_minimum_size().y
	var fijo: float = 0.0
	for c in h.get_children():
		if c is Control and (c as Control).visible and c != escudo.get_parent():
			fijo +=(c as Control).get_combined_minimum_size().y
	fijo += float(h.get_theme_constant("separation")) * float(maxi(h.get_child_count() - 1, 0))
	var reja_h: float = rejilla.get_combined_minimum_size().y
	var tope: float = maxf(HC_HEROE_ESCUDO, minf(HC_HEROE_ESCUDO_MAX,
		ancho - 16.0 - rejilla.get_combined_minimum_size().x))

	var libre: float = apoyo.size.y - otros - fijo
	var n: int = baldosas.size()
	var bh: float = 0.0
	if n > 0:
		bh = clampf(floorf((libre - maxf(HC_HEROE_ESCUDO, reja_h)) / float(n)), HC_BALDOSA_H,
			HC_BALDOSA_OBJ)
	var lado: float = clampf(floorf((libre - bh * float(n)) / 8.0) * 8.0, HC_HEROE_ESCUDO, tope)
	if n > 0:
		bh += floorf(maxf(libre - bh * float(n) - maxf(lado, reja_h), 0.0) / float(n))
	if not is_equal_approx(escudo.custom_minimum_size.y, lado):
		escudo.custom_minimum_size = Vector2(lado, lado)
	for b in baldosas:
		if not is_equal_approx(b.custom_minimum_size.y, bh):
			b.custom_minimum_size.y = bh










func _hc_heroe_datos(lista: Array, club: String) -> Dictionary:
	var out: Dictionary = {"cifra": "", "linea": "", "puesto": 0, "delta": 0, "ref": 0}
	var i: int = -1
	for k in lista.size():
		if String((lista[k] as Dictionary)["club"]) == club:
			i = k
			break
	if i < 0:
		return out
	var tot: int = int(lista[i]["total"])
	var puesto: int = int(lista[i]["puesto"])

	var arriba: Dictionary = lista[puesto - 2] if puesto >= 2 else {}
	if tot <= 0:
		out["cifra"] = "0"
		if not arriba.is_empty():
			out["delta"] = int(arriba["total"])
			out["ref"] = int(arriba["puesto"])
			out["linea"] = I18n.tf("TÍTULOS · -{0} DEL {1}", [out["delta"],
				_ordinal(int(out["ref"]))])
		return out
	out["puesto"] = puesto
	out["cifra"] = _ordinal(puesto)
	if puesto == 1:
		for k in range(i + 1, lista.size()):
			var d: Dictionary = lista[k]
			if int(d["total"]) < tot:
				out["delta"] = tot - int(d["total"])
				out["ref"] = int(d["puesto"])
				out["linea"] = I18n.tf("{0} TÍTULOS · +{1} AL {2}", [tot, out["delta"],
					_ordinal(int(out["ref"]))])
				break
		return out
	out["delta"] = int(arriba["total"]) - tot
	out["ref"] = int(arriba["puesto"])
	out["linea"] = I18n.tf("{0} TÍTULOS · -{1} DEL {2}", [tot, out["delta"],
		_ordinal(int(out["ref"]))])
	return out


func _hc_rotulo(kind: String) -> String:
	match kind:
		"liga":
			return I18n.t("LIGAS", "carrera")
		"copa":
			return I18n.t("COPAS", "carrera")
		"champions":
			return I18n.t("CONTINENTAL")
	return I18n.t("MUNDIAL DE CLUBES")





func _hc_ranking(kind: String) -> Array:
	var out: Array = []
	var puesto: int = 1
	var antes: int = -1
	for id in Palmares.ranking_kind(kind, -1, _palm_country):
		var n: int = int(Palmares.of(id).get(kind, 0))
		if n <= 0:
			break
		if n != antes:
			puesto = out.size() + 1
			antes = n
		out.append({"club": id, "n": n, "puesto": puesto})
	return out






func _hc_baldosa(kind: String) -> Button:
	var rank: Array = _hc_ranking(kind)
	if rank.is_empty():
		return null
	var lider: String = String(rank[0]["club"])
	var team: Dictionary = Teams.by_id(lider)
	var yo: String = ""
	for r in rank:
		if String((r as Dictionary)["club"]) == GameState.player_team_id:
			yo = I18n.tf("TÚ {0}", [_ordinal(int(r["puesto"]))])
			break
	var cr: CrestView = CrestView.new()
	cr.custom_minimum_size = Vector2(48, 48)
	cr.set_team(team)
	var b: Button = CareerUi.baldosa_avance("torneos", _hc_rotulo(kind), CareerTheme.NAV_LEGADO, cr,
		GameState.nombre_corto_club(Competitions.demarca(String(team.get("name", lider)))),
		str(int(rank[0]["n"])), yo, _hc_top.bind(kind))

	var ic: Control = b.get_meta("avance_icono", null) as Control
	if ic != null:
		var tipo: String = _palm_cont_icon(String(team.get("country", ""))) if kind == "champions" \
				else kind
		var t: TrophyIcon = _hc_trofeo(tipo, ic.custom_minimum_size.x)
		t.size_flags_horizontal = ic.size_flags_horizontal

		t.set_meta("fl_tinta", true)
		ic.replace_by(t)
		ic.queue_free()
		b.set_meta("avance_icono", t)
	b.set_meta("hc_top", kind)
	b.set_meta("hc_lider", lider)
	b.custom_minimum_size.y = maxf(b.custom_minimum_size.y, HC_BALDOSA_H)
	return b






func _hc_top(kind: String) -> void:
	var rank: Array = _hc_ranking(kind)
	var filas: Array = rank.slice(0, mini(HC_TOP_N, rank.size()))
	var clubes: int = filas.size()
	for k in range(HC_TOP_N, rank.size()):
		if String((rank[k] as Dictionary)["club"]) == GameState.player_team_id:
			if k > HC_TOP_N:
				filas.append({"puntos": true})
			filas.append(rank[k])
			clubes += 1
			break
	var w_n: float = 0.0
	for r in filas:
		if not bool((r as Dictionary).get("puntos", false)):
			w_n = maxf(w_n, _hc_ancho(str(int(r["n"])), CareerTheme.T_DATO_TUMBADO))
	var med: Dictionary = _hc_med_plan({"tot": maxf(HC_ICONO_CAB, w_n + 8.0)}, filas,
		range(filas.size()).filter(func(i: int) -> bool:
			return not bool((filas[i] as Dictionary).get("puntos", false))))
	var nombres: Dictionary = _hc_nombres_w(filas, "club")
	var tipo: String = _palm_cont_icon(Teams.country_of(String(rank[0]["club"]))) \
			if kind == "champions" and not rank.is_empty() else kind
	var caja_ic: HBoxContainer = HBoxContainer.new()
	caja_ic.alignment = BoxContainer.ALIGNMENT_END
	caja_ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	caja_ic.add_child(_hc_trofeo(tipo, HC_ICONO_CAB))
	var cab: HBoxContainer = CareerUi.cabecera_tumbada([
		{"texto": "", "ancho": _hc_hueco_cab(med, HC_TOP_FILA_H, float(nombres[false]))},
		{"nodo": caja_ic, "ancho": float(med["tot"])},
		{"texto": "", "ancho": HC_COLA}])
	cab.name = "Cabecera"
	var box: VBoxContainer = _hc_carta(_hc_rotulo(kind), filas,
		_hc_pinta_top.bind(med, nombres), HC_TOP_FILA_H, cab)
	if box != null:
		box.set_meta("hc_top_modal", kind)
		box.set_meta("lista_entera", clubes)


func _hc_pinta_top(_i: int, fila: Variant, _franja: Color, alto: float, med: Dictionary,
		nombres_w: Dictionary) -> Control:
	var d: Dictionary = fila
	if bool(d.get("puntos", false)):
		return _hc_fila_puntos(alto, med)
	var club: String = String(d["club"])
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var tuya: bool = club == GameState.player_team_id
	var f: PanelContainer = CareerUi.fila_tumbada(alto, Color.TRANSPARENT, [
		{"texto": str(int(d["puesto"])), "ancho": float(med["pos"]), "derecha": true, "tam": tam,
			"color": CareerTheme.TEXT_MID},
		{"nodo": _hc_escudo(club, alto)},
		{"texto": _hc_nombre_club(club, compacta), "ancho": float(nombres_w[compacta]),
			"tam": tam},
		{"texto": str(int(d["n"])), "ancho": float(med["tot"]), "derecha": true,
			"tam": CareerTheme.T_DATO_TUMBADO if alto >= HC_FILA_H else tam},
		{"texto": "", "ancho": HC_COLA}],
		tuya, CareerTheme.NAV_LEGADO)
	f.set_meta("hc_club", club)
	if tuya:
		f.set_meta("fl_tuya", true)
	f.size_flags_vertical = Control.SIZE_EXPAND_FILL
	return f




