func _on_relation_tapped(key: String) -> void:




	if key == "agente":
		_on_tab("mercado")
		return
	if not _rel_rows.has(key) or _scroll == null or not is_instance_valid(_scroll):
		return
	var row: Control = _rel_rows[key]
	if not is_instance_valid(row):
		return


	var y: float = row.global_position.y - _scroll.global_position.y + _scroll.scroll_vertical
	var target: float = maxf(0.0, y - 24.0)
	var tw: Tween = create_tween()
	tw.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	tw.tween_property(_scroll, "scroll_vertical", int(target), 0.28)



	row.modulate = CareerTheme.accent_text()
	tw.parallel().tween_property(row, "modulate", Color.WHITE, 0.45) \
			.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)



























var _rel_scope: String = ""

func _tiene_seleccion() -> bool:
	return not Career.nationality.is_empty() and not Career.nat_retired

func _with_nat() -> bool:
	if not _tiene_seleccion():
		return false
	if not _rel_scope.is_empty():
		return _rel_scope == "seleccion"
	return String(GameState.current_fixture().get("comp", "")) == "nat"








func _rel_levels() -> Dictionary:
	if not _with_nat():




		var mine: Dictionary = Career.rel.duplicate()
		mine["aficion"] = Career.rel_eff("aficion")
		mine["prensa"] = Career.rel_eff("prensa")



		if not Career.pareja_activa():
			mine.erase("pareja")
		return mine
	var out: Dictionary = Career.rel.duplicate()
	out["tecnico"] = int(Career.nat_rel["tecnico"])
	out["equipo"] = int(Career.nat_rel["equipo"])
	out["aficion"] = int(Career.nat_rel["aficion"])


	out.erase("pareja")
	return out


