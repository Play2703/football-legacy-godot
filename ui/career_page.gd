	var out: Array = [{"id": "acepto", "icono": "puerta", "nombre": I18n.t("SALIR"),
		"color": CareerTheme.DANGER if concurso else CareerTheme.accent_ink(), "tap": acepta,
		"texto": I18n.t("ACEPTO SALIR"),
		"kind": CareerTheme.Kind.WARN if concurso else CareerTheme.Kind.PRIMARY}]
	var ficha: String = _short_money(Market.project_wage(int(Career.contract["wage"])))
	if concurso:
		var corta: Callable = func() -> void:
			_confirm(I18n.t("¿TE BAJAS LA FICHA?"),
				I18n.t("Cobras menos lo que reste de contrato y el administrador te saca de la"
				+ " lista. El vestuario y la grada lo ven."),
				I18n.t("ACEPTO"), false, func() -> void: Career.accept_concurso_cut())
		out.append({"id": "bajar_ficha", "icono": "moneda", "nombre": I18n.t("BAJAR FICHA"),
			"color": CareerTheme.DANGER, "cifra": ficha, "tap": corta})
		return out
	var cuerpo: String = I18n.t("Te quedas, y en el vestuario nadie te lo reprocha. La grada no"
		+ " cambia sola: esa hay que ganársela en el campo.") if Career.venta_por_grada() \
				else I18n.t("Te quedas, pero el club contaba con ese traspaso: bajan técnico,"
		+ " equipo y afición.")
	var niega: Callable = func() -> void:
		_confirm(I18n.t("¿TE NIEGAS A SALIR?"), cuerpo, I18n.t("ME QUEDO"), true,
			func() -> void: Career.refuse_forced_sale())
	out.append({"id": "niego", "icono": "cerrar", "nombre": I18n.t("ME NIEGO"),
		"color": CareerTheme.DANGER, "tap": niega, "texto": I18n.t("ME NIEGO"),
		"kind": CareerTheme.Kind.WARN})
	if Career.venta_por_grada():
		return out
	var baja: Callable = func() -> void:
		_confirm(I18n.t("¿TE BAJAS LA FICHA?"),
			I18n.t("Cobras menos lo que reste de contrato, pero el club retira la"
			+ " venta y refuerza. Sigues libre de salir cuando quieras."),
			I18n.t("ACEPTO"), false, func() -> void: Career.accept_project(true))
	var sube: Callable = func() -> void:
		_confirm(I18n.t("¿TE SUBES LA CLÁUSULA?"),
			I18n.tf("No cobras menos, pero te blindas: salir de aquí costará mucho más"
			+ " y firmas {0} temporada más.", [Market.PROJECT_EXTRA_SEASON]),
			I18n.t("ACEPTO"), false, func() -> void: Career.accept_project(false))
	out.append({"id": "bajar_ficha", "icono": "moneda", "nombre": I18n.t("BAJAR FICHA"),
		"color": CareerTheme.DANGER, "cifra": ficha, "tap": baja})


	out.append({"id": "subir_clausula", "icono": "candado", "nombre": I18n.t("CLÁUSULA"),
		"valor": I18n.t("SUBIR"), "color": _protege_col(), "tap": sube,
		"cifra": _short_money(Market.project_clause(int(Career.contract["clause"])))})
	return out




