func _ft_apoyo(pa: Dictionary) -> void:
	var apoyo: VBoxContainer = pa["apoyo"]
	var caro: Dictionary = _ft_mas_caro()
	var heroe: VBoxContainer = _ft_heroe_ventana() if caro.is_empty() else _ft_heroe_caro(caro)
	apoyo.add_child(heroe)





	var candidatas: Array = []
	var club_b: Button = _ft_baldosa_club()
	var gasto_b: Button = _ft_baldosa_gasto()
	candidatas.append(club_b if club_b != null else gasto_b)
	candidatas.append(_ft_baldosa_ventana() if not caro.is_empty() else _ft_baldosa_siguiente())
	if club_b != null:
		candidatas.append(gasto_b)
	if not caro.is_empty():
		candidatas.append(_ft_baldosa_siguiente())
	candidatas.append(_ft_baldosa_presupuesto())
	candidatas.append(_ft_baldosa_valor())
	var baldosas: Array[Button] = []
	for c in candidatas:
		if c != null:
			baldosas.append(c as Button)



	for b in baldosas:


		b.custom_minimum_size.y = maxf(b.custom_minimum_size.y, FT_BALDOSA_H)

		b.visible = baldosas.find(b) < FT_BALDOSAS_FIJAS
		apoyo.add_child(b)


	CareerUi.baldosas_avance_juntas(baldosas.slice(0, FT_BALDOSAS_FIJAS))
	CareerUi.heroe_cabe(heroe, float(pa["ancho_apoyo"]))
	apoyo.resized.connect(_ft_baldosas_caben.bind(apoyo, baldosas), CONNECT_DEFERRED)
	var b_agente: Button = CareerUi.accion("mercado", I18n.t("AGENTE"), _ft_color_agente())
	b_agente.custom_minimum_size.y = CareerTheme.TOQUE_PRINCIPAL_TUMBADO
	b_agente.set_meta("fl_principal", true)
	b_agente.pressed.connect(func() -> void: _on_tab("mercado"))
	(pa["cta"] as VBoxContainer).add_child(b_agente)









func _ft_baldosas_caben(apoyo: VBoxContainer, baldosas: Array[Button]) -> void:
	if not is_instance_valid(apoyo) or apoyo.size.y <= 0.0:
		return
	var sep: float = float(apoyo.get_theme_constant("separation"))
	var otros: float = 0.0
	var k: int = 0
	for c in apoyo.get_children():
		var cc: Control = c as Control
		if cc == null or not cc.visible or (cc is Button and baldosas.has(cc as Button)):
			continue
		otros += cc.get_combined_minimum_size().y
		k += 1
	var n: int = mini(FT_BALDOSAS_FIJAS, baldosas.size())

	while n < mini(baldosas.size(), 4) and is_instance_valid(baldosas[n]) \
			and otros + float(n + 1) * FT_BALDOSA_H + sep * float(k + n) <= apoyo.size.y:
		n += 1
	var cambia: bool = false
	for i in baldosas.size():
		if is_instance_valid(baldosas[i]) and baldosas[i].visible !=(i < n):
			baldosas[i].visible = i < n
			cambia = true
	if not cambia:
		return


	var vistas: Array = []
	for i in n:
		baldosas[i].size_flags_stretch_ratio = 1.0
		vistas.append(baldosas[i])
	CareerUi.baldosas_avance_juntas(vistas)




