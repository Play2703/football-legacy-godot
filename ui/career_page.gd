func _cal_tramos(d: Dictionary) -> Array:
	var out: Array = []
	var mes_de: Dictionary = d["mes_de_sem"]
	var por_semana: Dictionary = d["por_semana"]
	for sem in range(int(d["primera"]), int(d["ultima"]) + 1):
		var m: int = int(mes_de.get(sem, 0))
		if out.is_empty() or int((out[-1] as Dictionary)["mes"]) != m:
			out.append({"mes": m, "desde": sem, "hasta": sem, "partidos": []})
		var t: Dictionary = out[-1]
		t["hasta"] = sem
		var dias: Dictionary = por_semana.get(sem, {})
		var cols: Array = dias.keys()
		cols.sort()
		for c in cols:
			(t["partidos"] as Array).append(dias[c])
	return out








