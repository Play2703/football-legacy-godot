func _torn_leyenda_liga(filas: Array, mine: bool, vista: int) -> Array:
	var out: Array = []
	if filas.is_empty():
		return out
	var zones: Dictionary = _torn_zones(_torn_country, _torn_div, filas.size(), vista)
	var keys: Array = zones.keys()
	keys.sort()
	var vistos: Array = []
	for k in keys:
		var etiqueta: String = String((zones[k] as Dictionary)["label"])
		if vistos.has(etiqueta):
			continue
		vistos.append(etiqueta)
		var ultimo: int = int(k)
		for k2 in keys:
			if String((zones[k2] as Dictionary)["label"]) == etiqueta:
				ultimo = maxi(ultimo, int(k2))
		var puestos: String = str(int(k)) if ultimo == int(k) else "%d-%d" % [int(k), ultimo]
		out.append({"color":(zones[k] as Dictionary)["color"],
			"texto": "%s · %s" % [puestos, etiqueta]})
	var sanc: bool = false
	for f in filas:
		sanc = sanc or bool((f as Dictionary)["sancion"])
	if sanc:
		out.append({"color": CareerTheme.DANGER,
			"texto": I18n.tf("-{0} por fair play", [ClubFinance.FFP_PUNTOS])})
	var obj: int = _torn_obj_line(mine, vista)
	if obj > 0:
		out.append({"color": CareerTheme.SURFACE_LINE,
			"texto": I18n.tf("— objetivo del club: {0} —", [_ordinal(obj)])})
	var falta: String = _torn_zone_missing_texto(vistos)
	if not falta.is_empty():
		out.append({"color": Color.TRANSPARENT, "texto": falta})
	return out













