func _page_noticias() -> void:


	if UiKit.es_horizontal():
		_page_noticias_tumbada()
		return
	if _wnews_scope.is_empty():
		_wnews_scope = _wnews_default_scope()
	CareerUi.head(_content, I18n.t("NOTICIAS"))




	var ancho: float = _content.size.x if _content.size.x > 0.0 else _ancho_contenido_retrato()


	_placa.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_content.size_flags_vertical = Control.SIZE_EXPAND_FILL
	var app: VBoxContainer = Celular.vertical(_content, ancho, _wnews_ambitos(), _wnews_scope,
		_wnews_elige, _wnews_marcas())
	Celular.cabecera(app, _wnews_scope, _wnews_scope_text())
	var w: float = Celular.ancho_app_vertical(ancho)


	if _wnews_scope == "redes":
		RedesTira.build_retrato(self, app, w)
		return


	if _wnews_scope == "mensajes":
		if Celular.redes_pendiente():
			Celular.aviso(app, Celular.aviso_quien(), Celular.aviso_texto(), func() -> void:
				_wnews_elige("redes"))
		MensajesTira.build_retrato(self, app, w)
		return
	if has_meta("redes_todas"):
		remove_meta("redes_todas")
	if Celular.redes_pendiente():
		Celular.aviso(app, Celular.aviso_quien(), Celular.aviso_texto(), func() -> void:
			_wnews_elige("redes"))
	var rows: Array = _wnews_rows(_wnews_scope, WNEWS_ROWS)
	if rows.is_empty():
		CareerUi.vacio_apaisado(app, _wnews_empty_text(), "mundo")
		return
	var lista: VBoxContainer = VBoxContainer.new()
	lista.add_theme_constant_override("separation", 6)
	app.add_child(lista)




	var grupo: int = -1
	for i in rows.size():
		var f: Dictionary = rows[i]
		var t: int = int(f.get("season", 0))
		if t != grupo:
			grupo = t
			lista.add_child(_wnews_sep(t))


		lista.add_child(_wnews_row(f, i == 0))




