func _oferta() -> Dictionary:
	var deal: Dictionary = Career.shop_deal()
	if deal.is_empty():
		return {}
	var item: Dictionary = deal.get("item", {})
	var family: String = String(deal.get("family", ""))
	var id: String = String(item.get("id", ""))
	var full: int = Career.shop_price_full(family, item)
	var tuya: bool =(family == "boots" and Career.owned.has(id)) \
			or (family == "lifestyle" and Career.has_lifestyle(id)
			and not bool(item.get("repeat", false)))
	return {"id": id, "family": family, "full": full, "tuya": tuya,
		"tab": {"boots": "botas", "item": "consumibles",
			"lifestyle": "estilo"}.get(family, "")}





func _con_oferta_primero(lista: Array, family: String) -> Array:
	var of: Dictionary = _oferta()
	if of.is_empty() or String(of["family"]) != family:
		return lista
	var out: Array = []
	for d in lista:
		if String((d as Dictionary).get("id", "")) == String(of["id"]):
			out.push_front(d)
		else:
			out.append(d)
	return out



