func _cal_ronda(f: Dictionary) -> String:
	var torneo: String = Competitions.torneo_key(f)
	var raw: String = Competitions.round_of(f).strip_edges()
	if not torneo.is_empty() and (raw.begins_with("J") or raw.begins_with("j")):
		var rest: String = raw.substr(1)
		var slash: int = rest.find("/")
		var num: String = rest.substr(0, slash) if slash >= 0 else rest
		if num.is_valid_int():
			return "%s · %s" % [I18n.t(torneo), I18n.tf("J{0}", [num])]
	return CareerUi.pretty_round(f)








