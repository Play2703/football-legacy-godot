		CareerUi.close_modal(box)
		_refresh()
	var fuera_cb: Callable = func() -> void:
		Career.dismiss_rumor(id)
		cierra.call()
	var pie_cb: Callable = func() -> void:
		Career.nudge_club(id)
		cierra.call()
	var fuera: Dictionary = {"texto": I18n.t("NO ME INTERESA"), "kind": CareerTheme.Kind.WARN,
		"hold_s": RUMOR_HOLD_S, "cb": fuera_cb}
	var pie: Dictionary = {"texto": I18n.t("LE DOY PIE"), "kind": CareerTheme.Kind.PRIMARY,
		"hold_s": RUMOR_HOLD_S, "cb": pie_cb}
	var con_pie: bool = not Career.market_open() and Career.courting_club.is_empty()
	var con_fuera: bool = not Career.seeded_rumors().has(id)
	if not con_pie and not con_fuera:
		return
	var cta: VBoxContainer = VBoxContainer.new()
	cta.name = "Cta"
	cta.add_theme_constant_override("separation", 16)
	box.add_child(cta)
	if con_pie and con_fuera:
		CareerUi.cta_par(cta, fuera, pie)
	elif con_pie:
		_mt_cta_uno(cta, pie)
	else:
		_mt_cta_uno(cta, fuera)
	_mt_cta_ajusta(cta)







func _mt_subficha() -> bool:
	if Career.free_agent or Career.pending_loans.is_empty() or not Career.loan_window_open():
		_loan_open = -1
	else:
		_loan_open = clampi(_loan_open, -1, Career.pending_loans.size() - 1)
	if Career.pending_offers.is_empty():
		_offer_open = -1
	else:
		_offer_open = clampi(_offer_open, -1, Career.pending_offers.size() - 1)
	if _loan_open < 0 and _offer_open < 0:
		return false
	var d: Dictionary = {}
	if _loan_open >= 0:
		_ficha_cesion(_loan_open)
		d = Career.pending_loans[_loan_open] as Dictionary
	else:
		_offer_idx = _offer_open
		d = Career.pending_offers[_offer_idx] as Dictionary




		var fila: HBoxContainer = HBoxContainer.new()
		fila.name = "FichaTumbada"
		fila.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
		_content.add_child(fila)
		var antes: VBoxContainer = _content
		var cols: Array[VBoxContainer] = []
		for k in 2:
			var col: VBoxContainer = VBoxContainer.new()
			col.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
			col.size_flags_horizontal = Control.SIZE_EXPAND_FILL


			col.size_flags_stretch_ratio = 2.0 if k == 0 else 3.0
			fila.add_child(col)
			cols.append(col)
		_content = cols[0]
		_ficha_topbar(_offer_open)


		var barra: Node = cols[0].get_child(cols[0].get_child_count() - 1)
		for l in barra.find_children("*", "Label", false, false):
			(l as Label).text = "%d / %d" % [_offer_open + 1, Career.pending_offers.size()]
		await _offer_xi(String(d.get("id", "")), _mt_pos(d))


		if not is_inside_tree():
			_content = antes
			return true
		_content = cols[1]
		_offer_card(Career.pending_offers[_offer_idx], _offer_idx, Career.free_agent)
		_content = antes



		for l in cols[1].find_children("*", "Label", true, false):
			var lb: Label = l as Label
			if lb.autowrap_mode != TextServer.AUTOWRAP_OFF and lb.text.strip_edges().ends_with("."):
				lb.visible = false
		return true
	await _offer_xi(String(d.get("id", "")), _mt_pos(d))
	return true


func _mt_pos(d: Dictionary) -> String:
	var pos: String = String(d.get("pos", ""))
	return Career.puesto_hoy() if pos.is_empty() else pos


















func _mt_estado() -> void:
	var pa: Dictionary = _plantilla_pagina()
	_content.add_child(pa["raiz"])
	var mesa: bool = Career.mesa_abierta()
	var acciones: Array = _mt_estado_acciones(mesa)
	var grupo: Array = _mt_estado_grupo(acciones)
	var ids_cta: Array = []
	for e in grupo:
		ids_cta.append(String((e as Dictionary)["id"]))
	var baldosas: Array = acciones.filter(func(e: Dictionary) -> bool:
		return not ids_cta.has(String(e["id"])))
	var rejilla: Control = _mt_estado_rejilla(baldosas)
	(pa["contenido"] as VBoxContainer).add_child(rejilla)


	if mesa and Career.market_open():
		_agent_en_curso_visto = _agent_en_curso_ahora()
	var apoyo: VBoxContainer = pa["apoyo"]
	var heroe: VBoxContainer = _mt_heroe()
	apoyo.add_child(heroe)
	CareerUi.heroe_cabe(heroe, float(pa["ancho_apoyo"]), [72, 48, 32, 24])


	var valor: Button = _mt_baldosa_valor()
	if valor != null:
		apoyo.add_child(valor)
	var ficha: PanelContainer = _mt_estado_ficha(ids_cta)
	ficha.size_flags_vertical = Control.SIZE_EXPAND_FILL


	_mt_ficha_reparte(ficha)
	apoyo.add_child(ficha)
	_mt_estado_cta(pa["cta"] as VBoxContainer, grupo)




	var botones: Array =(pa["cta"] as VBoxContainer).find_children("*", "Button", true, false)
	var primero: Control = null
	for b in botones:
		if not Entrada.es_peligro(b):
			primero = b
			break
	if primero == null and not botones.is_empty():
		primero = botones[0]
	if primero == null:
		for b in rejilla.find_children("*", "Button", true, false):
			if not (b as Button).disabled and String(b.get_meta("mt_estado", "")) != "mesa":
				primero = b
				break
	if primero != null:
		primero.set_meta(Entrada.PRIMERO_META, true)







	var ds: DragScroll = _scroll as DragScroll
	if ds != null:
		var raiz: Control = pa["raiz"]
		var encaja: Callable = _mt_estado_encaja.bind(raiz, heroe, apoyo)
		ds.repartido_listo.connect(encaja, CONNECT_DEFERRED)
		raiz.tree_exited.connect(func() -> void:
			if is_instance_valid(ds) and ds.repartido_listo.is_connected(encaja):
				ds.repartido_listo.disconnect(encaja))




const MT_ENCAJA_PASOS: Array = [[72, false], [48, false], [48, true], [32, true], [24, true]]









func _mt_estado_encaja(raiz: Control, heroe: VBoxContainer, apoyo: VBoxContainer) -> void:
	if not is_instance_valid(raiz) or not is_instance_valid(heroe) or not raiz.is_inside_tree():
		return
	var ds: DragScroll = _scroll as DragScroll
	var cifra: Label = heroe.get_meta("heroe_cifra", null) as Label
	if ds == null or cifra == null or ds.alto_fila <= 0.0:
		return
	var alto: float = ds.alto_fila + 0.5
	var f: Font = cifra.get_theme_font("font")
	var letra: int = cifra.get_theme_font_size("font_size")
	var base: float = raiz.get_combined_minimum_size().y - f.get_height(letra)
	if base + f.get_height(letra) <= alto:
		return
	var paso: int = int(heroe.get_meta("encaja_paso", 0))
	var cajas: Array = [apoyo, apoyo.get_parent() as BoxContainer]
	var aire: float = 0.0
	for c in cajas:
		if c is BoxContainer:
			var vivos: int = 0
			for h in (c as BoxContainer).get_children():
				if h is Control and (h as Control).visible:
					vivos += 1
			aire += maxf(0.0, float((c as BoxContainer).get_theme_constant("separation")) - 8.0) \
					* maxi(0, vivos - 1)
	var elegido: int = MT_ENCAJA_PASOS.size() - 1
	for i in range(paso + 1, MT_ENCAJA_PASOS.size()):
		var p: Array = MT_ENCAJA_PASOS[i]
		if base + f.get_height(int(p[0])) -(aire if bool(p[1]) else 0.0) <= alto:
			elegido = i
			break
	if elegido <= paso:
		return
	heroe.set_meta("encaja_paso", elegido)
	var e: Array = MT_ENCAJA_PASOS[elegido]
	if int(e[0]) != letra:
		cifra.add_theme_font_size_override("font_size", int(e[0]))
	if bool(e[1]):
		for c in cajas:
			if c is BoxContainer:
				(c as BoxContainer).add_theme_constant_override("separation", 8)









func _mt_estado_acciones(mesa: bool) -> Array:
	var vuelve: Callable = func() -> void:
		_mt_vista = ""
		_refresh()
	var out: Array = [{"id": "mesa", "icono": "mesa", "nombre": I18n.t("MESA", "mercado"),
		"color": CareerTheme.NAV_MUNDO, "bloque": "estado", "tap": vuelve}]
	if Career.on_loan() or Career.free_agent or Career.retired:
		return out
	out.append_array(_mt_ea_estado())
	if mesa and Career.forced_sale:
		out.append_array(_mt_ea_venta())
	if Career.forced_loan:
		out.append_array(_mt_ea_cesion())
	if mesa and not Career.counter_offer.is_empty():
		out.append_array(_mt_ea_contra())
	if mesa:
		out.append_array(_mt_ea_pides())
	out.append_array(_mt_ea_no_venta())
	out.append_array(_mt_ea_contrato())
	if mesa:
		out.append_array(_mt_ea_noes(vuelve))
		out.append_array(_mt_ea_agente())


	var vistos: Array = []
	var limpio: Array = []
	for e in out:
		var id: String = String((e as Dictionary)["id"])
		if not vistos.has(id):
			vistos.append(id)
			limpio.append(e)
	return limpio




func _mt_ea_estado() -> Array:
	var est: Dictionary = Career.estatus_club()
	var salida: String = String(est.get("salida", ""))
	var detalle: String = String(est.get("detalle", ""))
	var clausula: int = int(Career.contract.get("clause", 0))
	var vendes: bool = salida == "EN VENTA" or salida == "PEDISTE SALIR" or salida == "EN CESIÓN"
	var bloq: int = Career.ofertas_bloqueadas()
	var defs: Array = [
		["estado_candado", "candado", "NO TE VENDEN", CareerTheme.accent_ink(),
			_short_money(clausula) if clausula > 0 else "", salida == "NO TE VENDEN",
			I18n.tf("{0} BLOQUEADAS", [bloq]) if bloq > 0 else ""],
		["estado_moneda", "moneda", "SI PAGAN", CareerTheme.MONEY,
			_short_money(Career.asking_price()), salida == "TE ESCUCHAN", ""],
		["estado_mercado", "mercado", salida if vendes else "EN VENTA", CareerTheme.DANGER, "",
			vendes, ""],
	]
	var out: Array = []
	for d in defs:
		var on: bool = bool(d[5])
		var tinta: Color = d[3]
		var nota: String = detalle if on and not detalle.is_empty() \
				else I18n.t(_estado_nota(String(d[2]), on))


		if String(d[2]) == "PEDISTE SALIR":
			var dicho: String = Career.salida_dicho(Salida.VIA_TRASPASO)
			if not dicho.is_empty():
				nota = "%s · %s" % [I18n.tf("DIJISTE: {0}",
					[I18n.t(Salida.rotulo(Salida.VIA_TRASPASO, dicho))]),
					I18n.tf("TE COMPROMETE: {0}", [I18n.t(Salida.promesa(Salida.VIA_TRASPASO, dicho))])]
		var e: Dictionary = {"id": d[0], "icono": d[1], "nombre": I18n.t(String(d[2])),
			"color": tinta, "cifra": String(d[4]), "valor": String(d[6]), "on": on,
			"bloque": "estado"}
		e["tap"] = func() -> void: _toast(nota, tinta)
		out.append(e)
	return out





func _mt_ea_pides() -> Array:
	if Career.unsettled or Career.for_sale or Career.free_agent or Career.on_loan() \
			or Career.forced_sale or not Career.pending_precontract.is_empty():
		return []
	if Career.transfer_requested:
		var retira: Callable = func() -> void:
			_confirm(I18n.t("¿RETIRAR LA PETICIÓN?"),
				I18n.t("Disculpa pública: sales de la lista de venta. La afición se"
				+ " lo cobra, y el técnico tardará un par de partidos en volver a"
				+ " contar contigo — dijiste que te ibas."),
				I18n.t("ME QUEDO"), false, func() -> void:
					if Career.retract_transfer():
						_toast(I18n.t("RETIRASTE LA PETICIÓN"), CareerTheme.accent_text()))
		return [{"id": "retirar", "icono": "cerrar", "nombre": I18n.t("RETIRAR"),
			"color": CareerTheme.DANGER, "tap": retira, "texto": I18n.t("RETIRAR LA PETICIÓN"),
			"kind": CareerTheme.Kind.WARN}]
	var otras_cesiones: Array = Career.pending_loans.filter(func(d: Dictionary) -> bool:
		return not bool(d.get("encore", false)))
	var puede_ceder: bool = Career.loan.is_empty() and Career.loan_window_open() \
			and otras_cesiones.is_empty() and Career.list_status() != Career.LIST_LOAN \
			and Standing.contract_role_from_key(String(Career.contract.get("role",
				"rotacion"))) < Standing.ContractRole.TITULAR \
						and Career.salida_bloqueo(Salida.VIA_CESION).is_empty()
	var puede_traspaso: bool = Career.salida_bloqueo(Salida.VIA_TRASPASO).is_empty()
	if not puede_traspaso and not puede_ceder:
		var nota: String = I18n.t("Tu mercado ya no abre esta temporada: podrás"
			+ " pedir salir cuando abra el de verano.")
		return [{"id": "salir", "icono": "puerta", "nombre": I18n.t("SALIR"),
			"color": CareerTheme.DANGER, "on": false,
			"tap": func() -> void: _toast(nota, CareerTheme.TEXT_MID)}]
	var out: Array = []
	if puede_traspaso:
		out.append({"id": "traspaso", "icono": "puerta", "nombre": I18n.t("TRASPASO"),
			"color": CareerTheme.DANGER, "valor": I18n.t("MANTÉN"),
			"hold": func() -> void: _pide_salida(Salida.VIA_TRASPASO,
				I18n.t("PEDISTE EL TRASPASO"), CareerTheme.DANGER),
			"texto": I18n.t("MANTÉN · TRASPASO"), "kind": CareerTheme.Kind.WARN})
	if puede_ceder:

		out.append({"id": "ceder", "icono": "mover", "nombre": I18n.t("CESIÓN"),
			"color": CareerTheme.STAT_ASSIST, "valor": I18n.t("MANTÉN"),
			"hold": func() -> void: _pide_salida(Salida.VIA_CESION,
				I18n.t("PEDISTE SALIR CEDIDO"), CareerTheme.accent_text()),
			"texto": I18n.t("MANTÉN · CESIÓN"), "kind": CareerTheme.Kind.PRIMARY,
			"tinte": CareerTheme.STAT_ASSIST})
	return out




func _mt_ea_no_venta() -> Array:
	var bloqueo: String = Career.no_venta_bloqueo()
	if bloqueo == "ya_pedido":
		if Career.no_venta_concedida():
			return []
		var nota: String = I18n.t("La directiva dijo NO: no cuentas lo bastante."
			+ " Puedes volver a pedirlo la temporada que viene.")
		return [{"id": "no_venta", "icono": "candado", "nombre": I18n.t("NO VENDERME"),
			"color": CareerTheme.DANGER, "on": false, "cifra": I18n.t("NO"),
			"tap": func() -> void: _toast(nota, CareerTheme.DANGER)}]
	if not bloqueo.is_empty() or Career.club_blocks_sale():
		return []
	var pide: Callable = func() -> void:
		_confirm(I18n.t("¿PEDIR QUE NO TE VENDAN?"),
			I18n.t("Lo decide la directiva, una vez por temporada. Si dice que sí,"
			+ " rechaza las ofertas por ti este año. La cláusula sigue valiendo."),
			I18n.t("PEDIRLO"), false, func() -> void:
				var si: bool = Career.pedir_no_venta()
				_toast(I18n.t("LA DIRECTIVA DICE SÍ") if si
					else I18n.t("LA DIRECTIVA DICE NO"),
					CareerTheme.accent_ink() if si else CareerTheme.DANGER)
				_refresh_keeping_scroll())
	return [{"id": "no_venta", "icono": "candado", "nombre": I18n.t("NO VENDERME"),
		"color": CareerTheme.accent_ink(), "valor": I18n.t("PEDIR"), "tap": pide}]





func _mt_ea_contrato() -> Array:
	var out: Array = []
	var reneg_viva: bool = not _reneg_oferta_viva().is_empty()
	var visible: bool = _renovacion_visible()
	if reneg_viva:
		if Career.renegotiation_open():
			out.append({"id": "mejora", "icono": "contrato_firma", "nombre": I18n.t("MEJORA"),
				"color": CareerTheme.MONEY, "tap": _confirm_renegotiation,
				"texto": I18n.t("FIRMAR LA MEJORA"), "kind": CareerTheme.Kind.PRIMARY})
			out.append_array(_mt_ea_mesas())
		else:
			out.append({"id": "pide_mesa", "icono": "contrato_firma",
				"nombre": I18n.t("RENEGOCIAR"), "color": CareerTheme.MONEY,
				"cifra": "%d%%" % int(round(Career.renegotiation_sit_p() * 100.0)),
				"tap": _confirm_ask_table, "texto": I18n.t("PEDIR MESA AL CLUB"),
				"kind": CareerTheme.Kind.PRIMARY})
	elif not visible:

		var reneg: Dictionary = Career.renegotiation_gate()
		var falta: Array = reneg.get("missing", []) as Array
		if int(Career.contract["seasons_left"]) > 1 and Career.loan.is_empty() \
				and not Career.free_agent and not bool(reneg["ok"]) \
				and (falta.has("cooldown") or falta.has("refused")):
			out.append({"id": "gastada", "icono": "contrato_firma", "nombre": I18n.t("RENEGOCIAR"),
				"color": CareerTheme.MONEY, "on": false, "valor": I18n.t("EL AÑO QUE VIENE")})
	if not visible:
		return out
	if Career.can_renew():
		out.append({"id": "renovar", "icono": "contrato_firma", "nombre": I18n.t("RENOVAR"),
			"color": CareerTheme.MONEY, "tap": _confirm_renewal,
			"texto": I18n.t("RENOVAR CONTRATO"), "kind": CareerTheme.Kind.PRIMARY})


		var packs: Array = Career.renewal_packages()
		if packs.size() > 1:
			var o: Dictionary = _renewal_selected(packs)
			var opciones: Array = []
			for p in packs:
				opciones.append({"id": String(p["pack"]), "icon_type": "contrato_firma",
					"color": CareerTheme.NAV_YO,
					"texto": I18n.t(String(_PACK_LABELS.get(String(p["pack"]), "EQUILIBRIO")))})
			var elige: Callable = func() -> void:
				CareerUi.modal_rejilla(self, I18n.t("CAMINO"), opciones, func(id: String) -> void:
					_renewal_pack = id
					_refresh(), String(o.get("pack", "equilibrio")))
			out.append({"id": "camino", "icono": "contrato_firma", "nombre": I18n.t("CAMINO"),
				"color": CareerTheme.NAV_YO, "tap": elige,
				"valor": I18n.t(String(_PACK_LABELS.get(String(o.get("pack", "")), "EQUILIBRIO")))})
		out.append_array(_mt_ea_mesas())
	if Career.descartado() or Career.is_frozen():
		return out
	var no_renueva: Callable = func() -> void:
		_confirm(I18n.t("¿NO RENOVAR?"),
			I18n.t("El club te pondrá en venta para no perderte gratis. Si no sales, "
			+ "jugarás menos el resto del año. Si aguantas, quedarás libre al final."),
			I18n.t("MANTÉN PARA NO RENOVAR"), true, func() -> void:
				Career.decline_renewal()
				_toast(I18n.t("NO RENUEVAS · EL CLUB TE VENDE"), CareerTheme.DANGER),
			true)
	out.append({"id": "no_renovar", "icono": "cerrar", "nombre": I18n.t("NO RENOVAR"),
		"color": CareerTheme.DANGER, "tap": no_renueva, "texto": I18n.t("NO RENOVAR"),
		"kind": CareerTheme.Kind.WARN})
	return out




func _mt_ea_mesas() -> Array:
	var out: Array = []
	if Career.club_pulse_taken():
		var nota: String = I18n.t("Ya negociaste tu ficha esta temporada.")
		out.append({"id": "sueldo", "icono": "moneda", "nombre": I18n.t("SUELDO"),
			"color": CareerTheme.MONEY, "on": false,
			"tap": func() -> void: _toast(nota, CareerTheme.TEXT_MID)})
	elif bool(Career.club_pulse_bounds().get("ok", false)):
		out.append({"id": "sueldo", "icono": "moneda", "nombre": I18n.t("SUELDO"),
			"color": CareerTheme.MONEY, "valor": I18n.t("NEGOCIAR"), "tap": _go_club_pulse})
	var cl: Dictionary = Career.clausulas_mesa_club(_renewal_pack)
	if bool(cl.get("ok", false)):
		out.append({"id": "clausulas", "icono": "contrato_firma", "nombre": I18n.t("CLÁUSULAS"),
			"color": CareerTheme.NAV_YO, "valor": I18n.t("NEGOCIAR"),
			"tap": _abrir_clausulas_club})
	elif String(cl.get("why", "")) == "YA NEGOCIASTE ESTE AÑO":
		var nota2: String = I18n.t("Ya negociaste tus cláusulas esta temporada.")
		out.append({"id": "clausulas", "icono": "contrato_firma", "nombre": I18n.t("CLÁUSULAS"),
			"color": CareerTheme.NAV_YO, "on": false,
			"tap": func() -> void: _toast(nota2, CareerTheme.TEXT_MID)})
	return out




func _mt_ea_noes(vuelve: Callable) -> Array:
	var out: Array = []
	var noes: int = Career.market_rejects()
	var hoy: int = Career.offers_expiring_today()
	if noes > 0:
		var en_venta: bool = Career.sale_patience_counts()
		var val: String = "%d/%d" % [Career.sale_rejects(), Market.SALE_PATIENCE] \
				if en_venta else str(noes)
		var malo: bool =(en_venta and Career.sale_rejects() >= Market.SALE_PATIENCE - 1) \
				or noes > Market.REJECT_FREE
		var nota: String = ""
		if Career.sale_broken():
			nota = I18n.t("Se hartaron de tus noes: el club contaba con"
				+ " esa venta. El técnico deja de contar contigo hasta el año que viene.")
		elif noes > Market.REJECT_FREE:
			nota = I18n.t("Llevas muchos noes: lo que llega ahora ya no"
				+ " es del nivel de lo que tumbaste.")
		var e: Dictionary = {"id": "noes", "icono": "cerrar", "nombre": I18n.t("TUS NOES"),
			"color": CareerTheme.DANGER, "cifra": val, "on": malo}
		if not nota.is_empty():
			e["tap"] = func() -> void: _toast(nota, CareerTheme.DANGER)
		out.append(e)
	if hoy > 0:
		out.append({"id": "hoy", "icono": "jornada", "nombre": I18n.t("SE VAN HOY"),
			"color": CareerTheme.DANGER, "cifra": str(hoy), "tap": vuelve})
	return out





func _mt_ea_agente() -> Array:
	if not Career.market_open():
		return []
	var notas: Array[String] = []
	if not Career.agent_task.is_empty():
		var kind: String = String(Career.agent_task.get("kind", ""))
		notas.append(I18n.tf("Tu agente trabaja la liga de {0}: sus clubes"
			+ " entran primero.", [String(Career.agent_task.get("target", ""))])
			if kind == "league"
			else I18n.t("Tu agente te está moviendo: esta ventana entran más clubes."))
	if not Career.agent_shot.is_empty():
		notas.append(I18n.t("Tu agente sostiene esa oferta: se sabe en la"
			+ " próxima jornada.")
			if String(Career.agent_shot.get("kind", "")) == "hold"
			else I18n.t("Tu agente está tocando esa puerta: se sabe en la próxima jornada."))
	var libres: int = Career.agent_tasks_left()
	var cerrado: bool = libres <= 0 or Career.market_deadline()
	if Career.market_deadline():
		notas.append(I18n.t("El mercado cierra hoy: ya no hay tiempo para encargos."))
	elif libres <= 0:
		notas.append(I18n.t("Tu agente no acepta más encargos esta ventana."))
	var conf: int = int(Career.rel["agente"])
	var nota: String = " ".join(PackedStringArray(notas)) if not notas.is_empty() \
			else "%s %d" % [CareerTheme.caps(I18n.t("CONFIANZA")), conf]
	var pasivo: String = String(Career.agent_task.get("kind", ""))
	var tiro: String = String(Career.agent_shot.get("kind", ""))
	var mueve: Callable = func() -> void:
		if not Career.agent_commission("push"):
			_toast(I18n.t("NO TE ALCANZA"), CareerTheme.DANGER)
	return [
		{"id": "agente", "icono": "agente", "nombre": I18n.t("TU AGENTE"),
			"color": CareerTheme.accent_text(), "cifra": str(conf), "barra": float(conf) / 100.0,
			"valor": I18n.tf("{0} LIBRE" if libres == 1 else "{0} LIBRES", [libres]),
			"on": not cerrado, "bloque": "agente", "ancha": true,
			"tap": func() -> void: _toast(nota, CareerTheme.accent_text())},
		{"id": "ag_push", "nombre": I18n.t("MUÉVEME"), "bloque": "agente",
			"agente": ["mover", "push", cerrado or pasivo != "", pasivo == "push", mueve]},
		{"id": "ag_liga", "nombre": I18n.t("UNA LIGA"), "bloque": "agente",
			"agente": ["mundo", "league", cerrado or pasivo != "", pasivo == "league",
				func() -> void: _agent_pick_country(false)]},
		{"id": "ag_club", "nombre": I18n.t("UN CLUB"), "bloque": "agente",
			"agente": ["puerta", "club", cerrado or tiro != "", tiro == "club",
				func() -> void: _agent_pick_country(true)]},
	]




