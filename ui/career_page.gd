		pz.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(pz)
	elif Career.is_frozen():
		CareerUi.head(_content, I18n.t("EN EL ESCAPARATE"))
		var fz: Label = CareerUi.plain(22, CareerTheme.DANGER)
		fz.text = I18n.t("No renuevas: el club te vende y juegas menos hasta que salgas.")
		fz.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(fz)
		CareerUi.dim(_content, I18n.t("Busca una salida en el MERCADO, o aguanta el año y"
			+ " quedarás AGENTE LIBRE al final."))



	if Career.can_retire():
		CareerUi.head(_content, I18n.t("EL FINAL"))
		CareerUi.dim(_content, I18n.t("Los años ya pesan. Puedes seguir peleando... o"
			+ " cerrar la carrera y entrar en la historia con lo que ganaste."))


		CareerUi.dim(_content, I18n.tf("Juegues lo que juegues, a los {0} años se acaba:"
