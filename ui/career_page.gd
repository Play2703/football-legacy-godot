func _reco_ex_txt(f: Dictionary) -> String:
	var n: int = Career.gerencia_ex(f)
	if n <= 0:
		return ""
	var temps: String = "%d %s" % [n, I18n.plural(n, "temporada", "temporadas")]

	if Career.gerencia_precio(f) <= 0 or Career.gerencia_clausula(f):
		return I18n.tf("Jugó aquí {0}", [temps])
	return I18n.tf("Jugó aquí {0} · traspaso -{1} %",
		[temps, roundi(Gerencia.ex_rebaja(n) * 100.0)])




func _reco_bajada_txt(f: Dictionary) -> String:
	var bajada: float = float(Career.gerencia_ojeo(f)["bajada"])
	if bajada <= 1.0:
		return ""
	return I18n.tf("Viene de más arriba: precio +{0} %", [roundi((bajada - 1.0) * 100.0)])





func _reco_tray_txt(f: Dictionary) -> String:
	var oj: Dictionary = Career.gerencia_ojeo(f)
	var mult: float = float(oj.get("tray", 1.0))
	var info: Dictionary = oj.get("tray_info", {}) as Dictionary
	var pct: int = roundi(absf(mult - 1.0) * 100.0)
	if mult > 1.005:
		return I18n.tf("Trayectoria: precio +{0} % ({1} temporadas en ligas grandes)",
			[pct, int(info.get("grandes", 0))])
	if mult < 0.995:
		return I18n.tf("Trotamundos: precio −{0} % ({1} cesiones, {2} clubes)",
			[pct, int(info.get("cesiones", 0)), int(info.get("clubes", 0))])
	return ""





