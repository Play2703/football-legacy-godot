		return I18n.t("PRECONTRATO FIRMADO")
	if Career.free_agent or Career.mesa_abierta():
		return I18n.t("SIN OFERTA")
	return I18n.t("MERCADO CERRADO")




static func _mt_nombre_escalon(l: Label) -> void:
	var w: float = l.size.x
	if w <= 0.0:
		return
	var font: Font = l.get_theme_font("font")
	var px: int = int(l.get_meta("mt_px", CareerTheme.T_LEE_TUMBADO))
	while px > CareerTheme.T_CAP_TUMBADO \
			and font.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, px).x > w:
		px -= 8
	if l.get_theme_font_size("font_size") != px:
		l.add_theme_font_size_override("font_size", px)




