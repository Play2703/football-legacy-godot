		_gerencia_dorsal_row()



func _peldano_placa() -> VBoxContainer:
	var caja: PanelContainer = CareerUi.plate()
	_content.add_child(caja)
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 18)
	caja.add_child(col)
	return col












func _peldano_color(k: int) -> Color:
	if k <= 1:
		return CareerTheme.SURFACE_LINE.lightened(0.3)
	if k >= Gerencia.PELDANO_LEYENDA:
		return CareerTheme.HISTORIA
	return CareerTheme.TIER_COLORS[clampi(k - 2, 0, CareerTheme.TIER_COLORS.size() - 1)]




func _peldano_tinta(k: int) -> Color:
	return CareerTheme.text_on_dark(_peldano_color(k))












func _peldano_escalera(n: int, sel: int = 0, al_tocar: Callable = Callable()) -> HBoxContainer:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 8)
	for k in range(1, Gerencia.PELDANO_MAX + 1):
		var pila: VBoxContainer = VBoxContainer.new()
		pila.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		pila.alignment = BoxContainer.ALIGNMENT_END
		pila.add_theme_constant_override("separation", 6)
		fila.add_child(pila)
		if k == n:
			var tu: PanelContainer = CareerUi.you_tag()
			tu.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
			pila.add_child(tu)
		var b: Button = CareerUi.icon_chip(Gerencia.peldano_icono(k), str(k),
			_peldano_color(k), k <= n,
			al_tocar.bind(k) if al_tocar.is_valid() else _peldano_modal.bind(k))
		b.custom_minimum_size.y = 62.0 + 18.0 * float(k - 1)


		for ic in b.find_children("*", "MenuIcon", true, false):
			(ic as Control).custom_minimum_size = Vector2(44, 44)
		for l in b.find_children("*", "Label", true, false):
			(l as Label).add_theme_font_size_override("font_size", CareerTheme.T_VALUE)
		pila.add_child(b)
		if sel > 0:



			var raya: ColorRect = ColorRect.new()
			raya.custom_minimum_size = Vector2(0, 6)
			raya.color = _peldano_tinta(k)
			raya.modulate.a = 1.0 if k == sel else 0.0
			raya.mouse_filter = Control.MOUSE_FILTER_IGNORE
			pila.add_child(raya)
	return fila







func _peldano_titular(v: Dictionary) -> HBoxContainer:
	var n: int = int(v["n"])
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 12)
	var nombre: Label = CareerUi.plain(CareerTheme.T_HEAD, _peldano_tinta(n))
	nombre.text = CareerTheme.caps(I18n.t(Gerencia.peldano_nombre(n)))
	nombre.clip_text = true
	nombre.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	nombre.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(nombre)
	if bool(v["cedido"]):
		return fila
	var cuando: String = _peldano_cuando(v)

	if _peldano_cae(v):
		fila.add_child(CareerUi.code_chip(CareerTheme.caps(I18n.tf("BAJAS EN {0}",
			[cuando])), CareerTheme.DANGER, CareerTheme.T_DIM))



	elif not String(v["frenado"]).is_empty():
		var pediste: bool = String(v["frenado"]) == "pediste"
		fila.add_child(CareerUi.icon_stat("candado", CareerTheme.caps(I18n.t(
			"PEDISTE SALIR" if pediste else "EN VENTA")),
			CareerTheme.DANGER if pediste else CareerTheme.TEXT_DIM, 34.0))
	elif n < Gerencia.PELDANO_MAX:
		var listo: bool = _peldano_listo(v)
		fila.add_child(CareerUi.icon_stat("check" if listo else "reloj", cuando,
			_peldano_tinta(n + 1) if listo else CareerTheme.TEXT_DIM, 34.0))
	return fila



func _peldano_cuando(v: Dictionary) -> String:
	return CareerTheme.caps(I18n.t("INVIERNO")
		if String(v["revision"]) == "invierno" else I18n.t("VERANO"))





func _peldano_cae(v: Dictionary) -> bool:
	return not bool(v["cedido"]) and int(v["n"]) > 1 and int(v["relacion"]) < int(v["baja"])





func _peldano_listo(v: Dictionary) -> bool:
	var n: int = int(v["n"])
	return n < Gerencia.PELDANO_MAX and int(v["relacion"]) >= int(v["sube"]) \
			and String(v["falta_capitan"]).is_empty() and String(v["frenado"]).is_empty() \
			and (n + 1 != Gerencia.PELDANO_LEYENDA or int(v["partidos"]) >= int(v["partidos_min"]))







func _peldano_progreso(col: VBoxContainer, v: Dictionary) -> void:
	if bool(v["cedido"]):
		col.add_child(CareerUi.icon_stat("candado", CareerTheme.caps(
			I18n.t("CEDIDO: TU NIVEL TE ESPERA")), CareerTheme.TEXT_DIM, 40.0))
		return
	var n: int = int(v["n"])
	var rel: int = int(v["relacion"])
	var cae: bool = n > 1 and rel < int(v["baja"])
	var tope: bool = n >= Gerencia.PELDANO_MAX
	var sig: int = mini(n + 1, Gerencia.PELDANO_MAX)
	var tinta: Color = CareerTheme.DANGER if cae else _peldano_tinta(sig)
	var carril: Control = _peldano_carril(col, "relaciones", str(rel),
		CareerTheme.DANGER if cae else CareerTheme.TEXT, tinta,
		CareerTheme.DANGER if cae else _peldano_color(sig), rel / 100.0)
	if cae:
		CareerUi.bar_notch(carril, int(v["baja"]) / 100.0)
		carril.get_parent().get_parent().add_child(CareerUi.icon_stat(
			Gerencia.peldano_icono(n), str(int(v["baja"])), CareerTheme.DANGER, 40.0))
		return
	if tope:
		return
	CareerUi.bar_notch(carril, int(v["sube"]) / 100.0)
	carril.get_parent().get_parent().add_child(CareerUi.icon_stat(
		Gerencia.peldano_icono(sig), str(int(v["sube"])), tinta, 40.0))
	if sig == Gerencia.PELDANO_LEYENDA:



		var pj: int = int(v["partidos"])
		var pide_pj: int = maxi(int(v["partidos_min"]), 1)
		_peldano_carril(col, "partido", str(pj), CareerTheme.TEXT, tinta, _peldano_color(sig),
			minf(float(pj) / float(pide_pj), 1.0)).get_parent().get_parent().add_child(
				CareerUi.icon_stat(Gerencia.peldano_icono(sig), str(pide_pj), tinta, 40.0))
		return
	if sig != Gerencia.PELDANO_CAPITAN:
		return



	if String(v["falta_capitan"]) == "freno":
		col.add_child(CareerUi.icon_stat("candado", CareerTheme.caps(
			I18n.t("PROMETIDO AL VETERANO")), CareerTheme.TEXT_DIM, 40.0))
		return

	if String(v["falta_capitan"]) == "anios":
		col.add_child(CareerUi.icon_stat("calendario", "%d/%d" % [int(v["temporadas"]),
			Gerencia.PELDANO_CAPITAN_TEMPORADAS], CareerTheme.TEXT_DIM, 40.0))
	var jug: float = float(v["jugado"])
	var pide: float = Gerencia.PELDANO_JUGADOS
	var partidos: Control = _peldano_carril(col, "partido", "%d%%" % roundi(jug * 100.0),
		CareerTheme.TEXT, tinta, _peldano_color(sig), jug)
	CareerUi.bar_notch(partidos, pide)
	partidos.get_parent().get_parent().add_child(CareerUi.icon_stat(
		Gerencia.peldano_icono(sig), "%d%%" % roundi(pide * 100.0), tinta, 40.0))





func _peldano_carril(col: VBoxContainer, icono: String, cifra: String, tinta_cifra: Color,
		tinta: Color, relleno: Color, frac: float) -> Control:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 14)
	col.add_child(fila)
	fila.add_child(_peldano_dibujo(icono, tinta, 48.0))
	var num: Label = CareerUi.plain(CareerTheme.T_HEAD, tinta_cifra)
	num.text = cifra
	num.clip_text = true

	num.custom_minimum_size = Vector2(4.0 * CareerTheme.T_HEAD, 0)
	num.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(num)
	var caja: VBoxContainer = VBoxContainer.new()
	caja.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	caja.alignment = BoxContainer.ALIGNMENT_CENTER
	fila.add_child(caja)
	var fill: ColorRect = CareerUi.bar(caja, relleno, 20.0)
	CareerUi.set_bar(fill, frac)
	return fill.get_parent() as Control


















func _peldano_fuentes() -> HBoxContainer:
	var ctx: Dictionary = Career.gerencia_ctx()
	var mov: Dictionary = Career.peldano_movido()
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 10)
	for parte in Gerencia.partes(ctx):
		var key: String = String(parte["key"])
		var v: int = int(parte["valor"])
		var de: Array = _peldano_fuente_de(key)
		fila.add_child(_peldano_fuente(key, String(parte.get("muestra", str(v))),
			v / 100.0, I18n.t(String(de[0])), de[1], key != "contrato" and v < 50,
			int(mov.get(key, 0)), not mov.is_empty()))
	var bono: int = Gerencia.trofeos_bono(ctx.get("trofeos", []))
	fila.add_child(_peldano_fuente("torneos", "+%d" % bono,
		float(bono) / float(Gerencia.TROFEOS_TOPE), I18n.t("TROFEOS"), CareerTheme.NAV_LEGADO,
		false, int(mov.get("trofeos", 0)), not mov.is_empty()))



	var hist: int = Gerencia.historia_bono(ctx.get("historia", {}))
	fila.add_child(_peldano_fuente("leyendas", "+%d" % hist,
		float(hist) / float(Gerencia.HISTORIA_TOPE), I18n.t("HISTORIA"), CareerTheme.NAV_YO,
		false, int(mov.get("historia", 0)), not mov.is_empty()))
	return fila






func _peldano_fuente_de(key: String) -> Array:
	match key:
		"tecnico":
			return ["Técnico", CareerTheme.NAV_MUNDO]
		"equipo":
			return ["Vestuario", CareerTheme.NAV_PLANTILLA]
		"contrato":
			return ["AÑOS", CareerTheme.NAV_PAPEL]
		"aficion":
			return ["Afición", CareerTheme.NAV_GENTE]
	return [key, CareerTheme.TEXT_DIM]


func _peldano_fuente(icono: String, cifra: String, frac: float, rotulo: String,
		color: Color, malo: bool, delta: int = 0, hueco: bool = false) -> PanelContainer:
	var p: PanelContainer = PanelContainer.new()
	p.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var sb: StyleBoxFlat = CareerTheme.tag(Color(color.r, color.g, color.b, 0.14))
	sb.set_corner_radius_all(6)
	sb.content_margin_left = 8.0
	sb.content_margin_right = 8.0
	sb.content_margin_top = 10.0
	sb.content_margin_bottom = 10.0
	p.add_theme_stylebox_override("panel", sb)
	var c: VBoxContainer = VBoxContainer.new()
	c.add_theme_constant_override("separation", 8)
	p.add_child(c)
	var arriba: HBoxContainer = HBoxContainer.new()
	arriba.alignment = BoxContainer.ALIGNMENT_CENTER
	arriba.add_theme_constant_override("separation", 6)
	c.add_child(arriba)
	arriba.add_child(_peldano_dibujo(icono, CareerTheme.text_on_dark(color), 40.0))


	var num: Label = CareerUi.plain(CareerTheme.T_VALUE,
		CareerTheme.DANGER if malo else CareerTheme.TEXT)
	num.text = cifra
	num.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	arriba.add_child(num)
	if hueco:



		var mv: Label = CareerUi.plain(CareerTheme.T_CAPTION,
			CareerTheme.text_on_dark(color) if delta > 0 else CareerTheme.DANGER)
		mv.name = "Movido"
		mv.text = "%+d" % delta if delta != 0 else " "
		mv.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		c.add_child(mv)
	CareerUi.set_bar(CareerUi.bar(c, CareerTheme.DANGER if malo else color, 8.0), frac)
	var r: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	r.text = CareerTheme.caps(rotulo)
	r.clip_text = true
	r.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	CareerUi.autoshrink(r, 12)
	c.add_child(r)
	return p













func _peldano_rejilla(v: Dictionary) -> GridContainer:
	var n: int = int(v["n"])
	var cae: bool = _peldano_cae(v)
	var g: GridContainer = GridContainer.new()
	g.columns = 3
	g.add_theme_constant_override("h_separation", 10)
	g.add_theme_constant_override("v_separation", 10)
	var frenado: String = String(v.get("frenado", ""))
	for k in range(1, Gerencia.PELDANO_MAX + 1):
		for p in Gerencia.peldano_poderes(k):
			g.add_child(_peldano_poder(String(p[0]), I18n.t(String(p[1])), k, n,
				cae and k == n, "", false,
				k <= n and Gerencia.poder_en_pausa(String(p[1]), frenado)))
	return g











func _peldano_poder(icono: String, rotulo: String, k: int, n: int,
		riesgo: bool, cifra: String = "", en_ficha: bool = false,
		pausa: bool = false) -> PanelContainer:
	var tienes: bool = k <= n and not pausa
	var metal: Color = _peldano_color(k)
	var p: PanelContainer = PanelContainer.new()
	p.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var sb: StyleBoxFlat = CareerTheme.tag(Color(metal.r, metal.g, metal.b,
		0.18 if tienes else 0.05))
	sb.set_corner_radius_all(6)
	sb.content_margin_left = 8.0
	sb.content_margin_right = 8.0
	sb.content_margin_top = 8.0
	sb.content_margin_bottom = 10.0
	if riesgo or k == n + 1:
		sb.border_color = CareerTheme.DANGER if riesgo else metal
		sb.set_border_width_all(2)
	p.add_theme_stylebox_override("panel", sb)
	var c: VBoxContainer = VBoxContainer.new()
	c.add_theme_constant_override("separation", 6)
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	p.add_child(c)


	var cabeza: Control = Control.new()
	cabeza.custom_minimum_size = Vector2(0, 58)
	cabeza.mouse_filter = Control.MOUSE_FILTER_IGNORE
	c.add_child(cabeza)
	var ic: MenuIcon = _peldano_dibujo(icono,
		_peldano_tinta_icono(icono, _peldano_tinta(k)) if tienes else CareerTheme.TEXT_DIM, 54.0)



	cabeza.add_child(ic)
	ic.set_anchors_preset(Control.PRESET_CENTER)
	ic.grow_horizontal = Control.GROW_DIRECTION_BOTH
	ic.grow_vertical = Control.GROW_DIRECTION_BOTH
	if not en_ficha:
		var marca: PanelContainer = CareerUi.code_chip(str(k), _peldano_tinta(k),
			CareerTheme.T_CAPTION, 6.0, 2.0)
		marca.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cabeza.add_child(marca)
		marca.set_anchors_preset(Control.PRESET_TOP_RIGHT)
		marca.grow_horizontal = Control.GROW_DIRECTION_BEGIN
	if not tienes and not en_ficha:
		var cerrado: MenuIcon = _peldano_dibujo("candado",
			CareerTheme.DANGER if pausa else CareerTheme.TEXT_DIM, 24.0)
		cabeza.add_child(cerrado)
		cerrado.set_anchors_preset(Control.PRESET_TOP_LEFT)
	if not cifra.is_empty():


		var num: Label = CareerUi.plain(CareerTheme.T_VALUE, _peldano_tinta_icono(icono,
			_peldano_tinta(k)) if tienes else CareerTheme.TEXT_DIM)
		num.text = cifra
		num.clip_text = true
		num.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		num.mouse_filter = Control.MOUSE_FILTER_IGNORE
		c.add_child(num)
	var l: Label = CareerUi.plain(CareerTheme.T_CAPTION,
		CareerTheme.TEXT if tienes else CareerTheme.TEXT_DIM)
	l.text = CareerTheme.caps(rotulo)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	c.add_child(l)
	if not en_ficha:
		p.add_child(CareerUi.hit_overlay(0.0, _peldano_modal.bind(k)))
	return p









func _peldano_cifra(icono: String) -> String:
	match icono:
		"capitan":
			return "+%d%%" % roundi(Gerencia.CAPITAN_BONUS * 100.0)
		"moneda":
			return "$ %s" % CareerUi.short_money(Gerencia.prima_fidelidad(
				Gerencia.PELDANO_LEYENDA, int(Career.contract.get("wage", 0))))

		"despacho":
			return "+%d%%" % roundi(Gerencia.CONTRATO_CASA * 100.0)
	return ""






func _peldano_tinta_icono(icono: String, tinta: Color) -> Color:
	return CareerTheme.MONEY if icono == "moneda" and tinta != CareerTheme.TEXT_DIM else tinta


func _peldano_dibujo(tipo: String, tinta: Color, px: float) -> MenuIcon:
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(px, px)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.setup(tipo, tinta)
	return ic


func _peldano_nota(parent: Container, text: String, col: Color) -> void:
	var l: Label = CareerUi.plain(CareerTheme.T_CAPTION, col)
	l.text = text
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	parent.add_child(l)




















func _peldano_modal(k: int) -> void:
	if Career.peldano_vista().is_empty():
		return
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	_peldano_ficha_llena(box, k)






func _peldano_ficha_llena(box: VBoxContainer, k: int) -> void:
	if not is_instance_valid(box) or box.is_queued_for_deletion():
		return
	var v: Dictionary = Career.peldano_vista()
	if v.is_empty():
		return
	for c in box.get_children():
		box.remove_child(c)
		c.queue_free()
	k = clampi(k, 1, Gerencia.PELDANO_MAX)
	CareerUi.head(box, I18n.t("TU NIVEL EN EL CLUB"))
	box.add_child(_peldano_escalera(int(v["n"]), k,
		func(otro: int) -> void: _peldano_ficha_va(box, otro)))
	box.add_child(_peldano_ficha(v, k))
	box.add_child(CareerUi.primary_cta(I18n.t("CERRAR"),
		func() -> void: CareerUi.close_modal(box)))





func _peldano_ficha_va(box: VBoxContainer, k: int) -> void:
	UiAudio.click()
	_peldano_ficha_llena.call_deferred(box, k)







func _peldano_ficha(v: Dictionary, k: int) -> PanelContainer:
	var n: int = int(v["n"])
	var cae: bool = k == n and _peldano_cae(v)
	var metal: Color = _peldano_color(k)
	var p: PanelContainer = PanelContainer.new()
	var sb: StyleBoxFlat = CareerTheme.tag(Color(metal.r, metal.g, metal.b,
		0.16 if k <= n else 0.06))
	sb.set_corner_radius_all(8)
	sb.content_margin_left = 20.0
	sb.content_margin_right = 20.0
	sb.content_margin_top = 18.0
	sb.content_margin_bottom = 20.0
	sb.border_color = CareerTheme.DANGER if cae else metal
	sb.set_border_width_all(2)
	p.add_theme_stylebox_override("panel", sb)
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 20)
	p.add_child(col)
	col.add_child(_peldano_ficha_cabeza(v, k))
	_peldano_ficha_pide(col, v, k)
	var poderes: Array = Gerencia.peldano_poderes(k)
	var g: GridContainer = GridContainer.new()
	g.columns = clampi(poderes.size(), 1, 3)
	g.add_theme_constant_override("h_separation", 10)
	g.add_theme_constant_override("v_separation", 10)
	col.add_child(g)
	for pw in poderes:
		g.add_child(_peldano_poder(String(pw[0]), I18n.t(String(pw[1])), k, n, cae,
			_peldano_cifra(String(pw[0])), true,
			k <= n and Gerencia.poder_en_pausa(String(pw[1]), String(v["frenado"]))))
	return p










func _peldano_ficha_cabeza(v: Dictionary, k: int) -> HBoxContainer:
	var n: int = int(v["n"])
	var cedido: bool = bool(v["cedido"])
	var tinta: Color = _peldano_tinta(k)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 18)
	fila.add_child(_peldano_dibujo(Gerencia.peldano_icono(k), tinta, 96.0))
	var pila: VBoxContainer = VBoxContainer.new()
	pila.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pila.alignment = BoxContainer.ALIGNMENT_CENTER
	pila.add_theme_constant_override("separation", 10)
	fila.add_child(pila)


	var nombre: Label = CareerUi.plain(CareerTheme.T_TITLE_MODAL, tinta)
	nombre.text = CareerTheme.caps(I18n.t(Gerencia.peldano_nombre(k)))
	nombre.clip_text = true
	CareerUi.autoshrink(nombre, CareerTheme.T_HEAD)
	pila.add_child(nombre)
	var estado: HBoxContainer = HBoxContainer.new()
	estado.add_theme_constant_override("separation", 12)
	pila.add_child(estado)
	if k == n and cedido:
		estado.add_child(CareerUi.icon_stat("candado", CareerTheme.caps(I18n.t("CEDIDO")),
			CareerTheme.TEXT_DIM, 36.0))
	elif k == n and _peldano_cae(v):
		estado.add_child(CareerUi.code_chip(CareerTheme.caps(I18n.tf("BAJAS EN {0}",
			[_peldano_cuando(v)])), CareerTheme.DANGER, CareerTheme.T_DIM))
	elif k <= n and String(v["frenado"]) == "pediste" and _peldano_k_en_pausa(k):
		estado.add_child(CareerUi.icon_stat("candado", CareerTheme.caps(I18n.t(
			"PEDISTE SALIR")), CareerTheme.DANGER, 36.0))
	elif k <= n:
		estado.add_child(_peldano_dibujo("check", tinta, 40.0))
	elif k == n + 1 and not cedido and not String(v["frenado"]).is_empty():
		estado.add_child(CareerUi.icon_stat("candado", CareerTheme.caps(I18n.t(
			"PEDISTE SALIR" if String(v["frenado"]) == "pediste" else "EN VENTA")),
			CareerTheme.TEXT_DIM, 36.0))
	elif k == n + 1 and not cedido:
		var listo: bool = _peldano_listo(v)
		estado.add_child(CareerUi.icon_stat("check" if listo else "reloj", _peldano_cuando(v),
			tinta if listo else CareerTheme.TEXT_DIM, 36.0))
	else:
		estado.add_child(_peldano_dibujo("candado", CareerTheme.TEXT_DIM, 40.0))
	return fila



func _peldano_k_en_pausa(k: int) -> bool:
	for p in Gerencia.peldano_poderes(k):
		if Gerencia.poder_en_pausa(String(p[1]), "pediste"):
			return true
	return false












func _peldano_ficha_pide(col: VBoxContainer, v: Dictionary, k: int) -> void:
	var tinta: Color = _peldano_tinta(k)
	if k <= 1:
		col.add_child(CareerUi.icon_stat("puerta", CareerTheme.caps(I18n.t("CLUB NUEVO")),
			tinta, 40.0))
		return
	var umbral: int = Gerencia.peldano_umbral(k)
	if bool(v["cedido"]):
		col.add_child(CareerUi.icon_stat(Gerencia.peldano_icono(k), str(umbral), tinta, 40.0))
		return
	var n: int = int(v["n"])
	var rel: int = int(v["relacion"])
	var cae: bool = k == n and _peldano_cae(v)
	var carril: Control = _peldano_carril(col, "relaciones", str(rel),
		CareerTheme.DANGER if cae else CareerTheme.TEXT, CareerTheme.DANGER if cae else tinta,
		CareerTheme.DANGER if cae else _peldano_color(k), rel / 100.0)
	if k == n:
		var baja: int = int(v["baja"])
		CareerUi.bar_notch(carril, baja / 100.0)
		carril.get_parent().get_parent().add_child(CareerUi.icon_stat("candado", str(baja),
			CareerTheme.DANGER if cae else CareerTheme.TEXT_DIM, 40.0))
	else:
		CareerUi.bar_notch(carril, umbral / 100.0)
		carril.get_parent().get_parent().add_child(CareerUi.icon_stat(
			Gerencia.peldano_icono(k), str(umbral), tinta, 40.0))
	if k <= n:
		return
	if k == Gerencia.PELDANO_CAPITAN:
		if String(v["falta_capitan"]) == "freno":
			col.add_child(CareerUi.icon_stat("candado", CareerTheme.caps(
				I18n.t("PROMETIDO AL VETERANO")), CareerTheme.TEXT_DIM, 40.0))
			return
		if String(v["falta_capitan"]) == "anios":
			col.add_child(CareerUi.icon_stat("calendario", "%d/%d" % [int(v["temporadas"]),
				Gerencia.PELDANO_CAPITAN_TEMPORADAS], CareerTheme.TEXT_DIM, 40.0))
		var jug: float = float(v["jugado"])
		var jugado: Control = _peldano_carril(col, "partido", "%d%%" % roundi(jug * 100.0),
			CareerTheme.TEXT, tinta, _peldano_color(k), jug)
		CareerUi.bar_notch(jugado, Gerencia.PELDANO_JUGADOS)
		jugado.get_parent().get_parent().add_child(CareerUi.icon_stat(
			Gerencia.peldano_icono(k), "%d%%" % roundi(Gerencia.PELDANO_JUGADOS * 100.0),
			tinta, 40.0))
	elif k == Gerencia.PELDANO_LEYENDA:
		var pj: int = int(v["partidos"])
		var pide: int = maxi(int(v["partidos_min"]), 1)
		_peldano_carril(col, "partido", str(pj), CareerTheme.TEXT, tinta, _peldano_color(k),
			minf(float(pj) / float(pide), 1.0)).get_parent().get_parent().add_child(
				CareerUi.icon_stat(Gerencia.peldano_icono(k), str(pide), tinta, 40.0))






