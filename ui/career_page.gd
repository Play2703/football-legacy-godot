func _page_gerencia() -> void:
	if Career.free_agent or GameState.player_team_id.is_empty():
		CareerUi.dim(_content, I18n.t("Sin club no hay nada que pedir."
			+ " Ficha por un equipo y aquí decidirás con él."))
		return










	var relacion: int = Career.gerencia_relacion()











	var tab: int = _ger_tab_viva()
	if _tira_tumbada():
		_ger_t_pestanas(tab)
	else:
		var tabs: Array = []
		for t in GER_TABS:
			tabs.append({"icon": String(t[0]), "label": I18n.t(String(t[1]))})
		CareerUi.icon_tabs(_content, tabs, tab, _ger_elige_tab)
	match tab:
		GER_TAB_NIVEL:
			_gerencia_peldano_block()
		GER_TAB_FICHAJES:

			_gerencia_cuentas_block()
			_gerencia_mesa_block()
		GER_TAB_PIDES:

			_gerencia_intocable_block()
			_gerencia_renueva_block()
			_gerencia_banquillo_block()
		GER_TAB_PRIMAS:

			_gerencia_primas_block()
		_:

			_gerencia_historial()






	if _board_stage != null and is_instance_valid(_board_stage):
		_board_stage.set_estado(relacion, Career.gerencia_mesa_compras().size())

	_mesa_relacion = relacion
	_mesa_fuera = _mesa_fuera_firma()




const GER_TABS: Array = [["stats", "NIVEL"], ["mercado", "FICHAJES"],
	["buzon", "PETICIONES"], ["reloj", "HISTORIAL"], ["moneda", "PRIMAS"]]
const GER_TAB_NIVEL: int = 0
const GER_TAB_FICHAJES: int = 1
const GER_TAB_PIDES: int = 2
const GER_TAB_HISTORIAL: int = 3
const GER_TAB_PRIMAS: int = 4

var _ger_tab: int = -1






func _ger_tab_viva() -> int:
	if _mesa_ir:
		return GER_TAB_FICHAJES
	if _ger_tab >= 0:
		return _ger_tab


	return GER_TAB_FICHAJES if Career.gerencia_mesa_abierta() \
			or not Career.ffp_aviso_fresh().is_empty() else GER_TAB_NIVEL





func _ger_elige_tab(i: int) -> void:
	var tira_antes: bool = _tira_tumbada()
	_ger_tab = i
	if _tira_tumbada() != tira_antes:
		_sync_nav()
		_rebuild()
	else:
		_refresh()







func _ger_t_pestanas(tab: int) -> void:
	if _placa_sub == null or not is_instance_valid(_placa_sub):
		return
	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "GerPestanas"
	fila.add_theme_constant_override("separation", 8)
	fila.size_flags_horizontal = Control.SIZE_SHRINK_END
	var anchos: Array[float] = []
	var total: float = 0.0
	for t in GER_TABS:
		var w: float = 2.0 * GER_T_PESTANA_LADO + GER_T_PESTANA_ICONO + 12.0 \
				+ _wnews_ancho(CareerTheme.caps(I18n.t(String(t[1]))), CareerTheme.T_CAP_TUMBADO)
		anchos.append(w)
		total += w + 8.0

	var libre: float = _ancho_util_apaisado() - 2.0 * 34.0 - CareerUi.PLACA_ATRAS_W \
			- _wnews_ancho(I18n.t(_sub_rotulo), CareerTheme.T_DATO_TUMBADO) - 3.0 * 16.0
	var solo_dibujo: bool = total > libre
	for i in GER_TABS.size():
		var on: bool = i == tab
		var con_rotulo: bool = on or not solo_dibujo
		var b: Button = Button.new()
		b.name = "Pestana%d" % i
		b.custom_minimum_size = Vector2(anchos[i] if con_rotulo else 88.0,
			CareerUi.PLACA_TITULO_H)
		CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL if on else CareerTheme.Kind.GHOST,
			CareerTheme.T_CAP_TUMBADO)
		b.set_meta("ger_tab", i)
		if not on:
			b.pressed.connect(_ger_elige_tab.bind(i))


		var ink: Color = CareerTheme.TEXT if on else CareerTheme.TEXT_MID
		var relleno: MarginContainer = CareerUi._relleno_boton(b, int(GER_T_PESTANA_LADO), 0)
		var dentro: HBoxContainer = HBoxContainer.new()
		dentro.alignment = BoxContainer.ALIGNMENT_CENTER
		dentro.add_theme_constant_override("separation", 12)
		dentro.mouse_filter = Control.MOUSE_FILTER_IGNORE
		relleno.add_child(dentro)
		var ic: MenuIcon = MenuIcon.new()
		ic.custom_minimum_size = Vector2(GER_T_PESTANA_ICONO, GER_T_PESTANA_ICONO)
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ic.setup(String(GER_TABS[i][0]), ink)
		dentro.add_child(ic)
		if con_rotulo:
			var l: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, ink,
				CareerTheme.caps(I18n.t(String(GER_TABS[i][1]))), false)
			l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
			dentro.add_child(l)
		if on:

			var raya: ColorRect = ColorRect.new()
			raya.name = "Subrayado"
			raya.color = CareerTheme.accent()
			raya.mouse_filter = Control.MOUSE_FILTER_IGNORE
