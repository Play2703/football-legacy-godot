	if not valor.is_empty():
		var v: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, color)
		v.text = valor
		v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		v.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		v.custom_minimum_size.x = ceilf(CareerUi._ancho_a(v, valor, CareerTheme.T_DATO_TUMBADO)) + 2.0
		h.add_child(v)
		h.resized.connect(_mt_dato_letra.bind(h, r, v), CONNECT_DEFERRED)
