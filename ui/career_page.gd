func _fichajes_tumbado() -> void:
	var pa: Dictionary = _plantilla_pagina()
	_content.add_child(pa["raiz"])
	var caja: VBoxContainer = pa["contenido"]

	var hay: bool = _ft_cuenta("mundo") > 0
	if hay:
		if _news_scope.is_empty() or _ft_cuenta(_news_scope) <= 0:
			_news_scope = _ft_scope_inicial()
		caja.add_child(_ft_franja())
	var rows: Array = _ft_filas(_news_scope) if hay else []
	if rows.is_empty():
		CareerUi.vacio_apaisado(caja, I18n.t("SIN FICHAJES"), "mercado")
	else:
		caja.add_child(_ft_lista(rows))
	_ft_apoyo(pa)






func _ft_scope_inicial() -> String:
	var mejor: String = _news_default_scope()
	var mas: int = 0
	for s in ["club", "liga", "mundo"]:
		var n: int = _ft_cuenta(s)
		if n >= NEWS_ROWS:
			return s
		if n > mas:
			mas = n
			mejor = s
	return mejor




func _ft_cuenta(scope: String) -> int:
	if scope == "club" and Career.free_agent:
		return 0
	var n: int = 0
	for m in Career.market_news:
		if _ft_de_temporada(m) and _news_in_scope(m, scope):
			n += 1
	return n






func _ft_de_temporada(m: Dictionary) -> bool:
	return int(m.get("season", 0)) == GameState.season_num








func _ft_cortada() -> bool:
	return Career.market_news.size() >= Career.MARKET_NEWS_MAX \
			and _ft_de_temporada(Career.market_news[Career.market_news.size() - 1])




func _ft_desde() -> String:
	var viejo: Dictionary = Career.market_news[Career.market_news.size() - 1]
	var f: Dictionary = Market.fecha_de_jornada(int(viejo.get("day", 0)), GameState.winter_day(),
		GameState.calendar.size())
	return I18n.tf("DESDE {0}", [CareerUi.fecha_corta(int(f["dia"]), int(f["mes"]))])




func _ft_filas(scope: String) -> Array:
	var todas: Array = _news_rows(scope, Career.market_news.size())
	var out: Array = []
	for m in todas:
		if _ft_de_temporada(m):
			out.append(m)
			if out.size() >= NEWS_ROWS:
				break
	return out






func _ft_franja() -> HBoxContainer:
	var h: HBoxContainer = HBoxContainer.new()
	h.name = "FranjaFichajes"
	h.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
	var ids: Array = []
	var opciones: Array = []
	for s in ["club", "liga", "mundo"]:
		var n: int = _ft_cuenta(s)
		if n <= 0:
			continue
		ids.append(s)




		opciones.append({"rotulo": I18n.t("CLUB") if s == "club" else (I18n.t("LIGA")
			if s == "liga" else I18n.t("MUNDO")), "cifra": "" if _ft_cortada() else str(n)})
	var seg: HBoxContainer = CareerUi.segmentado(opciones, ids.find(_news_scope), func(i: int) -> void:
		_news_scope = String(ids[i])
		_refresh())
	h.add_child(seg)
	_ft_rotulos_parejos(seg)
	_ft_segmentos_a_medida(seg)
	var ordenes: Array = []
	var activa: int = 0
	for k in NEWS_ORDENES.size():
		var t: Dictionary = NEWS_ORDENES[k]
		if String(t["id"]) == _news_tab:
			activa = k



		var col: Color = _news_orden_color(String(t["id"]))
		var ic: MenuIcon = MenuIcon.new()
		ic.setup(String(t["icon"]), col)
		ordenes.append({"rotulo": I18n.t(String(t["label"])), "icono": ic, "color": col})
	h.add_child(CareerUi.segmentado(ordenes, activa, func(i: int) -> void:
		_news_tab = String((NEWS_ORDENES[i] as Dictionary)["id"])
		_refresh(), true))
	return h







func _ft_rotulos_parejos(seg: HBoxContainer) -> void:
	var rotulos: Array[Label] = []
	var pide: Array[float] = []
	for b in seg.get_children():
		var l: Label = b.get_meta("segmento_rotulo", null) as Label if b is Button else null
		if l == null:
			continue
		var c: Label = l.get_parent().get_node_or_null("Cifra") as Label
		rotulos.append(l)
		pide.append(CareerUi._ancho_a(l, l.text, CareerTheme.T_LEE_TUMBADO)
			+(c.custom_minimum_size.x if c != null else 0.0))
	if rotulos.size() < 2:
		return
	var k: int = pide.find(pide.max())
	var guia: Label = rotulos[k]
	var antes: Label = guia
	for i in rotulos.size():
		if i == k:
			continue
		rotulos[i].set_meta("peldano_tope", guia)
		antes.set_meta("peldano_sigue", rotulos[i])
		antes = rotulos[i]







func _ft_segmentos_a_medida(seg: HBoxContainer) -> void:
	for b in seg.get_children():
		var l: Label = b.get_meta("segmento_rotulo", null) as Label if b is Button else null
		if l == null:
			continue
		var c: Label = l.get_parent().get_node_or_null("Cifra") as Label
		var pide: float = CareerUi._ancho_a(l, l.text, CareerTheme.T_LEE_TUMBADO) + 32.0
		if c != null:
			pide += 16.0 + c.custom_minimum_size.x
		(b as Button).size_flags_stretch_ratio = maxf(1.0, pide)





func _ft_lista(rows: Array) -> VBoxContainer:
	var lista: VBoxContainer = VBoxContainer.new()
	lista.name = "ListaFichajes"
	lista.add_theme_constant_override("separation", FT_FILA_SEP)
	lista.size_flags_vertical = Control.SIZE_EXPAND_FILL
	lista.set_meta("fl_lista", "fichajes")
	var nv: Dictionary = _ft_nivel(rows.size())
	for n in rows:
		var f: PanelContainer = _ft_fila(n, nv)
		f.size_flags_vertical = Control.SIZE_EXPAND_FILL
		lista.add_child(f)


	lista.resized.connect(_ft_letra_lista.bind(lista), CONNECT_DEFERRED)
	return lista



func _ft_nivel(n: int) -> Dictionary:
	for nv in FT_NIVELES:
		if n >= int((nv as Dictionary)["desde"]):
			return nv
	return FT_NIVELES[FT_NIVELES.size() - 1]






func _ft_letra_lista(lista: VBoxContainer) -> void:
	if not is_instance_valid(lista):
		return
	for clase in ["ft_nombre", "ft_pos", "ft_sello"]:
		var ls: Array[Label] = []
		for f in lista.get_children():
			for c in (f as Node).get_meta("fila_celdas", []):
				if c is Label and (c as Label).has_meta(clase):
					ls.append(c as Label)
		if ls.is_empty():
			continue
		var peldanos: Array = ls[0].get_meta(clase)
		var elegido: int = int(peldanos[peldanos.size() - 1])
		for p in peldanos:
			var cabe: bool = true
			for l in ls:
				if l.size.x <= 0.0:
					return
				var fuente: Font = l.get_theme_font("font")
				if fuente.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1, int(p)).x > l.size.x + 0.5:
					cabe = false
					break
			if cabe:
				elegido = int(p)
				break
		for l in ls:
			if l.get_theme_font_size("font_size") != elegido:
				l.add_theme_font_size_override("font_size", elegido)






func _ft_fila(n: Dictionary, nv: Dictionary) -> PanelContainer:
	var kind: String = String(n.get("kind", ""))
	var to_id: String = String(n.get("to", ""))
	var from_id: String = String(n.get("from", ""))
	var fee: int = int(n.get("fee", 0))
	var pagado: bool = kind == "signing" and not bool(n.get("free", false)) and fee > 0
	var mine_id: String = GameState.player_team_id


	var tuya: bool = not mine_id.is_empty() and _news_scope != "club" \
			and (to_id == mine_id or from_id == mine_id)
	var letra: Array = nv["letra"]
	var cap: Array = nv["cap"]
	var importe: Dictionary = {}
	if pagado:
		importe = {"texto": _money_short(fee), "color": CareerTheme.MONEY,
			"tam": int(letra[0]), "ancho": float(nv["importe"]), "derecha": true}
	else:
		var vuelve: bool = kind == "signing" and not bool(n.get("pre", false)) \
				and int(n.get("ex", 0)) > 0
		importe = {"texto": CareerTheme.caps(_news_kind_text(kind, false, bool(n.get("pre", false)),
			vuelve, Teams.is_free(from_id))), "color": CareerTheme.accent_text() if vuelve
			else _news_kind_color(kind, false), "tam": int(cap[0]),
			"ancho": float(nv["importe"]), "derecha": true}
	var media: int = int(n.get("media", 0))
	var pos: String = String(n.get("pos", ""))
	var p: PanelContainer = CareerUi.fila_tumbada(float(nv["alto"]), _news_kind_color(kind, pagado), [
		{"nodo": _ft_celda_ruta(_news_origin(kind, n, from_id), to_id, float(nv["escudo"]),
			bool(nv.get("apila", false)))},
		{"texto": CareerUi.surname(CareerUi.display_name(String(n.get("name", "")))),
			"expand": true, "tam": int(letra[0])},
		{"nodo": _ft_celda_pos(pos, int(cap[0]), float(nv["pos"]))},
		{"nodo": _ft_celda_media(media, int(cap[0]), float(nv["media"]))},
		importe, {"nodo": _ft_aire(FT_COL_AIRE)}], tuya, CareerTheme.NAV_MUNDO)
	p.set_meta("fl_fila", true)
	p.set_meta("fl_tuya", tuya)


	var celdas: Array = p.get_meta("fila_celdas", [])
	if celdas.size() > 4:
		(celdas[1] as Label).set_meta("ft_nombre", letra)
		if not pagado:
			(celdas[4] as Label).set_meta("ft_sello", cap)
	return p



