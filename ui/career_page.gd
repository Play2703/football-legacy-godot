			I18n.tf("{0} PUNTOS", [cost]),
			I18n.t("APRENDERLO"), false,
			func() -> void:
				if Career.compra_puesto(pos):
					UiAudio.confirm()
					_refresh(),


			false, CareerUi.pos_en_partido(pos)))
	row.add_child(plus)




