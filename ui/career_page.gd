	"libertad": "LIBERTAD", "bandera": "BANDERA",
}





func _renewal_selected(packs: Array) -> Dictionary:
	for p in packs:
		if String(p.get("pack", "")) == _renewal_pack:
			return p
	for p in packs:
		if String(p.get("pack", "")) == "equilibrio":
			return p
	return packs[0]












func _renewal_block() -> void:
	var packs: Array = Career.renewal_packages()
	var o: Dictionary = _renewal_selected(packs)
	_renewal_pack = String(o.get("pack", "equilibrio"))
	CareerUi.head(_content, I18n.t("LA OFERTA DEL CLUB"))
