func _dedo_tap(ctrl: Control, cb: Callable) -> void:
	ctrl.gui_input.connect(func(ev: InputEvent) -> void:
		if not (ev is InputEventMouseButton) \
				or (ev as InputEventMouseButton).button_index != MOUSE_BUTTON_LEFT:
			return
		var mb: InputEventMouseButton = ev as InputEventMouseButton
		if mb.pressed:
			ctrl.set_meta("down", mb.global_position)
		elif ctrl.has_meta("down"):
			var d: float =(mb.global_position \
					-(ctrl.get_meta("down") as Vector2)).length()
			ctrl.remove_meta("down")
			if d < 24.0:
				cb.call())
















func _ficha_de_asiento(club_id: String, seat: int) -> void:
	var squad: Array = Squad.of(club_id)
	if seat < 0 or seat >= squad.size():
		return
	var p: Dictionary =(squad[seat] as Dictionary).duplicate()
	var pos: String = String(p.get("pos", "MC"))






	var seat0: int = Squad.home_seat(squad, seat)
	var f: Dictionary = WorldRanking.ficha({"club": club_id, "seat": seat,
		"seat0": seat0, "pos": pos,
		"lvl": SquadMeta.media_of(p, pos), "ovr": SquadMeta.ovr_of(p, pos)})


	var crudo: String = String(p.get("name", ""))
	p["name"] = String(f.get("name", ""))
	var team: Dictionary = Teams.by_id(club_id)



	var nat_id: String = Nations.id_for_country(String(f.get("nat", "")))


	var hacer: Callable = func() -> PlayerCard:
		return PlayerCard.build(p, team, nat_id)








	var reco: Dictionary = {}
	if _ger_hay_club() and club_id != GameState.player_team_id and _host_ficha == null:
		reco = {"club": club_id, "seat": seat, "name": crudo,
			"pos": pos, "ovr": SquadMeta.ovr_of(p, pos)}



	_ficha_jugador(p, false,
		_pm_de_asiento(club_id, squad, seat0, int(f.get("age", 0))), hacer, "", reco,
		{"club": club_id, "seat": seat0, "name": crudo})
















func _pm_de_asiento(club_id: String, squad: Array, seat0: int, edad: int) -> Dictionary:
	var meta: Array = Career._meta_viva(club_id, squad)
	var m: Dictionary = meta[seat0] if seat0 >= 0 and seat0 < meta.size() else {}
	var pm: Dictionary = {"age": edad if edad >= 0 else int(m.get("age", 26))}
	if m.has("contract"):
		pm["contract"] = int(m["contract"])
	if bool(m.get("se_va", false)):
		pm["se_va"] = true
		pm["pre"] = String(m.get("pre", ""))
	return pm








func _de_convocado(nombre: String) -> Dictionary:
	if nombre.is_empty():
		return {}
	for r in Career.nat_squad_list():
		var row: Dictionary = r
		if String(row.get("name", "")) != nombre:
			continue
		var club_id: String = String(row.get("club_id", ""))
		var squad: Array = Squad.of(club_id) if not club_id.is_empty() else []
		for s in squad.size():
			var p: Dictionary = squad[s]
			if String(p.get("name", "")) != nombre:
				continue
			var pos: String = String(p.get("pos", "MC"))
			var seat0: int = Squad.home_seat(squad, s)


			var f: Dictionary = WorldRanking.ficha({"club": club_id, "seat": s,
				"seat0": seat0, "pos": pos,
				"lvl": SquadMeta.media_of(p, pos), "ovr": SquadMeta.ovr_of(p, pos)})
			return {"pm": _pm_de_asiento(club_id, squad, seat0, int(f.get("age", 0))),
				"tray": {"club": club_id, "seat": seat0}}
		return {}
	return {}









func _ficha_de_libre(row: Dictionary) -> void:
	var f: Dictionary = WorldRanking.ficha(row)
	var p: Dictionary =(row["libre"] as Dictionary).duplicate()
	p["name"] = String(f.get("name", ""))
	p["pos"] = String(row.get("pos", "MC"))
	var team: Dictionary = Teams.free_team()
	var nat_id: String = Nations.id_for_country(String(f.get("nat", "")))
	var hacer: Callable = func() -> PlayerCard:
		return PlayerCard.build(p, team, nat_id)
	var reco: Dictionary = {}
	if _ger_hay_club():
		reco = {"club": Teams.FREE_ID, "seat": _libre_seat_de(row),
			"name": String((row["libre"] as Dictionary).get("name", "")),
			"pos": String(p["pos"]), "ovr": int(row.get("ovr", 0))}
	_ficha_jugador(p, false, {"age": int(f.get("age", 0))}, hacer, "", reco,
		{"club": Teams.FREE_ID, "etapas": p.get("carrera", []),
			"desde": int(row.get("since", 0))})





func _libre_seat_de(row: Dictionary) -> int:
	return Career.libre_seat(String((row["libre"] as Dictionary).get("name", "")),
		String(row.get("pos", "MC")))





func _ficha_de_libre_seat(seat: int) -> void:
	for r in WorldRanking.rows():
		var row: Dictionary = r
		if row.get("libre", null) is Dictionary and _libre_seat_de(row) == seat:
			_ficha_de_libre(row)
			return








