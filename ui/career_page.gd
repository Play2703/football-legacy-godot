func _leyenda_pon(extras: Array) -> void:
	if _leyenda_mando == null or not is_instance_valid(_leyenda_mando) or extras == _leyenda_extras:
		return



	if not _leyenda_mando.is_inside_tree():
		return
	_leyenda_extras = extras
	var items: Array = CareerUi.LEYENDA_BASE.duplicate()
	for e in extras:
		items.insert(items.size() - 1, e)
	var nueva: HBoxContainer = CareerUi.leyenda_mando(items)
	var padre: Node = _leyenda_mando.get_parent()
	var sitio: int = _leyenda_mando.get_index()




	padre.remove_child(_leyenda_mando)
	_leyenda_mando.queue_free()
	padre.add_child(nueva)
	padre.move_child(nueva, sitio)
	_leyenda_mando = nueva




