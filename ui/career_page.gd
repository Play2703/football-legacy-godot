var _casa_taller: Control = null


func _house_thumb(extra_id: String) -> Control:






	if not _taller_listo():
		return null
	return _casa_taller.call("extra_thumb", extra_id, Career.house_level)




func _taller_listo() -> bool:
	if not _taller_sabe_retratos():
		return false
	if _casa_taller == null or not is_instance_valid(_casa_taller):
		_casa_taller = load("res://ui/house/house.tscn").instantiate()
		_casa_taller.set("solo_retratos", true)
		_casa_taller.visible = false
		add_child(_casa_taller)
	return true



func _taller_sabe_retratos() -> bool:
	if _taller_ok < 0:
		_taller_ok = 0
		var gs: GDScript = load("res://ui/house/house.gd")
		if gs != null:
			for m in gs.get_script_method_list():
				if String(m.get("name", "")) == "extra_thumb":
					_taller_ok = 1
					break
	return _taller_ok == 1



