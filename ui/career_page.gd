		t.text = I18n.t("EL MUNDIAL ES ESTE AÑO")
	elif faltan <= 1:
		t.text = I18n.t("EL MUNDIAL ES EL AÑO QUE VIENE")
	else:
		t.text = I18n.tf("MUNDIAL EN {0} TEMPORADAS", [faltan])


	t.clip_text = true
	col.add_child(t)
	var s: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)








	s.text = I18n.t("No llegarás: a esa edad ya estarás retirado.") \
			if edad >= Career.RETIRE_AGE \
			else (I18n.tf("Lo juegas con {0} años.", [edad]) if este
			else I18n.tf("Llegarás con {0} años.", [edad]))
	s.clip_text = true
	col.add_child(s)






