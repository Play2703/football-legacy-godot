	row.add_theme_constant_override("separation", 8)
	_content.add_child(row)
	var prev: Button = _palm_arrow("<")
	prev.disabled = idx <= 0
	prev.pressed.connect(_cycle_map_season.bind(idx - 1, seasons))
	row.add_child(prev)
	var cur: Dictionary = seasons[idx]
	var lbl: Label = CareerUi.plain(24, CareerTheme.MONEY)
	lbl.text = I18n.t("TODA TU CARRERA") if bool(cur.get("carrera", false)) \
			else I18n.tf("TEMPORADA {0}", [int(cur["season"])]) \
			+("*" if bool(cur["curso"]) else "")
	lbl.clip_text = true
	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(lbl)
	var next: Button = _palm_arrow(">")
	next.disabled = idx >= seasons.size() - 1
	next.pressed.connect(_cycle_map_season.bind(idx + 1, seasons))
	row.add_child(next)


