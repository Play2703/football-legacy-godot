func _ti_t_familias_seg() -> HBoxContainer:
	var fams: Array[Dictionary] = _ti_t_familias()
	var labels: Array = []
	var activa: int = 0
	for i in fams.size():
		labels.append(I18n.t(String(fams[i]["label"])))
		if String(fams[i]["id"]) == _shop_tab:
			activa = i
	var seg: HBoxContainer = CareerUi.segmented(labels, activa,
		func(i: int) -> void: _ti_t_elige_familia(String(fams[i]["id"])),
		CareerTheme.TOQUE_TUMBADO)
	seg.name = "Familias"
	seg.add_theme_constant_override("separation", 16)
	seg.set_meta("px", CareerTheme.T_CAP_TUMBADO)
	CareerUi.mark_segmented(seg, activa)
	seg.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	seg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	for i in seg.get_child_count():
		var b: Button = seg.get_child(i) as Button
		if b == null:
			continue
		b.set_meta("ti_t_familia", String(fams[i]["id"]))
		if String(fams[i]["id"]) == "caja" and i == activa:

			CareerTheme.apply_button_accent(b, CareerTheme.MONEY, CareerTheme.T_CAP_TUMBADO)
		_ti_t_un_enfocable(b, i == activa)
		b.gui_input.connect(_ti_t_seg_cruceta.bind(seg, i))
