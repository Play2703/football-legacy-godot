func _en_t_frase_parte(caja: VBoxContainer) -> void:
	if not is_instance_valid(caja) or caja.size.x <= 0.0 or caja.get_child_count() == 0:
		return
	var l0: Label = caja.get_child(0) as Label
	if l0 == null:
		return
	var f: Font = l0.get_theme_font("font")
	var px: int = l0.get_theme_font_size("font_size")
	var col: Color = l0.get_theme_color("font_color")
	var w: float = caja.size.x
	var lineas: Array[String] = []
	var actual: String = ""
	for pal in String(caja.get_meta("en_t_frase", "")).split(" ", false):
		var cand: String = pal if actual.is_empty() else actual + " " + pal
		if actual.is_empty() or f.get_string_size(cand, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x <= w:
			actual = cand
		else:
			lineas.append(actual)
			actual = pal
	if not actual.is_empty():
		lineas.append(actual)
	var de_ahora: Array[String] = []
	for h in caja.get_children():
		if h is Label:
			de_ahora.append((h as Label).text)
	if de_ahora == lineas:
		return
	for h in caja.get_children():
		caja.remove_child(h)
		h.queue_free()
	for i in lineas.size():
		var l: Label = _mk_t_label(px, col, lineas[i])
		l.name = "Linea%d" % i
		l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		caja.add_child(l)


