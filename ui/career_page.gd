func _rank_persona(row: Dictionary) -> Dictionary:
	var pos: String = String(row.get("pos", ""))
	if bool(row.get("yo", false)):
		var mios: Array = Career.puestos()
		return {"pos": String(mios[0]), "poss": mios}
	if row.get("libre", null) is Dictionary:
		var libre: Dictionary =(row["libre"] as Dictionary).duplicate()
		libre["pos"] = pos
		return libre
	var squad: Array = Squad.of(String(row.get("club", "")))
	var seat: int = int(row.get("seat", -1))
	if seat >= 0 and seat < squad.size():
		var p: Dictionary =(squad[seat] as Dictionary).duplicate()
		p["pos"] = pos
		return p
	return {"pos": pos}






















func _rank_marca(fila: HBoxContainer, row: Dictionary, yo: bool) -> void:
	if not _rank_marca_hay():
		return
	var club: String = String(row.get("club", ""))
	var seat: int = int(row.get("seat", -1))



	var nombre: String = ""
	if row.get("libre", null) is Dictionary:

		seat = _libre_seat_de(row)
		nombre = String((row["libre"] as Dictionary).get("name", ""))
	elif not club.is_empty():
		var squad: Array = Squad.of(club)
		if seat >= 0 and seat < squad.size():
			nombre = String((squad[seat] as Dictionary).get("name", ""))
	if yo or club.is_empty() or seat < 0 or nombre.is_empty() \
			or club == GameState.player_team_id:
		fila.add_child(_rank_act_hueco())
		return
	var f: Dictionary = {"club": club, "seat": seat, "name": nombre,
		"pos": String(row.get("pos", "")), "ovr": int(row.get("ovr", 0))}
	var marcado: bool = Career.gerencia_mesa_compro(f)
	var b: Button = _rank_act_btn(marcado)



	if not marcado and Gerencia.nivel_factor(int(row.get("ovr", 0))
			- Career.gerencia_once_media()
			- int(Career.gerencia_atractivo()["puntos"])) < Gerencia.INTERES_MIN:
		b.modulate = CareerTheme.DANGER
	b.pressed.connect(func() -> void: _mesa_toque_compra(f))
	fila.add_child(b)










func _mesa_toque_compra(f: Dictionary) -> void:
	var marca: int = _mesa_toque_marca()
	var antes: bool = Career.gerencia_mesa_compro(f)
	var causa: String = Career.gerencia_mesa_compra(f)
	if not causa.is_empty():
		UiAudio.deny()
		_toast(_mesa_causa_compra(f, causa), CareerTheme.DANGER)
		return


	UiAudio.toggle(not antes)
	if not antes:
		var precio: int = Career.gerencia_precio(f)
		var queda: int = int(Career.gerencia_mesa_saldo()["queda"])
		var cuesta: String = I18n.t("LIBRE") if precio <= 0 \
				else CareerUi.short_money(precio)

		if precio > 0 and Career.gerencia_clausula(f):
			cuesta = I18n.tf("CLÁUSULA: {0}", [cuesta])
		if queda >= 0:
			_toast(I18n.tf("Marcado ({0}). Te queda {1}.",
				[cuesta, CareerUi.short_money(queda)]), CareerTheme.MONEY)
		else:
			_toast(I18n.tf("Marcado ({0}). Te faltan {1}.",
				[cuesta, CareerUi.short_money(- queda)]), CareerTheme.DANGER)
	_mesa_refresca(_mesa_toque_limpio(marca))





func _mesa_causa_compra(f: Dictionary, causa: String) -> String:
	match causa:
		"cerrada": return _mesa_cerrada_txt(Career.gerencia_mesa_cerrada_por())
		"concurso": return I18n.t("Tu club está en concurso: hasta el mercado de invierno"
			+ " no ficha a nadie.")
		"tuyo": return I18n.t("Ya juega en tu club.")
		"ido": return I18n.t("Ya no juega ahí.")
		"edad": return I18n.t("Está acabando su carrera: el club no ficha a"
			+ " quien se retira.")
		"cedido": return I18n.t("Está cedido: quien lo tiene no lo puede vender.")
		"interes": return I18n.tf("No quiere venir: interés {0} % (mínimo {1} %).",
			[roundi(Career.gerencia_interes(f) * 100.0),
				roundi(Gerencia.INTERES_MIN * 100.0)])
		"club_no": return I18n.t("El club ya te dijo que no a este fichaje en esta ventana.")
	return ""



func _mesa_cerrada_txt(por: String) -> String:
	match por:
		"sin_club": return I18n.t("Sin club no hay mesa de fichajes.")
		"cedido": return I18n.t("Estás cedido: tu club no te pregunta por sus fichajes.")
		"te_vas": return I18n.t("Firmaste con otro club: la plantilla del año que viene"
			+ " ya no la haces tú.")
		"pediste": return I18n.t("Pediste salir: el club ya no te consulta su plantilla.")


