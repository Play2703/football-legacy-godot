func _cal_baldosa_nivel(b: Button) -> void:
	if not is_instance_valid(b) or not b.has_meta("cal_partes"):
		return
	var grupo: Array[Button] = []
	for o in b.get_meta("cal_juntas", [b]):
		if not is_instance_valid(o) or not (o as Button).is_inside_tree() \
				or not (o as Button).visible:
			continue
		if (o as Button).size.y <= 0.0:
			return
		grupo.append(o as Button)
	if grupo.is_empty():
		return
	var elegido: int = 0
	var dibs_de: Dictionary = {}
	for n in range(CAL_BALDOSA_NIVELES.size() - 1, -1, -1):
		var cabe: bool = true
		var dibs: Dictionary = {}
		for o in grupo:
			var sd: int = _cal_baldosa_cabe(o, CAL_BALDOSA_NIVELES[n])
			if sd < 0:
				cabe = false
				break
			dibs[o] = sd
		dibs_de = dibs
		if cabe:
			elegido = n
			break
	var nv: Array = CAL_BALDOSA_NIVELES[elegido]
	for o in grupo:
		var pt: Dictionary = o.get_meta("cal_partes")
		var cif: Label = pt["cifra"]
		var rot: Label = pt["rotulo"]
		var f: Font = cif.get_theme_font("font")
		var lee: int = CareerTheme.T_LEE_TUMBADO
		var ancho: float = o.size.x - 32.0
		(pt["icono"] as Control).custom_minimum_size = Vector2(nv[0], nv[0])
		var pila: bool = bool(nv[3])
		(pt["cab"] as BoxContainer).vertical = pila
		(pt["cab"] as BoxContainer).add_theme_constant_override("separation", 8 if pila else 16)
		cif.add_theme_font_size_override("font_size", int(nv[1]))
		var sd: int = int(dibs_de.get(o, 32))
		for dib in pt.get("dibs", []):
			(dib as Control).custom_minimum_size = Vector2(sd, sd)
		var w_rot: float = f.get_string_size(rot.text, HORIZONTAL_ALIGNMENT_LEFT, -1, lee).x \
				if f != null else 0.0
		rot.custom_minimum_size.x = minf(ceilf(w_rot) + 2.0,
			ancho if pila else maxf(0.0, ancho - float(nv[0]) - 16.0))
		for l in pt["subs"]:
			(l as Label).custom_minimum_size.x = ceilf(f.get_string_size((l as Label).text,
				HORIZONTAL_ALIGNMENT_LEFT, -1, lee).x) + 2.0 if f != null else 0.0
		o.set_meta("cal_nivel", elegido)




func _cal_baldosa_cabe(b: Button, nv: Array) -> int:
	var pt: Dictionary = b.get_meta("cal_partes")
	var cif: Label = pt["cifra"]
	var rot: Label = pt["rotulo"]
	var f: Font = cif.get_theme_font("font")
	if f == null:
		return -1
	var ancho: float = b.size.x - 32.0
	var alto: float = b.size.y - float(CareerTheme.SINK) - 32.0
	var lee: int = CareerTheme.T_LEE_TUMBADO
	var subs: Array = pt["subs"]
	var w_textos: float = 0.0
	for l in subs:
		w_textos += f.get_string_size((l as Label).text, HORIZONTAL_ALIGNMENT_LEFT, -1, lee).x
	var pila: bool = bool(nv[3])
	var w_r: float = f.get_string_size(rot.text, HORIZONTAL_ALIGNMENT_LEFT, -1, lee).x
	var w_cab: float = maxf(float(nv[0]), w_r) if pila else float(nv[0]) + 16.0 + w_r
	var w_cif: float = f.get_string_size(cif.text, HORIZONTAL_ALIGNMENT_LEFT, -1, int(nv[1])).x
	if w_cab > ancho or w_cif > ancho:
		return -1
	var h_cab: float = float(nv[0]) + 8.0 + f.get_height(lee) if pila \
			else maxf(float(nv[0]), f.get_height(lee))
	var h: float = h_cab + 8.0 + f.get_height(int(nv[1])) + 8.0 + CAL_T_BARRA
	if subs.is_empty():
		return int(nv[2]) if h <= alto else -1
	for sd in [int(nv[2]), 48, 32]:
		if sd > int(nv[2]):
			continue
		var w_subs: float = w_textos + float(subs.size()) *(float(sd) + 8.0) \
				+ 24.0 * float(maxi(0, subs.size() - 1))
		if w_subs <= ancho:
			return sd if h + 8.0 + maxf(float(sd), f.get_height(lee)) <= alto else -1

	return 32 if h + 8.0 + maxf(32.0, f.get_height(lee)) <= alto and int(nv[0]) == 48 \
			and int(nv[1]) == 32 else -1




func _cal_barra(partes: Array, alto: float) -> Control:
	var pista: PanelContainer = PanelContainer.new()
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = CareerTheme.SURFACE_LINE
	sb.set_corner_radius_all(2)
	pista.add_theme_stylebox_override("panel", sb)
	pista.custom_minimum_size = Vector2(0, alto)
	pista.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pista.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 0)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pista.add_child(fila)
	var usado: float = 0.0
	for pz in partes:
		var fr: float = clampf(float((pz as Array)[0]), 0.0, 1.0 - usado)
		if fr <= 0.0:
			continue
		usado += fr
		var r: ColorRect = ColorRect.new()
		r.color =(pz as Array)[1]
		r.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		r.size_flags_stretch_ratio = fr
		r.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fila.add_child(r)
	if usado < 1.0:
		var resto: Control = Control.new()
		resto.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		resto.size_flags_stretch_ratio = 1.0 - usado
		resto.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fila.add_child(resto)
	return pista









func _cal_temporada_modal(filas: Array) -> void:



	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	box.set_meta("cal_temporada", true)
	var titulo: Label = CareerUi.plain(CareerTheme.T_TITULO_TUMBADO, CareerTheme.TEXT)
	titulo.text = CareerTheme.caps(I18n.t("TEMPORADA"))
	titulo.clip_text = true
	titulo.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(titulo)
	var hay: Dictionary = _cal_familias_de(filas)
	var total: Array[int] = [0, 0, 0]
	var por_fam: Dictionary = {}
	for fam in hay:
		var gep: Array[int] = [0, 0, 0]
		var n: int = 0
		for f in filas:
			if String(f["familia"]) != fam:
				continue
			n += 1
			if not bool(f["jugado"]):
				continue
			var i: int = 0 if String(f["res"]) == "G" else (1 if String(f["res"]) == "E" else 2)
			gep[i] += 1
			total[i] += 1
		por_fam[fam] = {"gep": gep, "n": n}
	var jugados: bool = total[0] + total[1] + total[2] > 0
	var nombres: Array[Label] = []




	var bloque: VBoxContainer = VBoxContainer.new()
	bloque.add_theme_constant_override("separation", CAL_T_SEP)
	bloque.alignment = BoxContainer.ALIGNMENT_CENTER
	bloque.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(bloque)
	var cab: HBoxContainer = null
	if jugados:
		cab = _cal_temporada_fila(bloque, null, "", ["G", "E", "P"], [], nombres)
		cab.remove_meta("fl_fila")
	var lista: VBoxContainer = VBoxContainer.new()
	lista.add_theme_constant_override("separation", CAL_T_SEP)
	lista.mouse_filter = Control.MOUSE_FILTER_IGNORE
	lista.set_meta("fl_lista", "temporada")
	bloque.add_child(lista)
	var filas_hechas: int = 0
	for fam in hay:
		var pf: Dictionary = por_fam[fam]
		var gep: Array[int] = pf["gep"]
		if jugados and gep[0] + gep[1] + gep[2] == 0:
			continue
		var fd: Dictionary = hay[fam]
		var col: Color = _cal_label_col(Color(fd["tint"]))
		var logo: CompLogo = CompLogo.new()
		logo.setup(String(fd["logo"]), col)
		var nombre: String = I18n.t(String(CAL_FAMILIAS[fam]))
		if jugados:
			_cal_temporada_fila(lista, logo, nombre, [str(gep[0]), str(gep[1]), str(gep[2])], gep,
				nombres)
		else:
			_cal_temporada_fila(lista, logo, nombre, [str(int(pf["n"]))],
				[[float(int(pf["n"])) / float(maxi(1, filas.size())), col]], nombres)
		filas_hechas += 1
	if jugados and filas_hechas > 1:
		var ic: MenuIcon = MenuIcon.new()
		ic.setup("torneos", CareerTheme.TEXT_MID)
		_cal_temporada_fila(lista, ic, I18n.t("TOTAL"),
			[str(total[0]), str(total[1]), str(total[2])], total, nombres)

	var w: float = 0.0
	for l in nombres:
		var fnt: Font = l.get_theme_font("font")
		if fnt != null and not l.text.is_empty():
			w = maxf(w, fnt.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1,
				l.get_theme_font_size("font_size")).x)
	for l in nombres:
		l.custom_minimum_size.x = ceilf(w) + 2.0
	box.add_child(_torn_boton(I18n.t("CERRAR"), CareerTheme.Kind.GHOST,
		func() -> void: CareerUi.close_modal(box)))




const CAL_TEMP_CIFRA: float = 96.0


const CAL_TEMP_FILA_MAX: float = 112.0


const CAL_TEMP_BARRA_MIN: float = 480.0







func _cal_temporada_fila(box: VBoxContainer, dib: Control, nombre: String, cifras: Array,
		gep: Array, nombres: Array[Label]) -> HBoxContainer:
	var cabecera: bool = dib == null
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 24)
	fila.custom_minimum_size.y = 32.0 if cabecera else CAL_TEMP_FILA_MAX
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.set_meta("fl_fila", true)
	box.add_child(fila)
	var hueco: Control = Control.new() if cabecera else dib
	hueco.custom_minimum_size = Vector2(72, 72 if not cabecera else 0)
	hueco.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	hueco.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(hueco)
	var nom: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, CareerTheme.TEXT)
	nom.text = CareerTheme.caps(nombre)
	nom.clip_text = true
	nom.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	nom.set_meta("cal_temp_nombre", true)
	fila.add_child(nom)
	nombres.append(nom)
	var cols: Array[Color] = [CareerTheme.TEXT, CareerTheme.TEXT_DIM, CareerTheme.DANGER]
	for i in cifras.size():
		var l: Label = CareerUi.plain(CareerTheme.T_CAP_TUMBADO if cabecera
			else CareerTheme.T_TITULO_TUMBADO, cols[i] if cifras.size() == 3 else CareerTheme.TEXT)
		l.text = I18n.t(String(cifras[i]), "tabla_liga") if cabecera else String(cifras[i])
		l.clip_text = true
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

		l.vertical_alignment = VERTICAL_ALIGNMENT_BOTTOM if cabecera else VERTICAL_ALIGNMENT_CENTER
		l.custom_minimum_size.x = CAL_TEMP_CIFRA
		if not cabecera:
			l.set_meta("cal_temp_cifra", i)
		fila.add_child(l)
	var carril: VBoxContainer = VBoxContainer.new()
	carril.alignment = BoxContainer.ALIGNMENT_CENTER
	carril.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	carril.custom_minimum_size.x = CAL_TEMP_BARRA_MIN
	carril.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(carril)
	if cabecera:
		return fila
	if cifras.size() == 3:
		var n: float = float(maxi(1, int(gep[0]) + int(gep[1]) + int(gep[2])))
		carril.add_child(_cal_barra([[int(gep[0]) / n, CareerTheme.TEXT],
			[int(gep[1]) / n, CareerTheme.TEXT_DIM], [int(gep[2]) / n, CareerTheme.DANGER]], 24.0))
	else:
		carril.add_child(_cal_barra(gep, 24.0))
	return fila








func _cal_detalle_tumbado(f: Dictionary) -> void:
	var box: VBoxContainer = CareerUi.modal_pantalla(self)
	if box == null:
		return
	CareerUi.margen_modal_tumbada(box)
	CareerUi.modal_opaca(box)
	box.set_meta("cal_detalle", true)
	var tinta: Color = _cal_label_col(Color(f["tint"]))


	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 16)
	cab.alignment = BoxContainer.ALIGNMENT_CENTER
	cab.set_meta("cal_detalle_titulo", true)
	box.add_child(cab)
	var logo: CompLogo = CompLogo.new()
	logo.custom_minimum_size = Vector2(48, 48)
	logo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	logo.setup(String(f["logo"]), tinta)
	cab.add_child(logo)
	var torneo: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, tinta)
	var partes: Array[String] = [I18n.t(String(f["torneo"]))]
	if not String(f["ronda"]).is_empty():
		partes.append(String(f["ronda"]))
	torneo.text = CareerTheme.caps(" · ".join(partes))
	torneo.clip_text = true
	torneo.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	cab.add_child(torneo)
	var f_tit: Font = torneo.get_theme_font("font")
	var cabe: float = SceneFade.rect_visible(self).size.x - box.offset_left + box.offset_right \
			- 48.0 - 16.0
	torneo.custom_minimum_size.x = minf(cabe, 0.0 if f_tit == null else ceilf(f_tit.get_string_size(
		torneo.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, CareerTheme.T_DATO_TUMBADO).x) + 2.0)




	var jugado: bool = bool(f["jugado"])
	var casa: bool = bool(f["you_home"])
	var comp: String = String(f["comp"])
	var arriba: Control = Control.new()
	arriba.size_flags_vertical = Control.SIZE_EXPAND_FILL
	arriba.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(arriba)
	var r: HBoxContainer = HBoxContainer.new()
	r.add_theme_constant_override("separation", 48)
	r.alignment = BoxContainer.ALIGNMENT_CENTER
	box.add_child(r)
	_cal_lado_tumbado(r, f["local"], casa, comp)
	var marc: Label = CareerUi.plain(CareerTheme.T_HEROE_TUMBADO,
		_cal_res_col_tumbado(String(f["res"])) if jugado else CareerTheme.TEXT_DIM)
	marc.text =("%d-%d" % [int(f["gl"]), int(f["gv"])]) if jugado else I18n.t("VS")
	marc.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	marc.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	marc.custom_minimum_size.x = 240
	r.add_child(marc)
	_cal_lado_tumbado(r, f["visita"], not casa, comp)

	var datos: VBoxContainer = VBoxContainer.new()
	datos.add_theme_constant_override("separation", 16)
	datos.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	datos.custom_minimum_size.x = 1120
	datos.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(datos)

	var papel: String = ""
	if not jugado:
		var d: int = int(f["descanso"])
		if d >= 0:
			_cal_dato_tumbado(datos, "reloj", I18n.t("DÍAS DE DESCANSO"), I18n.tf("{0}d", [d]),
				_cal_descanso_col(d), float(d) / CAL_DESCANSO_BARRA)
		var baja: String = String(f["baja"])
		if baja == "BAJA" or baja == "ALTA":
			papel = baja
			_cal_dato_tumbado(datos, "cruz_medica", I18n.t("TU PAPEL"), I18n.t(baja, "lesion"),
				CareerTheme.DANGER if baja == "BAJA" else CareerTheme.TEXT, -1.0)
		elif bool(f["proximo"]) and comp != "nat":
			var e: float = Career.energy
			_cal_dato_tumbado(datos, "potencia", I18n.t("ENERGÍA"), str(roundi(e)),
				CareerTheme.energy_color(e), e / 100.0)
			papel = cal_papel(Career.standing())
			_cal_dato_tumbado(datos, "equipo", I18n.t("TU PAPEL"), I18n.t(papel),
				CareerTheme.TEXT if papel == "TITULAR" else cal_papel_color(papel), -1.0)
	box.set_meta("cal_papel", papel)
	var muelle: Control = Control.new()
	muelle.size_flags_vertical = Control.SIZE_EXPAND_FILL
	muelle.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(muelle)


	muelle.resized.connect(_cal_detalle_crece.bind(r, arriba, muelle))
	var botones: HBoxContainer = HBoxContainer.new()
	botones.add_theme_constant_override("separation", 16)
	box.add_child(botones)
	botones.add_child(_torn_boton(I18n.t("CERRAR"), CareerTheme.Kind.GHOST,
		func() -> void: CareerUi.close_modal(box)))
	if jugado or comp == "nat":
		return
	var plantilla: Button = Button.new()
	plantilla.text = I18n.t("PLANTILLA")
	plantilla.clip_text = true
	plantilla.custom_minimum_size = Vector2(0, CareerTheme.TOQUE_TUMBADO)
	plantilla.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerTheme.apply_button_tinted(plantilla, CareerTheme.NAV_PLANTILLA, CareerTheme.T_LEE_TUMBADO)
	plantilla.pressed.connect(func() -> void:
		CareerUi.close_modal(box)
		_on_family("plantilla"))
	botones.add_child(plantilla)




const CAL_DETALLE_ESCUDO: float = 240.0

const CAL_DETALLE_ESCUDO_MAX: float = 400.0
const CAL_DETALLE_AIRE: float = 64.0





func _cal_detalle_crece(r: HBoxContainer, arriba: Control, muelle: Control) -> void:
	var escudos: Array[Control] = []
	for c in r.find_children("*", "CrestView", true, false):
		escudos.append(c as Control)
	if escudos.is_empty():
		return
	var lado: float = escudos[0].custom_minimum_size.y
	var quiere: float = clampf(floorf(lado + arriba.size.y + muelle.size.y - 2.0 * CAL_DETALLE_AIRE),
		CAL_DETALLE_ESCUDO, CAL_DETALLE_ESCUDO_MAX)
	if absf(quiere - lado) < 1.0:
		return
	for e in escudos:
		e.custom_minimum_size = Vector2(quiere, quiere)




func _cal_lado_tumbado(r: HBoxContainer, team: Dictionary, tuyo: bool, comp: String) -> void:
	var caja: VBoxContainer = VBoxContainer.new()
	caja.add_theme_constant_override("separation", 16)
	caja.custom_minimum_size.x = 480
	caja.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.add_child(caja)
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(CAL_DETALLE_ESCUDO, CAL_DETALLE_ESCUDO)
	crest.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	crest.mouse_filter = Control.MOUSE_FILTER_IGNORE
	crest.set_team(team)
	caja.add_child(crest)
	var nom: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO,
		_cal_you_col() if tuyo else CareerTheme.TEXT)
	nom.text = CareerTheme.caps(_torn_nombre_corto(Competitions.demarca(
		String(team.get("name", team.get("abbrev", ""))))))
	nom.clip_text = true
	nom.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	caja.add_child(nom)
	var forma: Array = GameState.form_of_any(String(team.get("id", "")), comp)
	if forma.is_empty():
		return
	var cajas: HBoxContainer = CareerUi.forma_cajas(forma)
	cajas.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	cajas.set_meta("cal_racha", forma.size())
	caja.add_child(cajas)




func _cal_dato_tumbado(box: Container, icono: String, rotulo: String, valor: String, col: Color,
		frac: float) -> void:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 24)
	box.add_child(fila)
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(48, 48)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.setup(icono, col)
	fila.add_child(ic)
	var l: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_DIM)
	l.text = CareerTheme.caps(rotulo)
	l.custom_minimum_size.x = 440
	l.clip_text = true
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(l)
	var val: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, col)
	val.text = CareerTheme.caps(valor)
	val.clip_text = true
	val.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	if frac < 0.0:
		val.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fila.add_child(val)
		return
	val.custom_minimum_size.x = 120
	val.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	fila.add_child(val)
	var carril: VBoxContainer = VBoxContainer.new()
	carril.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	carril.alignment = BoxContainer.ALIGNMENT_CENTER
	fila.add_child(carril)
	carril.add_child(_cal_barra([[frac, col]], 16.0))










func _cal_casilla(f: Dictionary, tam: Vector2 = Vector2.ZERO, en_scroll: bool = false,
		tocable: bool = true, tumbado: bool = false) -> Control:
	var jugado: bool = bool(f["jugado"])
	var col: Color = _cal_res_col(String(f["res"]))
	var px: float = CAL_CASILLA.x if tam == Vector2.ZERO else tam.x
	var py: float = CAL_CASILLA.y if tam == Vector2.ZERO else tam.y
	var pan: PanelContainer = PanelContainer.new()
	pan.custom_minimum_size = Vector2(0.0 if en_scroll else px, py)
	if en_scroll:
		pan.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pan.set_meta("cal_partido", true)


	pan.set_meta("cal_descanso", int(f.get("descanso", -1)))
	pan.set_meta("cal_baja", String(f.get("baja", "")))


	var k: float = minf(px, py) / CAL_CASILLA.x


	var fam: String = String(f.get("familia", "liga"))
	var tint: Color = Color(f["tint"])
	var sb: StyleBoxFlat = _cal_sb_piel(fam, tint, k)
	pan.set_meta("cal_piel", fam)

	pan.add_child(_cal_patron(fam, tint, sb, int(f.get("dia", 0))))



	if bool(f.get("proximo", false)):
		sb.border_color = _cal_you_col()
		sb.border_width_left = 3
		sb.border_width_right = 3
		sb.border_width_bottom = 3
		sb.border_width_top = 3
		var pat: CAL_PATRON = pan.get_child(0) as CAL_PATRON
		pat.sangre = sb.content_margin_left - 3.0
		pat.radio = CareerTheme.RADIUS - 3.0
	pan.add_theme_stylebox_override("panel", sb)



	if fam == "continental":
		var agua: CenterContainer = CenterContainer.new()
		agua.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pan.add_child(agua)
		var wm: CompLogo = CompLogo.new()
		var lado_wm: float = floorf(minf(px, py) * CAL_AGUA_LADO)
		wm.custom_minimum_size = Vector2(lado_wm, lado_wm)
		wm.sin_placa = true
		wm.mouse_filter = Control.MOUSE_FILTER_IGNORE
		wm.setup(String(f["logo"]), _cal_label_col(tint))
		wm.modulate.a = CAL_AGUA_ALPHA
		wm.set_meta("cal_agua", true)
		agua.add_child(wm)
	if tumbado:
		_cal_casilla_tumbada(pan, f)
		pan.set_meta("cal_dia", int(f["dia"]))
		if bool(f.get("proximo", false)):
			pan.set_meta("fl_tuya", true)
		if tocable:
			pan.mouse_filter = Control.MOUSE_FILTER_PASS
			_rank_tap(pan, _cal_detalle.bind(f))
		else:
			pan.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return pan
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 2)
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pan.add_child(v)
	var logo: CompLogo = CompLogo.new()
	logo.custom_minimum_size = Vector2(18, 18) * k
	logo.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	logo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	logo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	logo.setup(String(f["logo"]), _cal_label_col(Color(f["tint"])))









	var sitio_chip: float = floorf(px - 8.0 - ceilf(18.0 * k) - 6.0)
	var chip: Control = _cal_chip(f, 0.0 if en_scroll and px >= CAL_CHIP_HOLGADO else sitio_chip)
	if en_scroll or chip != null:
		var cabeza: HBoxContainer = HBoxContainer.new()
		cabeza.add_theme_constant_override("separation", 2)
		cabeza.mouse_filter = Control.MOUSE_FILTER_IGNORE
		v.add_child(cabeza)
		logo.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		cabeza.add_child(logo)
		if chip != null:
			var muelle: Control = Control.new()
			muelle.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			muelle.mouse_filter = Control.MOUSE_FILTER_IGNORE
			cabeza.add_child(muelle)
			cabeza.add_child(chip)
	else:
		v.add_child(logo)


	var escudos: HBoxContainer = HBoxContainer.new()
	escudos.add_theme_constant_override("separation", 4)
	escudos.alignment = BoxContainer.ALIGNMENT_CENTER
	escudos.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(escudos)
	for lado in ["local", "visita"]:
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(30, 30) * k
		crest.mouse_filter = Control.MOUSE_FILTER_IGNORE
		crest.set_team(f[lado])
		escudos.add_child(crest)
	var t_marc: int = CareerTheme.T_BODY if k >= 1.4 else (CareerTheme.T_DIM if k > 1.0 \
			else CareerTheme.T_CAPTION)
	var marc: Label = CareerUi.plain(t_marc, CareerTheme.TEXT if jugado else CareerTheme.TEXT_DIM)
	marc.text =("%d - %d" % [int(f["gl"]), int(f["gv"])]) if jugado else I18n.t("VS")
	marc.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	if jugado:







		var sb_res: StyleBoxFlat = CareerTheme.tag(CareerTheme.SURFACE.lerp(col, CAL_RES_ALPHA))
		sb_res.set_content_margin_all(0.0)
		sb_res.expand_margin_left = CAL_RES_AIRE
		sb_res.expand_margin_right = CAL_RES_AIRE
		marc.add_theme_stylebox_override("normal", sb_res)
		marc.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		marc.set_meta("cal_res", String(f["res"]))
	v.add_child(marc)
	if not tocable:
		pan.mouse_filter = Control.MOUSE_FILTER_IGNORE
	elif en_scroll:
		pan.mouse_filter = Control.MOUSE_FILTER_PASS
		_rank_tap(pan, _cal_detalle.bind(f))
	else:
		pan.add_child(CareerUi.hit_overlay(px - 8.0, _cal_detalle.bind(f)))
	return pan




















