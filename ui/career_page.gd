func _season_nav_button(dir: int) -> Button:
	var b: Button = Button.new()
	b.custom_minimum_size = Vector2(150, CareerTheme.BTN_SECONDARY_H)
	CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, CareerTheme.T_VALUE)
	var to: int = _season_card_i + dir
	if to < 0 or to >= _season_cards.size():
		b.disabled = true
		b.text = "—"
		return b
	var yr: int = int(_season_cards[to].get("season", 0))


	b.text =("< T%d" % yr) if dir < 0 else ("T%d >" % yr)
	b.pressed.connect(func() -> void:
		_season_card_i = to
		_render_season_card())
	return b







