		if not Career.agent_commission("push"):
			_toast(I18n.t("NO TE ALCANZA"), CareerTheme.DANGER)
	var encargos: Array = [
		["mover", "MUÉVEME", "push", cerrado or pasivo != "", pasivo == "push", mueve],
		["mundo", "UNA LIGA", "league", cerrado or pasivo != "", pasivo == "league",
			func() -> void: _agent_pick_country(false)],
		["puerta", "UN CLUB", "club", cerrado or tiro != "", tiro == "club",
			func() -> void: _agent_pick_country(true)]]
	for e in encargos:
		_agent_tile(fila, String(e[0]), I18n.t(String(e[1])), String(e[2]), bool(e[3]),
			bool(e[4]), e[5] as Callable)
		var b: Button = fila.get_child(fila.get_child_count() - 1) as Button
		b.name = "Encargo_" + String(e[2])
		b.custom_minimum_size.y = MK_T_ENCARGO_H
		b.size_flags_vertical = Control.SIZE_EXPAND_FILL
		b.set_meta("mk_t_encargo", String(e[2]))
		for ic2 in b.find_children("*", "MenuIcon", true, false):
			(ic2 as Control).custom_minimum_size = Vector2(MK_T_ICONO, MK_T_ICONO)


		b.set_meta(Entrada.SIN_FOCO_META, true)
		b.focus_mode = Control.FOCUS_NONE
		b.gui_input.connect(_mk_t_cruceta.bind(_mk_t_encargos.size()))
		_mk_t_encargos.append(b)
	for i in _mk_t_encargos.size():
		if not _mk_t_encargos[i].disabled:
			_mk_t_encargos[i].focus_mode = Control.FOCUS_ALL
			_mk_t_encargo_elegido = i
			break
	return card




func _mk_t_cruceta(ev: InputEvent, i: int) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO:
		return
	var paso: int = 0
	if ev.is_action_pressed("ui_left", true):
		paso = -1
	elif ev.is_action_pressed("ui_right", true):
		paso = 1
	else:
		return
	var a: int = i + paso
	while a >= 0 and a < _mk_t_encargos.size() and _mk_t_encargos[a].disabled:
		a += paso
	if a < 0 or a >= _mk_t_encargos.size():
		return
	_mk_t_elige(a)
	_mk_t_encargos[i].accept_event()



func _mk_t_elige(a: int) -> void:
	if a < 0 or a >= _mk_t_encargos.size():
		return
	for i in _mk_t_encargos.size():
		var b: Button = _mk_t_encargos[i]
		if not is_instance_valid(b):
			continue
		b.focus_mode = Control.FOCUS_ALL if i == a else Control.FOCUS_NONE
	_mk_t_encargo_elegido = a
	_mk_t_encargos[a].grab_focus()





