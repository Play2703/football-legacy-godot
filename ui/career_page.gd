func _cal_semana_tumbada(box: VBoxContainer, sem: int, d: Dictionary, mes: int, tocable: bool,
		crece: bool) -> void:
	var por_dia: Dictionary =(d["por_semana"] as Dictionary).get(sem, {})
	var fifa: bool = bool((d["fifa"] as Dictionary).get(sem, false))
	var hoy: int = int(d["hoy"])
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", CAL_T_SEP)
	fila.custom_minimum_size.y = CAL_T_FICHA
	if crece:
		fila.size_flags_vertical = Control.SIZE_EXPAND_FILL
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.set_meta("cal_semana", sem)
	fila.set_meta("fl_fila", true)
	if fifa:
		fila.set_meta("cal_fifa", true)
	if sem * 7 + 6 < hoy:
		fila.set_meta("cal_semana_pasada", true)
	box.add_child(fila)
	var canal: Label = CareerUi.plain(CareerTheme.T_CAP_TUMBADO,
		_cal_label_col(_cal_tint("nat")) if fifa else CareerTheme.TEXT_MID)
	canal.text = CareerTheme.caps(I18n.t(CareerUi.MESES[mes - 1])) if mes > 0 else ""
	canal.clip_text = true
	canal.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	canal.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	canal.custom_minimum_size = Vector2(_cal_t_canal(), 0)
	fila.add_child(canal)
	for c in 7:
		if por_dia.has(c):
			var cas: Control = _cal_casilla(por_dia[c], Vector2(CAL_T_FICHA, CAL_T_FICHA), true,
				tocable, true)
			if sem * 7 + c < hoy:
				cas.modulate.a = CAL_VELO
			fila.add_child(cas)
		else:
			fila.add_child(_cal_celda_vacia(CAL_T_FICHA, fifa, sem * 7 + c < hoy, sem * 7 + c,
				c >= 5))







func _cal_casilla_tumbada(pan: PanelContainer, f: Dictionary) -> void:
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 4)
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pan.add_child(v)
	var r: HBoxContainer = HBoxContainer.new()
	r.add_theme_constant_override("separation", 4)
	r.alignment = BoxContainer.ALIGNMENT_CENTER
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(r)
	var partes: Dictionary = {"escudos": [], "logo": null, "pie": null}
	for lado in ["local", "logo", "visita"]:
		if lado == "logo":
			var logo: CompLogo = CompLogo.new()
			logo.custom_minimum_size = Vector2(CAL_T_LOGO, CAL_T_LOGO)
			logo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			logo.mouse_filter = Control.MOUSE_FILTER_IGNORE
			logo.setup(String(f["logo"]), _cal_label_col(Color(f["tint"])))
			r.add_child(logo)
			partes["logo"] = logo
			continue
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(CAL_T_ESCUDO, CAL_T_ESCUDO)
		crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		crest.mouse_filter = Control.MOUSE_FILTER_IGNORE
		crest.set_team(f[lado])
		r.add_child(crest)
		(partes["escudos"] as Array).append(crest)
	var pie: Control = null
	var baja: String = String(f.get("baja", ""))
	if bool(f["jugado"]):
		var res: String = String(f["res"])
		var marc: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, _cal_res_col_tumbado(res))


		marc.text = "%d-%d" % [int(f["gl"]), int(f["gv"])]


		var sb_res: StyleBoxFlat = CareerTheme.tag(CareerTheme.SURFACE)
		sb_res.set_content_margin_all(0.0)
		sb_res.expand_margin_left = CAL_RES_AIRE
		sb_res.expand_margin_right = CAL_RES_AIRE
		marc.add_theme_stylebox_override("normal", sb_res)
		marc.set_meta("cal_res", res)
		pie = marc
	elif baja == "BAJA" or baja == "ALTA":
		var ic: MenuIcon = MenuIcon.new()
		ic.custom_minimum_size = Vector2(CareerTheme.T_LEE_TUMBADO, CareerTheme.T_LEE_TUMBADO)
		ic.setup("cruz_medica", CareerTheme.DANGER if baja == "BAJA" else CareerTheme.TEXT)
		ic.set_meta("cal_chip", baja)
		pie = ic
	else:
		var dsc: int = int(f.get("descanso", -1))
		var l: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO,
			_cal_descanso_col(dsc) if dsc >= 0 else CareerTheme.TEXT_DIM)
		l.text = I18n.tf("{0}d", [dsc]) if dsc >= 0 else I18n.t("VS")
		if dsc >= 0:
			l.set_meta("cal_chip", l.text)
		pie = l
	if pie is Label:
		(pie as Label).horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	pie.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	pie.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(pie)
	partes["pie"] = pie
	pan.set_meta("cal_t_partes", partes)




func _cal_casilla_grande(pan: Control, grande: bool) -> void:
	if not pan.has_meta("cal_t_partes"):
		return
	var pt: Dictionary = pan.get_meta("cal_t_partes")
