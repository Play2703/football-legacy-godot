	var cb: Callable = d.get("al_tocar", Callable())
	if cb.is_valid():
		b.pressed.connect(cb)
	b.gui_input.connect(_ti_t_cruceta.bind(j))
	var relleno: MarginContainer = CareerUi._relleno_boton(b, 16, 12)
	var pila: VBoxContainer = VBoxContainer.new()
	pila.name = "Pila"
	pila.add_theme_constant_override("separation", 8)
	pila.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	pila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	relleno.add_child(pila)
	var arte: Control = _ti_t_arte(d)
	arte.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	arte.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pila.add_child(arte)
	var nombre: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT,
		CareerTheme.caps(String(d["titulo"])))
