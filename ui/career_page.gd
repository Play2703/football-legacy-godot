			if t:
				CareerUi.letra_por_peldanos(pide, [CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
		col.add_child(b)
	col.add_child(_pr_cobrado(v["cobrado"] as Dictionary, t))




func _pr_objetivo(prima: int) -> Button:
	var tipo: String = String(Career.contract.get("obj_type", "goals"))
	var meta: int = int(Career.contract.get("obj_target", 0))
	var lleva: int = int(Career.contract.get("obj_progress", 0))
	var ic: MenuIcon = MenuIcon.new()
	ic.setup("precision", CareerTheme.MONEY)
	var b: Button = _pr_baldosa("Objetivo", ic, I18n.t("OBJETIVO"), prima, PR_OBJETIVO_H,
		_pr_modal_objetivo.bind(prima), false)
	var fila: HBoxContainer = b.find_child("Fila", true, false) as HBoxContainer

	var relleno: MarginContainer = fila.get_parent() as MarginContainer
	relleno.remove_child(fila)
	var pila: VBoxContainer = VBoxContainer.new()
	pila.name = "Pila"
	pila.alignment = BoxContainer.ALIGNMENT_CENTER
	pila.add_theme_constant_override("separation", 16)
	pila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	relleno.add_child(pila)
	pila.add_child(fila)
	var abajo: HBoxContainer = HBoxContainer.new()
	abajo.name = "Va"
	abajo.add_theme_constant_override("separation", 16)
	abajo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pila.add_child(abajo)
	var unidad: String
	var cuenta: String
	match tipo:
		"assists":
			unidad = "ASISTENCIAS"
		"matches":
			unidad = "PARTIDOS"
		"rating":
			unidad = "NOTA"
		"position":
			unidad = "PUESTO"
		_:
			unidad = "GOLES"
	if tipo == "rating":
		cuenta = "%s/%s" % [I18n.num(float(lleva) / 10.0, 1), I18n.num(float(meta) / 10.0, 1)]
	else:
		cuenta = "%d/%d" % [lleva, meta]
	if tipo == "position":
		var pos: int = _league_position() if GameState.league_started() else 0
		var bien: bool = pos > 0 and pos <= meta
		var va: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO,
			CareerTheme.accent_text() if bien else CareerTheme.TEXT_MID,
			I18n.tf("VAS {0}", [_ordinal(pos)]) if pos > 0 else I18n.t("SIN EMPEZAR"))
		va.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		abajo.add_child(va)
		cuenta = _ordinal(meta)
	else:
		var barra: Control = _ct_t_barra(float(lleva) / float(maxi(meta, 1)), 0.0)
		if not bool(Career.objective_pace().get("on_track", true)):
			for n in barra.find_children("*", "ColorRect", true, false):
				if n.has_meta("ct_t_barra"):
					(n as ColorRect).color = CareerTheme.DANGER
		abajo.add_child(barra)
	var c: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT,
		"%s %s" % [cuenta, CareerTheme.caps(I18n.t(unidad))], false)
	c.name = "Cuenta"
	c.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	abajo.add_child(c)
	return b




func _pr_cobrado(cob: Dictionary, t: bool) -> Button:
	var partes: Array = [["firma", "FIRMA"], ["goles", "GOLES"], ["premios", "PREMIOS"]]
	var total: int = 0
	for p in partes:
		total += int(cob.get(p[0], 0))
	var ic: MenuIcon = MenuIcon.new()
	ic.setup("moneda", CareerTheme.MONEY)
	var b: Button = _pr_baldosa("Cobrado", ic, I18n.t("COBRADO"), total, PR_OBJETIVO_H,
		_pr_modal_cobrado.bind(cob), false)
	if t:
		b.size_flags_vertical = Control.SIZE_EXPAND_FILL
	var valor: Label = b.find_child("Valor", true, false) as Label

	valor.text = "$ %s" % CareerUi.money(total)
	valor.add_theme_font_size_override("font_size", CareerTheme.T_DATO_TUMBADO)
	valor.custom_minimum_size.x = _wnews_ancho(valor.text, CareerTheme.T_DATO_TUMBADO) + 4.0
	var fila: HBoxContainer = b.find_child("Fila", true, false) as HBoxContainer
	var relleno: MarginContainer = fila.get_parent() as MarginContainer
	relleno.remove_child(fila)
	var pila: VBoxContainer = VBoxContainer.new()
	pila.name = "Pila"
	pila.alignment = BoxContainer.ALIGNMENT_CENTER
	pila.add_theme_constant_override("separation", 16)
	pila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	relleno.add_child(pila)
	pila.add_child(fila)
	var tonos: Array[Color] = [CareerTheme.MONEY, CareerTheme.MONEY.darkened(0.3),
		CareerTheme.MONEY.darkened(0.55)]
	if total <= 0:
		pila.add_child(_ct_t_barra(0.0, 0.0))
	else:
		var barra: HBoxContainer = HBoxContainer.new()
		barra.name = "Barra"
		barra.custom_minimum_size.y = PR_BARRA_H
		barra.add_theme_constant_override("separation", 0)
		barra.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pila.add_child(barra)
		for i in partes.size():
			var monto: int = int(cob.get(partes[i][0], 0))
			if monto <= 0:
				continue
			var tramo: ColorRect = ColorRect.new()
			tramo.name = "Tramo_" + String(partes[i][0])
			tramo.color = tonos[i]
			tramo.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			tramo.size_flags_stretch_ratio = float(monto)
			tramo.mouse_filter = Control.MOUSE_FILTER_IGNORE
			barra.add_child(tramo)
	var ley: HBoxContainer = HBoxContainer.new()
	ley.name = "Leyenda"
	ley.add_theme_constant_override("separation", 20)
	ley.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pila.add_child(ley)
	for i in partes.size():
		var par: HBoxContainer = HBoxContainer.new()
		par.add_theme_constant_override("separation", 8)
		par.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var cuadro: ColorRect = ColorRect.new()
		cuadro.color = tonos[i]
		cuadro.custom_minimum_size = Vector2(16.0, 16.0)
		cuadro.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cuadro.mouse_filter = Control.MOUSE_FILTER_IGNORE
		par.add_child(cuadro)
		var l: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID,
			CareerTheme.caps(I18n.t(String(partes[i][1]))), false)
		l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		par.add_child(l)
		ley.add_child(par)
	return b


