	row.add_child(_caja_real(precio, puede, pid))



func _caja_lote_tuyo(ent: Dictionary) -> bool:
	var eds: Array = ent.get("ediciones", [])
	if eds.is_empty():
		return false
	for e in eds:
		if not Career.boots_ediciones.has(String(e)):
			return false
	return true





func _caja_buy(pid: String) -> void:


	if not _caja_esperando.is_empty():
		return
	Telemetry.count("caja_tocada")
	_caja_esperando = pid
	_caja_dinero_antes = Career.money
	_caja_peso = Iap.peso_de(pid)
	if not Store.comprar_pack(pid):


		Telemetry.count("caja_sin_hoja")
		_caja_esperando = ""
		_help(I18n.t("LA CAJA"), Store.texto_no_responde())
		return



	_caja_reloj(true)
	_refresh()





func _caja_reloj(on: bool) -> void:
	if _caja_timer == null or not is_instance_valid(_caja_timer):
		_caja_timer = Timer.new()
		_caja_timer.one_shot = true
		_caja_timer.wait_time = 30.0
		_caja_timer.timeout.connect(_caja_sin_respuesta)
		add_child(_caja_timer)
	if on:
		_caja_timer.start()
	else:
		_caja_timer.stop()





func _caja_sin_respuesta() -> void:


	if not _caja_esperando.is_empty():
		Telemetry.count("caja_sin_respuesta")
	_caja_esperando = ""
	_refresh()











func _on_caja_intento(ok: bool, motivo: String) -> void:
	if _caja_esperando.is_empty():
		return
	var comprado: String = _caja_esperando
	_caja_esperando = ""
	_caja_reloj(false)


	_refresh()
	if not ok:

		Telemetry.count(Store.evento_sin_cobro(motivo))
		if not motivo.is_empty():
			_help(I18n.t("LA CAJA"), I18n.t(motivo))
		return


	Telemetry.count("caja_comprada")





	if Iap.es_derecho(comprado):
		_help(I18n.t("TODAS LAS VENTAJAS"), I18n.t(
			"Listo: ya están abiertas todas. Las eliges al empezar una carrera nueva, en TUS VENTAJAS."))
		return
	var r: Dictionary = Career.last_iap_receipt
	var lineas: PackedStringArray = PackedStringArray()
	if int(r.get("dinero", 0)) > 0:
		lineas.append(I18n.tf("Se sumaron ${0} a tu carrera.",
			[CareerUi.money(int(r["dinero"]))]))
	if int(r.get("puntos", 0)) > 0:
		lineas.append(I18n.tf("Tienes {0} puntos nuevos para repartir en TU JUGADOR.",
			[int(r["puntos"])]))
	for boot_id in r.get("botas", []):
		lineas.append(I18n.tf("{0} están en tu ropero con el 100% de vida.",
			[I18n.t(String(Shop.boots_by_id(String(boot_id))["name"]))]))
	for ed_id in r.get("ediciones", []):
		lineas.append(I18n.tf("Tus botas estrenan la {0}.",
			[I18n.t(String(Iap.edicion(String(ed_id)).get("name", "")))]))



	if int(r.get("xp", 0)) > 0:
		lineas.append(I18n.tf(
			"Ya lo tienes todo al máximo, así que los puntos entraron como {0} de experiencia.",
			[int(r["xp"])]))
	if lineas.is_empty():


		lineas.append(I18n.t(
			"Se registró tu compra. Si no ves lo que compraste, cierra y vuelve a abrir el juego."))




	_celebrar_caja(int(r.get("puntos", 0)), "\n".join(lineas), _caja_peso)











func _celebrar_caja(puntos: int, cuerpo: String, peso: float) -> void:
	if is_instance_valid(_header) and not Settings.reduce_motion:





		var dur: float = _header.celebrar_ingreso(_caja_dinero_antes, puntos, peso)
		await SceneFade.timer(dur + 0.25).timeout
		if not is_inside_tree():
			return
	_recibo_caja(puntos, cuerpo)







func _recibo_caja(puntos: int, cuerpo: String) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(CareerTheme.T_TITLE_MODAL, CareerTheme.TEXT)
	t.text = I18n.t("COMPRA LISTA")
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	var b: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
	b.text = cuerpo
	b.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	b.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(b)
	var volver: String = String(_caja_motivo.get("volver", ""))
	var texto: String = I18n.t("LISTO")
	var hacer: Callable = Callable()
	if puntos > 0 and not Career.skills_maxed():
		texto = I18n.t("REPARTIR PUNTOS")
		hacer = _on_tab.bind("juego")
	elif not volver.is_empty():
		texto = I18n.tf("VOLVER A {0}", [_rotulo_familia(volver)])
		hacer = _select_shop.bind(volver)
	var ok: Button = Button.new()
	ok.text = texto
	ok.custom_minimum_size = Vector2(0, CareerTheme.BTN_CTA_H)
	ok.clip_text = true
	CareerTheme.apply_button(ok, CareerTheme.Kind.PRIMARY, CareerTheme.BTN_ROW_FONT)
	var cerrar_y: Callable = func() -> void:
		CareerUi.close_modal(box)
		if hacer.is_valid():
			hacer.call()
	ok.pressed.connect(cerrar_y)
	box.add_child(ok)






func _buy(id: String, action: Callable) -> void:
	_shop_bought = id





	var antes: int = Career.money
	if not bool(action.call()):
		_shop_bought = ""
		return
	if is_instance_valid(_header):
		_header.celebrar_gasto(antes)


	if _shop_band != null and is_instance_valid(_shop_band) \
			and _shop_band.has_method("sync_career"):
		_shop_band.sync_career()










func _celebrate_purchase(card: Control, price: int) -> void:
	await get_tree().process_frame
	if not is_instance_valid(card) or not card.is_inside_tree():
		return
	card.pivot_offset = card.size * 0.5
	var big: bool = price >= 100000
	card.scale = Vector2(0.88, 0.88) if big else Vector2(0.96, 0.96)
	var t: Tween = card.create_tween()
	if big:
		card.modulate = Color(1.3, 1.22, 1.0)
		t.set_parallel(true)
		t.tween_property(card, "scale", Vector2.ONE, 0.5) \
				.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		t.tween_property(card, "modulate", Color.WHITE, 0.55) \
				.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	else:
		t.tween_property(card, "scale", Vector2.ONE, 0.3) \
				.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)


















