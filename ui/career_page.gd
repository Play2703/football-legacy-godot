		return
	_season_card_i = clampi(idx, 0, _season_cards.size() - 1)
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return



	box.alignment = BoxContainer.ALIGNMENT_BEGIN
	_season_card_box = box
	_render_season_card()





