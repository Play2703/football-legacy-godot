	var no: Button = Button.new()
	no.text = I18n.t("SEGUIR CON LOS MÍOS")
	no.custom_minimum_size = Vector2(0, 84)
	CareerTheme.apply_button(no, CareerTheme.Kind.GHOST, 24)
	no.pressed.connect(func() -> void: CareerUi.close_modal(box))



	no.set_meta(Entrada.PRIMERO_META, true)
	box.add_child(no)




const ESC_MARGEN: float = 4.0













func _seleccion_escalera(col: VBoxContainer, score: float, cut_squad: float,
		cut_starter: float, accent: Color) -> void:
	var lo: float = score
	var hi: float = score
	for v in [cut_squad, cut_starter]:
		if float(v) > 0.0:
			lo = minf(lo, float(v))
			hi = maxf(hi, float(v))
	lo -= ESC_MARGEN
	hi += ESC_MARGEN


	var span: float = maxf(hi - lo, 0.1)


	var fill: ColorRect = CareerUi.bar(col, accent)
	fill.anchor_right = clampf((score - lo) / span, 0.0, 1.0)
	var track: Control = fill.get_parent() as Control
	_esc_marca(track,(cut_squad - lo) / span, cut_squad > 0.0)
	_esc_marca(track,(cut_starter - lo) / span, cut_starter > 0.0)






	var pies: HFlowContainer = HFlowContainer.new()
	pies.add_theme_constant_override("h_separation", 8)
	pies.add_theme_constant_override("v_separation", 8)
	pies.alignment = FlowContainer.ALIGNMENT_CENTER
	col.add_child(pies)
	if cut_squad > 0.0:
		pies.add_child(CareerUi.label_chip(I18n.t("PARA ENTRAR"), "%.1f" % cut_squad,
			CareerTheme.TEXT_DIM))
	pies.add_child(CareerUi.label_chip(CareerTheme.caps(CareerUi.you_name()),
		"%.1f" % score, accent))
	if cut_starter > 0.0:
		pies.add_child(CareerUi.label_chip(I18n.t("PARA SER TITULAR"), "%.1f" % cut_starter,
			CareerTheme.TEXT_DIM))





func _esc_marca(track: Control, frac: float, visible_marca: bool) -> void:
	if not visible_marca:
		return
	var m: ColorRect = ColorRect.new()
	m.color = CareerTheme.TEXT
	m.anchor_left = clampf(frac, 0.0, 1.0)
	m.anchor_right = m.anchor_left
	m.anchor_top = 0.0
	m.anchor_bottom = 1.0
	m.offset_left = -1.0
	m.offset_right = 1.0
	m.offset_top = -5.0
	m.offset_bottom = 5.0
	track.add_child(m)







func _seleccion_debut_line() -> void:
	var d: Dictionary = Career.nat_debut


	if d.is_empty() or int(d.get("age", 0)) <= 0:
		return
	var rival: String = Nations.display_name(String(d.get("rival", "")))
	var text: String = I18n.tf("Debut: {0} años", [int(d.get("age", 0))])
	if not rival.is_empty():
		text += " · vs %s" % rival
		var tg: int = int(d.get("tg", -1))
		var rg: int = int(d.get("rg", -1))
		if tg >= 0 and rg >= 0:
			text += " (%d-%d)" % [tg, rg]
	text += " · " + I18n.tf("Temporada {0}", [int(d.get("season", 1))])

	if int(d.get("goals", 0)) > 0:
		text += " · " + I18n.t("marcaste")
	CareerUi.dim(_content, text)










