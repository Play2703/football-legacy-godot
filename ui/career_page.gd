func _torn_nat_torneo(proj: Dictionary, kind: String, nat_name: String,
		accent: Color) -> void:


	if bool(proj.get("live", false)):
		var st: Dictionary = proj["state"]
		if String(st.get("comp", "")) in ["wc", "cont"]:
			_seleccion_wc_live(st, nat_name)
		else:
			_seleccion_qual_live(st, nat_name)
			_torn_heroe_qual(_nat_live_rows(st.get("table", {}), nat_name))
	elif kind == "wc" or kind == "cont":






		_seleccion_pending(nat_name, String(proj["name"]))
		_torn_apunta_heroe("-", I18n.tf("{0} no está en {1}.", [nat_name,
			I18n.t(String(proj["name"]))]))
	else:
		_seleccion_qualifiers(proj.get("qual", {}), nat_name)
		_torn_heroe_qual((proj.get("qual", {}) as Dictionary).get("table", []))




	if (kind == "wc" or kind == "cont") and bool(proj.get("live", false)):
		var field: Array = NatTeam.world_cup_field(Career.nationality,
			NatTeam.wc_entry(Career.nationality, GameState.season_num,
				Career.nat_qualified), GameState.season_num) if kind == "wc" \
						else NatTeam.continental_field(Career.nationality, true, GameState.season_num)







		var raw_race: Array = Race.international(field, GameState.season_num, kind,
			Career.nationality)





		var npt: Array = _torn_nat_frac(proj.get("state", {}))
		var race: Array = Race.prorate(raw_race, int(npt[0]), int(npt[1])) \
				if int(npt[0]) > 0 else []
		var cell: Dictionary =(Career.season_nat_by_comp.get(kind, {}) as Dictionary)


		if not (race.is_empty() and UiKit.es_horizontal()):
			_torn_race_tables(race, true, float(int(cell.get("g", 0))),
				float(int(cell.get("a", 0))), Career.season_avg_year(), accent,
				Career.season_nat_apps(kind), Nations.canon_id(Career.nationality))
	else:






		var plazas: String = I18n.tf("Quedar entre los {0} primeros del grupo"
			+ " clasifica para {1}.",
			[NatTeam.qual_spots(Career.nationality,
					NatTeam.qual_target(GameState.season_num, Career.nationality)),
				I18n.t(NatTeam.qual_target_name(GameState.season_num,
					Career.nationality), "nat")])

		if not _torn_leyenda([{"color": accent, "texto": plazas}]):
			_torn_nota(plazas)




