	_fortuna_block()





	_club_goals_block()

	CareerUi.head(_content, I18n.t("OBJETIVO DE TEMPORADA"))




	CareerUi.dim(_content, I18n.tf("Te miden como {0}", [I18n.t(
		Standing.contract_role_name(Standing.contract_role_from_key(
			String(Career.contract.get("role", "rotacion")))))]))
	_objective_block()



	_perk_block()










	var reneg: Dictionary = Career.renegotiation_gate()
	var can_reneg: bool = not _reneg_oferta_viva().is_empty()






	var falta: Array = reneg.get("missing", []) as Array
	var gastada: bool = falta.has("cooldown") or falta.has("refused")
	if _renovacion_visible():
		CareerUi.head(_content, I18n.t("RENOVACIÓN"))
	elif can_reneg:
		CareerUi.head(_content, I18n.t("RENEGOCIAR"))
	elif int(Career.contract["seasons_left"]) > 1 and Career.loan.is_empty() \
			and not Career.free_agent and not bool(reneg["ok"]) \
			and String(reneg.get("why", "")) != "":
		CareerUi.head(_content, I18n.t("RENEGOCIAR"))









		if not gastada:


			CareerUi.dim(_content, I18n.t(String(reneg["why"])))

	var cta: Button = Button.new()


	cta.custom_minimum_size = Vector2(0, CareerTheme.BTN_CTA_H)
	if Career.can_renew():


		cta.text = I18n.t("RENOVAR EN AGENTE")
		CareerTheme.apply_button(cta, CareerTheme.Kind.PRIMARY, CareerTheme.BTN_CTA_FONT)
		cta.pressed.connect(func() -> void: _on_tab("mercado"))
	elif can_reneg:

		cta.text = I18n.t("RENEGOCIAR EN AGENTE")
		CareerTheme.apply_button(cta, CareerTheme.Kind.PRIMARY, CareerTheme.BTN_CTA_FONT)
		cta.pressed.connect(func() -> void: _on_tab("mercado"))
	else:


		cta.disabled = true
		CareerTheme.apply_button(cta, CareerTheme.Kind.NEUTRAL, CareerTheme.BTN_CTA_FONT)



		if Career.on_loan():


			cta.text = I18n.t("CEDIDO · NO SE RENUEVA")
		elif Career.concurso_tuyo():


			cta.text = I18n.t("CONTRATOS CONGELADOS")
		elif gastada:




			cta.text = I18n.t("EL AÑO QUE VIENE")
		elif int(Career.contract["seasons_left"]) > 1:
			cta.text = I18n.t("SOLO EN TU ÚLTIMO AÑO")
		else:
			cta.text = I18n.t("EL TÉCNICO NO RENUEVA")
	cta.clip_text = true
	cta.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS

	_dock_add(cta)









	if Career.descartado():
