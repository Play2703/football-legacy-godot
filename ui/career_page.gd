func _torn_previa_camino(cam: Dictionary) -> PanelContainer:
	var pasos: Array = cam["pasos"]
	var grande: bool = pasos.size() <= 3
	var comp_lp: String = String(CLUB_GOAL_BRAND.get(String((pasos[-1] as Dictionary).get("comp",
		cam["comp"])), ""))
	var p: PanelContainer = _pa_t_superficie("CaminoPrevia", 28.0 if grande else 18.0)
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 18)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	p.add_child(v)
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 14)
	cab.mouse_filter = Control.MOUSE_FILTER_IGNORE
	cab.add_child(_torn_previa_trofeo(comp_lp, 40.0))
	var titulo: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT,
		I18n.t("CAMINO A LA FASE DE LIGA"))
	titulo.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	titulo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	cab.add_child(titulo)
	v.add_child(cab)



	var nodos: HBoxContainer = HBoxContainer.new()
	nodos.name = "Nodos"
	nodos.add_theme_constant_override("separation", 12)
	nodos.mouse_filter = Control.MOUSE_FILTER_IGNORE
	nodos.draw.connect(func() -> void:
		if nodos.get_child_count() < 2:
			return
		var a: Control = nodos.get_child(0)
		var b: Control = nodos.get_child(nodos.get_child_count() - 1)
		var x0: float = a.position.x + a.size.x * 0.5
		var x1: float = b.position.x + b.size.x * 0.5
		nodos.draw_rect(Rect2(x0, nodos.size.y * 0.5 - 3.0, x1 - x0, 6.0), CareerTheme.SURFACE_LINE))
	nodos.sort_children.connect(nodos.queue_redraw)
	v.add_child(nodos)
	var cols: HBoxContainer = HBoxContainer.new()
	cols.name = "Tarjetas"
	cols.add_theme_constant_override("separation", 12)
	cols.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(cols)
	for paso in pasos:
		var comp_v: String = String(CLUB_GOAL_BRAND.get(String((paso as Dictionary).get("comp",
			cam["comp"])), comp_lp))
		nodos.add_child(_torn_previa_nodo(paso, comp_v))
		var col: VBoxContainer = VBoxContainer.new()
		col.add_theme_constant_override("separation", 12)
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		col.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(_torn_previa_tarjeta(paso, comp_v, grande))
		if String(paso["ronda"]) != "LP":
			col.add_child(_torn_previa_cae(paso.get("cae", {}), 32.0 if grande else 28.0,
				CareerTheme.T_DIM if grande else CareerTheme.T_CAPTION))
		cols.add_child(col)
	v.add_child(_mk_t_label(CareerTheme.T_DIM, CareerTheme.DANGER, I18n.t("SI PIERDES")))
	v.add_child(_mk_t_label(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM,
		I18n.t("DESDE LA FASE DE LIGA YA NO SE BAJA")))
	return p




func _torn_previa_nodo(paso: Dictionary, comp_v: String) -> CenterContainer:
	var lp: bool = String(paso["ronda"]) == "LP"
	var actual: bool = bool(paso.get("actual", false))
	var color: Color = Competitions.COMP_ACCENT.get(comp_v, CareerTheme.TEXT)
	var lado: float = 72.0 if lp else (68.0 if actual else 60.0)
	var c: PanelContainer = PanelContainer.new()
	c.name = "Nodo"
	c.custom_minimum_size = Vector2(lado, lado)
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = color if actual and not lp else CareerTheme.SURFACE_HI
	sb.border_color = color if lp else (CareerTheme.TEXT if actual else CareerTheme.SURFACE_LINE)
	sb.set_border_width_all(4 if actual and not lp else 3)
	sb.set_corner_radius_all(int(lado * 0.5))
	c.add_theme_stylebox_override("panel", sb)
	if lp:
		var t: TrophyIcon = _torn_previa_trofeo(comp_v, 48.0)
		t.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		c.add_child(t)
	else:
		var l: Label = _mk_t_label(22 if actual else 20,
			CareerTheme.on_color(color) if actual else CareerTheme.TEXT_MID,
			CareerUi.ronda_previa(String(paso["ronda"])), false)
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		c.add_child(l)
	var cc: CenterContainer = CenterContainer.new()
	cc.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cc.mouse_filter = Control.MOUSE_FILTER_IGNORE
	cc.add_child(c)
	return cc





func _torn_previa_tarjeta(paso: Dictionary, comp_v: String, grande: bool) -> PanelContainer:
	var ronda: String = String(paso["ronda"])
	var lp: bool = ronda == "LP"
	var t: PanelContainer = PanelContainer.new()
	t.name = "Tarjeta"
	t.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = CareerTheme.SURFACE_HI
	sb.set_corner_radius_all(6)
	if bool(paso.get("actual", false)):
		sb.border_color = Competitions.COMP_ACCENT.get(comp_v, CareerTheme.TEXT)
		sb.set_border_width_all(3)
	sb.content_margin_left = 12.0
	sb.content_margin_right = 12.0
	sb.content_margin_top = 16.0
	sb.content_margin_bottom = 16.0
	t.add_theme_stylebox_override("panel", sb)
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 10)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	t.add_child(v)
	var rot: String = CareerUi.ronda_rotulo(ronda)
	var via: String = String(paso.get("via", ""))
	if not lp and ronda != "PO" and not via.is_empty():
		rot += " · " + I18n.t("VÍA DE CAMPEONES" if via == "campeones" else "VÍA DE LIGA")
	v.add_child(_torn_previa_centrada(CareerTheme.T_DIM, CareerTheme.TEXT_DIM, rot, [18, 16]))
	if lp:
		var fila: HBoxContainer = _torn_previa_fila(0)
		fila.add_child(_torn_previa_trofeo(comp_v, 72.0 if grande else 56.0))
		v.add_child(fila)

		v.add_child(_torn_previa_centrada(CareerTheme.T_CAPTION, CareerTheme.TEXT_MID,
			I18n.tf("{0} PARTIDOS", [6 if comp_v == "conference" else 8])))
		var s: Array = paso.get("sorteo", [])
		if s.size() == 2:
			v.add_child(_torn_previa_centrada(CareerTheme.T_DIM, CareerTheme.TEXT,
				I18n.tf("SORTEO {0}", [_torn_previa_dia(s)]), [18, 16]))
		return t
	var rival: String = String(paso.get("rival", ""))
	if not rival.is_empty():
		var fila: HBoxContainer = _torn_previa_fila(14 if grande else 8)
		fila.add_child(_torn_escudo(rival, 72.0 if grande else 48.0))
		var sig: Label = _mk_t_label(30 if grande else 20, CareerTheme.TEXT, _torn_sigla_de(rival), false)
		sig.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		fila.add_child(sig)
		v.add_child(fila)
		v.add_child(_torn_previa_centrada(CareerTheme.T_CAPTION, CareerTheme.TEXT_MID,
			_torn_nombre_de(rival)))
	else:
		var gan: Array = paso.get("ganador_de", [])
		var de: Array = gan if not gan.is_empty() else paso.get("perdedor_de", [])
		v.add_child(_torn_previa_centrada(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM,
			I18n.t("GANADOR DE" if not gan.is_empty() else "PERDEDOR DE")))
		if de.size() == 2:
			var fila: HBoxContainer = _torn_previa_fila(10 if grande else 6)
			for j in 2:
				var club: String = String(de[j])

				if j == 1:
					fila.add_child(_mk_t_label(20 if grande else 16, CareerTheme.TEXT_DIM, "·", false))
				if j == 0:
					fila.add_child(_torn_escudo(club, 44.0 if grande else 36.0))
				if grande:
					var sl: Label = _mk_t_label(20, CareerTheme.TEXT, _torn_sigla_de(club), false)
					sl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
					fila.add_child(sl)
				if j == 1:
					fila.add_child(_torn_escudo(club, 44.0 if grande else 36.0))
			v.add_child(fila)
	var ida: Array = paso.get("ida", [])
	var vuelta: Array = paso.get("vuelta", [])
	if ida.size() == 2:
		v.add_child(_torn_previa_centrada(CareerTheme.T_DIM, CareerTheme.TEXT,
			I18n.tf("IDA {0}", [_torn_previa_dia(ida)]), [18, 16]))
	if vuelta.size() == 2:
		v.add_child(_torn_previa_centrada(CareerTheme.T_DIM, CareerTheme.TEXT_MID,
			I18n.tf("VUELTA {0}", [_torn_previa_dia(vuelta)]), [18, 16]))
	return t




