func _to_t_datos_liga() -> void:
	_to_t_mine = _torn_country == Teams.country_of(GameState.player_team_id) \
			and _torn_div == GameState.player_div()
	_to_t_vista = -1
	if Liguilla.aplica(_torn_country, _torn_div) and (not _to_t_mine or GameState.torneos_activos()):
		_to_t_vista = _torn_vista_de(_to_t_mine)
	var datos: Dictionary = _torn_filas_liga(_to_t_mine, _to_t_vista)
	_to_t_filas = datos["filas"]
	_to_t_aviso = String(datos["aviso"])
	var zones: Dictionary = _torn_zones(_torn_country, _torn_div, _to_t_filas.size(), _to_t_vista)
	_to_t_franjas = []
	_to_t_zonas = []
	_to_t_zonas_d = []
	_to_t_tu = -1
	for i in _to_t_filas.size():
		var z: Dictionary = zones.get(i + 1, {})
		_to_t_franjas.append(z.get("color", Color.TRANSPARENT))
		_to_t_zonas.append(String(z.get("label", "")))
		_to_t_zonas_d.append(z)
		if bool((_to_t_filas[i] as Dictionary)["tuya"]):
			_to_t_tu = i
	var firma: String = "%s|%d|%d" % [_torn_country, _torn_div, _to_t_vista]
	if firma != _to_t_firma or _to_t_sel >= _to_t_filas.size():
		_to_t_sel = maxi(_to_t_tu, 0)
	_to_t_firma = firma



