func _chico_vivo(pt: Array) -> Array:
	if int(pt[0]) <= 0:
		return []
	var div_hoy: int = GameState.div_of(GameState.player_team_id)
	var you: Dictionary = Career.ballon_year(
		Teams.country_of(GameState.player_team_id), div_hoy)
	you.merge({
		"name": Career.player_name,
		"team": GameState.player_team_id,
		"div": div_hoy,
		"age": Career.age,
		"titles": [], "awards": [],
	})
	var ck: String = "%d|%d" % [GameState.season_num, int(pt[0])]
	if String(_chico_live_cache.get("key", "")) != ck:
		var lote: Dictionary = {}
		var temporada: int = GameState.season_num
		_chico_live_cache = {"key": ck, "board": BallonDor.chico_live(temporada, you,
			int(pt[0]), int(pt[1]), func(nombre: String, club: String) -> int:
				return Career._edad_de_ficha(nombre, club, temporada, lote))}
	return _chico_live_cache["board"]




