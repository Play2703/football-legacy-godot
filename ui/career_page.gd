	return CareerTheme.NAV_MUNDO





func _ft_mas_caro() -> Dictionary:
	var mejor: Dictionary = {}
	for m in Career.market_news:
		var d: Dictionary = m
		if String(d.get("kind", "")) != "signing" or bool(d.get("free", false)) \
				or int(d.get("fee", 0)) <= 0 or not _ft_de_temporada(d) \
				or not _news_in_scope(d, _news_scope):
			continue
		if mejor.is_empty() or int(d.get("fee", 0)) > int(mejor.get("fee", 0)):
			mejor = d
	return mejor





