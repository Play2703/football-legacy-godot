func _balon_gala_lista(parent: VBoxContainer, gala: Dictionary, tumbado: bool) -> void:
	var season: int = int(gala.get("season", -1))
	var chico: Dictionary = gala.get("chico", {}) as Dictionary
	var claves: Array[String] = ["votacion"]
	if not (chico.get("podium", []) as Array).is_empty():
		claves.append("chico")
	if not (Career.once_of(season).get("xi", []) as Array).is_empty():
		claves.append("once")
	if not claves.has(_balon_ver):
		_balon_ver = "votacion"
	if claves.size() > 1:
		var al_tocar: Callable = func(i: int) -> void:
			_balon_ver = claves[i]
			_refresh()
		var activa: int = claves.find(_balon_ver)
		if tumbado:
			var opciones: Array = []
			for k in claves:
				match k:
					"chico":
						var ic: TrophyIcon = TrophyIcon.new()
						ic.set_type("chico_oro")
						opciones.append({"rotulo": I18n.t("CHICO DE ORO"), "icono": ic})
					"once":
						opciones.append({"rotulo": I18n.t("ONCE IDEAL"), "icono": "once"})
					_:
						opciones.append({"rotulo": I18n.t("VOTACIÓN"), "icono": "stats"})
			parent.add_child(CareerUi.segmentado(opciones, activa, al_tocar))
		else:
			var rotulos: Array = []
			for k in claves:
				rotulos.append(I18n.t({"chico": "CHICO DE ORO", "once": "ONCE IDEAL"}.get(k,
					"VOTACIÓN")))
			parent.add_child(CareerUi.segmented(rotulos, activa, al_tocar, 0.0, BALON_ANCHO_PIE))
	if _balon_ver == "once":
		_balon_once(parent, season, tumbado)
		return
	var fuente: Dictionary = chico if _balon_ver == "chico" else gala
	var podium: Array = fuente.get("podium", [])
	var filas: Array = []
	for i in podium.size():
		filas.append({"puesto": i + 1, "e": podium[i]})

	var cola: Array = []
	var rank: int = int(fuente.get("you_rank", 0))
	if rank > podium.size() and not (fuente.get("you_card", {}) as Dictionary).is_empty():
		cola.append({"puesto": rank, "e": fuente.get("you_card", {})})
	filas = _balon_con_cola(filas, cola, BALON_TOPE_VOTO if tumbado else 0)
	if not filas.is_empty():
		_balon_lista(parent, filas, 56.0 if tumbado else 64.0)





