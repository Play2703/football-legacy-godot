func _wnews_identidad(f: Dictionary, portada: bool, lado: float = -1.0) -> Array:
	var kind: String = str(f.get("kind", ""))
	var club: String = str(f.get("club", ""))
	var px: float = lado if lado > 0.0 else (WNEWS_CREST_LEAD if portada else WNEWS_CREST)








