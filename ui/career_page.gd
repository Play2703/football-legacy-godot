func _torn_copa_retrato(cup: Dictionary, accent: Color, comp: String = "cup") -> void:



	var pais: String = Teams.country_of(GameState.player_team_id)
	var tipo: String = "copaliga" if comp == CopaLiga.COMP else "copa"
	var titulo: String = Competitions.trofeo_nombre(tipo, pais)
	if titulo == Competitions.comp_name("copa"):
		titulo = "COPA NACIONAL"

	var ligas: bool = comp == CopaLigas.COMP
	if ligas:
		titulo = CopaLigas.NOMBRE
	_torn_head(I18n.t(titulo), accent)
	var pat: String = "" if ligas else Competitions.trofeo_patrocinador(tipo, pais)
	if not pat.is_empty():


		var nota_pat: Label = _torn_nota(I18n.tf("Patrocinador: {0}", [pat]))
		nota_pat.autowrap_mode = TextServer.AUTOWRAP_OFF
		nota_pat.clip_text = true
	if cup.is_empty():
		_torn_nota(I18n.t("Aún no arranca."))
		return






	if UiKit.es_horizontal():
		_torn_head(I18n.t("CUADRO"), accent, true)
	_full_bracket(cup.get("bracket", []), cup.get("names", []), accent)
	_club_verdict(bool(cup.get("alive", true)), bool(cup.get("champion", false)),
		I18n.t("¡CAMPEÓN DE LA COPA DE LAS LIGAS!") if ligas else I18n.t("¡CAMPEÓN DE COPA!"),
		I18n.t("Eliminado de la Copa de las Ligas") if ligas else I18n.t("Eliminado de la Copa"))




func _torn_juegas_ligas() -> bool:
	var st: Dictionary = GameState.ligas_state
	if int(st.get("season", -1)) != GameState.season_num:
		return false
	return CopaLigas.siembra(GameState.player_team_id, st.get("mls", []), st.get("mx", [])) > 0










func _torn_ligas_copa() -> Dictionary:
	var st: Dictionary = GameState.ligas_state
	var mls: Array = st.get("mls", [])
	var mx: Array = st.get("mx", [])
	var clubes: int = CopaLigas.llaves(mls, mx).size()
	if clubes == 0:
		return {}
	var c: Dictionary = CopaLigas.cuadro_de(mls, mx, int(st.get("season", GameState.season_num)),
		GameState.player_team_id, st.get("ganadores", {}))
	var jugadas: int = _torn_ligas_jugadas()
	var bracket: Array = []
	var names: Array = []
	for r in CopaLigas.RONDAS.size():
		var ronda: String = String(CopaLigas.RONDAS[r][0])
		names.append(CopaLigas.FINAL_NOMBRE if ronda == "Final" else ronda)
		if r > jugadas:
			continue
		var cruces: Array = []
		for n in clubes>>(r + 1):
			var t: Dictionary = c.get(CopaLigas.cruce_id(ronda, n), {})
			if t.is_empty():
				continue
			var tie: Dictionary = {"a": String(t["a"]), "b": String(t["b"]), "winner": ""}
			if r < jugadas:
				tie["winner"] = String(t["winner"])
				_torn_ligas_marcador(tie, ronda)
			cruces.append(tie)
		bracket.append(cruces)


	var ganadas: int = int(st.get("idx", 0)) -(0 if bool(st.get("alive", true)) else 1)
	return {"bracket": bracket, "names": names, "idx": maxi(ganadas, 0),
		"alive": bool(st.get("alive", true)), "champion": bool(st.get("champion", false))}







func _torn_ligas_jugadas() -> int:
	var hechas: int = int(GameState.ligas_state.get("idx", 0))
	var n: int = 0
	while n < CopaLigas.RONDAS.size():
		var k: int = _torn_ligas_fecha(n)
		if n >= hechas and (k < 0 or k >= GameState.season_day):
			break
		n += 1
	return n





func _torn_ligas_fecha(r: int) -> int:
	if r < 0 or r >= CopaLigas.RONDAS.size():
		return -1
	var ronda: String = String(CopaLigas.RONDAS[r][0])
	for k in GameState.calendar.size():
		var f: Dictionary = GameState.calendar[k]
		if String(f.get("comp", "")) == CopaLigas.COMP and String(f.get("round", "")) == ronda:
			return k
	return -1





func _torn_ligas_marcador(tie: Dictionary, ronda: String) -> void:
	var a: String = String(tie["a"])
	var b: String = String(tie["b"])
	var yo: String = GameState.player_team_id
	if a != yo and b != yo:
		return
	for res in GameState.ligas_state.get("results", []):
		var d: Dictionary = res
		if String(d.get("round", "")) != ronda or String(d.get("opp", "")) !=(b if a == yo else a):
			continue
		var gf: int = int(d.get("gf", 0))
		var gc: int = int(d.get("gc", 0))
		tie["score"] = "%d-%d" %([gf, gc] if a == yo else [gc, gf])
		if gf == gc:
			tie["pens"] = String(tie["winner"])
		return



