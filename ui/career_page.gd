func _cal_proyecta_baja(filas: Array) -> void:
	if Career.injury_weeks <= 0:
		return
	var semanas: int = Career.injury_weeks
	var dias: int = Career.injury_dias
	var primero: bool = true
	for f in filas:
		if bool(f["jugado"]):
			continue
		if not primero:
			var r: Dictionary = Career.reloj_baja(semanas, dias,
				Career.dias_de_reloj(float(f["descanso"])))
			semanas -= int(r["semanas"])
			dias = int(r["dias"])
		if semanas <= 0:
			f["baja"] = "ALTA"
			break
		if not (primero and Career.has_match_fx("play_hurt")):
			f["baja"] = "BAJA"
		primero = false





