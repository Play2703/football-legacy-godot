const LEY_MARK_NONE: int = 0
const LEY_MARK_PASSED: int = 1
const LEY_MARK_OVERTAKEN: int = 2













func _ley_mark(e: Dictionary, theirs: int, ref: int, pass_kind: String = "") -> int:
	if bool(e.get("user", false)) or ref <= 0:
		return LEY_MARK_NONE
	if theirs < ref:
		return LEY_MARK_PASSED
	if theirs > ref and not pass_kind.is_empty() \
			and Career.legend_was_passed(pass_kind, Legends.key_of(e)):
		return LEY_MARK_OVERTAKEN
	return LEY_MARK_NONE




func _legend_passed_chip(mark: int, size_px: int = 13) -> Control:
	if mark == LEY_MARK_NONE:
		return null
	var col: Color = CareerTheme.MONEY if mark == LEY_MARK_PASSED else CareerTheme.DANGER
	var chip: PanelContainer = PanelContainer.new()
	chip.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = Color(col.r, col.g, col.b, 0.18)
	sb.set_corner_radius_all(4)
	sb.content_margin_left = 6
	sb.content_margin_right = 6
	sb.content_margin_top = 2
	sb.content_margin_bottom = 2
	chip.add_theme_stylebox_override("panel", sb)
	var l: Label = CareerUi.plain(size_px, col)
	l.text = I18n.t("SUPERADA") if mark == LEY_MARK_PASSED else I18n.t("TE ADELANTÓ")
	chip.add_child(l)
	return chip



