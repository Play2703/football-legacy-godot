	b.clip_contents = true
	b.set_meta("ti_t_celda", id)
	b.focus_entered.connect(func() -> void: _ti_t_elige(j, false))
	CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, CareerTheme.T_LEE_TUMBADO)
	var sb: StyleBoxFlat = b.get_theme_stylebox("normal").duplicate() as StyleBoxFlat
	if sb != null:
		b.add_theme_stylebox_override("normal", sb)
		b.set_meta("sb", sb)
