func _torn_nat_hoja_apoyo(pa: Dictionary, cu: Dictionary, n: Dictionary, accent: Color) -> void:
	var apoyo: VBoxContainer = pa["apoyo"]
	var box: VBoxContainer = pa["modal"]
	var heroe: PanelContainer = _torn_nat_hoja_heroe(cu, n, float(pa["ancho_apoyo"]))
	apoyo.add_child(heroe)
	var junta: Dictionary = {"junta": false}
	var bs: Array[Button] = []
	var tipo_1: String = "internacional" if Career.nat_caps > 0 else "mundial"
	var b1: Button = null
	if Career.nat_caps > 0:
		b1 = CareerUi.baldosa_avance("seleccion", I18n.t("INTERNACIONAL"), accent, null,

			I18n.tf("{0} PARTIDOS", [Career.nat_caps]), str(Career.nat_goals), I18n.t("GOLES"),
			_torn_nat_modal_internacional.bind(junta))
	else:


		var m: Array = _torn_nat_mundial()
		b1 = CareerUi.baldosa_avance("mundo", I18n.t("MUNDIAL"), accent, null,
			String(m[0][1]), str(int(m[2])), I18n.t("AÑOS"),
			_torn_nat_modal_internacional.bind(junta))
	if b1 != null:
		b1.set_meta("torn_nat_baldosa", tipo_1)
		bs.append(b1)
	var rows: Array = Legends.for_nation(Career.nationality)

	if not rows.is_empty() and not _torn_nat_lista_en_hoja():
		var lider: Dictionary = rows[0]


		var tu: String = I18n.t("GOLES")
		for i in rows.size():
			if bool((rows[i] as Dictionary).get("user", false)) and _torn_nat_puesto_sabido(rows, i):
				tu = I18n.tf("TÚ {0}", [_ordinal(i + 1)])
		var bg: Button = CareerUi.baldosa_avance("balon_rol", I18n.t("GOLEADORES"), accent, null,

			CareerUi.surname(CareerUi.display_name(String(lider.get("name", "")))),
			str(int(lider.get("goals", 0))),
			tu, _torn_nat_modal_goleadores)
		bg.set_meta("torn_nat_baldosa", "goleadores")
		bg.set_meta("fl_lista_entera", true)
		bs.append(bg)
	if not Career.nat_history.is_empty():
		if _torn_nat_hoja_caben(box, heroe, bs.size() + 1):
			var titulos: int = 0
			for h in Career.nat_history:
				if _torn_nat_es_titulo(h as Dictionary):
					titulos += 1
			var bh: Button = CareerUi.baldosa_avance("palmares", I18n.t("HISTORIAL"), accent, null,
				I18n.tf("{0} TEMPORADAS", [Career.nat_history.size()]),
				str(titulos), I18n.t("TÍTULOS"),
				_torn_nat_historial_modal)
			bh.set_meta("torn_nat_baldosa", "historial")
			bs.append(bh)
		else:
			junta["junta"] = true
	for b in bs:
		apoyo.add_child(b)
	CareerUi.baldosas_avance_juntas(bs)
	var cta: Button = CareerUi.accion("once", I18n.t("VER CONVOCATORIA"), CareerTheme.NAV_PLANTILLA)
	cta.custom_minimum_size.y = CareerTheme.TOQUE_PRINCIPAL_TUMBADO
	cta.focus_mode = Control.FOCUS_ALL
	cta.set_meta("fl_principal", true)
	cta.set_meta("torn_nat_cta", true)
	cta.pressed.connect(func() -> void:
		CareerUi.close_modal(box)
		_torn_nat_a_convocatoria())
	(pa["cta"] as VBoxContainer).add_child(cta)




