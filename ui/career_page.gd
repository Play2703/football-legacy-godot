func _loan_cifras(offer: Dictionary) -> Array:
	var pos: String = String(offer.get("pos", ""))
	if pos.is_empty():
		pos = Career.puesto_hoy()
	var items: Array = [
		[I18n.t("Jugarías de"), CareerUi.pos_rotulo(pos), CareerUi.pos_color(pos)],
		[I18n.t("Vuelves en"), CareerTheme.caps(I18n.t("FIN DE TEMPORADA")),
			CareerTheme.TEXT],
	]
	var fee: int = int(offer.get("buy_fee", 0))
	if fee > 0:
		items.append([I18n.t("Opción de compra"), "$" + CareerUi.money(fee),
			CareerTheme.MONEY])
	else:
		items.append([I18n.t("Opción de compra"),
			CareerTheme.caps(I18n.t("SIN OPCIÓN")), CareerTheme.TEXT_DIM])
	if Career.age <= Market.LOAN_DEV_AGE:
		items.append([I18n.t("Creces"),
			"+%d%%" % roundi((Career.LOAN_DEV_XP_MULT - 1.0) * 100.0),
			CareerTheme.accent_text()])
	return items





