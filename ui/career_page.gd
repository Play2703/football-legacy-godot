func _negociar_club(parent: Container) -> void:
	if Career.club_pulse_taken():
		CareerUi.dim(parent, I18n.t("Ya negociaste tu ficha esta temporada."))
	elif bool(Career.club_pulse_bounds().get("ok", false)):
		parent.add_child(_boton_mesa("moneda", I18n.t("NEGOCIAR MI SUELDO"), CareerTheme.MONEY, 84,
			func() -> void: _go_club_pulse()))
	var cl: Dictionary = Career.clausulas_mesa_club(_renewal_pack)
	if bool(cl.get("ok", false)):
		parent.add_child(_boton_mesa("contrato_firma", I18n.t("NEGOCIAR CLÁUSULAS"),
			CareerTheme.NAV_YO, 84,
			func() -> void: _abrir_clausulas_club()))
	elif String(cl.get("why", "")) == "YA NEGOCIASTE ESTE AÑO":
		CareerUi.dim(parent, I18n.t("Ya negociaste tus cláusulas esta temporada."))







func _boton_mesa(icono: String, texto: String, color: Color, alto: int,
		accion: Callable) -> Button:
