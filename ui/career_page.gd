func _mt_heroe() -> VBoxContainer:
	var cifra: String = ""
	var linea: String = ""
	var col: Color = CareerTheme.TEXT
	if Career.on_loan():
		var dueno: Dictionary = Teams.by_id(String(Career.loan.get("parent", "")))
		cifra = I18n.tf("{0} J", [maxi(GameState.calendar.size() - GameState.season_day, 0)])
		linea = "%s · %s" % [I18n.t("VUELVES"), String(dueno.get("name", ""))]
	elif Career.free_agent:
		cifra = I18n.t("SIN CLUB")
		linea = I18n.t("ERES AGENTE LIBRE")
	else:
		var wd: int = GameState.winter_day()
		var cal: int = GameState.calendar.size()
		var left: int = Career.market_days_left()
		var falta: int = Career.market_days_until_open()
		var reloj: String = ""
		if left > 0:
			cifra = I18n.t("HOY") if left == 1 else I18n.tf("{0} J", [left])
			reloj = _reloj_cap(I18n.t("CIERRA"), Market.window_last_day(GameState.season_day, wd),
				wd, cal)
		else:
			cifra = I18n.tf("{0} J", [falta]) if falta > 0 else I18n.t("EL AÑO QUE VIENE")
			reloj = _reloj_cap(I18n.t("ABRE"), GameState.season_day + falta if falta > 0 else -1,
				wd, cal)


		linea = "%s · %s" % [I18n.t("MERCADO ABIERTO" if left > 0 else "MERCADO CERRADO"),
			reloj.replace(" · ", " ")]
		col = CareerTheme.accent() if Career.market_open() else CareerTheme.TEXT_MID
	var h: VBoxContainer = CareerUi.heroe(cifra, linea)
	(h.get_meta("heroe_cifra") as Label).add_theme_color_override("font_color", col)
	return h




