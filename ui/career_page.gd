func _casa_tope_y() -> int:
	if _scroll == null or _casa_tabs_row == null or not is_instance_valid(_casa_tabs_row):
		return 0
	return maxi(0, _scroll.scroll_vertical + int(_casa_tabs_row.get_global_rect().position.y
		- _scroll.get_global_rect().position.y) - 8)












func _casa_pin_armar(secciones: Array, ids: Array, hay_nuevos: bool) -> void:
	if _scroll == null or not (_scroll.get_parent() is Control):
		return
	var capa: VBoxContainer = VBoxContainer.new()
	capa.name = "CasaPin"
	capa.mouse_filter = Control.MOUSE_FILTER_IGNORE
	capa.visible = false
	(_scroll.get_parent() as Control).add_child(capa)
	_casa_pin = capa
	var placa: PanelContainer = PanelContainer.new()
	var sb: StyleBoxFlat = CareerTheme.plate()
	sb.set_content_margin_all(12.0)


	sb.bg_color.a = 1.0
	placa.add_theme_stylebox_override("panel", sb)
	placa.mouse_filter = Control.MOUSE_FILTER_STOP
	capa.add_child(placa)
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 8)
	placa.add_child(col)


	var tabs: GridContainer = CareerUi.tile_tabs(col, secciones, ids.find(_casa_seccion),
		func(i: int) -> void: _casa_ir(String(ids[i]), -1, true), secciones.size(), true)
	if hay_nuevos and ids.has("muebles"):
		CareerUi.punto_nuevo(tabs.get_child(ids.find("muebles")) as Control)
	if not _casa_cajon_rotulos.is_empty():
		var fila: ScrollContainer = CareerUi.tile_chips_row(col, _casa_cajon_fichas,
			_casa_cajon, func(i: int) -> void: _casa_ir(_casa_seccion, i, true))
		var chips: Node = fila.get_child(0)
		for k in _casa_cajon_puntos:
			if int(k) < chips.get_child_count():
				CareerUi.punto_nuevo(chips.get_child(int(k)) as Control)
	CareerUi.normalize_caps(capa)
	var barra: VScrollBar = _scroll.get_v_scroll_bar()
	if not barra.value_changed.is_connected(_casa_pin_mira):
		barra.value_changed.connect(_casa_pin_mira)
	_casa_pin_mira.call_deferred(0.0)





func _casa_pin_mira(_v: float) -> void:
	if _casa_pin == null or not is_instance_valid(_casa_pin):
		return
	var fin: Control = _casa_nav_fin
	if _page != "casa" or _scroll == null or fin == null or not is_instance_valid(fin) \
			or _scroll.get_child_count() == 0:
		_casa_pin.visible = false
		return





	var hoja: Control = _scroll.get_child(0) as Control
	var fondo: float = fin.get_global_rect().end.y - hoja.get_global_rect().position.y
	_casa_pin.visible = fondo < float(_scroll.scroll_vertical)








func _casa_nuevos(extras: Array) -> Array:
