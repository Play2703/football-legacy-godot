		var w: float = chip.size.x
		var h: float = chip.size.y
		var muro: Color = pal.get("wall", base.get("wall", CareerTheme.TEXT))
		var mad: Color = pal.get("wood", base.get("wood", CareerTheme.TEXT))
		var tela: Color = pal.get("fabric", base.get("fabric", CareerTheme.TEXT))
		chip.draw_rect(Rect2(0, 0, w, h), muro)
		chip.draw_rect(Rect2(0, h * 0.62, w, h * 0.38), mad)
		chip.draw_rect(Rect2(w * 0.52, h * 0.1, w * 0.38, h * 0.34), tela)


		chip.draw_rect(Rect2(0, 0, w, h),
			Color(CareerTheme.TEXT.r, CareerTheme.TEXT.g, CareerTheme.TEXT.b, 0.35),
			false, 2.0))
	return chip
















