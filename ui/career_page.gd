func _open_name_editor() -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	CareerUi.head(box, I18n.t("TU NOMBRE"))
	var nombre: LineEdit = CareerUi.campo(Career.player_name, Career.NOMBRE_TECLEO,
		I18n.t("TU NOMBRE"))
	box.add_child(nombre)
	CareerUi.head(box, I18n.t("NOMBRE EN LA ESPALDA"))
	var espalda: LineEdit = CareerUi.campo(Career.nombre_espalda(), Career.ESPALDA_MAX,
		Career.espalda_auto())
	box.add_child(espalda)
	var guarda: Callable = func() -> void:
		if nombre.text == Career.player_name \
				and espalda.text.strip_edges().to_upper() == Career.nombre_espalda():
			return
		Career.rename_player(nombre.text, espalda.text)



		if nombre.text != Career.player_name:
			nombre.text = Career.player_name
			nombre.caret_column = nombre.text.length()
		if espalda.text != Career.nombre_espalda():
			espalda.text = Career.nombre_espalda()
			espalda.caret_column = espalda.text.length()
		espalda.placeholder_text = Career.espalda_auto()



		_look_name_sync.call_deferred()
		_header_tras_renombrarte.call_deferred()
	for e: LineEdit in [nombre, espalda]:
		e.text_submitted.connect(func(_t: String) -> void: guarda.call())
		e.focus_exited.connect(guarda)
		e.tree_exiting.connect(func() -> void:
			if e.has_focus():
				e.release_focus())
	box.tree_exiting.connect(guarda)
	var ok: Button = CareerUi.primary_cta(I18n.t("GUARDAR"), func() -> void:
		nombre.release_focus()
		espalda.release_focus()
		guarda.call()
		CareerUi.close_modal(box))
	box.add_child(ok)




