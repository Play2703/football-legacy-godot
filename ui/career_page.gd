func _gerencia_peldano_block() -> void:
	var v: Dictionary = Career.peldano_vista()
	if v.is_empty():
		return
	var n: int = int(v["n"])
	CareerUi.head(_content, I18n.t("TU NIVEL EN EL CLUB"))
	var col: VBoxContainer = _peldano_placa()
	col.add_child(_peldano_escalera(n))
	col.add_child(_peldano_titular(v))
	_peldano_progreso(col, v)






	if UiKit.es_horizontal():
		col = _peldano_placa()
	col.add_child(_peldano_fuentes())
	if UiKit.es_horizontal():
		col = _peldano_placa()
	col.add_child(_peldano_rejilla(v))
