func _page_entreno() -> void:
	if _tira_tumbada():
		_en_t_render()
		return
	var div: int = TrainingGround.clamp_div(GameState.player_div())
	var g: Dictionary = TrainingGround.ground(div)
	CareerUi.head(_content, I18n.t(String(g["name"])))
	CareerUi.line(_content, I18n.t(String(g["desc"])))




	CareerUi.dim(_content, I18n.t("Elige un ejercicio y repítelo sin límite: cada intento arma un escenario distinto. Aquí no se juega nada de la carrera — el que cuenta es EL ENCARGO DEL MÍSTER, y ése sale la jornada que no te convocan. Se sale con PAUSA."))
	CareerUi.head(_content, I18n.t("QUE SE ENTRENA AQUI"))
	for drill in TrainingGround.drills_of(div):
		var id: String = String(drill)


		var row: Button = CareerUi.menu_row(
			I18n.t(Practice.label_of(id)).to_upper(), "")
		row.pressed.connect(_start_training.bind(id))
		_content.add_child(row)
	var next_up: Array = TrainingGround.drills_unlocked_by(div)
	if next_up.is_empty():
		return
	CareerUi.head(_content, I18n.t("SI SUBES DE CATEGORIA"))
	var names: PackedStringArray = []
	for id2 in next_up:
		names.append(I18n.t(Practice.label_of(String(id2))))
	CareerUi.line(_content, I18n.tf("Se abre: {0}.", [", ".join(names)]))




