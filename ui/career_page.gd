	return ""






func _sponsor_offer_card(offer: Dictionary) -> void:
	var oid: String = String(offer["id"])
	var full: bool = Career.sponsors.size() >= Sponsors.MAX_ACTIVE


	var brand: Color = Sponsors.color_of(oid)
	var card: PanelContainer = PanelContainer.new()
	var sb: StyleBoxFlat = CareerTheme.plate_tinted(brand)
	sb.set_content_margin_all(22.0)
	card.add_theme_stylebox_override("panel", sb)
	_content.add_child(card)

	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 20)
	card.add_child(row)
	var icon: SponsorLogo = SponsorLogo.new()
	icon.custom_minimum_size = Vector2(86, 86)
	icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	icon.setup(oid, brand)
	row.add_child(icon)

	var info: VBoxContainer = VBoxContainer.new()
	info.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	info.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	info.add_theme_constant_override("separation", 10)
	row.add_child(info)
	var t: Label = CareerUi.plain(CareerTheme.T_CARD, brand)
	t.text = I18n.t(String(offer["name"]))
	t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	info.add_child(t)





	if offer.has("puja_rival"):
		var puja: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.MONEY)
		puja.text = I18n.tf("PUJA CON {0}: +{1} %", [
			I18n.t(String(offer["puja_rival"])), roundi((Sponsors.PUJA_MULT - 1.0) * 100.0)])
		puja.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		info.add_child(puja)

	var obj: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.accent_text())
	obj.text = I18n.tf("OBJETIVO: {0}", [I18n.t(Sponsors.objective_text(offer))])







	obj.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	info.add_child(obj)
	var pay: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.MONEY)










	pay.text = I18n.tf("${0} / PARTIDO   +${1} POR {2}", [
		CareerUi.money(int(offer["pay"])), CareerUi.money(int(offer["per_goal"])),
		Sponsors.per_label(offer)])
	pay.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	info.add_child(pay)



	var prize: Label = CareerUi.plain(CareerTheme.T_VALUE, CareerTheme.MONEY)
	prize.text = I18n.tf("PREMIO ${0}", [CareerUi.money(int(offer["reward"]))])
