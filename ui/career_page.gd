func _torn_historial_compacto(box: VBoxContainer, v: VBoxContainer) -> void:
	await get_tree().process_frame
	await get_tree().process_frame
	if not is_instance_valid(box) or not is_instance_valid(v) or v.get_child_count() == 0:
		return
	var capa: Control = box.get_parent() as Control
	var sep: float = float(box.get_theme_constant("separation"))
	var alto: float = capa.size.y - box.offset_top + box.offset_bottom
	for c in box.get_children():
		if c != v:
			alto -=(c as Control).get_combined_minimum_size().y + sep
	var n: int = v.get_child_count()
	var sep_v: float = float(v.get_theme_constant("separation"))
	if v.get_combined_minimum_size().y > alto:
		v.add_theme_constant_override("separation", 0)
		for l in v.find_children("*", "Label", true, false):
			_torn_pon_px(l as Label, CareerTheme.T_CAP_TUMBADO)
		return
	var cada: float = floorf(minf((alto - sep_v * float(n - 1)) / float(n),
		CareerTheme.TOQUE_TUMBADO))
	for r in v.get_children():
		(r as Control).custom_minimum_size.y = maxf((r as Control).custom_minimum_size.y, cada)








func _torn_nat_frac(st: Dictionary) -> Array:
	var groups: Array = st.get("groups", [])
	var ko_names: Array = st.get("ko_names", [])
	var g_rounds: int = 0
	var g_played: int = 0
	if not groups.is_empty():
		var g0: Dictionary = groups[0]
		g_rounds =(g0.get("schedule", []) as Array).size()
		var row: Dictionary =(g0.get("table", {}) as Dictionary).get(
			GameState.YOU_KEY, {})
		g_played = mini(int(row.get("pj", 0)), g_rounds)
	var total: int = g_rounds + ko_names.size()
	if total <= 0:
		return [1, 1]
	if bool(st.get("champion", false)) or not bool(st.get("alive", true)):
		return [total, total]
	var ko_done: int = mini(int(st.get("ko_idx", 0)), ko_names.size())
	return [mini(g_played + ko_done, total), total]





















func _torn_frac() -> Array:
	var total: int = GameState.league_rounds_yours()
	var played: int = int(Dictionary(GameState.league_table.get(
		GameState.YOU_KEY, {})).get("pj", 0))
	if total <= 0:
		return [1, 1]
	return [played, total]






func _torn_build_race(raw: Array, mine: bool, comp_key: String) -> Array:
	var pt: Array = _torn_frac()
	if int(pt[0]) <= 0:
		return []
	var race: Array = Race.prorate(raw, int(pt[0]), int(pt[1]))
	if mine:
		Career.blend_mate_stats(race, comp_key)
	return race





