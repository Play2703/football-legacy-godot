func _pf_t_sin_foco_vestuario() -> void:
	var room: Node = _pf_t_room()
	if room == null:
		return
	for h in room.get_children():
		_pf_t_marca_sin_foco(h)
	if not room.child_entered_tree.is_connected(_pf_t_marca_sin_foco):
		room.child_entered_tree.connect(_pf_t_marca_sin_foco)


func _pf_t_marca_sin_foco(n: Node) -> void:
