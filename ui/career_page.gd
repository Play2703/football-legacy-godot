func _reneg_bala(rotulo: String, valor: String, tinta: Color, lleno: bool) -> void:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 12)
	_content.add_child(fila)

	var dato: PanelContainer = CareerUi.chip()
	dato.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	fila.add_child(dato)
	var caja: HBoxContainer = HBoxContainer.new()
	caja.add_theme_constant_override("separation", 12)
	dato.add_child(caja)
	var cap: Label = CareerUi.plain(CareerTheme.T_BODY, tinta)
	cap.text = rotulo
	caja.add_child(cap)
	var val: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
	val.text = valor




	val.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	val.clip_text = true
	val.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	val.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	caja.add_child(val)

	var bala_box: PanelContainer = CareerUi.chip()
	fila.add_child(bala_box)
	var bala: Panel = Panel.new()
	bala.custom_minimum_size = Vector2(28, 28)
	bala.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	if lleno:
		sb.bg_color = CareerTheme.MONEY
	else:
		sb.bg_color = Color(0, 0, 0, 0)
		sb.set_border_width_all(3)
		sb.border_color = CareerTheme.SURFACE_LINE
	bala.add_theme_stylebox_override("panel", sb)
	bala_box.add_child(bala)




func _confirm_ask_table() -> void:
	var p: int = int(round(Career.renegotiation_sit_p() * 100.0))
	_confirm(I18n.t("PEDIR MESA AL CLUB"),
		I18n.tf("Se sientan contigo un {0}% de las veces. Si dicen que no, no habrá mesa esta temporada.", [p]),
		I18n.t("PEDIR MESA"), false,
		func() -> void:
			if bool(Career.request_renegotiation().get("ok", false)):
				_toast(I18n.t("SE SIENTAN CONTIGO"), CareerTheme.MONEY)
			else:
				_toast(I18n.t("NO HAY MESA ESTE AÑO"), CareerTheme.DANGER))





func _confirm_renegotiation() -> void:
	var o: Dictionary = Career.renegotiation_offer()
	var wage_new: int = int(o["wage"])
	var lines: PackedStringArray = PackedStringArray()
	var delta: int = int(o["delta"])
	if delta > 0:
		lines.append(I18n.tf("Sueldo: $ {0} → $ {1} (+$ {2})",
			[CareerUi.money(int(o["wage_now"])), CareerUi.money(wage_new),
			CareerUi.money(delta)]))
	var years: int = int(o["seasons"])
	if years > 0:
		lines.append(I18n.tf("Años: +{0} (tendrías {1})", [years, int(o["total"])]))
	var gadd: float = float(o.get("goal_bonus_add", 0.0))
	if gadd > 0.0:
		lines.append(I18n.tf("Prima por gol: +$ {0}",
			[CareerUi.money(int(float(wage_new) * 0.5 * gadd))]))
	var aadd: float = float(o.get("assist_bonus_add", 0.0))
	if aadd > 0.0:
		lines.append(I18n.tf("Prima por asistencia: +$ {0}",
			[CareerUi.money(int(float(wage_new) * 0.5 * aadd))]))
	if bool(o.get("role_up", false)):
		lines.append(I18n.tf("Rol: te reconocen como {0}", [String(o["role_name"])]))
	_confirm(I18n.t("MESA DE CONTRATO"), "\n".join(lines),
		I18n.t("MANTÉN PARA FIRMAR"), false,
		func() -> void:
			Career.accept_renegotiation()
			_toast(I18n.t("CONTRATO MEJORADO"), CareerTheme.MONEY), true)




















func _confirm(title_text: String, body_text: String, yes_text: String,
		danger: bool, on_yes: Callable, hold: bool = false,
		destacado: String = "") -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(30, CareerTheme.TEXT)
	t.text = title_text
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(t)
	if not destacado.is_empty():
		var d: Label = CareerUi.plain(23, CareerTheme.TEXT)
		d.text = destacado
		d.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		d.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		box.add_child(d)


		var aire: Control = Control.new()
		aire.custom_minimum_size = Vector2(0, 10)
		box.add_child(aire)
	var body: Label = CareerUi.plain(21, CareerTheme.TEXT_DIM)
	body.text = body_text
	body.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	body.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(body)
	if hold:


		var hb: Button = CareerUi.hold_button(box, yes_text, HOLD_SECS,
			func() -> void:
				CareerUi.close_modal(box)
				on_yes.call(),
			24, Color(0, 0, 0, 0) if danger else CareerTheme.GOOD)
		hb.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	else:
		var yes: Button = Button.new()
		yes.text = yes_text
		yes.custom_minimum_size = Vector2(0, 92)
		CareerTheme.apply_button(yes,
			CareerTheme.Kind.WARN if danger else CareerTheme.Kind.PRIMARY, 28)
		yes.pressed.connect(func() -> void:
			CareerUi.close_modal(box)
			on_yes.call())
		box.add_child(yes)
	var no: Button = Button.new()
	no.text = I18n.t("MEJOR NO")
	no.custom_minimum_size = Vector2(0, 92)
	CareerTheme.apply_button(no, CareerTheme.Kind.NEUTRAL, 26)
	no.pressed.connect(func() -> void: CareerUi.close_modal(box))






	box.add_child(no)



