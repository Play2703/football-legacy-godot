		var t: int = Career.cortejo_tramo(String(r.get("id", "")))
		if t >= 2:
			return [I18n.t("VA EN SERIO"), 2, true]
		return [I18n.t("TE QUIERE"), 1, false] if t == 1 \
				else [I18n.t("TE SIGUE"), 0, false]
