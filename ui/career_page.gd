	return seg




func _ti_t_un_enfocable(b: Button, on: bool) -> void:
	b.focus_mode = Control.FOCUS_ALL if on else Control.FOCUS_NONE
	if on:
		b.remove_meta(Entrada.SIN_FOCO_META)
	else:
		b.set_meta(Entrada.SIN_FOCO_META, true)


func _ti_t_elige_familia(id: String) -> void:
	if id == _shop_tab:
		return
	_ti_t_vista = ""
	_select_shop(id)





func _ti_t_seg_cruceta(ev: InputEvent, seg: HBoxContainer, i: int) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO:
		return
	var dir: String = _ti_t_dir(ev)
	if dir.is_empty() or (dir == "ui_up" and seg == _ti_t_seg) \
			or (dir == "ui_down" and _ti_t_celdas.is_empty()):
		return
	var b: Button = seg.get_child(i) as Button
	b.accept_event()
	var n: int = seg.get_child_count()
	match dir:
		"ui_left", "ui_right":
			var j: int = i +(1 if dir == "ui_right" else -1)
			if j < 0 or j >= n:
				return
			_ti_t_foco = "familia" if seg == _ti_t_seg else "caja"
			(seg.get_child(j) as Button).pressed.emit()
		"ui_down":
			_ti_t_elige(_ti_t_cursor)
		"ui_up":
			_ti_t_sube_a_familias()


func _ti_t_sube_a_familias() -> void:
	if _ti_t_seg == null or not is_instance_valid(_ti_t_seg):
		return
	for c in _ti_t_seg.get_children():
		if c is Button and (c as Button).focus_mode == Control.FOCUS_ALL:
			(c as Button).grab_focus()
			return


func _ti_t_dir(ev: InputEvent) -> String:
	for a in ["ui_left", "ui_right", "ui_up", "ui_down"]:
		if ev.is_action_pressed(String(a), true):
			return String(a)
	return ""


