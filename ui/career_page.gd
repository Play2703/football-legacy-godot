func _torn_ficha_ancho(franja: HBoxContainer, ancho: float) -> void:
	var ficha: Button = null
	var resto: float = 0.0
	var n: int = 0
	for c in franja.get_children():
		if not (c is Control):
			continue
		n += 1
		if c is Button and (c as Button).has_meta("ficha_texto"):
			ficha = c as Button
		else:
			resto +=(c as Control).get_combined_minimum_size().x
	if ficha == null:
		return
	var textos: Array = []
	for comp in _torn_list():
		textos.append(_torn_nombre(String(comp)))
	textos.append(_torn_nombre(_torn_comp))
	var sep: float = float(franja.get_theme_constant("separation"))
	CareerUi.ficha_contexto_ancho(ficha, textos, ancho - resto - sep * float(maxi(n - 1, 0)))










