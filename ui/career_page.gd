func _wnews_ident_ancho(h: HBoxContainer) -> float:
	var w: float = 0.0
	var n: int = 0
	for c in h.get_children():
		w +=(c as Control).custom_minimum_size.x
		n += 1
	return w + 16.0 * float(maxi(n - 1, 0))








func _wnews_portada_tumbada(f: Dictionary, ancho: float,
		lado: float = WNEWS_T_IDENT_PORTADA, vertical: bool = false) -> PanelContainer:
	var col: Color = _wnews_color_tumbado(f)
	var card: PanelContainer = _wnews_marco(f, true)
	card.name = "Portada"
	card.size_flags_vertical = Control.SIZE_EXPAND_FILL
	card.set_meta("wnews_portada", f)
	card.set_meta("wnews_lado", lado)
	card.set_meta("wnews_vertical", vertical)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 24)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(fila)
	var franja: ColorRect = _wnews_franja(col)
	franja.set_meta("wnews_franja", true)
	fila.add_child(franja)
	var ident: HBoxContainer = _wnews_ident_caja(f, true, _wnews_lado_pieza(f, lado))

	var pila: Container = fila
	if vertical:
		var v: VBoxContainer = VBoxContainer.new()
		v.add_theme_constant_override("separation", 24)
		v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		v.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		v.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fila.add_child(v)
		pila = v
		ident.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	pila.add_child(ident)
	var txt: VBoxContainer = VBoxContainer.new()
	txt.add_theme_constant_override("separation", 16)
	txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	txt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	txt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pila.add_child(txt)
	var sello: HBoxContainer = _wnews_sello(f, col, true)
	if vertical:
		sello.alignment = BoxContainer.ALIGNMENT_CENTER


	var med: HBoxContainer = _wnews_medalla(_wnews_jugador(f), WNEWS_T_MEDALLA, CareerTheme.T_LEE_TUMBADO)
	if med != null:
		sello.add_child(med)
	txt.add_child(sello)
	var w: float = _wnews_portada_ancho_texto(ancho, 0.0 if vertical else _wnews_ident_ancho(ident))
	var tit: VBoxContainer = _wnews_titular_tumbado(WorldNews.titular(f), WNEWS_T_PELDANOS_PORTADA,
		w, vertical)
	tit.set_meta("fl_titular", true)
	txt.add_child(tit)
	var dots: Control = _wnews_dots(f)
	if dots != null:
		if vertical:
			dots.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		txt.add_child(dots)
	var dato: Control = _wnews_dato(f)
	if dato != null:

		dato.add_theme_font_size_override("font_size", CareerTheme.T_DATO_TUMBADO)
		if vertical and dato is Label:
			(dato as Label).horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		txt.add_child(dato)
	if str(f.get("kind", "")) == "campeones":
		card.add_child(CareerUi.hit_overlay(CareerTheme.TOQUE_TUMBADO, _wnews_campeones.bind(f)))
	return card



const WNEWS_T_PELDANOS_PORTADA: Array = [[48, 3], [32, 4], [24, 6]]




func _wnews_portada_ancho_texto(ancho: float, ident_ancho: float) -> float:
	var seps: float = 24.0 *(2.0 if ident_ancho > 0.0 else 1.0)
	return ancho - WNEWS_T_FRANJA - seps - ident_ancho - 16.0 - WNEWS_T_HOLGURA




func _wnews_lado_pieza(f: Dictionary, alto: float) -> float:
	var kind: String = str(f.get("kind", ""))
	if kind in ["retiro", "bombazo", "promesa"] and not str(f.get("name", "")).is_empty():
		return floorf(alto * WNEWS_FACE_W / WNEWS_FACE_H)
	return alto






func _wnews_titular_tumbado(texto: String, peldanos: Array, ancho: float,
		centro: bool = false) -> VBoxContainer:
	var v: VBoxContainer = VBoxContainer.new()
	v.name = "Titular"
	v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.set_meta("wnews_titular", true)
	v.set_meta("wnews_ancho", ancho)
	var px: int = CareerTheme.T_LEE_TUMBADO
	var renglones: PackedStringArray = PackedStringArray()
	for p in peldanos:
		px = int(p[0])
		renglones = _wnews_renglones(texto, px, ancho)
		if renglones.size() <= int(p[1]):
			break



	v.add_theme_constant_override("separation", maxi(4, px / 8))
	for r in renglones:
		var l: Label = CareerUi.plain(px, CareerTheme.TEXT)
		l.text = r

		if centro:
			l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER

		l.clip_text = true
		l.mouse_filter = Control.MOUSE_FILTER_IGNORE
		v.add_child(l)
	return v



func _wnews_renglones(texto: String, px: int, ancho: float) -> PackedStringArray:
	var out: PackedStringArray = PackedStringArray()
	var fuente: Font = get_theme_font("font", "Label")
	if fuente == null:
		out.append(texto)
		return out
	var p: TextParagraph = TextParagraph.new()
	p.break_flags = TextServer.BREAK_MANDATORY|TextServer.BREAK_WORD_BOUND
	p.add_string(texto, fuente, px)
	p.width = maxf(1.0, ancho)
	for i in p.get_line_count():
		var r: Vector2i = p.get_line_range(i)
		var s: String = texto.substr(r.x, r.y - r.x).strip_edges()
		if not s.is_empty():
			out.append(s)
	return out



func _wnews_ancho(texto: String, px: int) -> float:
	var fuente: Font = get_theme_font("font", "Label")
	if fuente == null:
		return float(texto.length() * px)
	return ceilf(fuente.get_string_size(texto, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x)





func _wnews_modal_caja(box: VBoxContainer) -> Vector2:
	var vp: Rect2 = SceneFade.rect_visible(box)
	return Vector2(vp.size.x - box.offset_left + box.offset_right,
		vp.size.y - box.offset_top + box.offset_bottom)





func _wnews_archivo(ancla: Dictionary = {}) -> void:
	var box: VBoxContainer = CareerUi.modal_pantalla(self)
	if box == null:
		return
	box.set_meta("wnews_archivo", true)
	CareerUi.margen_modal_tumbada(box)
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 32)
	box.add_child(cab)
	var tit: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, CareerTheme.NAV_MUNDO)
	tit.text = CareerTheme.caps("%s · %s" % [I18n.t("NOTICIAS"), _wnews_scope_text()])
	tit.clip_text = true
	tit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tit.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	cab.add_child(tit)
	cab.add_child(_wnews_boton_cerrar(box))
	var filas: Array = _wnews_rows(_wnews_scope, WorldNews.MAX)
	var ts: Array = []
	var por_t: Dictionary = {}
	for f in filas:
		var t: int = int((f as Dictionary).get("season", 0))
		if not por_t.has(t):
			if ts.size() >= WNEWS_T_TEMPORADAS:
				continue
			ts.append(t)
			por_t[t] = []
		(por_t[t] as Array).append(f)
	var cols: HBoxContainer = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 32)
	cols.size_flags_vertical = Control.SIZE_EXPAND_FILL
	box.add_child(cols)
	var caja: Vector2 = _wnews_modal_caja(box)
	var sep_box: float = float(box.get_theme_constant("separation"))

	var alto: float = caja.y - CareerTheme.TOQUE_TUMBADO - sep_box - float(CareerTheme.T_LEE_TUMBADO) - 8.0
	var ancho_col: float =(caja.x - 32.0 * float(maxi(ts.size() - 1, 0))) / float(maxi(ts.size(), 1))
	var capa: Node = box.get_parent()
	for t in ts:
		cols.add_child(_wnews_archivo_columna(t, por_t[t], alto, ancho_col, ancla, capa))
	CareerUi.modal_opaca(box)



func _wnews_boton_cerrar(box: VBoxContainer) -> Button:
	var b: Button = Button.new()
	b.text = I18n.t("CERRAR")
	b.clip_text = true
	b.custom_minimum_size = Vector2(CareerUi.LISTA_VOLVER_W, CareerTheme.TOQUE_TUMBADO)
	b.size_flags_horizontal = Control.SIZE_SHRINK_END
	b.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	CareerTheme.apply_button(b, CareerTheme.Kind.GHOST, CareerTheme.T_LEE_TUMBADO)
	b.pressed.connect(func() -> void: CareerUi.close_modal(box))
	return b




func _wnews_archivo_columna(t: int, filas: Array, alto: float, ancho: float, ancla: Dictionary,
		capa: Node) -> VBoxContainer:
	var c: VBoxContainer = VBoxContainer.new()
	c.add_theme_constant_override("separation", 8)
	c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	c.set_meta("wnews_temporada", t)
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 16)
	c.add_child(cab)
	var l: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_DIM)
	l.text = CareerTheme.caps(I18n.tf("TEMPORADA {0}", [t]))
	l.clip_text = true
	l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	cab.add_child(l)
	var num: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT)
	num.text = str(filas.size())
	num.clip_text = true
	num.custom_minimum_size.x = _wnews_ancho(num.text, CareerTheme.T_LEE_TUMBADO) + 2.0
	num.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	cab.add_child(num)
	var marco: PanelContainer = PanelContainer.new()
	marco.name = "VentanaFoco"
	marco.add_theme_stylebox_override("panel", StyleBoxEmpty.new())
	marco.size_flags_vertical = Control.SIZE_EXPAND_FILL
	c.add_child(marco)
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 0)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.set_meta("fl_lista", "temporada_%d" % t)
	marco.add_child(v)
	var tu: int = filas.find(ancla) if not ancla.is_empty() else -1
	var idx: Array = CareerUi.ventana_foco(filas.size(), tu, 3, alto, WNEWS_T_FILA_ARCHIVO)

	var w_txt: float = ancho - _wnews_fila_fijo() - WNEWS_T_HOLGURA

	var vistas: Array = []
	for k in idx:
		if int(k) >= 0 and int(k) < filas.size():
			vistas.append(filas[int(k)])

	var medalla: float = _wnews_medallas_ancho(vistas if not vistas.is_empty() else filas)
	var sin_medalla: float = 0.0
	if medalla > 0.0:
		w_txt -= medalla + float(CareerUi.FILA_TUMBADA_SEP)



		sin_medalla = medalla + float(CareerUi.FILA_TUMBADA_SEP)
	var nivel: int = _wnews_nivel(vistas if not vistas.is_empty() else filas,
		CareerTheme.T_LEE_TUMBADO, w_txt, false, 0, sin_medalla)
	var scope: String = _wnews_scope
	CareerUi.ventana_pinta(v, idx, func(k: int) -> Control:
		var f: Dictionary = filas[k]
		var texto: String = _wnews_texto_nivel(f, nivel, false)
		var fila: PanelContainer = _wnews_fila_lista(f, WNEWS_T_FILA_ARCHIVO, texto,
			CareerTheme.T_LEE_TUMBADO, 0.0, k == tu, medalla)
		if k == tu:
			fila.set_meta("fl_tuya", true)
		return fila,
		func() -> void: _wnews_temporada_entera(capa, t, scope))
	return c




func _wnews_medallas_ancho(filas: Array) -> float:
	var w: float = 0.0
	for f in filas:
		w = maxf(w, _wnews_medalla_ancho(_wnews_jugador(f as Dictionary), WNEWS_T_MEDALLA_FILA))
	return w




func _wnews_fila_fijo() -> float:
	var sep: float = float(CareerUi.FILA_TUMBADA_SEP)
	return float(CareerUi.FILA_TUMBADA_CANAL) + CareerUi.FILA_TUMBADA_FRANJA + 24.0 \
			+ WNEWS_T_IDENT_FILA + WNEWS_T_AIRE_ESCUDO + 3.0 * sep + sep







func _wnews_fila_lista(f: Dictionary, alto: float, texto: String, tam: int, ancho: float,
		tuya: bool, medalla: float = 0.0) -> PanelContainer:
	var col: Color = _wnews_color_tumbado(f)
	var lado: float = minf(WNEWS_T_IDENT_FILA, alto - 4.0)
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(minf(24.0, lado), minf(24.0, lado))
	ic.setup(WorldNews.icono(f), col)
	var esc: HBoxContainer = HBoxContainer.new()
	esc.add_theme_constant_override("separation", 0)
	esc.custom_minimum_size.x = WNEWS_T_IDENT_FILA + WNEWS_T_AIRE_ESCUDO
	var crest: Control = _wnews_crest(str(f.get("club", "")), lado)
	if crest != null:
		esc.add_child(crest)
	var aire: Control = Control.new()
	aire.custom_minimum_size.x = WNEWS_T_AIRE_ESCUDO
	aire.mouse_filter = Control.MOUSE_FILTER_IGNORE
	esc.add_child(aire)
	var celdas: Array = [{"nodo": ic, "ancho": 24.0}, {"nodo": esc},
		{"texto": texto, "tam": tam, "expand": ancho <= 0.0, "ancho": maxf(ancho, 0.0)}]
	if medalla > 0.0:
		var med: HBoxContainer = _wnews_medalla(_wnews_jugador(f), WNEWS_T_MEDALLA_FILA)
		if med != null:
			med.alignment = BoxContainer.ALIGNMENT_END
			celdas.append({"nodo": med, "ancho": medalla})
	var p: PanelContainer = CareerUi.fila_tumbada(alto, col, celdas, tuya, CareerTheme.NAV_MUNDO)
	p.size_flags_vertical = Control.SIZE_EXPAND_FILL


	p.set_meta("wnews_fila", f)
	p.set_meta("wnews_texto", texto)
	p.set_meta("wnews_medalla", medalla > 0.0)
	return p





func _wnews_textos(f: Dictionary) -> Array:
	var club: String = str(f.get("club", ""))
	var nombre: String = str(f.get("name", ""))


	var persona: bool = not nombre.is_empty() and str(f.get("kind", "")) != "naming"
	var quien: String = WorldNews._apellido(nombre) if persona else WorldNews._club(club)





	var corto: String = quien if persona \
			else _torn_sigla_de(Coach.pais_nat(club) if Coach.es_nat(club) else club)
	return [WorldNews.titular(f), "%s · %s" % [CareerTheme.caps(WorldNews.sello(f)), quien], quien,
		corto]




func _wnews_texto_nivel(f: Dictionary, nivel: int, mayus: bool) -> String:
	var ts: Array = _wnews_textos(f)
	for i in range(clampi(nivel, 0, ts.size() - 1), ts.size()):
		var s: String = String(ts[i]).strip_edges()
		if not s.is_empty():
			return CareerTheme.caps(s) if mayus else s
	return CareerTheme.caps(WorldNews.sello(f))






func _wnews_nivel(filas: Array, tam: int, ancho: float, mayus: bool, desde: int = 0,
		sin_medalla: float = 0.0) -> int:
	for nivel in range(desde, 4):
		var caben: bool = true
		for f in filas:
			var t: String = _wnews_texto_nivel(f, nivel, mayus)
			var w: float = ancho
			if sin_medalla > 0.0 and _wnews_jugador(f as Dictionary).is_empty():
				w += sin_medalla


			if _wnews_ancho(t, tam) > w and t != _wnews_texto_nivel(f, 3, mayus):
				caben = false
				break
		if caben:
			return nivel
	return 3






func _wnews_temporada_entera(host: Node, temporada: int, scope: String, tope: int = -1) -> void:
	var filas: Array = []
	for f in _wnews_rows(scope, WorldNews.MAX):
		if int((f as Dictionary).get("season", 0)) == temporada:
			filas.append(f)
	if filas.is_empty():
		return
	var titulo: String = I18n.tf("TEMPORADA {0}", [temporada])


	var medalla: float = _wnews_medallas_ancho(filas)
	var cabe: int = tope if tope > 0 else _wnews_entera_cabe(
		WNEWS_T_FILA_ARCHIVO if medalla > 0.0 else CareerUi.LISTA_FILA_H_MIN)
	if filas.size() > cabe:
		_wnews_temporada_tipos(host, titulo, filas)
		return
	var franjas: Array = []
	for f in filas:
		franjas.append(_wnews_color_tumbado(f))




	var med: Dictionary = {"host": host, "medalla": medalla}
	var box: VBoxContainer = CareerUi.lista_entera_modal(host, titulo, filas, franjas,
		CareerTheme.NAV_MUNDO, func(_i: int, fila: Variant, _franja: Color, alto: float) -> Control:
			return _wnews_entera_fila(fila as Dictionary, alto, filas, med))
	if box == null:
		return
	box.set_meta("wnews_sub", filas.size())




func _wnews_entera_cabe(fila_h: float = CareerUi.LISTA_FILA_H_MIN) -> int:
	var vp: Viewport = get_viewport()
	if vp == null:
		return 999
	var alto: float = vp.get_visible_rect().size.y \
			- 2.0 * maxf(UiKit.top_safe_inset(vp) + UiKit.CORTESIA_LATERAL, CareerUi.MODAL_TUMBADA_ALTO) \
			- float(CareerTheme.T_DATO_TUMBADO) - CareerUi.LISTA_AIRE_TITULO
	return maxi(1, floori(alto / fila_h))




func _wnews_entera_libre(host: Node) -> float:
	var box: VBoxContainer = null
	for i in range(host.get_child_count() - 1, -1, -1):
		var c: Node = host.get_child(i)
		if c.is_in_group(CareerUi.MODAL_GROUP):
			box = c.get_node_or_null("Columna") as VBoxContainer
			break
	if box == null:
		return 0.0
	return _wnews_modal_caja(box).x - 3.0 * 32.0 - CareerUi.LISTA_VOLVER_W - _wnews_fila_fijo() \
			- WNEWS_T_HOLGURA






func _wnews_entera_fila(f: Dictionary, alto: float, filas: Array, med: Dictionary) -> Control:
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var medalla: float = float(med.get("medalla", 0.0))
	if not med.has("ancho"):
		var libre: float = _wnews_entera_libre(med["host"])
		if medalla > 0.0:
			libre -= medalla + float(CareerUi.FILA_TUMBADA_SEP)
		med["libre"] = libre
		var w: float = 0.0
		for paso in [[CareerTheme.T_LEE_TUMBADO, false], [CareerTheme.T_CAP_TUMBADO, true]]:
			var px: int = int(paso[0])
			var may: bool = bool(paso[1])
			var nivel: int = _wnews_nivel(filas, px, maxf(libre, 1.0), may)
			med["nivel_%d" % px] = nivel
			for g in filas:
				w = maxf(w, _wnews_ancho(_wnews_texto_nivel(g, nivel, may), px))
		med["ancho"] = minf(w + 2.0, maxf(libre, 1.0))
	var texto: String = _wnews_texto_nivel(f, int(med["nivel_%d" % tam]), compacta)
	return _wnews_fila_lista(f, alto, texto, tam, float(med["ancho"]), false, medalla)





func _wnews_temporada_tipos(host: Node, titulo: String, filas: Array) -> void:
	var box: VBoxContainer = CareerUi.modal_pantalla(host)
	if box == null:
		return
	box.set_meta("wnews_sub", filas.size())
	box.set_meta("wnews_tipos", true)
	CareerUi.margen_modal_tumbada(box)
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 32)
	box.add_child(cab)
	var tit: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, CareerTheme.NAV_MUNDO)
	tit.text = CareerTheme.caps(titulo)
	tit.clip_text = true
	tit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tit.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	cab.add_child(tit)
	cab.add_child(_wnews_boton_cerrar(box))

	var grupos: Dictionary = {}
	var orden: Array = []
	for f in filas:
		var k: String = str((f as Dictionary).get("kind", ""))
		if not grupos.has(k):
			grupos[k] = []
			orden.append(k)
		(grupos[k] as Array).append(f)
	orden.sort_custom(func(a: String, b: String) -> bool:
		return (grupos[a] as Array).size() >(grupos[b] as Array).size())
	var n_cols: int = mini(WNEWS_T_TEMPORADAS, orden.size())
	var carga: Array = []
	var reparto: Array = []
	for i in n_cols:
		carga.append(0)
		reparto.append([])
	for k in orden:
		var mejor: int = 0
		for i in n_cols:
			if int(carga[i]) < int(carga[mejor]):
				mejor = i
		(reparto[mejor] as Array).append(k)
		carga[mejor] = int(carga[mejor]) +(grupos[k] as Array).size()

	var caja: Vector2 = _wnews_modal_caja(box)
	var alto_cols: float = caja.y - CareerTheme.TOQUE_TUMBADO - float(box.get_theme_constant("separation"))
	var alto: float = WNEWS_T_FILA_ARCHIVO
	for i in n_cols:
		var cabeceras: float = float((reparto[i] as Array).size()) *(float(CareerTheme.T_LEE_TUMBADO) + 16.0)
		alto = minf(alto, floorf((alto_cols - cabeceras) / float(maxi(int(carga[i]), 1))))
	alto = maxf(CareerUi.LISTA_FILA_H_MIN, alto)
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var ancho_col: float =(caja.x - 32.0 * float(n_cols - 1)) / float(n_cols)
	var w_txt: float = ancho_col - _wnews_fila_fijo() - WNEWS_T_HOLGURA
	var cols: HBoxContainer = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 32)
	cols.size_flags_vertical = Control.SIZE_EXPAND_FILL
	box.add_child(cols)
	for i in n_cols:
		var col: VBoxContainer = VBoxContainer.new()
		col.add_theme_constant_override("separation", 8)
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		cols.add_child(col)
		for k in reparto[i]:
			var g: Array = grupos[k]
			var c: HBoxContainer = HBoxContainer.new()
			c.add_theme_constant_override("separation", 16)
			col.add_child(c)
			var ic: MenuIcon = MenuIcon.new()
			ic.custom_minimum_size = Vector2(24, 24)
			ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			ic.setup(WorldNews.icono(g[0]), _wnews_color_tumbado(g[0]))
			c.add_child(ic)


			var sello: String = CareerTheme.caps(WorldNews.sello(g[0]))
			var libre_s: float = ancho_col - 24.0 - 2.0 * 16.0 \
					- _wnews_ancho(str(g.size()), CareerTheme.T_LEE_TUMBADO) - WNEWS_T_HOLGURA
			var s: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO
				if _wnews_ancho(sello, CareerTheme.T_LEE_TUMBADO) <= libre_s
				else CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID)
			s.text = sello
			s.clip_text = true
			s.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			c.add_child(s)
			var num: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT)
			num.text = str(g.size())
			num.clip_text = true
			num.custom_minimum_size.x = _wnews_ancho(num.text, CareerTheme.T_LEE_TUMBADO) + 2.0
			c.add_child(num)
			var v: VBoxContainer = VBoxContainer.new()
			v.add_theme_constant_override("separation", 0)
			v.set_meta("fl_lista", "tipo_%s" % k)
			col.add_child(v)


			var medalla: float = _wnews_medallas_ancho(g) if alto >= WNEWS_T_FILA_ARCHIVO - 0.5 else 0.0
			var w_g: float = w_txt -(medalla + float(CareerUi.FILA_TUMBADA_SEP) if medalla > 0.0 else 0.0)
			var nivel: int = _wnews_nivel(g, tam, w_g, compacta, 2)
			for f in g:
				var fila: PanelContainer = _wnews_fila_lista(f, alto,
					_wnews_texto_nivel(f, nivel, compacta), tam, 0.0, false, medalla)
				fila.size_flags_vertical = Control.SIZE_FILL
				fila.set_meta("fl_fila", true)
				v.add_child(fila)
	CareerUi.modal_opaca(box)





























func _club_comp_row(club_id: String, country: String) -> HFlowContainer:
	var row: HFlowContainer = HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 8)
	row.add_theme_constant_override("v_separation", 4)
	row.add_child(Flags.make_rect(country, 18.0))
	var lbl: Label = CareerUi.plain(18, CareerTheme.TEXT_DIM)


	lbl.text = I18n.t(country)
	lbl.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(lbl)


	row.add_child(_comp_icon(Competitions.league_logo(country), CareerTheme.TEXT_DIM))








	var div: int = GameState.div_of(club_id)
	var div_l: Label = CareerUi.plain(18,
		CareerTheme.DANGER if div > GameState.player_div() else CareerTheme.TEXT)
	div_l.text = Teams.div_short(div)
	div_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(div_l)




	var eu: String = Market.club_europe(club_id, GameState.season_num)



	if Continental.es_americana(eu):
		eu = Continental.marca(eu)
	if not eu.is_empty():
		var accent: Color = Competitions.COMP_ACCENT.get(eu, CareerTheme.TEXT) as Color
		row.add_child(_comp_icon(eu, accent))
		var eu_l: Label = CareerUi.plain(16, accent)
		eu_l.text = I18n.t(String(Competitions.comp_name(eu)))
		eu_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(eu_l)
	else:
		var solo: Label = CareerUi.plain(16, CareerTheme.TEXT_DIM)
		solo.text = I18n.t("SOLO LIGA Y COPA")
		solo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		row.add_child(solo)
	return row



