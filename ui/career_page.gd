func _offer_xi(team_id: String, mi_pos: String = "") -> void:
	if team_id.is_empty():
		return
	var team: Dictionary = Teams.by_id(team_id)
	var squad: Array = Squad.of_nominal(team_id)
	if squad.is_empty():
		return





	var slots: Array = Squad.formation_slots(team_id).slice(0, Squad.STARTING_XI)
	var meta: Array = []
	meta.resize(squad.size())
	for i in squad.size():
		meta[i] = {}
	var once: Array = Rotation.lineup(squad, meta, slots)
	if once.is_empty():
		return


	var mejor: Callable = func(key: String) -> int:
		var top_i: int = -1
		var top_v: int = -1
		for idx in once:
			var pj: Dictionary = squad[int(idx)]
			if String(pj.get("pos", "")) == "POR":
				continue
			var v: int = int(pj.get(key, 0))
			if v > top_v:
				top_v = v
				top_i = int(idx)
		return top_i
	var pen_i: int = mejor.call("penal")
	var libre_i: int = mejor.call("parado")
	var cap: String = Squad.captain_name(team_id)
	var nat: String = Teams.country_of(team_id)




	var rivales: int = 0
	if not mi_pos.is_empty():
		for k in mini(once.size(), slots.size()):
			if String(slots[k]) == mi_pos:
				rivales += 1
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 10)
	_content.add_child(cab)
	var tit: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
	tit.text = CareerTheme.caps(I18n.t("SU ONCE MÁS FUERTE"))
	tit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tit.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	tit.clip_text = true
	cab.add_child(tit)


	if not mi_pos.is_empty():








		var sitio: Label = CareerUi.plain(CareerTheme.T_CAPTION,
			CareerTheme.accent_text() if rivales > 0 else CareerTheme.MONEY)
		sitio.text = CareerTheme.caps(
			I18n.tf("TU SITIO · {0}", [CareerUi.pos_rotulo(mi_pos)]) if rivales > 0
			else I18n.t("TU SITIO ESTA LIBRE"))
		sitio.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cab.add_child(sitio)

	var pitch: PitchView = PitchView.new()
	pitch.custom_minimum_size = Vector2(0, _alto_cancha())
	_content.add_child(pitch)
	var cards: Array = []
	var slots_once: Array = []
	for k in once.size():
		var i: int = int(once[k])
		var p: Dictionary = squad[i]
		var slot: String = String(slots[k]) if k < slots.size() else "MC"
		slots_once.append(slot)



		var nat_p: String = String(p.get("nat", ""))
		if nat_p.is_empty():
			nat_p = SquadMeta.nation_at(team_id, nat, i, String(p.get("pos", "MC")))
		var hacer: Callable = func() -> PlayerCard:
			return PlayerCard.build(p, team, Nations.id_for_country(nat_p),
				false, false, String(p.get("name", "")) == cap and not cap.is_empty(),
				0, -1, i == pen_i, i == libre_i, {}, slot, false)
		var c: PlayerCard = hacer.call()

		c.set_tap(func() -> void: _ficha_jugador(p, false,
			_pm_de_asiento(team_id, squad, i, -1), hacer, "", {},
			{"club": team_id, "seat": i}))
		cards.append(c)




	if not mi_pos.is_empty() and rivales > 0:
		for k in cards.size():
			if String(slots_once[k]) != mi_pos:
				(cards[k] as Control).modulate = Color(1, 1, 1, 0.45)
	for c in cards:
		pitch.add_child(c)
	await get_tree().process_frame


	if is_instance_valid(pitch):
		pitch.place(cards, slots_once)






























