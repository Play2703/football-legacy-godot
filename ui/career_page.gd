func _career_path_stints() -> Array:
	var out: Array = []
	for h in Career.season_history:
		_stint_push(out, String(h.get("club", "")), int(h.get("season", 0)),
			bool(h.get("loan", false)), _team_award_count(h.get("awards", [])))
	if Career.season_matches > 0 or Career.season_goals > 0:
		_stint_push(out, GameState.player_team_id, GameState.season_num,
			Career.on_loan(), _team_award_count(Career.current_season_awards()))
	return out




func _stint_push(out: Array, club: String, season: int, loan: bool,
		titles: int) -> void:
	if club.is_empty():
		return
	if not out.is_empty() and String(out[-1]["club"]) == club \
			and bool(out[-1]["loan"]) == loan:
		var last: Dictionary = out[-1]
		last["to"] = maxi(int(last["to"]), season)
		last["titles"] = int(last["titles"]) + titles


		if season != int(last["last"]):
			last["seasons"] = int(last["seasons"]) + 1
			last["last"] = season
		return
	out.append({"club": club, "from": season, "to": season, "last": season,
		"seasons": 1, "titles": titles, "loan": loan})









func _stint_transfer(e: Dictionary) -> Dictionary:
	var best: Dictionary = {}
	var best_d: int = 1<<30
	for t in Career.transfers:
		if String(t.get("id", "")) != String(e["club"]):
			continue
		var sn: int = int(t.get("season", 0))
		if sn < int(e["from"]) - 1 or sn > int(e["to"]):
			continue
		var d: int = absi(sn - int(e["from"]))
		if d < best_d:
			best_d = d
			best = t
	return best




func _stint_span(e: Dictionary) -> String:
	var a: int = int(e["from"])
	var b: int = int(e["to"])
	if a == b:
		return I18n.tf("T{0}", [a])
	return I18n.tf("T{0}-T{1}", [a, b])




