func _league_position() -> int:
	var rows: Array = GameState.league_standings()
	for i in rows.size():
		if String(rows[i].get("key", "")) == GameState.YOU_KEY:
			return i + 1
	return 0




func _ordinal(n: int) -> String:
	return I18n.ordinal(n)







const LOG_DAYS: int = 2





var _log_tags: Dictionary = {}










func _spread_log() -> void:
	_log_tags = {}
	var fuera: Array = []
	var sueltos: Array = []
	for e in Career.market_log:
		var entry: Dictionary = e
		if GameState.season_day - int(entry.get("day", 0)) > LOG_DAYS:
			continue
		var tag: String = I18n.t(String(entry.get("tag", "")))
		if bool(entry.get("gone", false)):
			fuera.append(String(entry.get("name", "")))
		elif not String(entry.get("id", "")).is_empty():


			if not _log_tags.has(String(entry["id"])):
				_log_tags[String(entry["id"])] = tag
		else:
			sueltos.append(tag)
	if fuera.is_empty() and sueltos.is_empty():
		return
	if not fuera.is_empty():
		var l: Label = CareerUi.plain(17, CareerTheme.TEXT_DIM)








		l.text = "%s  %s" % [CareerTheme.caps(I18n.t("SE FUERON")),
			CareerTheme.caps(" · ".join(fuera))]
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(l)


	if not sueltos.is_empty():
		var flow: HFlowContainer = HFlowContainer.new()
		flow.add_theme_constant_override("h_separation", 8)
		flow.add_theme_constant_override("v_separation", 8)
		_content.add_child(flow)
		for tag in sueltos:
			flow.add_child(_stamp(String(tag), CareerTheme.TEXT_DIM))




























func _leave_verdict() -> void:
	if Career.pending_offers.is_empty() or GameState.player_team_id.is_empty():
		return
	var mio_rating: int = Teams.rating(GameState.player_team_id)
	var mi_wage: int = int(Career.contract.get("wage", 0))
	var mis_min: int = int(Standing.CONTRACT_BASE_MINUTES.get(
		Standing.contract_role_from_key(String(Career.contract.get("role",
			"rotacion"))), 45))




	var mejor_club: int = -1
	var mejor_wage: int = -1
	var mejor_min: int = -1
	for o in Career.pending_offers:
		var d: Dictionary = o
		mejor_club = maxi(mejor_club, Teams.rating(String(d.get("id", ""))))
		mejor_wage = maxi(mejor_wage, int(d.get("wage", 0)))
		mejor_min = maxi(mejor_min, int(Standing.CONTRACT_BASE_MINUTES.get(
			Standing.contract_role_from_key(String(d.get("role", "rotacion"))), 45)))


	var d_club: int = mejor_club - mio_rating
	var d_wage: int = 0 if mi_wage <= 0 else int(round(
		(float(mejor_wage) - float(mi_wage)) / float(mi_wage) * 100.0))
	var d_min: int = mejor_min - mis_min
	if d_club <= 0 and d_wage <= 0 and d_min <= 0:
		CareerUi.dim(_content, I18n.t("Nada de lo que hay encima de la mesa te mejora:"
			+ " ni el club, ni la ficha, ni los minutos."))
		return




	var flow: HFlowContainer = HFlowContainer.new()
	flow.add_theme_constant_override("h_separation", 8)
	flow.add_theme_constant_override("v_separation", 8)
	_content.add_child(flow)
	var rot: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	rot.text = CareerTheme.caps(I18n.t("SI TE VAS, LO MEJOR DE LA MESA"))
	rot.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	flow.add_child(rot)
	flow.add_child(CareerUi.stat_chip(I18n.t("CLUB"), d_club))
	flow.add_child(CareerUi.stat_chip(I18n.t("SUELDO"), d_wage, "%"))






