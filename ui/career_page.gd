const RETIRE_HOLD_SECS: float = 2.0





func _sign_hold(parent: Container, on_sign: Callable, label_text: String = "") -> Button:
	var btn: Button = CareerUi.hold_button(parent,
		label_text if not label_text.is_empty() else I18n.t("MANTÉN PARA FICHAR"),
		HOLD_SECS, on_sign, 24, CareerTheme.GOOD)
	btn.custom_minimum_size = Vector2(0, 92)
	btn.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	return btn









func _offer_options(index: int) -> void:
	if index < 0 or index >= Career.pending_offers.size():
		return
	var offer: Dictionary = Career.pending_offers[index]
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(28, CareerTheme.TEXT)
	t.text = CareerTheme.caps(Market.club_name(offer))
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(t)

	if String(offer.get("role", "rotacion")) != "titular":
		box.add_child(_option_accion("once", I18n.t("PEDIR SER TITULAR"),
			CareerTheme.NAV_YO, box, func() -> void: _on_haggle(index, "role")))










	var mesa: Dictionary = Career.pulse_bounds(index)
	if Career.pulse_taken(index):
		CareerUi.dim(box, I18n.t("YA NEGOCIASTE CON ELLOS"))
	elif bool(mesa.get("ok", false)):
		box.add_child(_option_accion("moneda", I18n.t("NEGOCIAR TU SUELDO"),
			CareerTheme.MONEY, box, func() -> void: _go_pulse(index)))
	else:
		CareerUi.dim(box, I18n.t(String(mesa.get("why", "YA PAGAN SU TOPE"))))


	if bool(Career.clausulas_mesa_oferta(index).get("ok", false)):
		box.add_child(_option_accion("contrato_firma", I18n.t("NEGOCIAR CLÁUSULAS"),
			CareerTheme.NAV_YO, box, func() -> void: _abrir_clausulas_oferta(index)))








	if Career.agent_tasks_left() > 0 and Career.agent_shot.is_empty() \
			and not Career.market_deadline() and not bool(offer.get("pre", false)):
		var oid: String = String(offer.get("id", ""))

		box.add_child(_option_accion("agente", "%s · %s" % [I18n.t("QUE TU AGENTE LA SOSTENGA"),
			"$" + CareerUi.money(Career.agent_fee("hold"))],
			CareerTheme.MONEY, box, func() -> void:
				if Career.agent_commission("hold", oid):
					_toast(I18n.t("TU AGENTE LA SOSTIENE · RESPONDEN MAÑANA"),
						CareerTheme.accent_text())
				else:
