func _torn_heroe_liga(filas: Array, mine: bool, aviso: String = "") -> VBoxContainer:
	if filas.is_empty() or not aviso.is_empty():


		var linea0: String = _torn_linea_j0(aviso)

		return CareerUi.heroe(_torn_j0() if _torn_es_arranque(aviso) else "-", linea0, null)
	var i: int = -1
	if mine:
		for k in filas.size():
			if bool((filas[k] as Dictionary)["tuya"]):
				i = k
				break
	if i < 0:
		var lider: Dictionary = filas[0]
		return CareerUi.heroe(_ordinal(1), I18n.tf("{0} · {1} PTS",
			[_torn_nombre_corto(String(lider["nombre"])), int(lider["pts"])]),
			_torn_forma(GameState.form_of_any(String(lider["club"]))))
	var pts: int = int((filas[i] as Dictionary)["pts"])
	var linea: String = ""
	if i == 0:
		var ventaja: int = pts - int((filas[1] as Dictionary)["pts"]) if filas.size() > 1 else 0
		linea = I18n.tf("{0} PTS · +{1} AL {2}", [pts, ventaja, _ordinal(2)])
	else:
		linea = I18n.tf("{0} PTS · -{1} DEL {2}",
			[pts, int((filas[i - 1] as Dictionary)["pts"]) - pts, _ordinal(i)])
	return CareerUi.heroe(_ordinal(i + 1), linea,
		_torn_forma(GameState.form_of(GameState.YOU_KEY)))




