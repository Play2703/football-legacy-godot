func _balon_ranking(galas: Array) -> Array:
	var por: Dictionary = {}
	var out: Array = []
	for g in galas:
		var gala: Dictionary = g
		var w: Dictionary = gala.get("winner", {})
		var nombre: String = String(w.get("name", ""))
		if nombre.is_empty():
			continue
		if not por.has(nombre):
			por[nombre] = {"name": nombre, "seasons": [], "anios": [], "team": "", "nat": "",
				"you": false, "ultima": -1, "reciente": -1}
			out.append(por[nombre])
		var r: Dictionary = por[nombre]
		var real: bool = gala.has("anio")
		var cuando: int = int(gala["anio"]) if real \
				else BallonDor.anio_de(int(gala.get("season", 0)))
		if real:
			(r["anios"] as Array).append(int(gala["anio"]))
		else:
			(r["seasons"] as Array).append(int(gala.get("season", 0)))
			r["ultima"] = maxi(int(r["ultima"]), int(gala.get("season", 0)))
		if cuando >= int(r["reciente"]):
			r["reciente"] = cuando
			r["team"] = String(w.get("team", ""))
			r["nat"] = String(w.get("nat", ""))
		if bool(w.get("you", false)):
			r["you"] = true
	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		var na: int = _balon_cuenta(a)
		var nb: int = _balon_cuenta(b)
		if na != nb:
			return na > nb
		return int(a["reciente"]) > int(b["reciente"]))
	var puesto: int = 1
	for i in out.size():
		if i > 0 and _balon_cuenta(out[i]) < _balon_cuenta(out[i - 1]):
			puesto = i + 1
		out[i]["puesto"] = puesto
	return out



func _balon_cuenta(r: Dictionary) -> int:
	return (r.get("seasons", []) as Array).size() +(r.get("anios", []) as Array).size()




