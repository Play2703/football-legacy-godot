func _torn_escala_tumbada(raiz: Node) -> void:
	for h in raiz.find_children("*", "Control", true, false):
		if h is Label:
			var l: Label = h as Label
			var px: int = l.label_settings.font_size if l.label_settings != null \
					else l.get_theme_font_size("font_size")
			var cab: bool = l.get_parent() != null and l.get_parent().get_parent() != null \
					and l.get_parent().get_parent().has_meta(DragScroll.META_SECCION)
			var nuevo: int = _torn_px_tumbado(px, l.text, cab)
			if l.label_settings != null:

				l.label_settings = l.label_settings.duplicate() as LabelSettings
			_torn_pon_px(l, nuevo)
			if l.has_meta("shrink_base"):
				l.set_meta("shrink_base", nuevo)
				l.set_meta("shrink_floor", nuevo)


			if l.clip_text and l.autowrap_mode == TextServer.AUTOWRAP_OFF:
				l.set_meta("torn_px", nuevo)
				l.resized.connect(_torn_letra_cabe.bind(l))
		elif h is Button:
			var b: Button = h as Button
			b.add_theme_font_size_override("font_size",
				_torn_px_tumbado(b.get_theme_font_size("font_size"), b.text, false))
		elif h is RichTextLabel:
			var r: RichTextLabel = h as RichTextLabel
			var n: int = _torn_px_tumbado(r.get_theme_font_size("normal_font_size"), r.text, false)
			for k in ["normal_font_size", "bold_font_size", "italics_font_size"]:
				r.add_theme_font_size_override(k, n)
		elif h is HBoxContainer and h.get_child_count() > 1 \
				and h.get_children().all(func(c: Node) -> bool: return c is VBoxContainer):


			(h as HBoxContainer).add_theme_constant_override("separation", 32)



func _torn_pon_px(l: Label, px: int) -> void:
	if l.label_settings != null:
		l.label_settings.font_size = px
	else:
		l.add_theme_font_size_override("font_size", px)








func _torn_letra_cabe(l: Label) -> void:
	if not is_instance_valid(l) or l.size.x <= 0.0 or l.text.is_empty() \
			or l.autowrap_mode != TextServer.AUTOWRAP_OFF:
		return
	var f: Font = l.label_settings.font if l.label_settings != null \
			and l.label_settings.font != null else l.get_theme_font("font")
	var px: int = int(l.get_meta("torn_px", CareerTheme.T_LEE_TUMBADO))
	var suelo: int = mini(px, CareerTheme.T_LEE_TUMBADO)
	var cabe: bool = false
	for paso in [CareerTheme.T_HEROE_TUMBADO, CareerTheme.T_TITULO_TUMBADO,
			CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO]:
		if paso > px or paso < suelo:
			continue
		px = paso
		if f.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, paso).x + 6.0 <= l.size.x:
			cabe = true
			break
	_torn_pon_px(l, px)




	if not cabe and l.text.strip_edges().contains(" ") and not l.has_meta("torn_no_dobla"):
		l.clip_text = false
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART



		var palabra: float = 0.0
		for w in l.text.split(" ", false):
			palabra = maxf(palabra, f.get_string_size(w, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x)
		l.custom_minimum_size.x = maxf(l.custom_minimum_size.x, ceilf(palabra) + 2.0)



func _torn_nat_identidad() -> Array:
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(CareerTheme.T_TITULO_TUMBADO, CareerTheme.T_TITULO_TUMBADO)
