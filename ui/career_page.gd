func _hc_ficha_ancho(franja: HBoxContainer, ancho: float) -> void:
	var ficha: Button = null
	var resto: float = 0.0
	var n: int = 0
	for c in franja.get_children():
		if not (c is Control):
			continue
		n += 1
		if c is Button and (c as Button).has_meta("ficha_texto"):
			ficha = c as Button
		else:
			resto +=(c as Control).get_combined_minimum_size().x
	if ficha == null:
		return
	var textos: Array = [_hc_nombre_vista("")]
	for p in Nations.PLAYABLE:
		textos.append(_hc_nombre_vista(String(p)))
	var sep: float = float(franja.get_theme_constant("separation"))
	CareerUi.ficha_contexto_ancho(ficha, textos, ancho - resto - sep * float(maxi(n - 1, 0)))



	var l: Label = ficha.get_meta("ficha_texto", null) as Label
	if l != null:
		l.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
		CareerUi.letra_por_peldanos(l, [CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])




