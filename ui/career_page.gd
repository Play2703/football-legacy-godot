const LEG_HIST_NIVELES: Array = [[48, 32], [72, 48], [72, 72], [96, 72], [120, 72], [144, 72]]


const LEG_HIST_AIRE: float = 12.0





func _leg_historia_nivel(b: Button) -> void:
	if not is_instance_valid(b) or b.size.y <= 0.0 or b.size.x <= 0.0:
		return
	var pt: Dictionary = b.get_meta("leg_hist")
	var pos: Label = pt["pos"]
	if pos.get_theme_font("font") == null:
		return
	var elegido: int = _leg_historia_nivel_de(b, b.size.y)
	if elegido == int(b.get_meta("leg_nivel", -1)):
		return
	b.set_meta("leg_nivel", elegido)
	var nv_e: Array = LEG_HIST_NIVELES[elegido]
	(pt["icono"] as Control).custom_minimum_size = Vector2(nv_e[0], nv_e[0])
	var peldanos: Array = [int(nv_e[1])]
	for t in [CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO]:
		if t < int(nv_e[1]):
			peldanos.append(t)
	CareerUi.letra_por_peldanos(pos, peldanos)



func _leg_historia_nivel_de(b: Button, alto: float) -> int:
	for n in range(LEG_HIST_NIVELES.size() - 1, -1, -1):
		if float(_leg_historia_medida(b, LEG_HIST_NIVELES[n])[1]) <= alto:
			return n
	return 0






func _leg_historia_medida(b: Button, nv: Array) -> Array:
	var pt: Dictionary = b.get_meta("leg_hist")
	var pos: Label = pt["pos"]
	var f: Font = pos.get_theme_font("font")
	if f == null:
		return [0.0, INF]
	var v: VBoxContainer = pt["v"]
	var fila: Control = pt["fila"]
	var sep_v: float = float(v.get_theme_constant("separation"))
	var otros: int = 0
	for c in v.get_children():
		if c != fila and (c as Control).visible:
			otros += 1

	var resto: float = v.get_combined_minimum_size().y - fila.get_combined_minimum_size().y
	var resto_tinta: float = maxf(resto - sep_v * float(otros), 0.0)
	var ancho_col: float = b.size.x - 32.0 - float(nv[0]) - 16.0
	var letra: int = CareerTheme.T_CAP_TUMBADO
	for t in [int(nv[1]), CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO]:
		if t <= int(nv[1]) and f.get_string_size(pos.text, HORIZONTAL_ALIGNMENT_LEFT, -1, t).x \
				<= ancho_col:
			letra = t
			break
	var col_h: float = f.get_height(CareerTheme.T_CAP_TUMBADO) + LEG_HIST_AIRE + f.get_height(letra)
	var fila_h: float = maxf(float(nv[0]), col_h)

	var tinta: float = fila_h + resto_tinta -(LEG_HIST_AIRE if float(nv[0]) < col_h else 0.0)
	return [tinta, fila_h + resto + 32.0 + float(CareerTheme.SINK)]






func _leg_historia_alto(b: Button, v: VBoxContainer) -> void:
	if not is_instance_valid(b) or not is_instance_valid(v) or not b.has_meta("leg_hist"):
		return
	var pt: Dictionary = b.get_meta("leg_hist")
	var f: Font =(pt["pos"] as Label).get_theme_font("font")
	var fila_0: float = maxf(float(LEG_HIST_NIVELES[0][0]), f.get_height(CareerTheme.T_CAP_TUMBADO)
		+ LEG_HIST_AIRE + f.get_height(int(LEG_HIST_NIVELES[0][1]))) if f != null else 0.0
	var resto: float = v.get_combined_minimum_size().y -(pt["fila"] as Control).get_combined_minimum_size().y
	var h: float = maxf(CareerTheme.TOQUE_TUMBADO,
		ceilf(resto + fila_0) + 32.0 + float(CareerTheme.SINK))
