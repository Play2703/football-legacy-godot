func _trophy_ledger(items: Array) -> void:
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 12)
	_content.add_child(col)



	var provs: Array = []
	for it in items:
		provs.append(_trophy_prov(String((it as Dictionary)["name"])))
	var i: int = 0
	while i < items.size():



		var solo: bool =(provs[i] as Array).size() <= 1
		var pareja: bool = solo and i + 1 < items.size() \
				and (provs[i + 1] as Array).size() <= 1
		if not pareja:
			col.add_child(_trophy_card(items[i], provs[i], false))
			i += 1
			continue
		var duo: HBoxContainer = HBoxContainer.new()
		duo.add_theme_constant_override("separation", 12)
		col.add_child(duo)
		duo.add_child(_trophy_card(items[i], provs[i], true))
		duo.add_child(_trophy_card(items[i + 1], provs[i + 1], true))
		i += 2





func _trophy_card(it: Dictionary, prov: Array, half: bool) -> Control:
	var name_text: String = String(it["name"])
	var count: int = int(it["count"])
	var card: PanelContainer = CareerUi.chip()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 12 if half else 16)
	card.add_child(row)

	var side: float = LEDGER_ICON_HALF if half else LEDGER_ICON
	var stand: Control = Control.new()
	stand.custom_minimum_size = Vector2(side, side)
	stand.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(stand)






	var club_id: String = "" if prov.is_empty() \
			else String((prov[prov.size() - 1] as Dictionary).get("club", ""))
	var pais: String = "" if club_id.is_empty() else Teams.country_of(club_id)
	var logo: String = Competitions.league_logo(pais) \
			if String(it["type"]) == "liga" and not pais.is_empty() else ""
	_trophy_stand_icon(stand, String(it["type"]), count, logo, pais)
	var right: VBoxContainer = VBoxContainer.new()
	right.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	right.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	right.add_theme_constant_override("separation", 8 if not half else 6)
	row.add_child(right)
	var title: Label = CareerUi.plain(
		CareerTheme.T_DIM if not half else 15, CareerTheme.TEXT)
	title.text = CareerTheme.caps(I18n.t(name_text))
	title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	right.add_child(title)
	right.add_child(_trophy_stamps(name_text, count, prov))
	return card





func _trophy_prov(name_text: String) -> Array:
	return Trophies.provenance(name_text, Career.season_history,
		Career.current_season_awards(), GameState.player_team_id,
		GameState.season_num, GameState.player_div())






func _trophy_stamps(name_text: String, count: int, rows: Array) -> Control:
	var flow: HFlowContainer = HFlowContainer.new()
	flow.add_theme_constant_override("h_separation", 8)
	flow.add_theme_constant_override("v_separation", 8)
	var shown: int = 0




	var keys: Array = Trophies.keys_for(name_text)
	var grada_key: String = String(keys[0]) if keys.size() == 1 else ""
	for r in rows:
		if shown >= LEDGER_STAMPS_MAX:
			break
		flow.add_child(_trophy_stamp(r as Dictionary, name_text,
			not grada_key.is_empty() and Career.title_grada_at(grada_key, shown)))
		shown += 1




	var rest: int = count - shown
	if rest > 0:
		var more: String = I18n.tf("+{0}", [rest]) if rows.size() > shown \
				else I18n.tf("+{0} SIN REGISTRO", [rest])
		flow.add_child(_stamp_box([_stamp_label(more, CareerTheme.TEXT_DIM)]))
	return flow






func _trophy_stamp(r: Dictionary, name_text: String, grada: bool = false) -> Control:
	var parts: Array = []
	parts.append(_stamp_label(I18n.tf("T{0}", [int(r.get("season", 0))]),
		CareerTheme.accent_text()))
	if Trophies.is_national(name_text):


		var flag: TextureRect = Flags.make_rect(Career.nationality, 18.0)
		flag.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		parts.append(flag)
		parts.append(_stamp_label(CareerTheme.caps(Nations.display_name(Career.nationality)),
			CareerTheme.TEXT))
	else:
		var team: Dictionary = Teams.by_id(String(r.get("club", "")))
		if not team.is_empty():




			if Trophies.div_matters(name_text):
				var flag: TextureRect = Flags.make_rect(
					String(team.get("country", "")), 16.0)
				flag.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				parts.append(flag)
			var crest: CrestView = CrestView.new()
			crest.custom_minimum_size = Vector2(22, 22)
			crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			crest.set_team(team)
			parts.append(crest)
			parts.append(_stamp_label(String(team.get("abbrev", "?")), CareerTheme.TEXT))
	var div: int = int(r.get("div", 0))
	if div > 0 and Trophies.div_matters(name_text):
		parts.append(_stamp_label(I18n.ordinal_f(div), CareerTheme.TEXT_DIM))
	if grada:
		parts.append(_stamp_label(I18n.t("GRADA"), CareerTheme.TEXT_DIM))
	return _stamp_box(parts)


func _stamp_label(text: String, color: Color) -> Label:
	var l: Label = CareerUi.plain(16, color)
	l.text = text
	l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	return l


func _stamp_box(parts: Array) -> PanelContainer:
	var p: PanelContainer = PanelContainer.new()
	p.add_theme_stylebox_override("panel",
		CareerTheme.tag(Color(1, 1, 1, 0.06)))
	var h: HBoxContainer = HBoxContainer.new()
	h.add_theme_constant_override("separation", 6)
