const GRUPO_CARTA_W: float = 130.0



const GRUPO_CARTA_W_TUMBADA: float = 192.0


const GRUPO_CARTA_MARGEN: float = 16.0



const GRUPO_CARTA_MARGEN_ARRIBA: float = 20.0



const GRUPO_FILA_MARGEN_DER: float = 16.0





const GRUPO_FRANJA_AIRE: float = 28.0






const GRUPO_FRANJA_MARCO_AIRE: float = 12.0



const GRUPO_CARTA_MARGEN_IZQ: float = 16.0
const GRUPOS_POR_TANDA: int = 4






func _grupos_cartas(cartas: Array, accent: Color) -> void:
	var llena: bool =(_torn_capturando or _torn_cartas_llenas) and UiKit.es_horizontal()




	var equipos: Array = []
	var visto: Dictionary = {}
	for c in cartas:
		for f in (c as Dictionary)["filas"]:
			var team: Dictionary =(f as Dictionary)["team"]
			var id: String = String(team.get("id", team.get("name", "")))
			if not visto.has(id):
				visto[id] = equipos.size()
				equipos.append(team)
	var todas: Array = _torn_siglas_unicas(equipos)
	var noms: Array = []
	for c in cartas:
		var siglas: Array = []
		for f in (c as Dictionary)["filas"]:
			var team: Dictionary =(f as Dictionary)["team"]
			siglas.append(todas[int(visto[String(team.get("id", team.get("name", "")))])])
		(c as Dictionary)["siglas"] = siglas
	var tanda: HBoxContainer = null
	var con_cols: Array = []

	if llena:
		var anchos: Dictionary = _grupo_col_anchos(CareerTheme.T_LEE_TUMBADO, cartas)
		for c in cartas:
			(c as Dictionary)["anchos"] = anchos
	for c in cartas:
		if tanda == null or tanda.get_child_count() >= GRUPOS_POR_TANDA:
			tanda = HBoxContainer.new()
			tanda.add_theme_constant_override("separation", CAL_TANDA_SEP)
			tanda.alignment = BoxContainer.ALIGNMENT_CENTER
			if llena:
				tanda.name = "TandaGrupos"
				tanda.set_meta("torn_tanda", true)
				tanda.size_flags_vertical = Control.SIZE_EXPAND_FILL
			_content.add_child(tanda)
		var carta: Control = _grupo_carta(c, accent)
		if llena:
			carta.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		if carta.has_meta("grupo_anchos"):
			con_cols.append(carta)
		tanda.add_child(carta)
		for l in carta.find_children("*", "Label", true, false):
			if l.has_meta("grupo_nombre_corto"):
				noms.append(l)




	var forma: Callable = _grupos_forma.bind(noms)
	for l in noms:
		(l as Label).resized.connect(forma)




	if not con_cols.is_empty():


		var columnas: Callable = _grupos_columnas.bind(con_cols)
		for k in con_cols:
			for m in (k as Node).find_children("*", "HBoxContainer", true, false):
				if (m as Node).has_meta("grupo_fila"):
					(m as Control).resized.connect(columnas)

	while tanda != null and tanda.get_child_count() < GRUPOS_POR_TANDA:
		var hueco: Control = Control.new()
		hueco.custom_minimum_size = Vector2(GRUPO_CARTA_W_TUMBADA if UiKit.es_horizontal()
			else GRUPO_CARTA_W, 0)
		hueco.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if llena:
			hueco.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		tanda.add_child(hueco)





	if llena and UiKit.bottom_safe_inset(get_viewport()) < TORN_AIRE_PIE:
		var pie: Control = Control.new()
		pie.name = "AirePieGrupos"
		pie.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_content.add_child(pie)






func _grupos_forma(noms: Array) -> void:
	var cabe: bool = not noms.is_empty()
	var vistos: Dictionary = {}
	for it in noms:
		var l: Label = SceneFade.vivo(it) as Label
		if l == null or not is_instance_valid(l):
			return
		if l.size.x <= 0.0:
			return
		var nombre: String = String(l.get_meta("grupo_nombre_corto", ""))
		var f: Font = l.get_theme_font("font")
		var tam: int = l.get_theme_font_size("font_size")
		if nombre.is_empty() or vistos.has(nombre) or f == null or f.get_string_size(nombre,
				HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x > l.size.x - 2.0:
			cabe = false
		vistos[nombre] = true
	for it in noms:
		var l: Label = SceneFade.vivo(it) as Label
		var forma: String = "nombre" if cabe else "sigla"
		if String(l.get_meta("grupo_forma", "")) == forma and not l.text.is_empty():
			continue
		l.set_meta("grupo_forma", forma)
		l.text = String(l.get_meta("grupo_nombre_corto")) if cabe \
				else String(l.get_meta("grupo_sigla_txt"))







static func _torn_siglas_unicas(equipos: Array) -> Array:
	return BRACKET_TREE.siglas_unicas(equipos)


func _grupo_carta(c: Dictionary, accent: Color) -> Control:
	var pan: PanelContainer = PanelContainer.new()





	var tumbada: bool = UiKit.es_horizontal()

	var llena: bool = tumbada and (_torn_capturando or _torn_cartas_llenas)
	pan.custom_minimum_size = Vector2(GRUPO_CARTA_W_TUMBADA if tumbada else GRUPO_CARTA_W, 0)



	var mio: bool = false
	for f in c["filas"]:
		mio = mio or bool((f as Dictionary)["you"])
	var sb: StyleBoxFlat = CareerTheme.estilo_seleccion(accent, 4) if llena and mio \
			else CareerTheme.plate()
	if llena and mio:
		pan.set_meta("grupo_tuyo", true)
	sb.set_content_margin_all(6.0)
	if tumbada:




		sb.content_margin_top = GRUPO_CARTA_MARGEN_ARRIBA
		sb.content_margin_right = GRUPO_CARTA_MARGEN
		sb.content_margin_left = GRUPO_CARTA_MARGEN_IZQ
		pan.set_meta("grupo_carta", true)
	pan.add_theme_stylebox_override("panel", sb)
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 3)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	pan.add_child(v)




	var t: Label = CareerUi.plain((CareerTheme.T_LEE_TUMBADO if llena else CareerTheme.T_CAP_TUMBADO)
		if tumbada else CareerTheme.T_DIM, accent)
	t.text = String(c["titulo"])
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.clip_text = true
	if not tumbada:
		CareerUi.autoshrink(t, 10)
	v.add_child(t)
	var letra: int = CareerTheme.T_LEE_TUMBADO if tumbada else CareerTheme.T_DIM
	var lado: float = 32.0 if tumbada else 20.0
	var filas: Array = c["filas"]
	var equipos: Array = []
	for f in filas:
		equipos.append((f as Dictionary)["team"])
	var siglas: Array = c["siglas"] if c.has("siglas") else _torn_siglas_unicas(equipos)




	var filas_t: Array = c.get("filas_t", [])
	var columnas: bool = llena and filas_t.size() == filas.size()
	var anchos: Dictionary =(c["anchos"] if c.has("anchos") else _grupo_col_anchos(letra, [c])) \
			if columnas else {}
	if columnas:
		pan.set_meta("grupo_anchos", anchos)
		pan.set_meta("grupo_columnas", "nada")
		var cab: HBoxContainer = HBoxContainer.new()
		cab.add_theme_constant_override("separation", 4)
		cab.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var marco_cab: PanelContainer = _grupo_fila_marco(cab, false, false)
		marco_cab.name = "GrupoCab"
		marco_cab.visible = false
		v.add_child(marco_cab)


		var bajo: Control = Control.new()
		bajo.custom_minimum_size.x = 8.0 + GRUPO_FRANJA_AIRE + lado
		bajo.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cab.add_child(bajo)
		var hueco_cab: Control = Control.new()
		hueco_cab.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		hueco_cab.mouse_filter = Control.MOUSE_FILTER_IGNORE
		cab.add_child(hueco_cab)
		for k in GRUPO_COLUMNAS:
			cab.add_child(_grupo_celda(I18n.t(String(GRUPO_COL_ROTULO[k]), "tabla_liga"),
				String(k), _grupo_col_ancho(anchos, String(k)),
				letra, CareerTheme.TEXT_DIM))
		var cab_pts: Label = _grupo_celda(I18n.t("PTS", "tabla_liga"), "", float(anchos["pts"]),
			letra, CareerTheme.TEXT_DIM)
		cab_pts.visible = true
		cab.add_child(cab_pts)
	for i in filas.size():
		var f: Dictionary = filas[i]
		var you: bool = bool(f["you"])




		var col: Color = accent if you and not tumbada else CareerTheme.TEXT
		var fila: HBoxContainer = HBoxContainer.new()
		fila.add_theme_constant_override("separation", 4)
		fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if tumbada:
			v.add_child(_grupo_fila_marco(fila, you, llena))
		else:
			if llena:
				fila.size_flags_vertical = Control.SIZE_EXPAND_FILL
			v.add_child(fila)
		var franja: ColorRect = ColorRect.new()
		franja.color = _grupo_franja(i, int(c["pasan"]), bool(c.get("tercero_pasa", false)),
			accent)
		franja.custom_minimum_size = Vector2(8.0 if tumbada else 3.0, lado)
		franja.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if bool(c.get("tercero_pasa", false)) and i == int(c["pasan"]):
			franja.set_meta("grupo_tercero_pasa", true)
		fila.add_child(franja)
		if tumbada:

			var aire_franja: Control = Control.new()
			aire_franja.name = "AireFranja"
			aire_franja.custom_minimum_size.x = GRUPO_FRANJA_AIRE - 8.0
			aire_franja.mouse_filter = Control.MOUSE_FILTER_IGNORE
			fila.add_child(aire_franja)
		var team: Dictionary = f["team"]
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(lado, lado)
		crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		crest.mouse_filter = Control.MOUSE_FILTER_IGNORE
		crest.set_team(team)
		fila.add_child(crest)
		var nom: Label = CareerUi.plain(letra, col)
		nom.text = String(siglas[i])
		nom.set_meta("grupo_sigla", true)
		nom.set_meta("grupo_team", team)
		if tumbada:

			nom.set_meta("grupo_sigla_txt", nom.text)
			nom.set_meta("grupo_nombre_corto", _torn_nombre_de(String(team.get("id",
				team.get("name", "")))))
			nom.set_meta("grupo_forma", "sigla")
		nom.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		nom.clip_text = true
		nom.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		fila.add_child(nom)
		if columnas:

			fila.set_meta("grupo_fila", true)
			var ft: Dictionary = filas_t[i]
			for k in GRUPO_COLUMNAS:
				var n: int = int(ft.get(String(k), 0))
				var txt: String =("+%d" % n) if String(k) == "dif" and n > 0 else str(n)
				fila.add_child(_grupo_celda(txt, String(k),
