func _ct_t_estatus() -> Dictionary:
	var edge: float = float(Career.standing().get("edge", 0.0))
	var a: float = Standing.ROLE_CUTS[0]
	var b: float = Standing.ROLE_CUTS[Standing.ROLE_CUTS.size() - 1]
	return {"rotulo": I18n.t(Standing.role_name(edge)),
		"frac": clampf((edge - a) / maxf(b - a, 0.001), 0.0, 1.0)}


