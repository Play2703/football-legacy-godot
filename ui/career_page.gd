func _torn_row(rank: int, row: Dictionary, key: String, dup: bool, accent: Color,
		show_apps: bool = false) -> void:
	var you: bool = bool(row["you"])
	var color: Color = accent if you else CareerTheme.TEXT
	var line: HBoxContainer = HBoxContainer.new()
	line.add_theme_constant_override("separation", 10)
	_content.add_child(line)
	var pos_l: Label = CareerUi.plain(CareerTheme.T_BODY, color)
	pos_l.text = "%2d." % rank
	pos_l.custom_minimum_size = Vector2(52, 0)
	pos_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(pos_l)


	var team: Dictionary = Teams.by_id(String(row["team"]))
	if team.is_empty():
		team = Nations.as_team(String(row["team"]))
	if not team.is_empty():
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(30, 30)
		crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		crest.set_team(team)
		line.add_child(crest)
	var name_l: Label = CareerUi.plain(CareerTheme.T_BODY, color)



	var shown: String = String(row["name"])
	if not you and dup and not team.is_empty():
		shown = "%s · %s" % [shown, BRACKET_TREE.sigla_legible(team)]
	name_l.text = shown
	name_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	name_l.clip_text = true
	name_l.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	name_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(name_l)





	if bool(row.get("hot", false)):
		line.add_child(CareerUi.hot_tag())
	if show_apps:
		var apps_l: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT_DIM)
		apps_l.text = str(int(row.get("apps", 0)))
		apps_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		apps_l.custom_minimum_size = Vector2(TBL_NUM_W, 0)
		apps_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		line.add_child(apps_l)
	var val_l: Label = CareerUi.plain(CareerTheme.T_BODY, color)
	val_l.text =("%.1f" % float(row["val"])) if key == "avg" else str(int(row["val"]))
	val_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	val_l.custom_minimum_size = Vector2(TBL_NUM_W, 0) if show_apps else Vector2(0, 0)
	val_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(val_l)






