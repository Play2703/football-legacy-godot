	_torn_tabs(list)
	_torn_pinta(accent)




func _torn_pinta(accent: Color) -> void:
	match _torn_comp:
		"liga":
			_torn_liga(accent)
		"champions":
			_torn_continental("champions", "ucl", GameState.ucl_state, accent)
		"europa":
			_torn_continental("europa", "eul", GameState.eul_state, accent)
		"conference":
			_torn_continental("conference", "conf", GameState.conf_state, accent)



		"libertadores", "sudamericana", "concacaf", "oriente", "sol", "atlas", "baobab", "coral":
			var clave: String = Continental.comp_de_marca(_torn_comp)
			_torn_continental(_torn_comp, clave, GameState.euro_state(clave), accent)
		"copa":
			_torn_copa(accent)

		"copaliga":
			_torn_copa(accent, CopaLiga.COMP)


		"ligas":
			_torn_copa(accent, CopaLigas.COMP)
		"cwc":
			_torn_cwc(accent)
		"nat":
			_torn_nat(accent)






func _torn_list() -> Array:



	var list: Array = ["liga", "champions", "europa", "conference", "copa", "cwc"]



	if not GameState.copaliga_state.is_empty():
		list.insert(list.find("copa") + 1, "copaliga")


	if _torn_juegas_ligas():
		list.insert(list.find("cwc"), CopaLigas.COMP)








	var amer: Array = []
	for c in Continental.copas_de_pais(Teams.country_of(GameState.player_team_id)):
		amer.append(Continental.marca(String(c)))
	for c in Continental.AMER_COMPS:
		var marca: String = Continental.marca(String(c))
		if not amer.has(marca) and bool(GameState.euro_state(String(c)).get("playing", false)):
			amer.append(marca)
	for i in amer.size():
		list.insert(1 + i, amer[i])
	if not Career.nationality.is_empty():
		list.append("nat")
	return list




func _torn_nat_kind() -> String:
	return NatTeam.season_kind(GameState.season_num)









func _torn_accent(comp: String, country: String) -> Color:
	var raw: Color
	match comp:
		"liga":
			raw = Teams.accent(country)
		"cwc":
			raw = Competitions.COMP_ACCENT.get("mundial", CareerTheme.MONEY)
		"nat":


			raw = Competitions.COMP_ACCENT.get("mundial", CareerTheme.MONEY)

		"copaliga":
			raw = Competitions.COMP_ACCENT.get("copa", CareerTheme.accent())
		_:
			raw = Competitions.COMP_ACCENT.get(comp, CareerTheme.accent())
	return CareerTheme.text_on_dark(raw)




func _torn_logo(comp: String, country: String) -> String:
	match comp:
		"liga":

			return Competitions.league_div_logo(country, _torn_div)
		"cwc":



			return "clubes"
		"nat":
			return "clasif" if _torn_nat_kind() == "qual" else "mundial"


		"copa", "copaliga":
			var tid: String = Competitions.trofeo_id(comp,
				Teams.country_of(GameState.player_team_id))
			return tid if not tid.is_empty() and CompLogos.has(tid) else "copa"
		_:
			return comp




func _torn_short(comp: String) -> String:









	var puesto: String = Competitions.pack_short(comp, 10)
	if not puesto.is_empty():
		return puesto
	var fake: bool = Teams.fake_names_on()
	match comp:
		"liga": return I18n.t("LIGA", "tab")
		"champions": return I18n.t("COPA EU" if fake else "CHAMP", "tab")
		"europa": return I18n.t("COPA C." if fake else "EUROPA", "tab")
		"conference": return I18n.t("COPA 3" if fake else "CONFER.", "tab")
		"copa": return I18n.t("COPA", "tab")
		"copaliga": return I18n.t("C. LIGA", "tab")
		"ligas": return I18n.t("C. LIGAS", "tab")
		"cwc": return I18n.t("CLUBES", "tab")


		"libertadores": return I18n.t("GLORIA", "tab")
		"sudamericana": return I18n.t("SUR", "tab")
		"concacaf": return I18n.t("NORTE", "tab")
		"oriente": return I18n.t("ORIENTE", "tab")
		"sol": return I18n.t("SOL", "tab")
		"atlas": return I18n.t("ATLAS", "tab")
		"baobab": return I18n.t("BAOBAB", "tab")


		"coral": return I18n.t("CORAL", "tab")
		"nat":
			match _torn_nat_kind():
				"wc": return I18n.t("MUNDIAL", "tab")
				"cont": return I18n.t("CONTIN.", "tab")
				_: return I18n.t("CLASIF", "tab")
	return comp.to_upper()











