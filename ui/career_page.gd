func _pl_t_frases(texto: String) -> PackedStringArray:
	var out: PackedStringArray = []
	for p in texto.split(". ", false):
		var f: String = String(p).strip_edges()
		if f.is_empty():
			continue
		out.append(f if f.ends_with(".") or f.ends_with("!") or f.ends_with("?") else f + ".")
	return out


