func _ley_cards_below_you(rows: Array) -> void:
	var ref: int = 0
	var ref_g: int = -1
	for e in rows:
		if bool((e as Dictionary).get("user", false)):
			ref = Legends.total(e)
			ref_g = int((e as Dictionary).get("goles", -1))
	for e in rows:
		var d: Dictionary = e
		var mark: int = _ley_mark(d, Legends.total(d), ref)
		if ref_g >= 0 and not bool(d.get("user", false)):
			var t: int = Legends.total(d)
			var g: int = int(d.get("goles", 0))
			mark = LEY_MARK_PASSED if t <= ref and g <= ref_g and (t < ref or g < ref_g) \
					else LEY_MARK_NONE
		_legend_card(d, 0, mark)




