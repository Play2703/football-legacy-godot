var _map_stage_frame: int = -1


func _map_stage_block(items: Array, vista: String, alto: int,
		tocable: bool = false) -> void:
	var holder: Control = Control.new()
	holder.custom_minimum_size = Vector2(0, alto)
	holder.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.clip_contents = true
	_content.add_child(holder)
	if StadiumStage.headless():
		var flat: ShotMapView = ShotMapView.new()
		flat.mode = "porteria" if vista == "marco" else vista
		flat.set_anchors_preset(Control.PRESET_FULL_RECT)
		if vista == "pases":
			flat.set_passes(items)
		else:
			flat.set_shots(items)
		holder.add_child(flat)
		return
	var stage: ShotStage = ShotStage.new()
	stage.view = vista
	if vista == "pases":
		stage.passes = items
	else:
		stage.shots = items
	stage.club = Teams.by_id(GameState.player_team_id)
	stage.div = GameState.player_div()
	stage.att = 0.8
	stage.weather_id = "day"
	stage.set_anchors_preset(Control.PRESET_FULL_RECT)






	if _map_stage_frame == Engine.get_process_frames():
		var arbol: SceneTree = get_tree()
		await arbol.process_frame
		if not is_inside_tree() or not is_instance_valid(holder) \
				or holder.is_queued_for_deletion() or not holder.is_inside_tree():
			stage.free()
			return
	_map_stage_frame = Engine.get_process_frames()
	holder.add_child(stage)
	if not tocable:
		return
	stage.mark_picked.connect(_on_map_pick.bind(stage, items))



	if _map_pick >= 0 and _map_pick < items.size():
		stage.open_mark(_map_pick)






func _on_map_pick(index: int, stage: ShotStage, items: Array) -> void:
	_map_pick = index
	if is_instance_valid(stage):
		stage.open_mark(index)
	_fill_map_card(items)




func _map_card_box(items: Array) -> void:
	_map_card = VBoxContainer.new()
	_map_card.add_theme_constant_override("separation", 6)
	_map_card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_content.add_child(_map_card)
	_fill_map_card(items)








func _fill_map_card(items: Array) -> void:
	if _map_card == null or not is_instance_valid(_map_card):
		return
	for c in _map_card.get_children():
		c.queue_free()
	if _map_pick < 0 or _map_pick >= items.size():
		CareerUi.dim(_map_card, I18n.t("Toca una marca del campo para ver la"
			+ " jugada."))
		return
	var d: Dictionary = items[_map_pick] as Dictionary
	var o: String = String(d.get("o", ""))
	var card: PanelContainer = CareerUi.chip()
	card.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_map_card.add_child(card)
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 3)
	card.add_child(col)

	var titulo: Label = CareerUi.plain(CareerTheme.T_CARD, _map_card_color(o))
	titulo.text = I18n.t(PassBook.label_of(o) if _map_kind == "pases"
		else ShotBook.label_of(o))
	titulo.clip_text = true
	col.add_child(titulo)



	var trozos: PackedStringArray = PackedStringArray()
	var rid: String = String(d.get("r", ""))
	if not rid.is_empty():
		var nombre: String = String(Teams.by_id(rid).get("name", ""))
		if not nombre.is_empty():
			trozos.append(Competitions.demarca(nombre))
	var minuto: int = int(d.get("m", 0))
	if minuto > 0:
		trozos.append(I18n.tf("min {0}", [minuto]))



	var jugada: String = String(d.get("k", ""))
	if not jugada.is_empty():
		trozos.append(I18n.t(ShotBook.play_label(jugada), "tabla"))


	var comp: String = String(d.get("c", ""))
	if not comp.is_empty():
		trozos.append(Competitions.comp_name(comp))
	var sub: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
	sub.text = " · ".join(trozos)
	sub.clip_text = true
	col.add_child(sub)

	var metros: float = PassBook.dist(d) if _map_kind == "pases" else ShotBook.dist(d)
	var m: Label = CareerUi.plain(CareerTheme.T_MONEY, CareerTheme.MONEY)
	m.text = I18n.tf("{0} m", ["%.1f" % metros])
	col.add_child(m)




func _map_card_color(o: String) -> Color:
	if o == "goal":
		return CareerTheme.MONEY
	if _map_kind == "pases":
		if o in PassBook.ANULADO:
			return CareerTheme.DANGER
		return CareerTheme.TEXT if o in PassBook.REMATE \
				else Color(CareerTheme.TEXT, 0.7)
	if o in ShotBook.FUERA:
		return CareerTheme.DANGER
	return CareerTheme.TEXT if o in ShotBook.A_PUERTA \
			else Color(CareerTheme.TEXT, 0.7)














func _play_chips(cubos: Array, goles: bool) -> void:
	if cubos.size() < 2:
		_map_play = "*"
		return
	var hay: bool = false
	for c in cubos:
		if String((c as Dictionary)["play"]) == _map_play:
			hay = true
			break
	if not hay:
		_map_play = "*"
	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	_content.add_child(row)
	for c in cubos:
		var cubo: Dictionary = c as Dictionary
		var t: Dictionary = cubo["tally"] as Dictionary
		var play: String = String(cubo["play"])



		var valor: String = "%d/%d" % [
			int(t["gol"]) if goles else int(t["asis"]), int(t["total"])]
		_stat_chip(row, I18n.t(String(cubo["label"]), "tabla"), valor,
			CareerTheme.MONEY if play == "penal" else CareerTheme.TEXT)
		var chip: Control = row.get_child(row.get_child_count() - 1) as Control
		if _map_play != "*" and _map_play != play:



			chip.modulate = CareerTheme.MUTED
		var hit: Button = Button.new()
		hit.flat = true
		hit.set_anchors_preset(Control.PRESET_FULL_RECT)
		hit.focus_mode = Control.FOCUS_NONE
		hit.pressed.connect(_on_map_play.bind(play))
		chip.add_child(hit)




func _on_map_play(play: String) -> void:
	_map_play = "*" if _map_play == play else play
	_map_pick = -1
	_refresh()



func _by_play(items: Array) -> Array:
	if _map_play == "*":
		return items
	if _map_kind == "pases":
		return PassBook.only_play(items, _map_play)
	return ShotBook.only_play(items, _map_play)





func _play_note() -> String:
	if _map_play == "*":
		return ""
	return I18n.tf(" · sólo {0}", [I18n.t(ShotBook.play_label(_map_play), "tabla")])











func _map_chip(parent: Container, caption: String, value: String, color: Color,
		key: String) -> void:
	_stat_chip(parent, caption, value, color)
	var chip: Control = parent.get_child(parent.get_child_count() - 1) as Control
	if not _map_filter.is_empty() and _map_filter != key:



		chip.modulate = CareerTheme.MUTED
	var hit: Button = Button.new()
	hit.flat = true
	hit.set_anchors_preset(Control.PRESET_FULL_RECT)
	hit.focus_mode = Control.FOCUS_NONE
	hit.pressed.connect(_on_map_filter.bind(key))
	chip.add_child(hit)





func _on_map_filter(key: String) -> void:
	_map_filter = "" if _map_filter == key else key
	_map_pick = -1
	_refresh()




func _filter_note(total: int, vistos: int) -> void:
	if _map_filter.is_empty():
		return
	CareerUi.dim(_content, I18n.tf("Viendo {0} de {1} · toca otra vez el chip para"
		+ " verlo todo", [vistos, total]))


func _filter_shots(shots: Array) -> Array:
	if _map_filter.is_empty():
		return shots
	var out: Array = []
	for s in shots:
		var o: String = String((s as Dictionary).get("o", ""))
		var pasa: bool = false
		match _map_filter:
			"gol":
				pasa = o == "goal"
			"puerta":
				pasa = o in ShotBook.A_PUERTA
			"fuera":
				pasa = o in ShotBook.FUERA
		if pasa:
			out.append(s)
	return out


func _filter_passes(passes: Array) -> Array:
	if _map_filter.is_empty():
		return passes
	var out: Array = []
	for p in passes:
		var o: String = String((p as Dictionary).get("o", ""))
		var pasa: bool = false
		match _map_filter:
			"asis":
				pasa = o == "goal"
			"remate":
				pasa = o in PassBook.REMATE
			"seco":
				pasa = not (o in PassBook.REMATE) and not (o in PassBook.ANULADO)
		if pasa:
			out.append(p)
	return out













func _shot_side_line(shots: Array) -> void:
	var mejor: Dictionary = {}
	var peor: Dictionary = {}
	for b in ShotBook.by_side(shots):
		var banda: Dictionary = b as Dictionary
		var t: Dictionary = banda["tally"] as Dictionary
		if int(t["medidos"]) < ShotBook.SIDE_MIN:
			continue
		if mejor.is_empty() or float(t["pct_gol"]) > float((mejor["tally"] as Dictionary)["pct_gol"]):
			mejor = banda
		if peor.is_empty() or float(t["pct_gol"]) < float((peor["tally"] as Dictionary)["pct_gol"]):
			peor = banda
	if mejor.is_empty():
		return
	var linea: String = I18n.tf("{0}: {1}", [I18n.t(String(mejor["label"]), "tabla"),
		_uno_de_cada((mejor["tally"] as Dictionary))])
	if not peor.is_empty() and peor["label"] != mejor["label"]:
		linea += " · " + I18n.tf("{0}: {1}", [I18n.t(String(peor["label"]), "tabla"),
			_uno_de_cada((peor["tally"] as Dictionary))])
	CareerUi.dim(_content, linea)



func _uno_de_cada(t: Dictionary) -> String:
	var goles: int = int(t["gol"])
	var medidos: int = int(t["medidos"])
	if goles <= 0:
		return I18n.tf("ninguno en {0}", [medidos])
	return I18n.tf("1 de cada {0}", [maxi(roundi(float(medidos) / float(goles)), 1)])




func _pass_side_line(passes: Array) -> void:
	var mejor: Dictionary = {}
	for b in PassBook.by_side(passes):
		var banda: Dictionary = b as Dictionary
		var t: Dictionary = banda["tally"] as Dictionary
		if int(t["medidos"]) < PassBook.SIDE_MIN:
			continue
		if mejor.is_empty() or float(t["pct_asis"]) > float((mejor["tally"] as Dictionary)["pct_asis"]):
			mejor = banda
	if mejor.is_empty():
		return
	var t2: Dictionary = mejor["tally"] as Dictionary
	if int(t2["asis"]) <= 0:
		return
	CareerUi.dim(_content, I18n.tf("Tus asistencias salen sobre todo {0}:"
		+ " {1} de {2}", [I18n.t(String(mejor["label"]), "tabla"),
			int(t2["asis"]), int(t2["medidos"])]))




func _move_side_line(moves: Array) -> void:
	var celda: int = MoveBook.worst_cell(moves)
	if celda < 0:
		return
	var r: Array = MoveBook.cell_rect(celda)
	var cx: float =(float(r[0]) + float(r[2])) * 0.5
	var cz: float =(float(r[1]) + float(r[3])) * 0.5
	var banda: String = "POR EL CENTRO"
	if cx < - ShotBook.SIDE_M:
		banda = "POR LA IZQUIERDA"
	elif cx > ShotBook.SIDE_M:
		banda = "POR LA DERECHA"

	var tercio: String = "en tu propio campo"
	if cz <= MoveBook.DEPTH / 3.0:
		tercio = "en el último tercio"
	elif cz <= MoveBook.DEPTH * 2.0 / 3.0:
		tercio = "en el medio campo"
	CareerUi.dim(_content, I18n.tf("Donde más te la quitan: {0}, {1}.",
		[I18n.t(banda, "tabla"), I18n.t(tercio)]))







func _map_selector(idx: int, seasons: Array) -> void:
