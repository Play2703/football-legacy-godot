func _value_curve(curve: Array, peak: int) -> void:
	var points: Array = []
	for h in curve:
		var sn: int = int(h.get("season", 0))
		var val: int = int(h.get("value", 0))
		var p: Dictionary = {"label": I18n.tf("T{0}", [sn]),
			"text": _money_short(val), "value": val, "gold": true}
		if not points.is_empty() and String(points[-1]["label"]) == String(p["label"]):
			points[-1] = p
		else:
			points.append(p)
	_curve_bars(points, peak)










func _curve_bars(points: Array, peak: int) -> void:
	var row: HBoxContainer = HBoxContainer.new()











	var n: int = points.size()
	var body: int = 14
	var sep: int = 6
	if n > 20:



		body = 8
		sep = 2
	elif n > 16:
		body = 10
		sep = 2
	elif n > 13:
		body = 11
		sep = 3
	elif n > 10:
		body = 12
		sep = 4
	row.add_theme_constant_override("separation", sep)
	row.custom_minimum_size = Vector2(0, 156)
	_content.add_child(row)
	var pk: int = maxi(peak, 1)
	for p in points:
		var col: VBoxContainer = VBoxContainer.new()
		col.add_theme_constant_override("separation", 3)
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_child(col)
		var val_l: Label = CareerUi.plain(body,
			CareerTheme.MONEY if bool(p.get("gold", false)) else CareerTheme.TEXT)
		val_l.text = String(p["text"])
		val_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		val_l.clip_text = true
		col.add_child(val_l)
		var bar_holder: Control = Control.new()
		bar_holder.custom_minimum_size = Vector2(0, 100)
		bar_holder.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		bar_holder.size_flags_vertical = Control.SIZE_EXPAND_FILL
		col.add_child(bar_holder)
		_curve_barra(bar_holder, p, pk, CareerTheme.accent())
		var lbl: Label = CareerUi.plain(body, CareerTheme.TEXT_DIM)
		lbl.text = String(p["label"])
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		lbl.clip_text = true
		col.add_child(lbl)







func _curve_barra(holder: Control, p: Dictionary, pk: int, color: Color) -> void:







	var frac: float = clampf(sqrt(float(int(p["value"])) / float(pk)), 0.06, 1.0)
	var segs: Array =(p.get("segments", []) as Array).filter(
		func(s: Dictionary) -> bool: return int(s["goals"]) > 0)
	if segs.size() >= 2:







		var total: float = float(int(p["value"]))
		var acum: float = 0.0
		for s in segs:
			var seg_bar: ColorRect = ColorRect.new()
			var team: Dictionary = Teams.by_id(String(s["club"]))
			seg_bar.color = CareerTheme.accent() if team.is_empty() \
					else CareerTheme.accent_of(team)
			seg_bar.anchor_left = 0.15
			seg_bar.anchor_right = 0.85
			seg_bar.anchor_bottom = 1.0 - acum
			acum += frac * float(int(s["goals"])) / total
			seg_bar.anchor_top = 1.0 - acum
			if acum < frac - 0.001:



				seg_bar.offset_top = 1.0
			holder.add_child(seg_bar)
	else:
		var bar: ColorRect = ColorRect.new()
		bar.color = color
		bar.anchor_left = 0.15
		bar.anchor_right = 0.85
		bar.anchor_top = 1.0 - frac
		bar.anchor_bottom = 1.0
		holder.add_child(bar)












func _goals_curve() -> void:
	var grupos: Array = Career.goals_by_season()



	if grupos.size() < 2:
		return
	var points: Array = []
	var peak: int = 0
	for g in grupos:
		var total: int = int(g["total"])
		peak = maxi(peak, total)



		var curr: bool = int(g["season"]) == GameState.season_num
		points.append({"label": I18n.tf("T{0}", [int(g["season"])]) +("*" if curr else ""),
			"text": str(total), "value": total, "gold": curr,
			"segments": g["segs"]})
	CareerUi.dim(_content, I18n.t("Goles por temporada"))
	_curve_bars(points, peak)



func _money_short(v: int) -> String:
	if v >= 1000000:
		var m: float = float(v) / 1000000.0
		return I18n.num(m, 0 if m >= 10.0 else 1) + "M"
	if v >= 1000:
		return I18n.num(float(v) / 1000.0) + "K"
	return str(v)


















