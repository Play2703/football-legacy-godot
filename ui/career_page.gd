func _torn_heroe_ko(champ: bool, alive: bool, ronda: int, names: Array, bracket: Array,
		fuera: String = "") -> bool:
	if champ:
		_torn_apunta_heroe(CareerTheme.caps(I18n.t("¡CAMPEÓN!")), "")
		return true
	if not alive:
		_torn_apunta_heroe(CareerTheme.caps(I18n.t("ELIMINADO")), fuera)
		return true
	if bracket.is_empty() or ronda < 0 or ronda >= names.size():
		return false
	var linea: String = ""
	if ronda < bracket.size():
		for t in bracket[ronda]:
			var d: Dictionary = t
			var a: String = String(d.get("a", ""))
			var b: String = String(d.get("b", ""))
			if String(d.get("winner", "")).is_empty() and (_torn_soy(a) or _torn_soy(b)):
				linea = I18n.tf("vs {0}", [_torn_nombre_de(b if _torn_soy(a) else a)])
				break



	_torn_apunta_heroe(CareerTheme.caps(I18n.t(String(TORN_RONDA_CORTA.get(String(names[ronda]),
		names[ronda])))), linea)
	return true




func _torn_heroe_euro(state: Dictionary) -> void:

	if _torn_capturando:
		_torn_captura["campo"] = state
	if _torn_heroe_ko(bool(state.get("champion", false)), bool(state.get("alive", true)),
			int(state.get("ko_idx", 0)), state.get("ko_names", []), state.get("bracket", []),
			"" if bool(state.get("advanced", false)) else _fuera_previa_text(state)):
		return
	var groups: Array = state.get("groups", [])
	for gi in groups.size():
		var g: Dictionary = groups[gi]
		var i: int = GameState.euro_group_order(g).find(GameState.YOU_KEY)
		if i < 0:
			continue
		var fila: Dictionary =(g.get("table", {}) as Dictionary).get(GameState.YOU_KEY, {})
		if _torn_sin_jugar(fila):
			_torn_apunta_heroe(_torn_j0(), _torn_linea_j0())
			return
		var pts: int = int(fila.get("pts", 0))
		var linea: String = I18n.tf("{0} PTS", [pts])
		if not bool(state.get("league_phase", false)):
			var letra: String = _torn_letra_grupo(gi)
			linea = I18n.tf("GRUPO {0}", [letra]) + " · " + linea



		_torn_apunta_heroe(_ordinal(i + 1), linea,
			_torn_forma(GameState.form_of_comp(GameState.YOU_KEY, _torn_clave())))
		return
	_torn_apunta_heroe("-", I18n.t("En juego"))




