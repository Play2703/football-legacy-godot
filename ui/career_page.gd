	nombre.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	nombre.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pila.add_child(nombre)
	CareerUi.letra_por_peldanos(nombre, [CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	nombre.max_lines_visible = 2
	nombre.resized.connect(_ti_t_nombre_ajusta.bind(nombre))
	var precio: String = String(d.get("precio", ""))
	if not precio.is_empty():
		var p: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, d.get("precio_col", CareerTheme.MONEY),
			precio)
		p.name = "Precio"
		p.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		p.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		pila.add_child(p)

		CareerUi.letra_por_peldanos(p, [CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	var chip: String = String(d.get("chip", ""))
	if not chip.is_empty():
		var c: PanelContainer = CareerUi.code_chip(CareerTheme.caps(chip),
			d.get("chip_col", CareerTheme.TEXT), CareerTheme.T_CAP_TUMBADO, 10.0, 4.0)
		c.name = "Chip"
		c.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		c.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pila.add_child(c)
	_ti_t_celdas.append(b)
	_ti_t_marca(b, id == String(_shop_sel.get(_shop_tab, "")) and not id.is_empty())
	return b





func _ti_t_nombre_ajusta(l: Label) -> void:
	if not is_instance_valid(l) or l.size.x <= 0.0:
		return
	var f: Font = l.get_theme_font("font")
	var cabe: bool = f == null or f.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0,
		l.get_theme_font_size("font_size")).x + 6.0 <= l.size.x
	var modo: TextServer.AutowrapMode = TextServer.AUTOWRAP_OFF if cabe \
			else TextServer.AUTOWRAP_WORD_SMART
	if l.autowrap_mode != modo:
		l.autowrap_mode = modo


		l.clip_text = cabe



func _ti_t_arte(d: Dictionary) -> Control:
	var merch: String = String(d.get("merch", ""))
	if not merch.is_empty():
		var m: Control = _merch_icon(merch)
		m.custom_minimum_size = Vector2(TI_T_FOTO, TI_T_FOTO)
		return m
	if d.has("pack"):
		return _caja_foto(d["pack"] as Dictionary, bool(d.get("destaca", false)))
	var foto: String = String(d.get("foto", d.get("id", "")))
	if not foto.is_empty() and ShopPhoto.tiene_modelo(foto):
		return ShopPhoto.rect(self, foto, TI_T_FOTO)
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(EN_T_ICONO, EN_T_ICONO)
	ic.setup(String(d.get("icono", "")), CareerTheme.TEXT)
	return ic



func _ti_t_marca(b: Button, on: bool) -> void:
	var sb: StyleBoxFlat = b.get_meta("sb", null) as StyleBoxFlat
	if sb == null:
		return
	var base: Array = b.get_meta("base", [])
	if on:
		sb.bg_color = CareerTheme.SURFACE_HI
		sb.border_color = CareerTheme.TEXT
		sb.set_border_width_all(3)
	elif base.size() == 3:
		sb.bg_color = base[0]
		sb.border_color = base[1]
		sb.set_border_width_all(int(base[2]))
	b.set_meta("ti_t_elegida", on)



func _ti_t_derecha(ancho: float) -> VBoxContainer:
	var col: VBoxContainer = VBoxContainer.new()
	col.name = "Derecha"
	col.custom_minimum_size.x = ancho
	col.size_flags_horizontal = Control.SIZE_FILL
	col.size_flags_vertical = Control.SIZE_EXPAND_FILL
	col.add_theme_constant_override("separation", TI_T_AIRE)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_ti_t_dock = col
	_ti_t_dock_repinta()
	return col



func _ti_t_dock_repinta() -> void:
	if _ti_t_dock == null or not is_instance_valid(_ti_t_dock):
		return
	for c in _ti_t_dock.get_children():
		_ti_t_dock.remove_child(c)
		c.queue_free()
	_ti_t_filas_dock = []
	var sel: String = String(_shop_sel.get(_shop_tab, ""))
	var celda_sel: Button = null
	for b in _ti_t_celdas:
		if not is_instance_valid(b):
			continue
		var es: bool = not sel.is_empty() and String(b.get_meta("ti_t_celda", "")) == sel
		_ti_t_marca(b, es)
		if es:
			celda_sel = b
	if celda_sel != null and _ti_t_celdas.find(celda_sel) != _ti_t_cursor:
		_ti_t_elige(_ti_t_celdas.find(celda_sel), false)
	var inf: Dictionary = _shop_infos.get(sel, {}) if not sel.is_empty() else {}
	if _shop_tab == "caja":
		if inf.has("producto"):
			_ti_t_dock_producto(inf["producto"] as Dictionary)
		else:
			_ti_t_dock_cartera()
	elif not inf.is_empty():
		_ti_t_dock_eleccion(inf)
		if sel == _shop_bought and celda_sel != null:
			_shop_bought = ""
			_celebrate_purchase(celda_sel, _shop_price_of(sel))
	else:
		_ti_t_dock_reposo()
	if sel.is_empty() and not _shop_bought.is_empty() and _shop_tab == "consumibles":
		_shop_bought = ""


	_ti_t_filas_vecinas()
	_ti_t_dock_vuelve()
	if not _ti_t_filas_dock.is_empty():
		_ti_t_elige_fila(clampi(_ti_t_fila_cursor, 0, _ti_t_filas_dock.size() - 1), false)





func _ti_t_filas_vecinas() -> void:
	var n: int = _ti_t_filas_dock.size()
	for i in n:
		var b: Button = _ti_t_filas_dock[i]
		b.focus_neighbor_top = b.get_path_to(_ti_t_filas_dock[i - 1] if i > 0 else b)
		b.focus_neighbor_bottom = b.get_path_to(_ti_t_filas_dock[i + 1] if i + 1 < n else b)
		b.focus_neighbor_right = b.get_path_to(b)
		b.focus_entered.connect(_ti_t_elige_fila.bind(i, false))


