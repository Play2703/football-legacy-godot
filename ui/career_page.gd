	return foto




















func _finish_swatch(a: Dictionary, zona: String) -> Control:
	var id: String = String(a["id"])
	var sw: PanelContainer = PanelContainer.new()
	sw.custom_minimum_size = Vector2(64, 64)
	sw.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	sw.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sb: StyleBoxFlat = StyleBoxFlat.new()



	sb.bg_color = a.get("color", CareerTheme.TEXT)


	sb.border_color = Color(CareerTheme.TEXT.r, CareerTheme.TEXT.g,
		CareerTheme.TEXT.b, 0.35)
	sb.set_border_width_all(2)
	sw.add_theme_stylebox_override("panel", sb)
	var tex: ColorRect = ColorRect.new()
	tex.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sm: ShaderMaterial = ShaderMaterial.new()
	sm.shader = load("res://ui/house/finish_swatch.gdshader")
	sm.set_shader_parameter("base", a.get("color", CareerTheme.TEXT))
	sm.set_shader_parameter("zona", 1 if zona != "floor" else 0)


	var tipo: int = 0
	if zona == "floor":
		tipo = House.floor_grano(id)
	elif zona == "wall":
		tipo = House.wall_grano(id)
	sm.set_shader_parameter("tipo", tipo)




	sm.set_shader_parameter("metros", 0.8 if zona == "wall" else 1.2)
	tex.material = sm
	sw.add_child(tex)
	return sw















func _house_extra_card(e: Dictionary, nuevo: bool = false) -> void:
	var id: String = String(e["id"])
	var owned: bool = Career.house_extras.has(id)



	var tengo: int = Career.house_extra_count(id)
	var price: int = int(e["price"])





	var retrato: Control = null
	if House.STYLE_PAL.has(id):
		retrato = _house_style_chip(id)
	elif House.es_fachada(id):


		retrato = _house_fachada_chip(id)
	else:
		retrato = _house_thumb(id)





	var candado: String = _casa_candado_de(e)
	var compra: Callable = Callable()
	var action: Control = null
	if owned and bool(e.get("multi", false)):


		compra = func() -> void:
			if Career.buy_house_copy(id):
				_casa_marca_recien(id)
				_refresh_keeping_scroll()
	elif owned:
		action = _shop_seal(I18n.t("INSTALADO"))






		if ["fachada", "estilo"].has(String(e.get("excl", ""))):
			var col_q: VBoxContainer = VBoxContainer.new()
			col_q.add_theme_constant_override("separation", 6)
			col_q.custom_minimum_size = Vector2(220, 0)
			col_q.add_child(action)
			col_q.add_child(_shop_action(I18n.t("QUITAR"), CareerTheme.Kind.WARN, false,
				func() -> void:
					_confirm(I18n.t("¿VOLVER A LA DE FÁBRICA?"),
						I18n.t("Se quita sin reembolso y la casa vuelve a la de fábrica."
						+ " Comprarla otra vez cuesta lo mismo."),
						I18n.t("QUITAR"), true, func() -> void:
							if Career.quitar_house_extra(id):
								_refresh_keeping_scroll())))
			action = col_q
	elif candado.is_empty():
		compra = func() -> void:



			var festejo: String = String(House.extra_by_id(id).get("festejo", ""))
			var estrena: bool = not festejo.is_empty() \
					and not Settings.celeb_desbloqueado(festejo)
			if Career.buy_house_extra(id):
				_casa_marca_recien(id)
				_refresh_keeping_scroll()
				if estrena and Settings.celeb_desbloqueado(festejo):
					_aviso_festejo(festejo)



				if bool(House.extra_by_id(id).get("pet", false)):
					(load("res://ui/house/pet_nombre.gd") as GDScript).call("abrir", self, id)
	var puede: bool = candado.is_empty() and Career.can_afford(price)
	if action == null:
		var b: Control = _shop_action("$ %s" % CareerUi.money(price),
			CareerTheme.Kind.NEUTRAL, not puede, compra)
		if owned:




			var col: VBoxContainer = VBoxContainer.new()
			col.add_theme_constant_override("separation", 6)
			col.custom_minimum_size = Vector2(220, 0)
			col.add_child(b)
			var otra: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.accent_text())
			otra.text = I18n.t("OTRA MÁS")
			otra.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			otra.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			col.add_child(otra)
			b = col


		action = _con_falta(b, price) if candado.is_empty() else b




	var info: VBoxContainer = _shop_card(I18n.t(String(e["name"])),
		String(e.get("icon", "estilo")), [], I18n.t(String(e["desc"])), owned, action,
		0, "", "", "", retrato)



	if nuevo:
		var tag: PanelContainer = PanelContainer.new()
		var ac: Color = CareerTheme.accent()
		tag.add_theme_stylebox_override("panel",
			CareerTheme.tag(Color(ac.r, ac.g, ac.b, 0.18)))
		tag.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		var tl: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.accent_text())
		tl.text = I18n.t("NUEVO")
		tag.add_child(tl)
		info.add_child(tag)
		info.move_child(tag, 1)
	var up: int = int(e.get("upkeep", 0))
	if up > 0:
		var upl: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.DANGER)
		upl.text = I18n.tf("Mantenimiento: -{0} por partido", [CareerUi.money(up)])
		upl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		info.add_child(upl)


	if tengo > 0 and bool(e.get("multi", false)):
		var have: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.MONEY)
		have.text = I18n.tf("TIENES {0}", [str(tengo)])
		have.clip_text = true
		info.add_child(have)
	var rest: float = float(e.get("rest_raw", 0.0))
	if rest > 0.0 and not owned:
		var neto: float = Career.rest_delta_for(rest)
		if neto > 0.05:
			var rl: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT)
			rl.text = I18n.tf("Suma +{0} de energía tras cada partido.",
				[String.num(neto, 1)])
			rl.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			info.add_child(rl)




	var lado_min: float = float(e.get("lado_min", 0.0))
	if not owned and House.lado_of(Career.land_tier) < lado_min:
		var ll: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.DANGER)
		ll.text = I18n.tf("Sólo cabe en el jardín de un solar de {0} x {0} o más.",
			[str(int(lado_min))])
		ll.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		info.add_child(ll)
	if not candado.is_empty():
		info.add_child(_casa_candado(candado))
	elif not puede and compra.is_valid():



		var cuando: String = CareerUi.price_in_matches(price - Career.money,
			int(Career.contract.get("wage", 0)))
		if not cuando.is_empty():
			CareerUi.dim(info, cuando)







	var estrenado: bool = not owned and Career.house_extras_estrenados.has(id) \
			and not (e.get("rel", {}) as Dictionary).is_empty()
	if estrenado:
		var ya: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_MID)
		ya.text = I18n.t("Bono de relación ya estrenado: no vuelve a sumar.")
		ya.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		info.add_child(ya)
	if not owned and candado.is_empty():
		var pitch: String = House.extra_pitch(e, Career.energy,
			{} if estrenado else Career.rel)
		if not pitch.is_empty():
			var tip: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.accent_text())
			tip.text = I18n.t(pitch)
			tip.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			info.add_child(tip)




	var recien: String = String(_casa_recien.get("iid", ""))
	if String(_casa_recien.get("extra", "")) == id and not recien.is_empty() \
			and not House.item_puesto(recien):
		var col_b: Button = Button.new()
		col_b.text = I18n.t("COLOCAR AHORA")
		col_b.custom_minimum_size = Vector2(0, CareerTheme.BTN_ROW_H)
		col_b.clip_text = true
		CareerTheme.apply_button(col_b, CareerTheme.Kind.PRIMARY, 20)
		col_b.pressed.connect(func() -> void:
			House.colocar_al_entrar = recien
			_casa_recien = {}
			SceneFade.to_scene("res://ui/house/house.tscn"))
		info.add_child(col_b)





