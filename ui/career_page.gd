func _pr_baldosa(nombre: String, icono: Control, rotulo: String, monto: int, alto: float,
		cb: Callable, apilada: bool, chip: String = "") -> Button:
	var t: bool = UiKit.es_horizontal()
	var px_v: int = CareerTheme.T_LEE_TUMBADO if t else CareerTheme.T_MONEY
	var valor: String = "$ %s" % CareerUi.money(monto)
	var b: Button = Button.new()
	b.name = nombre
	b.custom_minimum_size = Vector2(0.0, alto)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, CareerTheme.T_CAP_TUMBADO)
	b.set_meta("pr_monto", monto)
	b.pressed.connect(cb)
	var relleno: MarginContainer = CareerUi._relleno_boton(b, 16, 8)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "Fila"
	fila.add_theme_constant_override("separation", 12)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	relleno.add_child(fila)
	icono.custom_minimum_size = Vector2(PR_ICONO, PR_ICONO)
	icono.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	icono.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(icono)
	var r: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID,
		CareerTheme.caps(rotulo))
	r.name = "Rotulo"
	var v: Label = _mk_t_label(px_v, CareerTheme.MONEY, valor)
	v.name = "Valor"
	if apilada:
		var txt: VBoxContainer = VBoxContainer.new()
		txt.name = "Texto"
		txt.add_theme_constant_override("separation", 8)
		txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		txt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		txt.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fila.add_child(txt)


		r.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		txt.add_child(r)
		v.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		txt.add_child(v)
		if t:
			v.set_meta("peldano_corto", "$ %s" % CareerUi.short_money(monto))
			CareerUi.letra_por_peldanos(v, [px_v])
		else:
			CareerUi.autoshrink(v, CareerTheme.T_CAP_TUMBADO)
	else:
		r.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		r.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		fila.add_child(r)

		v.custom_minimum_size.x = _wnews_ancho(valor, px_v) + 4.0
		v.size_flags_horizontal = Control.SIZE_SHRINK_END
		v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		v.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		fila.add_child(v)
	if not chip.is_empty():
		var c: PanelContainer = CareerUi.code_chip(chip, CareerTheme.MONEY,
			CareerTheme.T_CAP_TUMBADO, 8.0, 2.0)
		c.name = "Pactada"
		c.mouse_filter = Control.MOUSE_FILTER_IGNORE
		c.anchor_left = 1.0
		c.anchor_right = 1.0
		c.offset_right = -12.0
		c.offset_top = 10.0
		c.grow_horizontal = Control.GROW_DIRECTION_BEGIN
		b.add_child(c)
	return b



func _pr_modal(titulo: String, monto: int, filas: Array, frase: String) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	box.name = "PrimasDetalle"
	if UiKit.es_horizontal():
		_pr_modal_tumbada(box, titulo, monto, filas, frase)
		return
	var tit: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.TEXT)
	tit.text = CareerTheme.caps(titulo)
	tit.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(tit)
	var cifra: Label = CareerUi.plain(CareerTheme.T_TITLE, CareerTheme.MONEY)
	cifra.name = "Cifra"
	cifra.text = "+$ %s" % CareerUi.money(monto)
	cifra.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(cifra)
	for f in filas:
		CareerUi.kv(box, String(f[0]), String(f[1]), f[2] as Color)
	var regla: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT_DIM)
	regla.text = frase
	regla.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(regla)
	var cerrar: Button = Button.new()
	cerrar.text = I18n.t("CERRAR")
	cerrar.custom_minimum_size = Vector2(0, 76)
	cerrar.clip_text = true
	CareerTheme.apply_button(cerrar, CareerTheme.Kind.NEUTRAL, CareerTheme.T_MONEY)
	cerrar.pressed.connect(func() -> void: CareerUi.close_modal(box))
	box.add_child(cerrar)






func _pr_modal_tumbada(box: VBoxContainer, titulo: String, monto: int, filas: Array,
		frase: String) -> void:
	box.add_theme_constant_override("separation", PF_T_AIRE_MODAL)
	_pf_t_modal_titulo(box, CareerTheme.caps(titulo), "moneda", CareerTheme.MONEY)
	var cifra: Label = _mk_t_label(CareerTheme.T_TITULO_TUMBADO, CareerTheme.MONEY,
		"+$ %s" % CareerUi.money(monto), false)
	cifra.name = "Cifra"
	cifra.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(cifra)
	for f in filas:
		var fila: HBoxContainer = HBoxContainer.new()
		fila.add_theme_constant_override("separation", 16)
		fila.custom_minimum_size.x = PF_T_PARRAFO_W
		fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
		box.add_child(fila)
		var k: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_MID,
			CareerTheme.caps(String(f[0])))
		k.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fila.add_child(k)
		var v: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, f[2] as Color, String(f[1]), false)
		v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		fila.add_child(v)
	var regla: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_DIM, frase, false)
	regla.name = "Regla"
	regla.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	regla.custom_minimum_size.x = PF_T_PARRAFO_W
	box.add_child(regla)
	_pf_t_modal_cerrar(box).set_meta(Entrada.PRIMERO_META, true)


func _pr_modal_titulo(d: Dictionary, wage: int) -> void:
	var filas: Array = [[I18n.t("FICHA"), "$ %s" % CareerUi.money(wage), CareerTheme.TEXT]]
	var m: float = float(d["mult"])
	if m > 1.0:
		filas.append([I18n.t("PACTADA"),
			I18n.t(ClausulasEditor.NIVELES[maxi(0, Clausulas.TITULO_MULT.find(m))]),
			CareerTheme.MONEY])
	_pr_modal(I18n.t(Competitions.comp_name(String(d["kind"]))), int(d["monto"]), filas,
		I18n.t("Se cobra al cierre de la temporada si el club gana el título."))


func _pr_modal_premio(d: Dictionary) -> void:
	var a: String = String(d["award"])
	_pr_modal(I18n.t(String(PR_PREMIO_ROTULO.get(a, a))), int(d["monto"]), [],
		I18n.t("Se cobra en cuanto ganas el premio."))


func _pr_modal_partido(es_gol: bool, v: Dictionary) -> void:
	var total: int = int(v["gol" if es_gol else "asist"])
	var pactada: int = int(v["gol_pactada" if es_gol else "asist_pactada"])
	var filas: Array = [[I18n.t("BASE"), "$ %s" % CareerUi.money(total - pactada),
		CareerTheme.TEXT]]
	if pactada > 0:
		filas.append([I18n.t("PACTADA"), "+$ %s" % CareerUi.money(pactada), CareerTheme.MONEY])
	_pr_modal(I18n.t("PRIMA POR GOL" if es_gol else "PRIMA POR ASISTENCIA"), total, filas,
		I18n.t("Se cobra en el partido, por cada gol que marques." if es_gol
			else "Se cobra en el partido, por cada asistencia que des."))


func _pr_modal_objetivo(prima: int) -> void:
	var tipo: String = String(Career.contract.get("obj_type", "goals"))
	var meta: int = int(Career.contract.get("obj_target", 0))
	var lleva: int = int(Career.contract.get("obj_progress", 0))
	var frase: String
	match tipo:
		"position":
			frase = I18n.tf("Termina {0} o mejor en la liga.", [_ordinal(meta)])
		"assists":
			frase = I18n.tf("Da {0} asistencias  (llevas {1})", [meta, lleva])
		"matches":
			frase = I18n.tf("Juega {0} partidos  (llevas {1})", [meta, lleva])
		"rating":
			frase = I18n.tf("Promedia {0} de nota  (llevas {1})",
				[I18n.num(float(meta) / 10.0, 1), I18n.num(float(lleva) / 10.0, 1)])
		_:
			frase = I18n.tf("Marca {0} goles  (llevas {1})", [meta, lleva])
	_pr_modal(I18n.t("OBJETIVO"), prima, [], frase + "\n"
		+ I18n.t("Se cobra al cierre de la temporada si cumples el objetivo."))


func _pr_modal_club(tope: int) -> void:
	var filas: Array = []
	for g in Career.club_goals_live():
		var gd: Dictionary = g as Dictionary
		var va: String
		var col: Color = CareerTheme.TEXT_MID
		if bool(gd.get("done", false)):
			va = I18n.t("CUMPLIDO")
			col = CareerTheme.MONEY
		elif bool(gd.get("failed", false)):
			va = I18n.t("FALLADO")
			col = CareerTheme.DANGER
		else:
			va = _club_goal_progress(gd, String(gd.get("comp", "league")))
		filas.append([_club_goal_ask(gd), va, col])
	_pr_modal(I18n.t("SI EL CLUB CUMPLE"), tope, filas,
		I18n.t("Se cobra al cierre de la temporada si el club cumple lo que pide."))


func _pr_modal_cobrado(cob: Dictionary) -> void:
	var total: int = 0
	var filas: Array = []
	for p in [["firma", "FIRMA"], ["goles", "GOLES"], ["premios", "PREMIOS"]]:
		var monto: int = int(cob.get(p[0], 0))
		total += monto
		filas.append([I18n.t(String(p[1])), "$ %s" % CareerUi.money(monto), CareerTheme.MONEY])
	_pr_modal(I18n.t("COBRADO"), total, filas,
		I18n.t("Lo que llevas cobrado en primas esta temporada."))



