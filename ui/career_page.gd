func _ti_t_datos() -> Array[Dictionary]:
	var datos: Array[Dictionary] = []
	match _shop_tab:
		"consumibles":
			for it in _con_oferta_primero(Shop.ITEMS, "item"):
				var d: Dictionary = it
				datos.append(_ti_t_dato_inf(_info_vestuario(d)) if d.has("rel")
					else _ti_t_dato_item(d))
		"estilo":
			datos.append(_ti_t_dato_vista("ropa", "camiseta", I18n.t("ROPA DE CALLE")))
			if not KitRecolor.PIEZAS_PROPIAS.group("hair").is_empty() \
					or not KitRecolor.PIEZAS_PROPIAS.group("beard").is_empty():
				datos.append(_ti_t_dato_vista("pelu", "scissors", I18n.t("PELUQUERÍA")))
			for l in _con_oferta_primero(Shop.LIFESTYLE, "lifestyle"):
				if not House.COCHES.has(String(l["id"])):
					datos.append(_ti_t_dato_inf(_info_estilo(l as Dictionary)))
		"inversiones":
			var sig: Dictionary = Shop.agent_next(Career.agent_level)
			if not sig.is_empty():
				datos.append(_ti_t_dato_inf(_info_agente(sig)))
			for v in Shop.INVESTMENTS:
				datos.append(_ti_t_dato_inf(_info_inversion(v as Dictionary)))
		"club":
			for m in Shop.merch_catalog(GameState.player_div()):
				datos.append(_ti_t_dato_inf(_info_merch(m as Dictionary)))
			if not Career.jersey_table().is_empty():
				datos.append({"id": "_vendidas", "titulo": I18n.t("LAS MÁS VENDIDAS"),
					"icono": "camiseta", "chip": I18n.tf("{0} AL AÑO",
						[CareerUi.short_money(Career.jersey_volume())]),
					"chip_col": CareerTheme.TEXT_MID, "al_tocar": _ti_t_vendidas_modal})
		"caja":
			for p in _ti_t_productos():
				datos.append(_ti_t_dato_producto(p))
		_:
			for b in _con_oferta_primero(Shop.BOOTS, "boots"):
				datos.append(_ti_t_dato_inf(_info_bota(b as Dictionary)))
	return datos



func _ti_t_dato_inf(inf: Dictionary) -> Dictionary:
	var id: String = String(inf["id"])
	_shop_infos[id] = inf
	var fam: String = String(inf.get("fam", _shop_tab))
	var tag: Dictionary = inf.get("tag", {})
	var precio: String = String(inf.get("price", ""))
	var d: Dictionary = {"id": id, "inf": inf, "titulo": String(inf["title"]),
		"icono": String(inf.get("icon", "")), "merch": String(inf.get("merch", "")),
		"precio": precio, "precio_col": inf.get("price_color", CareerTheme.MONEY),
		"chip": String(tag.get("text", "")), "chip_col": CareerTheme.TEXT,
		"apagada": bool(inf.get("locked", false)),
		"destaca": inf.has("oferta") or String(_oferta().get("id", "")) == id,
		"al_tocar": func() -> void: _ti_t_toca(fam, id)}
	if precio.is_empty() and String(d["chip"]).is_empty() and inf.has("state"):
		d["chip"] = String(inf["state"])
		d["chip_col"] = CareerTheme.TEXT_MID
	return d




func _ti_t_toca(fam: String, id: String) -> void:
	if fam == "consumibles" or _shop_tab == "consumibles":
		var inf: Dictionary = _shop_infos.get(id, {})
		if not inf.is_empty():
			_shop_pagar(inf)
		return
	_elegir(fam, id)



func _ti_t_dato_item(it: Dictionary) -> Dictionary:
	var iid: String = String(it["id"])
	var ip: int = Career.shop_price("item", it)
	var have: int = int(Career.stock.get(iid, 0))
	var alcanza: bool = Career.can_afford(ip)
	var pago: Dictionary = {"title": I18n.t(String(it["name"])), "precio": ip,
		"cta": {"text": "$ %s" % CareerUi.money(ip), "money": true, "ok": true,
			"do": func() -> void: _buy(iid, func() -> bool: return Career.buy_item(iid))}}
	return {"id": iid, "inf": {}, "titulo": I18n.t(String(it["name"])),
		"icono": Shop.icon_of(it, "consumible"), "foto": iid,
		"precio": "$ %s" % CareerUi.money(ip),
		"precio_col": CareerTheme.MONEY if alcanza else CareerTheme.TEXT_DIM,
		"chip":("x%d" % have) if have > 0 else "", "chip_col": CareerTheme.accent_text(),
		"apagada": not alcanza, "destaca": String(_oferta().get("id", "")) == iid,
		"al_tocar": func() -> void:
			if Career.can_afford(ip):
				_shop_pagar(pago)}


func _ti_t_dato_vista(vista: String, icono: String, titulo: String) -> Dictionary:
	return {"id": "_" + vista, "titulo": titulo, "icono": icono, "chip": I18n.t("VER"),
		"chip_col": CareerTheme.TEXT_MID, "al_tocar": func() -> void:
			_ti_t_vista = vista
			_refresh()}



func _ti_t_productos() -> Array[Dictionary]:
	var lista: Array = []
	match _ti_t_caja_seg:
		"dinero":
			lista = Iap.de_tipo(Iap.TIPO_DINERO)
		"puntos":
			lista = Iap.de_tipo(Iap.TIPO_PUNTOS)
		"botas":
			lista = Iap.lotes_de("coleccion")
		_:
			if Store.combo_disponible():
				lista.append(Iap.COMBO)
			lista.append_array(Iap.lotes_de("pack"))
	var out: Array[Dictionary] = []
	for p in lista:
		if not Store.precio_de(String((p as Dictionary)["pid"])).is_empty():
			out.append(p as Dictionary)
	return out



func _ti_t_dato_producto(p: Dictionary) -> Dictionary:
	var pid: String = String(p["pid"])
	var cuanto: int = int(p.get("cuanto", 0))
	var es_dinero: bool = String(p.get("tipo", "")) == Iap.TIPO_DINERO
	var ent: Dictionary = p.get("entrega", {})
	if String(p.get("tipo", "")) == Iap.TIPO_LOTE:
		cuanto = int(ent.get("dinero", 0))
		es_dinero = true
	var grande: String = ""
	if cuanto > 0:
		grande =("$ " + CareerUi.money(cuanto)) if es_dinero else I18n.tf("{0} PUNTOS", [cuanto])
	elif not (ent.get("botas", []) as Array).is_empty():
		grande = I18n.t("BOTAS")
	_shop_infos[pid] = {"fam": "caja", "id": pid, "title": I18n.t(String(p["name"])),
		"producto": p}
	return {"id": pid, "inf": _shop_infos[pid], "titulo": I18n.t(String(p["name"])),
		"icono": "moneda", "pack": p, "precio": grande,
		"precio_col": CareerTheme.MONEY if es_dinero else CareerTheme.TEXT,
		"chip": Store.precio_de(pid), "chip_col": CareerTheme.MONEY,
		"destaca": Iap.COMBO == p, "al_tocar": func() -> void: _elegir("caja", pid)}





func _ti_t_rejilla(datos: Array[Dictionary]) -> GridContainer:
	var grid: GridContainer = GridContainer.new()
	grid.name = "Rejilla"
	grid.columns = TI_T_COLS
	grid.add_theme_constant_override("h_separation", TI_T_AIRE)
	grid.add_theme_constant_override("v_separation", TI_T_AIRE)
	grid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	grid.size_flags_vertical = Control.SIZE_EXPAND_FILL
	grid.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var visibles: Array[Dictionary] = datos
	var resto: Array[Dictionary] = []
	if datos.size() > TI_T_CELDAS:
		visibles = datos.slice(0, TI_T_CELDAS - 1)
		resto = datos.slice(TI_T_CELDAS - 1)
		var sel: String = String(_shop_sel.get(_shop_tab, ""))
		for i in resto.size():
			if String(resto[i]["id"]) == sel:
				var ultima: Dictionary = visibles[visibles.size() - 1]
				visibles[visibles.size() - 1] = resto[i]
				resto[i] = ultima
				break
	for j in visibles.size():
		grid.add_child(_ti_t_celda(visibles[j], j))
	if not resto.is_empty():
		var mas: Dictionary = {"id": "_mas", "titulo": "%s · %d" % [I18n.t("MÁS"), resto.size()],
			"icono": "otra", "al_tocar": func() -> void:
				_ti_t_lista_modal(I18n.t(String(_rotulo_familia(_shop_tab))), resto, "ti_t_lista")}
		grid.add_child(_ti_t_celda(mas, visibles.size()))





	var n: int = _ti_t_celdas.size()
	for i in n:
		var b: Button = _ti_t_celdas[i]
		var c: int = i % TI_T_COLS
		b.focus_neighbor_left = b.get_path_to(_ti_t_celdas[i - 1] if c > 0 else b)
		if c < TI_T_COLS - 1 and i + 1 < n:
			b.focus_neighbor_right = b.get_path_to(_ti_t_celdas[i + 1])
		var abajo: int = i + TI_T_COLS if i + TI_T_COLS < n else \
				(n - 1 if (n - 1) / TI_T_COLS > i / TI_T_COLS else i)
		b.focus_neighbor_bottom = b.get_path_to(_ti_t_celdas[abajo])
		if i >= TI_T_COLS:
			b.focus_neighbor_top = b.get_path_to(_ti_t_celdas[i - TI_T_COLS])
	return grid







func _ti_t_celda(d: Dictionary, j: int) -> Button:
	var id: String = String(d["id"])
