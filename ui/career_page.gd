func _contract_numbers() -> void:
	var wage: int = int(Career.contract["wage"])
	var upkeep: int = Career.upkeep_total()
	var left: int = int(Career.contract["seasons_left"])


	var net: int = Career.con_doble_paga(wage) - upkeep
	var sueldo_txt: String = "$ %s" % CareerUi.money(wage)
	if Career.paga_mult() > 1.0:
		sueldo_txt += " ×%d" % roundi(Career.paga_mult())
	var rows: Array = [
		["contrato_firma", I18n.t("SUELDO"), sueldo_txt,
			CareerTheme.MONEY],
		["jornada", I18n.t("TEMPORADAS"),
			I18n.tf("{0}", [left]),
			CareerTheme.DANGER if left <= 1 else CareerTheme.TEXT],
		["coche", I18n.t("TREN DE VIDA"),
			("-$ %s" % CareerUi.money(upkeep)) if upkeep > 0 else "—",
			CareerTheme.DANGER if upkeep > 0 else CareerTheme.TEXT_DIM],
		["balon", I18n.t("NETO POR PARTIDO"),
