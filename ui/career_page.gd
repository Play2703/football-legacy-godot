func _cal_t_fichas(filas: Array, prox: int, ancho: float) -> HBoxContainer:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "FilaFechas"
	fila.add_theme_constant_override("separation", CAL_T_FICHA_SEP)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.set_meta("cal_t_fila", true)
	var n: int = mini(CAL_T_FICHAS, filas.size())
	var desde: int = prox if prox >= 0 else filas.size() - n
	desde = clampi(mini(desde, filas.size() - n), 0, maxi(0, filas.size() - 1))
	var w: float = floorf((ancho - float(CAL_T_FICHA_SEP *(n - 1))) / float(maxi(1, n)))
	_cal_t_botones = []
	_cal_t_elegida = -1
	for i in n:
		var k: int = desde + i
		var b: Button = _cal_t_ficha(filas[k], k == prox, w)
		fila.add_child(b)
		_cal_t_botones.append(b)
		if k == prox:
			_cal_t_elegida = i
	if _cal_t_elegida < 0 and n > 0:
		_cal_t_elegida = 0
	for i in _cal_t_botones.size():
		_cal_t_botones[i].focus_mode = Control.FOCUS_ALL if i == _cal_t_elegida else Control.FOCUS_NONE
		_cal_t_botones[i].gui_input.connect(_cal_t_cruceta.bind(i))
	return fila





