func _agent_scroll_list(items: Array, on_pick: Callable,
		modal_box: VBoxContainer) -> ScrollContainer:






	var scroll: ScrollContainer = DragScroll.new()
	if UiKit.es_horizontal():


		scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
	else:
		scroll.custom_minimum_size = Vector2(0, 860)


	scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_SHOW_NEVER
	scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var list: VBoxContainer = VBoxContainer.new()
	list.add_theme_constant_override("separation", 8)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	scroll.add_child(list)
	var filas: Container = list
	if UiKit.es_horizontal():




		var rejilla: GridContainer = GridContainer.new()
		rejilla.columns = maxi(4, ceili(items.size() / 10.0))
		rejilla.add_theme_constant_override("h_separation", 12)
		rejilla.add_theme_constant_override("v_separation", 8)
		list.add_child(rejilla)
		filas = rejilla
	for item in items:
		var dim: bool = bool(item.get("dim", false))
		var row: Button = Button.new()



		row.custom_minimum_size = Vector2((400 if items.size() <= 40 else 300)
			if UiKit.es_horizontal() else 0, 72)
		row.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		CareerTheme.apply_button(row, CareerTheme.Kind.GHOST if dim
			else CareerTheme.Kind.NEUTRAL, 20)


		var line: HBoxContainer = HBoxContainer.new()
		line.set_anchors_preset(Control.PRESET_FULL_RECT)
		line.mouse_filter = Control.MOUSE_FILTER_IGNORE
		line.add_theme_constant_override("separation", 12)
		line.offset_left = AGENT_ROW_PAD
		line.offset_right = - AGENT_ROW_PAD
		row.add_child(line)
		var country: String = String(item.get("country", ""))
		if not country.is_empty():
			if Flags.has(country):
				var flag: Control = Flags.make_rect(country, AGENT_FLAG_H)
				flag.size_flags_vertical = Control.SIZE_SHRINK_CENTER
				flag.mouse_filter = Control.MOUSE_FILTER_IGNORE
				line.add_child(flag)
			var logo: CompLogo = CompLogo.new()
			logo.custom_minimum_size = Vector2(AGENT_ICON, AGENT_ICON)
			logo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			logo.mouse_filter = Control.MOUSE_FILTER_IGNORE
			logo.setup(Competitions.league_logo(country),
				Teams.accent(country) if not dim else CareerTheme.TEXT_DIM)
			line.add_child(logo)
		var club: Dictionary = item.get("club", {})
		if not club.is_empty():
			var crest: CrestView = CrestView.new()
			crest.custom_minimum_size = Vector2(AGENT_ICON, AGENT_ICON)
			crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			crest.mouse_filter = Control.MOUSE_FILTER_IGNORE
			crest.set_team(club)
			line.add_child(crest)
		var l: Label = CareerUi.plain(20, CareerTheme.TEXT_DIM if dim
			else CareerTheme.TEXT)
		l.text = String(item["label"])
		l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		l.clip_text = true
		l.mouse_filter = Control.MOUSE_FILTER_IGNORE
		line.add_child(l)
		var value: String = String(item["value"])
		row.pressed.connect(func() -> void:
			CareerUi.close_modal(modal_box)
			on_pick.call(value))
		filas.add_child(row)
	return scroll






