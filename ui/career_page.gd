func _nat_live_rows(table: Dictionary, nat_name: String) -> Array:
	var rows: Array = []
	for k in table:
		var r: Dictionary = table[k]
		var you: bool = String(k) == GameState.YOU_KEY

		rows.append({"you": you,
			"id": Career.nationality if you else String(k),
			"name": nat_name if you else Nations.display_name(String(k)),
			"pts": int(r["pts"]), "pj": int(r["pj"]),
			"g": int(r.get("w", 0)), "e": int(r.get("d", 0)), "p": int(r.get("l", 0)),
			"gd": int(r["gf"]) - int(r["gc"]), "gf": int(r["gf"]), "sorteo": rows.size()})




	rows.sort_custom(func(a, b):
		if int(a["pts"]) != int(b["pts"]):
			return int(a["pts"]) > int(b["pts"])
		if int(a["gd"]) != int(b["gd"]):
			return int(a["gd"]) > int(b["gd"])
		if int(a["gf"]) != int(b["gf"]):
			return int(a["gf"]) > int(b["gf"])
		return int(a["sorteo"]) < int(b["sorteo"]))
	return rows







static func _nat_terceros_dentro(filas_de: Array, avanzan: int, cuantos: int) -> Dictionary:
	var out: Dictionary = {}
	if cuantos <= 0:
		return out
	var terceros: Array = []
	for gi in filas_de.size():
		var rows: Array = filas_de[gi]
		if rows.size() > avanzan:
			if int(rows[avanzan].get("pj", 0)) <= 0:
				return {}
			terceros.append({"gi": gi, "pts": int(rows[avanzan]["pts"]),
				"gd": int(rows[avanzan]["gd"])})
	terceros.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if int(a["pts"]) != int(b["pts"]):
			return int(a["pts"]) > int(b["pts"])
		return int(a["gd"]) > int(b["gd"]))
	for i in mini(cuantos, terceros.size()):
		out[int(terceros[i]["gi"])] = true
	return out





