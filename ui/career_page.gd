func _pl_t_cruceta_ambito(ev: InputEvent) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO or _pl_t_ambito_boton == null:
		return
	var quiere: String = ""
	if ev.is_action_pressed("ui_left", true):
		quiere = "club"
	elif ev.is_action_pressed("ui_right", true):
		quiere = "seleccion"
	else:
		return
	_pl_t_ambito_boton.accept_event()
	_pl_t_cambia_ambito(quiere)




func _pl_t_cambia_ambito(quiere: String) -> void:
