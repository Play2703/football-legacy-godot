func _agent_tile(parent: HBoxContainer, icono: String, texto: String, kind: String,
		cerrado: bool, en_curso: bool, accion: Callable) -> void:
	var fee: int = Career.agent_fee(kind)
	var pobre: bool = Career.money < fee and not en_curso
	var b: Button = Button.new()
	b.custom_minimum_size = Vector2(0, 176)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	b.size_flags_stretch_ratio = 1.0
	CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, CareerTheme.T_CAPTION)



	CareerTheme.apply_button_peldano(b, CareerTheme.NAV_MUNDO, false, CareerTheme.T_CAPTION)
	b.text = ""
	b.clip_contents = true
	b.disabled = cerrado or pobre
	if en_curso:
		var sbe: StyleBoxFlat = StyleBoxFlat.new()
		sbe.bg_color = CareerTheme.SURFACE_HI
		sbe.border_color = CareerTheme.accent()
		sbe.set_border_width_all(3)
		sbe.set_corner_radius_all(6)
		b.add_theme_stylebox_override("disabled", sbe)
	if not b.disabled:
		b.pressed.connect(accion)
	parent.add_child(b)
	var v: VBoxContainer = VBoxContainer.new()
	v.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	v.offset_left = 10.0
	v.offset_right = -10.0
	v.offset_top = 12.0
	v.offset_bottom = -12.0
	v.alignment = BoxContainer.ALIGNMENT_CENTER
	v.add_theme_constant_override("separation", 8)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	b.add_child(v)
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(60, 60)
	ic.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var vivo: bool = en_curso or not b.disabled
	ic.setup(icono, CareerTheme.accent_text() if vivo else CareerTheme.TEXT_DIM)
	v.add_child(ic)
	var l: Label = CareerUi.plain(CareerTheme.T_CAPTION,
		CareerTheme.TEXT if vivo else CareerTheme.TEXT_DIM)
	l.text = CareerTheme.caps(texto)
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(l)
	var pl: Label = CareerUi.plain(CareerTheme.T_CAPTION,
		CareerTheme.DANGER if pobre else CareerTheme.MONEY)
	pl.text = "$" + CareerUi.money(fee)
	pl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	pl.clip_text = true
	pl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(pl)
	if not en_curso:
		return
	pl.text = CareerTheme.caps(I18n.t("EN CURSO"))
	pl.add_theme_color_override("font_color", CareerTheme.accent_text())

	var carril: Control = Control.new()
	carril.custom_minimum_size = Vector2(0, 6)
	carril.clip_contents = true
	carril.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(carril)
	var fondo: ColorRect = ColorRect.new()
	fondo.color = CareerTheme.BG_DEEP
	fondo.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	fondo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	carril.add_child(fondo)
	var tramo: ColorRect = ColorRect.new()
	tramo.color = CareerTheme.accent()
	tramo.anchor_top = 0.0
	tramo.anchor_bottom = 1.0
	tramo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	carril.add_child(tramo)
	var barre: Callable = func(t: float) -> void:
		tramo.anchor_left = t - 0.4
		tramo.anchor_right = t
		tramo.offset_left = 0.0
		tramo.offset_right = 0.0
	barre.call(0.0)
	var tw: Tween = tramo.create_tween().set_loops()
	tw.tween_method(barre, 0.0, 1.4, 1.1).set_trans(Tween.TRANS_SINE).set_ease(
		Tween.EASE_IN_OUT)

	var tr: Tween = ic.create_tween().set_loops()
	tr.tween_property(ic, "modulate:a", 0.45, 0.6).set_trans(Tween.TRANS_SINE)
	tr.tween_property(ic, "modulate:a", 1.0, 0.6).set_trans(Tween.TRANS_SINE)

	if bool(_agent_en_curso_visto.get(kind, false)):
		return
	b.resized.connect(func() -> void: b.pivot_offset = b.size * 0.5)
	b.scale = Vector2(0.9, 0.9)
	b.modulate = Color.WHITE * 1.6
	var tp: Tween = b.create_tween().set_parallel()
	tp.tween_property(b, "scale", Vector2.ONE, 0.5).set_trans(Tween.TRANS_BACK).set_ease(
		Tween.EASE_OUT)
	tp.tween_property(b, "modulate", Color.WHITE, 0.55).set_trans(Tween.TRANS_CUBIC).set_ease(
		Tween.EASE_OUT)










