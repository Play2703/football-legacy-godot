func _to_t_chips(accent: Color) -> HBoxContainer:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "Chips"
	fila.add_theme_constant_override("separation", TO_T_CHIP_SEP)
	fila.custom_minimum_size.y = TO_T_CHIP_H
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var derecha: Array[Control] = []
	if _torn_comp == "liga":
		if _to_t_vista >= 0:
			derecha.append(_to_t_chip_vista())
		_to_t_pais = _to_t_chip_pais(accent)
		derecha.append(_to_t_pais)
	elif not _to_t_ayuda.is_empty():

		var items: Array = _to_t_ayuda
		var ayuda: Button = CareerUi.boton_ayuda(func() -> void:
			CareerUi.leyenda_modal(self, I18n.t("ZONAS"), items, CareerUi.AYUDA_SANGRIA))
		ayuda.custom_minimum_size = Vector2(TO_T_CHIP_H, TO_T_CHIP_H)
		derecha.append(ayuda)
	var pista: HBoxContainer = _to_t_pista("fl_modo", "CAMBIAR")
	var libre: float = _torn_ancho_plantilla()
	for d in derecha:
		libre -= d.get_combined_minimum_size().x + float(TO_T_CHIP_SEP)
	if Entrada.modo == Entrada.Modo.MANDO:
		libre -= pista.get_combined_minimum_size().x + float(TO_T_CHIP_SEP)
	var comps: Array = _to_t_comps()
	var total: float = - float(TO_T_CHIP_SEP)
	for comp in comps:
		total += _to_t_chip_ancho(String(comp), false) + float(TO_T_CHIP_SEP)
	var solo_logo: bool = total > libre
	for comp in comps:
		fila.add_child(_to_t_chip(String(comp), solo_logo and String(comp) != _torn_comp))
	fila.add_child(pista)
	var hueco: Control = Control.new()
	hueco.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	hueco.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(hueco)
	for d in derecha:
		fila.add_child(d)
	return fila



