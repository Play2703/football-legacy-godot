func _wnews_default_scope() -> String:
	for sc in ["club", "liga", "mundo"]:
		for f in Career.world_news:
			if _wnews_in_scope(f, sc):
				return sc
	return "mundo"








func _wnews_in_scope(f: Dictionary, scope: String) -> bool:


	if scope == "redes" or scope == "mensajes":
		return false
	var ring: int = WorldNews.anillo(f)
	if scope == "club":
		return ring == WorldNews.ANILLO_TUYO
	if scope == "liga":
		return ring >= WorldNews.ANILLO_LIGA
	return true




















func _wnews_rows(scope: String, tope: int) -> Array:
	var out: Array = []
	var i: int = 0
	for f in Career.world_news:
		i += 1
		if not _wnews_in_scope(f, scope):
			continue
		out.append({"f": f, "i": i})
	out.sort_custom(_wnews_antes)
	var filas: Array = []
	for d in out:
		filas.append((d as Dictionary)["f"])
		if filas.size() >= tope:
			break
	return filas



func _wnews_antes(a: Dictionary, b: Dictionary) -> bool:
	var fa: Dictionary = a["f"]
	var fb: Dictionary = b["f"]
	var sa: int = int(fa.get("season", 0))
	var sb: int = int(fb.get("season", 0))
	if sa != sb:
		return sa > sb
	var da: int = int(fa.get("day", 0))
	var db: int = int(fb.get("day", 0))
	if da != db:
		return da > db
	return int(a["i"]) < int(b["i"])





