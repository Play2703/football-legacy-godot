func _chips_jornada() -> void:
	var males: Array = []
	if Career.injury_weeks > 0:
		males.append({"que": "heal", "rotulo": I18n.t("LESIONADO"), "grave": true})
	if Career.energy < Standing.TIRED_BENCH_ENERGY:
		males.append({"que": "energy", "grave": Career.energy < Career.LOW_ENERGY,
			"rotulo": I18n.tf("ENERGÍA {0}%", [roundi(Career.energy)])})
	if males.is_empty():
		return
	var flow: HFlowContainer = null
	for m in males:
		var d_m: Dictionary = m as Dictionary
		var clave: String = String(d_m["que"])
		var tengo: Dictionary = {}
		var barato: Dictionary = {}
		for it in Shop.ITEMS:
			var d: Dictionary = it as Dictionary
			var iid: String = String(d["id"])



			if float(d.get(clave, 0.0)) <= 0.0:
				continue
			if not Career.item_block_reason(iid).is_empty():
				continue
			if int(Career.stock.get(iid, 0)) > 0:
				tengo = d
				break
			var pr: int = Career.shop_price("item", d)
			if Career.can_afford(pr) and (barato.is_empty()
					or pr < Career.shop_price("item", barato)):
				barato = d
		var pieza: Dictionary = tengo if not tengo.is_empty() else barato
		if pieza.is_empty():
			continue
		if flow == null:
			flow = HFlowContainer.new()
			flow.add_theme_constant_override("h_separation", 8)
			flow.add_theme_constant_override("v_separation", 8)
			_content.add_child(flow)
		var nombre: String = I18n.t(String(pieza["name"]))
		if not tengo.is_empty():
			flow.add_child(CareerUi.label_chip(I18n.t("USA LO QUE TIENES"), nombre,
				CareerTheme.accent_ink()))
		else:
			flow.add_child(CareerUi.label_chip(String(d_m["rotulo"]), nombre,
				CareerTheme.DANGER if bool(d_m["grave"]) else CareerTheme.TEXT))


