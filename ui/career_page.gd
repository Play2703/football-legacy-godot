func _on_map_kind(i: int) -> void:
	var kind: String = ["tiros", "pases", "regates"][clampi(i, 0, 2)]
	if kind == _map_kind:
		return
	_map_kind = kind


	_map_filter = ""
	_map_play = "*"
	_map_pick = -1
	_refresh()

















func _map_seasons(key: String) -> Array:
	var vivo: Array = Career.season_shots
	if key == "passes":
		vivo = Career.season_passes
	elif key == "moves":
		vivo = Career.season_moves
	var by_year: Dictionary = {}
	var order: Array = []
	for row in Career.season_history:
		var r: Dictionary = row as Dictionary
		var items: Variant = r.get(key, [])
		var heat: Variant = r.get("heat", null)
		var hay_calor: bool = key == "moves" and MoveBook.has_heat(heat)






		if not hay_calor and (not (items is Array) or (items as Array).is_empty()) \
				and not _hay_mapa(r):
			continue
		var yr: int = int(r.get("season", 0))
		if not by_year.has(yr):
			by_year[yr] = {"season": yr, "items": [], "heat": MoveBook.blank(),
				"club": String(r.get("club", "")), "curso": false,
				"best_goal_m": 0.0, "best_pass_m": 0.0}
			order.append(yr)
		var acc: Dictionary = by_year[yr]
		if items is Array:
			(acc["items"] as Array).append_array(items as Array)
		if hay_calor:
			acc["heat"] = MoveBook.merge_heat(acc["heat"] as PackedInt32Array,
				heat as PackedInt32Array)
		acc["best_goal_m"] = maxf(float(acc["best_goal_m"]),
			float(r.get("best_goal_m", 0.0)))
		acc["best_pass_m"] = maxf(float(acc["best_pass_m"]),
			float(r.get("best_pass_m", 0.0)))
	var out: Array = []
	for yr in order:
		out.append(by_year[yr])
	if not vivo.is_empty() or (key == "moves" and MoveBook.has_heat(Career.season_heat)):
		out.append({
			"season": GameState.season_num, "items": vivo,
			"heat": Career.season_heat,
			"club": GameState.player_team_id, "curso": true,
			"best_goal_m": float(Career.season_best_goal_dist.get("m", 0.0)),
			"best_pass_m": float(Career.season_best_pass_dist.get("m", 0.0)),
		})










	if out.size() < 2 or _con_dato(out, key) < 2:
		return out
	var todo: Array = []
	var calor: PackedInt32Array = MoveBook.blank()
	for fila in out:
		todo.append_array((fila as Dictionary)["items"] as Array)
		calor = MoveBook.merge_heat(calor,(fila as Dictionary)["heat"] as PackedInt32Array)
	out.append({
		"season": MAP_CAREER, "items": todo, "heat": calor,
		"club": GameState.player_team_id, "curso": false, "carrera": true,



		"best_goal_m": 0.0, "best_pass_m": 0.0,
	})
	return out




func _hay_mapa(r: Dictionary) -> bool:
	for k in ["shots", "passes", "moves"]:
		var v: Variant = r.get(k, [])
		if v is Array and not (v as Array).is_empty():
			return true
	return MoveBook.has_heat(r.get("heat", null))



func _con_dato(seasons: Array, key: String) -> int:
	var n: int = 0
	for fila in seasons:
		var f: Dictionary = fila as Dictionary
		if not (f["items"] as Array).is_empty() \
				or (key == "moves" and MoveBook.has_heat(f["heat"])):
			n += 1
	return n






func _map_pick_season(seasons: Array) -> int:


	if _map_season == MAP_CAREER:
		for i in seasons.size():
			if bool((seasons[i] as Dictionary).get("carrera", false)):
				return i
	elif _map_season >= 0:
		for i in seasons.size():
			if int((seasons[i] as Dictionary)["season"]) == _map_season:
				return i



	for i in seasons.size():
		if bool((seasons[i] as Dictionary).get("curso", false)):
			return i
	return maxi(seasons.size() - 2, 0)


