func _ca_t_baldosa(id: String, icono: String, rotulo: String) -> Button:
	var nivel: int = House.clamp_level(Career.house_level)
	var texto: String = I18n.t(rotulo)
	var sub: String = ""
	var cifra: String = ""
	var col: Color = CareerTheme.TEXT
	var valor: int = 0
	var cb: Callable = Callable()
	var kind: int = CareerTheme.Kind.NEUTRAL
	match id:
		"casa":
			texto = CareerTheme.caps(I18n.t(String(House.level_data(nivel)["name"])))
			sub = I18n.tf("NIVEL {0}", [nivel + 1])
			valor = House.upgrade_price(nivel)
			cifra = CareerUi.money(valor) if valor > 0 else ""
			col = CareerTheme.MONEY
			cb = _ca_t_mudarse_modal
		"trofeos":
			var cab: Dictionary = Trophies.cabinet(Career.awards)
			valor = _trophy_sum(cab.get("team", [])) + _trophy_sum(cab.get("individual", []))
			cifra = I18n.num(valor)
			cb = _ca_t_trofeos
		"minijuegos":
			valor = _ca_t_minijuegos().size()
			cifra = I18n.num(valor)
			cb = _ca_t_minijuego
		"vender":
			valor = _ca_t_vendibles().size()
			cifra = I18n.num(valor)
			col = CareerTheme.DANGER
			kind = -1
			cb = _ca_t_vender_modal
	var b: Button = _ca_t_boton(id.capitalize(), icono, texto, kind, cb, sub, cifra, col)
	b.set_meta("ca_t_fila", id)
	b.set_meta("ca_t_valor", valor)
	if id == "casa":

		CareerUi.letra_por_peldanos(b.find_child("Rotulo", true, false) as Label,
			[CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	if valor <= 0 and id != "trofeos":
		_ca_t_apaga(b)
	return b



func _ca_t_apaga(b: Button) -> void:
	b.disabled = true
	b.focus_mode = Control.FOCUS_NONE
	b.set_meta(Entrada.SIN_FOCO_META, true)




func _ca_t_boton(nombre: String, icono: String, texto: String, kind: int, cb: Callable,
		sub: String = "", cifra: String = "", col_cifra: Color = CareerTheme.TEXT) -> Button:
	var b: Button = Button.new()
	b.name = nombre
	b.custom_minimum_size = Vector2(0.0, CA_T_FILA_H)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	b.clip_text = true
	var tinta: Color = CareerTheme.accent_text()
	if kind < 0:
		CareerTheme.apply_button_accent(b, CareerTheme.DANGER, CareerTheme.T_LEE_TUMBADO)
		tinta = CareerTheme.TEXT
	else:
		CareerTheme.apply_button(b, kind as CareerTheme.Kind, CareerTheme.T_LEE_TUMBADO)
		if kind == CareerTheme.Kind.PRIMARY:
			tinta = CareerTheme.TEXT
	if cb.is_valid():
		b.pressed.connect(cb)
	var relleno: MarginContainer = CareerUi._relleno_boton(b, 24, 8)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "Fila"
	fila.add_theme_constant_override("separation", 16)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	relleno.add_child(fila)
	var ic: MenuIcon = MenuIcon.new()
	ic.name = "Icono"
	ic.custom_minimum_size = Vector2(CA_T_ICONO, CA_T_ICONO)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.setup(icono, tinta)
	fila.add_child(ic)
	var txt: VBoxContainer = VBoxContainer.new()
	txt.name = "Texto"
	txt.add_theme_constant_override("separation", 2)
	txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	txt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	txt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(txt)
	var l: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT, texto)
	l.name = "Rotulo"
	l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	txt.add_child(l)
	if not sub.is_empty():
		var s: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID, sub)
		s.name = "Sub"
		s.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		txt.add_child(s)
	if not cifra.is_empty():
		var c: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, col_cifra, cifra)
		c.name = "Cifra"

		c.custom_minimum_size.x = _wnews_ancho(cifra, CareerTheme.T_LEE_TUMBADO) + 4.0
		c.size_flags_horizontal = Control.SIZE_SHRINK_END
		c.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		c.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		fila.add_child(c)
	return b






func _ca_t_ordena() -> void:
	var primera: Button = null
	for b in _ca_t_filas:
		if b.disabled:
			continue
		if primera == null or String(b.get_meta("ca_t_fila", "")) == "casa":
			primera = b
	if primera == null:
		return
	primera.set_meta(Entrada.PRIMERO_META, true)
	for i in _ca_t_filas.size():
		var b: Button = _ca_t_filas[i]
		var abajo: Button = _ca_t_viva(i, 1)
		var arriba: Button = _ca_t_viva(i, -1)
		b.focus_neighbor_bottom = b.get_path_to(abajo if abajo != null else b)
		b.focus_neighbor_top = b.get_path_to(arriba) if arriba != null else NodePath()
		b.focus_neighbor_left = b.get_path_to(b)
		b.focus_neighbor_right = b.get_path_to(b)



func _ca_t_viva(i: int, paso: int) -> Button:
	var j: int = i + paso
	while j >= 0 and j < _ca_t_filas.size():
		if not _ca_t_filas[j].disabled:
			return _ca_t_filas[j]
		j += paso
	return null




func _ca_t_minijuegos() -> Array[String]:
	var kinds: Array[String] = []
	var gs: GDScript = load("res://ui/house/house.gd")
	var lista: Array = gs.get_script_constant_map().get("MINIJUEGO_KINDS", []) if gs != null else []
	for it in Career.house_items:
		var d: Dictionary = it as Dictionary
		var kind: String = String(d.get("kind", ""))
		if lista.has(kind) and not kinds.has(kind) and not House.kind_vetado(kind) \
				and House.item_puesto(String(d.get("iid", ""))):
			kinds.append(kind)
	return kinds




func _ca_t_vendibles() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	for it in Career.house_items:
		var d: Dictionary = it as Dictionary
		var iid: String = String(d.get("iid", ""))
		var vale: int = Career.house_sell_value(iid)
		if vale <= 0:
			continue
		var e: Dictionary = House.extra_by_id(String(d.get("extra", "")))
		out.append({"iid": iid, "vale": vale, "piezas": Career.house_sell_pieces(iid),
			"nombre": CareerTheme.caps(I18n.t(String(e.get("name", "")))),
			"icono": String(e.get("icon", "caja"))})
	return out


