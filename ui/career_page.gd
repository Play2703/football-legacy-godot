func _chip_grid(rows: Array) -> void:
	var grid: GridContainer = GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override("h_separation", 12)
	grid.add_theme_constant_override("v_separation", 10)
	_content.add_child(grid)
	for r in rows:
		var chip: PanelContainer = CareerUi.chip()
		chip.size_flags_horizontal = Control.SIZE_EXPAND_FILL



		chip.custom_minimum_size.y = 96.0
		grid.add_child(chip)
		var h: HBoxContainer = HBoxContainer.new()
		h.add_theme_constant_override("separation", 12)
		chip.add_child(h)


		var ic: Control
		if String(r[0]).begins_with("trofeo:"):
			var tro: TrophyIcon = TrophyIcon.new()
			tro.set_type(String(r[0]).substr(7))
			ic = tro
		else:
			var mi: MenuIcon = MenuIcon.new()
			mi.setup(String(r[0]), r[3] as Color)
			ic = mi
		ic.custom_minimum_size = Vector2(38, 38)
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(ic)
		var col: VBoxContainer = VBoxContainer.new()
		col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		col.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		col.add_theme_constant_override("separation", 4)
		h.add_child(col)




		var cap: Label = CareerUi.plain(14, CareerTheme.TEXT_DIM)
		cap.text = String(r[1])
		cap.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		cap.custom_minimum_size.y = 20.0






		if UiKit.es_horizontal():
			cap.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		col.add_child(cap)
		var val: Label = CareerUi.plain(26, r[3] as Color)
		val.text = String(r[2])
		val.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS


		val.custom_minimum_size.y = 34.0
		col.add_child(val)


		CareerUi.autoshrink(val, 16)





var _renewal_pack: String = "equilibrio"




const _PACK_LABELS: Dictionary = {
