			CareerTheme.TEXT_DIM, 30.0))
	if not ult.is_empty():


		var vendido: bool = String(ult.get("sale", "")) == "vendido"
		_content.add_child(_gerencia_trato_fila("cerrar" if vendido else "candado",
			CareerTheme.DANGER if vendido else CareerTheme.accent_text(),
			String(ult.get("name", "")), String(ult.get("to", "")),
			int(ult.get("fee", 0)), vendido))




func _gerencia_trato_fila(icono: String, color: Color, nombre: String, club_id: String,
		fee: int, entro: bool) -> HBoxContainer:
	var fila: HBoxContainer = CareerUi.icon_stat(icono,
