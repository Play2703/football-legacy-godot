func _unhandled_input(event: InputEvent) -> void:
	if not TIRA_PAGINAS.has(_page) or not UiKit.es_horizontal() or Entrada.modo != Entrada.Modo.MANDO:
		return
	if CareerUi.modal_open(self):
		return
	var y: bool = event.is_action_pressed("fl_modo")


	var x: bool = event.is_action_pressed("fl_toque")
	if not y and not x:
		return
	match _page:
		"noticias":
			if not y:
				return
			_wnews_rota_filtro()
		"calendario":
			if not y:
				return

			_cal_temporada_modal(_cal_t_filas)
		"plantilla":
			if y:
				_pl_t_rota_orden()
			else:
				_pl_t_once_modal()
		"mercado":


			if not y or Career.free_agent or Career.on_loan() or _offer_open >= 0 \
					or _loan_open >= 0:
				return
			if _mt_vista == "estado":
				_mt_vista = ""
				_refresh()
			else:
				_mt_abre_estado()
		"entreno":

			if x:
				_en_t_practica()
			elif Career.encargo_disponible():
				_en_t_encargo()
			else:
				return
		"relaciones":

			if x:
				_ge_t_detalle_foco()
			elif _tiene_seleccion():
				_ge_t_cambia_ambito("club" if _with_nat() else "seleccion")
			else:
				return
		"tienda":

			if not x or not _ti_t_compra_x():
				return
		"ranking":

			if not y:
				return
			RankingTira.buscar(self)
		"fichajes":

			if not y:
				return
			FichajesTira.filtrar(self)
		"legado":


			if not y or _leg_tab != "carrera":
				return
			CarreraTira.detalle(self)
		"torneos":


			if _torn_comp == "nat":
				return
			if y:
				_to_t_rota_comp()
			elif _torn_comp == "liga" and _to_t_vista >= 0:
				_torn_elige_vista((_to_t_vista + 1) % 3)
			else:
				return
		"perfil":

			if y:
				if _perf_tab == "contrato":
					_ct_t_mas_modal()
				else:
					_pf_t_mas_modal()
			elif x and _perf_tab == "juego" and Career.can_undo_point():
				_on_undo_point()
			else:
				return
		_:
			return
	get_viewport().set_input_as_handled()



