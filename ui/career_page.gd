func _taller_sabe_foto() -> bool:
	if _foto_ok < 0:
		_foto_ok = 0
		var gs: GDScript = load("res://ui/house/house.gd")
		if gs != null:
			for p in gs.get_script_property_list():
				if String(p.get("name", "")) == "solo_foto":
					_foto_ok = 1
					break
	return _foto_ok == 1



