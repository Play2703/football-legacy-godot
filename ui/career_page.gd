func _ct_t_ordena(caja: Control) -> void:
	var mas: Button = caja.find_child("Mas", true, false) as Button
	var d: Button = _ct_t_vivo(caja.find_child("Pedir", true, false) as Button)
	var r: Button = _ct_t_vivo(caja.find_child("Renovar", true, false) as Button)
	var s: Button = _ct_t_vivo(caja.find_child("Salida", true, false) as Button)
	var primero: Button = r if r != null else (s if s != null else (d if d != null else mas))
	if primero != null:
		primero.set_meta(Entrada.PRIMERO_META, true)
	var derecha: Button = r if r != null else s
	if r != null:
		r.focus_neighbor_top = r.get_path_to(mas)
		r.focus_neighbor_bottom = r.get_path_to(s if s != null else r)
		r.focus_neighbor_left = r.get_path_to(d if d != null else r)
		r.focus_neighbor_right = r.get_path_to(r)
	if s != null:
		s.focus_neighbor_top = s.get_path_to(r if r != null else mas)
		s.focus_neighbor_bottom = s.get_path_to(s)
		s.focus_neighbor_left = s.get_path_to(d if d != null else s)
		s.focus_neighbor_right = s.get_path_to(s)
	if d != null:
		d.focus_neighbor_top = d.get_path_to(mas)
		d.focus_neighbor_bottom = d.get_path_to(d)
		d.focus_neighbor_left = d.get_path_to(d)
		d.focus_neighbor_right = d.get_path_to(derecha if derecha != null else d)
	if mas != null:
		var abajo: Button = r if r != null else (s if s != null else (d if d != null else mas))
		mas.focus_neighbor_bottom = mas.get_path_to(abajo)
		mas.focus_neighbor_left = mas.get_path_to(d if d != null else mas)
		mas.focus_neighbor_right = mas.get_path_to(mas)
		mas.focus_neighbor_top = NodePath()


