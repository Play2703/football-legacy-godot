func _pa_t_ordena(caja: Control) -> void:
	var romper: Button = _ct_t_vivo(caja.find_child("Romper", true, false) as Button)
	var firmas: Array[Button] = []
	for i in Career.sponsor_offers.size():
		var f: Button = _ct_t_vivo(caja.find_child("Firmar%d" % i, true, false) as Button)
		if f != null:
			firmas.append(f)
	var primero: Button = firmas[0] if not firmas.is_empty() else romper
	if primero != null:
		primero.set_meta(Entrada.PRIMERO_META, true)
	for i in firmas.size():
		var f: Button = firmas[i]
		f.focus_neighbor_top = f.get_path_to(firmas[i - 1]) if i > 0 else NodePath()
		f.focus_neighbor_bottom = f.get_path_to(firmas[i + 1] if i + 1 < firmas.size() else f)
		f.focus_neighbor_left = f.get_path_to(romper if romper != null else f)
		f.focus_neighbor_right = f.get_path_to(f)
	if romper != null:
		romper.focus_neighbor_top = romper.get_path_to(firmas[0]) if not firmas.is_empty() else NodePath()
		romper.focus_neighbor_bottom = romper.get_path_to(romper)
		romper.focus_neighbor_left = romper.get_path_to(romper)
		romper.focus_neighbor_right = romper.get_path_to(firmas[0] if not firmas.is_empty() else romper)













