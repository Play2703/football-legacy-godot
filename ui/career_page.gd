	_cal_pinta_semanas(lista, d, int(d["primera"]), int(d["ultima"]), celda)
	return lista












func _cal_baja_al_mes(lista: VBoxContainer) -> void:
	var placa: Control = null
	var meses: int = 0
	for c in lista.get_children():
		if (c as Node).has_meta("cal_hoy"):
			break
		if (c as Node).has_meta("cal_mes"):
			meses += 1
			placa = c as Control
	if placa == null or meses <= 1:
		return
	var antes: int = -1
	for i in 12:
		await get_tree().process_frame
		if not is_instance_valid(_scroll) or not is_instance_valid(placa):
			return
		var y: int = maxi(0, int(placa.global_position.y - _scroll.global_position.y)
			+ _scroll.scroll_vertical - CAL_AL_MES_AIRE)
		_scroll.scroll_vertical = y
		if y == antes and _scroll.scroll_vertical == y:
			return
		antes = y



const CAL_AL_MES_AIRE: int = 12

var _cal_al_mes_hecho: bool = false






func _cal_semanas(filas: Array) -> Dictionary:



	var por_semana: Dictionary = {}
	var mes_de_fila: Dictionary = {}
	var por_mes: Dictionary = {}
	var fifa: Dictionary = {}
	var primera: int = 1<<30
	var ultima: int = -1



	_cal_sb_vacia = null
	_cal_sb_fifa = null
	_cal_sb_finde = null


	var hoy: int = CAL_SIN_HOY
	for f in filas:
		if bool(f["proximo"]):
			hoy = int(f["dia"])
			break
	for f in filas:
		var dia: int = int(f["dia"])
		var fila: int = floori(float(dia) / 7.0)
		if not por_semana.has(fila):
			por_semana[fila] = {}
			mes_de_fila[fila] = int(f["mes"])
		primera = mini(primera, fila)
		ultima = maxi(ultima, fila)




		if String(f["comp"]) == "nat":
			fifa[fila] = true


		if bool(_cal_oculta.get(String(f["familia"]), false)):
			continue
		(por_semana[fila] as Dictionary)[dia - fila * 7] = f
		var m_f: int = int(f["mes"])
		if not por_mes.has(m_f):
			por_mes[m_f] = []
		(por_mes[m_f] as Array).append(f)



	var mes_de_sem: Dictionary = {}
	var mes: int = 0
	for sem in range(primera, ultima + 1):
		var m: int = int(mes_de_fila.get(sem, mes))
		if m > 0:
			mes = m
		mes_de_sem[sem] = m
	return {"por_semana": por_semana, "mes_de_sem": mes_de_sem, "por_mes": por_mes, "fifa": fifa,
		"primera": primera, "ultima": ultima, "hoy": hoy}








func _cal_pinta_semanas(box: VBoxContainer, d: Dictionary, desde: int, hasta: int, celda: Vector2,
		sigue: bool = false, tocable: bool = true) -> void:
	var mes_de: Dictionary = d["mes_de_sem"]
	var por_semana: Dictionary = d["por_semana"]
	var fifa: Dictionary = d["fifa"]
	var hoy: int = int(d["hoy"])
	var mes: int = int(mes_de.get(desde - 1, 0)) if sigue else 0
	for sem in range(desde, hasta + 1):
		var m: int = int(mes_de.get(sem, mes))
		if m > 0 and m != mes:
			mes = m
			_cal_mes(box, mes,(d["por_mes"] as Dictionary).get(mes, []))
			_cal_dias(box)
		elif sigue and sem == desde:
			_cal_dias(box)


		if hoy != CAL_SIN_HOY and sem == floori(float(hoy) / 7.0):
			_cal_linea_hoy(box)
		_cal_semana(box, sem, por_semana.get(sem, {}), celda, bool(fifa.get(sem, false)), hoy,
			tocable)









func _cal_semana(box: VBoxContainer, sem: int, por_dia: Dictionary, celda: Vector2,
		fifa: bool = false, hoy: int = CAL_SIN_HOY, tocable: bool = true) -> void:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", CAL_CELDA_SEP)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.set_meta("cal_semana", sem)
	if fifa:
		fila.set_meta("cal_fifa", true)
	var pasada: bool = sem * 7 + 6 < hoy
	if pasada:
		fila.set_meta("cal_semana_pasada", true)
	box.add_child(fila)
	var num: Label = CareerUi.plain(CareerTheme.T_CAPTION,
		_cal_label_col(_cal_tint("nat")) if fifa else CareerTheme.TEXT_DIM)
	num.text = str(sem)
	num.clip_text = true
	num.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	num.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	num.custom_minimum_size = Vector2(CAL_CANAL, celda.y)
	if pasada:
		num.modulate.a = CAL_VELO
	fila.add_child(num)
	for col in 7:
		if por_dia.has(col):
			var cas: Control = _cal_casilla(por_dia[col], celda, true, tocable)
			if sem * 7 + col < hoy:
				cas.modulate.a = CAL_VELO
			fila.add_child(cas)
		else:
			fila.add_child(_cal_celda_vacia(celda.y, fifa, sem * 7 + col < hoy, sem * 7 + col,
