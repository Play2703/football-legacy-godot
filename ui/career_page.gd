		pts.text = str(int(f["pts"]))
		pts.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		pts.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		if columnas:





			pts.custom_minimum_size.x = float(anchos.get("pts_cifra", anchos["pts"]))
			pts.set_meta("grupo_pts", true)
