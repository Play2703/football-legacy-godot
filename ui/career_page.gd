func _torn_nat_es_titulo(h: Dictionary) -> bool:
	var texto: String = String(h.get("text", ""))
	return bool(h.get("mine", texto.to_upper().contains("CAMPEÓN") and not texto.contains("sin ti")))





func _torn_nat_hoja_caben(box: VBoxContainer, heroe: Control, n: int) -> bool:
	var vp: Viewport = box.get_viewport()
	if vp == null:
		return true
	var sep: float = float(CareerUi.PLANTILLA_SEP)
	var alto: float = vp.get_visible_rect().size.y - box.offset_top + box.offset_bottom \
			- CareerTheme.TOQUE_TUMBADO - sep - float(CareerUi.PLANTILLA_AIRE_ARRIBA) \
			- heroe.get_combined_minimum_size().y - sep - CareerTheme.TOQUE_PRINCIPAL_TUMBADO - sep
	return alto >= float(n) * CareerTheme.TOQUE_PRINCIPAL_TUMBADO + float(n - 1) * sep






func _torn_nat_hoja_heroe(cu: Dictionary, n: Dictionary, ancho: float) -> PanelContainer:
	var cifra: String = ""
	var linea: String = ""
	var resta: String = ""
	var rol: String = String(n.get("status", "fuera"))
	var score: float = snappedf(float(cu.get("score", 0.0)), 0.1)
	if Career.nat_retired or n.is_empty():



		cifra = I18n.t("RETIRADO")
	elif rol == "fuera":
		cifra = _ordinal(int(cu.get("rank", 0)))
		linea = I18n.t("NO CONVOCADO")
		var ovr_min: float = snappedf(float(cu.get("ovr_min", 0.0)), 0.1)
		if ovr_min > score:
			resta = I18n.tf("-{0} PARA ENTRAR", [String.num(ovr_min - score, 1)])
	else:
		cifra = Career.nat_role_label(rol)
		var bar: float = snappedf(float(cu.get("bar_starter", 0.0)), 0.1)
		linea = I18n.tf("-{0} PARA SER TITULAR", [String.num(bar - score, 1)]) \
				if rol != "titular" and bar > score else I18n.tf("NIVEL {0}", [_torn_nat_n(score)])
	var extra: Label = null
	if not resta.is_empty():
