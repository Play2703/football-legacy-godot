func _ti_t_dock_producto(p: Dictionary) -> void:
	var pid: String = String(p["pid"])
	_ti_t_dock_titulo(I18n.t(String(p["name"])))
	var ent: Dictionary = p.get("entrega", {})
	var es_lote: bool = String(p.get("tipo", "")) == Iap.TIPO_LOTE
	var extra: int = int(ent.get("puntos", 0)) if es_lote else int(p.get("puntos_extra", 0))
	if extra > 0:
		_ti_t_dock_linea(I18n.tf("+ {0} PUNTOS", [extra]) if es_lote
			else I18n.tf("+ {0} PUNTOS DE HABILIDAD", [extra]), CareerTheme.TEXT)
	var bono: int = Iap.bono(p)
	if bono > 0 and p != Iap.COMBO:
		_ti_t_dock_linea("%s +%d%%" % [I18n.t("EXTRA"), bono], CareerTheme.MONEY)
	for boot_id in ent.get("botas", []):
		var b: Dictionary = Shop.boots_by_id(String(boot_id))
		_ti_t_dock_linea(I18n.tf("+ {0} · DURAN {1} PARTIDOS",
			[I18n.t(String(b["name"])), int(b["life"])]), CareerTheme.TEXT)
	for ed_id in ent.get("ediciones", []):
		var ed: Dictionary = Iap.edicion(String(ed_id))
		if not ed.is_empty():
			_ti_t_dock_linea("+ " + I18n.t(String(ed["name"])), CareerTheme.TEXT)
	_ti_t_dock_linea(_caja_linea(p, false))
	_ti_t_dock_linea(Store.texto_dinero_real(), CareerTheme.MONEY)
	_ti_t_dock_hueco()
	var puede: bool = Store.se_puede_pagar()
	var real: Button = _caja_real(Store.precio_de(pid), puede, pid)
	real.name = "Pagar"

	for l in real.find_children("*", "Label", true, false):
		var px: int =(l as Label).get_theme_font_size("font_size")
		if px != CareerTheme.T_CAP_TUMBADO:
			(l as Label).add_theme_font_size_override("font_size", CareerTheme.T_LEE_TUMBADO)
	real.custom_minimum_size = Vector2(0.0, CareerTheme.TOQUE_PRINCIPAL_TUMBADO)
	real.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_ti_t_dock.add_child(real)





func _ti_t_lista_modal(rotulo: String, datos: Array[Dictionary], meta: String) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	box.set_meta(meta, datos.size())
	box.add_theme_constant_override("separation", 24)
	var t: Label = _mk_t_label(CareerTheme.T_TITULO_TUMBADO, CareerTheme.TEXT,
		CareerTheme.caps(rotulo), false)
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	var cols: HBoxContainer = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 24)
	box.add_child(cols)
	var lista: VBoxContainer = null
	for i in datos.size():
		if i % TI_T_MODAL_COL == 0:
			lista = VBoxContainer.new()
			lista.add_theme_constant_override("separation", 16)
			lista.custom_minimum_size.x = TI_T_MODAL_ANCHO
			cols.add_child(lista)
		var d: Dictionary = datos[i].duplicate()
		var id: String = String(d.get("id", ""))
		var hacer: Callable = d.get("al_tocar", Callable())
		d["al_tocar"] = func() -> void:
			CareerUi.close_modal(box)
			if meta == "ti_t_lista" and _shop_infos.has(id):
				_shop_sel[_shop_tab] = id
				_refresh()
			elif hacer.is_valid():
				hacer.call()
		var fila: Button = _ti_t_fila(d)
		fila.set_meta("ti_t_modal_fila", id)
		lista.add_child(fila)




func _ti_t_vendidas_modal() -> void:
	var rows: Array = Career.jersey_table()
	if rows.is_empty():
		return
	var box: VBoxContainer = CareerUi.modal(self)
	box.set_meta("ti_t_vendidas", rows.size())
	box.add_theme_constant_override("separation", 24)
	var t: Label = _mk_t_label(CareerTheme.T_TITULO_TUMBADO, CareerTheme.TEXT,
		"%s · %s" % [I18n.t("LAS MÁS VENDIDAS"),
			I18n.tf("{0} AL AÑO", [CareerUi.short_money(Career.jersey_volume())])], false)
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	var cols: HBoxContainer = HBoxContainer.new()
	cols.add_theme_constant_override("separation", 24)
	box.add_child(cols)
	var top_share: float = maxf(0.0001, float((rows[0] as Dictionary).get("share", 0.0)))
	var rating: int = Teams.rating(GameState.player_team_id)
	var div: int = GameState.player_div()





	var k: float = _torn_ancho_plantilla() / TI_T_DISENO_W
	var tope: float = get_viewport_rect().size.x - TI_T_MODAL_TOPE
	var total: float = minf(floor(TI_T_MODAL_ANCHO * k * 2.0 + 24.0), tope)
	var ncol: int = 2 if floor((total - 24.0) / 2.0) >= TI_T_MODAL_COL_MIN else 1
	var ancho_col: float = floor((total - 24.0) / 2.0) if ncol == 2 else total
	box.set_meta("ti_t_vendidas_cols", ncol)
	var lista: VBoxContainer = null
	for i in mini(rows.size(), TI_T_MODAL_COL * ncol):
		if i % TI_T_MODAL_COL == 0:
			lista = VBoxContainer.new()
			lista.add_theme_constant_override("separation", 16)
			lista.custom_minimum_size.x = ancho_col
			cols.add_child(lista)
		var r: Dictionary = rows[i]
		var yours: bool = bool(r.get("is_you", false))
		var share: float = float(r.get("share", 0.0))
		var col: Color = CareerTheme.MONEY if yours else CareerTheme.TEXT
		var fila: PanelContainer = _mk_t_placa("Vendida%d" % i, 24.0, 0.0)
		fila.custom_minimum_size.y = TI_T_FILA_H
		fila.set_meta("ti_t_vendida", yours)
		var h: HBoxContainer = HBoxContainer.new()
		h.add_theme_constant_override("separation", 16)
		h.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fila.add_child(h)
		var pos: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, col, "%d" %(i + 1))
		pos.custom_minimum_size.x = 48.0
		pos.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		h.add_child(pos)
		var medalla: Control = _jersey_ovr(r)
		medalla.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(medalla)

		var pos_id: String = String(r.get("pos", ""))
		var chip: Control = CareerUi.code_chip(CareerUi.pos_rotulo(pos_id),
			CareerUi.pos_color(pos_id), CareerTheme.T_CAP_TUMBADO, 10.0, 4.0)
		chip.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(chip)
		var n: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, col,
			CareerUi.display_name(Competitions.demarca(String(r.get("name", "")))))
		n.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		n.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		h.add_child(n)
		var u: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, col,
			CareerUi.short_money(JerseySales.units_of(share, rating, div)))
		u.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		u.custom_minimum_size.x = _wnews_ancho(u.text, CareerTheme.T_LEE_TUMBADO) + 4.0
		h.add_child(u)
		var cuota: VBoxContainer = VBoxContainer.new()
		cuota.custom_minimum_size.x = 120.0
		cuota.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cuota.add_theme_constant_override("separation", 4)
		cuota.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h.add_child(cuota)
		var pct: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, col,
			"%s%%" % I18n.num(share * 100.0, 1))
		pct.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		cuota.add_child(pct)
		var barra: ColorRect = CareerUi.bar(cuota, col, 8.0)
		barra.custom_minimum_size.x = floor(120.0 * clampf(share / top_share, 0.0, 1.0))
		barra.size_flags_horizontal = Control.SIZE_SHRINK_END
		lista.add_child(fila)
	var cerrar: Button = Button.new()
	cerrar.name = "Volver"
	cerrar.text = I18n.t("VOLVER")
	cerrar.custom_minimum_size = Vector2(0.0, TI_T_FILA_H)
	CareerTheme.apply_button(cerrar, CareerTheme.Kind.NEUTRAL, CareerTheme.T_LEE_TUMBADO)
	cerrar.pressed.connect(CareerUi.close_modal.bind(box))
	box.add_child(cerrar)





func _ti_t_ordena() -> void:
	if _ti_t_celdas.is_empty():
		_ti_t_foco = ""
		return
	var sel: String = String(_shop_sel.get(_shop_tab, ""))
	_ti_t_cursor = 0
	for j in _ti_t_celdas.size():
		if not sel.is_empty() and String(_ti_t_celdas[j].get_meta("ti_t_celda", "")) == sel:
			_ti_t_cursor = j
	_ti_t_elige(_ti_t_cursor, false)
	var primero: Control = _ti_t_celdas[_ti_t_cursor]
	var seg: HBoxContainer = _ti_t_seg if _ti_t_foco == "familia" else \
			(_ti_t_seg_caja if _ti_t_foco == "caja" else null)
	if seg != null and is_instance_valid(seg):
		for c in seg.get_children():
			if c is Button and (c as Button).focus_mode == Control.FOCUS_ALL:
				primero = c
	_ti_t_foco = ""
	if primero != _ti_t_celdas[_ti_t_cursor]:
		_ti_t_celdas[_ti_t_cursor].remove_meta(Entrada.PRIMERO_META)
	primero.set_meta(Entrada.PRIMERO_META, true)





func _ti_t_elige(j: int, enfoca: bool = true) -> void:
	if j < 0 or j >= _ti_t_celdas.size():
		return
	for i in _ti_t_celdas.size():
		var b: Button = _ti_t_celdas[i]
		if is_instance_valid(b):
			if i == j:
				b.set_meta(Entrada.PRIMERO_META, true)
			elif b.has_meta(Entrada.PRIMERO_META):
				b.remove_meta(Entrada.PRIMERO_META)
	_ti_t_cursor = j
	_ti_t_dock_vuelve()
	if enfoca and is_instance_valid(_ti_t_celdas[j]):
		_ti_t_celdas[j].grab_focus()





func _ti_t_dock_vuelve() -> void:
	if _ti_t_dock == null or not is_instance_valid(_ti_t_dock) or _ti_t_celdas.is_empty():
		return
	var celda: Button = _ti_t_celdas[clampi(_ti_t_cursor, 0, _ti_t_celdas.size() - 1)]
	if not is_instance_valid(celda):
		return
	for h in _ti_t_dock.find_children("*", "BaseButton", true, false):
		(h as Control).focus_neighbor_left =(h as Control).get_path_to(celda)





func _ti_t_cruceta(ev: InputEvent, j: int) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO:
		return
	if j < 0 or j >= _ti_t_celdas.size():
		return
	var dir: String = _ti_t_dir(ev)
	if dir.is_empty():
		return
	_ti_t_celdas[j].accept_event()
	var n: int = _ti_t_celdas.size()
	var col: int = j % TI_T_COLS
	match dir:
		"ui_left":
			if col > 0:
				_ti_t_elige(j - 1)
		"ui_right":
			if col < TI_T_COLS - 1 and j + 1 < n:
				_ti_t_elige(j + 1)
			else:
				_ti_t_salta_dock()
		"ui_up":
			if j >= TI_T_COLS:
				_ti_t_elige(j - TI_T_COLS)
			else:
				_ti_t_sube_a_seg()
		"ui_down":
			if j + TI_T_COLS < n:
				_ti_t_elige(j + TI_T_COLS)
			elif j < n - 1 and j / TI_T_COLS ==(n - 1) / TI_T_COLS - 1:
				_ti_t_elige(n - 1)


func _ti_t_sube_a_seg() -> void:
	var seg: HBoxContainer = _ti_t_seg_caja if _ti_t_seg_caja != null \
			and is_instance_valid(_ti_t_seg_caja) else _ti_t_seg
	if seg == null or not is_instance_valid(seg):
		return
	for c in seg.get_children():
		if c is Button and (c as Button).focus_mode == Control.FOCUS_ALL:
			(c as Button).grab_focus()
			return



func _ti_t_salta_dock() -> void:
	if not _ti_t_filas_dock.is_empty():
		_ti_t_elige_fila(clampi(_ti_t_fila_cursor, 0, _ti_t_filas_dock.size() - 1))
		return
	if _ti_t_dock == null or not is_instance_valid(_ti_t_dock):
		return
	for h in _ti_t_dock.find_children("*", "BaseButton", true, false):
		if Entrada.enfocable(h):
			(h as Control).grab_focus()
			return




func _ti_t_elige_fila(i: int, enfoca: bool = true) -> void:
	if i < 0 or i >= _ti_t_filas_dock.size():
		return
	_ti_t_fila_cursor = i
	if enfoca and is_instance_valid(_ti_t_filas_dock[i]):
		_ti_t_filas_dock[i].grab_focus()



func _ti_t_fila_cruceta(ev: InputEvent, i: int) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO:
		return
	if i < 0 or i >= _ti_t_filas_dock.size():
		return
	var dir: String = _ti_t_dir(ev)
	if dir.is_empty():
		return
	_ti_t_filas_dock[i].accept_event()
	match dir:
		"ui_up":
			if i > 0:
				_ti_t_elige_fila(i - 1)
		"ui_down":
			if i + 1 < _ti_t_filas_dock.size():
				_ti_t_elige_fila(i + 1)
		"ui_left":
			_ti_t_elige(_ti_t_cursor)




func _ti_t_compra_x() -> bool:
	if _shop_tab == "caja" or not _ti_t_vista.is_empty():
		return false
	var sel: String = String(_shop_sel.get(_shop_tab, ""))
	var inf: Dictionary = _shop_infos.get(sel, {}) if not sel.is_empty() else {}
	var cta: Dictionary = inf.get("cta", {})
	if cta.is_empty() or not bool(cta.get("ok", false)):
		return false
	_shop_pagar(inf)
	return true




















