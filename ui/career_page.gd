func _seleccion_wc_live(st: Dictionary, nat_name: String) -> void:
	var champ: bool = bool(st.get("champion", false))
	var alive: bool = bool(st.get("alive", true))
	var tour: String = String(st.get("name", "MUNDIAL"))
	var accent: Color = CareerTheme.accent_text()

	if _torn_capturando:
		_torn_heroe_nat(st, nat_name)
	elif champ:
		var c: Label = CareerUi.plain(26, CareerTheme.MONEY)
		c.text = I18n.tf("¡{0}, CAMPEÓN de {1}!", [CareerTheme.caps(nat_name), I18n.t(tour)])
		c.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(c)
	elif not alive:
		var out: Label = CareerUi.plain(22, CareerTheme.DANGER)
		out.text = I18n.tf("{0} quedó eliminada de {1}", [nat_name, I18n.t(tour)])
		out.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(out)
	var groups: Array = st.get("groups", [])
	if not groups.is_empty():





		var fmt: Dictionary = NatTeam.tournament_format(String(st.get("comp", "wc")),
			Career.nationality)
		var avanzan: int = int(fmt.get("advance", NatTeam.WC_ADVANCE))
		var terceros: int = maxi(0, int(fmt.get("bracket", 0)) - groups.size() * avanzan)
		var filas_de: Array = []
		for gi in groups.size():
			filas_de.append(_nat_live_rows((groups[gi] as Dictionary).get("table", {}),
				nat_name))
		var terceros_dentro: Dictionary = _nat_terceros_dentro(filas_de, avanzan, terceros)
		var cartas: Array = []
		for gi in groups.size():
			var letter: String = _torn_letra_grupo(gi)
			var rows: Array = filas_de[gi]
			if UiKit.es_horizontal():
				var filas: Array = []
				for r in rows:
					filas.append({"team": Nations.as_team(String(r["id"])),
						"you": bool(r["you"]), "pts": int(r["pts"])})

				var filas_t: Array = []
				for r in rows:
					filas_t.append({"club": String(r["id"]), "nombre": String(r["name"]),
						"pj": int(r["pj"]), "w": int(r["g"]), "d": int(r["e"]),
						"l": int(r["p"]), "dif": int(r["gd"]), "pts": int(r["pts"]),
						"tuya": bool(r["you"]), "sancion": false})
				cartas.append({"titulo": I18n.tf("GRUPO {0}", [letter]), "filas": filas,
					"pasan": avanzan, "filas_t": filas_t,
					"tercero_pasa": terceros_dentro.has(gi),
					"detalle": _nat_table.bind(rows, accent, avanzan)})
				continue
			_torn_head(I18n.tf("GRUPO {0}", [letter]), accent)
			_nat_table(rows, accent, avanzan)
		_grupos_cartas(cartas, accent)


		if not UiKit.es_horizontal():
			_torn_nota(I18n.tf("Pasan los {0} primeros de cada grupo y los {1} mejores terceros.",
				[avanzan, terceros]) if terceros > 0
				else I18n.tf("Pasan los {0} primeros de cada grupo.", [avanzan]))
		else:





			_torn_leyenda(_torn_leyenda_grupos(groups.size(), avanzan, terceros, accent,
				not terceros_dentro.is_empty()))


	var bracket: Array = st.get("bracket", [])
	if bracket.is_empty() and UiKit.es_horizontal():
		return

	if _torn_capturando:
		_torn_cuadro(bracket, st.get("ko_names", []), accent,
			Nations.as_team(Career.nationality))
		return
	_torn_head(I18n.t("CUADRO"), accent, true)
	_nat_bracket(bracket, st.get("ko_names", []), GameState.YOU_KEY, accent)




func _torn_heroe_nat(st: Dictionary, nat_name: String) -> void:
	if _torn_heroe_ko(bool(st.get("champion", false)), bool(st.get("alive", true)),
			int(st.get("ko_idx", 0)), st.get("ko_names", []), st.get("bracket", [])):
		return
	var groups: Array = st.get("groups", [])
	for gi in groups.size():
		var rows: Array = _nat_live_rows((groups[gi] as Dictionary).get("table", {}), nat_name)
		for i in rows.size():
			if bool((rows[i] as Dictionary)["you"]):
				if _torn_sin_jugar(rows[i]):
					_torn_apunta_heroe(_torn_j0(), _torn_linea_j0())
