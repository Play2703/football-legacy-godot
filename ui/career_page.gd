func _tira_tumbada() -> bool:




	return UiKit.es_horizontal() and TIRA_PAGINAS.has(_page) \
			and not (_page == "casa" and _casa_desde_tienda) \
			and not (_page == "legado" and _leg_tab != "carrera") \
			and not (_page == "gerencia" and _ger_tab_viva() != GER_TAB_PRIMAS)




func _atras_sub() -> void:

	if _page == "tienda" and not _ti_t_vista.is_empty():
		_ti_t_vista = ""
		_refresh()
		return
	if _sub_padre.is_empty():
		_ir_al_hub()
	else:
		_on_tab(_sub_padre)


func _ir_al_hub() -> void:
	Career.clear_spend_undo()
	SceneFade.to_scene("res://ui/career_hub.tscn")


func _aire_v(alto: float) -> Control:
	var c: Control = Control.new()
	c.custom_minimum_size = Vector2(0, alto)
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return c





func _page_tiene_banda() -> bool:
	match _page:
		"aspecto":
			return true
		"perfil":


			return not (_perf_tab == "contrato" and _tira_tumbada())
		"tienda":

			return not _tira_tumbada()
		"relaciones":
			return not RelationsStage.headless() and not _tira_tumbada()
		"gerencia":

			return not BoardStage.headless() and not Career.free_agent \
					and not GameState.player_team_id.is_empty() and not _tira_tumbada()
	return false






func _ancho_contenido_apaisado(con_banda: bool) -> float:
	var util: float = _ancho_util_apaisado()
	if _cede >= 2:
		return util
	if _page == "ranking":
		return util

	if _page == "perfil" and _perf_tab == "contrato" and _tira_tumbada():
		return util

	if _page == "perfil" and _tira_tumbada():
		return PF_T_COL_W





	if not con_banda:
		return util
	var banda: float = BANDA_MIN if _cede == 1 \
			else clampf(util - CONTENIDO_MIN, BANDA_MIN, BANDA_MAX)
	return util - banda




func _ancho_util_apaisado() -> float:
	var vp: Viewport = get_viewport()
	var util: float = UiKit.lienzo().x
	if vp != null:


		var lados: Vector2 = UiKit.side_safe_insets(vp, UiKit.CORTESIA_LATERAL)
		util = vp.get_visible_rect().size.x - lados.x - lados.y

	return util -(0.0 if _tira_tumbada() else NavBar.ancho_seccion())








var _giro_lados: Vector2 = Vector2(-1.0, -1.0)


func _vigila_giro() -> void:
	if not UiKit.es_horizontal() or not (OS.has_feature("ios") or OS.has_feature("android")):
		return
	if get_node_or_null("Giro") != null:
		return
	_giro_lados = UiKit.side_safe_insets(get_viewport(), UiKit.CORTESIA_LATERAL)
	var t: Timer = Timer.new()
	t.name = "Giro"
	t.wait_time = 0.5
	t.autostart = true
	t.timeout.connect(_comprueba_giro)
	add_child(t)


func _comprueba_giro() -> void:
	var vp: Viewport = get_viewport()
	if vp == null or _root == null or not UiKit.es_horizontal():
		return
	var lados: Vector2 = UiKit.side_safe_insets(vp, UiKit.CORTESIA_LATERAL)
	if lados.is_equal_approx(_giro_lados):
		return
	_giro_lados = lados
	CareerUi.apply_safe_area_lados(_root)
	if _header != null:
		_header.estira_fondo()
	if _nav != null:
		_nav._estira_fondo()
















var _cede: int = 0
var _cede_tab: String = ""
var _fila_banda: VBoxContainer = null
var _fila_col: VBoxContainer = null


func _cede_ancho() -> void:
	var ds: DragScroll = _scroll as DragScroll
	if ds == null or not ds.repartido() or ds.no_caben == 0:
		return
	_cede_pedido()






func _cede_pedido() -> bool:
	if _cede >= 2 or _fila_col == null or not is_instance_valid(_fila_col):
		return false
	var con_banda: bool = is_instance_valid(_fila_banda) and _fila_banda.visible
	if con_banda and _cede == 1 and _page == "aspecto":
		return false



	if not con_banda:
		return false
	_cede += 1
	_aplica_cede.call_deferred()
	return true


func _aplica_cede() -> void:
	if _fila_col == null or not is_instance_valid(_fila_col):
		return
	var con_banda: bool = is_instance_valid(_fila_banda) and _fila_banda.visible
	var ancho: float = _ancho_contenido_apaisado(con_banda)
	if _cede >= 2 and con_banda:
		_fila_banda.visible = false
		_fila_col.size_flags_horizontal = Control.SIZE_EXPAND|Control.SIZE_SHRINK_CENTER
	_fila_col.custom_minimum_size.x = ancho
	_refresh()




func _apaisa_columnas(banda_padre: VBoxContainer, col: VBoxContainer,
		ancho_col: float) -> void:
	if banda_padre.get_child_count() == 0 or _cede >= 2:
		banda_padre.visible = false
		col.custom_minimum_size.x = ancho_col
		col.size_flags_horizontal = Control.SIZE_EXPAND|Control.SIZE_SHRINK_CENTER
		return
	for c in banda_padre.get_children():
		_banda_de_pie(c as Control)
	banda_padre.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.custom_minimum_size.x = ancho_col
	col.size_flags_horizontal = Control.SIZE_FILL




func _banda_de_pie(c: Control) -> void:
	if c == null or not UiKit.es_horizontal():
		return
	c.custom_minimum_size = Vector2.ZERO
	c.size_flags_vertical = Control.SIZE_EXPAND_FILL
	c.size_flags_horizontal = Control.SIZE_EXPAND_FILL

















func _refresh_avisos() -> void:

	var tira: bool = _nav != null and _nav.es_tira()
	if _nav != null:
		var por_familia: Dictionary = Avisos.agrupados("familia")
		if tira:
			por_familia = CareerNav.avisos_por_seccion(por_familia)
		for fam in (CareerNav.secciones_tumbadas() if tira else CareerNav.FAMILIES):
			var id: String = String(fam["id"])
			var a: Dictionary = por_familia.get(id, {})
			_nav.mark(id, Color(a["tint"]) if not a.is_empty() else UiKit.CLEAR,
				bool(a.get("pulse", false)),
				PackedStringArray(a.get("msgs", []) as Array))
	if _tabs == null:
		return
	var por_tab: Dictionary = Avisos.agrupados("pestana")
	for t in (CareerNav.tabs_tumbados(_family) if tira else CareerNav.tabs_of(_family)):
		var id: String = String(t["id"])
		var a: Dictionary = por_tab.get(id, {})
		_tabs.mark(id, Color(a["tint"]) if not a.is_empty() else UiKit.CLEAR,
			bool(a.get("pulse", false)),
			PackedStringArray(a.get("msgs", []) as Array))







func _sync_nav() -> void:
	var sub: String = _current_sub()
	_sub_padre = ""
	_sub_rotulo = ""
	if _tira_tumbada():


		var r: Dictionary = CareerNav.seccion_tumbada(_page, sub)
		_family = String(r["seccion"])
		_tab_id = String(r["tab"])
		_sub_padre = String(r["padre"])
		_sub_rotulo = String(r["rotulo"])
		return
	var tab: String = CareerNav.tab_of_page(_page, sub)
	if tab.is_empty():
		return
	_tab_id = tab
	_family = CareerNav.family_of_tab(tab)















func _count_open() -> void:
	var tab: String = CareerNav.tab_of_page(_page, _current_sub())
	if tab.is_empty():
		return
	Telemetry.count("pantalla_%s" % tab)




func _current_sub() -> String:
	match _page:
		"perfil":
			return _perf_tab
		"historia":
			return _hist_tab
		"legado":
			return _leg_tab
		"relaciones":
			return _rel_vista
		"torneos":

			return "nat" if _torn_comp == "nat" else ""
	return ""





func _apply_sub(page: String, sub: String) -> void:


	if page == "relaciones":
		_rel_vista = sub
		return


	if page == "torneos" and sub.is_empty() and _torn_comp == "nat":
		_torn_comp = "liga"





	if page == "tienda":
		_ti_t_vista = ""
	if page == "tienda" and sub.is_empty():
		_shop_tab = "caja" if Store.caja_disponible() else "botas"
		_caja_por_defecto = _shop_tab == "caja"
		return
	if sub.is_empty():
		return
	match page:
		"perfil":
			_perf_tab = sub
		"tienda":



			_shop_tab = sub
		"historia":
			_hist_tab = sub
		"legado":
			_leg_tab = sub
		"torneos":
			_torn_comp = sub





func _on_tab(tab_id: String) -> void:
	if tab_id == _tab_id:
		return
	var route: Array = CareerNav.route_tumbada(tab_id)
	if route.is_empty():
		return
	_tab_id = tab_id
	_page = String(route[0])
	if _page != "casa":
		_casa_desde_tienda = false
	_apply_sub(_page, String(route[1]))


	_sync_nav()




	_count_open()
	if _page == "mercado":


		_offer_open = -1
		_loan_open = -1
		_mt_vista = ""
		Career.mark_market_news_seen()
		Career.mark_agent_result_seen()
		Career.mark_haggle_results_seen()



	if _page == "noticias":
		Career.mark_world_news_seen()
	if _page == "fichajes":
		Career.mark_market_news_seen()
	_rebuild()





func _on_family(family: String) -> void:


	if family == "hogar":
		_ir_al_hub()
		return
	if family == _family:
		return
	var tabs: Array = CareerNav.tabs_tumbados(family) if _nav != null and _nav.es_tira() \
			else CareerNav.tabs_of(family)
	if tabs.is_empty():
		return
	_family = family
	_on_tab(String(tabs[0]["id"]))









func _rebuild() -> void:
	if _root == null:
		return




	_close_tour()
	remove_child(_root)
	_root.queue_free()
	_root = null
	_build_ui.call_deferred()












	_refresh_pending = true

	_mesa_en_sitio = false
	_refresh_now.call_deferred()


func _exit_tree() -> void:




	Career.clear_spend_undo()


	Career.gerencia_mesa_vuelca()








var _refresh_pending: bool = false






var _build_gen: int = 0


var _refresh_peticiones: int = 0


func _refresh() -> void:
	_refresh_peticiones += 1



	_mesa_en_sitio = false
	if _refresh_pending:
		return
	_refresh_pending = true
	_refresh_now.call_deferred()


func _refresh_now() -> void:















	if _root == null or _header == null or not is_instance_valid(_header):






		if _root != null:
			_refresh_pending = false
		return
	_refresh_pending = false


	if _mesa_en_sitio:
		_mesa_en_sitio = false
		if _mesa_repinta():
			_refresh_avisos()
			_mesa_scroll_compensa(true)
			return
	_header.refresh()
	_build_content()



	_refresh_avisos()
	_mesa_scroll_compensa(false)




