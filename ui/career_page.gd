		return
	var k: int = 0
	for fila in caja.get_children():
		if fila is HBoxContainer and fila.get_child_count() > 1 and k < tipos.size():
			var ic: TrophyIcon = _hc_trofeo(String(tipos[k]), 32.0)
			fila.add_child(ic)
			fila.move_child(ic, 1)
			k += 1








func _hc_fila(puesto: int, club: String, alto: float, nombre_w: float = 0.0,
		med: Dictionary = {}) -> PanelContainer:
	var p: Dictionary = Palmares.of(club)
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var nombre: String = _hc_nombre_club(club, compacta)
	var celdas: Array = [
		{"texto": str(puesto), "ancho": float(med.get("pos", HC_COL_POS)), "derecha": true,
			"tam": tam, "color": CareerTheme.TEXT_MID},
		{"nodo": _hc_escudo(club, alto)},
		{"texto": nombre, "expand": nombre_w <= 0.0, "ancho": maxf(nombre_w, 0.0), "tam": tam}]


	var tam_tot: int = CareerTheme.T_DATO_TUMBADO if alto >= HC_FILA_H else tam
	var w_trofeo: float = float(med.get("trofeo", HC_COL_TROFEO))
	for kind in Palmares.KINDS:
		var n: int = int(p.get(kind, 0))
		celdas.append({"texto": str(n), "ancho": w_trofeo, "derecha": true, "tam": tam,
			"color": CareerTheme.TEXT if n > 0 else CareerTheme.TEXT_DIM})
	celdas.append({"texto": str(Palmares.total(club)), "ancho": float(med.get("tot", HC_COL_TOT)),
		"derecha": true, "tam": tam_tot})
	celdas.append({"texto": "", "ancho": HC_COLA})
	var tuya: bool = club == GameState.player_team_id
	var f: PanelContainer = CareerUi.fila_tumbada(alto, Color.TRANSPARENT, celdas, tuya,
		CareerTheme.NAV_LEGADO)
	if nombre_w <= 0.0:



		var nom: Label =(f.get_meta("fila_celdas") as Array)[2] as Label
		nom.set_meta("hc_nombre", nombre)
		nom.resized.connect(_hc_nombre_ajusta.bind(nom))
	f.name = "FilaClub"
	f.set_meta("hc_club", club)
	f.set_meta("fl_fila", true)
	if tuya:
		f.set_meta("fl_tuya", true)
	f.size_flags_vertical = Control.SIZE_EXPAND_FILL
	return f



func _hc_nombre_ajusta(l: Label) -> void:
	if not is_instance_valid(l) or l.size.x <= 0.0:
		return
	var f: Font = l.get_theme_font("font")
	if f == null:
		return
	var txt: String = _hc_nombre_cabe(String(l.get_meta("hc_nombre", l.text)), l.size.x, f,
		l.get_theme_font_size("font_size"))
	if l.text != txt:
		l.text = txt





func _hc_nombre_cabe(nombre: String, ancho: float, f: Font, tam: int) -> String:
	if f.get_string_size(nombre, HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x <= ancho:
		return nombre
	var partes: PackedStringArray = nombre.split(" ", false)
	while partes.size() > 1:
		partes.remove_at(partes.size() - 1)
		while partes.size() > 1 and HC_PARTICULAS.has(partes[partes.size() - 1].to_lower()):
			partes.remove_at(partes.size() - 1)
		var corto: String = " ".join(partes)
		if f.get_string_size(corto, HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x <= ancho:
			return corto
	return " ".join(partes)





