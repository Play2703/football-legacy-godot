func _news_rows(scope: String, tope: int) -> Array:
	var pool: Array = []
	for n in Career.market_news:
		if not _news_in_scope(n, scope):
			continue
		if _news_tab == "valor" and (String(n.get("kind", "")) != "signing"
				or int(n.get("fee", 0)) <= 0):
			continue
		if _news_tab == "ovr" and int(n.get("media", 0)) <= 0:
			continue
		pool.append(n)
	if _news_tab == "valor" or _news_tab == "ovr":
		var llave: String = "fee" if _news_tab == "valor" else "media"
		var otra: String = "media" if _news_tab == "valor" else "fee"


		var idx: Array = range(pool.size())
		idx.sort_custom(func(i: int, j: int) -> bool:
			var a: Dictionary = pool[i]
			var b: Dictionary = pool[j]
			var va: int = int(a.get(llave, 0))
			var vb: int = int(b.get(llave, 0))
			if va != vb:
				return va > vb
			var oa: int = int(a.get(otra, 0))
			var ob: int = int(b.get(otra, 0))
			if oa != ob:
				return oa > ob
			return i < j)
		pool = idx.map(func(i: int) -> Dictionary: return pool[i])





	if scope == "mundo":
		var mia: Array = []
		var resto: Array = []
		for n in pool:
			(mia if _news_in_scope(n, "liga") else resto).append(n)
		pool = mia + resto
	return pool.slice(0, mini(tope, pool.size()))









func _news_in_scope(n: Dictionary, scope: String) -> bool:
	if scope == "mundo":
		return true
	if scope == "club":
		var club: String = GameState.player_team_id
		if club.is_empty():
			return false
		return String(n.get("to", "")) == club or String(n.get("from", "")) == club
	var mine: String = Teams.country_of(GameState.player_team_id)
	if mine.is_empty():
		return true
	return Teams.country_of(String(n.get("to", ""))) == mine \
			or Teams.country_of(String(n.get("from", ""))) == mine




























