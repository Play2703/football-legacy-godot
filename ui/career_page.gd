	_ley_country = String(countries[(i + dir + countries.size()) % countries.size()])

	var clubs: Array = Teams.teams_of_country(_ley_country)
	_ley_club = String(clubs[0]["id"]) if not clubs.is_empty() else ""
	_refresh()


func _cycle_ley_club(dir: int) -> void:
	var ids: Array = []
	for t in Teams.teams_of_country(_ley_country):
		ids.append(String(t["id"]))
	if ids.is_empty():
		return
	var i: int = ids.find(_ley_club)
	if i < 0:
		i = 0
	_ley_club = String(ids[(i + dir + ids.size()) % ids.size()])
	_refresh()




