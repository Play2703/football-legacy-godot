func _balon_candidato(puesto: int, e: Dictionary) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var tumbado: bool = UiKit.es_horizontal()
	var g_ucl: int = int(e.get("ucl_goals", 0))
	var a_ucl: int = int(e.get("ucl_assists", 0))
	var filas: Array = [
		{"rotulo": I18n.t("PUESTO"), "valor": I18n.ordinal(puesto), "color": _balon_metal(puesto)},
		{"rotulo": I18n.t("PUNTOS"), "valor": "%.0f" % float(e.get("score", 0.0)),
			"color": CareerTheme.MONEY},
		{"rotulo": I18n.t("GOLES"), "valor": str(int(e.get("goals", 0)) + g_ucl),
			"color": CareerTheme.TEXT},
		{"rotulo": I18n.t("ASIST."), "valor": str(int(e.get("assists", 0)) + a_ucl),
			"color": CareerTheme.TEXT},
		{"rotulo": I18n.t("MEDIA"), "valor": I18n.num(float(e.get("avg", 0.0)), 1),
			"color": CareerTheme.TEXT},
	]
	if int(e.get("apps", 0)) > 0:
		filas.append({"rotulo": I18n.t("PARTIDOS"), "valor": str(int(e.get("apps", 0))),
			"color": CareerTheme.TEXT})
	if g_ucl > 0 or a_ucl > 0:
		filas.append({"rotulo": I18n.t(Competitions.comp_name("champions")),
			"valor": "%dG %dA" % [g_ucl, a_ucl], "color": CareerTheme.TEXT})
	box.add_child(CareerUi.ficha_detalle(_balon_escudo(String(e.get("team", "")), 72.0),
		CareerUi.display_name(String(e.get("name", "?"))), filas))
	var titles: Array = e.get("titles", [])
	if not titles.is_empty():
		var trow: HFlowContainer = HFlowContainer.new()
		trow.add_theme_constant_override("h_separation", 16)
		trow.add_theme_constant_override("v_separation", 8)
		box.add_child(trow)
		for t in titles:
			trow.add_child(_balon_title_chip(String(t)))
	var counts: Dictionary = {}
	for a in e.get("awards", []):
		var tr: Dictionary = Trophies.of(String(a))
		if String(tr.get("kind", "")) == "individual" and String(a) != "Balón de Oro":
			counts[String(a)] = int(counts.get(String(a), 0)) + 1
	if not counts.is_empty():
		var arow: VBoxContainer = VBoxContainer.new()
		arow.add_theme_constant_override("separation", 6)
		box.add_child(arow)

		for key in Trophies.ORDER:
			if counts.has(key):
				arow.add_child(_balon_award_chip(String(key), int(counts[key])))
	var cerrar: Button = Button.new()
	cerrar.text = I18n.t("CERRAR")
	cerrar.custom_minimum_size = Vector2(CareerUi.LISTA_VOLVER_W, CareerTheme.TOQUE_TUMBADO) \
			if tumbado else Vector2(0, CareerTheme.BTN_ROW_H)
	if tumbado:
		cerrar.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	cerrar.clip_text = true
	CareerTheme.apply_button(cerrar, CareerTheme.Kind.GHOST,
		CareerTheme.T_LEE_TUMBADO if tumbado else CareerTheme.T_BODY)
	cerrar.pressed.connect(func() -> void: CareerUi.close_modal(box))
	box.add_child(cerrar)



