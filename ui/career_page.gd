		CareerUi.tab_chips(_content, labels, idx, func(i: int) -> void:
			_renewal_pack = String(packs[i]["pack"])
			_refresh_keeping_scroll())
	var years: int = int(o["seasons"])
	var delta: int = int(o["delta"])






	_chip_grid([
		["jornada", I18n.t("AÑOS QUE OFRECEN"),
