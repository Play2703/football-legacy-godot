func _transfers_block(club_only: bool = false, rotulo: bool = true) -> void:
	if Career.market_news.is_empty():
		return
	if _news_scope.is_empty():
		_news_scope = _news_default_scope()
	var scope: String = "club" if club_only else _news_scope
	var rows: Array = _news_rows(scope, NEWS_SHORT if club_only else NEWS_ROWS)
	if club_only and rows.is_empty():
		return
	if rotulo:
		CareerUi.head(_content, I18n.t("EN TU VESTUARIO") if club_only \
				else I18n.t("FICHAJES"))
	if not club_only:
		_news_tabs()
	if rows.is_empty():
		CareerUi.vacio_apaisado(_content, _news_empty_text(), "mercado")
		return
	var lista: VBoxContainer = VBoxContainer.new()
	lista.add_theme_constant_override("separation", 6)
	_content.add_child(lista)
	for n in rows:
		lista.add_child(_news_card(n))





func _news_default_scope() -> String:
	for s in ["club", "liga", "mundo"]:
		for n in Career.market_news:
			if _news_in_scope(n, s):
				return s
	return "mundo"





func _news_empty_text() -> String:
	if _news_scope == "club":
		if Career.free_agent:
			return I18n.t("Sin club: nadie entra ni sale de un vestuario que no tienes.")
		return I18n.t("Tu vestuario sigue igual: ni una alta ni una baja.")
	if _news_scope == "liga":
		return I18n.t("Ningún movimiento en tu liga todavía.")
	return I18n.t("El mercado todavía no se ha movido.")

















func _news_tabs() -> void:
	var row: HFlowContainer = HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 8)
	row.add_theme_constant_override("v_separation", 8)
	_content.add_child(row)





	row.add_child(CareerUi.icon_chip(_news_scope_icon(), _news_scope_text(),
		CareerTheme.accent_text(), false,
		func() -> void:
			_news_scope = _news_next_scope()
			_refresh()))
	for t in NEWS_ORDENES:
		var id: String = String(t["id"])
