				var letra: String = _torn_letra_grupo(gi)
				_torn_apunta_heroe(_ordinal(i + 1), I18n.tf("GRUPO {0}", [letra]) + " · "
					+ I18n.tf("{0} PTS", [int((rows[i] as Dictionary)["pts"])]))
				return
	_torn_apunta_heroe("-", I18n.t("En juego"))

















