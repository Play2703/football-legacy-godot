const TORN_TOPS_SEP: int = 24




const TORN_TOP_ICONO: float = 42.0








func _torn_tops_reparte(fila: HBoxContainer) -> void:
	if not is_instance_valid(fila) or fila.size.x <= 0.0:
		return
	var cols: Array[Control] = []
	var fijo: float = 0.0
	for c in fila.get_children():
		if c is Control and (c as Control).has_meta("top_fijo"):
			cols.append(c as Control)
			fijo += float((c as Control).get_meta("top_fijo"))
	if cols.size() < 2:
		return






	var libre: float = fila.size.x - float(TORN_TOPS_SEP) * float(cols.size() - 1) - fijo
	if libre <= 0.0:
		return



	var pides: Array[float] = []
	for c in cols:
		pides.append(_torn_tops_pide_nombre(c))



	var gasto: float = 0.0
	for c in cols:
		gasto += _torn_tops_holgura(c)
	var nombres: Array[float] = _torn_tops_nombres(libre - gasto, pides)
	var holgado: bool = true
	for i in cols.size():
		holgado = holgado and nombres[i] >= pides[i]
	if not holgado:
		nombres = _torn_tops_nombres(libre, pides)
	for i in cols.size():
		var c: Control = cols[i]
		_torn_tops_cifra(c, holgado)
		c.size_flags_stretch_ratio = float(c.get_meta("top_fijo")) \
				+(_torn_tops_holgura(c) if holgado else 0.0) + nombres[i]








static func _torn_tops_nombres(libre: float, pides: Array[float]) -> Array[float]:
	var n: int = pides.size()
	var igual: float = libre / float(maxi(n, 1))
	var out: Array[float] = []
	var falta: float = 0.0
	var sobra: float = 0.0
	for p in pides:
		out.append(igual)
		if p > igual:
			falta += p - igual
		else:
			sobra += igual - p
	if falta <= 0.0 or sobra < falta:
		return out
	for i in n:
		out[i] = pides[i] if pides[i] > igual else igual -(igual - pides[i]) * falta / sobra
	return out



func _torn_tops_holgura(col: Control) -> float:
	return maxf(0.0, float(col.get_meta("top_val_holgado", 0.0)) - float(col.get_meta("top_val", 0.0)))





func _torn_tops_cifra(col: Control, holgado: bool) -> void:
	if not col.has_meta("top_val"):
		return
	var ancho: float = float(col.get_meta("top_val_holgado" if holgado else "top_val"))
	for h in col.get_children():
		var celdas: Array = h.get_meta("fila_celdas", [])
		if celdas.is_empty() or not (celdas[-1] is Control):
			continue
		var v: Control = celdas[-1] as Control
		if not is_equal_approx(v.custom_minimum_size.x, ancho):
			v.custom_minimum_size.x = ancho




func _torn_tops_pide_nombre(raiz: Node) -> float:
	var pide: float = 0.0
	for n in raiz.find_children("*", "Label", true, false):
