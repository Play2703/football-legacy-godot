func _banquillo_ultimo() -> void:
	var ult: Dictionary = Career.pide_dt_ultimo()
	if ult.is_empty():
		return
	var sale: String = String(ult.get("sale", ""))

	if bool(ult.get("cese", false)) and sale == "cae":
		sale = "si"
	var col: Color = CareerTheme.accent_text() if sale == "si" \
			else (CareerTheme.DANGER if sale == "no" else CareerTheme.TEXT_DIM)


	var nombre: String = CareerTheme.caps(String(ult.get("name", "")))
	if bool(ult.get("cese", false)) and sale == "si":
		nombre = I18n.tf("{0} · FUERA", [nombre])
