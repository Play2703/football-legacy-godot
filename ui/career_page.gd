func _torn_ventana_llena(caja: PanelContainer, v: VBoxContainer, filas: Array, franjas: Array,
		tu: int, accent: Color) -> void:
	var alto_caja: float = caja.size.y
	var n: int = filas.size()
	if alto_caja < TORN_FILA_H_LARGA or n == 0:
		return
	var plan: Array = []
	var h: float = TORN_FILA_H
	for alto in [TORN_FILA_H, TORN_FILA_H_LARGA]:
		h = float(alto)
		plan = _torn_ventana_cabe(n, tu, int(floorf(alto_caja / h)))
		var directos: bool = plan.size() >= n
		for i in plan:
			directos = directos or int(i) == GameState.EURO_DIRECT - 1
		if directos:
			break
	var firma: String = "%d|%s" % [roundi(h), str(plan)]
	if String(caja.get_meta("torn_ventana_firma", "")) == firma:
		return
	caja.set_meta("torn_ventana_firma", firma)
	for c in v.get_children():
		v.remove_child(c)
		c.queue_free()
	_torn_ventana_pinta(v, filas, franjas, accent, plan, h)





