	ClausulasEditor.chips(parent, c as Dictionary, int(o.get("wage", 0)))







func _abrir_clausulas_oferta(index: int) -> void:
	if index < 0 or index >= Career.pending_offers.size():
		return
	if not Career.clausulas_entra_oferta(index):
		var mesa: Dictionary = Career.clausulas_mesa_oferta(index)
		_toast(I18n.t(String(mesa.get("why", "SIN OFERTA"))), CareerTheme.DANGER)
		return
	abrir_oferta = index
	abrir_oferta_id = String((Career.pending_offers[index] as Dictionary).get("id", ""))
	SceneFade.to_scene("res://ui/ceremonies/pulse.tscn")




