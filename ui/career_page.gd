func _mt_estado_letras(rej: VBoxContainer) -> void:
	if not is_instance_valid(rej) or rej.size.x <= 0.0:
		return
	for fila in rej.get_children():
		_mt_estado_letras_fila(fila as Node)


func _mt_estado_letras_fila(fila: Node) -> void:
	var tiles: Array[Button] = []
	var encargos: Array[Button] = []
	for h in fila.get_children():
		var b: Button = h as Button
		if b == null:
			continue
		if b.size.x <= 0.0:
			return
		if b.has_meta("tile_name"):
			tiles.append(b)
		elif b.has_meta("mt_encargo"):
			encargos.append(b)
	var bajo: float = INF
	var estrecha: float = INF
	for b in tiles:
		bajo = minf(bajo, b.size.y)
		estrecha = minf(estrecha, b.size.x)
	if not tiles.is_empty():


		var grandes: bool = bajo >= 200.0
		var ancho: float = estrecha - 28.0
		var renglon: Array = [32, 24, 16] if grandes else [24, 16]


		var pasos: Dictionary = {"tile_badge": [48, 32, 24, 16] if bajo >= 320.0 else [32, 24, 16],
			"tile_value": renglon, "tile_name": renglon}
		for papel in pasos:
			var hueco: float = ancho -(0.0 if grandes or papel != "tile_badge" else 56.0)
			var px: int = _mt_peldano_comun(tiles, String(papel), pasos[papel] as Array, hueco)
			for b in tiles:
				_mt_clava_letra(b.get_meta(papel) as Label, px)


		for b in tiles:
			if b.has_meta("mt_centro"):
				var marca: Label = b.get_meta("tile_badge") as Label
				var arriba: Control = marca.get_parent() as Control
				var ve: bool = not (grandes and marca.text.is_empty())
				if arriba.visible != ve:
					arriba.visible = ve
		var icono: float = 48.0
		if grandes:


			var libre: float = INF
			for b in tiles:
				libre = minf(libre, b.size.y - _mt_alto_sin_dibujo(b) - 16.0)
			icono = clampf(floorf(minf(libre, ancho * 0.6) / 8.0) * 8.0, 48.0, 224.0)
		for b in tiles:
			var ic: Control = b.get_meta("tile_icon") as Control
			var centro: Control = b.get_meta("mt_centro", null) as Control
			if centro != null:
				var donde: Node = centro if grandes else (b.get_meta("tile_badge") as Node).get_parent()
				if ic.get_parent() != donde:
					ic.get_parent().remove_child(ic)
					donde.add_child(ic)
					if not grandes:
						donde.move_child(ic, 0)
			if not is_equal_approx(ic.custom_minimum_size.x, icono):
				ic.custom_minimum_size = Vector2(icono, icono)
	if encargos.is_empty():
		return

	var labels: Array[Label] = []
	var ancho_e: float = INF
	var bajo_e: float = INF
	for b in encargos:
		ancho_e = minf(ancho_e, b.size.x - 20.0)
		bajo_e = minf(bajo_e, b.size.y)
		for l in (b.get_child(0) as Node).find_children("*", "Label", false, false):
			labels.append(l as Label)
	var px_e: int = 16
	for p in [24, 16]:
		var cabe: bool = true
		for l in labels:
			if not l.text.is_empty() and not _mt_cabe(l.get_theme_font("font"), l.text, int(p), ancho_e, 1):
				cabe = false
		if cabe:
			px_e = int(p)
			break
	for l in labels:
		_mt_clava_letra(l, px_e)
	var icono_e: float = clampf(floorf(minf((bajo_e - 120.0) * 0.6, ancho_e * 0.35) / 8.0) * 8.0,
		48.0, 96.0)
	for b in encargos:
		for ic in (b.get_child(0) as Node).find_children("*", "MenuIcon", false, false):
			if not is_equal_approx((ic as Control).custom_minimum_size.x, icono_e):
				(ic as Control).custom_minimum_size = Vector2(icono_e, icono_e)





func _mt_alto_sin_dibujo(b: Button) -> float:
	var marca: Label = b.get_meta("tile_badge") as Label
	var arriba: Node = marca.get_parent()
	var caja: VBoxContainer = arriba.get_parent() as VBoxContainer
	var alto: float = 22.0 + float(CareerTheme.SINK)
	var vistos: int = 0
	for h in caja.get_children():
		var c: Control = h as Control
		if c == null or not c.visible:
			continue
		vistos += 1
		if c == arriba:
			alto += marca.get_combined_minimum_size().y
		elif c.name != "Centro":
			alto += c.get_combined_minimum_size().y
	return alto + 12.0 * float(maxi(vistos - 1, 0))



func _mt_peldano_comun(tiles: Array[Button], papel: String, peldanos: Array, hueco: float) -> int:
	for p in peldanos:
		var cabe: bool = true
		for b in tiles:
			var l: Label = b.get_meta(papel) as Label
			if l != null and not l.text.is_empty() \
					and not _mt_cabe(l.get_theme_font("font"), l.text, int(p), hueco, 1):
				cabe = false
				break
		if cabe:
			return int(p)
	return int(peldanos[peldanos.size() - 1])




func _mt_clava_letra(l: Label, px: int) -> void:
	if l == null:
		return
	l.set_meta("shrink_base", px)
	l.set_meta("shrink_floor", px)
	if l.get_theme_font_size("font_size") != px:
		l.add_theme_font_size_override("font_size", px)


func _mt_cabe(f: Font, texto: String, px: int, ancho: float, lineas: int) -> bool:
	if lineas <= 1:
		return f.get_string_size(texto, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x + 6.0 <= ancho
	var n: int = 1
	var linea: String = ""
	for w in texto.split(" ", false):
		var prueba: String = w if linea.is_empty() else linea + " " + w
		if f.get_string_size(prueba, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x + 6.0 <= ancho:
			linea = prueba
			continue
		if f.get_string_size(w, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x + 6.0 > ancho:
			return false
		n += 1
		linea = w
	return n <= lineas






func _mt_estado_ficha(ids_cta: Array) -> PanelContainer:
	var filas: Array = []
	var titulo: String = ""
	var c: Dictionary = Career.contract



	if ids_cta.has("acepto"):
		titulo = "VENTA"
		if Career.venta_por_grada():
			filas.append(_mt_dato(I18n.t("GRADA"), "", CareerTheme.DANGER))
		elif Career.venta_por_concurso():
			filas.append(_mt_dato(I18n.t("CONCURSO"), "", CareerTheme.DANGER))
		filas.append(_mt_dato(I18n.t("SUELDO"), _short_money(int(c.get("wage", 0))),
			CareerTheme.MONEY))
		if Career.venta_por_grada():
			filas.append_array(_mt_filas_club(GameState.player_team_id))
		elif Career.venta_por_concurso():
			filas.append(_mt_dato(I18n.t("BAJAR FICHA"),
				_short_money(Market.project_wage(int(c.get("wage", 0)))), CareerTheme.DANGER))
		else:
			filas.append(_mt_dato(I18n.t("CLÁUSULA"), _short_money(int(c.get("clause", 0))),
				CareerTheme.TEXT))
			filas.append(_mt_dato(I18n.t("ME NIEGO"), "", CareerTheme.DANGER,
				_mt_coste(Career.forced_sale_cost(), ["tecnico", "equipo", "aficion"])))
	elif ids_cta.has("quedo"):
		titulo = "CESIÓN"
		filas.append(_mt_dato(I18n.t("MINUTOS"), _mt_rol(String(c.get("role", "rotacion"))),
			CareerTheme.DANGER))

		if not Career.loan_window_open() and not Career.pending_loans.is_empty():
			var destino: String = String(Teams.by_id(
				String(Career.pending_loans[0].get("id", ""))).get("name", ""))
			if not destino.is_empty():
				filas.append(_mt_dato(CareerTheme.caps(destino), "", CareerTheme.STAT_ASSIST))
		filas.append(_mt_dato(I18n.t("ME QUEDO"), "", CareerTheme.DANGER,
			_mt_coste(Career.forced_loan_cost(), ["tecnico", "equipo"])))
	elif ids_cta.has("quedarme"):
		var co: Dictionary = Career.counter_offer
		titulo = "TU CLUB QUIERE RETENERTE"
		filas.append(_mt_dato(I18n.t("SUELDO NUEVO"), _short_money(int(co.get("wage", 0))),
			CareerTheme.MONEY))
		filas.append(_mt_dato(I18n.t("TEMPORADAS"), str(int(co.get("seasons", 3))),
			CareerTheme.TEXT))
		var prima: int = Career.agent_signing_net(int(co.get("bonus", 0)))
		if prima > 0:
			filas.append(_mt_dato(I18n.t("PRIMA"), _short_money(prima), CareerTheme.MONEY))
	elif ids_cta.has("renovar"):
		var o: Dictionary = _renewal_selected(Career.renewal_packages())
		var years: int = int(o["seasons"])
		titulo = "LA OFERTA DEL CLUB"
		filas.append(_mt_dato(I18n.t("AÑOS"),("+%d" % years) if years > 0
			else I18n.t("NINGUNO"), CareerTheme.TEXT if years > 0 else CareerTheme.DANGER))
		filas.append(_mt_dato(I18n.t("SUELDO NUEVO"), _short_money(int(o["wage"])),
			CareerTheme.MONEY if int(o["delta"]) >= 0 else CareerTheme.DANGER))
		filas.append(_mt_dato(I18n.t("PRIMA"), _short_money(Career.agent_signing_net(
			int(o.get("signing_bonus", 0)))), CareerTheme.MONEY))
		filas.append(_mt_dato(I18n.t("CLÁUSULA"), _short_money(int(o.get("clause", 0))),
			CareerTheme.TEXT))
	elif ids_cta.has("mejora"):
		var r: Dictionary = _reneg_oferta_viva()
		var wage_new: int = int(r.get("wage", 0))
		var anos: int = int(r.get("seasons", 0))
		titulo = "TU CLUB TE MEJORA" if Career.renegotiation_club_offered() \
				else "LO QUE PUEDES PEDIR"
		filas.append(_mt_dato(I18n.t("SUELDO NUEVO"), _short_money(wage_new),
			CareerTheme.MONEY if int(r.get("delta", 0)) >= 0 else CareerTheme.DANGER))
		filas.append(_mt_dato(I18n.t("AÑOS"),("+%d" % anos) if anos > 0 else I18n.t("NINGUNO"),
			CareerTheme.TEXT if anos > 0 else CareerTheme.TEXT_DIM))
		var gadd: float = float(r.get("goal_bonus_add", 0.0))
		var aadd: float = float(r.get("assist_bonus_add", 0.0))
		if gadd > 0.0:
			filas.append(_mt_dato(I18n.t("GOL"), "+" + _short_money(int(float(wage_new) * 0.5
				* gadd)), CareerTheme.MONEY))
		if aadd > 0.0:
			filas.append(_mt_dato(I18n.t("ASISTENCIA"), "+" + _short_money(int(float(wage_new)
				* 0.5 * aadd)), CareerTheme.MONEY))
	elif ids_cta.has("pide_mesa"):
		titulo = "RENEGOCIAR"
		filas.append(_mt_dato(I18n.t("SE SIENTAN"), "%d%%" % int(round(
			Career.renegotiation_sit_p() * 100.0)), CareerTheme.MONEY))
	elif ids_cta.has("no_renovar"):


		titulo = "LA OFERTA DEL CLUB"
		filas.append(_mt_dato(I18n.t("CONTRATOS CONGELADOS") if Career.concurso_tuyo()
			else I18n.t("EL TÉCNICO NO RENUEVA"), "", CareerTheme.DANGER))
	else:
		return _mt_detalle({})


	if ids_cta.has("no_renovar"):
		var racha: Dictionary = Career.no_renuevo_racha_coste()
		if not racha.is_empty():
			filas.append(_mt_dato(I18n.t("VAS EN RACHA"), "", CareerTheme.DANGER,
				_mt_coste({"relaciones": - absi(int(racha["club"])),
					"aficion": - absi(int(racha["aficion"]))}, ["relaciones", "aficion"])))
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(72, 72)
	crest.set_team(Teams.by_id(GameState.player_team_id))
	var p: PanelContainer = CareerUi.ficha_detalle(crest, I18n.t(titulo), filas)



	CareerUi.letra_por_peldanos(p.get_meta("detalle_titulo") as Label, [CareerTheme.T_TITULO_TUMBADO,
		CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	return p








func _mt_coste(valores: Dictionary, claves: Array) -> HBoxContainer:
	var h: HBoxContainer = HBoxContainer.new()
	h.name = "Coste"
	h.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
	for k in claves:
		var v: int = int(valores.get(k, 0))
		var ic: MenuIcon = MenuIcon.new()
		ic.setup(String(k), CareerTheme.TEXT_MID)
		ic.custom_minimum_size = Vector2(32, 32)
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(ic)
		var l: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO,
			CareerTheme.DANGER if v < 0 else CareerTheme.TEXT)
		l.text = "%+d" % v if v != 0 else "0"
		l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		h.add_child(l)
	return h





func _mt_estado_cta(cta: VBoxContainer, grupo: Array) -> void:
	if grupo.is_empty():
		return
	var dicts: Array = []
	for e in grupo:
		var d: Dictionary = e
		var hold: Callable = d.get("hold", Callable())
		dicts.append({"texto": String(d["texto"]), "kind": d["kind"],
			"hold_s": HOLD_SECS if hold.is_valid() else 0.0,
			"cb": hold if hold.is_valid() else d.get("tap", Callable())})
	if dicts.size() == 1:
		_mt_cta_uno(cta, dicts[0])
	else:
		CareerUi.cta_par(cta, dicts[0], dicts[1])
	for b in cta.find_children("*", "Button", true, false):
		for e in grupo:
			if (b as Button).text == String((e as Dictionary)["texto"]):
				b.set_meta("mt_estado", String(e["id"]))
				if (e as Dictionary).has("tinte"):
					CareerTheme.apply_button_accent(b as Button, e["tinte"] as Color,
						CareerTheme.T_LEE_TUMBADO)
	_mt_cta_ajusta(cta)


func _mt_abre_estado() -> void:
	_mt_vista = "estado"
	_refresh()






func _mt_segmentos() -> Array:
	var out: Array = []
	if (Career.free_agent or Career.mesa_abierta()) and not Career.pending_offers.is_empty():
		out.append("ofertas")
	if Career.free_agent:
		return out
	if Career.loan_window_open() and not _mt_datos("cesion").is_empty():
		out.append("cesion")
	if not Career.mesa_abierta() and not _mt_datos("rumores").is_empty():
		out.append("rumores")
	return out




func _mt_color(seg: String) -> Color:
	match seg:
		"ofertas":
			return CareerTheme.MONEY
		"cesion":
			return CareerTheme.accent_text()
	return CareerTheme.NAV_MUNDO






func _mt_datos(seg: String) -> Array:
	var out: Array = []
	match seg:
		"ofertas":
			var hoy: int = int(Career.contract.get("wage", 0))
			for i in Career.pending_offers.size():
				var o: Dictionary = Career.pending_offers[i] as Dictionary
				var wage: int = int(o.get("wage", 0))
				var linea: String = I18n.tf("{0} TEMP", [int(o.get("seasons", 0))])
				if hoy > 0 and not Career.free_agent:
					linea += " · %+d%%" % roundi((float(wage) / float(hoy) - 1.0) * 100.0)
				var bloq: bool = not Career.free_agent and Career.club_blocks_sale() \
						and not Career.pays_clause(o)
				out.append({"tipo": "oferta", "i": i, "id": String(o.get("id", "")), "d": o,
					"nombre": CareerTheme.caps(Market.club_name(o)), "linea": linea,
					"cifra": "$%s" % CareerUi.money(wage),
					"color": CareerTheme.TEXT_DIM if bloq else CareerTheme.MONEY})
		"cesion":
			for i in Career.pending_loans.size():
				var o: Dictionary = Career.pending_loans[i] as Dictionary
				var id: String = String(o.get("id", ""))
				var team: Dictionary = Teams.by_id(id)
				if team.is_empty():
					continue
				out.append({"tipo": "cesion", "i": i, "id": id, "d": o,
					"nombre": CareerTheme.caps(String(team.get("name", "?"))),
					"linea": _mt_linea_club(id), "cifra": I18n.t("TITULAR"),
					"color": CareerTheme.accent_text()})
		"rumores":
			for r0 in Career.rumores_visibles(4, false):
				var r: Dictionary = r0 as Dictionary
				var id: String = String(r.get("id", ""))
				if Teams.by_id(id).is_empty():
					continue
				if Career.seeded_rumors().has(id) and not bool(r.get("seen", false)):
					r = r.duplicate()
					r["seen"] = true
				var sello: Array = _rumor_sello(r)
				var pie: bool = Career.courting_club == id
				out.append({"tipo": "rumor", "id": id, "d": r,
					"nombre": CareerTheme.caps(String(r.get("name", id))),
					"linea": _mt_linea_club(id),
					"cifra": I18n.t("LE DISTE PIE") if pie else String(sello[0]),
					"color": CareerTheme.accent_text() if pie or bool(sello[2])
						else (CareerTheme.TEXT if int(sello[1]) >= 1 else CareerTheme.TEXT_DIM)})
	return out.slice(0, MT_FILAS_MAX)



const MT_FILAS_MAX: int = 9



func _mt_linea_club(id: String) -> String:
	var txt: String = CareerTheme.caps(Teams.div_short(GameState.div_of(id)))
	var snap: Dictionary = Market.club_snapshot(id, GameState.season_num)
	if not snap.is_empty():
		txt += " · %s/%d" % [I18n.ordinal(int(snap["league_pos"])), int(snap["league_size"])]
	return txt




func _mt_letra_aviso(l: Label) -> void:
	if not is_instance_valid(l) or l.size.x <= 0.0:
		return
