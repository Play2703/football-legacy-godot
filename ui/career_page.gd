const SKILL_BOOT_KEY: Dictionary = {"potencia": "pot", "precision": "pre", "efecto": "efe"}
func _skill_boot_tag(key: String, compacto: bool = false) -> Control:
	if not SKILL_BOOT_KEY.has(key):
		return null
	var v: int = roundi(Career._boot(String(SKILL_BOOT_KEY[key])) * 100.0)
	if v == 0:
		return null
	var tag: HBoxContainer = HBoxContainer.new()
	tag.alignment = BoxContainer.ALIGNMENT_END
	tag.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tag.add_theme_constant_override("separation", 6)
