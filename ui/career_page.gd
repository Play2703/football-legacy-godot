		sil.setup("tecnico", CareerTheme.DANGER)
		fila.add_child(sil)
		fila.move_child(sil, 1)
	_content.add_child(fila)










func _gerencia_intocable_block() -> void:
	var t: Dictionary = Career.gerencia_intocable()
	var ult: Dictionary = Career.gerencia_intocable_ult()
	var deuda: int = Career.gerencia_deuda()
	if t.is_empty() and ult.is_empty():
