func _ge_t_retrato(key: String, col: Color) -> Control:
	var lado: Vector2 = Vector2(GE_T_RETRATO, GE_T_RETRATO)
	var av: PlayerAvatar = null
	if key == "tecnico":


		var look: Dictionary = {}
		if _with_nat():
			if not Career.nat_coach_name().is_empty():
				look = Career.nat_coach_look()
		else:
			var f: Dictionary = CoachCard.fila_del_club(GameState.player_team_id)
			if f.has("id"):
				look = Coach.look_de(Coaches.face_de_id(String(f["id"])))
		if not look.is_empty():
			av = PlayerAvatar.new()
			av.set_look(look, CoachRankingView.COACH_TEX)
	elif key == "equipo" and not _with_nat() and not Career.captain_name().is_empty():
		av = PlayerAvatar.new()
		av.club = Teams.by_id(GameState.player_team_id)
		av.set_look(KitRecolor.appearance_for(Career.captain_name(), GameState.player_kit()))
	elif key == "pareja":
		var arq: String = String(Career.pareja.get("id", ""))
		if not Pareja.by_id(arq).is_empty():
			var m: Control = PlayerCard.medalla_pareja(arq, GE_T_RETRATO)
			m.name = "Retrato"
			m.custom_minimum_size = lado
			m.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			m.mouse_filter = Control.MOUSE_FILTER_IGNORE
			return m
	if av != null:
		av.name = "Retrato"
		av.custom_minimum_size = lado
		av.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		av.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return av
	var ic: MenuIcon = MenuIcon.new()
	ic.name = "Retrato"
	ic.custom_minimum_size = lado
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.setup(key, col)
	return ic





func _ge_t_ordena() -> void:
	var cartas: Array[Button] = []
	for key in GE_T_ORDEN:
		if _ge_t_cartas.has(key):
			var b: Button = _ge_t_cartas[key]
			_ge_t_rejilla.add_child(b)
			cartas.append(b)
	var n: int = cartas.size()
	for i in n:
		var b: Button = cartas[i]
		var c: int = i % GE_T_COLS
		b.focus_neighbor_left = b.get_path_to(cartas[i - 1] if c > 0 else b)
		b.focus_neighbor_right = b.get_path_to(
			cartas[i + 1] if c < GE_T_COLS - 1 and i + 1 < n else b)
		b.focus_neighbor_bottom = b.get_path_to(cartas[i + GE_T_COLS] if i + GE_T_COLS < n else b)
		if i >= GE_T_COLS:
			b.focus_neighbor_top = b.get_path_to(cartas[i - GE_T_COLS])
	if n > 0:
		var primera: Button = _ge_t_cartas.get("pareja", cartas[0])
		primera.set_meta(Entrada.PRIMERO_META, true)




func _ge_t_toque(key: String) -> void:
	if Entrada.modo == Entrada.Modo.MANDO:
		_ge_t_verbo_hacer(key)
	else:
		_ge_t_detalle(key)


func _ge_t_verbo_hacer(key: String) -> void:
	match key:
		"agente":
			_on_tab("mercado")
		"pareja":
			_dejarla_confirmar()
		_:
			_ge_t_detalle(key)







func _ge_t_detalle(key: String) -> void:
	if not _ge_t_cartas.has(key):
		return
	var b: Button = _ge_t_cartas[key]
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	box.set_meta("rel_detalle", key)
	box.add_theme_constant_override("separation", 24)
	box.custom_minimum_size.x = GE_T_MODAL_ANCHO
	var col: Color = b.get_meta("ge_t_col", CareerTheme.accent_text())
	var nivel: int = int(b.get_meta("ge_t_nivel", -1))
	var cab: HBoxContainer = HBoxContainer.new()
	cab.name = "Cabeza"
	cab.add_theme_constant_override("separation", 24)
	cab.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(cab)
	cab.add_child(_ge_t_retrato(key, col))
	var textos: VBoxContainer = VBoxContainer.new()
	textos.add_theme_constant_override("separation", 4)
	textos.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	textos.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	textos.mouse_filter = Control.MOUSE_FILTER_IGNORE
	cab.add_child(textos)
	var nombre: String = CareerTheme.caps(_ge_t_nombre(key, String(b.get_meta("ge_t_nombre", ""))))
	var rotulo: String = CareerTheme.caps(I18n.t(_ge_t_rotulo(key)))
	if rotulo != nombre:
		textos.add_child(_mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID, rotulo, false))
	var nom: Label = _mk_t_label(CareerTheme.T_TITULO_TUMBADO, CareerTheme.TEXT, nombre)
	nom.name = "Nombre"
	nom.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerUi.letra_por_peldanos(nom, [CareerTheme.T_TITULO_TUMBADO, CareerTheme.T_DATO_TUMBADO,
		CareerTheme.T_LEE_TUMBADO])
	textos.add_child(nom)
	if nivel >= 0:
		var col_barra: Color = CareerTheme.DANGER if nivel < 35 else CareerTheme.NAV_GENTE
		var rel: HBoxContainer = HBoxContainer.new()
		rel.name = "Relacion"
		rel.add_theme_constant_override("separation", 16)
		rel.alignment = BoxContainer.ALIGNMENT_CENTER
		rel.mouse_filter = Control.MOUSE_FILTER_IGNORE
		box.add_child(rel)
		var cifra: Label = _mk_t_label(CareerTheme.T_DATO_TUMBADO, col_barra, str(nivel), false)
		cifra.name = "Cifra"
		cifra.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		rel.add_child(cifra)
		var caja_barra: VBoxContainer = VBoxContainer.new()
		caja_barra.name = "Barra"
		caja_barra.custom_minimum_size = GE_T_MODAL_BARRA
		caja_barra.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		caja_barra.mouse_filter = Control.MOUSE_FILTER_IGNORE
		rel.add_child(caja_barra)
		var fill: ColorRect = CareerUi.bar(caja_barra, col_barra, GE_T_MODAL_BARRA.y)
		fill.anchor_right = clampf(float(nivel) / 100.0, 0.0, 1.0)
	var chip: String = String(b.get_meta("ge_t_chip", ""))
	if not chip.is_empty():
		var ch: PanelContainer = CareerUi.code_chip(CareerTheme.caps(chip),
			b.get_meta("ge_t_chip_col", col), CareerTheme.T_CAP_TUMBADO, 10.0, 4.0)
		ch.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
		ch.mouse_filter = Control.MOUSE_FILTER_IGNORE
		box.add_child(ch)
	if key == "tecnico":
		var quien: String = Career.nat_coach_name() if _with_nat() else Career.coach_name()
		if not quien.is_empty():
			box.add_child(CareerUi.estrellas(
				Career.nat_coach_nivel() if _with_nat() else Career.coach_nivel(), 32.0, true))
	var det: Control = _rel_detalle.get(key, null)
	if det != null and is_instance_valid(det):
		for h in det.get_children():
			if h is Label and not (h as Label).text.is_empty():
				var fr: VBoxContainer = _en_t_frase((h as Label).text, CareerTheme.T_LEE_TUMBADO,
					CareerTheme.TEXT)
				fr.name = "Linea"
				fr.custom_minimum_size.x = GE_T_MODAL_ANCHO
				box.add_child(fr)
	var volver: Button = Button.new()
	volver.name = "Volver"
	volver.text = I18n.t("VOLVER")
	volver.custom_minimum_size = Vector2(0.0, CareerTheme.TOQUE_TUMBADO)
	volver.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerTheme.apply_button(volver, CareerTheme.Kind.GHOST, CareerTheme.T_LEE_TUMBADO)
	volver.pressed.connect(CareerUi.close_modal.bind(box))
	box.add_child(volver)


func _ge_t_detalle_foco() -> void:


	var f: Control = SceneFade.foco(self)
