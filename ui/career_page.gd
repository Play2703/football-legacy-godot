func _leg_rango() -> Dictionary:
	var rows: Array = Legends.board_rivals(Legends.PASS_BOARD, WORLD_RANK_BOARD)
	var you: Dictionary = Legends.career_flat(Legends.user_entry())
	var rank: int = 1
	for r in rows:
		if Legends.board_ahead(Legends.PASS_BOARD, r, you):
			rank += 1
	var above: Dictionary = {}
	if rank > 1 and not rows.is_empty():
		above = rows[mini(rank - 2, rows.size() - 1)]



	var falta: int = 0
	if not above.is_empty():
		falta = maxi(Legends.total(above) - Legends.total(you), 0)
	return {"rows": rows, "you": you, "rank": rank, "above": above, "falta": falta}





