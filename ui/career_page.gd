func _dock_tus_cosas(panel: PanelContainer) -> void:
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 8)
	panel.add_child(col)
	var t: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_MID)
	t.text = I18n.t("TUS COSAS")
	col.add_child(t)
	var fila: HFlowContainer = HFlowContainer.new()
	fila.add_theme_constant_override("h_separation", 12)
	fila.add_theme_constant_override("v_separation", 8)
	col.add_child(fila)
	var hay: bool = false
	for it in Shop.ITEMS:
		var iid: String = String((it as Dictionary)["id"])
		var have: int = int(Career.stock.get(iid, 0))
		if have <= 0:
			continue
		hay = true
		var caja: HBoxContainer = HBoxContainer.new()
		caja.add_theme_constant_override("separation", 8)
		fila.add_child(caja)
		if ShopPhoto.tiene_modelo(iid):
			caja.add_child(ShopPhoto.rect(self, iid, 44.0))
		else:
			var ic: MenuIcon = MenuIcon.new()
			ic.custom_minimum_size = Vector2(40, 40)
			ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			ic.setup(Shop.icon_of(it, "consumible"), CareerTheme.TEXT)
			caja.add_child(ic)
		var n: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
		n.text = "x%d" % have
		n.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		caja.add_child(n)


		var motivo: String = Career.item_block_reason(iid)
		var espera: int = Career.item_wait(iid)
		var use: Button = Button.new()
		use.text = I18n.t("USAR") if motivo.is_empty() \
				else (I18n.tf("EN {0} {1}", [espera, I18n.plural(espera, "PARTIDO", "PARTIDOS")])
				if espera > 0 else I18n.t(motivo))
		use.disabled = not motivo.is_empty()
		use.clip_text = true
		use.custom_minimum_size = Vector2(150, 56)
		CareerTheme.apply_button(use, CareerTheme.Kind.PRIMARY, CareerTheme.T_CAPTION)
		use.pressed.connect(func() -> void: Career.use_item(iid))
		caja.add_child(use)
	if not hay:
		var v: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
		v.text = I18n.t("NO TIENES NADA GUARDADO")
		fila.add_child(v)









func _shop_pagar(inf: Dictionary) -> void:
	var cta: Dictionary = inf.get("cta", {})
	if cta.is_empty() or not bool(cta.get("ok", false)):
		return
	var precio: int = int(inf.get("precio", 0))
	if bool(inf.get("confirm", false)) or (precio > 0 and precio * 2 >= Career.money):
		_modal_compra(inf)
	else:
		var hacer: Callable = cta["do"]
		hacer.call()




func _modal_compra(inf: Dictionary) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(CareerTheme.T_TITLE_MODAL, CareerTheme.TEXT)
	t.text = String(inf["title"])
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(t)
	var s: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_MID)
	s.text = I18n.t("LO QUE CAMBIA")
	s.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(s)
	var precio: int = int(inf.get("precio", 0))
	var lineas: Array = [I18n.tf("PAGAS ${0} · TE QUEDAN ${1}",
		[CareerUi.money(precio), CareerUi.money(maxi(0, Career.money - precio))])]


	for l in [inf.get("line", "")] + Array(inf.get("modal", [])) + Array(inf.get("dock", [])):
		if not String(l).is_empty() and not lineas.has(String(l)):
			lineas.append(String(l))
	for i in lineas.size():
		if String(lineas[i]).is_empty():
			continue
		var l: Label = CareerUi.plain(CareerTheme.T_BODY if i == 0 else CareerTheme.T_DIM,
			CareerTheme.TEXT if i == 0 else CareerTheme.TEXT_DIM)
		l.text = String(lineas[i])
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		box.add_child(l)


	var efectos: Array = []
	if String(inf.get("fam", "")) == "botas":


		box.add_child(_tablero_bota(String(inf["id"]), inf.get("vs", {})))
	else:
		efectos = _chips_de(inf.get("stats", []), String(inf.get("suffix", "")))
	if not efectos.is_empty():
		var flow: HFlowContainer = HFlowContainer.new()
		flow.alignment = FlowContainer.ALIGNMENT_CENTER
		flow.add_theme_constant_override("h_separation", 8)
		flow.add_theme_constant_override("v_separation", 8)
		box.add_child(flow)
		for c in efectos:
			flow.add_child(c as Control)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 16)
	box.add_child(fila)
	var no: Button = Button.new()
	no.text = I18n.t("CANCELAR")
	no.custom_minimum_size = Vector2(0, CareerTheme.BTN_SECONDARY_H)
	no.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	no.size_flags_vertical = Control.SIZE_SHRINK_END
	CareerTheme.apply_button(no, CareerTheme.Kind.NEUTRAL, CareerTheme.BTN_ROW_FONT)
	no.pressed.connect(func() -> void: CareerUi.close_modal(box))
	fila.add_child(no)
	var cta: Dictionary = inf.get("cta", {})
	var si: Button = Button.new()
	si.text = String(cta.get("text", ""))
	si.custom_minimum_size = Vector2(0, CareerTheme.BTN_CTA_H)
	si.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	si.clip_text = true
	CareerTheme.apply_button(si, CareerTheme.Kind.NEUTRAL, CareerTheme.T_MONEY)
	UiKit.set_cue(si, "ui_coin")
	_cifra_dorada(si)
	var hacer: Callable = cta["do"]
	si.pressed.connect(func() -> void:
		CareerUi.close_modal(box)
		hacer.call())
	fila.add_child(si)


