func _torn_nombre(comp: String) -> String:
	match comp:
		"liga":


			var propio: String = CompEdits.league(Competitions.liga_llave(_torn_country, _torn_div)) \
					if _torn_div > 1 else ""
			if not propio.is_empty():
				return propio
			var n: String = I18n.t(Competitions.league_brand(_torn_country))
			if Teams.max_div(_torn_country) > 1:
				n += " · " + Teams.div_short(_torn_div)
			return n
		"cwc":
			return I18n.t(Competitions.comp_name("mundialito"))
		"nat":
			return _torn_short("nat")


		"copa", "copaliga":
			return I18n.t(Competitions.trofeo_nombre(comp,
				Teams.country_of(GameState.player_team_id)))
	return I18n.t(Competitions.comp_name(comp))




