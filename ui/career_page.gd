func _season_cards_list() -> Array:
	var out: Array = Career.season_history.duplicate()
	if Career.season_matches > 0 or Career.season_goals > 0:
		out.append({
			"season": GameState.season_num,
			"club": GameState.player_team_id,
			"loan": Career.on_loan(),
			"apps": Career.season_matches,
			"goals": Career.season_goals,
			"assists": Career.season_assists,



			"goals_league": Career.season_goals_league,
			"assists_league": Career.season_assists_league,






			"recu": Career.season_recu,
			"avg": Career.season_avg(),
			"value": Career.market_value(),
			"age": Career.age,
			"ovr": int(round(Career.skills_avg())),
			"awards": Career.current_season_awards(),
			"div": GameState.player_div(),
			"number": GameState.player_number,
			"current": true,
		})
	return out





func _open_season_cards(idx: int) -> void:
	_season_cards = _season_cards_list()
