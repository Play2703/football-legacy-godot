const SKILL_CELDA_H: float = 70.0


const SKILL_PLUS: float = 62.0












func _skill_celda(key: String, icon_key: String = "") -> Control:
	var celda: PanelContainer = CareerUi.chip()



	var sb: StyleBoxFlat = CareerTheme.chip()
	sb.content_margin_left = 10.0
	sb.content_margin_right = 4.0
	sb.content_margin_top = 4.0
	sb.content_margin_bottom = 4.0
	celda.add_theme_stylebox_override("panel", sb)
	celda.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	celda.custom_minimum_size = Vector2(0, SKILL_CELDA_H)
	var titulo: String = CareerTheme.caps(I18n.t(String(Career.SKILL_NAMES.get(key, key))))
	celda.add_child(CareerUi.hit_overlay(SKILL_CELDA_H, func() -> void:
		_help(titulo, I18n.t(String(Career.SKILL_FX.get(key, ""))) + "\n\n"
			+ Career.skill_gauge(key))))


	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 6)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	celda.add_child(row)
	var icon: MenuIcon = MenuIcon.new()
	icon.custom_minimum_size = Vector2(28, 28)
	icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	icon.setup(icon_key if not icon_key.is_empty() else key,
		CareerUi.SKILL_ICON_COL.get(key, CareerTheme.accent_text()))
	row.add_child(icon)
	var mid: VBoxContainer = VBoxContainer.new()
	mid.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	mid.alignment = BoxContainer.ALIGNMENT_CENTER
	row.add_child(mid)



	var name_l: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT)
	name_l.text = I18n.t(String(Career.SKILL_NAMES[key]))
	name_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	name_l.clip_text = true
	mid.add_child(name_l)


	var lvl: float = Career.stat_norm(key)
	var col: Color = _skill_color(lvl)
	var barra: HBoxContainer = HBoxContainer.new()
	mid.add_child(barra)
	var fill: ColorRect = CareerUi.bar(barra, col, 10.0)
	fill.anchor_right = clampf(lvl, 0.0, 1.0)



	var cost: int = Career.point_cost(key)
	var botas: Control = _skill_boot_tag(key, true)
	var tope: int = Career.skill_tope(key)



	var topada: bool = int(Career.skills[key]) >= tope and tope < Career.SKILL_CAP
	var caro: bool =(cost > 1 and int(Career.skills[key]) < tope) or topada
	mid.add_theme_constant_override("separation", 3 if botas != null or caro else 8)
	if botas != null or caro:
		var abajo: HBoxContainer = HBoxContainer.new()
		abajo.add_theme_constant_override("separation", 6)
		mid.add_child(abajo)
		if botas != null:
			botas.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
			abajo.add_child(botas)
		if caro:
			var cost_l: Label = CareerUi.plain(CareerTheme.T_CAPTION,
				CareerTheme.TEXT_DIM if Career.skill_points < cost
				else CareerTheme.accent_text())
			cost_l.text = I18n.tf("TOPE {0}", [tope]) if topada else I18n.tf("{0} PUNTOS", [cost])

			cost_l.custom_minimum_size = Vector2(130, 0)
			cost_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			cost_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
			cost_l.clip_text = true
			abajo.add_child(cost_l)
	var animar: bool = key == _anim_skill
	if animar:
		_anim_skill = ""
	var val_l: Label = CareerUi.plain(CareerTheme.T_BODY, col)
	val_l.text = str(Career.skills[key])
	val_l.custom_minimum_size = Vector2(44, 0)
	val_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	val_l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	row.add_child(val_l)
	var plus: Button = Button.new()
	plus.text = "+"
	plus.custom_minimum_size = Vector2(SKILL_PLUS, SKILL_PLUS)
	plus.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var puede: bool = Career.skill_points >= cost and int(Career.skills[key]) < tope

	plus.disabled = not puede and not _plus_a_caja(key)
	CareerTheme.apply_button(plus,
		CareerTheme.Kind.PRIMARY if puede else CareerTheme.Kind.NEUTRAL, 30)
	_boton_menos(row, key, Vector2(SKILL_PLUS, SKILL_PLUS))
	plus.pressed.connect(func() -> void:
		if _plus_a_caja(key):
			_faltan_puntos_modal(key)
			return
		var ovr_antes: int = Career.ovr_shown()
		Career.spend_point(key)
		_festejar_punto(key, ovr_antes))
	row.add_child(plus)
	_ignora_toques(row)
	_skill_bits[key] = {"val": val_l, "plus": plus}
	if animar:
		UiKit.punch.call_deferred(val_l)
	return celda







func _boton_menos(row: HBoxContainer, key: String, tam: Vector2) -> void:
	if not Career.can_unspend_point(key):
		return
	var menos: Button = Button.new()
	menos.text = "-"
	menos.custom_minimum_size = tam
	menos.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	CareerTheme.apply_button(menos, CareerTheme.Kind.NEUTRAL, 30)
	menos.pressed.connect(func() -> void: Career.unspend_point(key))
	row.add_child(menos)




func _ignora_toques(n: Node) -> void:
	for c in n.get_children():
		if c is BaseButton:
			continue
		if c is Control:
			(c as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
		_ignora_toques(c)





func _puestos_tumbados() -> void:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 10)
	fila.custom_minimum_size = Vector2(0, SKILL_CELDA_H)
	_content.add_child(fila)
	var rot: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
	rot.text = I18n.t("TUS PUESTOS")
	rot.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(rot)
	var fav: String = Career.puesto_favorito()
	for p in Career.puestos():
		var pos: String = String(p)
		var b: Button = CareerUi.icon_chip("media", CareerUi.pos_rotulo(pos),
			CareerUi.pos_color(pos), pos == fav, func() -> void: _puesto_modal(pos))
		b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		fila.add_child(b)
	var hueco: Control = Control.new()
	hueco.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	fila.add_child(hueco)
	var en_venta: Array = _puestos_en_venta()
	if en_venta.is_empty():
		return
	var barato: int = 999999
	for pos in en_venta:
		barato = mini(barato, Career.coste_puesto(String(pos)))
	var plus: Button = Button.new()
	plus.text = "+"
	plus.custom_minimum_size = Vector2(SKILL_PLUS, SKILL_PLUS)
	plus.size_flags_vertical = Control.SIZE_SHRINK_CENTER

	CareerTheme.apply_button(plus, CareerTheme.Kind.PRIMARY if Career.skill_points >= barato
		else CareerTheme.Kind.NEUTRAL, 30)
	plus.pressed.connect(_puestos_venta_modal)
	fila.add_child(plus)



func _puestos_en_venta() -> Array:
	var en_venta: Array = []
	for p in Squad.POS_LINE.keys():
		var pos: String = String(p)
		if Career.coste_puesto(pos) > 0:
			en_venta.append(pos)
	return en_venta




