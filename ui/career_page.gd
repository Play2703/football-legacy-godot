func _pl_t_render(titulo: String, ovr: int, squad: Array, slots: Array, titulares: Array,
		carta: Callable, secciones: Array, linea: Dictionary, mister: String, yo: int) -> void:
	var caja: HBoxContainer = _pl_t_caja()
	var ancho: float = _torn_ancho_plantilla()
	var k: float = ancho / PL_T_DISENO_W
	var hueco: float = floorf(PL_T_HUECO * k)
	var izq: float = floorf(PL_T_IZQ_W * k)
	var der: float = maxf(PL_T_DER_MIN, ancho - izq - PL_T_CANCHA_W - hueco * 2.0)
	caja.add_theme_constant_override("separation", int(hueco))
	var en_once: Dictionary = {}
	for i in titulares:
		en_once[int(i)] = true
	var listas: Array = []
	for sec in secciones:
		listas.append({"titulo": String(sec["titulo"]), "icono": String(sec.get("icono", "equipo")),
			"idxs": _pl_t_idxs(sec, squad, en_once)})
	var mi_sitio: String = ""
	if yo >= 0:
		if en_once.has(yo):
			mi_sitio = "once"
		elif listas.size() > 0 and (listas[0]["idxs"] as Array).has(yo):
			mi_sitio = "banca"
		elif listas.size() > 1 and (listas[1]["idxs"] as Array).has(yo):
			mi_sitio = "fuera"
	_pl_t_datos = {"titulo": titulo, "ovr": ovr, "squad": squad, "slots": slots,
		"titulares": titulares, "carta": carta, "listas": listas, "linea": linea,
		"mister": mister, "yo": yo, "mi_sitio": mi_sitio}
	_pl_t_fichas = []
	_pl_t_elegida = -1
	_pl_t_filas_banca = []
	_pl_t_banca_elegida = -1
	_pl_t_mas_boton = null
	caja.add_child(_pl_t_izquierda(izq, titulo, false))
	var cancha: PitchView = PitchView.new()
	cancha.name = "Cancha"
	cancha.custom_minimum_size = Vector2(PL_T_CANCHA_W, 0.0)
	cancha.size_flags_horizontal = Control.SIZE_FILL
	cancha.size_flags_vertical = Control.SIZE_EXPAND_FILL
	cancha.mouse_filter = Control.MOUSE_FILTER_IGNORE
	caja.add_child(cancha)
	var slots_once: Array = []
	for j in titulares.size():
		slots_once.append(String(slots[j]) if j < slots.size() else "MC")


	var por_linea: Dictionary = {}
	for sl in slots_once:
		var ln: String = "POR" if String(sl) == "POR" else Squad.line_pintada(String(sl))
		por_linea[ln] = int(por_linea.get(ln, 0)) + 1
	var n_max: int = 1
	for ln in por_linea:
		n_max = maxi(n_max, int(por_linea[ln]))
	var ancho_ficha: float = clampf(floorf(PL_T_CANCHA_W *(1.0 - 2.0 * PitchView.AIRE_MIN)
		/ float(n_max)) - 8.0, PL_T_FICHA.x, PL_T_FICHA_MAX)
	for j in titulares.size():
		var b: Button = _pl_t_ficha(int(titulares[j]), String(slots_once[j]), j, ancho_ficha)
		cancha.add_child(b)
		_pl_t_fichas.append(b)
	caja.add_child(_pl_t_derecha(der, listas, mister))


	var mio: int = -1
	for j in _pl_t_fichas.size():
		if _pl_t_fichas[j].has_meta("pl_t_yo"):
			mio = j
	_pl_t_elige(maxi(mio, 0), false)
	var mia_fila: int = -1
	for kf in _pl_t_filas_banca.size():
		if _pl_t_filas_banca[kf].has_meta("pl_t_yo"):
			mia_fila = kf
	_pl_t_elige_banca(maxi(mia_fila, 0), false)
	if _pl_t_foco_en_ambito and _pl_t_ambito_boton != null:
		_pl_t_ambito_boton.set_meta(Entrada.PRIMERO_META, true)
	elif mio >= 0:
		_pl_t_fichas[mio].set_meta(Entrada.PRIMERO_META, true)
	elif mia_fila >= 0:
		_pl_t_filas_banca[mia_fila].set_meta(Entrada.PRIMERO_META, true)
	_pl_t_foco_en_ambito = false
	_leyenda_pon([[["fl_toque"], "ALINEACIÓN"], [["fl_modo"], "ORDENAR"]])
	await get_tree().process_frame
	if not is_instance_valid(cancha) or not cancha.is_inside_tree():
		return
	cancha.place(_pl_t_fichas, slots_once)
	_pl_t_pliega()




func _pl_t_idxs(sec: Dictionary, squad: Array, en_once: Dictionary) -> Array:
	var idxs: Array = []
	if sec.has("idxs"):
		for i in sec["idxs"]:
			if not en_once.has(int(i)):
				idxs.append(int(i))
	else:
		var incluir: Callable = sec["incluir"]
		for i in squad.size():
			if not en_once.has(i) and incluir.call(i):
				idxs.append(i)
	idxs.sort_custom(func(a: int, b: int) -> bool:
		if _plantilla_orden == "ovr":
			var ma: int = _pl_t_media(a)
			var mb: int = _pl_t_media(b)
			if ma != mb:
				return ma > mb
			return a < b
		var ra: int = _rango_linea(squad, a)
		var rb: int = _rango_linea(squad, b)
		if ra != rb:
			return ra < rb
		return a < b)
	return idxs


func _pl_t_media(i: int) -> int:
	var d: Dictionary = _pl_t_datos
	if d.is_empty():
		return 0
	if i == int(d["yo"]):
		return int(round(Career.skills_avg()))
	var p: Dictionary =(d["squad"] as Array)[i]
	return SquadMeta.ovr_of(p, String(p.get("pos", "MC")))


func _pl_t_nombre(i: int) -> String:
	var d: Dictionary = _pl_t_datos
	if i == int(d["yo"]):
		return Career.player_name
	return String(((d["squad"] as Array)[i] as Dictionary).get("name", ""))



func _pl_t_apellido(i: int) -> String:
	var partes: PackedStringArray = _pl_t_nombre(i).strip_edges().split(" ", false)
