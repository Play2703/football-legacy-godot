	cost_l.custom_minimum_size = Vector2(150, 0)
	cost_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	cost_l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
