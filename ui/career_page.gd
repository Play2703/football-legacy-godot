func _rel_deja_pasar(n: Node, deja: Control) -> void:
	for c in n.get_children():
		if c == deja:
			continue
		if c is Control:
			(c as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
		_rel_deja_pasar(c, deja)








func _rel_detalle_abre(key: String, label_text: String, nivel: int, col: Color,
		chip: String = "", chip_col: Variant = null) -> void:

	if key == "agente":
		_on_tab("mercado")
		return
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null or not _rel_detalle.has(key):
		return
	box.add_theme_constant_override("separation", 14)
	var icon: MenuIcon = MenuIcon.new()
	icon.custom_minimum_size = Vector2(96, 96)
	icon.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	icon.setup(key, col)
	box.add_child(icon)
	var t: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.TEXT)
	t.text = CareerTheme.caps(label_text)
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.clip_text = true
	box.add_child(t)
	if nivel >= 0:
		var n: Label = CareerUi.plain(CareerTheme.T_SCORE, col)
		n.text = str(nivel)
		n.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		box.add_child(n)
