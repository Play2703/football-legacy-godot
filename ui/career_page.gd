func _leg_valor_tumbado() -> void:
	var puntos: Array = []
	for h in Career.season_history:
		var val: int = int(h.get("value", 0))
		if val <= 0:
			continue
		var p: Dictionary = {"label": I18n.tf("T{0}", [int(h.get("season", 0))]),
			"text": "$" + _money_short(val), "value": val}
		if not puntos.is_empty() and String(puntos[-1]["label"]) == String(p["label"]):
			puntos[-1] = p
		else:
			puntos.append(p)
	var v: int = Career.market_value()
	puntos.append({"label": I18n.tf("T{0}", [GameState.season_num]), "text": "$" + _money_short(v),
		"value": v, "tuya": true})
	var pico: Dictionary = _leg_valor_pico()
	var linea: String = ""

	if int(pico["season"]) > 0 and int(pico["valor"]) > v:
		linea = I18n.tf("PICO {0} · T{1}", ["$" + _money_short(int(pico["valor"])),
			int(pico["season"])])
	_leg_modal_curva(I18n.t("VALOR DE MERCADO"), "leg_valor_modal", true, "moneda",
		"$" + CareerUi.short_money(v), CareerTheme.MONEY, linea, puntos, CareerTheme.MONEY)




func _leg_cifra_modal(clave: String) -> void:
	var d: Dictionary = _leg_cifra_datos()[clave]
	if clave == "goles" or clave == "asist":
		_leg_modal_curva(String(d["rotulo"]), "leg_cifra_modal", clave, String(d["icono"]),
			String(d["valor"]), CareerTheme.TEXT, "",
			_leg_puntos_goles() if clave == "goles" else _leg_puntos_asist(), CareerTheme.NAV_LEGADO)
		return
	var linea: String = ""
	match clave:
		"partidos":
			linea = I18n.tf("{0}V · {1}E · {2}D", [GameState.wins, GameState.draws, GameState.losses])
		"media":
			linea = I18n.tf("mejor: {0}", [GameState.best_rating_text()])
		"temps":
			var n: int = _leg_clubes().size()
			linea = I18n.tf("en {0} {1}", [n, I18n.plural(n, "club", "clubes")])
		"seleccion":
			if not Career.nationality.is_empty():
				linea = I18n.tf("{0} goles con {1}", [Career.nat_goals,
					Nations.display_name(Career.nationality)])
	var barra: Control = null
	if clave == "partidos":
		var m: int = maxi(GameState.wins + GameState.draws + GameState.losses, 1)
		barra = _cal_barra([[float(GameState.wins) / float(m), CareerTheme.NAV_LEGADO],
			[float(GameState.draws) / float(m), CareerTheme.TEXT_DIM],
			[float(GameState.losses) / float(m), CareerTheme.DANGER]], CAL_T_BARRA)
		barra.custom_minimum_size.x = LEG_LADO_W
	_leg_tarjeta("leg_cifra_modal", clave, String(d["icono"]), String(d["valor"]), CareerTheme.TEXT,
		String(d["rotulo"]), linea, barra)




