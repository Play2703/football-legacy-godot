func _estado_directiva(con_salidas: bool = false) -> void:
	if Career.on_loan() or Career.free_agent or Career.retired:
		return
	var est: Dictionary = Career.estatus_club()
	var salida: String = String(est.get("salida", ""))
	var detalle: String = String(est.get("detalle", ""))
	CareerUi.head(_content, I18n.t("TU ESTADO"), null, I18n.t("LO DECIDE LA DIRECTIVA"))
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 10)
	_content.add_child(fila)
	var clausula: int = int(Career.contract.get("clause", 0))
	var vendes: bool = salida == "EN VENTA" or salida == "PEDISTE SALIR" or salida == "EN CESIÓN"
	var tercera: String = salida if vendes else "EN VENTA"
	var defs: Array = [
		["candado", "NO TE VENDEN", CareerTheme.accent_ink(),
			_short_money(clausula) if clausula > 0 else "", salida == "NO TE VENDEN"],
		["moneda", "SI PAGAN", CareerTheme.MONEY,
			_short_money(Career.asking_price()), salida == "TE ESCUCHAN"],
		["mercado", tercera, CareerTheme.DANGER, "", vendes],
	]
	for d in defs:
		var t: Button = CareerUi.icon_tile(String(d[0]), I18n.t(String(d[1])), d[2] as Color,
			String(d[3]), 44.0)
		t.size_flags_stretch_ratio = 1.0
		var on: bool = bool(d[4])
		CareerUi.pinta_icon_tile(t, on)
		var nota: String = detalle if on and not detalle.is_empty() \
				else I18n.t(_estado_nota(String(d[1]), on))
		t.pressed.connect(func() -> void: _toast(nota, d[2] as Color))
		fila.add_child(t)
	var bloq: int = Career.ofertas_bloqueadas()
	if bloq > 0:
		CareerUi.line(_content, I18n.tf("La directiva te bloquea {0} ofertas", [bloq])) \
				.add_theme_color_override("font_color", CareerTheme.DANGER)




	if con_salidas:
		_request_transfer_block()
	_pedir_no_venta_fila()



func _estado_nota(rotulo: String, on: bool) -> String:
	match rotulo:
		"NO TE VENDEN":
			return "Tu club rechaza las ofertas por ti: sólo la cláusula te saca." if on \
					else "Tu club no te retiene."
		"SI PAGAN":
			return "Si alguien paga lo que pide tu club, te vende." if on \
					else "Hoy tu club no negocia por ti."
	return "Tu club te ofrece a quien pregunte." if on else "No estás en venta."




func _pedir_no_venta_fila() -> void:
	var bloqueo: String = Career.no_venta_bloqueo()
	if bloqueo == "ya_pedido":
		if not Career.no_venta_concedida():
			CareerUi.line(_content, I18n.t("La directiva dijo NO: no cuentas lo bastante."
				+ " Puedes volver a pedirlo la temporada que viene.")) \
						.add_theme_color_override("font_color", CareerTheme.DANGER)
		return
	if not bloqueo.is_empty() or Career.club_blocks_sale():
		return
	var b: Button = Button.new()
	b.text = I18n.t("PEDIR QUE NO ME VENDAN")
	b.custom_minimum_size = Vector2(0, CareerTheme.BTN_ROW_H)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	CareerTheme.apply_button_tinted(b, CareerTheme.accent_ink(), CareerTheme.T_BODY)
	b.pressed.connect(func() -> void:
		_confirm(I18n.t("¿PEDIR QUE NO TE VENDAN?"),
			I18n.t("Lo decide la directiva, una vez por temporada. Si dice que sí,"
			+ " rechaza las ofertas por ti este año. La cláusula sigue valiendo."),
			I18n.t("PEDIRLO"), false, func() -> void:
				var si: bool = Career.pedir_no_venta()
				_toast(I18n.t("LA DIRECTIVA DICE SÍ") if si
					else I18n.t("LA DIRECTIVA DICE NO"),
					CareerTheme.accent_ink() if si else CareerTheme.DANGER)
				_refresh_keeping_scroll()))
	_content.add_child(b)








func _reject_strip() -> void:
	var noes: int = Career.market_rejects()
	var hoy: int = Career.offers_expiring_today()
	if noes == 0 and hoy == 0:
		return
	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	_content.add_child(row)
	if noes > 0:



		var en_venta: bool = Career.sale_patience_counts()
		var val: String = "%d/%d" % [Career.sale_rejects(), Market.SALE_PATIENCE] \
				if en_venta else str(noes)
		var tinte: Color = CareerTheme.TEXT
		if en_venta and Career.sale_rejects() >= Market.SALE_PATIENCE - 1:
			tinte = CareerTheme.DANGER
		elif noes > Market.REJECT_FREE:
			tinte = CareerTheme.DANGER
		_strip_chip(row, I18n.t("TUS NOES"), val, tinte)
	if hoy > 0:
		_strip_chip(row, I18n.t("SE VAN HOY"), str(hoy), CareerTheme.DANGER)

	if Career.sale_broken():
		CareerUi.dim(_content, I18n.t("Se hartaron de tus noes: el club contaba con"
			+ " esa venta. El técnico deja de contar contigo hasta el año que viene."))
	elif Career.market_rejects() > Market.REJECT_FREE:
		CareerUi.dim(_content, I18n.t("Llevas muchos noes: lo que llega ahora ya no"
			+ " es del nivel de lo que tumbaste."))




