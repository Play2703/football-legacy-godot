func _leg_historia_tumbado() -> void:
	var d: Dictionary = _leg_rango()
	var rows: Array = d["rows"]
	var rank: int = int(d["rank"])
	var filas: Array = []
	for r in rows:
		filas.append({"e": r})
	filas.insert(mini(rank - 1, filas.size()), {"e": d["you"], "tu": true})
	var nombre_w: float = 0.0
	var tot_w: float = _hc_ancho(CareerTheme.caps(I18n.t("TÍTULOS")), CareerTheme.T_CAP_TUMBADO)
	for i in filas.size():
		var f: Dictionary = filas[i]
		f["puesto"] = i + 1 if not (bool(f.get("tu", false)) and rank > WORLD_RANK_BOARD) else 0
		var n: String = CareerUi.display_name(String((f["e"] as Dictionary).get("name", "?")))
		f["nombre"] = n
		nombre_w = maxf(nombre_w, maxf(_hc_ancho(n, CareerTheme.T_LEE_TUMBADO),
			_hc_ancho(CareerTheme.caps(n), CareerTheme.T_CAP_TUMBADO)))
		tot_w = maxf(tot_w, _hc_ancho(str(Legends.total(f["e"])), CareerTheme.T_LEE_TUMBADO))
	nombre_w += LEG_AIRE
	tot_w += 2.0
	var cab: HBoxContainer = CareerUi.cabecera_tumbada([{"texto": "", "ancho": HC_COL_POS},
		{"texto": "", "ancho": 40.0}, {"texto": "", "ancho": nombre_w},
		{"texto": CareerTheme.caps(I18n.t("TÍTULOS")), "ancho": tot_w, "derecha": true},
		_leg_cola()])
	cab.name = "Cabecera"
	var pinta: Callable = func(_i: int, fila: Variant, _franja: Color, alto: float) -> Control:
		return _leg_fila_leyenda(fila, alto, nombre_w, tot_w)
	var box: VBoxContainer = CareerUi.lista_entera_modal(self, I18n.t("LEYENDAS"), filas, [],
		CareerTheme.NAV_LEGADO, pinta)
	if box == null:
		cab.free()
		return
	_hc_pon_cabecera(box, cab)
	box.set_meta("leg_historia_modal", true)


func _leg_fila_leyenda(fila: Dictionary, alto: float, nombre_w: float, tot_w: float) -> PanelContainer:
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var e: Dictionary = fila["e"]
	var hueco: CenterContainer = CenterContainer.new()
	hueco.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var bandera: TextureRect = Flags.make_rect(String(e.get("nat", "")), minf(24.0, alto - 12.0))
	bandera.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hueco.add_child(bandera)
	var puesto: int = int(fila["puesto"])
	var n: String = String(fila["nombre"])
	var tuya: bool = bool(fila.get("tu", false))
	var f: PanelContainer = CareerUi.fila_tumbada(alto, Color.TRANSPARENT, [
		{"texto": str(puesto) if puesto > 0 else "—", "ancho": HC_COL_POS, "derecha": true,
			"tam": tam, "color": CareerTheme.TEXT_MID},
		{"nodo": hueco, "ancho": 40.0},
		{"texto": CareerTheme.caps(n) if compacta else n, "ancho": nombre_w, "tam": tam},
		{"texto": str(Legends.total(e)), "ancho": tot_w, "derecha": true, "tam": tam},
		_leg_cola()], tuya,
		CareerTheme.NAV_LEGADO)
	if tuya:
		f.set_meta("fl_tuya", true)
	f.size_flags_vertical = Control.SIZE_EXPAND_FILL
	return f





func _leg_recorrido_tumbado() -> void:
	var etapas: Array = _career_path_stints()
	if etapas.is_empty():
		etapas = [{"club": GameState.player_team_id, "from": GameState.season_num,
			"to": GameState.season_num, "seasons": 1, "titles": 0, "loan": Career.on_loan()}]
	var med: Dictionary = {"nombre": 0.0, "tramo": 0.0, "pago": 0.0}
	var filas: Array = []
	for i in etapas.size():
		var e: Dictionary = etapas[i]
		var t: Dictionary = _stint_transfer(e)

		var pago: String = ""
		var pago_col: Color = CareerTheme.TEXT_DIM
		if bool(e.get("loan", false)):
			pago = I18n.t("CED")
		elif not t.is_empty() and int(t.get("fee", 0)) > 0:
			pago = "$" + _money_short(int(t.get("fee", 0)))
			pago_col = CareerTheme.MONEY
		var nombre: String = _hc_nombre_club(String(e["club"]), false)
		var fila: Dictionary = {"club": String(e["club"]), "nombre": nombre, "tramo": _stint_span(e),
			"pago": pago, "pago_col": pago_col, "titulos": int(e.get("titles", 0)),
			"tu": i == etapas.size() - 1 and not Career.retired}
		filas.append(fila)
		med["nombre"] = maxf(float(med["nombre"]), maxf(_hc_ancho(nombre, CareerTheme.T_LEE_TUMBADO),
			_hc_ancho(CareerTheme.caps(nombre), CareerTheme.T_CAP_TUMBADO)) + LEG_AIRE)
		med["tramo"] = maxf(float(med["tramo"]), _hc_ancho(String(fila["tramo"]),
			CareerTheme.T_LEE_TUMBADO) + LEG_AIRE)
		med["pago"] = maxf(float(med["pago"]), _hc_ancho(pago, CareerTheme.T_LEE_TUMBADO) + 2.0)
	var pinta: Callable = func(_i: int, fila: Variant, _franja: Color, alto: float) -> Control:
		return _leg_fila_etapa(fila, alto, med)
	var lado: VBoxContainer = null
	if filas.size() <= LEG_CORTA_MAX:


		med["nombre"] = maxf(float(med["nombre"]), LEG_CORTA_ANCHO * 0.5)

		lado = _leg_lista_corta(I18n.t("TU RECORRIDO"), "leg_recorrido_modal", filas.size(), filas,
			pinta)
	else:
		var box: VBoxContainer = CareerUi.lista_entera_modal(self, I18n.t("TU RECORRIDO"), filas, [],
			CareerTheme.NAV_LEGADO, pinta)
		if box != null:
			box.set_meta("leg_recorrido_modal", filas.size())
			lado =(box.get_meta("lista_entera_partes") as Dictionary)["lado"]
	if lado == null:
		return
	var camiseta: Control = _leg_camiseta()
	if camiseta != null:
		lado.add_child(camiseta)


func _leg_fila_etapa(fila: Dictionary, alto: float, med: Dictionary) -> PanelContainer:
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var titulos: HBoxContainer = HBoxContainer.new()
	titulos.add_theme_constant_override("separation", 8)
	titulos.alignment = BoxContainer.ALIGNMENT_END
	titulos.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var ti: TrophyIcon = TrophyIcon.new()
	var lado: float = minf(28.0, alto - 8.0)
	ti.custom_minimum_size = Vector2(lado, lado)
	ti.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ti.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ti.set_type("liga")
	titulos.add_child(ti)
	var n: int = int(fila["titulos"])
	titulos.add_child(_leg_label(str(n), tam, CareerTheme.TEXT if n > 0 else CareerTheme.TEXT_DIM))
	var nombre: String = String(fila["nombre"])
	var tuya: bool = bool(fila.get("tu", false))
	var f: PanelContainer = CareerUi.fila_tumbada(alto, Color.TRANSPARENT, [
		{"nodo": _hc_escudo(String(fila["club"]), alto), "ancho": LEG_COL_ESCUDO},
		{"texto": CareerTheme.caps(nombre) if compacta else nombre, "ancho": float(med["nombre"]),
			"tam": tam},
		{"texto": String(fila["tramo"]), "ancho": float(med["tramo"]), "tam": tam,
			"color": CareerTheme.TEXT_MID},
		{"texto": String(fila["pago"]), "ancho": float(med["pago"]), "derecha": true, "tam": tam,
			"color": fila["pago_col"]},
		{"nodo": titulos, "ancho": LEG_COL_NOTA + 16.0}, _leg_cola()], tuya, CareerTheme.NAV_LEGADO)
	if tuya:
		f.set_meta("fl_tuya", true)
	f.size_flags_vertical = Control.SIZE_EXPAND_FILL
	return f




