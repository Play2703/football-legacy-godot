func _leg_puntos_goles() -> Array:
	var out: Array = []
	for g in Career.goals_by_season():
		var t: int = int(g["total"])
		out.append({"label": I18n.tf("T{0}", [int(g["season"])]), "text": str(t), "value": t,
			"tuya": int(g["season"]) == GameState.season_num, "segments": g["segs"]})
	return out



func _leg_puntos_asist() -> Array:
	var por: Dictionary = {}
	var orden: Array = []
	for h in Career.season_history:
		var sn: int = int(h.get("season", 0))
		if not por.has(sn):
			por[sn] = 0
			orden.append(sn)
		por[sn] = int(por[sn]) + int(h.get("assists", 0))
	if Career.season_matches > 0 or Career.season_goals > 0:
		var sn2: int = GameState.season_num
		if not por.has(sn2):
			por[sn2] = 0
			orden.append(sn2)
		por[sn2] = int(por[sn2]) + Career.season_assists
	var out: Array = []
	for sn in orden:
		out.append({"label": I18n.tf("T{0}", [int(sn)]), "text": str(int(por[sn])),
			"value": int(por[sn]), "tuya": int(sn) == GameState.season_num})
	return out



const LEG_REGLA_AIRE: float = 32.0





func _leg_reglas_tumbado() -> void:
	var premios: Array = []
	for a in Legacy.AWARD_POINTS:
		if String(a) in Legacy.FLAVOR_ONLY or String(a) in Legacy.REPEATABLE:
			continue
		if not Trophies.of(String(a)).is_empty():
			premios.append(String(a))
	premios.sort_custom(func(x, y): return int(Legacy.AWARD_POINTS[x]) > int(Legacy.AWARD_POINTS[y]))
	var filas: Array = []
	var nombre_w: float = 0.0
	var pts_w: float = 0.0
	for i in mini(RULES_MAX, premios.size()):
		var n: String = I18n.t(String(Trophies.of(String(premios[i]))["name"]))
		filas.append({"premio": String(premios[i]), "nombre": n})
		nombre_w = maxf(nombre_w, maxf(_hc_ancho(n, CareerTheme.T_LEE_TUMBADO),
			_hc_ancho(CareerTheme.caps(n), CareerTheme.T_CAP_TUMBADO)))
		pts_w = maxf(pts_w, _hc_ancho("+%d" % int(Legacy.AWARD_POINTS[premios[i]]),
			CareerTheme.T_LEE_TUMBADO))



	nombre_w += LEG_REGLA_AIRE
	pts_w += 2.0
	var pinta: Callable = func(_i: int, fila: Variant, _franja: Color, alto: float) -> Control:
		return _leg_fila_regla(fila, alto, nombre_w, pts_w)


	var lado: VBoxContainer = _leg_lista_corta(I18n.t("COMO SE SUBE"), "leg_reglas", true, filas, pinta)
	if lado == null:
		return
	lado.add_child(_leg_escalones())
	var vias: Dictionary = Career.legacy_tier().get("vias", {})
	if not vias.is_empty():
		lado.add_child(_leg_vias(vias))


func _leg_fila_regla(fila: Dictionary, alto: float, nombre_w: float, pts_w: float) -> PanelContainer:
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var ti: TrophyIcon = TrophyIcon.new()
	var lado: float = minf(40.0, alto - 16.0)
	ti.custom_minimum_size = Vector2(lado, lado)
	ti.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ti.set_type(String(Trophies.of(String(fila["premio"]))["type"]))
	var n: String = String(fila["nombre"])
	var f: PanelContainer = CareerUi.fila_tumbada(alto, Color.TRANSPARENT, [
		{"nodo": ti, "ancho": 40.0},
		{"texto": CareerTheme.caps(n) if compacta else n, "ancho": nombre_w, "tam": tam},
		{"texto": "+%d" % int(Legacy.AWARD_POINTS[String(fila["premio"])]), "ancho": pts_w,
			"derecha": true, "tam": tam, "color": CareerTheme.NAV_LEGADO}], false,
		CareerTheme.NAV_LEGADO)
	f.size_flags_vertical = Control.SIZE_EXPAND_FILL
	return f



func _leg_escalones() -> VBoxContainer:
	var v: VBoxContainer = VBoxContainer.new()
	v.name = "LegEscalones"
	v.add_theme_constant_override("separation", 0)
	v.set_meta("fl_lista", "escalones")
	var actual: String = String(Career.legacy_tier().get("name", ""))
	var w: float = 0.0
	for i in 4:
		w = maxf(w, _hc_ancho(I18n.t(String(Legacy.TIERS[i]["name"])), CareerTheme.T_LEE_TUMBADO))
	w = maxf(w + LEG_AIRE, LEG_LADO_W - LEG_COL_NOTA - 5.0 * float(CareerUi.FILA_TUMBADA_SEP) - 16.0)
	for i in 4:
		var nombre: String = String(Legacy.TIERS[i]["name"])
		var tuya: bool = nombre == actual
		var f: PanelContainer = CareerUi.fila_tumbada(LEG_FILA_IDEAL, Color.TRANSPARENT, [
			{"texto": I18n.t(nombre), "ancho": w},
			{"texto": str(int(Legacy.TIERS[i]["min"])), "ancho": LEG_COL_NOTA, "derecha": true,
				"color": CareerTheme.TEXT_MID}, _leg_cola()], tuya, CareerTheme.NAV_LEGADO)
		f.set_meta("fl_fila", true)
		if tuya:
			f.set_meta("fl_tuya", true)
		v.add_child(f)
	return v






func _leg_vias(vias: Dictionary) -> VBoxContainer:
	var v: VBoxContainer = VBoxContainer.new()
	v.name = "LegVias"
	v.add_theme_constant_override("separation", 16)
	var w: Dictionary = vias.get("world", {})
	var c: Dictionary = vias.get("club", {})
	var pares: Array = [
		["MUNDO", "%.0f/%.0f" % [float(w.get("prestige", 0.0)), float(w.get("target", 0.0))],
			String(w.get("next", "")), float(w.get("ratio", 0.0))],
		["CLUB", "%d/%d" % [int(c.get("total", 0)), int(c.get("target", 0))],
			String(c.get("next", "")), float(c.get("ratio", 0.0))]]
	for par in pares:
		var bloque: VBoxContainer = VBoxContainer.new()
		bloque.add_theme_constant_override("separation", 8)
		v.add_child(bloque)
		var fila: HBoxContainer = HBoxContainer.new()
		fila.add_theme_constant_override("separation", 16)
		fila.custom_minimum_size.x = LEG_LADO_W
		bloque.add_child(fila)
		fila.add_child(_leg_label(CareerTheme.caps(I18n.t(String(par[0]))), CareerTheme.T_CAP_TUMBADO,
			CareerTheme.TEXT_MID))
		fila.add_child(_leg_label(String(par[1]), CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT))
		var hueco: Control = Control.new()
		hueco.size_flags_horizontal = Control.SIZE_EXPAND_FILL
