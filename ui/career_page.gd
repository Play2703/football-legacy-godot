func _pa_t_notas(s: Dictionary) -> Array[String]:
	var out: Array[String] = []
	if Sponsors.profile_of(s) == "titular":
		out.append(I18n.tf("Desde el banquillo no cobras: sólo cuentan (y se pagan) las jornadas"
			+ " de {0}' o más.", [Sponsors.STARTER_MINUTES]))
	if Sponsors.injury_relief(s) > 0.0:
		if String(s.get("obj", "goals")) == "rating":
			out.append(I18n.tf("Te piden menos jornadas por las {0} que te perdiste lesionado. La"
				+ " media no baja.", [int(s.get("missed", 0))]))
		else:
			out.append(I18n.tf("Te perdonan parte del objetivo por las {0} jornadas que te perdiste"
				+ " lesionado (firmaste {1}).", [int(s.get("missed", 0)), int(s.get("target", 0))]))
	return out





