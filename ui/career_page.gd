						"titulo": I18n.t(String(ed["name"])) if not ed.is_empty()
							else I18n.t("SIN EDICIÓN"),
						"icono": "bota_potencia", "color": ed.get("color", CareerTheme.TEXT_DIM),
						"chip": I18n.t("TUYA") if puesta else "", "chip_col": CareerTheme.TEXT,
						"primaria": puesta, "al_tocar": func() -> void:
							_poner_edicion(id)
							_ti_t_dock_repinta()})
				_ti_t_dock_filas(eds, I18n.t("TUS EDICIONES"))



func _ti_t_dock_filas(filas: Array[Dictionary], rotulo: String) -> void:
	var vivas: Array[Dictionary] = filas
	var resto: Array[Dictionary] = []
	if filas.size() > TI_T_FILAS_DOCK:
		vivas = filas.slice(0, TI_T_FILAS_DOCK - 1)
		resto = filas.slice(TI_T_FILAS_DOCK - 1)
	for f in vivas:
		var b: Button = _ti_t_fila(f)
		b.gui_input.connect(_ti_t_fila_cruceta.bind(_ti_t_filas_dock.size()))
		_ti_t_filas_dock.append(b)
		_ti_t_dock.add_child(b)
	if not resto.is_empty():
		var mas: Button = _ti_t_fila({"id": "_mas", "icono": "otra",
			"titulo": "%s · %d" % [I18n.t("MÁS"), resto.size()],
			"al_tocar": func() -> void: _ti_t_lista_modal(rotulo, resto, "ti_t_filas")})
		mas.gui_input.connect(_ti_t_fila_cruceta.bind(_ti_t_filas_dock.size()))
		_ti_t_filas_dock.append(mas)
		_ti_t_dock.add_child(mas)



func _ti_t_fila(d: Dictionary) -> Button:
	var b: Button = Button.new()
	b.name = "Fila_" + String(d.get("id", ""))
	b.custom_minimum_size = Vector2(0.0, TI_T_FILA_H)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	b.clip_text = true
	b.set_meta("ti_t_fila", String(d.get("id", "")))
	CareerTheme.apply_button(b, CareerTheme.Kind.PRIMARY if bool(d.get("primaria", false))
		else CareerTheme.Kind.NEUTRAL, CareerTheme.T_LEE_TUMBADO)
	var cb: Callable = d.get("al_tocar", Callable())
	if cb.is_valid():
		b.pressed.connect(cb)
	if bool(d.get("apagada", false)):
		b.modulate.a = 0.55
	var relleno: MarginContainer = CareerUi._relleno_boton(b, 24, 8)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "Fila"
	fila.add_theme_constant_override("separation", 16)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	relleno.add_child(fila)
	if d.has("color"):
		var muestra: ColorRect = ColorRect.new()
		muestra.color = d["color"]
		muestra.custom_minimum_size = Vector2(32.0, 32.0)
		muestra.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		muestra.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fila.add_child(muestra)
	else:
		var foto: String = String(d.get("foto", ""))
		var arte: Control = ShopPhoto.rect(self, foto, float(MK_T_ICONO)) \
				if not foto.is_empty() and ShopPhoto.tiene_modelo(foto) else null
		if arte == null:
			var ic: MenuIcon = MenuIcon.new()
			ic.custom_minimum_size = Vector2(MK_T_ICONO, MK_T_ICONO)
			ic.setup(String(d.get("icono", "")), CareerTheme.TEXT)
			arte = ic
		arte.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		arte.mouse_filter = Control.MOUSE_FILTER_IGNORE
		fila.add_child(arte)
	var l: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT,
		CareerTheme.caps(String(d.get("titulo", ""))))
	l.name = "Nombre"
	l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(l)
	var chip: String = String(d.get("chip", ""))
	if not chip.is_empty():
		fila.add_child(CareerUi.code_chip(CareerTheme.caps(chip), d.get("chip_col", CareerTheme.TEXT),
			CareerTheme.T_CAP_TUMBADO, 10.0, 4.0))
	var cifra: String = String(d.get("precio", ""))
	if not cifra.is_empty():
		var c: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, d.get("precio_col", CareerTheme.MONEY),
			CareerTheme.caps(cifra))
		c.name = "Cifra"
		c.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		c.custom_minimum_size.x = _wnews_ancho(c.text, CareerTheme.T_LEE_TUMBADO) + 4.0
		fila.add_child(c)
	return b




