	var cab: Label = CareerUi.plain(CareerTheme.T_TITULO_TUMBADO, CareerTheme.TEXT)
	cab.text = CareerTheme.caps(titulo)
	cab.clip_text = true
	cab.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(cab)
	var tocables: bool = idxs.size() <= PL_T_MODAL_TOCABLES
	var columnas: HBoxContainer = HBoxContainer.new()
	columnas.add_theme_constant_override("separation", 24)
	columnas.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(columnas)
	var por_col: int = PL_T_MODAL_COL if not tocables else idxs.size()
	var lista: VBoxContainer = null
	for n in idxs.size():
		if lista == null or (n % maxi(por_col, 1) == 0 and not tocables):
			lista = VBoxContainer.new()
			lista.add_theme_constant_override("separation", 16 if tocables else 8)
			lista.custom_minimum_size.x = PL_T_MODAL_ANCHO
			lista.mouse_filter = Control.MOUSE_FILTER_IGNORE
			lista.set_meta("pl_t_lista_col", true)
			columnas.add_child(lista)
		var i: int = int(idxs[n])
		var pos: String = String(slots[n]) if n < slots.size() else _pl_t_pos(i)
		var yo: bool = i == int(_pl_t_datos.get("yo", -1))
		if tocables:
			var b: Button = Button.new()
			b.name = "Jugador%d" % n
			b.custom_minimum_size = Vector2(0.0, PL_T_FILA_H)
			b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			b.clip_text = true
			CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, CareerTheme.T_LEE_TUMBADO)
			b.set_meta("pl_t_modal_fila", i)
			b.pressed.connect(_pl_t_abre.bind(i, String(slots[n]) if n < slots.size() else ""))
			var relleno: MarginContainer = CareerUi._relleno_boton(b, 16, 8)
			relleno.add_child(_pl_t_jugador_fila(i, pos, yo, PL_T_MODAL_ANCHO - 200.0))
			lista.add_child(b)
		else:
			var placa: PanelContainer = CareerUi.plate()
			placa.name = "Jugador%d" % n
			placa.custom_minimum_size = Vector2(0.0, PL_T_MODAL_FILA)
			placa.mouse_filter = Control.MOUSE_FILTER_IGNORE
			placa.set_meta("pl_t_modal_fila", i)
			placa.add_child(_pl_t_jugador_fila(i, pos, yo, PL_T_MODAL_ANCHO - 200.0))
			lista.add_child(placa)



func _pl_t_once_modal() -> void:
	var d: Dictionary = _pl_t_datos
	if d.is_empty():
		return
	var slots: Array = []
	var titulares: Array = d["titulares"]
	for j in titulares.size():
		slots.append(String((d["slots"] as Array)[j]) if j <(d["slots"] as Array).size() else "MC")
	_pl_t_lista_modal(String(d["titulo"]), titulares, "pl_t_once", slots)


func _page_plantilla() -> void:





	var tiene_pais: bool = not Career.nationality.is_empty()
	_pl_t_tiene_pais = tiene_pais
	if not tiene_pais:
		_plantilla_scope = "club"
	elif not UiKit.es_horizontal():

		var seg: HBoxContainer = CareerUi.segmented(
			[I18n.t("CLUB"), I18n.t("SELECCIÓN")],
			0 if _plantilla_scope == "club" else 1,
			func(i: int) -> void:
				_plantilla_scope = "club" if i == 0 else "seleccion"
				_rebuild())
		_content.add_child(seg)

	if _plantilla_scope == "seleccion":
		await _plantilla_seleccion()
	else:
		await _plantilla_club()




func _plantilla_club() -> void:
	if Career.free_agent:
		_plantilla_vacia(I18n.t("Sin club: no hay plantilla que mostrar."
			+ " Ficha por un equipo y aquí verás a los tuyos."))
		return
	var id: String = GameState.player_team_id
	var team: Dictionary = Teams.by_id(id)




	var squad: Array = Squad.of_nominal(id).duplicate()
	if squad.is_empty():
		return
	var pais: String = Teams.country_of(id)
	var slots: Array = Squad.formation_slots(id)
	var cap: String = Squad.captain_name(id)













	var jornada: Dictionary = Career.club_matchday()



	slots = Squad.formation_slots(id)


	Squad.aplica_urgencias(id, squad)
	var titulares: Array =(jornada.get("once", []) as Array).duplicate()
	var convocados: Array =(jornada.get("banca", []) as Array).duplicate()
	if titulares.is_empty():

		for k in mini(Squad.STARTING_XI, squad.size()):
			titulares.append(k)










	var yo_idx: int = squad.size()
	squad.append({
		"name": Career.player_name, "pos": Squad.USER_POS,
		"number": GameState.shirt_number_now(),


		"media": int(round(Career.skills_avg())),
	})





	var mi_status: String = Standing.STATUS_FUERA if not Career.can_play() \
			else String(Career.standing().get("status", Standing.STATUS_BANCA))





	var en_once: Dictionary = {}
	for i in titulares:
		en_once[int(i)] = true
	var en_banca: Dictionary = {}
	for i in convocados:
		en_banca[int(i)] = true
	var banca: Array = []
	for i in yo_idx:
		if not en_once.has(i) and en_banca.has(i):
			banca.append(i)










	if mi_status == Standing.STATUS_TITULAR:













		var once_por_hueco: Array = []
		for j in titulares.size():
			once_por_hueco.append({"pos": String(slots[j]) if j < slots.size() else ""})
		var hueco: int = Squad.user_index(once_por_hueco)
		if hueco < 0:

			hueco = titulares.size() - 1


		banca.push_front(int(titulares[hueco]))
		titulares[hueco] = yo_idx
	elif mi_status == Standing.STATUS_BANCA:
		banca.push_front(yo_idx)


	if banca.size() > Squad.BENCH_SIZE:
		banca.resize(Squad.BENCH_SIZE)






	var en_once_final: Dictionary = {}
	for i in titulares:
		en_once_final[int(i)] = true
	var en_banca_final: Dictionary = {}
	for i in banca:
		en_banca_final[int(i)] = true
	var reserva: Array = []
	for i in squad.size():
		if not en_once_final.has(i) and not en_banca_final.has(i):
			reserva.append(i)















	var mejor_en_once: Callable = func(key: String) -> int:
		var top_i: int = -1
		var top_v: int = -1
		for i in titulares:
			var p: Dictionary = squad[i]
			if String(p.get("pos", "")) == "POR":
				continue
			var v: int = int(Career.skills.get(key, 0)) if i == yo_idx \
					else int(p.get(key, 0))



			if v > top_v or (v == top_v and i == yo_idx):
				top_v = v
				top_i = i
		return top_i
	var pen_i: int = mejor_en_once.call("penal")
	var libre_i: int = mejor_en_once.call("parado")


	var cap_i: int = -1
	if Career.is_player_captain():
		cap_i = yo_idx
	else:



		for i in titulares:
			if i != yo_idx and String((squad[i] as Dictionary).get("name", "")) == cap \
					and not cap.is_empty() and String(Career.captain_npc.get("name", "")) == cap:
				cap_i = i
		var cap_ovr: float = -1.0 if cap_i < 0 else INF
		for i in titulares:
			var p: Dictionary = squad[i]
			if i == yo_idx or String(p.get("pos", "")) == "POR":
				continue


			var o: float = Squad.ovr(p)
			if String(p.get("name", "")) == cap:
				o += 0.001
			if o > cap_ovr:
				cap_ovr = o
				cap_i = i








	var estado_de: Dictionary = {}
	for i in titulares:
		estado_de[int(i)] = I18n.t(Standing.STATUS_LABEL[Standing.STATUS_TITULAR])
	for i in banca:
		estado_de[int(i)] = I18n.t(Standing.STATUS_LABEL[Standing.STATUS_BANCA])
	for i in reserva:
		estado_de[int(i)] = I18n.t(Standing.STATUS_LABEL[Standing.STATUS_FUERA])






	var meta: Array = Career._ensure_squad_meta(id, Squad.of_nominal(id))





	var cedidos: Dictionary = Career.cedidos_de(id)




	var carta: Callable = func(i: int, slot: String) -> PlayerCard:
		var p: Dictionary = squad[i]



		if i == yo_idx:








			var p_mio: Dictionary = p.duplicate()
			p_mio["poss"] = Career.puestos()
			var hacer_mio: Callable = func() -> PlayerCard:
				return PlayerCard.build(p_mio, team,
					Nations.id_for_country(Career.nationality), true, false,
					Career.is_player_captain(), Career.dias_baja(),
					int(round(Career.energy)),
					i == pen_i, i == libre_i,
					GameState.player_look(), slot, false,



					int(Career.contract.get("seasons_left", -1)),


					Career.suspension_matches if Career.suspended_now() else 0)
			var mia: PlayerCard = hacer_mio.call()
			mia.set_tap(func() -> void: _ficha_jugador(p_mio, true, {}, hacer_mio,
				String(estado_de.get(i, ""))))
			return mia






		var nat: String = String(p.get("nat", ""))
		if nat.is_empty():
			nat = SquadMeta.nation_at(id, pais, i, String(p.get("pos", "MC")))




		var baja: int = 0
		var sancion: int = 0
		var pm: Dictionary = {}
		if i < meta.size():
			pm = meta[i] as Dictionary


			baja = Career.dias_baja_ficha(pm)


			sancion = int(pm.get("sancion", 0))






		var contrato: int = int(pm.get("contract", -1)) if pm.has("contract") else -1




		if contrato >= 0 and contrato <= 1 and not bool(pm.get("se_va", false)):
			contrato = -1



		var soc: int = Career.socio_v(String(p.get("name", "")))
		if absi(soc) < Career.SOCIO_UMBRAL:
			soc = 0
		var hacer: Callable = func() -> PlayerCard:
			return PlayerCard.build(p, team, Nations.id_for_country(nat),
				false, false,
				i == cap_i, baja, Career.club_energy(i),
				i == pen_i, i == libre_i, {}, slot, cedidos.has(i), contrato, sancion,
				soc)
		var c: PlayerCard = hacer.call()


		c.set_tap(func() -> void: _ficha_jugador(p, false, pm, hacer,
			String(estado_de.get(i, "")), {}, {"club": id, "seat": i}))
		return c











	var suma: int = 0
	for i in titulares:
		suma += SquadMeta.ovr_of(squad[i], String((squad[i] as Dictionary).get("pos", "MC")))
	await _plantilla_render(CareerTheme.caps("%s · %s"
			% [I18n.t("EL ONCE"), Squad.formation_of(id)]),
		int(round(float(suma) / maxf(1.0, float(titulares.size())))),
		squad, slots, titulares, carta,
		[
			{"titulo": I18n.t("BANCA"), "icono": "banquillo", "cols": 4,
				"idxs": banca},




			{"titulo": I18n.t("NO CONVOCADOS"), "icono": "equipo", "cols": 4,
				"idxs": reserva},
		],






		Callable(),


		_linea_brazalete(),

		id, yo_idx)








func _mister_cromo(club: String) -> CoachCard:
	var f: Dictionary = CoachCard.fila_del_club(club)
	if f.is_empty():
		return null
	var cc: CoachCard = CoachCard.build(f)
	cc.scale = Vector2(MISTER_K, MISTER_K)
	cc.set_tap(func() -> void: CoachRankingView.ficha(self, CoachMarket.detalle(f)))
	return cc
















func _linea_brazalete() -> Dictionary:
	var r: Dictionary = Career.captain_race_view()
	if r.is_empty():
		return {}
	var tuyo: bool = bool(r["tuyo"])
	var partes: Array[String] = [I18n.t("BRAZALETE TUYO") if tuyo else I18n.t("BRAZALETE")]
	var cuando: String = I18n.t("INVIERNO") if String(r["revision"]) == "invierno" \
			else I18n.t("VERANO")
	if tuyo:
		partes.append(I18n.t("EN RIESGO") if bool(r["en_riesgo"]) else I18n.tf(
			"NIVEL {0}/{1}", [int(r["nivel"]), Gerencia.PELDANO_MAX]))
		partes.append(cuando)
	else:
		if not String(r.get("name", "")).is_empty():
			partes.append(CareerTheme.caps(String(r["name"])))
		if bool(r["frenado"]):
			partes.append(I18n.t("FRENADO POR TU PALABRA"))
		elif int(r["nivel"]) < Gerencia.PELDANO_CAPITAN - 1:


			partes.append(I18n.tf("ES EL NIVEL {0}: VAS EN EL {1}",
				[Gerencia.PELDANO_CAPITAN, int(r["nivel"])]))
		elif int(r["falta"]) > 0:
			partes.append(I18n.tf("TE FALTAN {0} DE RELACIÓN", [int(r["falta"])]))
		elif float(r["jugado"]) < Gerencia.PELDANO_JUGADOS:
			partes.append(I18n.tf("TITULAR EL {0} %: PIDE {1} %",
				[roundi(float(r["jugado"]) * 100.0),
					roundi(Gerencia.PELDANO_JUGADOS * 100.0)]))
		else:
			partes.append(cuando)
	var col: Color = CareerTheme.DANGER if bool(r["en_riesgo"]) \
			else (CareerTheme.accent_text() if tuyo else CareerTheme.TEXT_DIM)
	return {"text": " · ".join(partes), "col": col}






















func _plantilla_seleccion() -> void:
	var squad: Array = Career.nat_match_squad()
	if squad.is_empty():
		_plantilla_vacia(I18n.t("Aún no hay convocatoria que mostrar."))
		return
	var flag: String = Nations.id_for_country(Career.nationality)





	var pen_taker: String = Squad.taker_name_in(squad, "penal", Career.skills)
	var libre_taker: String = Squad.taker_name_in(squad, "parado", Career.skills)


	var titulares: Array = []
	for i in mini(Squad.STARTING_XI, squad.size()):
		titulares.append(i)











	var forma_nat: Array = NatTeam.squad_shape(Career.nationality)
	var por_linea: Dictionary = {}
	var k_de: Dictionary = {}
	for i in squad.size():
		var li: String = Squad.line_of(String((squad[i] as Dictionary).get("pos", "MC")))
		if not por_linea.has(li):
			por_linea[li] = [0, 0]
		k_de[i] = int((por_linea[li] as Array)[0])
		(por_linea[li] as Array)[0] += 1
		if i < Squad.STARTING_XI:
			(por_linea[li] as Array)[1] += 1



	var estado_de: Callable = func(i: int) -> String:
		if i < Squad.STARTING_XI:
			return Career.nat_role_label("titular")
		var li: String = Squad.line_of(String((squad[i] as Dictionary).get("pos", "MC")))
		var datos: Array = por_linea.get(li, [0, 0])
		return Career.nat_role_label(NatTeam.role_for(int(k_de.get(i, 0)),
			int(datos[1]), int(datos[0]), li, forma_nat))
	var en_banca: Callable = func(i: int) -> bool:
		return String(estado_de.call(i)) == Career.nat_role_label("banca")





	var yo_idx: int = -1
	for r in Career.nat_squad_list():
		if bool((r as Dictionary).get("is_you", false)):
			yo_idx = int((r as Dictionary).get("rank", 0)) - 1
			break
	if yo_idx < 0 or yo_idx >= squad.size():
		yo_idx = -1
		for i in squad.size():
			var f: Dictionary = squad[i]
			if String(f.get("pos", "")) == Squad.USER_POS \
					and String(f.get("name", "")).to_upper() \
					== Career.player_name.to_upper():
				yo_idx = i
				break




	var carta: Callable = func(i: int, slot: String) -> PlayerCard:
		var p: Dictionary = squad[i]


		var titular: bool = i < Squad.STARTING_XI



		var es_cap: bool = titular and i == yo_idx and Career.is_nat_captain()


		var nombre: String = String(p.get("name", ""))



		var soy_yo: bool = i == yo_idx
		if soy_yo:





			p = p.duplicate()
			p["media"] = int(round(Career.skills_avg()))

			p["poss"] = Career.puestos()




		var p_ficha: Dictionary = p
		var hacer: Callable = func() -> PlayerCard:
			return PlayerCard.build(p_ficha, Nations.as_team(Career.nationality), flag,
				soy_yo, false, es_cap, 0, -1,
				titular and nombre == pen_taker, titular and nombre == libre_taker,
				GameState.player_look() if soy_yo else {}, slot)
		var c: PlayerCard = hacer.call()
		c.set_tap(func() -> void:
			var de: Dictionary = {} if soy_yo else _de_convocado(String(p_ficha.get("name", "")))
			_ficha_jugador(p_ficha, soy_yo, de.get("pm", {}), hacer,
				String(estado_de.call(i)), {}, de.get("tray", {})))
		return c

	var suma: int = 0
	for i in titulares:
		suma += SquadMeta.ovr_of(squad[i], String(squad[i].get("pos", "MC")))
	var ovr: int = int(round(float(suma) / maxf(1.0, float(titulares.size()))))













	await _plantilla_render(CareerTheme.caps("%s · %s"
			% [I18n.t("EL ONCE"), Nations.display_name(Career.nationality)]),




		ovr, squad, NatTeam.squad_shape(Career.nationality), titulares, carta,
		[
			{"titulo": I18n.t("BANCA"), "icono": "banquillo", "cols": 4,
				"incluir": func(i: int) -> bool: return bool(en_banca.call(i))},
			{"titulo": I18n.t("RESERVA"), "icono": "equipo", "cols": 4,
				"incluir": func(i: int) -> bool: return not bool(en_banca.call(i))},
		],




		Callable(), {}, Coach.origen_nat(Career.nationality), yo_idx)














func _plantilla_render(titulo: String, ovr: int, squad: Array, slots: Array,
		titulares: Array, carta: Callable, secciones: Array,
		extra: Callable = Callable(), linea: Dictionary = {},
		mister: String = "", yo: int = -1) -> void:
	if UiKit.es_horizontal():

		await _pl_t_render(titulo, ovr, squad, slots, titulares, carta, secciones, linea, mister, yo)
		return
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 10)
	_content.add_child(cab)
	var tit: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.TEXT)
	tit.text = titulo
	tit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	tit.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	tit.clip_text = true
	cab.add_child(tit)
	var med: OvrBadge = OvrBadge.new()
	med.custom_minimum_size = Vector2(58, 62)
	med.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	med.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	cab.add_child(med)
	med.setup(ovr, 22)
	if not linea.is_empty():


		var ln: Label = CareerUi.plain(CareerTheme.T_DIM, linea["col"])
		ln.text = String(linea["text"])
		ln.clip_text = true


		CareerUi.autoshrink(ln, 11)
		ln.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		_content.add_child(ln)

	var pitch: PitchView = PitchView.new()
	pitch.custom_minimum_size = Vector2(0, _alto_cancha())
	_content.add_child(pitch)
	var cards: Array = []
	var slots_once: Array = []
	for k in titulares.size():




		slots_once.append(String(slots[k]) if k < slots.size() else "MC")
		cards.append(carta.call(int(titulares[k]), String(slots_once[k])))
	for c in cards:
		pitch.add_child(c)




	var cromo_m: CoachCard = null
	if not mister.is_empty():
		cromo_m = _mister_cromo(mister)
		if cromo_m != null:
			pitch.add_child(cromo_m)






	var gen: int = _build_gen
	await get_tree().process_frame
	if is_instance_valid(pitch):
		pitch.place(cards, slots_once)
		if cromo_m != null:



			pitch.pon_en_esquina(cromo_m, MISTER_K, MISTER_AIRE)








	if gen != _build_gen or not is_instance_valid(_content):
		return
	if extra.is_valid():
		extra.call()

	var en_once: Dictionary = {}
	for i in titulares:
		en_once[i] = true




	var seg_orden: HBoxContainer = CareerUi.segmented(
		[I18n.t("POSICIÓN"), I18n.t("MEDIA", "ovr")],
		0 if _plantilla_orden == "linea" else 1,
		func(k: int) -> void:
			_plantilla_orden = "linea" if k == 0 else "ovr"






			_refresh_keeping_scroll(),
		70.0)
	_content.add_child(seg_orden)



	for sec in secciones:



		var idxs: Array = []
		if sec.has("idxs"):
			for i in sec["idxs"]:
				if not en_once.has(int(i)):
					idxs.append(int(i))
		else:
			var incluir: Callable = sec["incluir"]
			for i in squad.size():
				if not en_once.has(i) and incluir.call(i):
					idxs.append(i)






		idxs.sort_custom(func(a: int, b: int) -> bool:


			if _plantilla_orden == "ovr":
				var ma: int = SquadMeta.ovr_of(squad[a],
					String((squad[a] as Dictionary).get("pos", "MC")))
				var mb: int = SquadMeta.ovr_of(squad[b],
					String((squad[b] as Dictionary).get("pos", "MC")))
				if ma != mb:
					return ma > mb
				return a < b
			var ra: int = _rango_linea(squad, a)
			var rb: int = _rango_linea(squad, b)
			if ra != rb:
				return ra < rb
			return a < b)
		if idxs.is_empty():
			continue





		var ic_sec: MenuIcon = MenuIcon.new()



		ic_sec.setup(String(sec.get("icono", "equipo")), CareerTheme.accent_text())
		CareerUi.head(_content, String(sec["titulo"]), ic_sec)




		var cols: int = int(sec["cols"])





		var filas: Control = _content
		if not UiKit.es_horizontal():
			var caja: VBoxContainer = VBoxContainer.new()
			caja.add_theme_constant_override("separation", 10)
			caja.size_flags_horizontal = Control.SIZE_FILL
			_content.add_child(caja)
			filas = caja
		var k: int = 0
		while k < idxs.size():
			var fila: HBoxContainer = HBoxContainer.new()
			fila.size_flags_horizontal = Control.SIZE_EXPAND_FILL




			if filas == _content:
				fila.add_theme_constant_override("separation", 0)
			filas.add_child(fila)
			_espaciador(fila)
			for j in range(k, mini(k + cols, idxs.size())):


				fila.add_child(carta.call(int(idxs[j]), ""))
				_espaciador(fila)
			k += cols





func _rango_linea(squad: Array, i: int) -> int:
	if i < 0 or i >= squad.size():
		return 9


	var linea: String = Squad.line_pintada(String((squad[i] as Dictionary).get("pos", "MC")))
	return {"POR": 0, "DEF": 1, "MED": 2, "DEL": 3}.get(linea, 9)




func _espaciador(fila: HBoxContainer) -> void:
	var sp: Control = Control.new()
	sp.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	fila.add_child(sp)


























