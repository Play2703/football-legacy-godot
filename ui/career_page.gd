		derecha.size_flags_horizontal = Control.SIZE_SHRINK_END
		derecha.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		h.add_child(derecha)
	CareerUi.letra_por_peldanos(r, [CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	return h







func _mt_dato_letra(h: HBoxContainer, r: Label, v: Label) -> void:
	if not is_instance_valid(h) or h.size.x <= 0.0:
		return
	var hueco: float = h.size.x - float(h.get_theme_constant("separation"))
	var rot: float = CareerUi._ancho_a(r, r.text, CareerTheme.T_LEE_TUMBADO) + 2.0
	var px: int = CareerTheme.T_DATO_TUMBADO
	if rot + CareerUi._ancho_a(v, v.text, px) + 2.0 > hueco \
			and rot + CareerUi._ancho_a(v, v.text, CareerTheme.T_LEE_TUMBADO) + 2.0 <= hueco:
		px = CareerTheme.T_LEE_TUMBADO
	if v.get_theme_font_size("font_size") != px:
		v.add_theme_font_size_override("font_size", px)
		v.custom_minimum_size.x = ceilf(CareerUi._ancho_a(v, v.text, px)) + 2.0





