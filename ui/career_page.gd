func _ficha_regateo(box: VBoxContainer, reco: Dictionary) -> void:
	var precio: int = Career.gerencia_precio(reco)
	var trato: Dictionary = Career.gerencia_trato(reco)
	var fila: HBoxContainer = HBoxContainer.new()
	var t: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	t.text = I18n.t("TU OFERTA")
	t.clip_text = true
	t.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	t.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(t)
	var cifra: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.MONEY)
	cifra.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	fila.add_child(cifra)
	box.add_child(fila)
	var sl: HSlider = HSlider.new()


	var paso: int = Gerencia.regateo_paso(precio)
	sl.step = float(paso)
	sl.min_value = float(paso * roundi(Gerencia.REGATEO_SUELO / Gerencia.REGATEO_PASO))
	sl.max_value = float(precio)
	sl.custom_minimum_size = Vector2(0, 56)
	UiKit.style_slider(sl)
	box.add_child(sl)
	var chips: HFlowContainer = HFlowContainer.new()
	chips.add_theme_constant_override("h_separation", 10)
	chips.add_theme_constant_override("v_separation", 8)
	box.add_child(chips)
	var b: Button = Button.new()
	b.text = I18n.t("OFRECER")
	b.custom_minimum_size = Vector2(0, 92)
	b.clip_text = true
	CareerTheme.apply_button_tinted(b, CareerTheme.MONEY, 26)
	box.add_child(b)

	var pinta: Callable = func() -> void:
		var tr: Dictionary = Career.gerencia_trato(reco)
		var v: int = int(sl.value)
		cifra.text = CareerUi.short_money(v)
		for c in chips.get_children():
			chips.remove_child(c)
			c.queue_free()
		var pct: int = roundi((1.0 - float(v) / float(maxi(1, precio))) * 100.0)

		var rebaja: PanelContainer = CareerUi.label_chip("", "-%d %%" % pct if pct > 0 else "0 %",
			CareerTheme.NAV_YO)
		chips.add_child(rebaja)
		var quedan: int = Gerencia.REGATEO_INTENTOS - int(tr["n"])
		var intentos: PanelContainer = CareerUi.label_chip(I18n.t("INTENTOS"), "%d/%d" % [quedan,
			Gerencia.REGATEO_INTENTOS], CareerTheme.DANGER if quedan <= 1 else CareerTheme.TEXT)
		chips.add_child(intentos)
		if int(tr["contra"]) >= 0:
			var piden: PanelContainer = CareerUi.label_chip(I18n.t("PIDEN"),
				CareerUi.short_money(int(tr["contra"])), CareerTheme.MONEY)
			chips.add_child(piden)
	sl.value = float(trato["contra"]) if int(trato["contra"]) >= 0 else float(precio)
	sl.value_changed.connect(func(_v: float) -> void: pinta.call())
	pinta.call()
	b.pressed.connect(func() -> void:
		var res: Dictionary = Career.gerencia_ofrece(reco, int(sl.value))
		if bool(res.get("ok", false)):
			UiAudio.toggle(true)
			CareerUi.close_modal(box)
			var queda: int = int(Career.gerencia_mesa_saldo()["queda"])
			_toast(I18n.tf("Trato cerrado ({0}). Te queda {1}.", [
				CareerUi.short_money(int(res["pacto"])),
				CareerUi.short_money(queda)]),
				CareerTheme.MONEY if queda >= 0 else CareerTheme.DANGER)
			return
		UiAudio.deny()
		var causa_r: String = String(res.get("causa", ""))
		if not causa_r.is_empty():
			CareerUi.close_modal(box)
			_toast(_mesa_causa_compra(reco, causa_r), CareerTheme.DANGER)
			return
		sl.set_value_no_signal(float(int(res["contra"])))
		pinta.call()
		_toast(I18n.tf("No aceptan. Piden {0}.", [CareerUi.short_money(int(res["contra"]))]),
			CareerTheme.DANGER))







