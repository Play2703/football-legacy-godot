func _balon_lista_epocas(titulo: String, grupos: Array, pinta: Callable) -> void:
	var ini: Array = grupos[0]["filas"]
	var box: VBoxContainer = CareerUi.lista_entera_modal(self, titulo, ini,
		_balon_sin_franjas(ini.size()), CareerTheme.accent(), pinta)
	if box == null:
		return
	var partes: Dictionary = box.get_meta("lista_entera_partes")
	var col: VBoxContainer = partes["lista"]
	var filas_v: VBoxContainer = partes["filas"]
	var opciones: Array = []
	for gr in grupos:
		opciones.append({"rotulo": String(gr["rotulo"]), "color": CareerTheme.accent()})
	var seg: HBoxContainer = CareerUi.segmentado(opciones, 0, func(i: int) -> void:
		_balon_epoca_pinta(box, filas_v, grupos[i]["filas"], pinta))
	seg.name = "BalonEpocas"
	seg.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
	col.add_child(seg)
	col.move_child(seg, filas_v.get_index())
	var aire: Control = Control.new()
	aire.name = "AireEpocas"
	aire.custom_minimum_size = Vector2(0.0, float(CareerUi.PLANTILLA_SEP))
	aire.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(aire)
	col.move_child(aire, filas_v.get_index())
	CareerUi.normalize_caps(box)




func _balon_epoca_pinta(box: VBoxContainer, v: VBoxContainer, filas: Array,
		pinta: Callable) -> void:
	if not is_instance_valid(box):
		return
	for c in v.resized.get_connections():
		v.resized.disconnect(c["callable"])
	for h in v.get_children():
		v.remove_child(h)
		h.queue_free()
	v.set_meta("torn_lista_alto", 0.0)
	var franjas: Array = _balon_sin_franjas(filas.size())
	v.resized.connect(CareerUi.lista_entera_llena.bind(v, filas, franjas, pinta))
	CareerUi.lista_entera_llena(v, filas, franjas, pinta)
	box.set_meta("lista_entera", filas.size())
	CareerUi.normalize_caps(v)






func _balon_epocas(filas: Array, de_gala: bool) -> Array:
	var carrera: Array = []
	var por_epoca: Array = []
	for _e in BALON_EPOCAS:
		por_epoca.append([])
	for f in filas:
		var d: Dictionary = f
		var anio: int = int(d.get("anio", -1)) if de_gala \
				else (-1 if not (d.get("seasons", []) as Array).is_empty()
				else int(d.get("reciente", -1)))
		if anio < 0:
			carrera.append(d)
			continue
		for i in BALON_EPOCAS.size():
			if anio >= int(BALON_EPOCAS[i][0]) and anio <= int(BALON_EPOCAS[i][1]):
				(por_epoca[i] as Array).append(d)
				break
	var out: Array = []
	if not carrera.is_empty():
		out.append({"rotulo": I18n.t("TU CARRERA"), "filas": carrera})
	for i in BALON_EPOCAS.size():
		if not (por_epoca[i] as Array).is_empty():
			out.append({"rotulo": "%d-%d" % [int(BALON_EPOCAS[i][0]), int(BALON_EPOCAS[i][1])],
				"filas": por_epoca[i]})
	return out



