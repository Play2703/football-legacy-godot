func _ficha_mesa_venta(box: VBoxContainer, seat: int, nombre: String,
		pintas: Array = []) -> Callable:
	if not Career.gerencia_mesa_abierta():
		return func() -> void: pass



	var b: Button = CareerUi.accion("mercado", I18n.t("PONER EN VENTA"),
		CareerTheme.DANGER)
	var nota: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	nota.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART


	var cuesta: int = Career.gerencia_vende_coste(seat, nombre)
	if cuesta > 0:
		box.add_child(CareerUi.coste_fila([["equipo", cuesta]],
			I18n.tf("DE TUS {0} MEJORES", [Gerencia.VENDE_TOP])))
	var pinta: Callable = func() -> void:
		var en: bool = Career.gerencia_mesa_vendo(seat, nombre)
		CareerUi.pinta_accion(b, "mercado", I18n.t("QUITAR DE VENTA") if en
			else I18n.t("PONER EN VENTA"), CareerTheme.DANGER, en)
		nota.add_theme_color_override("font_color", CareerTheme.TEXT_DIM)
		nota.text = _mesa_venta_nota(seat, nombre) if en else ""
		nota.visible = en
	pinta.call()
	b.pressed.connect(func() -> void:
		var marca: int = _mesa_toque_marca()
		var antes: bool = Career.gerencia_mesa_vendo(seat, nombre)
		var causa: String = Career.gerencia_mesa_vende(seat, nombre)
		if not causa.is_empty():
			UiAudio.deny()
			nota.add_theme_color_override("font_color", CareerTheme.DANGER)
			nota.text = _mesa_causa_venta(causa,
				String(_mesa_fila_venta(seat, nombre).get("pos", "")))
			nota.visible = true
			return
		UiAudio.toggle(not antes)
		pinta.call()
		for f in pintas:
			(f as Callable).call()


		_mesa_refresca(_mesa_toque_limpio(marca)))
	box.add_child(b)
	box.add_child(nota)
	return pinta



func _mesa_fila_venta(idx: int, nombre: String) -> Dictionary:
	for r in Career.gerencia_mesa_plantilla():
		var row: Dictionary = r
		if int(row.get("idx", -1)) == idx and String(row.get("name", "")) == nombre:
			return row
	return {}




func _mesa_venta_nota(idx: int, nombre: String) -> String:
	var row: Dictionary = _mesa_fila_venta(idx, nombre)
	var club: String = String(row.get("club", ""))
	if club.is_empty():

		return I18n.t("En venta: sus ofertas, en la lista VENDER.")
	return I18n.tf("Va al {0} por {1} cuando confirmes la mesa.",
		[Competitions.demarca(String(Teams.by_id(club).get("name", "?"))),
			CareerUi.money(int(row.get("cobra", 0)))])




func _mesa_causa_venta(causa: String, pos: String) -> String:
	match causa:
		"cerrada": return _mesa_cerrada_txt(Career.gerencia_mesa_cerrada_por())
		"cedido": return I18n.t("Juega aquí cedido: no es tuyo para venderlo.")
		"nuevo": return I18n.t("Firmó esta temporada: no se vende hasta la próxima.")
		"puesto": return I18n.tf("Es tu último {0}: sin él no hay quien juegue ahí.",
			[CareerUi.pos_rotulo(pos)])
		"comprador": return I18n.t("Nadie lo compra hoy a ese precio.")
		"ido": return I18n.t("Ya no juega ahí.")
		"nivel": return _mesa_venta_nivel_txt()
	return ""



func _mesa_causa_venta_corta(causa: String, pos: String) -> String:
	match causa:
		"cedido": return I18n.t("CEDIDO")
		"nuevo": return I18n.t("FIRMO ESTE AÑO")
		"puesto": return I18n.tf("ULTIMO {0}", [CareerUi.pos_rotulo(pos)])
		"comprador": return I18n.t("SIN COMPRADOR")
		"ido": return I18n.t("YA NO ESTA")
		"nivel": return I18n.t(Gerencia.peldano_nombre(Gerencia.PELDANO_MESA))
	return ""




func _mesa_venta_nivel_txt() -> String:
	return I18n.tf("Vender es del nivel {0}: {1} de relación con el club.",
		[I18n.t(Gerencia.peldano_nombre(Gerencia.PELDANO_MESA)),
			Gerencia.peldano_umbral(Gerencia.PELDANO_MESA)])





static func _protege_col() -> Color:
	return UiKit.BTN_BLUE["bg"] as Color




func _ficha_intocable(box: VBoxContainer, seat: int, nombre: String,
		pintas: Array) -> Callable:


	var b: Button = CareerUi.accion("candado", I18n.t("NO LO VENDAIS"), _protege_col())
	var nota: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	nota.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART

	var coste: HBoxContainer = CareerUi.coste_fila([["relaciones",
		Gerencia.INTOCABLE_SUPLENTE]], I18n.t("SUPLENTE Y CLUB EN APURO"))
	box.add_child(coste)
	var pinta: Callable = func() -> void:
		var en: bool = Career.gerencia_es_intocable(seat, nombre)
		var cobra: bool = Career.gerencia_intocable_coste(seat, nombre) > 0
		coste.visible = cobra
		CareerUi.pinta_accion(b, "candado", I18n.t("QUITAR PROTECCION") if en
			else I18n.t("NO LO VENDAIS"), CareerTheme.DANGER if cobra else _protege_col(), en)
		nota.text = I18n.tf("Protegido: el club no lo vende ni lo cede y pide el doble"
			+ " por él. Si lo pagan, se va igual; cada ventana en que rechace ofertas te"
			+ " quita {0} de relación.", [Gerencia.INTOCABLE_DEUDA]) if en else ""
		nota.visible = en
	pinta.call()
	b.pressed.connect(func() -> void:
		var antes: bool = Career.gerencia_es_intocable(seat, nombre)
		if not Career.gerencia_pon_intocable(seat, nombre):
			return
		UiAudio.toggle(not antes)
		for f in pintas:
			(f as Callable).call()


		_refresh_keeping_scroll())
	box.add_child(b)
	box.add_child(nota)
	return pinta




func _ficha_renueva(box: VBoxContainer, seat: int, nombre: String) -> void:
	var motivo: String = Career.gerencia_renueva_motivo(seat, nombre)
	if not motivo in ["", "lleno"]:
		return





	var b: Button = CareerUi.accion("contrato_firma", I18n.t("QUE LO RENUEVEN"),
		CareerTheme.NAV_YO)
	var nota: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	nota.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART

	var coste: HBoxContainer = CareerUi.coste_fila([["relaciones",
		Gerencia.RENUEVA_VETERANO]], I18n.t("VETERANO SUPLENTE"))
	box.add_child(coste)
	var pinta: Callable = func() -> void:
		var en: bool = Career.gerencia_renueva_pedida(seat, nombre)
		var cobra: bool = Career.gerencia_renueva_coste(seat, nombre) > 0
		coste.visible = cobra
		CareerUi.pinta_accion(b, "contrato_firma", I18n.t("RETIRAR LA PETICION") if en
			else I18n.t("QUE LO RENUEVEN"), CareerTheme.DANGER if cobra
			else CareerTheme.NAV_YO, en)
		var p: float = Career.gerencia_renueva_prob(seat, nombre)
		if p < 0.0:
			nota.text = I18n.t("Se decide en la próxima ventana de contratos.")
		elif en:
			nota.text = I18n.tf("Pedido: {0} % de que renueve en la próxima ventana"
				+ " de contratos.", [roundi(p * 100.0)])
		else:
			nota.text = I18n.tf("Si lo pides: {0} % de que renueve.", [roundi(p * 100.0)])
	pinta.call()
	b.pressed.connect(func() -> void:
		var antes: bool = Career.gerencia_renueva_pedida(seat, nombre)
		if not Career.gerencia_pon_renueva(seat, nombre):
			nota.text = I18n.tf("Ya pides {0} renovaciones.", [Gerencia.RENUEVA_MAX])
			return
		UiAudio.toggle(not antes)
		pinta.call())
	box.add_child(b)
	box.add_child(nota)












func _gerencia_banquillo_block() -> void:
	if Career.free_agent or GameState.player_team_id.is_empty():
		return
	CareerUi.head(_content, I18n.t("BANQUILLO"))
	_banquillo_ultimo()
	var req: Dictionary = Career.pide_dt()
	if req.is_empty():

		if Career.peldano() < Gerencia.PELDANO_MESA:
			_content.add_child(CareerUi.icon_stat("candado", I18n.tf("NIVEL {0}/{1}",
				[Gerencia.PELDANO_MESA, Gerencia.PELDANO_MAX]), CareerTheme.TEXT_DIM, 30.0))
			return
		_banquillo_cese()

		if Career.peldano() < Gerencia.PELDANO_CASA:
			var cand: HBoxContainer = CareerUi.icon_stat("candado", I18n.tf(
				"ELEGIR QUIÉN VIENE · NIVEL {0}", [Gerencia.PELDANO_CASA]),
				CareerTheme.TEXT_DIM, 30.0)
			(cand.get_child(1) as Label).clip_text = true
			(cand.get_child(1) as Label).size_flags_horizontal = Control.SIZE_EXPAND_FILL
			_content.add_child(cand)
			return

		var ir: Button = CareerUi.menu_row(I18n.t("BUSCAR EN EL RANKING"), "",
			CareerTheme.TEXT_DIM, "tecnico")
		ir.pressed.connect(func() -> void:
			_rank_tecnicos = true
			_rank_uefa = false
			_family = CareerNav.family_of_tab("ranking")
			_on_tab("ranking"))
		_content.add_child(ir)
		return
	var caja: PanelContainer = CareerUi.plate()
	_content.add_child(caja)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 18)
	caja.add_child(fila)


	var f: Dictionary = Career._pide_dt_fila(String(req.get("id", "")))
	if not f.is_empty():
		var cc: CoachCard = CoachCard.build(f)
		cc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cc.set_tap(func() -> void: CoachRankingView.ficha(self, CoachMarket.detalle(f)))
		fila.add_child(cc)
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 14)
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.alignment = BoxContainer.ALIGNMENT_CENTER
	fila.add_child(col)
	_gerencia_prob(col, Career.pide_dt_prob())

	var invierno: bool = Career._coach_winter_season != GameState.season_num
	col.add_child(CareerUi.icon_stat("reloj", I18n.t("INVIERNO") if invierno
		else I18n.t("FIN DE TEMPORADA"), CareerTheme.TEXT_DIM, 30.0))

	var riesgo: HBoxContainer = CareerUi.icon_stat("tecnico",
		I18n.t("SI DICE QUE NO, TU TÉCNICO LO SABE"), CareerTheme.DANGER, 30.0)
	(riesgo.get_child(1) as Label).clip_text = true
	(riesgo.get_child(1) as Label).size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.add_child(riesgo)
	var quita: Button = Button.new()
	quita.text = I18n.t("RETIRAR LA PETICION")
	quita.custom_minimum_size = Vector2(0, CareerTheme.BTN_ROW_H)
	quita.clip_text = true
	CareerTheme.apply_button(quita, CareerTheme.Kind.WARN, CareerTheme.BTN_ROW_FONT)
	quita.pressed.connect(func() -> void:
		UiAudio.toggle(false)
		Career.pide_dt_pon({"id": String(req.get("id", ""))}))
	col.add_child(quita)










func _banquillo_cese() -> void:
	var mio: String = GameState.player_team_id
	var vivo: bool = not Career.pide_cese().is_empty()
	var motivo: String = Career.pide_cese_motivo()
	var caja: PanelContainer = CareerUi.plate()
	_content.add_child(caja)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 18)
	caja.add_child(fila)
	var f: Dictionary = Career._pide_dt_fila(Coaches.id_of(mio))
	if not f.is_empty():
		var cc: CoachCard = CoachCard.build(f)
		cc.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		cc.set_tap(func() -> void: CoachRankingView.ficha(self, CoachMarket.detalle(f)))
		fila.add_child(cc)
	var col: VBoxContainer = VBoxContainer.new()
	col.add_theme_constant_override("separation", 14)
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.alignment = BoxContainer.ALIGNMENT_CENTER
	fila.add_child(col)
	if motivo.is_empty():
		_gerencia_prob(col, Career.pide_cese_prob(), I18n.t("QUE LO ECHEN"))
	else:

		var cand: HBoxContainer = CareerUi.icon_stat("candado", I18n.t("RECIÉN LLEGADO")
			if motivo == "recien" else I18n.t("PEDISTE SALIR"), CareerTheme.TEXT_DIM, 30.0)
		(cand.get_child(1) as Label).clip_text = true
		(cand.get_child(1) as Label).size_flags_horizontal = Control.SIZE_EXPAND_FILL
		col.add_child(cand)
	var palancas: HBoxContainer = HBoxContainer.new()
	palancas.add_theme_constant_override("separation", 28)
	col.add_child(palancas)
	var apoyos: int = Career.pide_cese_apoyos().size()
	palancas.add_child(CareerUi.icon_stat("equipo", "%d/%d" % [
		mini(apoyos, Gerencia.CESE_APOYOS), Gerencia.CESE_APOYOS],
		CareerTheme.accent_text() if apoyos >= Gerencia.CESE_APOYOS
			else CareerTheme.TEXT_DIM, 30.0))
	var racha: int = Career._club_winless
	var r: HBoxContainer = CareerUi.icon_stat("partido", I18n.tf("{0} SIN VICTORIA", [racha]),
		CareerTheme.DANGER if racha >= Gerencia.CESE_RACHA else CareerTheme.TEXT_DIM, 30.0)
	(r.get_child(1) as Label).clip_text = true
	(r.get_child(1) as Label).size_flags_horizontal = Control.SIZE_EXPAND_FILL

	r.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	palancas.add_child(r)
	if vivo:
		var invierno: bool = Career._coach_winter_season != GameState.season_num
		col.add_child(CareerUi.icon_stat("reloj", I18n.t("INVIERNO") if invierno
			else I18n.t("FIN DE TEMPORADA"), CareerTheme.TEXT_DIM, 30.0))
		var riesgo: HBoxContainer = CareerUi.icon_stat("tecnico",
			I18n.t("SI DICE QUE NO, TU TÉCNICO LO SABE"), CareerTheme.DANGER, 30.0)
		(riesgo.get_child(1) as Label).clip_text = true
		(riesgo.get_child(1) as Label).size_flags_horizontal = Control.SIZE_EXPAND_FILL
		col.add_child(riesgo)
	elif motivo.is_empty() and Career.pide_cese_capricho_aplica():
		col.add_child(CareerUi.coste_fila([["relaciones", Gerencia.DT_CAPRICHO]],
			I18n.t("CUMPLE SUS METAS")))
	if not vivo and not motivo.is_empty():
		return
	var b: Button = CareerUi.accion("tecnico", I18n.t("RETIRAR LA PETICION") if vivo
		else I18n.t("PEDIR QUE LO ECHEN"), CareerTheme.DANGER, vivo)
	b.pressed.connect(func() -> void:
		UiAudio.toggle(not vivo)
		Career.pide_cese_pon())
	col.add_child(b)





