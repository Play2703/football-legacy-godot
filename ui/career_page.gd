func _wnews_medalla_ancho(j: Dictionary, num: int, chip_px: int = CareerTheme.T_CAP_TUMBADO) -> float:
	if j.is_empty() or int(j.get("ovr", 0)) <= 0:
		return 0.0
	var w: float = ceilf(float(num) * 2.5)
	var pos: String = String(j.get("pos", ""))
	if not pos.is_empty():
		w += 8.0 + _wnews_ancho(CareerUi.pos_rotulo(pos), chip_px) + 16.0 + 4.0
	return w



