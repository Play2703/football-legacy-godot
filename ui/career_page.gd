const _ChefCasa := preload("res://ui/house/chef_casa.gd")
const _StaffCasa := preload("res://ui/house/staff_casa.gd")
static var _personal_cuadros: Dictionary = {}

static var _personal_crudos: Dictionary = {}

var _personal_esperan: Array = []
var _personal_horneando: bool = false



const PERSONAL_HORNO_US: int = 2500









func _personal_retrato(quien: String) -> Control:
	var tr: TextureRect = TextureRect.new()


	tr.custom_minimum_size = Vector2(132, 210)
	tr.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tr.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if not _personal_cuadros.has(quien):
		var sf: SpriteFrames = _ChefCasa.hechos() if quien == "chef" \
				else _StaffCasa.hechos(quien)
		if sf != null and sf.has_animation("idle_south"):
			var texs: Array = []
			for i in sf.get_frame_count("idle_south"):
				texs.append(sf.get_frame_texture("idle_south", i))
			_personal_listo(quien, texs)
	if _personal_cuadros.has(quien):
		_personal_anima(tr, quien)
	else:
		_personal_esperan.append([tr, quien])
		if not _personal_horneando:
			_personal_hornea.call_deferred()
	return tr





func _personal_listo(quien: String, texs: Array) -> void:
	var marco: Rect2i = Rect2i()
	var buenos: Array = []
	for tex in texs:
		if tex == null:
			continue


		var r: Rect2i = SceneFade.caja_usada(tex,
			Rect2i(Vector2i.ZERO, Vector2i((tex as Texture2D).get_size())))
		marco = r if marco.size == Vector2i.ZERO else marco.merge(r)
		buenos.append(tex)
	var cuadros: Array = []
	for tex in buenos:
		var at: AtlasTexture = AtlasTexture.new()
		at.atlas = tex
		at.region = Rect2(marco)
		cuadros.append(at)
	_personal_cuadros[quien] = {"cuadros": cuadros,
		"fps": _StaffCasa.RESPIRA_FPS if quien == "nutricionista" else 4.5}
	_personal_crudos.erase(quien)





func _personal_hornea() -> void:
	_personal_horneando = true
	while is_inside_tree():
		var falta: String = ""
		for e in _personal_esperan:
			if not _personal_cuadros.has(String(e[1])):
				falta = String(e[1])
				break
		if falta.is_empty():
			break
		var t0: int = Time.get_ticks_usec()
		while not falta.is_empty() and Time.get_ticks_usec() - t0 < PERSONAL_HORNO_US:
			var hechos: Array = _personal_crudos.get(falta, [])
			if falta == "nutricionista":

				var img: Image = _StaffCasa.nutri_vestida("south")
				for k in _StaffCasa.RESPIRA:
					hechos.append(null if img == null
						else ImageTexture.create_from_image(_StaffCasa.respira(img, k)))
			elif falta == "chef":
				hechos.append(_ChefCasa.cuadro_idle("south", hechos.size()))
			else:
				hechos.append(_StaffCasa.cuadro_entre("south", hechos.size()))
			_personal_crudos[falta] = hechos
			if hechos.size() >= 4:
				_personal_listo(falta, hechos)
				for e in _personal_esperan:
					if String(e[1]) == falta and is_instance_valid(e[0]):
						_personal_anima(e[0] as TextureRect, falta)
				falta = ""
		await get_tree().process_frame
	_personal_esperan = _personal_esperan.filter(func(e: Array) -> bool:
		return is_instance_valid(e[0]) and not _personal_cuadros.has(String(e[1])))
	_personal_horneando = false


func _personal_anima(tr: TextureRect, quien: String) -> void:
	var hecho: Dictionary = _personal_cuadros[quien]
	var cuadros: Array = hecho["cuadros"]
	if cuadros.is_empty():
		return
	tr.texture = cuadros[0]
	if cuadros.size() < 2:
		return
	var reloj: Timer = Timer.new()
	reloj.wait_time = 1.0 / float(hecho["fps"])
	reloj.autostart = true
	var n: Array = [0]
	reloj.timeout.connect(func() -> void:
		n[0] =(int(n[0]) + 1) % cuadros.size()
		tr.texture = cuadros[n[0]])
	tr.add_child(reloj)






func _casa_ir(seccion: String, cajon: int, al_tope: bool) -> void:
	var tope: int = _casa_tope_y()
	_casa_seccion = seccion
