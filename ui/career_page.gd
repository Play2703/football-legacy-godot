func _hc_filas(pais: String) -> Array:
	var clubs: Array = []
	var k: int = 0
	for t in (Teams.all() if pais.is_empty() else Teams.teams_of_country(pais)):
		var id: String = String((t as Dictionary)["id"])
		clubs.append({"club": id, "total": Palmares.total(id), "k": k})
		k += 1
	clubs.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if int(a["total"]) != int(b["total"]):
			return int(a["total"]) > int(b["total"])
		return int(a["k"]) < int(b["k"]))
	var puesto: int = 1
	for i in clubs.size():
		if i > 0 and int(clubs[i]["total"]) < int(clubs[i - 1]["total"]):
			puesto = i + 1
		clubs[i]["puesto"] = puesto
	return clubs





func _hc_heroe_lista(filas: Array) -> Array:
	for f in filas:
		if String((f as Dictionary)["club"]) == GameState.player_team_id:
			return filas
	return _hc_filas("")













func _hc_medidas(filas: Array, ancho: float = 0.0) -> Dictionary:
	var maxk: int = 0
	var maxt: int = 0
	var maxp: int = 1
	var tu: int = -1
	for i in filas.size():
		var d: Dictionary = filas[i]
		if not d.has("club"):
			continue
		var p: Dictionary = Palmares.of(String(d["club"]))
		for kind in Palmares.KINDS:
			maxk = maxi(maxk, int(p.get(kind, 0)))
		maxt = maxi(maxt, int(d.get("total", Palmares.total(String(d["club"])))))
		maxp = maxi(maxp, int(d.get("puesto", 1)))
		if String(d["club"]) == GameState.player_team_id:
			tu = i
	var out: Dictionary = {"pos": _hc_ancho(str(maxp), CareerTheme.T_LEE_TUMBADO),
		"trofeo": maxf(HC_ICONO_CAB, _hc_ancho(str(maxk), CareerTheme.T_LEE_TUMBADO) + 8.0),
		"tot": maxf(_hc_ancho(I18n.t("TOT", "tabla"), CareerTheme.T_CAP_TUMBADO),
			_hc_ancho(str(maxt), CareerTheme.T_DATO_TUMBADO) + 8.0)}
	var suelo: float = float(out["trofeo"])
	if ancho <= 0.0:
		out["trofeo"] = maxf(suelo, HC_COL_TROFEO)
		return out


	var vistos: Array = filas.slice(0, mini(filas.size(), HC_ENTERA_MAX))
	if tu >= vistos.size():
		vistos.append(filas[tu])
	var nombre: float = float(_hc_nombres_w(vistos, "club")[false])


	var sep: float = float(CareerUi.FILA_TUMBADA_SEP)
	var fijo: float = float(CareerUi.FILA_TUMBADA_CANAL) + CareerUi.FILA_TUMBADA_FRANJA \
			+ float(out["pos"]) + HC_ESCUDO + HC_AIRE_ESCUDO + float(out["tot"]) + HC_COLA + sep \
			+ 9.0 * sep
	var cabe: float = floorf((ancho - fijo - nombre) / float(Palmares.KINDS.size()))
	out["trofeo"] = maxf(suelo, minf(HC_COL_TROFEO, cabe))
	return out



func _hc_ancho(texto: String, tam: int) -> float:
	var f: Font = get_theme_font("font", "Label")
	if f == null:
		return float(texto.length() * tam)
	return ceilf(f.get_string_size(texto, HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x)



