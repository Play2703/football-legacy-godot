	var col: VBoxContainer = VBoxContainer.new()
	col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	col.add_theme_constant_override("separation", 2)
	head.add_child(col)
	var name_l: Label = CareerUi.plain(24, CareerTheme.TEXT)
	name_l.text = CareerTheme.caps(String(r["name"]))


	name_l.clip_text = true
	name_l.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	col.add_child(name_l)





	col.add_child(_club_comp_row(String(r["id"]), String(r.get("league", ""))))





	var stamps: HFlowContainer = HFlowContainer.new()
	stamps.add_theme_constant_override("h_separation", 8)
	stamps.add_theme_constant_override("v_separation", 8)
	box.add_child(stamps)




	stamps.add_child(_stamp(String(_rumor_sello(r)[0]), CareerTheme.accent()))

	_ruta_stamps(stamps, r.get("ruta", {}) as Dictionary)


	if not Market.ex_dict_de(r).is_empty():
		stamps.add_child(_stamp(I18n.t("TU EX CLUB"), CareerTheme.accent_text()))
	var snap: Dictionary = Market.club_snapshot(String(r["id"]), GameState.season_num)
	if not snap.is_empty():
		stamps.add_child(_stamp("%s/%d" % [I18n.ordinal(int(snap["league_pos"])),
			int(snap["league_size"])], CareerTheme.TEXT_DIM))
		stamps.add_child(_stamp(_cup_short(String(snap["cup"])), CareerTheme.TEXT_DIM))
	if compacto:





		return
	if nudged:
		var done: Label = CareerUi.plain(20, CareerTheme.accent_text())
		done.text = I18n.t("LE DISTE PIE · APRETARÁ EN LA VENTANA")
		box.add_child(done)
	elif Career.courting_club.is_empty():

		var nudge: Button = CareerUi.accion("contrato_firma", I18n.t("MOSTRAR INTERÉS"),
			CareerTheme.NAV_MUNDO)
		nudge.custom_minimum_size = Vector2(0, 80)
		nudge.pressed.connect(func() -> void:
			_confirm(I18n.tf("¿MOSTRAR INTERÉS EN {0}?", [CareerTheme.caps(String(r["name"]))]),
				I18n.t("Le das pie para que apriete en la próxima ventana. Tu vestuario"
				+ " lo nota: bajan un poco técnico, equipo y afición."),
				I18n.t("LE DOY PIE"), false,
				func() -> void: Career.nudge_club(String(r["id"]))))
		box.add_child(nudge)
		box.add_child(_dismiss_rumor_button(r))
	else:
		var other: Label = CareerUi.dim(box, I18n.t("Ya le diste pie a otro club."))
		other.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
		box.add_child(_dismiss_rumor_button(r))










