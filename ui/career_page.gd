	]




	var my_country: String = Teams.country_of(GameState.player_team_id)
	for t in BallonDor.titulos_tabla(my_country):
		rows.append(["torneos",
			I18n.t(JuegosOlimpicos.pinta(String(BallonDor.TITLE_NAME.get(t, t)))).to_upper(),
			BallonDor.title_pts(String(t), my_country)])

	for a in BallonDor.PREMIOS_TABLA:
		rows.append(["torneos", Competitions.t_demarca(String(a)).to_upper(),
			BallonDor.premio_pts(String(a), my_country)])
	return rows











func _balon_vivo(pt: Array) -> Dictionary:
	if int(pt[0]) <= 0:
		return {}
	var div_hoy: int = GameState.div_of(GameState.player_team_id)
	var you: Dictionary = Career.ballon_year(
		Teams.country_of(GameState.player_team_id), div_hoy)
	you.merge({
		"name": Career.player_name,
		"team": GameState.player_team_id,
		"div": div_hoy,
		"titles": [], "awards": [],
	})
	var ck: String = "%d|%d" % [GameState.season_num, int(pt[0])]
	if String(_balon_live_cache.get("key", "")) != ck:
		_balon_live_cache = {"key": ck, "board": BallonDor.live_board(
			GameState.season_num, you, int(pt[0]), int(pt[1]))}
	return {"board": _balon_live_cache["board"], "you": you}







func _balon_este(raiz: VBoxContainer, vivo: Dictionary, you_rank: int, pt: Array,
		tumbado: bool) -> void:
	var board: Array = vivo.get("board", [])
	if board.is_empty():
		CareerUi.dim(raiz, I18n.t("La votación del año arranca con la primera jornada."))
		return
	var izq: VBoxContainer = raiz
	var der: VBoxContainer = raiz
	if tumbado:
		var cols: Array = _balon_columnas(raiz)
		izq = cols[0]
		der = cols[1]
	_balon_jornada(izq, int(pt[0]), int(pt[1]), tumbado)
	_balon_heroe(izq, board, you_rank, vivo.get("you", {}), tumbado)
	_balon_podio(izq, board, tumbado)
	var filas: Array = []
	for i in range(3, mini(BallonDor.TOP_N, board.size())):
		filas.append({"puesto": i + 1, "e": board[i]})
	var cola: Array = []
	for i in board.size():
		var cand: Dictionary = board[i]
		if bool(cand.get("you", false)) \
				or String(cand.get("team", "")) != GameState.player_team_id:
			continue
		if i >= BallonDor.TOP_N:
			cola.append({"puesto": i + 1, "e": cand})
		break
	if you_rank > BallonDor.TOP_N:
		cola.append({"puesto": you_rank, "e": board[you_rank - 1]})
	filas = _balon_con_cola(filas, cola, BALON_TOPE_ESTE if tumbado else 0)
	if not filas.is_empty():
		_balon_lista(der, filas, 56.0 if tumbado else 64.0)
	_balon_chico(der, pt, tumbado)





func _balon_con_cola(filas: Array, cola: Array, tope: int) -> Array:
	cola.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a["puesto"]) < int(b["puesto"]))
	var out: Array = filas
	if tope > 0 and filas.size() + cola.size() > tope:
		out = filas.slice(0, maxi(tope - cola.size(), 0))
	return out + cola



