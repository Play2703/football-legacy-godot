func _pl_t_nombre_cabe(texto: String, l: Label, ancho: float) -> String:
	var f: Font = l.get_theme_font("font")
	var px: int = l.get_theme_font_size("font_size")
	var t: String = texto
	while f != null and t.length() > 3 \
			and f.get_string_size(t, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x > ancho:
		t = t.left(t.length() - 1)
	return t




func _pl_t_abre(i: int, slot: String) -> void:
	var d: Dictionary = _pl_t_datos
	if d.is_empty():
		return
	var carta: Callable = d["carta"]
	if not carta.is_valid():
		return
	var pc: PlayerCard = carta.call(i, slot)
	if pc == null:
		return
	var cb: Callable = pc.tap_cb
	pc.free()
	if cb.is_valid():
		cb.call()



func _pl_t_filas_cancha() -> Array:
	var filas: Array = []
	for linea in PL_T_LINEAS:
		var fila: Array = []
		for j in _pl_t_fichas.size():
			var b: Button = _pl_t_fichas[j]
			if is_instance_valid(b) and String(b.get_meta("pl_t_linea", "")) == linea:
				fila.append(j)
		if fila.is_empty():
			continue
		fila.sort_custom(func(a: int, c: int) -> bool:
			return _pl_t_fichas[a].global_position.x < _pl_t_fichas[c].global_position.x)
		filas.append(fila)
	return filas



func _pl_t_vecina(j: int, dir: String) -> int:
	var filas: Array = _pl_t_filas_cancha()
	for r in filas.size():
		var fila: Array = filas[r]
		var c: int = fila.find(j)
		if c < 0:
			continue
		if dir == "ui_left":
			return int(fila[c - 1]) if c > 0 else -1
		if dir == "ui_right":
			return int(fila[c + 1]) if c + 1 < fila.size() else -1
		var r2: int = r - 1 if dir == "ui_up" else r + 1
		if r2 < 0 or r2 >= filas.size():
			return -1
		var x: float = _pl_t_fichas[j].get_global_rect().get_center().x
		var mejor: int = -1
		var dist: float = INF
		for k in filas[r2]:
			var dx: float = absf(_pl_t_fichas[int(k)].get_global_rect().get_center().x - x)
			if dx < dist:
				dist = dx
				mejor = int(k)
		return mejor
	return -1


func _pl_t_cruceta(ev: InputEvent, j: int) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO:
		return
	if j < 0 or j >= _pl_t_fichas.size():
		return
	var b: Button = _pl_t_fichas[j]
	var dir: String = ""
	for a in ["ui_left", "ui_right", "ui_up", "ui_down"]:
		if ev.is_action_pressed(String(a), true):
			dir = String(a)
			break
	if dir.is_empty():
		return
	b.accept_event()
	var v: int = _pl_t_vecina(j, dir)
	if v >= 0:
		_pl_t_elige(v)
	elif dir == "ui_right":
		_pl_t_salta_derecha()
	elif dir == "ui_left" and _pl_t_ambito_boton != null and is_instance_valid(_pl_t_ambito_boton) \
			and _pl_t_ambito_boton.is_visible_in_tree():
		_pl_t_ambito_boton.grab_focus()


func _pl_t_elige(a: int, enfoca: bool = true) -> void:
	if a < 0 or a >= _pl_t_fichas.size():
		return
	for j in _pl_t_fichas.size():
		var b: Button = _pl_t_fichas[j]
		if is_instance_valid(b):
			b.focus_mode = Control.FOCUS_ALL if j == a else Control.FOCUS_NONE
	_pl_t_elegida = a
	if enfoca:
		_pl_t_fichas[a].grab_focus()



func _pl_t_salta_derecha() -> void:
	if _pl_t_banca_elegida >= 0 and _pl_t_banca_elegida < _pl_t_filas_banca.size():
		var f: Button = _pl_t_filas_banca[_pl_t_banca_elegida]
		if is_instance_valid(f) and f.is_visible_in_tree():
			f.grab_focus()
			return
	var caja: Control = _content.find_child("Plantel", true, false) as Control
	var der: Control = caja.find_child("Derecha", false, false) as Control if caja != null else null
	if der == null:
		return
	for h in der.find_children("*", "BaseButton", true, false):
		if Entrada.enfocable(h):
			(h as Control).grab_focus()
			return




