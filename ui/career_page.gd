			floorf(lado /(WNEWS_FACE_W * 0.5)) if lado > 0.0 else 0.0)
		if cara != null:
			return [cara]
	if kind == "sorpresa":



		var ganador: Control = _wnews_crest(club, px)
		var perdedor: Control = _wnews_crest(str(f.get("club2", "")), px * 0.72)
