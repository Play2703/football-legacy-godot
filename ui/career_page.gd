	return b



func _pf_t_coste(key: String) -> Dictionary:
	var cost: int = Career.point_cost(key)
	var tope: int = Career.skill_tope(key)
	var topada: bool = int(Career.skills[key]) >= tope and tope < Career.SKILL_CAP
	var caro: bool =(cost > 1 and int(Career.skills[key]) < tope) or topada
	return {"cost": cost, "tope": tope, "topada": topada,
		"puede": Career.skill_points >= cost and int(Career.skills[key]) < tope,
		"sub":(I18n.tf("TOPE {0}", [tope]) if topada else I18n.tf("{0} PUNTOS", [cost])) if caro else "",
		"col_sub": CareerTheme.TEXT_DIM if Career.skill_points < cost else CareerTheme.accent_text()}



