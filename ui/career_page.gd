func _ti_t_dock_eleccion(inf: Dictionary) -> void:
	var cab: HBoxContainer = HBoxContainer.new()
	cab.add_theme_constant_override("separation", 16)
	cab.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_ti_t_dock.add_child(cab)
	var arte: Control = _dock_icono(inf)
	arte.custom_minimum_size = Vector2(56.0, 56.0)
	arte.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	cab.add_child(arte)
	var t: Label = _mk_t_label(CareerTheme.T_DATO_TUMBADO, CareerTheme.TEXT,
		CareerTheme.caps(String(inf["title"])))
	t.name = "DockTitulo"
	t.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	t.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	cab.add_child(t)
	CareerUi.letra_por_peldanos(t, [CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO])
	var tag: Dictionary = inf.get("tag", {})
	if not tag.is_empty():
		var chip: PanelContainer = CareerUi.code_chip(CareerTheme.caps(String(tag["text"])),
			CareerTheme.TEXT, CareerTheme.T_CAP_TUMBADO, 10.0, 4.0)
		chip.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		_ti_t_dock.add_child(chip)
	for linea in inf.get("dock", []):
		_ti_t_dock_linea(String(linea))
	if inf.has("line") and not (inf.get("dock", []) as Array).has(inf["line"]):
		_ti_t_dock_linea(String(inf["line"]), inf.get("line_color", CareerTheme.TEXT_MID))
	var stats: PackedStringArray = PackedStringArray()
	for s in inf.get("stats", []):
		var st: Dictionary = s
		var v: Variant = st.get("value", 0)
		var txt: String = str(v)
		if v is int or v is float:
			txt =("+" if float(v) > 0.0 else "") + str(v) + String(inf.get("suffix", ""))
		stats.append("%s %s" % [I18n.t(String(st["label"])), txt])
	if not stats.is_empty():
		_ti_t_dock_linea(" · ".join(stats), CareerTheme.TEXT)
	if inf.has("bar"):
		var barra: ColorRect = CareerUi.bar(_ti_t_dock, CareerTheme.TEXT,
			8.0)
		barra.custom_minimum_size.x = floor(_ti_t_dock.custom_minimum_size.x
			* clampf(float(inf["bar"]), 0.0, 1.0))
		barra.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	if inf.has("state") and not (inf.get("dock", []) as Array).has(inf["state"]):
		_ti_t_dock_linea(String(inf["state"]),
			CareerTheme.DANGER if inf.has("falta") else CareerTheme.TEXT_MID)
	_ti_t_dock_hueco()
	var cta: Dictionary = inf.get("cta", {})
	if inf.has("ghost") and (cta.is_empty() or not bool(cta.get("ok", false))):
		var g: Dictionary = inf["ghost"]
		var gb: Button = CareerUi.accion(String(g["icon"]), String(g["text"]), g["col"] as Color)
		gb.name = "Fantasma"
		gb.custom_minimum_size = Vector2(0.0, CareerTheme.TOQUE_TUMBADO)
		gb.pressed.connect(g["do"] as Callable)
		_ti_t_dock.add_child(gb)
		return
	if cta.is_empty():
		return
	var b: Button = Button.new()
	b.name = "Pagar"
	b.text = String(cta["text"])
	b.custom_minimum_size = Vector2(0.0, CareerTheme.TOQUE_PRINCIPAL_TUMBADO)
	b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	b.clip_text = true
	b.disabled = not bool(cta.get("ok", false))
	CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL if bool(cta.get("money", false))
		else CareerTheme.Kind.PRIMARY, CareerTheme.T_DATO_TUMBADO)
	if bool(cta.get("money", false)):
		UiKit.set_cue(b, "ui_coin")
		_cifra_dorada(b)
	if b.disabled:
		UiKit.deny_tap(b)
	else:
		b.pressed.connect(_shop_pagar.bind(inf))
	_ti_t_dock.add_child(b)




func _ti_t_dock_reposo() -> void:
	match _shop_tab:
		"consumibles":
			_ti_t_dock_titulo(I18n.t("TUS COSAS"))
			var filas: Array[Dictionary] = []
			for it in Shop.ITEMS:
				var iid: String = String((it as Dictionary)["id"])
				var have: int = int(Career.stock.get(iid, 0))
				if have <= 0:
					continue
				var motivo: String = Career.item_block_reason(iid)
				var espera_it: int = Career.item_wait(iid)
				var sub: String = ""
				if not motivo.is_empty():
					sub = I18n.tf("EN {0} {1}", [espera_it,
						I18n.plural(espera_it, "PARTIDO", "PARTIDOS")]) if espera_it > 0 \
								else I18n.t(motivo)
				filas.append({"id": iid, "titulo": I18n.t(String((it as Dictionary)["name"])),
					"icono": Shop.icon_of(it as Dictionary, "consumible"), "foto": iid,
					"chip": "x%d" % have, "chip_col": CareerTheme.accent_text(),
					"precio": I18n.t("USAR") if motivo.is_empty() else sub,
					"precio_col": CareerTheme.TEXT if motivo.is_empty() else CareerTheme.TEXT_DIM,
					"apagada": not motivo.is_empty(),
					"al_tocar": func() -> void:
						if Career.use_item(iid):
							_refresh()})
			if filas.is_empty():
				_ti_t_dock_linea(I18n.t("NO TIENES NADA GUARDADO"))
			else:
				_ti_t_dock_filas(filas, I18n.t("TUS COSAS"))
		"estilo":
			_ti_t_dock_titulo(I18n.t("TU TREN DE VIDA"))
			var upkeep: int = Career.upkeep_total()
			_ti_t_dock_linea(I18n.tf("MANTENIMIENTO  -${0} / PARTIDO", [CareerUi.money(upkeep)])
				if upkeep > 0 else I18n.t("SIN MANTENIMIENTO"),
				CareerTheme.DANGER if upkeep > 0 else CareerTheme.TEXT_MID)
			_ti_t_dock_linea(I18n.t("TOCA UNA FICHA PARA ELEGIRLA"))
		"inversiones":
			_ti_t_dock_titulo(I18n.t("TU PERSONAL"))
			var actual: Dictionary = Shop.agent_current(Career.agent_level)
			_ti_t_dock_linea(I18n.tf("TE LLEVA: {0}", [I18n.t(String(actual["name"]))])
				if not actual.is_empty() else I18n.t("EL DE SIEMPRE"), CareerTheme.TEXT)
			var n: int = 0
			for v in Shop.INVESTMENTS:
				if Career.has_investment(String((v as Dictionary)["id"])):
					n += 1
			_ti_t_dock_linea(I18n.tf("TIENES {0} DE {1}", [n, Shop.INVESTMENTS.size()]))
