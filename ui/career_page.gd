	return b







func _ft_baldosa_siguiente() -> Button:
	var dia: int = GameState.season_day
	var wd: int = GameState.winter_day()
	var cal: int = GameState.calendar.size()

	var ancla: int = dia
	if not Market.window_open(dia, wd):
		var hasta: int = Market.days_until_open(dia, wd, cal)
		if hasta <= 0 or dia + hasta >= cal:
			return null
		ancla = dia + hasta
	var desde: int = Market.window_last_day(ancla, wd) + 1
	var falta: int = Market.days_until_open(desde, wd, cal)
	if falta <= 0:
		return null
	var abre: int = desde + falta

	var f: Dictionary = Market.fecha_de_jornada(abre if abre < cal else Market.SUMMER_DAY, wd, cal)
	var invierno: bool = abre < cal and abre >= Market.winter_first(wd)
	var b: Button = CareerUi.baldosa_avance("mercado", I18n.t("ABRE"), _ft_color_agente(), null,
		CareerUi.fecha_corta(int(f["dia"]), int(f["mes"])), I18n.tf("{0} J", [abre - dia]),
		CareerTheme.caps(I18n.t("INVIERNO" if invierno else "VERANO")), func() -> void: _on_tab("mercado"))
	b.set_meta("ft_baldosa", "siguiente")
	return b





func _ft_baldosa_club() -> Button:
	var club: String = GameState.player_team_id
	if club.is_empty() or Career.free_agent:
		return null
	var entran: int = 0
	var salen: int = 0
	for m in Career.market_news:
		var d: Dictionary = m
		if int(d.get("season", 0)) != GameState.season_num:
			continue
		if String(d.get("to", "")) == club:
			entran += 1
		elif String(d.get("from", "")) == club:
			salen += 1
	if entran + salen <= 0:
		return null







	var b: Button = CareerUi.baldosa_avance("equipo", "%s·%s" % [I18n.t("ENTRAN"), I18n.t("SALEN")],
		CareerTheme.accent_text(), null, I18n.t("TU CLUB"), "%d·%d" % [entran, salen],
		_ft_desde() if _ft_cortada() else I18n.tf("TEMPORADA {0}", [GameState.season_num]),
		func() -> void:
			_news_scope = "club"
			_refresh())
	b.set_meta("ft_baldosa", "club")
	return b




func _ft_baldosa_gasto() -> Button:
	var pais: String = Teams.country_of(GameState.player_team_id)
	var suma: int = 0
	var pagados: int = 0
	for m in Career.market_news:
		var d: Dictionary = m
		if int(d.get("season", 0)) != GameState.season_num or String(d.get("kind", "")) != "signing" \
				or bool(d.get("free", false)):
			continue
		if (pais.is_empty() or Teams.country_of(String(d.get("to", ""))) == pais) \
				and int(d.get("fee", 0)) > 0:
			suma += int(d.get("fee", 0))
			pagados += 1
	if suma <= 0:
		return null



	var b: Button = CareerUi.baldosa_avance("moneda", I18n.t("GASTO", "carrera"), CareerTheme.MONEY,
		null, I18n.t("TU LIGA"), _money_short(suma), _ft_desde() if _ft_cortada()
		else (I18n.t("1 FICHAJE") if pagados == 1 else I18n.tf("{0} FICHAJES", [pagados])),
		func() -> void:
			_news_scope = "liga"
			_news_tab = "valor"
			_refresh())
	b.set_meta("ft_baldosa", "gasto")
	b.set_meta("ft_gasto", suma)
	return b





