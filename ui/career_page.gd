	if not Career.clausulas_entra_club(_renewal_pack):
		var mesa: Dictionary = Career.clausulas_mesa_club(_renewal_pack)
		_toast(I18n.t(String(mesa.get("why", "SIN MESA ABIERTA"))), CareerTheme.DANGER)
		return
	SceneFade.to_scene("res://ui/ceremonies/pulse.tscn")







func _contract_bonuses() -> void:
	var gb: float = float(Career.contract.get("goal_bonus", 0.0))
	var ab: float = float(Career.contract.get("assist_bonus", 0.0))
	var wage: int = int(Career.contract["wage"])
	var rows: Array = []


	var ps: Array = Career.pacto_puestos(GameState.player_team_id)
	if not ps.is_empty():
		var rot: Array[String] = []
		for pos in ps:
			rot.append(CareerUi.pos_rotulo(String(pos)))
		rows.append(["once", I18n.t("TUS PUESTOS"), "/".join(rot), CareerTheme.TEXT])
	if gb > 0.0:
		rows.append(["gol", I18n.t("PRIMA POR GOL"),
			"+$ %s" % CareerUi.money(int(float(wage) * 0.5 * gb)), CareerTheme.MONEY])
	if ab > 0.0:
		rows.append(["asist", I18n.t("PRIMA POR ASISTENCIA"),
			"+$ %s" % CareerUi.money(int(float(wage) * 0.5 * ab)), CareerTheme.MONEY])




	for k in Clausulas.TITULOS:
		var m: float = Career.prima_titulo_mult(String(k))
		if m > 1.0:
			var n: int = maxi(0, Clausulas.TITULO_MULT.find(m))
			rows.append(["trofeo:" + String(k), I18n.t(ClausulasEditor.NIVELES[n]),
				"+$ %s" % CareerUi.money(ContractTerms.title_bonus(wage, String(k), m)),
				CareerTheme.MONEY])
	if rows.is_empty():
		return
	CareerUi.head(_content, I18n.t("PRIMAS PACTADAS"))
	_chip_grid(rows)











func _reneg_oferta_viva() -> Dictionary:
	if not bool(Career.renegotiation_gate().get("ok", false)) or Career.can_renew() \
			or Career.on_loan():
		return {}
	var o: Dictionary = Career.renegotiation_offer()
	return o if _reneg_improves(o) else {}




func _reneg_improves(o: Dictionary) -> bool:
	return int(o.get("delta", 0)) > 0 or int(o.get("seasons", 0)) > 0 \
			or float(o.get("goal_bonus_add", 0.0)) > 0.0 \
			or float(o.get("assist_bonus_add", 0.0)) > 0.0 \
			or bool(o.get("role_up", false))









func _renegotiation_block(o: Dictionary) -> void:

	if Career.renegotiation_club_offered():
		CareerUi.head(_content, I18n.t("TU CLUB TE MEJORA"))
		CareerUi.dim(_content, I18n.t("Se adelanta a los que vienen a por ti."))
	else:
		CareerUi.head(_content, I18n.t("LO QUE PUEDES PEDIR"))
	var delta: int = int(o["delta"])
	var years: int = int(o["seasons"])
	var wage_new: int = int(o["wage"])
	var rows: Array = [
		["contrato_firma", I18n.t("SUELDO NUEVO"), "$ %s" % CareerUi.money(wage_new),
			CareerTheme.MONEY],
		["jornada", I18n.t("AÑOS QUE SUMAS"),
			("+%d" % years) if years > 0 else I18n.t("NINGUNO"),
			CareerTheme.TEXT if years > 0 else CareerTheme.TEXT_DIM],
	]


	var gadd: float = float(o.get("goal_bonus_add", 0.0))
	var aadd: float = float(o.get("assist_bonus_add", 0.0))
	if gadd > 0.0:
		rows.append(["balon", I18n.t("PRIMA POR GOL"),
			"+$ %s" % CareerUi.money(int(float(wage_new) * 0.5 * gadd)), CareerTheme.MONEY])
	if aadd > 0.0:
		rows.append(["asist", I18n.t("PRIMA POR ASISTENCIA"),
			"+$ %s" % CareerUi.money(int(float(wage_new) * 0.5 * aadd)), CareerTheme.MONEY])
	_chip_grid(rows)
	if delta > 0:
		var d: Label = CareerUi.plain(21, CareerTheme.MONEY)
		d.text = I18n.tf("Tu sueldo sube de $ {0} a $ {1} por partido",
			[CareerUi.money(int(o["wage_now"])), CareerUi.money(wage_new)])
		d.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(d)
	elif delta < 0:


		var d2: Label = CareerUi.plain(21, CareerTheme.DANGER)
		d2.text = I18n.t("Es MENOS de lo que cobras ahora.")
		d2.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(d2)
	if bool(o.get("role_up", false)):
		CareerUi.dim(_content, I18n.tf("Te reconocen como {0}", [String(o["role_name"])]))
	var pct: int = int(o.get("perf_pct", 0))
	if pct > 0:
		var pf: Label = CareerUi.plain(21, CareerTheme.MONEY)
		pf.text = I18n.tf("Por tu temporada: +{0}% sobre el sueldo", [pct])
		pf.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(pf)
	_clausulas_resumen(_content, o)












