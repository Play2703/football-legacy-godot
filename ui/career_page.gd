func _pl_t_pliega() -> void:
	if _pl_t_mas_boton == null or not is_instance_valid(_pl_t_mas_boton) \
			or _pl_t_filas_banca.is_empty():
		return
	var col: Control = _pl_t_mas_boton.get_parent() as Control
	var marco: Control = col.get_parent() as Control if col != null else null
	if marco == null or marco.size.y < 1.0:
		return
	var fijo: float = 0.0
	var n_fijos: int = 0
	for h in col.get_children():
		var c: Control = h as Control
		if c == null or not c.visible or c == _pl_t_mas_boton or c.has_meta("pl_t_fila") \
				or (c.size_flags_vertical&Control.SIZE_EXPAND) != 0:
			continue
		fijo += c.get_combined_minimum_size().y
		n_fijos += 1
	var sep: float = float(PL_T_FILA_SEP)
	var disponible: float = marco.size.y - fijo - sep * float(n_fijos)
	var todas: int = _pl_t_filas_banca.size()
	var paso: float = PL_T_FILA_H + sep
	var cabe_todo: bool = floorf((disponible + sep) / paso) >= float(todas)
	var n: int = todas if cabe_todo else maxi(0, int(floorf((disponible - paso + sep) / paso)))
	for k in todas:
		_pl_t_filas_banca[k].visible = k < n
	_pl_t_mas_boton.visible = not cabe_todo
	if cabe_todo:

		if _pl_t_mas_boton.has_meta(Entrada.PRIMERO_META):
			_pl_t_mas_boton.remove_meta(Entrada.PRIMERO_META)
			for f in _pl_t_filas_banca:
				if f.has_meta("pl_t_yo"):
					f.set_meta(Entrada.PRIMERO_META, true)
		return
	_pl_t_mas_boton.set_meta("pl_t_mas", todas - n)
	var rot: Label = _pl_t_mas_boton.find_child("Rotulo", true, false) as Label
	if rot != null:
		rot.text = CareerTheme.caps("%s · %d" % [I18n.t("MÁS"), todas - n])
	if _pl_t_banca_elegida >= n:
		_pl_t_elige_banca(0 if n > 0 else -1, false)
	for k in range(n, todas):
		var f: Button = _pl_t_filas_banca[k]
		if f.has_meta(Entrada.PRIMERO_META):
			f.remove_meta(Entrada.PRIMERO_META)
			_pl_t_mas_boton.set_meta(Entrada.PRIMERO_META, true)



