func _rank_open_picker(title_text: String, options: Array, current: String,
		on_pick: Callable) -> void:
	var box: VBoxContainer = CareerUi.modal_pantalla(self) if UiKit.es_horizontal() \
			else CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(28, CareerTheme.TEXT)
	t.text = title_text
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	if UiKit.es_horizontal() and options.size() > 40:
		_rank_picker_indice(box, options, current, on_pick)
		return
	var list: VBoxContainer = VBoxContainer.new()
	list.add_theme_constant_override("separation", 6)
	list.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	if options.size() > RANK_PICKER_INLINE_MAX:
		var scroll: DragScroll = DragScroll.new()
		if UiKit.es_horizontal():
			scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
		else:
			scroll.custom_minimum_size = Vector2(0, RANK_PICKER_MAX_H)
		scroll.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		box.add_child(scroll)
		scroll.add_child(list)
	else:
		box.add_child(list)
	for opt in options:
		var id: String = String(opt[0])
		var b: Button = Button.new()
		b.text = String(opt[1])
		UiKit.style_button(b)
		b.custom_minimum_size = Vector2(0, 56)






		if (opt as Array).size() > 2 and Flags.has(String(opt[2])):
			b.icon = Flags.texture(String(opt[2]))
			b.expand_icon = false
			b.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
			b.add_theme_constant_override("h_separation", 14)



		b.clip_text = true
		if id == current:
			var col: Color = CareerNav.FAMILY_COLORS["mundo"]
			b.add_theme_stylebox_override("normal",
				UiKit.make_button_sb(col.darkened(0.55), col, CareerTheme.SINK))
			b.add_theme_color_override("font_color", CareerTheme.TEXT)
		b.pressed.connect(func() -> void:
			CareerUi.close_modal(box)
			on_pick.call(id))
		list.add_child(b)
	var close: Button = Button.new()
	close.text = I18n.t("CERRAR")
	close.custom_minimum_size = Vector2(0, 78)
	CareerTheme.apply_button(close, CareerTheme.Kind.GHOST, 22)
	close.pressed.connect(func() -> void: CareerUi.close_modal(box))
	box.add_child(close)





func _rank_picker_indice(box: VBoxContainer, options: Array, current: String,
		on_pick: Callable) -> void:
	var grid: GridContainer = GridContainer.new()
	grid.columns = 3
	grid.size_flags_vertical = Control.SIZE_EXPAND_FILL
	grid.add_theme_constant_override("h_separation", 12)
	grid.add_theme_constant_override("v_separation", 6)
	var indice: HFlowContainer = HFlowContainer.new()
	indice.add_theme_constant_override("h_separation", 6)
	indice.add_theme_constant_override("v_separation", 6)
	box.add_child(indice)
	var letras: Array[String] = []
	for opt in options:
		if String(opt[0]).is_empty():
			continue
		var letra: String = CareerTheme.inicial(String(opt[1]))
		if not letras.has(letra):
			letras.append(letra)
	letras.sort()
	for letra in letras:
		var b: Button = CareerUi.menu_row(letra, "")
		b.custom_minimum_size = Vector2(56.0, 56.0)
		b.pressed.connect(_rank_picker_prefijo.bind(letra, grid, options, current, on_pick, box))
		indice.add_child(b)
	var busca: LineEdit = CareerUi.campo("", 64, I18n.t("BUSCAR"))
	busca.custom_minimum_size.y = 56.0
	box.add_child(busca)
	busca.text_changed.connect(_rank_picker_prefijo.bind(grid, options, current, on_pick, box))
	box.add_child(grid)
	_rank_picker_prefijo(letras[0] if not letras.is_empty() else "", grid,
		options, current, on_pick, box)
	var cerrar: Button = CareerUi.menu_row(I18n.t("CERRAR"), "")
	cerrar.pressed.connect(CareerUi.close_modal.bind(box))
	box.add_child(cerrar)


func _rank_picker_prefijo(prefijo: String, grid: GridContainer, options: Array,
		current: String, on_pick: Callable, box: VBoxContainer) -> void:
	if not is_instance_valid(grid):
		return
	for hijo in grid.get_children():
		grid.remove_child(hijo)
		hijo.queue_free()
	var clave: String = CareerTheme.deaccent(prefijo.strip_edges().to_upper())
	if clave.is_empty():
		clave = "A"
	for opt in options:
		var id: String = String(opt[0])
		if not id.is_empty() and not CareerTheme.empieza_por(String(opt[1]), clave):
			continue
		var b: Button = Button.new()
		b.text = String(opt[1])
		b.clip_text = true
		b.custom_minimum_size.y = 56.0
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		CareerTheme.apply_button(b, CareerTheme.Kind.PRIMARY if id == current \
				else CareerTheme.Kind.NEUTRAL, CareerTheme.T_DIM)
		if (opt as Array).size() > 2 and Flags.has(String(opt[2])):
			b.icon = Flags.texture(String(opt[2]))
			b.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
		b.pressed.connect(_rank_picker_elije.bind(id, on_pick, box))
		grid.add_child(b)
	CareerUi.normalize_caps(grid)


func _rank_picker_elije(id: String, on_pick: Callable, box: VBoxContainer) -> void:
	CareerUi.close_modal(box)
	on_pick.call(id)








