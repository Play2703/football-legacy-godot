		pend_l.clip_text = true
		cifra.add_child(pend_l)
	bloque.add_child(plus)
	_skill_bits[key] = {"val": val_l, "plus": plus}
	if animar:




		UiKit.punch.call_deferred(val_l)



















func _festejar_punto(key: String, ovr_antes: int) -> void:
	if Settings.reduce_motion:
		return
	if Career.ovr_shown() > ovr_antes and is_instance_valid(_header):
		_header.celebrar_media()
	var bits: Dictionary = _skill_bits.get(key, {}) as Dictionary
	var val_l: Control = SceneFade.vivo(bits.get("val", null)) as Control
	if val_l == null or not is_instance_valid(val_l) or not val_l.is_inside_tree():
		return
	var l: Label = CareerUi.plain(CareerTheme.T_CAPTION,
		CareerUi.SKILL_ICON_COL.get(key, CareerTheme.accent_text()))
	l.text = "+1"
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	l.z_index = 20


	l.top_level = true
	val_l.add_child(l)
	l.global_position = val_l.global_position + Vector2(val_l.size.x - 26.0, -4.0)
	var t: Tween = l.create_tween()
	t.set_parallel(true)
	t.tween_property(l, "global_position",
			l.global_position + Vector2(0.0, -38.0), 0.75) \
					.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	t.tween_property(l, "modulate:a", 0.0, 0.75).set_delay(0.3)
	t.chain().tween_callback(l.queue_free)







