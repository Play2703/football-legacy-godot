func _alto_de_texto(l: Label, px: int, max_lineas: int) -> void:
	var ajusta: Callable = func() -> void:
		var f: Font = l.get_theme_font("font")
		if f == null:
			return
		var ancho: float = f.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT,
			-1, px).x
		var hueco: float = maxf(l.size.x, 1.0)
		var n: int = clampi(int(ceilf(ancho / hueco)), 1, max_lineas)
		var alto: float = ceilf(f.get_height(px) * float(n))


		if not is_equal_approx(l.custom_minimum_size.y, alto):
			l.custom_minimum_size.y = alto
	ajusta.call()
	l.resized.connect(ajusta)







