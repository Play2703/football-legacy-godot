func _hc_campeones() -> void:
	var pais: String = _hc_pais_campeones()
	var filas: Array = []
	var con_torneos: bool = false
	for r in Palmares.league_rows(pais, Career.league_history):
		var d: Dictionary = r
		var ap: String = str(d.get("champion_ap", ""))
		filas.append({"season": int(d.get("season", 0)), "campeon": str(d.get("champion", "")),
			"sub": str(d.get("runner_up", "")), "torneo": "CLAUSURA" if not ap.is_empty() else ""})
		if not ap.is_empty():
			con_torneos = true
			filas.append({"season": int(d.get("season", 0)), "campeon": ap,
				"sub": str(d.get("runner_up_ap", "")), "torneo": "APERTURA"})
	var titulo: String = "%s · %s" % [I18n.t("CAMPEONES"), CareerTheme.caps(I18n.t(pais))]
	var pinta: Callable = _hc_pinta_campeon.bind(con_torneos, _hc_nombres_w(filas, "campeon"),
		_hc_nombres_w(filas, "sub"))
	var box: VBoxContainer = null
	if filas.size() > HC_CAMPEONES_CARTA:
		box = CareerUi.lista_entera_modal(self, titulo, filas, [], CareerTheme.NAV_LEGADO, pinta)
	else:
		box = _hc_carta(titulo, filas, pinta)
	if box != null:
		box.set_meta("hc_campeones_modal", Palmares.league_rows(pais, Career.league_history).size())






func _hc_carta(titulo: String, filas: Array, pinta: Callable, alto: float = 40.0,
		cab: Control = null) -> VBoxContainer:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		if cab != null:
			cab.free()
		return null

	var caja: VBoxContainer = VBoxContainer.new()
	caja.name = "CampeonesCaja"
	caja.add_theme_constant_override("separation", 16)
	box.add_child(caja)
	var t: Label = CareerUi.plain(CareerTheme.T_DATO_TUMBADO, CareerTheme.NAV_LEGADO)
	t.text = CareerTheme.caps(titulo)
	t.clip_text = true
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	caja.add_child(t)


	CareerUi.letra_por_peldanos(t, [CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO])
	if cab != null:
		caja.add_child(cab)
	var lista: VBoxContainer = VBoxContainer.new()
	lista.name = "Filas"
	lista.add_theme_constant_override("separation", 0)
	lista.set_meta("fl_lista", "campeones" if cab == null else "top")
	caja.add_child(lista)
	for i in filas.size():
		var f: Control = pinta.call(i, filas[i], Color.TRANSPARENT, alto) as Control
		f.size_flags_vertical = Control.SIZE_FILL
		f.set_meta("fl_fila", true)
		lista.add_child(f)
	var cerrar: Button = CareerUi.accion("cerrar", I18n.t("CERRAR"), CareerTheme.TEXT_MID)
	cerrar.custom_minimum_size.y = CareerTheme.TOQUE_TUMBADO
	cerrar.pressed.connect(func() -> void: CareerUi.close_modal(box))
	caja.add_child(cerrar)
	return box


