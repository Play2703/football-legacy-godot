func _reloj_cap(base: String, jornada: int, wd: int, cal: int) -> String:
	if jornada < 0:
		return base
	var f: Dictionary = Market.fecha_de_jornada(jornada, wd, cal)
	var txt: String = CareerUi.fecha_corta(int(f["dia"]), int(f["mes"]))
	return base if txt.is_empty() else "%s · %s" % [base, txt]



