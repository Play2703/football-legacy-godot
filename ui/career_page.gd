func _torn_continental(comp: String, key: String, state: Dictionary, accent: Color) -> void:
	var playing: bool = bool(state.get("playing", false))
	var amer: bool = Continental.es_americana(key)


	var camino: Dictionary = {} if amer or not playing else GameState.europa_camino(key)
	if not camino.is_empty():
		_torn_previa(camino, state)
	elif playing:






		var ko: Array = state.get("bracket", [])
		var liga_fase: bool = bool(state.get("league_phase", false))
		if _torn_capturando and bool(state.get("advanced", false)) and not ko.is_empty() \
				and (liga_fase or not (state.get("groups", []) as Array).is_empty()):



			_torn_camino(ko, state.get("ko_names", []), accent, int(state.get("ko_idx", 0)),
				bool(state.get("alive", true)), bool(state.get("champion", false)),
				String(state.get("comp", key)), "ko_idx")
			if liga_fase:
				_torn_fase_baldosa(state, accent)
			else:
				_torn_grupos_baldosa(state, accent)
		else:
			if amer:
				_amer_previa(state, key, accent)
			_cont_groups(state, amer, accent)
		_torn_cuadro(state.get("bracket", []), state.get("ko_names", []), accent)

		if _torn_capturando:
			_torn_heroe_euro(state)
		elif bool(state.get("champion", false)):
			var c: Label = CareerUi.plain(24, CareerTheme.MONEY)
			c.text = I18n.t("¡CAMPEÓN!")
			_content.add_child(c)
		elif not bool(state.get("alive", true)):
			var o: Label = CareerUi.plain(20, CareerTheme.DANGER)
			o.text = I18n.t("Eliminado") if bool(state.get("advanced", false)) \
					else _fuera_previa_text(state)
			_content.add_child(o)
	else:







		if not String(state.get("fuera", "")).is_empty() and (amer or GameState.previas_vivas()):
			if amer:
				_amer_previa(state, key, accent)
			if _torn_capturando:
				_torn_apunta_heroe(CareerTheme.caps(I18n.t("ELIMINADO")), I18n.t("PREVIA"))
			else:
				var fuera: Label = CareerUi.plain(20, CareerTheme.DANGER)
				fuera.text = I18n.t("Eliminado")
				fuera.clip_text = true
				_content.add_child(fuera)
		elif not _torn_capturando:
			_torn_nota(I18n.t("No la juegas esta temporada — así va en el mundo."))









		var proj: Dictionary
		if amer:
			proj = GameState.amer_proyectado(key, GameState.season_num, _world_upto())
		else:
			proj = EURO_SIM.simulate(key, _euro_field_of(comp),
				GameState.season_num, _world_upto())
		if proj.is_empty():
			_torn_nota(I18n.t("Sin datos de esta competición todavía.") if amer
				else I18n.t("Sin campo europeo esta temporada."))
		else:
			if amer and String(state.get("fuera", "")).is_empty():
				_amer_previa(proj, key, accent)
			_cont_groups(proj, amer, accent)
			_torn_cuadro(proj.get("bracket", []), proj.get("ko_names", []), accent)


			_torn_heroe_fase(proj)
			_projected_champion(String(proj.get("winner", "")), accent)


	var raw: Array = []
	var yg: float = 0.0
	var ya: float = 0.0
	match key:
		"ucl":
			raw = Career.ucl_race() if playing else Race.ucl(GameState.season_num)
			yg = float(Career.season_goals_ucl)
			ya = float(Career.season_assists_ucl)
		"eul":
			raw = Career.eul_race() if playing else Race.eul(GameState.season_num)
			yg = float(Career.season_goals_eul)
			ya = float(Career.season_assists_eul)
		"conf":
			raw = Career.conf_race() if playing else Race.conf(GameState.season_num)
			yg = float(Career.season_goals_conf)
			ya = float(Career.season_assists_conf)




		"lib":
			raw = Career.lib_race()
		"sud":
			raw = Career.sud_race()
		"cca":
			raw = Career.cca_race()
		"ace", "ac2":
			raw = Career.cont_race(key)
		"caf", "cf2", "ofc":
			raw = Career.cont_race(key)
	if amer:
		yg = float(Career.season_comp(key, "g"))
		ya = float(Career.season_comp(key, "a"))
	var race: Array = _torn_build_race(raw, playing, key)


	_torn_race_tables(race, playing, yg, ya, Career.season_avg_year(), accent,
		Career.season_matches_in(key))





func _euro_field_of(comp: String) -> Array:
	match comp:
		"champions":
			return GameState.ucl_field(GameState.UCL_FIELD)
		"europa":
			return GameState.eul_field(GameState.EUL_FIELD)


		"libertadores", "sudamericana", "concacaf", "oriente", "sol", "atlas", "baobab", "coral":
			return GameState.amer_field(Continental.comp_de_marca(comp))
		_:
			return GameState.conf_field(GameState.CONF_FIELD)







