func _look_mirror_switch() -> void:
	var vistas: Array[String] = ["fisico", "uniforme", "casual", "gala"]
	var rotulos: Array = []
	for r in ["FISICO", "UNIFORME", "CASUAL", "Gala"]:
		rotulos.append(CareerTheme.caps(I18n.t(r)))
	var host: Container = _content
	var ancho: float = 0.0
	if _look_mando != null and is_instance_valid(_look_mando):
		for child in _look_mando.get_children():
			_look_mando.remove_child(child)
			child.queue_free()
		host = VBoxContainer.new()
		host.add_theme_constant_override("separation", 8)
		_look_mando.add_child(host)

		ancho = get_viewport_rect().size.x - 68.0
	var al_tocar: Callable = func(i: int) -> void:
		if _look_tab == vistas[i]:
			return
		_look_tab = vistas[i]

		_look_zoom_alterno = false
		_look_hoja_nueva()
	var cats: Array = LookEditor.categorias(_look_tab)






	if UiKit.es_horizontal() and host != _content:
		var fila: HBoxContainer = HBoxContainer.new()
		fila.add_theme_constant_override("separation", 20)
		host.add_child(fila)
		var izq: VBoxContainer = VBoxContainer.new()
		fila.add_child(izq)
		LookEditor.pestanas_vista(izq, vistas, _look_tab, al_tocar, true)
		var raya: ColorRect = ColorRect.new()
		raya.color = CareerTheme.SURFACE_LINE
		raya.custom_minimum_size = Vector2(2, 0)
		fila.add_child(raya)
		host = VBoxContainer.new()
		host.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		fila.add_child(host)
	else:
		host.add_child(CareerUi.segmented(rotulos, vistas.find(_look_tab), al_tocar, 0.0,
			ancho))


	if cats.is_empty():
		return
	var tabs: Array = []
	for c in cats:
		tabs.append({"icon": String(c["icono"]), "label": I18n.t(String(c["rotulo"]))})
	var actual: String = _look_cat_actual()
	var idx: int = 0
	for i in cats.size():
		if String(cats[i]["id"]) == actual:
			idx = i
	CareerUi.icon_tabs(host, tabs, idx, func(i: int) -> void:
		_look_cat[_look_tab] = String(cats[i]["id"])
		_look_zoom_alterno = false
		_look_hoja_nueva())



func _look_cat_actual() -> String:
	var c: Dictionary = LookEditor.categoria_de(_look_tab, String(_look_cat.get(_look_tab, "")))
	return String(c.get("id", ""))





func _look_sub_actual() -> String:
	var cat: String = _look_cat_actual()
	var clave: String = "%s/%s" % [_look_tab, cat]
	if _look_sub.has(clave):
		return String(_look_sub[clave])
	if _look_tab == "fisico" and cat == "corte":
		var tuyo: String = str(GameState.team_custom.get("modular_hair", "none"))

		var grupos: Dictionary = KitRecolor.PIEZAS_PROPIAS.hair_groups()
		for largo in ["medium", "long"]:
			if (grupos.get(largo, []) as Array).has(tuyo):
				return "mediano" if largo == "medium" else "largo"
		return "corto"
	return String(LookEditor.sub_de(LookEditor.categoria_de(_look_tab, cat), "").get("id", ""))




func _look_hoja_nueva() -> void:
	_refresh()
	if _scroll != null:
		_scroll.scroll_vertical = 0



func _look_abre(vista: String, cat: String = "", sb: String = "") -> void:
	_look_tab = vista
	if not cat.is_empty():
		_look_cat[vista] = cat
	if not sb.is_empty():
		_look_sub["%s/%s" % [vista, _look_cat_actual()]] = sb
	_look_zoom_alterno = false
	_look_hoja_nueva()






func _look_subfichas(nota: Label = null) -> void:
	var c: Dictionary = LookEditor.categoria_de(_look_tab, _look_cat_actual())
	var subs: Array = c.get("subs", [])
	if subs.is_empty():
		return
	var rotulos: Array = []
	var idx: int = 0
	var actual: String = _look_sub_actual()
	for i in subs.size():
		rotulos.append(CareerTheme.caps(I18n.t(String(subs[i]["rotulo"]))))
		if String(subs[i]["id"]) == actual:
			idx = i
	var clave: String = "%s/%s" % [_look_tab, String(c["id"])]
	var al_tocar: Callable = func(i: int) -> void:
		_look_sub[clave] = String(subs[i]["id"])
		_look_zoom_alterno = false
		_look_hoja_nueva()




	if UiKit.es_horizontal():
		var fila: HBoxContainer = HBoxContainer.new()
		fila.add_theme_constant_override("separation", 16)
		_content.add_child(fila)
