func _vitrina_de(fam: String, id: String) -> void:
	if _shop_band == null or not is_instance_valid(_shop_band) \
			or not _shop_band.has_method("show_item"):
		return
	var inf: Dictionary = _shop_infos.get(id, {}) if not id.is_empty() else {}
	if inf.is_empty() or inf.has("merch"):
		_shop_band.show_item({})
		return
	var of: Dictionary = _oferta()
	var oferta: bool = String(of.get("id", "")) == id and String(of.get("tab", "")) == fam
	_shop_band.show_item({"icon": String(inf.get("icon", "")),
