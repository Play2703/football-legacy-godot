func _finish_tile(a: Dictionary, zona: String) -> Control:
	var id: String = String(a["id"])
	var owned: bool = House.acabado_owned(id, Career.house_finishes)
	var puesto: bool = String(Career.house_finish.get(zona,
		House.ACABADO_BASE[zona])) == id
	var price: int = int(a.get("price", 0))
	var b: Button = Button.new()



	b.custom_minimum_size = Vector2(300, 250)



	if puesto:
		CareerTheme.apply_button(b, CareerTheme.Kind.PRIMARY, 20)
	else:
		CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, 20)



	var row: VBoxContainer = VBoxContainer.new()
	row.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	row.offset_left = 12.0
	row.offset_right = -12.0
	row.offset_top = 10.0
	row.offset_bottom = -10.0
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_theme_constant_override("separation", 6)
	b.add_child(row)
	row.add_child(_finish_retrato(a, zona))
	var txt: VBoxContainer = VBoxContainer.new()
	txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	txt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	txt.add_theme_constant_override("separation", 0)
	row.add_child(txt)
	var nl: Label = CareerUi.plain(20, CareerTheme.TEXT)
	nl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	nl.text = I18n.t(String(a["name"]))


	nl.clip_text = true
	nl.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	nl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	txt.add_child(nl)
	var el: Label = CareerUi.plain(16, CareerTheme.TEXT_DIM)
	if puesto:




		el.text = I18n.t("EN USO")
		el.add_theme_color_override("font_color", CareerTheme.on_accent())
	elif owned:
		el.text = I18n.t("TUYO")
	else:
		el.text = CareerUi.money(price)
		el.add_theme_color_override("font_color", CareerTheme.MONEY)
	el.clip_text = true
	el.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	el.mouse_filter = Control.MOUSE_FILTER_IGNORE
	txt.add_child(el)



	if puesto:
		b.disabled = true
	elif owned:
		b.pressed.connect(func() -> void:
			if Career.equip_finish(id):
				_refresh_keeping_scroll())
	else:




		b.pressed.connect(func() -> void: _acabado_prueba(a, zona))
	return b












func _acabado_prueba(a: Dictionary, zona: String) -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	var id: String = String(a["id"])
