func _cal_t_fecha(f: Dictionary) -> String:
	var partes: Array[String] = []
	var dia: int = int(f["dia"])
	if CalendarioMundo.dia_conocido(dia):

		partes.append(CareerTheme.caps(I18n.t(CAL_DIAS[posmod(dia, 7)], "dia")))
	var mes: int = int(f["mes"])
	if mes >= 1 and mes <= 12:
		partes.append(CareerTheme.caps(I18n.t(CareerUi.MESES[mes - 1])))
	return " · ".join(partes)






func _cal_t_cruceta(ev: InputEvent, i: int) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO:
		return
	var a: int = i
	if ev.is_action_pressed("ui_left", true):
		a = i - 1
	elif ev.is_action_pressed("ui_right", true):
		a = i + 1
	else:
		return
	if a < 0 or a >= _cal_t_botones.size():
		_cal_t_botones[i].accept_event()
		return
	_cal_t_elige(a)
	_cal_t_botones[i].accept_event()



func _cal_t_elige(a: int) -> void:
	if a < 0 or a >= _cal_t_botones.size():
		return
	for i in _cal_t_botones.size():
		var b: Button = _cal_t_botones[i]
		if not is_instance_valid(b):
			continue
		b.focus_mode = Control.FOCUS_ALL if i == a else Control.FOCUS_NONE
	_cal_t_elegida = a
	_cal_t_botones[a].grab_focus()





