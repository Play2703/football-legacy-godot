	var t: Label = CareerUi.plain(CareerTheme.T_TITLE_MODAL, CareerTheme.TEXT)
	t.text = CareerTheme.caps(I18n.t(String(a["name"])))
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	t.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	box.add_child(t)
	var marco: PanelContainer = PanelContainer.new()
	marco.add_theme_stylebox_override("panel", CareerTheme.plate())
	var view: Control = null
	if _taller_sabe_foto():
		view = load("res://ui/house/house.tscn").instantiate()
