const TORN_AIRE_CAB_LISTA_MIN: float = 8.0








func _torn_lista_aire_cab(box: Control, n: int) -> float:
	var vp: Viewport = box.get_viewport()
	if vp == null:
		return TORN_AIRE_CAB_LISTA
	var alto: float = vp.get_visible_rect().size.y - box.offset_top + box.offset_bottom
	var resto: float = float(CareerTheme.T_DATO_TUMBADO) + TORN_AIRE_TITULO_LISTA \
			+ float(CareerTheme.T_CAP_TUMBADO) + float(n) * TORN_FILA_H_COMPACTA
	return clampf(floorf(alto - resto), TORN_AIRE_CAB_LISTA_MIN, TORN_AIRE_CAB_LISTA)







func _torn_lista_entrada(fila: HBoxContainer, entrada: Control, col: Control,
		lado: Control) -> void:
	if not is_instance_valid(fila) or not is_instance_valid(col):
		return
	var sep: float = float(fila.get_theme_constant("separation"))






	var ref_lista: float = _torn_lista_ancho(TORN_LISTA_NOMBRE_REF, true)
	var lado_w: float = lado.get_combined_minimum_size().x
	var ref: float = ref_lista + lado_w
	var lista_w: float = col.get_combined_minimum_size().x
	var hueco: MarginContainer = fila.get_node_or_null("HuecoLado") as MarginContainer
	var real: float = lista_w + lado_w



	var mando: Control = fila.get_node_or_null("Mando") as Control
	var mando_w: float = 0.0 if mando == null else mando.get_combined_minimum_size().x + sep
	var w: float = clampf(floorf(0.5 *(fila.size.x - 3.0 * sep - ref)), 0.0,
		maxf(0.0, fila.size.x - 2.0 * sep - real - mando_w))
	if not is_equal_approx(entrada.custom_minimum_size.x, w):
		entrada.custom_minimum_size.x = w


	if hueco != null:
		var libre: float = fila.size.x - 2.0 * sep - w - real - mando_w
		var hw: int = int(clampf(floorf(ref_lista - lista_w), 0.0, maxf(0.0, libre)))
		if hueco.get_theme_constant("margin_left") != hw:
			hueco.add_theme_constant_override("margin_left", hw)











func _torn_lista_zonas(lado: VBoxContainer, tramos: Array) -> void:


	lado.add_theme_constant_override("separation", 0)
	for i in tramos.size():
		var d: Dictionary = tramos[i]
		var c: Color = d["color"]
		if c.a <= 0.0:
			c = _torn_color_eliminado()
		var hueco: Control = Control.new()
		hueco.name = "HuecoZ%d" % i
		hueco.mouse_filter = Control.MOUSE_FILTER_IGNORE
		lado.add_child(hueco)
		var llave: HBoxContainer = CareerUi.llave_zona(c, String(d.get("puestos", d["texto"])),
			String(d.get("destino", "")))
		llave.name = "Llave%d" % i



		var rot: Label = llave.find_child("Rotulo", true, false) as Label
		var f_rot: Font = get_theme_font("font", "Label")
		if rot != null and f_rot != null:
			rot.custom_minimum_size.x = ceilf(f_rot.get_string_size(rot.text,
				HORIZONTAL_ALIGNMENT_LEFT, -1.0, CareerTheme.T_LEE_TUMBADO).x)
		var desde: int = int(d.get("desde", 0))
		llave.set_meta("zona_desde", desde)
		llave.set_meta("zona_hasta", desde + maxi(1, int(d.get("filas", 1))) - 1)
		lado.add_child(llave)



const TORN_LLAVE_APARTA: float = 2.0









func _torn_lista_zonas_alinea(lado: VBoxContainer, col: VBoxContainer,
		filas_v: VBoxContainer) -> void:
	if not is_instance_valid(lado) or not is_instance_valid(col) or not is_instance_valid(filas_v) \
			or filas_v.size.y <= 0.0 or lado.size.y <= 0.0:
		return
	var filas: Array[Control] = []
	for c in filas_v.get_children():
		if c is Control and not (c as Node).is_queued_for_deletion():
			filas.append(c as Control)
	if filas.is_empty():
		return
	var marco: MarginContainer = lado.get_parent() as MarginContainer
	var marco_y: float = 0.0 if marco == null else marco.position.y
	var lado_y: float = lado.position.y
	if marco != null:
		var tope: int = maxi(0, roundi(col.position.y + filas_v.position.y + filas[0].position.y
			- marco_y))
		if marco.get_theme_constant("margin_top") != tope:
			marco.add_theme_constant_override("margin_top", tope)





		lado_y = float(tope)
	var base: float = col.position.y + filas_v.position.y - marco_y - lado_y
	var fin: float = 0.0





	var desdes: Dictionary = {}
	var hastas: Dictionary = {}
	for c in lado.get_children():
		if c is Control and c.has_meta("zona_desde"):
			var d0: int = clampi(int(c.get_meta("zona_desde")), 0, filas.size() - 1)
			desdes[d0] = true
			hastas[clampi(int(c.get_meta("zona_hasta", d0)), d0, filas.size() - 1)] = true
	for c in lado.get_children():
		if not (c is Control) or not c.has_meta("zona_desde"):
			continue
		var z: Control = c as Control
		var desde: int = clampi(int(z.get_meta("zona_desde")), 0, filas.size() - 1)
		var hasta: int = clampi(int(z.get_meta("zona_hasta", desde)), desde, filas.size() - 1)
		var arriba: float = base + filas[desde].position.y
		var abajo: float = base + filas[hasta].position.y + filas[hasta].size.y
		if hastas.has(desde - 1):
			arriba += TORN_LLAVE_APARTA
		if desdes.has(hasta + 1):
			abajo -= TORN_LLAVE_APARTA
		var hueco: Control = lado.get_child(z.get_index() - 1) as Control
		var h_hueco: float = maxf(0.0, roundf(arriba - fin))
		var h_zona: float = maxf(0.0, roundf(abajo - fin - h_hueco))
		if not is_equal_approx(hueco.custom_minimum_size.y, h_hueco):
			hueco.custom_minimum_size.y = h_hueco
		if not is_equal_approx(z.custom_minimum_size.y, h_zona):
			z.custom_minimum_size.y = h_zona
		fin += h_hueco + maxf(h_zona, z.get_combined_minimum_size().y)





