func _torn_lista_fila(i: int, f: Dictionary, franja: Color, alto: float, filas: Array,
		accent: Color, cab: HBoxContainer, medida: Dictionary) -> Control:
	if not is_equal_approx(float(medida.get("alto", -1.0)), alto):
		var compacta: bool = alto < TORN_LISTA_LETRA_GRANDE
		var apretada: bool = not compacta and alto < TORN_LISTA_FILA_HOLGADA
		medida["alto"] = alto
		medida["compacta"] = compacta
		medida["apretada"] = apretada
		medida["nombre_w"] = _torn_nombre_ancho(filas, compacta)
		var escudo: float = TORN_ESCUDO_COMPACTO if compacta \
				else (minf(TORN_ESCUDO, alto - 4.0) if apretada else TORN_ESCUDO)
		if cab != null and is_instance_valid(cab):
			var celdas_cab: Array = cab.get_meta("fila_celdas", [])
			if not celdas_cab.is_empty():
				(celdas_cab[0] as Control).custom_minimum_size.x = _torn_lista_hueco_cab(
					float(medida["nombre_w"]), escudo)
	var p: PanelContainer = _torn_fila(i + 1, f, franja, alto, accent, bool(medida["compacta"]),
		bool(medida["apretada"]), float(medida["nombre_w"]))
	p.size_flags_vertical = Control.SIZE_EXPAND_FILL
	return p







