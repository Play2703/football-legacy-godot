func _torn_j0() -> String:
	var clave: String = _torn_clave()
	if _torn_comp == "liga":
		var mia: bool = _torn_country == Teams.country_of(GameState.player_team_id) \
				and _torn_div == GameState.player_div()
		clave = "league" if mia else ""
	if clave.is_empty():
		return "-"
	for k in range(maxi(GameState.season_day, 0), GameState.calendar.size()):
		var f: Dictionary = GameState.calendar[k]
		if String(f.get("comp", "")) != clave or bool(f.get("dead", false)):
			continue

		if not _torn_fecha_del_torneo(clave, f) and String(f.get("round", "")) != "qual":
			continue
		return I18n.tf("S{0}", [k + 1])
	return "-"






