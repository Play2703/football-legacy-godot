func _torn_liga_tumbada(accent: Color) -> void:
	var mine: bool = _torn_country == Teams.country_of(GameState.player_team_id) \
			and _torn_div == GameState.player_div()
	var vista: int = -1
	if Liguilla.aplica(_torn_country, _torn_div) \
			and (not mine or GameState.torneos_activos()):
		vista = _torn_vista_de(mine)
	var pa: Dictionary = _torn_plantilla()
	_content.add_child(pa["raiz"])
	var datos: Dictionary = _torn_filas_liga(mine, vista)
	var filas: Array = datos["filas"]
	var franja: HBoxContainer = _torn_tabla_tumbada(pa["contenido"], filas, mine, vista, accent)
	_torn_pon_ayuda(franja, _torn_leyenda_liga(filas, mine, vista))
	_torn_apoyo_liga(pa, filas, mine, vista, accent, String(datos["aviso"]))
	_torn_ficha_ancho(franja, float(pa["ancho_contenido"]))






func _torn_filas_liga(mine: bool, vista: int) -> Dictionary:
	var torneo: bool = vista >= 0 and vista != TORN_ANUAL
	var rows: Array = []
	var aviso: String = ""
	if mine:
		if torneo and vista > GameState.torneo_actual():
			return {"filas": [], "aviso": I18n.t("El torneo aún no arranca.")}
		if not GameState.league_started():
			aviso = I18n.t("La liga aún no arranca.")
		rows = GameState.torneo_standings(vista) if torneo else GameState.league_standings()
	else:
		var pt: Array = _torn_frac()
		if int(pt[0]) <= 0:
			return {"filas": [], "aviso": I18n.t("La liga aún no arranca.")}
		if torneo:
			var f: float = _torn_frac_torneo(vista)
			if f <= 0.0:
				return {"filas": [], "aviso": I18n.t("El torneo aún no arranca.")}
			rows = SimLeague.table_torneo(_torn_country, _torn_div, GameState.season_num,
				vista, f)
		else:
			rows = SimLeague.table(_torn_country, _torn_div, GameState.season_num,
				float(pt[0]) / float(maxi(int(pt[1]), 1)))
		if rows.is_empty():
			return {"filas": [], "aviso": I18n.t("Sin datos de esta competición todavía.")}
	var out: Array = []
	for r in rows:
		var d: Dictionary = r
		var tuya: bool = mine and String(d.get("key", "")) == GameState.YOU_KEY
		var club: String = GameState.player_team_id if tuya \
				else String(d.get("key", d.get("id", "")))
		var nombre: String = String(d["name"]) if mine \
				else Competitions.demarca(String(Teams.by_id(club).get("name", club)))
		out.append({"club": club, "nombre": nombre, "pj": int(d.get("pj", 0)),
			"w": int(d.get("w", 0)), "d": int(d.get("d", 0)), "l": int(d.get("l", 0)),
			"dif": int(d.get("gf", 0)) - int(d.get("gc", 0)), "pts": int(d.get("pts", 0)),
			"tuya": tuya, "sancion": _torn_sancion(club, vista)})
	return {"filas": out, "aviso": aviso}






func _torn_tabla_tumbada(caja: VBoxContainer, filas: Array, mine: bool, vista: int,
		accent: Color) -> HBoxContainer:

	var partes: Dictionary = CareerUi.tabla_tumbada(caja, _torn_ficha(), _torn_cabecera(filas),
		TORN_AIRE_TABLA)
	var tabla: VBoxContainer = partes["tabla"]
	var franja: HBoxContainer = partes["franja"]
	if filas.is_empty():
		return franja
	var zones: Dictionary = _torn_zones(_torn_country, _torn_div, filas.size(), vista)
	var obj_line: int = _torn_obj_line(mine, vista)
	var alto: float = TORN_FILA_H if filas.size() <= 20 else TORN_FILA_H_LARGA
	var zona_antes: String = ""
	for i in filas.size():
		var zone: Dictionary = zones.get(i + 1, {})
		var etiqueta: String = String(zone.get("label", ""))
		if i > 0 and (etiqueta != zona_antes or i == obj_line):
			tabla.add_child(_torn_divisor())
		zona_antes = etiqueta
		tabla.add_child(_torn_fila(i + 1, filas[i],
			zone["color"] if not zone.is_empty() else Color.TRANSPARENT, alto, accent))
	return franja






static func _torn_letra_grupo(gi: int) -> String:
	if gi >= 0 and gi < GameState.EURO_GROUP_LETTERS.size():
		return String(GameState.EURO_GROUP_LETTERS[gi])
	if gi >= 0 and gi < 26:
		return char(65 + gi)
	return str(gi + 1)














