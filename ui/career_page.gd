			_ti_t_dock_linea(I18n.tf("MIENTRAS SIGAS AQUÍ · TE QUEDAN {0} {1}",
				[left, I18n.plural(left, "TEMPORADA", "TEMPORADAS")]))
			_ti_t_dock_linea(I18n.t("TOCA UNA FICHA PARA ELEGIRLA"))
