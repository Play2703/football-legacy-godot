		_ge_t_fila(key, label_text, effect, extra, chip, chip_col)
		return
	var nivel: int = int(_rel_levels().get(key, -1))
	var col: Color = CareerTheme.DANGER if nivel >= 0 and nivel < 35 \
			else CareerTheme.accent_text()



	var card: PanelContainer = PanelContainer.new()

	var aire: StyleBoxEmpty = StyleBoxEmpty.new()
	aire.content_margin_top = 8.0
	aire.content_margin_bottom = 14.0
	card.add_theme_stylebox_override("panel", aire)
	_content.add_child(card)
