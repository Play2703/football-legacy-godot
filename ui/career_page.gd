func _cal_mes_modal_tumbado(t: Dictionary, d: Dictionary) -> void:
	var box: VBoxContainer = CareerUi.modal_pantalla(self)
	if box == null:
		return
	CareerUi.margen_modal_tumbada(box)
	CareerUi.modal_opaca(box)
	box.set_meta("cal_mes_modal", int(t["mes"]))
	var titulo: Label = CareerUi.plain(CareerTheme.T_TITULO_TUMBADO, CareerTheme.TEXT)
	titulo.text = CareerTheme.caps(I18n.t(CareerUi.MESES[int(t["mes"]) - 1]))
	titulo.clip_text = true
	titulo.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(titulo)
	_cal_dias_tumbado(box)
	var lista: VBoxContainer = VBoxContainer.new()
	lista.add_theme_constant_override("separation", CAL_T_SEP)
	lista.mouse_filter = Control.MOUSE_FILTER_IGNORE
	lista.set_meta("fl_lista", "mes")
	lista.size_flags_vertical = Control.SIZE_EXPAND_FILL
	box.add_child(lista)
	var hoy: int = int(d["hoy"])
	for sem in range(int(t["desde"]), int(t["hasta"]) + 1):
		if hoy != CAL_SIN_HOY and sem == floori(float(hoy) / 7.0):
			_cal_hoy_tumbado(lista)
		_cal_semana_tumbada(lista, sem, d, int(t["mes"]) if sem == int(t["desde"]) else 0, false,
			true)


	lista.resized.connect(_cal_mes_escala.bind(lista), CONNECT_DEFERRED)
	var aire: Control = Control.new()
	aire.custom_minimum_size.y = CAL_T_AIRE_CERRAR
	aire.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(aire)
	box.add_child(_torn_boton(I18n.t("CERRAR"), CareerTheme.Kind.GHOST,
		func() -> void: CareerUi.close_modal(box)))



func _cal_mes_escala(lista: VBoxContainer) -> void:
	if not is_instance_valid(lista):
		return
	var cas: Array = []
	var alto: float = INF
	var ancho: float = INF
	for sem in lista.get_children():
		if not (sem as Node).has_meta("cal_semana"):
			continue
		alto = minf(alto,(sem as Control).size.y)
		for c in (sem as Node).get_children():
			if (c as Node).has_meta("cal_t_partes"):
				cas.append(c)
				ancho = minf(ancho,(c as Control).size.x)
	var grande: bool = alto >= CAL_T_GRANDE_ALTO and ancho >= CAL_T_GRANDE_ANCHO
	for c in cas:
		if bool((c as Control).get_meta("cal_t_grande", false)) != grande:
			_cal_casilla_grande(c as Control, grande)



func _cal_familias_de(filas: Array) -> Dictionary:
	var primera: Dictionary = {}
	for f in filas:
		var fam: String = String(f["familia"])
		if not primera.has(fam):
			primera[fam] = f
	var hay: Dictionary = {}
	for fam in CAL_FAMILIAS:
		if primera.has(fam):
			hay[fam] = primera[fam]
	return hay










