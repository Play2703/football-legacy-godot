func _ficha_trayectoria(box: VBoxContainer, p: Dictionary, es_yo: bool,
		origen: Dictionary) -> void:
	var etapas: Array = []
	var desde: int = 0
	var club_hoy: String = ""
	if es_yo:
		club_hoy = GameState.player_team_id
		var mia: Dictionary = TransferBook.trayectoria_propia(Career.start_club,
			Career.transfers, club_hoy, not Career.loan.is_empty())
		etapas = mia.get("etapas", [])
		desde = int(mia.get("desde", 1))
	elif origen.get("etapas", null) is Array:


		club_hoy = String(origen.get("club", ""))
		etapas = origen["etapas"]
		desde = int(origen.get("desde", 0))
	elif not origen.is_empty():
		club_hoy = String(origen.get("club", ""))
		var d: Dictionary = TransferBook.trayectoria_ficha(club_hoy,
			int(origen.get("seat", -1)), String(p.get("pos", "MC")))
		etapas = d.get("etapas", [])
		desde = int(d.get("desde", 0))
	if club_hoy.is_empty():
		return
	CareerUi.subhead(box, I18n.t("TRAYECTORIA"), "mundo")



	var cab: VBoxContainer = VBoxContainer.new()
	box.add_child(cab)
	var cuerpo: VBoxContainer = VBoxContainer.new()
	cuerpo.add_theme_constant_override("separation",
		box.get_theme_constant("separation"))
	box.add_child(cuerpo)
	var paginas: int = _tray_paginas(etapas)
	_tray_pagina(cab, cuerpo, etapas, [paginas - 1], club_hoy, desde)


func _tray_paginas(etapas: Array) -> int:
	return maxi(ceili(float(etapas.size()) / TRAY_POR_PAGINA), 1)






func _tray_pagina(cab: VBoxContainer, cuerpo: VBoxContainer, etapas: Array,
		pagina: Array, club_hoy: String, desde: int) -> void:
	if UiKit.es_horizontal():
		_tray_indice(cab, cuerpo, etapas, club_hoy, desde)
		return
	var paginas: int = _tray_paginas(etapas)
	var actual: int = clampi(int(pagina[0]), 0, paginas - 1)
	pagina[0] = actual
	var ini: int = actual * TRAY_POR_PAGINA
	var fin: int = mini(ini + TRAY_POR_PAGINA, etapas.size())

	var base: int = TransferBook.base_carrera(etapas, desde)
	for n in cab.get_children():
		cab.remove_child(n)
		n.queue_free()
	for n2 in cuerpo.get_children():
		cuerpo.remove_child(n2)
		n2.queue_free()
	if paginas > 1:
		var primera: Dictionary = etapas[ini]
		var ultima: Dictionary = etapas[fin - 1]
		CareerUi.pager(cab, _tray_rango(int(primera.get("desde", 0)),
			int(ultima.get("hasta", 0)), base), paginas, actual,
			func(d: int) -> void:
				pagina[0] = wrapi(actual + d, 0, paginas)
				_tray_pagina(cab, cuerpo, etapas, pagina, club_hoy, desde))
	for k in range(ini, fin):
		var e: Dictionary = etapas[k]
		_tray_fila(cuerpo, String(e.get("club", "")),
			_tray_rango(int(e.get("desde", 0)), int(e.get("hasta", 0)), base),
			String(e.get("via", "")), false, String(e.get("nombre", "")),
			String(e.get("pais", "")))
	var hoy: String = I18n.tf("DESDE T{0}", [TransferBook.temporada_carrera(desde, base)])
	_tray_fila(cuerpo, club_hoy, hoy, "", true)




func _tray_indice(cab: VBoxContainer, cuerpo: VBoxContainer, etapas: Array,
		club_hoy: String, desde: int) -> void:
	var base: int = TransferBook.base_carrera(etapas, desde)
	for hijo in cab.get_children():
		cab.remove_child(hijo)
		hijo.queue_free()
	if etapas.size() > 1:
		var indice: HFlowContainer = HFlowContainer.new()
		indice.name = "IndiceTrayectoria"
		indice.add_theme_constant_override("h_separation", 8)
		indice.add_theme_constant_override("v_separation", 8)
		cab.add_child(indice)
		for e in etapas:
			var b: Button = Button.new()
			b.text = I18n.tf("T{0}", [TransferBook.temporada_carrera(int(e.get("desde", 0)), base)])
			b.custom_minimum_size = Vector2(80.0, 56.0)
			b.tooltip_text = TransferBook.nombre_de_etapa(e)
			CareerTheme.apply_button(b, CareerTheme.Kind.NEUTRAL, CareerTheme.T_DIM)
			b.pressed.connect(_tray_muestra.bind(cuerpo, e, club_hoy, desde, base))
			indice.add_child(b)
	_tray_muestra(cuerpo, etapas.back() if not etapas.is_empty() else {}, club_hoy, desde, base)


func _tray_muestra(cuerpo: VBoxContainer, e: Dictionary, club_hoy: String,
		desde: int, base: int) -> void:
	for hijo in cuerpo.get_children():
		cuerpo.remove_child(hijo)
		hijo.queue_free()
	if not e.is_empty():
		_tray_fila(cuerpo, String(e.get("club", "")),
			_tray_rango(int(e.get("desde", 0)), int(e.get("hasta", 0)), base),
			String(e.get("via", "")), false, String(e.get("nombre", "")),
			String(e.get("pais", "")))
	_tray_fila(cuerpo, club_hoy, I18n.tf("DESDE T{0}", [
		TransferBook.temporada_carrera(desde, base)]), "", true)










func _tray_rango(desde: int, hasta: int, base: int = TransferBook.ANIO_T1) -> String:
	return "%s-%s" % [I18n.tf("T{0}", [TransferBook.temporada_carrera(desde, base)]),
		I18n.tf("T{0}", [TransferBook.temporada_carrera(hasta, base)])]













func _tray_fila(parent: Container, club_id: String, rango: String, via: String,
		hoy: bool, nombre: String = "", pais: String = "") -> void:
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 10)
	parent.add_child(fila)
	var r: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)
	r.text = rango
	r.clip_text = true
	r.custom_minimum_size = Vector2(TRAY_W_RANGO, 0)
	r.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(r)
	var team: Dictionary = Teams.by_id(club_id)
	var bandera: String = pais
	if not team.is_empty():
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(TRAY_ESCUDO, TRAY_ESCUDO)
		crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		crest.set_team(team)
		fila.add_child(crest)
		bandera = Teams.country_of(club_id)
	if not bandera.is_empty() and Flags.has(bandera):
		fila.add_child(Flags.make_rect(bandera, TRAY_BANDERA))
	var c: Label = CareerUi.plain(CareerTheme.T_BODY,
		CareerTheme.accent_text() if hoy else CareerTheme.TEXT)




	c.text = TransferBook.nombre_de_etapa({"club": club_id, "nombre": nombre})
	c.clip_text = true
	c.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	c.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(c)
	if via.is_empty():
		return
	var v: Label = CareerUi.plain(CareerTheme.T_CAPTION, _via_color(via))
	v.text = _via_rotulo(via)
	v.clip_text = true
	v.custom_minimum_size = Vector2(TRAY_W_VIA, 0)
	v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	v.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	fila.add_child(v)




func _via_rotulo(via: String) -> String:
	if via == TransferBook.VIA_CESION:
		return I18n.t("CESION")
	if via == TransferBook.VIA_VUELTA:
		return I18n.t("FIN CESION")
	if via == TransferBook.VIA_COMPRA:
		return I18n.t("COMPRADO")
	if via == TransferBook.VIA_LIBRE:
		return I18n.t("LIBRE", "via")
	if via == TransferBook.VIA_EDITOR:
		return I18n.t("EDITOR", "via")
	return I18n.t("TRASPASO")








func _via_color(via: String) -> Color:
	if via == TransferBook.VIA_CESION:
		return CareerTheme.NAV_MUNDO
	if via == TransferBook.VIA_VUELTA:
		return CareerTheme.NAV_YO
	if via == TransferBook.VIA_COMPRA:
		return CareerTheme.NAV_LEGADO
	if via == TransferBook.VIA_LIBRE:
		return CareerTheme.NAV_PAPEL
	if via == TransferBook.VIA_EDITOR:
		return CareerTheme.TEXT_DIM
	return CareerTheme.MONEY
















func _ficha_mesa(box: VBoxContainer, reco: Dictionary) -> void:
	_ficha_reco_pct(box, "INTERES", Career.gerencia_interes(reco))
	_reco_nota(box, _reco_interes_porque(reco))


	_ficha_atractivo(box)


	_reco_nota(box, _reco_ex_txt(reco))
	if Career.gerencia_en_linea(reco):
		_reco_nota(box, I18n.t("Lo pide tu técnico: si llega, te lo apunta."))




	var precio: int = Career.gerencia_precio(reco)
	if precio >= 0:
		var por_clausula: bool = Career.gerencia_clausula(reco)


		var pactado: bool = int(Career.gerencia_trato(reco)["pacto"]) >= 0
		CareerUi.kv(box, I18n.t("CLÁUSULA") if por_clausula \
				else (I18n.t("PACTADO") if pactado else I18n.t("PRECIO")),
			I18n.t("LIBRE") if precio == 0 else CareerUi.short_money(precio),
			CareerTheme.MONEY)
		if por_clausula:
			_reco_nota(box, I18n.t("Su club no lo vende: sólo sale pagando su cláusula."))
		elif Career.gerencia_fuerza(reco):


			var fz: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.MONEY)
			fz.text = I18n.tf("Quiere venir: sale sin cláusula (+{0} %).",
				[roundi((Gerencia.FUERZA_PRIMA - 1.0) * 100.0)])
			fz.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			box.add_child(fz)
		_reco_nota(box, _reco_bajada_txt(reco))
		_reco_nota(box, _reco_tray_txt(reco))
	var por: String = Career.gerencia_mesa_cerrada_por()
	if not por.is_empty():
		_reco_nota(box, _mesa_cerrada_txt(por))
		return
	var dentro: bool = Career.gerencia_mesa_compro(reco)
	var causa: String = _mesa_causa_compra(reco, Career.gerencia_mesa_no_compra(reco))
	if not causa.is_empty() and not dentro:
		var l: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.DANGER)
		l.text = causa
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		box.add_child(l)

	if not dentro and causa.is_empty() and Career.gerencia_regatea(reco):
		_ficha_regateo(box, reco)
		return




	var b: Button
	if dentro:
		b = CareerUi.accion("cerrar", I18n.t("QUITAR DE LA MESA"), CareerTheme.DANGER)
	elif causa.is_empty():
