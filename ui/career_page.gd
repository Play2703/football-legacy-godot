func _mk_t_heroe() -> PanelContainer:
	var abierto: bool = Career.market_open()
	var estado: String = "abierto" if abierto else "cerrado"
	var titulo: String = I18n.t("MERCADO ABIERTO" if abierto else "MERCADO CERRADO")
	var col: Color = CareerTheme.GOOD if abierto else CareerTheme.TEXT_MID
	var cifra: String = ""
	var linea: String = ""
	var wd: int = GameState.winter_day()
	var cal: int = GameState.calendar.size()
	if Career.on_loan():
		estado = "cedido"
		titulo = I18n.t("ESTÁS CEDIDO")
		col = CareerTheme.accent_text()
		var dueno: Dictionary = Teams.by_id(String(Career.loan.get("parent", "")))
		cifra = I18n.tf("{0} J", [maxi(cal - GameState.season_day, 0)])
		linea = "%s · %s" % [I18n.t("VUELVES"), CareerTheme.caps(String(dueno.get("name", "")))]
	else:
		if Career.free_agent:
			estado = "libre"
			titulo = I18n.t("ERES AGENTE LIBRE")
			col = CareerTheme.accent_text()
		var left: int = Career.market_days_left()
		if left > 0:
			cifra = I18n.t("HOY") if left == 1 else I18n.tf("{0} J", [left])
			linea = _reloj_cap(I18n.t("CIERRA"),
				Market.window_last_day(GameState.season_day, wd), wd, cal)
		else:
			var falta: int = Career.market_days_until_open()
			cifra = I18n.tf("{0} J", [falta]) if falta > 0 else ""
			linea = _reloj_cap(I18n.t("ABRE"), GameState.season_day + falta, wd, cal) \
					if falta > 0 else I18n.t("EL AÑO QUE VIENE")
	var card: PanelContainer = _mk_t_placa("Heroe", 24.0, 16.0)
	card.custom_minimum_size.y = MK_T_HEROE_H
	card.set_meta("mk_t_heroe", estado)
	if abierto:
		var sb: StyleBoxFlat = card.get_theme_stylebox("panel") as StyleBoxFlat
		sb.border_color = CareerTheme.GOOD
		sb.set_border_width_all(MK_T_BORDE)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 20)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(fila)
	var ic: MenuIcon = MenuIcon.new()
	ic.custom_minimum_size = Vector2(MK_T_ICONO, MK_T_ICONO)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.setup("candado" if estado == "cerrado" else "mercado", col)
	fila.add_child(ic)
	var txt: VBoxContainer = VBoxContainer.new()
	txt.add_theme_constant_override("separation", 8)
	txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	txt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	txt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(txt)
	var t: Label = _mk_t_label(CareerTheme.T_DATO_TUMBADO, col, titulo)
	t.name = "Titulo"

	CareerUi.letra_por_peldanos(t, [CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO])
	txt.add_child(t)
	var aviso: Array = _mk_t_aviso()
	if not aviso.is_empty():
		var chip: PanelContainer = CareerUi.code_chip(I18n.t(String(aviso[0])),
			aviso[1] as Color, CareerTheme.T_CAP_TUMBADO)
		chip.name = "Aviso"
		chip.set_meta("mk_t_aviso", String(aviso[0]))
		chip.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		chip.mouse_filter = Control.MOUSE_FILTER_IGNORE
		txt.add_child(chip)
	var der: VBoxContainer = VBoxContainer.new()
	der.name = "Reloj"
	der.add_theme_constant_override("separation", 4)
	der.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	der.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(der)
	if not cifra.is_empty():
		var c: Label = _mk_t_label(CareerTheme.T_TITULO_TUMBADO,
			CareerTheme.TEXT if estado == "cerrado" else col, cifra)
		c.name = "Cifra"
		c.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		der.add_child(c)
	var l: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID, linea)
	l.name = "Linea"
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	der.add_child(l)
	der.custom_minimum_size.x = _mk_t_ancho_cifra(der)
	if not (Career.free_agent or Career.on_loan()):
		_dedo_tap(card, _mt_abre_estado)
	return card



func _mk_t_ancho_derecha() -> float:
	var k: float = _torn_ancho_plantilla() / MK_T_DISENO_W
	return _torn_ancho_plantilla() - floor(MK_T_IZQ_W * k) - floor(MK_T_HUECO * k)





func _mk_t_ancho_cifra(col: Control) -> float:
	var ancho: float = 0.0
	for h in col.get_children():
		var l: Label = h as Label
		if l == null:
			continue
		var f: Font = l.get_theme_font("font")
		var px: int = l.get_theme_font_size("font_size")
		ancho = maxf(ancho, ceilf(f.get_string_size(l.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x) + 8.0)
	return ancho







func _mk_t_nombre_cabe(l: Label, id: String) -> void:
	if l == null:
		return
	var corto: String = _torn_sigla_de(id)
	if corto.is_empty():
		corto = _torn_nombre_corto(l.text)
	l.set_meta("peldano_entero", l.text)
	if not corto.is_empty() and corto != l.text:
		l.set_meta("peldano_corto", corto)
	CareerUi.letra_por_peldanos(l, [CareerTheme.T_LEE_TUMBADO])







func _mk_t_modal_ancho(datos: Array, l: Label) -> float:
	var f: Font = l.get_theme_font("font")
	var ancho: float = MK_T_MODAL_ANCHO
	for d in datos:
		var nombre: float = f.get_string_size(String((d as Dictionary)["nombre"]),
			HORIZONTAL_ALIGNMENT_LEFT, -1.0, int(CareerTheme.T_LEE_TUMBADO)).x
		var cifra: float = f.get_string_size(String((d as Dictionary)["cifra"]),
			HORIZONTAL_ALIGNMENT_LEFT, -1.0, int(CareerTheme.T_DATO_TUMBADO)).x
		ancho = maxf(ancho, ceilf(nombre + cifra) + MK_T_MODAL_RESTO)
	var cols: int = maxi(1, ceili(float(datos.size()) / float(MK_T_MODAL_COL)))
	var tope: float =(get_viewport_rect().size.x - 2.0 * 96.0 - 56.0 - 24.0 * float(cols - 1)) \
			/ float(cols)
	return minf(ancho, maxf(MK_T_MODAL_ANCHO, floorf(tope)))




func _mk_t_aviso() -> Array:
	if Career.free_agent or Career.on_loan():
		return []
	var mesa: bool = Career.mesa_abierta()
	if Career.forced_sale and mesa:
		return ["VENTA", CareerTheme.DANGER]
	if Career.forced_loan:
		return ["TE CEDEN", CareerTheme.DANGER]
	if mesa and not Career.counter_offer.is_empty():
		return ["CONTRAOFERTA", CareerTheme.accent_text()]
	return []




