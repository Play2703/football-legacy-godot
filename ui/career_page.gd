func _ct_t_mas_primas() -> PanelContainer:
	var wage: int = int(Career.contract.get("wage", 0))
	var ab: float = float(Career.contract.get("assist_bonus", 0.0))
	var ps: Array = Career.pacto_puestos(GameState.player_team_id)
	var titulos: Array = []
	for k in Clausulas.TITULOS:
		var m: float = Career.prima_titulo_mult(String(k))
		if m > 1.0:
			titulos.append([String(k), m])
	if ps.is_empty() and ab <= 0.0 and titulos.is_empty():
		return null
	var p: PanelContainer = _ct_t_mas_placa("Primas", I18n.t("PRIMAS PACTADAS"))
	var col: VBoxContainer = p.get_node("Columna") as VBoxContainer
	var flujo: HFlowContainer = HFlowContainer.new()
	flujo.name = "Lista"
	flujo.add_theme_constant_override("h_separation", 24)
	flujo.add_theme_constant_override("v_separation", 12)
	flujo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(flujo)
	if not ps.is_empty():
		var puestos: HBoxContainer = _ct_t_mas_pieza("Puestos")
		for pos in ps:
			var chip: PanelContainer = CareerUi.code_chip(CareerUi.pos_rotulo(String(pos)),
				CareerUi.pos_color(String(pos)), CareerTheme.T_CAP_TUMBADO, 8.0, 2.0)
			chip.mouse_filter = Control.MOUSE_FILTER_IGNORE
			chip.size_flags_vertical = Control.SIZE_SHRINK_CENTER
			puestos.add_child(chip)
		flujo.add_child(puestos)
	if ab > 0.0:
		var asist: HBoxContainer = _ct_t_mas_pieza("Asistencia")
		var mi: MenuIcon = MenuIcon.new()
		mi.setup("asist", CareerTheme.MONEY)
		asist.add_child(_ct_t_mas_icono(mi))
		asist.add_child(_mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.MONEY,
			"+$ %s" % CareerUi.money(int(float(wage) * 0.5 * ab)), false))
		flujo.add_child(asist)
	for t in titulos:
		var k: String = String(t[0])
		var pieza: HBoxContainer = _ct_t_mas_pieza("Titulo" + k.capitalize())
		var tro: TrophyIcon = TrophyIcon.new()
		tro.set_type(k)
		pieza.add_child(_ct_t_mas_icono(tro))
		var n: int = maxi(0, Clausulas.TITULO_MULT.find(float(t[1])))
		pieza.add_child(_mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID,
			I18n.t(ClausulasEditor.NIVELES[n]), false))
		pieza.add_child(_mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.MONEY,
			"+$ %s" % CareerUi.money(ContractTerms.title_bonus(wage, k, float(t[1]))), false))
		flujo.add_child(pieza)
	for l in flujo.find_children("*", "Label", true, false):
		(l as Label).vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	return p


func _ct_t_mas_pieza(nombre: String) -> HBoxContainer:
	var h: HBoxContainer = HBoxContainer.new()
	h.name = nombre
	h.add_theme_constant_override("separation", 8)
	h.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return h


func _ct_t_mas_icono(ic: Control) -> Control:
	ic.custom_minimum_size = Vector2(CT_T_MAS_ICONO, CT_T_MAS_ICONO)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return ic




func _ct_t_mas_clausula(box: VBoxContainer) -> PanelContainer:
	var p: PanelContainer = _ct_t_mas_placa("Clausula", I18n.t("CLÁUSULA PERSONAL"))
	var col: VBoxContainer = p.get_node("Columna") as VBoxContainer
	var perk: String = Career.perk()
	var tiene: bool = PERK_INFO.has(perk)
	var nombre: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO,
		CareerTheme.TEXT if tiene else CareerTheme.TEXT_DIM,
		I18n.t(String(PERK_INFO[perk][0])) if tiene else I18n.t("SIN CLÁUSULA"))
	nombre.name = "Nombre"
	col.add_child(nombre)
	if Career.can_set_perk():
		var b: Button = _ca_t_boton("ElegirClausula", String(PERK_ICONO.get(perk, "contrato_firma")),
			I18n.t("CAMBIAR CLÁUSULA") if tiene else I18n.t("ELEGIR CLÁUSULA"),
			CareerTheme.Kind.NEUTRAL, func() -> void:
				CareerUi.close_modal(box)
				_choose_perk())
		_ct_t_mas_tinta(b, CareerTheme.NAV_YO)
		col.add_child(b)
	else:
		var dice: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_MID,
			I18n.t(String(PERK_INFO[perk][1])) if tiene
				else I18n.t("La cláusula se pacta al arranque de la temporada."), false)
		dice.name = "Dice"
		dice.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		dice.custom_minimum_size.x = CT_T_MAS_TEXTO_W
		col.add_child(dice)
	return p





func _ct_t_mas_objetivo(box: VBoxContainer) -> PanelContainer:
	var p: PanelContainer = _ct_t_mas_placa("Objetivo", I18n.t("OBJETIVO DE TEMPORADA"))
	var col: VBoxContainer = p.get_node("Columna") as VBoxContainer
	var tipo: String = String(Career.contract.get("obj_type", "goals"))
	var meta: int = int(Career.contract.get("obj_target", 0))
	var lleva: int = int(Career.contract.get("obj_progress", 0))
	var frase: String
	match tipo:
		"position":
			frase = I18n.tf("Termina {0} o mejor en la liga.", [_ordinal(meta)])
		"assists":
			frase = I18n.tf("Da {0} asistencias  (llevas {1})", [meta, lleva])
		"matches":
			frase = I18n.tf("Juega {0} partidos  (llevas {1})", [meta, lleva])
		"rating":
			frase = I18n.tf("Promedia {0} de nota  (llevas {1})",
				[I18n.num(float(meta) / 10.0, 1), I18n.num(float(lleva) / 10.0, 1)])
		_:
			frase = I18n.tf("Marca {0} goles  (llevas {1})", [meta, lleva])
	var l: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT, frase, false)
	l.name = "Frase"
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.custom_minimum_size.x = CT_T_MAS_TEXTO_W
	col.add_child(l)

	var obj_bonus: int = int(Career.contract.get("obj_bonus", 0))
	if obj_bonus > 0:
		col.add_child(_ct_t_mas_prima("Prima", "precision", I18n.t("PRIMA"), obj_bonus))
	if tipo == "position":
		var va: Label
		if not GameState.league_started():
			va = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_MID,
				I18n.t("La liga aún no arranca."))
		else:
			var pos: int = _league_position()
			var bien: bool = pos > 0 and pos <= meta
			va = _mk_t_label(CareerTheme.T_LEE_TUMBADO,
				CareerTheme.accent_text() if bien else CareerTheme.DANGER,
				I18n.tf("Vas {0}{1}", [_ordinal(pos) if pos > 0 else I18n.t("sin clasificar"), "  ✓" if bien else ""]))
		va.name = "Va"
		col.add_child(va)
	else:
		var bien_r: bool = bool(Career.objective_pace().get("on_track", true))
		var barra: Control = _ct_t_barra(float(lleva) / float(maxi(meta, 1)), 0.0)
		if not bien_r:
			for n in barra.find_children("*", "ColorRect", true, false):
				if n.has_meta("ct_t_barra"):
					(n as ColorRect).color = CareerTheme.DANGER
		col.add_child(barra)
	var mide: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_MID,
		I18n.tf("Te miden como {0}", [I18n.t(Standing.contract_role_name(
			Standing.contract_role_from_key(String(Career.contract.get("role", "rotacion")))))]), false)
	mide.name = "Mide"
	mide.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	mide.custom_minimum_size.x = CT_T_MAS_TEXTO_W
	col.add_child(mide)
	if Career.can_negotiate_objective():
		var b: Button = _ca_t_boton("Pactar", "target", I18n.t("PACTAR OBJETIVO"),
			CareerTheme.Kind.NEUTRAL, func() -> void:
				CareerUi.close_modal(box)
				_negotiate_objective())
		_ct_t_mas_tinta(b, CareerTheme.NAV_YO)
		col.add_child(b)
	return p




func _ct_t_mas_club() -> PanelContainer:
	var metas: Array = Career.club_goals_live()
	if metas.is_empty():
		return null
	var p: PanelContainer = _ct_t_mas_placa("Club", I18n.t("LO QUE PIDE EL CLUB"))
	var col: VBoxContainer = p.get_node("Columna") as VBoxContainer
	for i in mini(metas.size(), CT_T_MAS_CLUB_MAX):
		var g: Dictionary = metas[i]
		var comp: String = String(g.get("comp", "league"))
		var fila: HBoxContainer = _ct_t_mas_pieza("Meta%d" % i)
		fila.add_theme_constant_override("separation", 16)
		var brand: String = String(CLUB_GOAL_BRAND.get(comp, ""))
		if comp == "board":
			var mi: MenuIcon = MenuIcon.new()
			mi.setup("mercado", CareerTheme.MONEY)
			fila.add_child(_ct_t_mas_icono(mi))
		elif brand.is_empty():
			fila.add_child(_ct_t_mas_icono(_comp_icon(Competitions.league_logo(
				Teams.country_of(GameState.player_team_id)), CareerTheme.TEXT_DIM)))
		else:
			fila.add_child(_ct_t_mas_icono(_comp_icon(brand,
				Competitions.COMP_ACCENT.get(brand, CareerTheme.TEXT_DIM) as Color)))
		var pide: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT, _club_goal_ask(g), false)
		pide.name = "Pide"
		pide.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		pide.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		pide.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		fila.add_child(pide)

		var va: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID, "", false)
		va.name = "Va"
		va.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		if bool(g.get("done", false)):
			va.text = I18n.t("CUMPLIDO")
			va.add_theme_color_override("font_color", CareerTheme.MONEY)
		elif bool(g.get("failed", false)):
			va.text = I18n.t("FALLADO")
			va.add_theme_color_override("font_color", CareerTheme.DANGER)
		else:
			va.text = _club_goal_progress(g, comp)
			if ClubGoals.liga_en_rojo(g):
				va.add_theme_color_override("font_color", CareerTheme.DANGER)
		fila.add_child(va)

		var f: Font = va.get_theme_font("font")
		var va_w: float = f.get_string_size(va.text, HORIZONTAL_ALIGNMENT_LEFT, -1,
			CareerTheme.T_CAP_TUMBADO).x if f != null else 0.0
		pide.custom_minimum_size.x = maxf(0.0, CT_T_MAS_TEXTO_W - CT_T_MAS_ICONO - 32.0 - ceilf(va_w))
		col.add_child(fila)
	var tope: int = Career.prima_club_tope()
	if tope > 0:
		col.add_child(_ct_t_mas_prima("Extra", "equipo", I18n.t("SI EL CLUB CUMPLE"), tope))
	return p




func _ct_t_mas_prima(nombre: String, icono: String, rotulo: String, monto: int) -> HBoxContainer:
	var pieza: HBoxContainer = _ct_t_mas_pieza(nombre)
	var mi: MenuIcon = MenuIcon.new()
	mi.setup(icono, CareerTheme.MONEY)
	pieza.add_child(_ct_t_mas_icono(mi))
	var r: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID, rotulo, false)
	r.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	pieza.add_child(r)
	var v: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.MONEY,
		"+$ %s" % CareerUi.money(monto), false)
	v.name = "Valor"
	v.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	pieza.add_child(v)
	return pieza




func _ct_t_mas_guardaron() -> PanelContainer:
	if Career.sell_on.is_empty() and Career.buyback.is_empty():
		return null
	var p: PanelContainer = _ct_t_mas_placa("Guardaron", I18n.t("LO QUE SE GUARDARON"))
	var col: VBoxContainer = p.get_node("Columna") as VBoxContainer
	var frases: Array[String] = []
	if not Career.sell_on.is_empty():
		frases.append(I18n.tf("{0} se lleva el {1}% de tu próximo traspaso (hoy serían {2}).",
			[Competitions.demarca(String(Teams.by_id(String(Career.sell_on.get("club", ""))).get("name", "?"))),
			roundi(float(Career.sell_on.get("pct", 0.0)) * 100.0),
			CareerUi.money(Career.sell_on_due(Career.asking_price()))]))
	if not Career.buyback.is_empty():
		var vivo: bool = GameState.season_num <= int(Career.buyback.get("until", 0))
		frases.append(I18n.tf("{0} puede recomprarte por {1}{2}.",
			[Competitions.demarca(String(Teams.by_id(String(Career.buyback.get("club", ""))).get("name", "?"))),
			CareerUi.money(int(Career.buyback.get("fee", 0))), "" if vivo else I18n.t(" (ya caducó)")]))
	for f in frases:
		var l: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_MID, f, false)
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		l.custom_minimum_size.x = CT_T_MAS_TEXTO_W
		col.add_child(l)
	return p















const PA_T_DISENO_W: float = 2012.0
const PA_T_IZQ_W: float = 960.0
const PA_T_HUECO: float = 20.0
const PA_T_LADOS: float = 32.0
const PA_T_AIRE: float = 24.0
const PA_T_LOGO: float = 88.0
const PA_T_ICONO: float = 48.0
const PA_T_ICONO_FILA: float = 32.0
const PA_T_FILA_H: float = 184.0
const PA_T_FIRMAR_W: float = 208.0
const PA_T_ROMPER_W: float = 320.0
const PA_T_BOTON_H: float = 88.0
const PA_T_MANTEN_S: float = 1.0
const PA_T_MODAL_W: float = 1100.0
const PA_T_MODAL_LADOS: float = 32.0
var _pa_t_k: float = 1.0


func _pa_t_render() -> void:
	_torn_placa(true)
	_plantilla_en_uso = true
	if not Entrada.modo_cambiado.is_connected(_pa_t_modo):
		Entrada.modo_cambiado.connect(_pa_t_modo)
	_pa_t_k = _torn_ancho_plantilla() / PA_T_DISENO_W
	var caja: HBoxContainer = HBoxContainer.new()
	caja.name = "Patrocinio"
	caja.add_theme_constant_override("separation", roundi(PA_T_HUECO * _pa_t_k))
	caja.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	caja.size_flags_vertical = Control.SIZE_EXPAND_FILL
	caja.mouse_filter = Control.MOUSE_FILTER_IGNORE
	caja.set_meta("fl_plantilla", "D")
	caja.set_meta(DragScroll.META_ORDENADA, true)
	_content.add_child(caja)
	caja.add_child(_pa_t_marca())
	caja.add_child(_pa_t_ofertas())
	_pa_t_ordena(caja)
	_leyenda_pon([])



func _pa_t_modo(_m: int) -> void:
	if _page == "relaciones" and _rel_vista == "patrocinio" and is_inside_tree() and _tira_tumbada():
		_refresh()



func _pa_t_ancho_der() -> float:
	return _torn_ancho_plantilla() - floor(PA_T_IZQ_W * _pa_t_k) - roundf(PA_T_HUECO * _pa_t_k)



func _pa_t_superficie(nombre: String, lados: float) -> PanelContainer:
	var c: PanelContainer = PanelContainer.new()
	c.name = nombre
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = CareerTheme.HUD_SURFACE
	sb.border_color = CareerTheme.SURFACE_LINE
	sb.set_border_width_all(2)
	sb.set_corner_radius_all(12)
	sb.content_margin_left = lados
	sb.content_margin_right = lados
	sb.content_margin_top = 16.0
	sb.content_margin_bottom = 16.0
	c.add_theme_stylebox_override("panel", sb)
	c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return c



func _pa_t_frase(nombre: String, px: int, col: Color, texto: String, ancho: float) -> Label:
	var l: Label = _mk_t_label(px, col, texto, false)
	l.name = nombre
	l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	l.custom_minimum_size.x = maxf(ancho, 0.0)
	return l


func _pa_t_icono(nombre: String, icono: String, lado: float, col: Color) -> MenuIcon:
	var ic: MenuIcon = MenuIcon.new()
	ic.name = nombre
	ic.custom_minimum_size = Vector2(lado, lado)
	ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	ic.setup(icono, col)
	return ic



func _pa_t_icono_obj(contrato: Dictionary) -> String:
	match String(contrato.get("obj", "goals")):
		"assists":
			return "asist"
		"rating":
			return "media"
		"matches":
			return "partido"
	return "gol"


func _pa_t_logo(id: String, lado: float) -> SponsorLogo:
	var logo: SponsorLogo = SponsorLogo.new()
	logo.name = "Logo"
	logo.custom_minimum_size = Vector2(lado, lado)
	logo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	logo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	logo.setup(id, Sponsors.color_of(id))
	return logo



func _pa_t_marca() -> PanelContainer:
	var lados: float = floor(PA_T_LADOS * _pa_t_k)
	var card: PanelContainer = _mk_t_placa("TuMarca", lados, PA_T_LADOS)
	card.custom_minimum_size.x = floor(PA_T_IZQ_W * _pa_t_k)
	card.size_flags_vertical = Control.SIZE_EXPAND_FILL
	var col: VBoxContainer = VBoxContainer.new()
	col.name = "Columna"
	col.add_theme_constant_override("separation", roundi(PA_T_AIRE))
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	card.add_child(col)
	var dentro: float = floor(PA_T_IZQ_W * _pa_t_k) - 2.0 * lados
	var r: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID, I18n.t("TU MARCA"), false)
	r.name = "Rotulo"
	col.add_child(r)
	var s: Dictionary = Career.sponsors[0] if not Career.sponsors.is_empty() else {}
	var c: Dictionary = Sponsors.by_id(String(s.get("id", ""))) if not s.is_empty() else {}
	if c.is_empty():
		var placa: PanelContainer = _pa_t_superficie("SinMarca", floor(24.0 * _pa_t_k))
		placa.size_flags_vertical = Control.SIZE_EXPAND_FILL
		col.add_child(placa)
		var l: Label = _pa_t_frase("Frase", CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_MID,
			I18n.t("Ninguna todavía. Sal en la prensa y vendrán solas."), dentro - 2.0 * floor(24.0 * _pa_t_k))
		l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		placa.add_child(l)
		return card
	var id: String = String(s["id"])

	var fila: HBoxContainer = HBoxContainer.new()
	fila.name = "Marca"
	fila.add_theme_constant_override("separation", 28)
	fila.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(fila)
	fila.add_child(_pa_t_logo(id, PA_T_LOGO))
	var txt: VBoxContainer = VBoxContainer.new()
	txt.name = "Texto"
	txt.add_theme_constant_override("separation", 4)
	txt.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	txt.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	txt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fila.add_child(txt)
	var nombre: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT, I18n.t(String(c["name"])))
	nombre.name = "Nombre"
	txt.add_child(nombre)
	var pago: Label = _mk_t_label(CareerTheme.T_DATO_TUMBADO, CareerTheme.MONEY,
		I18n.tf("${0} / PARTIDO", [CareerUi.money(Sponsors.term(s, "pay"))]))
	pago.name = "Pago"
	txt.add_child(pago)
	CareerUi.letra_por_peldanos(pago, [CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO])
	if Sponsors.term(s, "per_goal") > 0:
		var ev: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.MONEY,
			I18n.tf("+${0} POR {1}", [CareerUi.money(Sponsors.term(s, "per_goal")), Sponsors.per_label(s)]))
		ev.name = "PorEvento"
		txt.add_child(ev)
	var linea: ColorRect = ColorRect.new()
	linea.name = "Linea"
	linea.color = CareerTheme.SURFACE_LINE
	linea.custom_minimum_size = Vector2(0.0, 2.0)
	linea.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(linea)
	var ro: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_MID, I18n.t("OBJETIVO"), false)
	ro.name = "RotuloObjetivo"
	col.add_child(ro)

	var obj: HBoxContainer = HBoxContainer.new()
	obj.name = "Objetivo"
	obj.add_theme_constant_override("separation", 16)
	obj.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(obj)
	obj.add_child(_pa_t_icono("Icono", _pa_t_icono_obj(s), PA_T_ICONO, CareerTheme.accent_text()))
	var meta: Label = _pa_t_frase("Meta", CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT,
		Sponsors.objective_text(s), dentro - PA_T_ICONO - 16.0)
	meta.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	meta.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	obj.add_child(meta)
	var prog: HBoxContainer = HBoxContainer.new()
	prog.name = "Progreso"
	prog.add_theme_constant_override("separation", 24)
	prog.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(prog)
	prog.add_child(_ct_t_barra(Sponsors.progress_ratio(s), 0.0))
	var cuenta: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT, Sponsors.progress_text(s))
	cuenta.name = "Cuenta"
	cuenta.custom_minimum_size.x = minf(_wnews_ancho(cuenta.text, CareerTheme.T_LEE_TUMBADO) + 4.0, dentro * 0.6)
	cuenta.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	prog.add_child(cuenta)

	var chips: HBoxContainer = HBoxContainer.new()
	chips.name = "Chips"
	chips.add_theme_constant_override("separation", 16)
	chips.mouse_filter = Control.MOUSE_FILTER_IGNORE
	col.add_child(chips)
	var premio: PanelContainer = CareerUi.code_chip(
		I18n.tf("PREMIO ${0}", [CareerUi.money(Sponsors.term(s, "reward"))]),
		CareerTheme.MONEY, CareerTheme.T_CAP_TUMBADO, 16.0, 8.0)
	premio.name = "Premio"
