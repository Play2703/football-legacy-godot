func _casa_candado_de(e: Dictionary) -> String:
	var id: String = String(e["id"])
	if Career.house_extras.has(id):
		return ""
	if not Career.house_extra_space_ok(id):
		return I18n.t("La ampliación está ocupada. No se moverá tu construcción.")
	var clash: Dictionary = House.excl_conflict(id, Career.house_extras)









	if not clash.is_empty() and not (bool(e.get("swap", false))
			and bool(clash.get("swap", false))
			and ["estilo", "fachada"].has(String(e.get("excl", "")))):
		return I18n.tf("YA TIENES {0}", [I18n.t(String(clash["name"]))])
	var req: String = String(e.get("req_extra", ""))
	if not req.is_empty() and not Career.house_extras.has(req):
		return I18n.tf("PIDE {0}", [I18n.t(String(
			House.extra_by_id(req).get("name", "")))])
	return ""



func _casa_se_puede(e: Dictionary) -> bool:
	var owned: bool = Career.house_extras.has(String(e["id"]))
	if owned and not bool(e.get("multi", false)):
		return false
	return _casa_candado_de(e).is_empty() and Career.can_afford(int(e["price"]))



func _casa_conviene(e: Dictionary) -> bool:
	if Career.house_extras.has(String(e["id"])) or not _casa_candado_de(e).is_empty():
		return false
	return not House.extra_pitch(e, Career.energy, Career.rel).is_empty()





