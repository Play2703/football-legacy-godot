		caja.set_meta("leg_tope", alto_pedido)
	var alto: float = alto_pedido if alto_pedido > 0.0 \
			else minf(caja.size.y, float(caja.get_meta("leg_tope", caja.size.y)))
	if alto < LEG_FILA_H or lista.is_empty():
		return
	var plan: Array = CareerUi.ventana_foco(lista.size(), tu, 1, alto, LEG_FILA_H)
	if plan.is_empty():
		return
	var h: float = maxf(LEG_FILA_H, floorf(alto / float(plan.size())))
	var firma: String = "%d|%s" % [roundi(h), str(plan)]
	if String(caja.get_meta("leg_firma", "")) == firma:
		return
	caja.set_meta("leg_firma", firma)
	for c in v.get_children():
		v.remove_child(c)
		c.queue_free()
	var salta: bool = plan.has(-1)
	var pinta: Callable = func(i: int) -> Control:
		var f: PanelContainer = _leg_fila_temporada(i, lista[i], h, 0.0)


		f.custom_minimum_size.y = LEG_FILA_H

		if not salta:
			_tap_cell(f, i)
			CareerUi.tocable_mando(f)
		return f
	CareerUi.ventana_pinta(v, plan, pinta,
		_leg_temporadas_entera.bind(lista) if salta else Callable())
	if not salta and caja.has_meta("fl_ventana_toque"):


		var hit: Node = SceneFade.vivo(caja.get_meta("fl_ventana_toque", null)) as Node
		caja.remove_meta("fl_ventana_toque")
		if hit != null and is_instance_valid(hit):
			hit.queue_free()
	if not caja.has_meta("leg_entrada"):
		caja.set_meta("leg_entrada", true)
		for c in v.get_children():
			if c is PanelContainer:
				CareerUi.entrada_escalonada(c as Control)





func _leg_fila_temporada(i: int, d: Dictionary, alto: float, nombre_w: float) -> PanelContainer:
	var compacta: bool = alto < 32.0
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var club: String = String(d.get("club", ""))
	var celdas: Array = [
		{"texto": I18n.tf("T{0}", [int(d.get("season", 0))]), "ancho": LEG_COL_T, "tam": tam,
			"color": CareerTheme.TEXT_MID},
		{"nodo": _hc_escudo(club, alto), "ancho": LEG_COL_ESCUDO},
		{"texto": _leg_nombre_temp(d, compacta), "expand": nombre_w <= 0.0,
			"ancho": maxf(nombre_w, 0.0), "tam": tam}]
	for k in ["apps", "goals", "assists"]:
		celdas.append({"texto": str(int(d.get(k, 0))), "ancho": LEG_COL_CIFRA, "derecha": true,
			"tam": tam})


	var nota: String = "%.1f" % float(d.get("avg", 0.0)) if int(d.get("apps", 0)) > 0 else ""
	celdas.append({"texto": nota, "ancho": LEG_COL_NOTA_TEMP, "derecha": true, "tam": tam})
	celdas.append({"nodo": _leg_hueco_trofeos(), "ancho": LEG_HUECO_TROFEOS})
	celdas.append({"nodo": _leg_trofeos_celda(d.get("awards", []), alto), "ancho": LEG_COL_TROFEOS})
	var tuya: bool = bool(d.get("current", false))
	var f: PanelContainer = CareerUi.fila_tumbada(alto, Color.TRANSPARENT, celdas, tuya,
		CareerTheme.NAV_LEGADO)
	f.name = "FilaTemporada"
	f.set_meta("leg_temp", i)
	if tuya:
		f.set_meta("fl_tuya", true)
	f.size_flags_vertical = Control.SIZE_EXPAND_FILL
	return f



