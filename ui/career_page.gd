func _amer_previa(state: Dictionary, key: String, accent: Color) -> void:
	var ties: Array = []
	var etapa: String = ""
	var tuyo: bool = false
	for k in ["previa", "preliminar"]:
		var p: Variant = state.get(k, {})
		if not (p is Dictionary):
			continue
		var d: Dictionary = p
		if not String(d.get("a", "")).is_empty():
			etapa = k
			tuyo = true
			ties = [_amer_cruce_tuyo(d)]
			break
		if k == "previa" and d.get("fase3", []) is Array \
				and not (d.get("fase3", []) as Array).is_empty():
			etapa = k
			var jugada: bool = bool(d.get("jugada", false))
			for t in d["fase3"]:
				if not (t is Dictionary):
					continue
				var c: Dictionary =(t as Dictionary).duplicate()
				if not jugada:
					c["winner"] = ""
					c["score"] = ""
				ties.append(c)
			break



	if ties.is_empty() or (not tuyo and not (state.get("groups", []) as Array).is_empty()):
		return
	var preliminar: bool = etapa == "preliminar" or key == "sud"
	_torn_head(I18n.t("PRELIMINAR") if preliminar else I18n.t("PREVIA"), accent, true)
	_full_bracket([ties], ["Preliminar" if preliminar else "Previa"], accent)






func _amer_cruce_tuyo(d: Dictionary) -> Dictionary:
	var a: String = String(d.get("a", ""))
	var b: String = String(d.get("b", ""))
	var w: String = String(d.get("winner", ""))
	var yo: String = GameState.player_team_id
	if a == yo:
		a = GameState.YOU_KEY
	if b == yo:
		b = GameState.YOU_KEY
	if w == yo:
		w = GameState.YOU_KEY
	var ga: int = 0
	var gb: int = 0
	var hay: bool = false
	for leg in ["leg1", "leg2"]:
		var g: Array = Liguilla.goles(String(d.get(leg, "")))
		if g.size() == 2:
			ga += int(g[0])
			gb += int(g[1])
			hay = true
	return {"a": a, "b": b, "winner": w, "score":("%d-%d" % [ga, gb]) if hay else ""}





