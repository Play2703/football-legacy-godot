func _leave_verdict_txt() -> String:
	if Career.pending_offers.is_empty() or GameState.player_team_id.is_empty():
		return ""
	var mio: int = Teams.rating(GameState.player_team_id)
	var mi_wage: int = int(Career.contract.get("wage", 0))
	var mejor_club: int = -1
	var mejor_wage: int = -1
	for o in Career.pending_offers:
		var d: Dictionary = o
		mejor_club = maxi(mejor_club, Teams.rating(String(d.get("id", ""))))
		mejor_wage = maxi(mejor_wage, int(d.get("wage", 0)))
	var d_club: int = mejor_club - mio
	var d_wage: int = 0 if mi_wage <= 0 else int(round(
		(float(mejor_wage) - float(mi_wage)) / float(mi_wage) * 100.0))
	if d_club <= 0 and d_wage <= 0:
		return ""
	return "%s %+d · %s %+d%%" % [CareerTheme.caps(I18n.t("CLUB")), d_club,
		CareerTheme.caps(I18n.t("SUELDO")), d_wage]


func _offer_best_axes() -> Dictionary:
	var out: Dictionary = {"wage": [], "club": [], "role": []}
	var n: int = Career.pending_offers.size()
	if n < 2:
		return out
	var vals: Dictionary = {"wage": [], "club": [], "role": []}
	for o in Career.pending_offers:
		var d: Dictionary = o
		(vals["wage"] as Array).append(int(d.get("wage", 0)))
		(vals["club"] as Array).append(Teams.rating(String(d.get("id", ""))))
		(vals["role"] as Array).append(int(Standing.contract_role_from_key(
			String(d.get("role", "rotacion")))))
	for eje in out.keys():
		var lista: Array = vals[eje]
		var mx: int = -1
		for v in lista:
			mx = maxi(mx, int(v))
		var ganan: Array = []
		for i in n:
			if int(lista[i]) == mx:
				ganan.append(i)
		if ganan.size() < n:
			out[eje] = ganan
	return out





