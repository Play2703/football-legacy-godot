func _balon_nombre_ajusta(l: Label) -> void:
	if not is_instance_valid(l) or l.size.x <= 0.0:
		return
	var f: Font = l.get_theme_font("font")
	if f == null:
		return
	var nombre: String = String(l.get_meta("balon_nombre", l.text))
	var formas: Array = [[nombre, int(l.get_meta("balon_tam", CareerTheme.T_LEE_TUMBADO))]]
	for corta in _torn_nombres_cortos(nombre):
		formas.append([corta, CareerTheme.T_CAP_TUMBADO])
	var k: int = formas.size() - 1
	for i in formas.size():
		if f.get_string_size(String(formas[i][0]), HORIZONTAL_ALIGNMENT_LEFT, -1.0,
				int(formas[i][1])).x <= l.size.x:
			k = i
			break
	if l.text != String(formas[k][0]):
		l.text = String(formas[k][0])
	l.add_theme_font_size_override("font_size", int(formas[k][1]))




