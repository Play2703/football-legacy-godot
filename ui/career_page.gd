func _season_trophies_cell(awards: Array) -> Control:
	var icons: HBoxContainer = HBoxContainer.new()
	icons.add_theme_constant_override("separation", 6)
	icons.size_flags_vertical = Control.SIZE_SHRINK_CENTER



	icons.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	icons.custom_minimum_size = Vector2(SEASON_TROPHY_W * SEASON_TROPHY_MAX, 0)
	var seen: Dictionary = {}
	var drawn: int = 0
	var extra: int = 0
	for a in awards:
		var info: Dictionary = Trophies.of(String(a))




		if info.is_empty() or seen.has(String(a)):
			continue
		seen[String(a)] = true



		if drawn >= SEASON_TROPHY_MAX:
			extra += 1
			continue
		var ti: TrophyIcon = TrophyIcon.new()
		ti.custom_minimum_size = Vector2(28, 28)
		ti.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		ti.set_type(String(info["type"]))
		icons.add_child(ti)
		drawn += 1
	if extra > 0:
		var more: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
		more.text = "+%d" % extra
		more.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		icons.add_child(more)
	return icons





