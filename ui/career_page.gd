func _torn_semana_proyectada(g: Dictionary) -> String:
	if _torn_comp == "cwc":
		return _torn_semana_destapa(g, EURO_SIM.GROUP_SPOTS)
	if not _torn_comp in ["champions", "europa", "conference"] \
			or not bool(g.get("league_phase", false)):
		return ""
	var total: int =(g.get("schedule", []) as Array).size()
	var jugadas: int = int(g.get("played", 0))
	var n: int = GameState.calendar.size()
	var pais: String = Teams.country_of(GameState.player_team_id)

	var comp: String = {"champions": "ucl", "europa": "eul", "conference": "conf"}[_torn_comp]
	var spots: Array[float] = GameState.euro_league_spots(comp)
	if n <= 0 or jugadas >= total or jugadas >= spots.size() \
			or Teams.confed_of_country(pais) != Continental.confed_de("ucl"):
		return ""
	var largo: int = CalendarioMundo.league_len_de(pais, 1)
	if largo <= 0:
		return ""
	var semana: float = CalendarioMundo.semana_euro_liga(jugadas, largo, comp, pais)
	var k_real: int = 0
	for f in GameState.calendar:
		if not (f as Dictionary).has("week"):
			return ""
		if float((f as Dictionary)["week"]) < semana:
			k_real += 1
	if k_real < maxi(GameState.season_day, 0) or k_real >= n:
		return ""


	for k in range(maxi(GameState.season_day, 0), k_real):
		if EURO_SIM._rounds_done(total, spots,(float(k) + 0.5) / float(n)) > jugadas:
			return ""
	return I18n.tf("S{0}", [k_real + 1])













func _torn_semana_destapa(g: Dictionary, spots: Array[float]) -> String:
	var total: int =(g.get("schedule", []) as Array).size()
	var jugadas: int = int(g.get("played", 0))
	var n: int = GameState.calendar.size()
	if n <= 0 or jugadas >= total:
		return ""
	for k in range(maxi(GameState.season_day, 0), n):
		if EURO_SIM._rounds_done(total, spots,(float(k) + 0.5) / float(n)) > jugadas:
			return I18n.tf("S{0}", [k + 1])
	return ""






