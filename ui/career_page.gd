func _leg_cifras_nivel(g: GridContainer) -> void:
	if not is_instance_valid(g):
		return
	var bs: Array = g.get_children()
	if bs.is_empty() or (bs[0] as Control).size.y <= 0.0:
		return
	var elegido: int = -1

	var medida: String = "%dx%d" % [roundi((bs[0] as Control).size.x), roundi((bs[0] as Control).size.y)]
	var tope: Array = g.get_meta("leg_tope", ["", LEG_CIFRA_NIVELES.size() - 1])
	var maximo: int = int(tope[1]) if String(tope[0]) == medida else LEG_CIFRA_NIVELES.size() - 1
	for n in range(maximo, -1, -1):
		var cabe: bool = true
		for b in bs:
			if not _leg_cifra_cabe(b as Button, LEG_CIFRA_NIVELES[n]):
				cabe = false
				break
		if cabe:
			elegido = n
			break
	var firma: String = "%d|%d" % [elegido, roundi((bs[0] as Control).size.x)]
	if String(g.get_meta("leg_nivel", "")) == firma:
		return
	g.set_meta("leg_nivel", firma)


	var nv: Array = LEG_CIFRA_NIVELES[elegido] if elegido >= 0 else LEG_CIFRA_SIN_ICONO
	for b in bs:
		var pt: Dictionary =(b as Button).get_meta("leg_partes")
		var v: Label = pt["valor"]
		var r: Label = pt["rotulo"]
		var ancho: float =(b as Button).size.x - 32.0
		(pt["icono"] as Control).custom_minimum_size = Vector2(nv[0], nv[0])
		(pt["icono"] as Control).visible = int(nv[0]) > 0
		(pt["cab"] as BoxContainer).vertical = bool(nv[3])
		(pt["cab"] as BoxContainer).add_theme_constant_override("separation",
			8 if bool(nv[3]) else 16)
		v.add_theme_font_size_override("font_size", int(nv[1]))
		r.add_theme_font_size_override("font_size", int(nv[2]))
		v.custom_minimum_size.x = minf(_hc_ancho(v.text, int(nv[1])) + 2.0, ancho)
		r.custom_minimum_size.x = minf(_hc_ancho(r.text, int(nv[2])) + 2.0, ancho)
	if elegido > 0:
		_leg_cifras_revisa.call_deferred(g, elegido, medida)






func _leg_cifras_revisa(g: GridContainer, elegido: int, medida: String) -> void:
	if not is_instance_valid(g):
		return
	for b in g.get_children():
		var m: Control =((b as Button).get_meta("leg_partes")["cab"] as Control).get_parent() as Control
		if m.get_combined_minimum_size().y >(b as Button).size.y - float(CareerTheme.SINK) + 0.5:
			g.set_meta("leg_tope", [medida, elegido - 1])
			g.remove_meta("leg_nivel")
			_leg_cifras_nivel(g)
			return


func _leg_cifra_cabe(b: Button, nv: Array) -> bool:
	var pt: Dictionary = b.get_meta("leg_partes")
	var v: Label = pt["valor"]
	var f: Font = v.get_theme_font("font")
	if f == null:
		return false
	var ancho: float = b.size.x - 32.0
	var alto: float = b.size.y - float(CareerTheme.SINK) - 16.0
	var w_v: float = _hc_ancho(v.text, int(nv[1]))
	var w_r: float = _hc_ancho((pt["rotulo"] as Label).text, int(nv[2]))
	var h_txt: float = f.get_height(int(nv[1])) + float(LEG_CIFRA_AIRE) + f.get_height(int(nv[2]))
	if bool(nv[3]):
		return maxf(float(nv[0]), maxf(w_v, w_r)) <= ancho and float(nv[0]) + 8.0 + h_txt <= alto
	var w_ic: float = float(nv[0]) + 16.0 if int(nv[0]) > 0 else 0.0
	return w_ic + maxf(w_v, w_r) <= ancho and maxf(float(nv[0]), h_txt) <= alto








func _leg_torneos_filas() -> Array:
	var anio: Dictionary = Career.season_comps()
	var todo: Dictionary = Career.career_comps()
	var orden: Array = [["LIGA", "league"], ["LIGUILLA", "liguilla"],
		["CAMPEÓN DE CAMPEONES", "campeones"], [SupercopaNacional.NOMBRE, SupercopaNacional.COMP],
		["COPA", "cup"], [CopaLiga.NOMBRE, CopaLiga.COMP],
		[Competitions.demarca("CHAMPIONS"), "ucl"], [Competitions.demarca("EUROPA LEAGUE"), "eul"],
		[Competitions.demarca("CONFERENCE"), "conf"], ["MUNDIALITO", "cwc"]]
	for ac in Continental.AMER_COMPS:
		orden.append([Competitions.demarca(Continental.etiqueta(ac)), ac])
	for sc in Supercopas.COMPS:
		orden.append([String(Competitions.FAKE_COMP_NAME[Supercopas.marca(sc)]), sc])
	orden.append([CopaLigas.NOMBRE, CopaLigas.COMP])
	var out: Array = []
	for o in orden:
		var s: Dictionary = anio.get(String(o[1]), {})
		var c: Dictionary = todo.get(String(o[1]), {})
		_leg_torneo_pon(out, String(o[0]), int(s.get("g", 0)), int(s.get("a", 0)),
			int(c.get("g", 0)), int(c.get("a", 0)))

	var con_detalle: bool = false
	for k in Career.NAT_COMPS:
		var s: Dictionary = Career.season_nat_by_comp.get(k, {})
		var c: Dictionary = todo.get("nat_%s" % k, {})
		con_detalle = con_detalle or int(s.get("g", 0)) > 0 or int(s.get("a", 0)) > 0
		_leg_torneo_pon(out, JuegosOlimpicos.pinta(String(Career.NAT_COMP_NAME.get(k, k))), int(s.get("g", 0)),
			int(s.get("a", 0)), int(c.get("g", 0)), int(c.get("a", 0)))
	if not con_detalle:
		_leg_torneo_pon(out, "SELECCIÓN", Career.season_nat_goals, Career.season_nat_assists,
			0, 0)
	return out


func _leg_torneo_pon(out: Array, nombre: String, sg: int, sa: int, cg: int, ca: int) -> void:
