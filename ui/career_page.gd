func _balon_nombres_w(filas: Array, de_gala: bool) -> float:
	var f: Font = get_theme_font("font", "Label")
	if f == null:
		return BALON_NOMBRE_MAX
	var w: float = 0.0
	for fi in filas:
		var d: Dictionary =(fi as Dictionary).get("winner", {}) if de_gala else fi
		w = maxf(w, f.get_string_size(CareerUi.display_name(String(d.get("name", ""))),
			HORIZONTAL_ALIGNMENT_LEFT, -1.0, CareerTheme.T_LEE_TUMBADO).x)
	return minf(ceilf(w) + 2.0, BALON_NOMBRE_MAX)







func _balon_rank_fila(r: Dictionary, alto: float, tocable: bool,
		nombre_w: float = 0.0) -> PanelContainer:
	var puesto: int = int(r.get("puesto", 1))
	var seasons: Array = r.get("seasons", [])
	var cuenta: int = _balon_cuenta(r)
	var grande: bool = alto >= 64.0
	var texto: VBoxContainer = VBoxContainer.new()


	texto.add_theme_constant_override("separation", 10)
	texto.alignment = BoxContainer.ALIGNMENT_CENTER
	var nom: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT)
	nom.text = CareerUi.display_name(String(r.get("name", "?")))
	nom.clip_text = true
	nom.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	_balon_nombre_cabe(nom, CareerTheme.T_LEE_TUMBADO)
	texto.add_child(nom)
	if grande:
		var tt: Array = []
		for s in seasons:
			tt.append(str(BallonDor.anio_de(int(s))))
		for a in r.get("anios", []):
			tt.append(str(int(a)))
		var linea: Label = CareerUi.plain(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_DIM)
		linea.text = " · ".join(PackedStringArray(tt))
		linea.clip_text = true
		linea.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		texto.add_child(linea)
	var copas: HBoxContainer = HBoxContainer.new()
	copas.add_theme_constant_override("separation", 4)
	copas.alignment = BoxContainer.ALIGNMENT_END
	copas.custom_minimum_size.x = _balon_copas_ancho()
	var lado: float = minf(32.0, alto - 8.0)
	for i in mini(cuenta, BALON_RANK_COPAS):
		var ic: TrophyIcon = TrophyIcon.new()
		ic.custom_minimum_size = Vector2(lado, lado)
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		ic.set_type("balon_oro")
		copas.add_child(ic)
	var p: PanelContainer = _balon_fila(alto, [
		{"texto": I18n.ordinal(puesto), "ancho": 80.0, "color": _balon_metal(puesto)},
		{"nodo": _balon_escudo(String(r.get("team", "")), minf(40.0, alto - 8.0),
			String(r.get("nat", ""))), "ancho": 40.0},
		{"nodo": texto, "expand": nombre_w <= 0.0, "ancho": nombre_w},
		{"nodo": copas},
		{"texto": str(cuenta), "ancho": 72.0, "derecha": true,
			"tam": CareerTheme.T_DATO_TUMBADO if grande else CareerTheme.T_LEE_TUMBADO},
	], bool(r.get("you", false)))
	CareerUi._raton_fuera(p)
	if tocable and int(r.get("ultima", -1)) >= 0:
		_balon_toque(p, _balon_abre_gala.bind(int(r.get("ultima", -1))))
	return p



