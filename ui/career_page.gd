func _cal_celda_vacia(alto: float, fifa: bool = false, pasada: bool = false,
		dia: int = -1, finde: bool = false) -> Control:
	var filo: Color = CareerTheme.SURFACE_LINE.lerp(CareerTheme.TEXT, CAL_VACIA_FILO)
	if _cal_sb_vacia == null:
		_cal_sb_vacia = _cal_sb_dia(CareerTheme.SURFACE_HI, 1.0, filo)
	if fifa and _cal_sb_fifa == null:
		var borde: Color = _cal_tint("nat")
		borde.a = CAL_FIFA_BORDE
		_cal_sb_fifa = _cal_sb_dia(_cal_tint("nat"), CAL_VACIA_FIFA, borde)
	var c: PanelContainer = PanelContainer.new()
	if finde and not fifa and _cal_sb_finde == null:
		_cal_sb_finde = _cal_sb_dia(CareerTheme.SURFACE_HI.lerp(CareerTheme.TEXT, CAL_FINDE), 1.0,
			filo)
	var sb: StyleBoxFlat = _cal_sb_fifa if fifa else (_cal_sb_finde if finde else _cal_sb_vacia)
	if pasada:
		c.modulate.a = CAL_VELO
		c.set_meta("cal_pasada", true)
	c.set_meta("cal_vacia", dia)
	c.add_theme_stylebox_override("panel", sb)
	c.custom_minimum_size = Vector2(0, alto)
	c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return c





