func _mesa_cromos_block() -> void:
	_mesa_cromos = VBoxContainer.new()
	_mesa_cromos.add_theme_constant_override("separation", 10)
	_content.add_child(_mesa_cromos)
	var mio: String = GameState.player_team_id
	var ventas: Array = []
	for r in Career.gerencia_mesa_plantilla():
		var row: Dictionary = r
		if not bool(row["vendo"]):
			continue
		var idx: int = int(row["idx"])


		var sig: String = "v|" + str(row)
		var vieja: VBoxContainer = _mesa_cromo_reusa(sig)
		if vieja != null:
			ventas.append({"celda": vieja})
			continue
		var cromo: PlayerCard = _mesa_cromo(mio, _mesa_visible(idx))
		if cromo == null:
			continue



		var sale: bool = not String(row["club"]).is_empty()
		var n_of: int = int(row["ofertas"])
		var causa: String = _mesa_causa_venta_corta(String(row["causa"]),
			String(row["pos"]))
		var txt: String = "+" + CareerUi.short_money(int(row["cobra"]))
		var col: Color = CareerTheme.MONEY
		if not sale and n_of > 0:
			txt = I18n.tf("{0} OFERTAS", [n_of]) if n_of > 1 else I18n.t("1 OFERTA")
		elif not sale and String(row["causa"]) == "comprador":
			txt = I18n.t("SIN OFERTAS AÚN")
			col = CareerTheme.TEXT_DIM
		elif not sale:
			txt = causa if not causa.is_empty() else I18n.t("SIN OFERTAS AÚN")
			col = CareerTheme.DANGER
		var pos_v: String = String(row["pos"])
		var nom_v: String = String(row["name"])
		ventas.append({"cromo": cromo, "sig": sig, "apaga": not sale, "txt": txt,
			"col": col, "abre": func() -> void: _mesa_ofertas_modal(idx, nom_v, pos_v)})
	var compras: Array = []
	for e in Career.gerencia_mesa_compras():
		var f: Dictionary = e
		var causa: String = Career.gerencia_mesa_no_compra(f)
		var precio: int = Career.gerencia_precio(f)
		var sig: String = "c|%d|%s|%s" % [precio, causa, str(f)]
		var vieja: VBoxContainer = _mesa_cromo_reusa(sig)
		if vieja != null:
			compras.append({"celda": vieja})
			continue
		var cromo: PlayerCard = _mesa_cromo_compra(f)
		if cromo == null:





			compras.append({"hueco": String(_mesa_ident(String(f.get("club", "")),
				int(f.get("seat", -1)), String(f.get("name", "")),
				String(f.get("pos", "")))["nombre"]), "sig": sig,
				"txt": _mesa_causa_compra_corta(causa), "col": CareerTheme.DANGER,
				"abre": func() -> void: _mesa_toque_compra(f)})
			continue
		var txt: String = _mesa_causa_compra_corta(causa)
		var col: Color = CareerTheme.DANGER
		if causa.is_empty():


			txt = "-" if precio < 0 else (I18n.t("LIBRE") if precio == 0
				else "-" + CareerUi.short_money(precio))
			col = CareerTheme.TEXT
		var club: String = String(f.get("club", ""))
		var seat: int = int(f.get("seat", -1))
		var abre: Callable = func() -> void:
			if Teams.is_free(club):
				_ficha_de_libre_seat(seat)
			else:
				_ficha_de_asiento(club, seat)
		compras.append({"cromo": cromo, "sig": sig, "apaga": not causa.is_empty(),
			"txt": txt, "col": col, "abre": abre})
	if not ventas.is_empty():
		_mesa_rotulo(_mesa_cromos, I18n.t("VENDES"))
		_mesa_cromos_filas(ventas)
	if not compras.is_empty():
		_mesa_rotulo(_mesa_cromos, I18n.t("FICHAS"))
		_mesa_cromos_filas(compras)





func _mesa_cromos_filas(items: Array) -> void:
	var k: int = 0
	while k < items.size():
		var fila: HBoxContainer = HBoxContainer.new()
		fila.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		_mesa_cromos.add_child(fila)
		_espaciador(fila)
		for j in range(k, mini(k + MESA_CROMOS_COLS, items.size())):
			var it: Dictionary = items[j]


			if it.has("celda"):
				var vieja: VBoxContainer = it["celda"]
				vieja.get_parent().remove_child(vieja)
				fila.add_child(vieja)
				_espaciador(fila)
				continue
			var celda: VBoxContainer = VBoxContainer.new()
			celda.add_theme_constant_override("separation", 4)
			celda.set_meta("mesa_sig", String(it.get("sig", "")))
			fila.add_child(celda)
			if it.has("hueco"):


				var h: Button = Button.new()
				h.text = String(it["hueco"])
				h.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
				h.custom_minimum_size = Vector2(PlayerCard.MIN_W, PlayerCard.AVATAR.y)
				h.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
				CareerTheme.apply_button(h, CareerTheme.Kind.GHOST, CareerTheme.T_CAPTION)
				h.pressed.connect(it["abre"] as Callable)
				celda.add_child(h)
			else:
				var cromo: PlayerCard = it["cromo"]
				cromo.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
				cromo.apaga(bool(it["apaga"]))
				cromo.set_tap(it["abre"] as Callable)
				celda.add_child(cromo)




			var cifra: Label = CareerUi.plain(CareerTheme.T_CAPTION, it["col"] as Color)
			cifra.text = String(it["txt"])
			cifra.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
			cifra.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
			celda.add_child(cifra)
			_espaciador(fila)
		k += MESA_CROMOS_COLS





func _mesa_cromo(club_id: String, seat: int) -> PlayerCard:
	var squad: Array = Squad.of(club_id)
	if seat < 0 or seat >= squad.size():
		return null
	var p: Dictionary =(squad[seat] as Dictionary).duplicate()
	var pos: String = String(p.get("pos", "MC"))
	var f: Dictionary = WorldRanking.ficha({"club": club_id, "seat": seat,
		"seat0": Squad.home_seat(squad, seat), "pos": pos,
		"lvl": SquadMeta.media_of(p, pos), "ovr": SquadMeta.ovr_of(p, pos)})
	p["name"] = String(f.get("name", ""))
	return PlayerCard.build(p, Teams.by_id(club_id),
		Nations.id_for_country(String(f.get("nat", ""))))








func _mesa_cromo_compra(f: Dictionary) -> PlayerCard:
	if Career.gerencia_ficha_de(f).is_empty():
		return null
	var club: String = String(f.get("club", ""))
	var seat: int = int(f.get("seat", -1))
	if not Teams.is_free(club):
		return _mesa_cromo(club, seat)
	for r in WorldRanking.rows():
		var row: Dictionary = r
		if row.get("libre", null) is Dictionary and _libre_seat_de(row) == seat:
			var fr: Dictionary = WorldRanking.ficha(row)
			var p: Dictionary =(row["libre"] as Dictionary).duplicate()
			p["name"] = String(fr.get("name", ""))
			p["pos"] = String(row.get("pos", "MC"))
			return PlayerCard.build(p, Teams.free_team(),
				Nations.id_for_country(String(fr.get("nat", ""))))
	return null










func _mesa_refresca(en_sitio: bool = false) -> void:
	var antes: float = _mesa_cromos_alto()
	var at: int = _scroll.scroll_vertical if _scroll != null else 0
	_refresh()


	_mesa_en_sitio = en_sitio
	_mesa_scroll_at = at if _scroll != null and at > 0 else -1
	_mesa_cromos_antes = antes
	_mesa_anclas = _mesa_anclas_vistas() if _mesa_scroll_at > 0 else []




func _mesa_anclas_vistas() -> Array:
	var out: Array = []
	if _mesa_caja == null or not is_instance_valid(_mesa_caja):
		return out
	var vista: Rect2 = _scroll.get_global_rect()
	for c in _mesa_caja.get_children():
		if c.has_meta("mesa_sig") and (c as Control).get_global_rect().intersects(vista):
			out.push_front([c,(c as Control).position.y + _mesa_caja.position.y])
	return out















func _mesa_scroll_compensa(en_sitio: bool) -> void:
	var at: int = _mesa_scroll_at
	_mesa_scroll_at = -1
	if at < 0 or _page != "gerencia" or _scroll == null or not is_instance_valid(_scroll):
		_mesa_anclas.clear()
		return
	if en_sitio:
		_mesa_scroll_pon.call_deferred(at, 0)
		return
	_mesa_anclas.clear()
	var antes: float = _mesa_cromos_antes
	await get_tree().process_frame
	if is_instance_valid(_scroll):
		_restaura_scroll(maxi(at + roundi(_mesa_cromos_alto() - antes), 0))












func _mesa_scroll_pon(at: int, vuelta: int, previo: int = -1) -> void:
	if not is_instance_valid(_scroll):
		_mesa_anclas.clear()
		return
	var a: int = at + roundi(_mesa_cromos_alto() - _mesa_cromos_antes)
	for par in _mesa_anclas:
		var n: Variant = par[0]
		if is_instance_valid(n) and (n as Node).get_parent() == _mesa_caja:
			a = at + roundi((n as Control).position.y + _mesa_caja.position.y - float(par[1]))
			break
	a = maxi(a, 0)
	if a != previo and vuelta < 3:
		_mesa_scroll_pon.call_deferred(at, vuelta + 1, a)
		return
	_mesa_anclas.clear()
	if _scroll.scroll_vertical != a:
		_scroll.scroll_vertical = a




func _mesa_toque_marca() -> int:
	return -2 if _refresh_pending else _refresh_peticiones





func _mesa_toque_limpio(marca: int) -> bool:
	return marca >= 0 and _refresh_peticiones == marca + 1













func _mesa_repinta() -> bool:
	if _page != "gerencia" or _mesa_caja == null or not is_instance_valid(_mesa_caja) \
			or _mesa_caja.get_parent() != _content:
		return false
	if _mesa_fuera_firma() != _mesa_fuera:
		return false

	_mesa_pool.clear()
	var n0: int = _mesa_caja.get_child_count()
	for c in _mesa_caja.get_children():
		if c.has_meta("mesa_sig"):
			var sig: String = String(c.get_meta("mesa_sig"))
			if not _mesa_pool.has(sig):
				_mesa_pool[sig] = []
			(_mesa_pool[sig] as Array).append([c, c.get_meta("mesa_linea")])
	_mesa_movidos = 0

	_mesa_pool_cromos.clear()
	if is_instance_valid(_mesa_cromos):
		for fila in _mesa_cromos.get_children():
			for celda in fila.get_children():
				if celda.has_meta("mesa_sig"):
					var sig: String = String(celda.get_meta("mesa_sig"))
					if not _mesa_pool_cromos.has(sig):
						_mesa_pool_cromos[sig] = []
					(_mesa_pool_cromos[sig] as Array).append(celda)

	for child in _dock.get_children():
		_dock.remove_child(child)
		child.queue_free()
	_dock_box.visible = false
	var fuera: VBoxContainer = _content
	_content = _mesa_caja
	_mesa_cuerpo()
	_content = fuera


	for i in n0 - _mesa_movidos:
		var c: Node = _mesa_caja.get_child(0)
		_mesa_caja.remove_child(c)
		c.queue_free()
	_mesa_pool.clear()
	_mesa_pool_cromos.clear()
	if _board_stage != null and is_instance_valid(_board_stage):
		_board_stage.set_estado(_mesa_relacion, Career.gerencia_mesa_compras().size())
	return true





func _mesa_reusa(sig: String) -> bool:
	if _mesa_pool.is_empty():
		return false
	var pila: Variant = _mesa_pool.get(sig, null)
	if pila == null or (pila as Array).is_empty():
		return false
	for n in ((pila as Array).pop_front() as Array):
		_content.move_child(n as Node, -1)
		_mesa_movidos += 1
	return true




func _mesa_cromo_reusa(sig: String) -> VBoxContainer:
	if _mesa_pool_cromos.is_empty():
		return null
	var pila: Variant = _mesa_pool_cromos.get(sig, null)
	if pila == null or (pila as Array).is_empty():
		return null
	return (pila as Array).pop_front() as VBoxContainer




func _mesa_firma(fila: HBoxContainer, sig: String) -> void:
	var placa: Node = fila.get_parent()
	placa.set_meta("mesa_sig", sig)
	placa.set_meta("mesa_linea", _content.get_child(_content.get_child_count() - 1))




func _mesa_fuera_firma() -> String:
