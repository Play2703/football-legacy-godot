func _torn_record_de(kind: String, clubes: Array, accent: Color) -> Button:
	var mejor: String = ""
	var n: int = 0
	for t in clubes:
		var id: String = String((t as Dictionary).get("id", ""))
		if id.is_empty():
			continue
		var k: int = int(Palmares.of(id).get(kind, 0))
		if k > n or (k == n and k > 0 and id < mejor):
			mejor = id
			n = k
	if n <= 0 or mejor == GameState.player_team_id or Teams.by_id(mejor).is_empty():
		return null


	var b: Button = CareerUi.baldosa_avance("palmares", I18n.t("MÁS TÍTULOS"), accent,
		_torn_escudo(mejor, 48.0), _torn_nombre_de(mejor), str(n), "", Callable())
