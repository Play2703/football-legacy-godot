func _mt_detalle(d: Dictionary) -> PanelContainer:
	var filas: Array = []
	var id: String = String(d.get("id", ""))
	match String(d.get("tipo", "")):
		"oferta":
			var o: Dictionary = d["d"]
			var role: String = String(o.get("role", "rotacion"))
			filas.append(_mt_dato(I18n.t("SUELDO"), String(d["cifra"]), d["color"] as Color))
			filas.append(_mt_dato(I18n.t("TEMPORADAS"), str(int(o.get("seasons", 0))),
				CareerTheme.TEXT))
			filas.append(_mt_dato(I18n.t("MINUTOS"), _mt_rol(role),
				CareerTheme.DANGER if role == "esporadico" else CareerTheme.TEXT))
			if Career.free_agent or bool(o.get("pre", false)):
				filas.append(_mt_dato(I18n.t("PRIMA"), _money_short(Career.agent_signing_net(
					int(o.get("bonus", 0)))), CareerTheme.MONEY))
			else:
				var precio: int = Career.deal_price(o)
				filas.append(_mt_dato(I18n.t("TRASPASO"), _money_short(precio), CareerTheme.TEXT))
				filas.append(_mt_dato(I18n.t("PRIMA"), _money_short(Career.agent_signing_net(
					Career.signing_bonus_gross(precio))), CareerTheme.MONEY))
		"cesion":
			var cifras: Array = _loan_cifras(d["d"] as Dictionary)
			for k in cifras.size():
				if k == 1:
					continue
				if k == 0:

					var pos: String = String((d["d"] as Dictionary).get("pos", ""))
					var fp: HBoxContainer = _mt_dato(String(cifras[0][0]), "", CareerTheme.TEXT_MID)
					var chip: PanelContainer = CareerUi.pos_chip(Career.puesto_hoy() if pos.is_empty()
						else pos)
					chip.size_flags_vertical = Control.SIZE_SHRINK_CENTER
					for cl in chip.find_children("*", "Label", true, false):
						(cl as Label).add_theme_font_size_override("font_size", CareerTheme.T_LEE_TUMBADO)
					fp.add_child(chip)
					filas.append(fp)
					continue
				var c: Array = cifras[k]


				filas.append(_mt_dato(I18n.t("COMPRA") if k == 2 else String(c[0]), String(c[1]),
					c[2] as Color))
		"rumor":
			filas = _mt_filas_club(id)
			if Career.courting_club == id:
				filas.append(_mt_dato(I18n.t("LE DISTE PIE"), "", CareerTheme.accent_text()))
			elif not Career.market_open() and Career.courting_club.is_empty():
				filas.append(_mt_coste_pie())
		_:
			id = GameState.player_team_id
			filas = _mt_filas_club(id)
			if not Career.free_agent:
				filas.append(_mt_dato(I18n.t("MINUTOS"), _mt_rol(String(Career.contract.get("role",
					"rotacion"))), CareerTheme.TEXT))
				var wage: int = int(Career.contract.get("wage", 0))
				if wage > 0:
					filas.append(_mt_dato(I18n.t("SUELDO"), "$%s" % CareerUi.money(wage),
						CareerTheme.MONEY))
	var team: Dictionary = Teams.by_id(id)
	if team.is_empty() or Career.free_agent and d.is_empty():
		return CareerUi.ficha_detalle(null, I18n.t("ERES AGENTE LIBRE") if Career.free_agent
			else I18n.t("SIN CLUB"), [])
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(72, 72)
	crest.set_team(team)
	var titulo: String = String(d.get("nombre", CareerTheme.caps(String(team.get("name", "")))))
	var p: PanelContainer = CareerUi.ficha_detalle(crest, titulo, filas)


	CareerUi.letra_por_peldanos(p.get_meta("detalle_titulo") as Label, [CareerTheme.T_TITULO_TUMBADO,
		CareerTheme.T_DATO_TUMBADO, CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	return p



func _mt_filas_club(id: String) -> Array:
	var out: Array = []
	var div: int = GameState.div_of(id)
	out.append(_mt_dato(I18n.t("DIVISIÓN"), CareerTheme.caps(Teams.div_short(div)),
		CareerTheme.DANGER if div > GameState.player_div() else CareerTheme.TEXT))
	var snap: Dictionary = Market.club_snapshot(id, GameState.season_num)
	if not snap.is_empty():
		out.append(_mt_dato(I18n.t("PUESTO"), "%s/%d" % [I18n.ordinal(int(snap["league_pos"])),
			int(snap["league_size"])], CareerTheme.TEXT))
	return out


