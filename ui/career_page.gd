func _swap_shop_band(del_club: bool) -> void:
	if _shop_band == null or not is_instance_valid(_shop_band):
		return
	var padre: Node = _shop_band.get_parent()
	if padre == null:
		return
	var donde: int = _shop_band.get_index()
	var vieja: Control = _shop_band
	_shop_band = ClubStore.new() if del_club and ClubStore.available() \
			else Boutique.new()
