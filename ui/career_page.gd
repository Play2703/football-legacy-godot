	action.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(action)
	return info




func _shop_price_of(id: String) -> int:


	for fam in [Shop.BOOTS, Shop.ITEMS, Shop.LIFESTYLE, Shop.INVESTMENTS, Shop.AGENTS,
			Shop.CLUB_MERCH]:
		for d in fam:
			if String((d as Dictionary).get("id", "")) == id:
				return int((d as Dictionary).get("price", 0))
	return 0












static var _merch_fotos: Dictionary = {}


func _merch_icon(id: String) -> Control:
	var kit: Dictionary = GameState.player_kit()
	var clave: String = "%s|%s|%d" % [id, str(kit), GameState.player_number]
	var tr: TextureRect = TextureRect.new()
	if _merch_fotos.has(clave):
		tr.texture = _merch_fotos[clave]
	else:
		var vp: MerchIcon = MerchIcon.new()
		add_child(vp)
		vp.setup(id, kit, GameState.player_number)
		tr.texture = vp.get_texture()
		_hornear_merch(vp, tr, clave)
	tr.custom_minimum_size = Vector2(86, 86)
	tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	tr.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return tr





func _hornear_merch(vp: SubViewport, tr: TextureRect, clave: String) -> void:
	if DisplayServer.get_name() != "headless":
		await get_tree().process_frame
		await RenderingServer.frame_post_draw
	if not is_instance_valid(vp):
		return
	var img: Image = null
	if DisplayServer.get_name() != "headless":
		img = vp.get_texture().get_image()
	var tex: ImageTexture = null
	if img != null and not img.is_empty():
		tex = ImageTexture.create_from_image(img)
		_merch_fotos[clave] = tex
	if is_instance_valid(tr):
		tr.texture = tex
	vp.queue_free()




















