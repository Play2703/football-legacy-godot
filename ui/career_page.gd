func _cal_tint(comp: String) -> Color:
	match comp:
		"league", "liguilla", "campeones", "supercopa":
			return Teams.accent(Teams.country_of(GameState.player_team_id))
		"cup", "copaliga":
			return Competitions.COMP_ACCENT.get("copa", CareerTheme.TEXT_DIM)



		"lib", "sud", "cca", "ace", "ac2", "caf", "cf2", "ofc":
			return Competitions.COMP_ACCENT.get(Continental.marca(comp), CareerTheme.accent_text())
		"recopa", "intercont", "supereuropa", "superafrica":
			return Competitions.COMP_ACCENT.get(Supercopas.marca(comp), CareerTheme.accent_text())
		"ligas":
			return Competitions.COMP_ACCENT.get(CopaLigas.COMP, CareerTheme.accent_text())
		"nat":





			var mio: Dictionary = Nations.as_team(Career.nationality)
			if mio.is_empty():
				return Competitions.COMP_ACCENT.get("mundial", CareerTheme.MONEY)
			return CareerTheme.accent_of(mio)
		_:
			return Competitions.COMP_ACCENT.get(comp, CareerTheme.accent_text())





