const TORN_RONDA_CORTA: Dictionary = {"Dieciseisavos": "16avos", "Treintaidosavos": "32avos",
	"Primera ronda": "1.ª ronda", "Segunda ronda": "2.ª ronda", "Tercera ronda": "3.ª ronda",
	"Cuarta ronda": "4.ª ronda", "Quinta ronda": "5.ª ronda", "Sexta ronda": "6.ª ronda",
	"Séptima ronda": "7.ª ronda", "Octava ronda": "8.ª ronda", "Fase de grupos": "GRUPOS",
	"DUELO DE CAMPEONES": "Final"}












func _torn_camino(bracket: Array, names: Array, accent: Color, actual: int = -1,
		vivo: bool = true, campeon: bool = false, cal_comp: String = "",
		cal_campo: String = "") -> void:
	var v: VBoxContainer = VBoxContainer.new()
	v.name = "Camino"
	v.add_theme_constant_override("separation", 0)
	v.size_flags_vertical = Control.SIZE_EXPAND_FILL
	var caido: bool = false
	var rondas: int = maxi(names.size(), bracket.size())
	for r in rondas:
		var tie: Dictionary = {}
		if r < bracket.size():
			for t in bracket[r]:
				var d: Dictionary = t
				if _torn_soy(String(d.get("a", ""))) or _torn_soy(String(d.get("b", ""))):
					tie = d
					break
		var ronda: String = CareerTheme.caps(I18n.t(String(TORN_RONDA_CORTA.get(
			String(names[r]), names[r])))) if r < names.size() else str(r + 1)
		var tuya: bool = vivo and not campeon and r == actual
		var apagada: bool = false
		var rival: String = ""
		var dato: String = ""
		var dato_tam: int = CareerTheme.T_LEE_TUMBADO
		var dato_color: Color = CareerTheme.TEXT_MID
		var nombre: String = ""
		if caido:
			apagada = true
		elif not tie.is_empty():
			var soy_a: bool = _torn_soy(String(tie.get("a", "")))
			rival = String(tie.get("b", "")) if soy_a else String(tie.get("a", ""))
			nombre = _torn_nombre_de(rival)
			var w: String = String(tie.get("winner", ""))
			var marcador: String = String(tie.get("score", ""))
			if marcador.is_empty():
				marcador = String(tie.get("leg1", ""))
			var g: Array = Liguilla.goles(marcador)
			if not soy_a and g.size() == 2:
				marcador = "%d-%d" % [int(g[1]), int(g[0])]
			if not w.is_empty():
				dato = marcador
				dato_tam = CareerTheme.T_DATO_TUMBADO
				dato_color = accent if _torn_soy(w) else CareerTheme.DANGER
				caido = not _torn_soy(w)
			elif not marcador.is_empty():

				dato = marcador
				dato_tam = CareerTheme.T_DATO_TUMBADO
			else:
				dato = _torn_semana(cal_comp, cal_campo, r)
		elif actual >= 0 and r < actual:
			apagada = true
			nombre = I18n.t("EXENTO")
		elif not vivo:
			apagada = true
		else:
			apagada = true
			nombre = I18n.t("POR DEFINIR")
			dato = _torn_semana(cal_comp, cal_campo, r)
		var color_txt: Color = CareerTheme.TEXT_DIM if apagada else CareerTheme.TEXT
		var celdas: Array = [
			{"texto": ronda, "ancho": TORN_COL_RONDA,
				"color": CareerTheme.TEXT_DIM if apagada else CareerTheme.TEXT_MID}]
		if not rival.is_empty():
			celdas.append({"nodo": _torn_camino_escudo(rival, TORN_CAMINO_ESCUDO)})
		else:



			var hueco: Control = Control.new()
			hueco.custom_minimum_size = Vector2(TORN_CAMINO_ESCUDO, TORN_CAMINO_ESCUDO)
			hueco.mouse_filter = Control.MOUSE_FILTER_IGNORE
			hueco.visible = false
			celdas.append({"nodo": hueco})
		celdas.append({"texto": nombre, "expand": true, "color": color_txt})
		celdas.append({"texto": dato, "ancho": TORN_COL_MARCADOR, "derecha": true,
			"tam": dato_tam, "color": CareerTheme.TEXT_DIM if apagada else dato_color})

		var cola: Control = Control.new()
		cola.custom_minimum_size = Vector2(TORN_CAMINO_COLA, 0.0)
		cola.mouse_filter = Control.MOUSE_FILTER_IGNORE
		celdas.append({"nodo": cola})
		var fila: PanelContainer = CareerUi.fila_tumbada(TORN_CAMINO_FILA_H, Color.TRANSPARENT,
			celdas, tuya, accent)




		var gastada: bool = rival.is_empty() and dato.is_empty()
		fila.size_flags_vertical = Control.SIZE_FILL if gastada else Control.SIZE_EXPAND_FILL
		fila.set_meta("torn_camino_gastada", gastada)
		fila.set_meta("torn_ronda", r)

		fila.set_meta("torn_camino_rival", not rival.is_empty())

		var hechas: Array = fila.get_meta("fila_celdas", [])
		if hechas.size() >= 4:
			(hechas[3] as Control).set_meta("torn_camino_cifra",
				dato_tam == CareerTheme.T_DATO_TUMBADO)


			if not rival.is_empty():
				(hechas[2] as Control).set_meta("torn_camino_entero", nombre)
				(hechas[2] as Control).set_meta("torn_camino_sigla",
					CareerTheme.caps(_torn_sigla_de(rival)))
		v.add_child(fila)
	if v.get_child_count() == 0:
		v.free()
		return

	v.resized.connect(_torn_camino_nivel.bind(v))
	_content.add_child(v)













func _torn_camino_nivel(v: VBoxContainer, semana_cifra: bool = false) -> void:
	if not is_instance_valid(v) or v.size.y <= 0.0:
		return
	var filas: Array = []
	for h in v.get_children():
		if h.has_meta("torn_ronda") and h.has_meta("fila_celdas"):
			filas.append(h)
	if filas.is_empty():
		return


	var fijo: float = 0.0
	var repartidas: int = 0
	for fila in filas:
		if bool((fila as Node).get_meta("torn_camino_gastada", false)):

			fijo +=(fila as Control).get_combined_minimum_size().y
		else:
			repartidas += 1
	var alto: float =(v.size.y - fijo) / float(maxi(1, repartidas))
	var escudo: float = TORN_CAMINO_ESCUDO
	var letra: int = CareerTheme.T_LEE_TUMBADO
	var cifra: int = CareerTheme.T_DATO_TUMBADO
	if alto >= TORN_CAMINO_ALTO_96:
		escudo = 96.0
		letra = CareerTheme.T_DATO_TUMBADO
		cifra = CareerTheme.T_TITULO_TUMBADO
	elif alto >= TORN_CAMINO_ALTO_72:
		escudo = 72.0
		letra = CareerTheme.T_DATO_TUMBADO
		cifra = CareerTheme.T_TITULO_TUMBADO
	var firma: String = "%d|%d|%d|%d" % [roundi(escudo), letra, cifra, roundi(v.size.x)]
	if not semana_cifra:
		if String(v.get_meta("torn_camino_nivel", "")) == firma:
			return
		v.set_meta("torn_camino_nivel", firma)
	var fuente: Font = null
	var col_ronda: float = TORN_COL_RONDA


	var col_dato: float = TORN_COL_MARCADOR if escudo <= TORN_CAMINO_ESCUDO else 0.0

	var con_hueco: float = 0.0
	for fila in filas:
		var celdas: Array =(fila as Node).get_meta("fila_celdas")
		if celdas.size() < 4:
			continue
		var ronda: Label = celdas[0] as Label
		var dato: Label = celdas[3] as Label
		if ronda == null or dato == null:
			continue
		if fuente == null:
			fuente = ronda.get_theme_font("font")
		if fuente == null:
			break
		var tam_dato: int = cifra if semana_cifra or bool(dato.get_meta("torn_camino_cifra", false)) \
				else letra
		col_ronda = maxf(col_ronda, _torn_camino_col(fuente, ronda.text, letra))


		col_ronda = maxf(col_ronda, ceilf((fuente.get_string_size(ronda.text,
			HORIZONTAL_ALIGNMENT_LEFT, -1.0, letra).x + TORN_CAMINO_AIRE_RONDA
			- float(CareerUi.FILA_TUMBADA_SEP)) / 8.0) * 8.0)
		col_dato = maxf(col_dato, _torn_camino_col(fuente, dato.text, tam_dato))
		if not dato.text.strip_edges().is_empty():
			con_hueco = maxf(con_hueco, _torn_camino_col(fuente, dato.text, tam_dato)
				+ TORN_CAMINO_HUECO_DATO)




	var ganado: float = maxf(0.0, con_hueco - col_dato)
	col_dato += ganado



	var sep: float = float(CareerUi.FILA_TUMBADA_SEP)
	var celda_esc: float = escudo + TORN_CAMINO_AIRE_ESCUDO
	var resto: float = v.size.x - float(CareerUi.FILA_TUMBADA_CANAL) - CareerUi.FILA_TUMBADA_FRANJA \
			- col_ronda - celda_esc - col_dato - TORN_CAMINO_COLA - 6.0 * sep

	_torn_camino_siglas(filas, fuente, INF, CareerTheme.T_LEE_TUMBADO)






	var letra_nombre: int = _torn_camino_letra_nombre(filas, fuente, resto, false,
		[letra, CareerTheme.T_LEE_TUMBADO])
	var letra_rival: int = letra_nombre
	if escudo > TORN_CAMINO_ESCUDO:
		letra_rival = _torn_camino_letra_nombre(filas, fuente, resto, true,
			[CareerTheme.T_TITULO_TUMBADO, letra, CareerTheme.T_LEE_TUMBADO])






	_torn_camino_siglas(filas, fuente, resto, letra_rival)
	var reparto: Vector2 = _torn_camino_aire(filas, fuente, resto, celda_esc, col_ronda, col_dato,
		letra, cifra, letra_nombre, letra_rival, ganado, semana_cifra)


	if letra_rival > letra and reparto.y > v.size.x * TORN_CAMINO_HUECO:
		var baja: int = _torn_camino_letra_nombre(filas, fuente, resto, true,
			[letra, CareerTheme.T_LEE_TUMBADO])
		_torn_camino_siglas(filas, fuente, resto, baja)
		var bajado: Vector2 = _torn_camino_aire(filas, fuente, resto, celda_esc, col_ronda,
			col_dato, letra, cifra, letra_nombre, baja, ganado, semana_cifra)
		if bajado.y < reparto.y:
			letra_rival = baja
			reparto = bajado
		else:
			_torn_camino_siglas(filas, fuente, resto, letra_rival)
	var aire: float = reparto.x












	var aire_libre: float = aire
	var queda: float = reparto.y
	if reparto.y > v.size.x * TORN_CAMINO_HUECO:
		var libres: Array = filas.filter(func(f: Variant) -> bool:
			return not bool((f as Node).get_meta("torn_camino_rival", false)))
		if not libres.is_empty() and libres.size() < filas.size():
			var suyo: Vector2 = _torn_camino_aire(libres, fuente, resto, celda_esc, col_ronda,
				col_dato, letra, cifra, letra_nombre, letra_rival, ganado, semana_cifra)
			aire_libre = maxf(aire, suyo.x)



			var rivales: Array = filas.filter(func(f: Variant) -> bool:
				return bool((f as Node).get_meta("torn_camino_rival", false)))
			queda = maxf(_torn_camino_aire(libres, fuente, resto, celda_esc, col_ronda, col_dato,
				letra, cifra, letra_nombre, letra_rival, ganado, semana_cifra, aire_libre).y,
				_torn_camino_aire(rivales, fuente, resto, celda_esc, col_ronda, col_dato, letra,
				cifra, letra_nombre, letra_rival, ganado, semana_cifra, aire).y)






	if not semana_cifra and queda > v.size.x * TORN_CAMINO_HUECO:
		_torn_camino_nivel(v, true)
		return
	for fila in filas:
		var celdas: Array =(fila as Node).get_meta("fila_celdas")
		if celdas.size() < 4:
			continue
		var ronda: Label = celdas[0] as Label
		if ronda != null:
			ronda.add_theme_font_size_override("font_size", letra)
			ronda.custom_minimum_size.x = col_ronda +(aire if bool((fila as Node).get_meta(
				"torn_camino_rival", false)) else aire_libre)
		var nombre: Label = celdas[2] as Label
		var letra_fila: int = letra_rival if bool((fila as Node).get_meta("torn_camino_rival", false)) \
				else letra_nombre


		var sangria: float = 0.0
		if nombre != null:
			sangria = _torn_sangria(nombre.get_theme_font("font"), nombre.text, letra_fila)
		_torn_camino_escudo_mide(celdas[1] as Control, escudo, sangria)
		if nombre != null:
			nombre.add_theme_font_size_override("font_size", letra_fila)
		var dato: Label = celdas[3] as Label
		if dato != null:
			dato.add_theme_font_size_override("font_size",
				cifra if semana_cifra or bool(dato.get_meta("torn_camino_cifra", false)) else letra)
			dato.custom_minimum_size.x = col_dato
	v.set_meta("torn_camino_escudo", escudo)
	v.set_meta("torn_camino_letra", letra_nombre)
	v.set_meta("torn_camino_letra_rival", letra_rival)
	v.set_meta("torn_camino_aire", aire)
















func _torn_camino_aire(filas: Array, fuente: Font, resto: float, escudo: float,
		col_ronda: float, col_dato: float, letra: int, cifra: int, letra_nombre: int,
		letra_rival: int, hueco: float = 0.0, semana_cifra: bool = false,
		aire_fijo: float = -1.0) -> Vector2:
	if fuente == null:
		return Vector2.ZERO
	var sep: float = float(CareerUi.FILA_TUMBADA_SEP)
	var tras_ronda: float = 0.0
	var ante_dato: float = 0.0
	var cabe: float = INF
	for fila in filas:
		var n: Node = fila as Node
		var celdas: Array = n.get_meta("fila_celdas")
		if celdas.size() < 4:
			continue
		var ronda: Label = celdas[0] as Label
		var nombre: Label = celdas[2] as Label
		var dato: Label = celdas[3] as Label
		if ronda == null or nombre == null or dato == null:
			continue
		var rival: bool = bool(n.get_meta("torn_camino_rival", false))
		var w_n: float = fuente.get_string_size(nombre.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0,
			letra_rival if rival else letra_nombre).x

		var sitio: float = resto if rival else resto + escudo + sep




		cabe = minf(cabe, sitio - w_n - maxf(0.0, TORN_CAMINO_AIRE_DATO - hueco))
		if bool(n.get_meta("torn_camino_gastada", false)):
			continue
		var w_r: float = fuente.get_string_size(ronda.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0,
			letra).x
		var w_d: float = 0.0
		if not dato.text.strip_edges().is_empty():
			w_d = fuente.get_string_size(dato.text, HORIZONTAL_ALIGNMENT_LEFT, -1.0,
				cifra if semana_cifra or bool(dato.get_meta("torn_camino_cifra", false)) else letra).x
		var bloque: float =(escudo + sep + w_n) if rival else w_n
		tras_ronda = maxf(tras_ronda, col_ronda - w_r)
		ante_dato = maxf(ante_dato, escudo + sep + resto - bloque + col_dato - w_d)
	if cabe == INF:
		return Vector2.ZERO
	var aire: float = floorf((ante_dato - tras_ronda) * 0.5 / 8.0) * 8.0
	aire = clampf(aire, 0.0, maxf(0.0, floorf(cabe / 8.0) * 8.0))
	if aire_fijo >= 0.0:
		aire = aire_fijo
	return Vector2(aire, maxf(tras_ronda + aire, ante_dato - aire) + sep)





func _torn_camino_letra_nombre(filas: Array, fuente: Font, resto: float, rivales: bool,
		letras: Array) -> int:
	if fuente == null:
		return int(letras[letras.size() - 1])
	for tam in letras:
		var caben: bool = true
		for fila in filas:
			if bool((fila as Node).get_meta("torn_camino_rival", false)) != rivales:
				continue
			var celdas: Array =(fila as Node).get_meta("fila_celdas")
			var nombre: Label = celdas[2] as Label if celdas.size() >= 3 else null
			if nombre != null and fuente.get_string_size(nombre.text,
					HORIZONTAL_ALIGNMENT_LEFT, -1.0, int(tam)).x > resto:
				caben = false
				break
		if caben:
			return int(tam)
	return int(letras[letras.size() - 1])








func _torn_camino_siglas(filas: Array, fuente: Font, resto: float, letra: int) -> void:
	for fila in filas:
		var celdas: Array =(fila as Node).get_meta("fila_celdas")
		var nombre: Label = celdas[2] as Label if celdas.size() >= 3 else null
		if nombre == null or not nombre.has_meta("torn_camino_entero"):
			continue
		var entero: String = String(nombre.get_meta("torn_camino_entero"))
		var sigla: String = String(nombre.get_meta("torn_camino_sigla", ""))
		var no_cabe: bool = fuente != null and resto < INF and fuente.get_string_size(entero,
			HORIZONTAL_ALIGNMENT_LEFT, -1.0, letra).x > resto
		nombre.text = sigla if no_cabe and not sigla.is_empty() else entero




func _torn_camino_col(fuente: Font, texto: String, tam: int) -> float:
	var w: float = fuente.get_string_size(texto, HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x
	return ceilf(w / 8.0) * 8.0















func _torn_camino_escudo(club: String, lado: float) -> Control:
	var escudo: Control = _torn_escudo(club, lado)
	var aspecto: float = 1.0
	var cr: CrestView = escudo as CrestView
	if cr != null and cr.is_logo():
		var tex: Texture2D = CrestLogos.texture(String(cr.get("_logo_id")))
		if tex != null and tex.get_height() > 0:
			aspecto = clampf(float(tex.get_width()) / float(tex.get_height()), 0.05, 1.0)
	var caja: Control = Control.new()
	caja.name = "EscudoCamino"
	caja.mouse_filter = Control.MOUSE_FILTER_IGNORE
	escudo.custom_minimum_size = Vector2.ZERO
	caja.add_child(escudo)
	caja.set_meta("torn_camino_logo", escudo)
	caja.set_meta("torn_camino_aspecto", aspecto)
	_torn_camino_escudo_mide(caja, lado)
	return caja







func _torn_camino_escudo_mide(celda: Control, lado: float, sangria: float = 0.0) -> void:
	if celda == null:
		return
	if not celda.has_meta("torn_camino_logo"):
		celda.custom_minimum_size = Vector2(lado, lado)
		return



	sangria = clampf(sangria, 0.0, TORN_CAMINO_AIRE_ESCUDO)
	celda.custom_minimum_size = Vector2(lado + TORN_CAMINO_AIRE_ESCUDO - sangria, lado)
	var escudo: Control = celda.get_meta("torn_camino_logo") as Control
	var ancho: float = lado * float(celda.get_meta("torn_camino_aspecto", 1.0))

	var corre: float = 0.0
	var cr: CrestView = escudo as CrestView
	if cr != null and not cr.is_logo():
		corre = clampf(lado - cr.tinta_en(Vector2(lado, lado)).end.x, 0.0, lado * 0.5)
	escudo.anchor_left = 1.0
	escudo.anchor_right = 1.0
	escudo.anchor_top = 0.0
	escudo.anchor_bottom = 1.0
	escudo.offset_left = - TORN_CAMINO_AIRE_ESCUDO - ancho + corre + sangria
	escudo.offset_right = - TORN_CAMINO_AIRE_ESCUDO + corre + sangria
	escudo.offset_top = 0.0
	escudo.offset_bottom = 0.0








func _torn_sangria(fuente: Font, texto: String, tam: int) -> float:
	if fuente == null or texto.is_empty() or tam <= 0:
		return 0.0
	var ts: TextServer = TextServerManager.get_primary_interface()
	var c: int = texto.unicode_at(0)
	for rid in fuente.get_rids():
		if not ts.font_has_char(rid, c):
			continue
		var g: int = ts.font_get_glyph_index(rid, tam, c, 0)
		var pts: PackedVector3Array = ts.font_get_glyph_contours(rid, tam, g).get("points",
			PackedVector3Array())
		var lo: float = INF
		for p in pts:
			lo = minf(lo, p.x)
		return maxf(0.0, lo) if lo != INF else 0.0
	return 0.0





func _torn_semana(cal_comp: String, cal_campo: String, ronda: int) -> String:

	if cal_comp == CopaLigas.COMP:
		var k: int = _torn_ligas_fecha(ronda)
		return I18n.tf("S{0}", [k + 1]) if k >= 0 else ""
	if cal_comp.is_empty() or cal_campo.is_empty():
		return ""
	for k in GameState.calendar.size():
		var f: Dictionary = GameState.calendar[k]
		if String(f.get("comp", "")) == cal_comp and int(f.get(cal_campo, -1)) == ronda:
			return I18n.tf("S{0}", [k + 1])
	return ""

