const GER_TUYOS_VISIBLE: int = 4






func _gerencia_tuyos_block() -> void:
	var tuyos: Array = Career.gerencia_tuyos_vista()
	if tuyos.is_empty():
		return
	CareerUi.head(_content, I18n.t("TUS FICHAJES"))
	for i in mini(tuyos.size(), GER_TUYOS_VISIBLE):
		var t: Dictionary = tuyos[i]
		var caja: PanelContainer = CareerUi.plate()
		_content.add_child(caja)
		var col: VBoxContainer = VBoxContainer.new()
		col.add_theme_constant_override("separation", 8)
		caja.add_child(col)
		var nom: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT)
		nom.text = CareerTheme.caps(Competitions.demarca(String(t.get("name", ""))))
		nom.clip_text = true
		col.add_child(nom)
		var fee: int = int(t.get("fee", 0))
		var pie: Label = CareerUi.plain(CareerTheme.T_CAPTION, CareerTheme.TEXT_DIM)


		pie.text = I18n.tf("{0} · {1}", ["T%d" % maxi(int(t.get("season", 1)), 1),
			CareerUi.short_money(fee) if fee > 0 else I18n.t("LIBRE")])
		if int(t.get("fuera", -1)) >= 0:
			pie.text += " · " + I18n.t("YA NO ESTA")
		pie.clip_text = true
		col.add_child(pie)
		var gp: int = int(t.get("gp", 0))
		if gp <= 0:
			continue
		var linea: HBoxContainer = HBoxContainer.new()
		linea.add_theme_constant_override("separation", 18)
		col.add_child(linea)
		for spec in [["partido", str(gp), CareerTheme.STAT_AVG],
				["media", "%.1f" %(float(t.get("rs", 0.0)) / float(gp)),
					CareerTheme.STAT_AVG],
				["gol", str(int(t.get("g", 0))), CareerTheme.STAT_GOAL],
				["asist", str(int(t.get("a", 0))), CareerTheme.STAT_ASSIST]]:
			var cel: HBoxContainer = CareerUi.icon_stat(String(spec[0]),
				String(spec[1]), spec[2], 30.0)
			cel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			cel.alignment = BoxContainer.ALIGNMENT_CENTER
			linea.add_child(cel)




