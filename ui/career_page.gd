func _standings_row(pos: int, club_id: String, club_name: String, you: bool,
		band_color: Color, nums: Array, pts: int, accent: Color,
		crest_size: float = 28.0, sancion: bool = false) -> void:
	var color: Color = accent if you else CareerTheme.TEXT
	var line: HBoxContainer = HBoxContainer.new()
	line.add_theme_constant_override("separation", 8)
	_content.add_child(line)


	var band: ColorRect = ColorRect.new()
	band.color = band_color
	band.custom_minimum_size = Vector2(6, crest_size + 2.0)
	band.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(band)
	var pos_l: Label = CareerUi.plain(CareerTheme.T_BODY, color)
	pos_l.text = "%2d." % pos
	pos_l.custom_minimum_size = Vector2(TBL_POS_W, 0)
	pos_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(pos_l)
	var team: Dictionary = Teams.by_id(club_id)


	if team.is_empty():
		team = Nations.as_team(club_id)
	if team.is_empty():
		line.add_child(_tbl_gap(28.0))
	else:
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(crest_size, crest_size)
		crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		crest.set_team(team)
		line.add_child(crest)
	var name_l: Label = CareerUi.plain(CareerTheme.T_BODY, color)
	name_l.text = CareerUi.with_you(club_name) if you else club_name
	name_l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	name_l.clip_text = true
	name_l.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	name_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(name_l)
	for n in nums:
		var v: Label = CareerUi.plain(CareerTheme.T_BODY, color)
		v.text = str(int(n))
		v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		v.custom_minimum_size = Vector2(TBL_NUM_W, 0)
		v.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		line.add_child(v)


	var pts_l: Label = CareerUi.plain(CareerTheme.T_BODY,
		CareerTheme.DANGER if sancion else (color if you else accent))
	pts_l.text = str(pts)
	pts_l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	pts_l.custom_minimum_size = Vector2(TBL_NUM_W + 14.0, 0)
	pts_l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	line.add_child(pts_l)







func _torn_previa(cam: Dictionary, state: Dictionary) -> void:
	var cruce: PanelContainer = _torn_previa_cruce(cam)
