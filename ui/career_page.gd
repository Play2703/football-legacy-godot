func _pf_t_mas_menos(nombre: String, texto: String, kind: CareerTheme.Kind, apagado: bool, cb: Callable,
		lado: float = PF_T_BOTON) -> Button:
	var b: Button = Button.new()
	b.name = nombre
	b.text = texto
	b.custom_minimum_size = Vector2(lado, lado)
	b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	b.disabled = apagado
	CareerTheme.apply_button(b, kind, CareerTheme.T_DATO_TUMBADO)


	for estado in ["normal", "hover", "pressed", "disabled", "focus"]:
		var sb: StyleBoxFlat = b.get_theme_stylebox(estado) as StyleBoxFlat
		if sb == null:
			continue
		sb = sb.duplicate()
		sb.content_margin_left = PF_T_AIRE
		sb.content_margin_right = PF_T_AIRE
		sb.content_margin_top = 2.0 + float(CareerTheme.SINK - sb.border_width_bottom)
		sb.content_margin_bottom = 2.0 + float(sb.border_width_bottom)
		b.add_theme_stylebox_override(estado, sb)
	b.pressed.connect(cb)
	return b


