			_page_noticias()
		"fichajes":
			_page_fichajes()
		"historia":
			_page_historia()
		"legado":
			_page_legado()
		"aspecto":
			_page_aspecto()
		"casa":
			_page_casa()
		"entreno":
			_page_entreno()
		"plantilla":
			_page_plantilla()
		"gerencia":
