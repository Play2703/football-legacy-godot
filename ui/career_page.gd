func _torn_fase_de(t: Dictionary) -> String:
	var names: Array = t.get("ko_names", [])
	var br: Array = t.get("bracket", [])
	for r in br.size():
		for tie in br[r]:
			if String((tie as Dictionary).get("winner", "")).is_empty() and r < names.size():
				return CareerTheme.caps(I18n.t(String(names[r])))
	if not br.is_empty() and br.size() < names.size():
		return CareerTheme.caps(I18n.t(String(names[br.size()])))
	if not br.is_empty() and not names.is_empty():
		return CareerTheme.caps(I18n.t(String(names[names.size() - 1])))
	var groups: Array = t.get("groups", [])
	if groups.size() == 1:
		return CareerTheme.caps(I18n.t("FASE DE LIGA"))
	return CareerTheme.caps(I18n.t("GRUPOS"))



















