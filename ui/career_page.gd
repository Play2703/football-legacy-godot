func _pr_contrato(col: VBoxContainer, v: Dictionary, t: bool) -> void:
	var wage: int = int(v["ficha"])
	if t:
		var cab: HBoxContainer = HBoxContainer.new()
		cab.name = "Cabecera"
		cab.add_theme_constant_override("separation", 16)
		cab.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(cab)
		var ic: MenuIcon = MenuIcon.new()
		ic.custom_minimum_size = Vector2(32.0, 32.0)
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ic.setup("contrato", CareerTheme.TEXT_MID)
		cab.add_child(ic)
		var tit: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT,
			CareerTheme.caps(I18n.t("TU CONTRATO PAGA")))
		tit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		tit.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		cab.add_child(tit)
		var fr: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_DIM,
			CareerTheme.caps(I18n.t("FICHA")), false)
		fr.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		cab.add_child(fr)
		var fv: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.MONEY,
			"$ %s" % CareerUi.money(wage), false)
		fv.name = "Ficha"
		fv.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		cab.add_child(fv)
	else:
		CareerUi.head(col, I18n.t("TU CONTRATO PAGA"))
		CareerUi.kv(col, I18n.t("FICHA"), "$ %s" % CareerUi.money(wage), CareerTheme.MONEY)

	_pr_seccion(col, "TÍTULOS", t)
	var g_tit: GridContainer = _pr_rejilla(col, "Titulos", 3)
	var primero: bool = true
	for d in v["titulos"]:
		var k: String = String(d["kind"])
		var m: float = float(d["mult"])
		var n: int = maxi(0, Clausulas.TITULO_MULT.find(m))
		var tro: TrophyIcon = TrophyIcon.new()
		tro.set_type(k)
		var b: Button = _pr_baldosa("Titulo_" + k, tro, I18n.t(Competitions.comp_name(k)),
			int(d["monto"]), PR_BALDOSA_H, _pr_modal_titulo.bind(d, wage), true,
			I18n.t(ClausulasEditor.NIVELES[n]) if m > 1.0 else "")

		if primero:
			b.set_meta(Entrada.PRIMERO_META, true)
			primero = false
		g_tit.add_child(b)




	_pr_seccion(col, "PREMIOS", t)
	var g_pre: GridContainer = _pr_rejilla(col, "Premios", 2)
	for d in v["premios"]:
		var a: String = String(d["award"])
		var tro: TrophyIcon = TrophyIcon.new()
		tro.set_type(String(Trophies.of(a).get("type", "")))
		g_pre.add_child(_pr_baldosa("Premio%d" % g_pre.get_child_count(), tro,
			I18n.t(String(PR_PREMIO_ROTULO.get(a, a))), int(d["monto"]), PR_BALDOSA_H,
			_pr_modal_premio.bind(d), true))

	_pr_seccion(col, "CADA PARTIDO", t)
	var g_par: GridContainer = _pr_rejilla(col, "Partido", 2)
	var gol: MenuIcon = MenuIcon.new()
	gol.setup("gol", CareerTheme.MONEY)
	g_par.add_child(_pr_baldosa("Gol", gol, I18n.t("GOL"), int(v["gol"]), PR_PARTIDO_H,
		_pr_modal_partido.bind(true, v), false))
	var asi: MenuIcon = MenuIcon.new()
	asi.setup("asist", CareerTheme.MONEY)
	g_par.add_child(_pr_baldosa("Asist", asi, I18n.t("ASISTENCIA"), int(v["asist"]),
		PR_PARTIDO_H, _pr_modal_partido.bind(false, v), false))





