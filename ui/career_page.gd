func _rumor_fila(r: Dictionary) -> void:
	var club_id: String = String(r["id"])
	var team: Dictionary = Teams.by_id(club_id)
	if team.is_empty():
		return






	var sembrado: bool = Career.seeded_rumors().has(club_id)
	if sembrado and not bool(r.get("seen", false)):
		r = r.duplicate()
		r["seen"] = true
	var caja: PanelContainer = PanelContainer.new()
	var sb: StyleBoxFlat = StyleBoxFlat.new()
	sb.bg_color = CareerTheme.SURFACE
	sb.border_color = CareerTheme.SURFACE_HI
	sb.set_border_width_all(2)
	sb.set_corner_radius_all(6)
	sb.set_content_margin_all(12.0)
	caja.add_theme_stylebox_override("panel", sb)
	_content.add_child(caja)
	_con_uniforme(caja, team)
	var fila: HBoxContainer = HBoxContainer.new()
	fila.add_theme_constant_override("separation", 12)
	caja.add_child(fila)
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(64, 64)
	crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	crest.set_team(team)
	fila.add_child(_escudo_en_disco(crest))
	var datos: VBoxContainer = VBoxContainer.new()
	datos.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	datos.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	datos.add_theme_constant_override("separation", 4)
	fila.add_child(datos)
	var nom: Label = CareerUi.plain(CareerTheme.T_CARD, CareerTheme.TEXT)
	nom.text = CareerTheme.caps(String(r.get("name", club_id)))
	nom.clip_text = true
	datos.add_child(nom)
	datos.add_child(_club_sub_row(club_id, String(r.get("league", ""))))
	var sello: Array = _rumor_sello(r)
	var calor: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.accent() if bool(sello[2])
		else (CareerTheme.TEXT if int(sello[1]) >= 1 else CareerTheme.TEXT_DIM))
	calor.text = I18n.t("LE DISTE PIE") if Career.courting_club == club_id \
			else String(sello[0])
	calor.clip_text = true
	datos.add_child(calor)
	var botones: VBoxContainer = VBoxContainer.new()
	botones.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	botones.add_theme_constant_override("separation", 8)
	fila.add_child(botones)







	if not Career.market_open() and Career.courting_club.is_empty():
		var pie: Button = CareerUi.hold_button(botones, I18n.t("LE DOY PIE"), RUMOR_HOLD_S,
			func() -> void: Career.nudge_club(club_id), CareerTheme.T_DIM, CareerTheme.GOOD)
		pie.custom_minimum_size = Vector2(230, 56)
	if sembrado:
		return
	var fuera: Button = CareerUi.hold_button(botones, I18n.t("NO ME INTERESA"), RUMOR_HOLD_S,
		func() -> void: Career.dismiss_rumor(club_id), CareerTheme.T_DIM, CareerTheme.DANGER)
	fuera.custom_minimum_size = Vector2(230, 56)



