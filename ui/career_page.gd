func _to_t_plan(casillas: int) -> Array:
	var n: int = _to_t_filas.size()
	var out: Array = []
	if casillas >= n:
		for i in n:
			out.append(i)
		return out
	var pon: Callable = func(i: int) -> void:
		if i >= 0 and i < n and not out.has(i) and out.size() < casillas:
			out.append(i)
	for i in [_to_t_sel, _to_t_sel - 1, _to_t_sel + 1, _to_t_tu]:
		pon.call(int(i))
	var ultima: String = String(_to_t_zonas[n - 1]) if n > 0 else ""
	var fondo: int = 1
	if not ultima.is_empty():
		while fondo < n and String(_to_t_zonas[n - 1 - fondo]) == ultima:
			fondo += 1
	fondo = mini(fondo, maxi(floori(float(casillas) / 3.0), 1))
	for j in fondo:
		pon.call(n - 1 - j)
	for i in n:
		pon.call(i)
	out.sort()
	return out



func _to_t_alto(plan: Array) -> float:
	var alto: float = float(plan.size()) * TO_T_FILA_H
	for j in range(1, plan.size()):
		if int(plan[j]) != int(plan[j - 1]) + 1:
			alto += TO_T_SALTO
	return alto



func _to_t_plan_que_cabe(alto: float) -> Array:
	var c: int = maxi(floori(alto / TO_T_FILA_H), 1)
	var plan: Array = _to_t_plan(c)
	while c > 1 and _to_t_alto(plan) > alto + 0.5:
		c -= 1
		plan = _to_t_plan(c)
	return plan






func _to_t_llena(filas: VBoxContainer) -> void:
	if not is_instance_valid(filas) or not filas.is_inside_tree() or filas.size.y <= 0.0:
		return
	var alto: float = filas.size.y
	if is_instance_valid(_scroll) and is_instance_valid(_placa) and _placa.get_parent() == _scroll:
		alto -= maxf(_placa.get_combined_minimum_size().y - _scroll.size.y, 0.0)
	var plan: Array = _to_t_plan_que_cabe(alto)
	if plan !=(filas.get_meta("to_t_plan", []) as Array):
		_to_t_pinta(filas, plan)


func _to_t_llena_scroll() -> void:
	if _page == "torneos" and is_instance_valid(_to_t_caja_filas):
		_to_t_llena(_to_t_caja_filas)


func _to_t_pinta(filas: VBoxContainer, plan: Array) -> void:
	var con_foco: bool = false
	for c in filas.get_children():
		if c is Control and (c as Control).has_focus():
			con_foco = true
		filas.remove_child(c)
		c.queue_free()
	var antes: int = -1
	for v in plan:
		var i: int = int(v)
		if antes >= 0 and i != antes + 1:
			filas.add_child(_to_t_salto())
		filas.add_child(_to_t_fila(i))
		antes = i
	filas.set_meta("to_t_plan", plan)
	_to_t_vecinos()
	if con_foco:
		var b: Button = filas.find_child("Fila%d" % _to_t_sel, false, false) as Button
		if b != null:
			b.grab_focus.call_deferred()



