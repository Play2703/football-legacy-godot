const CAL_COMP_W: float = 178.0


func _page_calendario() -> void:
	var filas: Array = _cal_rows()
	if filas.is_empty():
		CareerUi.dim(_content, I18n.t("La temporada aún no tiene calendario."))
		return
	var g: int = 0
	var e: int = 0
	var p: int = 0
	for f in filas:
		if not bool(f["jugado"]):
			continue
		match String(f["res"]):
			"G": g += 1
			"E": e += 1
			_: p += 1
	if UiKit.es_horizontal():




		_cal_tumbado(filas, g, e, p)
		return
	_cal_resumen(g, e, p)



	var con_dia: bool = true
	for f in filas:
		if not CalendarioMundo.dia_conocido(int(f["dia"])):
			con_dia = false
			break
	if con_dia:




		_cal_proximo(filas)
		_cal_filtros(filas)
		var rejilla: VBoxContainer = _cal_rejilla(filas)
		if not _cal_al_mes_hecho:
			_cal_al_mes_hecho = true
			_cal_baja_al_mes(rejilla)
		return







	var lista: VBoxContainer = VBoxContainer.new()
	lista.add_theme_constant_override("separation", 6)
	_content.add_child(lista)
	var mes: int = 0
	for f in filas:
		if int(f["mes"]) > 0 and int(f["mes"]) != mes:
			mes = int(f["mes"])
			_cal_mes(lista, mes)
		_cal_fila(lista, f)





func _cal_rows() -> Array:



	var club: Dictionary = Teams.by_id(GameState.player_team_id)


	var pais: String = Teams.country_of(GameState.player_team_id)
	var jornadas: int = CalendarioMundo.league_len_de(pais, GameState.player_div())
	var out: Array = []



	var dias: Array = GameState.dias_fixtures()
	for i in GameState.calendar.size():
		var f: Dictionary = GameState.calendar[i]
		if bool(f.get("dead", false)):
			continue
		var riv: Dictionary = GameState.rival_of(f)
		if riv.is_empty():
			continue
		var yo: Dictionary = club
		if String(f.get("comp", "")) == "nat":
			var seleccion: Dictionary = Nations.as_team(Career.nationality)
			if not seleccion.is_empty():
				yo = seleccion
		var home: bool = bool(f.get("home", true))
		var jugado: bool = bool(f.get("played", false))
		var comp: String = String(f.get("comp", "league"))
		var gy: int = int(f.get("gf", 0))
		var go: int = int(f.get("gc", 0))
		var res: String = "G" if gy > go else ("E" if gy == go else "P")
		out.append({
			"tint": _cal_tint(comp),
			"logo": _cal_logo(comp, String(f.get("round", ""))),


			"comp": comp,
			"familia": _cal_familia(comp),



			"torneo": Competitions.name_of(f),
			"ronda": _cal_ronda(f),



			"mes": CalendarioMundo.mes_de_fixture(f, jornadas, pais),


			"dia": int(dias[i]),
			"proximo": false,
			"local": yo if home else riv,
			"visita": riv if home else yo,
			"you_home": home,
			"gl":(gy if home else go),
			"gv":(go if home else gy),
			"jugado": jugado, "res": res,




			"descanso": -1,
			"baja": "",
		})
		if out.size() >= CAL_MAX_ROWS:
			break


	for f in out:
		if not bool(f["jugado"]):
			f["proximo"] = true
			break



	var dia_ant: int = CalendarioMundo.SIN_DIA
	for f in out:
		var d: int = int(f["dia"])
		f["descanso"] =(d - dia_ant) if (CalendarioMundo.dia_conocido(d)
			and CalendarioMundo.dia_conocido(dia_ant)) else -1
		dia_ant = d
	_cal_proyecta_baja(out)
	return out






func _cal_familia(comp: String) -> String:
	match comp:
		"league", "liguilla", "campeones", "supercopa":
			return "liga"
		"cup", "copaliga", "recopa", "intercont", "supereuropa", "superafrica":
			return "copa"
		"nat":
			return "nat"
		_:
			return "continental"




