func _torn_nat_modal_goleadores_llena(box: VBoxContainer, v: VBoxContainer) -> void:
	await get_tree().process_frame
	await get_tree().process_frame
	if not is_instance_valid(box) or not is_instance_valid(v) or v.get_child_count() == 0:
		return
	var capa: Control = box.get_parent() as Control
	var sep: float = float(box.get_theme_constant("separation"))
	var alto: float = capa.size.y - box.offset_top + box.offset_bottom
	for c in box.get_children():
		if c != v:
			alto -=(c as Control).get_combined_minimum_size().y + sep
	var n: int = v.get_child_count()
	var sep_v: float = float(v.get_theme_constant("separation"))
	if v.get_combined_minimum_size().y > alto:
		_torn_historial_compacto(box, v)
		return
	var cada: float = floorf(minf((alto - sep_v * float(n - 1)) / float(n),
		2.0 * CareerTheme.TOQUE_TUMBADO))
	for r in v.get_children():
		(r as Control).custom_minimum_size.y = maxf((r as Control).custom_minimum_size.y, cada)



func _torn_nat_ancho_ano(rows: Array) -> float:
	var mide: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO)
	var ancho_ano: float = ceilf(CareerUi._ancho_a(mide, I18n.t("ACTIVO"),
		CareerTheme.T_LEE_TUMBADO))
	for r in rows:
		ancho_ano = maxf(ancho_ano, ceilf(CareerUi._ancho_a(mide, str(int(r.get("year", 0))),
			CareerTheme.T_LEE_TUMBADO)))
	mide.free()
	return ancho_ano






func _torn_nat_puesto_sabido(rows: Array, i: int) -> bool:
	if not bool((rows[i] as Dictionary).get("user", false)):
		return true
	for k in range(i + 1, rows.size()):
		if not bool((rows[k] as Dictionary).get("user", false)):
			return true
	return false





