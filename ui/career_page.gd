func _wnews_color(f: Dictionary) -> Color:
	match str(f.get("kind", "")):

		"liga", "campeones":
			return CareerTheme.NAV_LEGADO
		"bombazo":
			return CareerTheme.MONEY
		"descenso":
			return CareerTheme.DANGER
		"retiro":
			return CareerTheme.HISTORIA

		"sorpresa", "promesa":
			return CareerTheme.NAV_PLANTILLA
		"tecnico":
			return CareerTheme.NAV_GENTE
		"proyecto":
			return CareerTheme.MONEY if int(f.get("n", 0)) > 0 else CareerTheme.DANGER


		"renueva", "precontrato":
			return CareerTheme.NAV_GENTE
		"no_renueva":
			return CareerTheme.DANGER
		"goleo":





			return CareerTheme.STAT_GOAL
		"asistencias":
			return CareerTheme.STAT_ASSIST
		"mvp":
			return CareerTheme.STAT_AVG
		"racha":
			return CareerTheme.accent_text() if int(f.get("n2", 0)) > 0 \
					else CareerTheme.DANGER

		"previa":
			if int(f.get("n", 0)) == WorldNews.PREVIA_CAE:
				return CareerTheme.DANGER
			var marca: String = String(ClubGoals.BRAND.get(str(f.get("comp", "")), ""))
			if Competitions.COMP_ACCENT.has(marca):
				return Competitions.COMP_ACCENT[marca]


	var t: int = WorldNews.tono(f)
	if t < 0:
		return CareerTheme.DANGER
	return CareerTheme.accent_text() if t > 0 else CareerTheme.HISTORIA











