			chip_col if chip_col is Color else col)
		c.text = CareerTheme.caps(chip)
		c.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		c.clip_text = true
		box.add_child(c)
	box.add_child(HSeparator.new())
	var det: Control =(_rel_detalle[key] as Control).duplicate()

	if det.get_child_count() > 0 and det.get_child(0) is Label:
		var l0: Label = det.get_child(0)
		l0.add_theme_font_size_override("font_size", CareerTheme.T_BODY)
		l0.add_theme_color_override("font_color", CareerTheme.TEXT)
	box.add_child(det)
	box.add_child(_option_button(
		I18n.t("VOLVER"), CareerTheme.Kind.GHOST, box, Callable()))









