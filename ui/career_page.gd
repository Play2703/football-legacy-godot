func _neto_partido() -> int:
	return Career.con_doble_paga(int(Career.contract.get("wage", 0))) - Career.upkeep_total()



func _partidos_de(v: int) -> int:
	if v <= 0:
		return 0
	var neto: int = _neto_partido()
	if neto <= 0:
		return -1
	return ceili(float(v) / float(neto))


func _en_partidos(n: int) -> String:
	return "≈%d %s" % [n, I18n.plural(n, "PARTIDO", "PARTIDOS")]




func _falta_txt(precio: int) -> String:
	var falta: int = precio - Career.money
	var n: int = _partidos_de(falta)
	if n < 0:
		return I18n.t("CON TU NETO DE HOY NO LLEGAS")
	return I18n.tf("TE FALTAN {0} · {1}", [_en_partidos(n), CareerUi.short_money(falta)])


func _chips_de(stats: Array, suffix: String = "") -> Array:
	var out: Array = []
	for st in stats:
