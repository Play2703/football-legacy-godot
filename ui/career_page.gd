			c.get("filas_t", []), int(c["pasan"]), bool(c.get("tercero_pasa", false)))))
	return pan





const GRUPO_COLUMNAS: Array = ["pj", "w", "d", "l", "dif"]
const GRUPO_COLUMNAS_MIN: Array = ["pj", "dif"]
const GRUPO_COL_ROTULO: Dictionary = {"pj": "PJ", "w": "G", "d": "E", "l": "P", "dif": "DG"}


const GRUPO_COL_AIRE: float = 12.0





func _grupo_celda(texto: String, clave: String, ancho: float, letra: int,
		color: Color) -> Label:
	var l: Label = CareerUi.plain(letra, color)
	l.text = texto
	l.clip_text = true
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	l.custom_minimum_size.x = ancho
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if not clave.is_empty():
		l.set_meta("grupo_col", clave)
		l.visible = false
	return l






func _grupo_col_anchos(letra: int, cartas: Array) -> Dictionary:
	var f: Font = get_theme_font("font", "Label")
	var nums: Array = [I18n.t("PJ", "tabla_liga"), I18n.t("G", "tabla_liga"),
		I18n.t("E", "tabla_liga"), I18n.t("P", "tabla_liga")]
	var dgs: Array = [I18n.t("DG", "tabla_liga")]
	var ptss: Array = [I18n.t("PTS", "tabla_liga")]
	for c in cartas:
		for ft in (c as Dictionary).get("filas_t", []):
			var d: Dictionary = ft
			for k in ["pj", "w", "d", "l"]:
				nums.append(str(int(d.get(k, 0))))
			var dif: int = int(d.get("dif", 0))
			dgs.append(("+%d" % dif) if dif > 0 else str(dif))
			ptss.append(str(int(d.get("pts", 0))))
		for fi in (c as Dictionary).get("filas", []):
			ptss.append(str(int((fi as Dictionary).get("pts", 0))))



	var mide: Callable = func(textos: Array) -> float:
		var w: float = 0.0
		for t in textos:
			w = maxf(w, 0.0 if f == null else f.get_string_size(String(t),
				HORIZONTAL_ALIGNMENT_LEFT, -1.0, letra).x)
		return ceilf(w) + GRUPO_COL_AIRE


	var cifras: Array = ptss.slice(1)
	var num: float = mide.call(nums)





	return {"num": num, "pj": num - GRUPO_COL_AIRE + 4.0, "dg": mide.call(dgs),
		"pts": mide.call(ptss), "pts_cifra": mide.call(cifras)}




static func _grupo_col_ancho(anchos: Dictionary, k: String) -> float:
	if k == "dif":
		return float(anchos["dg"])
	if k == "pj":
		return float(anchos.get("pj", anchos["num"]))
	return float(anchos["num"])








func _grupos_columnas(cartas: Array) -> void:
	var ancho: float = INF
	var sigla: float = 0.0
	var anchos: Dictionary = {}
	for it in cartas:
		var pan: Control = SceneFade.vivo(it) as Control
		if pan == null or not is_instance_valid(pan) or not pan.has_meta("grupo_anchos"):
			return
		anchos = pan.get_meta("grupo_anchos")
		for m in pan.find_children("*", "HBoxContainer", true, false):
			var hb: HBoxContainer = m as HBoxContainer
			if not hb.has_meta("grupo_fila"):
				continue
			if hb.size.x <= 0.0:
				return
			ancho = minf(ancho, hb.size.x)
			for l in hb.get_children():
				if (l as Node).has_meta("grupo_sigla_txt"):
					var lab: Label = l as Label
					var f: Font = lab.get_theme_font("font")
					sigla = maxf(sigla, f.get_string_size(String(lab.get_meta("grupo_sigla_txt")),
						HORIZONTAL_ALIGNMENT_LEFT, -1.0, lab.get_theme_font_size("font_size")).x + 2.0)
	if anchos.is_empty() or ancho == INF:
		return




	var fijo: float = 8.0 +(GRUPO_FRANJA_AIRE - 8.0) + 32.0 + sigla + float(anchos["pts"]) \
			+ 4.0 * 4.0
	var pide: Callable = func(cols: Array) -> float:
		var w: float = fijo
		for k in cols:
			w += _grupo_col_ancho(anchos, String(k)) + 4.0
		return w
	var forma: String = "nada"
	var cols: Array = []
	if pide.call(GRUPO_COLUMNAS) <= ancho:
		forma = "todas"
		cols = GRUPO_COLUMNAS
	elif pide.call(GRUPO_COLUMNAS_MIN) <= ancho:
		forma = "pj_dg"
		cols = GRUPO_COLUMNAS_MIN
	for it in cartas:
		var pan: Control = SceneFade.vivo(it) as Control
		if String(pan.get_meta("grupo_columnas", "")) == forma:
			continue
		pan.set_meta("grupo_columnas", forma)
		for l in pan.find_children("*", "Label", true, false):
			if (l as Node).has_meta("grupo_col"):
				(l as Label).visible = cols.has(String(l.get_meta("grupo_col")))
			elif (l as Node).has_meta("grupo_pts"):

				(l as Label).custom_minimum_size.x = float(anchos["pts"] if forma != "nada"
					else anchos.get("pts_cifra", anchos["pts"]))
		var cab: Control = pan.find_child("GrupoCab", true, false) as Control
		if cab != null:
			cab.visible = forma != "nada"





static func _grupo_franja(i: int, pasan: int, tercero_pasa: bool, accent: Color) -> Color:
	if i < pasan:
		return accent
	if tercero_pasa and i == pasan:
		return _grupo_color_tercero(accent)
	return Color.TRANSPARENT










const TERCERO_CONTRASTE: float = 2.0


static func _grupo_color_tercero(accent: Color) -> Color:
	var apagado: Color = CareerTheme.fill_on_dark(accent)
	var tope: float = _grupo_contraste_fila(accent)
	for i in 21:
		var c: Color = apagado.lerp(accent, 0.05 * float(i))
		var k: float = _grupo_contraste_fila(c)
		if k >= TERCERO_CONTRASTE and k < tope:
			return c
	return apagado.lerp(accent, 0.5)





static func _grupo_contraste_fila(c: Color) -> float:
	var opaca: Color = CareerTheme.PLATE_BG
	opaca.a = 1.0
	return minf(CareerTheme.contrast(c, CareerTheme.BG_DEEP.blend(CareerTheme.PLATE_BG)),
		CareerTheme.contrast(c, opaca.blend(CareerTheme.PLATE_BG)))










