func _hc_nombres_w(filas: Array, clave: String) -> Dictionary:
	var f: Font = get_theme_font("font", "Label")
	var out: Dictionary = {false: 0.0, true: 0.0}
	if f == null:
		return out
	for compacta in [false, true]:
		var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
		var w: float = 0.0
		for fi in filas:
			var club: String = String((fi as Dictionary).get(clave, ""))
			if club.is_empty():
				continue
			w = maxf(w, f.get_string_size(_hc_nombre_club(club, compacta),
				HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x)
		out[compacta] = ceilf(w) + 2.0
	return out




