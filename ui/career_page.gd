func _row_stamps(offer: Dictionary, index: int, ejes: Dictionary) -> Array:
	var out: Array = []
	var role_key: String = String(offer.get("role", "rotacion"))
	var role: int = Standing.contract_role_from_key(role_key)
	out.append(_stamp(I18n.t(Standing.contract_role_name(role)),
		CareerTheme.DANGER if role_key == "esporadico" else CareerTheme.accent()))
	if Career.club_blocks_sale() and Career.pays_clause(offer):
		out.append(_stamp(I18n.t("PAGAN LA CLÁUSULA"), CareerTheme.MONEY))
		return out
	if bool(offer.get("deadline", false)):
		out.append(_stamp(I18n.t("HOY O NUNCA"), CareerTheme.DANGER))
		return out
	if offer.has("expires") \
			and int(offer["expires"]) - GameState.season_day + 1 <= 1:
		out.append(_stamp(I18n.t("SE VAN MAÑANA"), CareerTheme.DANGER))
		return out
	if (ejes.get("wage", []) as Array).has(index):
		out.append(_stamp(I18n.t("PAGA MÁS"), CareerTheme.MONEY))
	elif (ejes.get("club", []) as Array).has(index):
		out.append(_stamp(I18n.t("MEJOR CLUB"), CareerTheme.accent()))
	elif (ejes.get("role", []) as Array).has(index):
		out.append(_stamp(I18n.t("MÁS MINUTOS"), CareerTheme.accent()))
	return out








