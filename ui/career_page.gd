func _cycle_torn_country(dir: int) -> void:
	var countries: Array = Nations.PLAYABLE
	var i: int = countries.find(_torn_country)
	if i < 0:
		i = 0
	_torn_country = String(countries[(i + dir + countries.size()) % countries.size()])

	_torn_div = clampi(_torn_div, 1, Teams.max_div(_torn_country))
	_refresh()


func _cycle_torn_div(dir: int) -> void:
	var maxd: int = Teams.max_div(_torn_country)
	_torn_div =(_torn_div - 1 + dir + maxd) % maxd + 1
	_refresh()













func _torn_zones(country: String, div: int, rows_n: int, vista: int = -1) -> Dictionary:




	return Zonas.de_liga(country, div, rows_n,
		"auto" if vista < 0 else ("anual" if vista == TORN_ANUAL else "torneo"))



func _torn_titulo_tabla(vista: int) -> String:
	if vista == TORN_ANUAL:
		return I18n.tf("CLASIFICACIÓN · {0}", [I18n.t("ANUAL")])
	if vista >= 0:
		return I18n.tf("CLASIFICACIÓN · {0}", [I18n.t(Liguilla.TORNEOS[vista].to_upper())])
	return I18n.tf("CLASIFICACIÓN · {0}", [I18n.t(Teams.div_name(_torn_div)).to_upper()])





func _torn_zone_legend(zones: Dictionary) -> void:
	var seen: Array = []








	var row: HFlowContainer = HFlowContainer.new()
	row.add_theme_constant_override("h_separation", 16)
	row.add_theme_constant_override("v_separation", 6)
	var keys: Array = zones.keys()
	keys.sort()
	for k in keys:
		var z: Dictionary = zones[k]
		if seen.has(String(z["label"])):
			continue
		seen.append(String(z["label"]))
		var item: HBoxContainer = HBoxContainer.new()
		item.add_theme_constant_override("separation", 6)
		var sw: ColorRect = ColorRect.new()
		sw.color = z["color"]
		sw.custom_minimum_size = Vector2(14, 14)
		sw.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		item.add_child(sw)
		var l: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
		l.text = String(z["label"])
		l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		item.add_child(l)
		row.add_child(item)
	if not seen.is_empty():
		_content.add_child(row)
	_torn_zone_missing(seen)
















func _torn_zone_missing(seen: Array) -> void:
	var texto: String = _torn_zone_missing_texto(seen)
	if not texto.is_empty():
		_torn_nota(texto)



func _torn_zone_missing_texto(seen: Array) -> String:
	if _torn_div != 1 or not Teams.is_european(_torn_country):
		return ""
	var faltan: Array = []
	for comp in ["champions", "europa", "conference"]:
		var nombre: String = I18n.t(Competitions.comp_name(String(comp)))
		if not seen.has(nombre):
			faltan.append(nombre)
	if faltan.is_empty():
		return ""
	return I18n.tf("Ningún puesto de esta liga da plaza de {0}: las"
		+ " plazas se reparten por el coeficiente del país, y la última competición"
		+ " es la puerta de las ligas pequeñas.", [" / ".join(faltan)])










func _torn_standings(accent: Color, vista: int = -1) -> void:
	_torn_head(_torn_titulo_tabla(vista), accent)
	if vista >= 0 and vista != TORN_ANUAL and vista > GameState.torneo_actual():
		_torn_nota(I18n.t("El torneo aún no arranca."))
		return
	if not GameState.league_started():
		_torn_nota(I18n.t("La liga aún no arranca."))
	var obj_line: int = int(Career.contract["obj_target"]) \
			if String(Career.contract["obj_type"]) == "position" \
			and (vista < 0 or vista == TORN_ANUAL) else 0
	var rows: Array = GameState.torneo_standings(vista) \
			if vista >= 0 and vista != TORN_ANUAL else GameState.league_standings()

	var zones: Dictionary = _torn_zones(_torn_country, _torn_div, rows.size(), vista)
	_standings_header()
	var sanc: bool = false
	for i in rows.size():
		var r: Dictionary = rows[i]
		var you: bool = r["key"] == GameState.YOU_KEY
		var club_id: String = GameState.player_team_id if you else String(r["key"])
		var zone: Dictionary = zones.get(i + 1, {})
		var s: bool = _torn_sancion(club_id, vista)
		sanc = sanc or s
		_standings_row(i + 1, club_id, String(r["name"]), you,
			zone["color"] if not zone.is_empty() else Color(0, 0, 0, 0),
			[int(r["pj"]), int(r.get("w", 0)), int(r.get("d", 0)), int(r.get("l", 0))],
			int(r["pts"]), accent, 28.0, s)
		if obj_line > 0 and i + 1 == obj_line and i + 1 < rows.size():
			var cut: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
			cut.text = I18n.tf("— objetivo del club: {0} —", [_ordinal(obj_line)])
			_content.add_child(cut)
	_torn_zone_legend(zones)
	_torn_sancion_legend(sanc)






func _torn_sancion(club_id: String, vista: int) -> bool:
	return vista != Liguilla.CLAUSURA and Career.sancion_pts(club_id) > 0




func _torn_sancion_legend(hay: bool) -> void:
	if not hay:
		return
	CareerUi.dot_legend(_content, [[CareerTheme.DANGER,
		I18n.tf("-{0} por fair play", [ClubFinance.FFP_PUNTOS]), true]])














func _torn_standings_sim(accent: Color, vista: int = -1) -> void:
	_torn_head(_torn_titulo_tabla(vista), accent)
	var pt: Array = _torn_frac()
	if int(pt[0]) <= 0:
		_torn_nota(I18n.t("La liga aún no arranca."))
		return
	var rows: Array = []
	if vista >= 0 and vista != TORN_ANUAL:
		var f: float = _torn_frac_torneo(vista)
		if f <= 0.0:
			_torn_nota(I18n.t("El torneo aún no arranca."))
			return
		rows = SimLeague.table_torneo(_torn_country, _torn_div, GameState.season_num,
			vista, f)
	else:
		rows = SimLeague.table(_torn_country, _torn_div,
			GameState.season_num, float(pt[0]) / float(maxi(int(pt[1]), 1)))
	if rows.is_empty():
		_torn_nota(I18n.t("Sin datos de esta competición todavía."))
		return
	var zones: Dictionary = _torn_zones(_torn_country, _torn_div, rows.size(), vista)
	_standings_header()
	var sanc: bool = false
	for i in rows.size():
		var r: Dictionary = rows[i]
		var club_id: String = String(r["id"])
		var zone: Dictionary = zones.get(i + 1, {})
		var s: bool = _torn_sancion(club_id, vista)
		sanc = sanc or s
		_standings_row(i + 1, club_id,
			Competitions.demarca(String(Teams.by_id(club_id).get("name", club_id))),
			false, zone["color"] if not zone.is_empty() else Color(0, 0, 0, 0),
			[int(r["pj"]), int(r["w"]), int(r["d"]), int(r["l"])],
			int(r["pts"]), accent, 28.0, s)
	_torn_zone_legend(zones)
	_torn_sancion_legend(sanc)



























func _torn_liguilla(accent: Color, mine: bool, t: int = -1) -> void:
	_torn_head(I18n.t("LIGUILLA"), accent, true)
	var st: Dictionary = {}
	if mine:
		st = GameState.liguilla_de(t) if t >= 0 else GameState.liguilla_state
	var sembrado: bool = mine and bool(st.get("seeded", false)) \
			and not (st.get("bracket", []) as Array).is_empty()
	var bracket: Array = []
	var winner: String = ""
	var superlider: String = ""
	if sembrado:
		bracket = st.get("bracket", [])
		winner = String(st.get("winner", ""))
		superlider = String(st.get("superlider", ""))
	elif not mine:
		var pt: Array = _torn_frac()
		var acabada: bool = _torn_frac_torneo(t) >= 1.0 if t >= 0 \
				else int(pt[0]) >= int(pt[1])
		if acabada:
			var lg: Dictionary = SimLeague.liguilla(_torn_country, _torn_div,
				GameState.season_num, [], t)
			bracket = lg.get("bracket", [])
			winner = String(lg.get("winner", ""))
			superlider = String(lg.get("superlider", ""))
	if bracket.is_empty():




		_torn_nota(I18n.t("Del 1º al 8º, a cuartos."))
		var orden: Array = _torn_liguilla_orden(mine, t)
		if not orden.is_empty():
			_torn_nota(I18n.t("Así quedaría si la liga acabara hoy."))
			bracket = BRACKET_TREE.liguilla_proyeccion(orden)
	if not bracket.is_empty():
		var partes: Dictionary = BRACKET_TREE.liguilla_partes(bracket)

		if not (partes["playin"] as Array).is_empty():
			_torn_liguilla_arbol(partes["playin"], partes["playin_names"], accent)
		_torn_liguilla_arbol(partes["cuadro"], partes["cuadro_names"], accent)
	if not superlider.is_empty():
		_torn_superlider(superlider)
	if not winner.is_empty():
		_projected_champion(winner, accent)



	if UiKit.es_horizontal():
		var fin: Control = Control.new()
		fin.set_meta(DragScroll.META_HUECO, true)
		_content.add_child(fin)










func _torn_liguilla_orden(mine: bool, t: int = -1) -> Array:
	var out: Array = []
	var filas: Array = []
	if mine:
		if not GameState.league_started():
			return out
		if t < 0:
			filas = GameState.league_standings()
		elif t <= GameState.torneo_actual():
			filas = GameState.torneo_standings(t)
	elif t < 0:
		var pt: Array = _torn_frac()
		if int(pt[0]) <= 0:
			return out
		filas = SimLeague.table(_torn_country, _torn_div, GameState.season_num,
			float(pt[0]) / float(maxi(int(pt[1]), 1)))
	elif _torn_frac_torneo(t) > 0.0:
		filas = SimLeague.table_torneo(_torn_country, _torn_div, GameState.season_num, t,
			_torn_frac_torneo(t))
	var jugado: bool = t < 0
	for r in filas:
		if int((r as Dictionary).get("pj", 0)) > 0:
			jugado = true
	if not jugado:
		return out
	for r in filas:
		out.append(String((r as Dictionary).get("key",(r as Dictionary).get("id", ""))))
	return out







func _torn_liguilla_arbol(bracket: Array, names: Array, accent: Color) -> void:
	var tree: Control = BRACKET_TREE.new()
	tree.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_content.add_child(tree)
	tree.setup(bracket, names, accent, GameState.YOU_KEY)
	if UiKit.es_horizontal():
		tree.set_meta(DragScroll.META_PANTALLA, true)






func _torn_superlider(club_id: String) -> void:
	var team: Dictionary = Teams.by_id(club_id)
	if team.is_empty():
		return
	var row: HBoxContainer = HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	_content.add_child(row)
	var crest: CrestView = CrestView.new()
	crest.custom_minimum_size = Vector2(34, 34)
	crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	crest.set_team(team)
