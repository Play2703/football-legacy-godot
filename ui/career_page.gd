const MT_ESTADO_GRUPOS: Array = [
	["niego", "acepto"], ["quedo", "cedido"], ["quedo"], ["quedarme"],
	["no_renovar", "renovar"], ["no_renovar", "mejora"], ["no_renovar", "pide_mesa"],
	["no_renovar"], ["traspaso", "ceder"], ["traspaso"], ["retirar"],
]


func _mt_estado_grupo(acciones: Array) -> Array:
	var por_id: Dictionary = {}
	for e in acciones:
		if (e as Dictionary).has("texto"):
			por_id[String(e["id"])] = e
	for g in MT_ESTADO_GRUPOS:
		var ids: Array = g
		if not por_id.has(String(ids[ids.size() - 1])):
			continue
		var out: Array = []
		for id in ids:
			if por_id.has(String(id)):
				out.append(por_id[String(id)])
		return out
	return []









func _mt_estado_rejilla(baldosas: Array) -> VBoxContainer:
	var rej: VBoxContainer = VBoxContainer.new()
	rej.name = "RejillaEstado"
	rej.set_meta("fl_rejilla", true)
	rej.size_flags_vertical = Control.SIZE_EXPAND_FILL
	rej.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rej.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
	var lotes: Array = [[], []]
	for e in baldosas:
		(lotes[1 if String((e as Dictionary).get("bloque", "")) == "agente" else 0] as Array).append(e)
	var filas: Array = []
	for li in lotes.size():
		var lote: Array = lotes[li]
		var n: int = lote.size()
		if n == 0:
			continue

		var nf: int = ceili(float(n) /(4.0 if n > 12 or li == 1 else 3.0))
		var k: int = 0
		for i in nf:
			var cuantas: int = floori(float(n) / float(nf)) +(1 if i < n % nf else 0)
			filas.append((lote as Array).slice(k, k + cuantas))
			k += cuantas
	if filas.size() == 1 and (filas[0] as Array).size() > 2:
		var sola: Array = filas[0]
		var mitad: int = ceili(float(sola.size()) / 2.0)
		filas = [sola.slice(0, mitad), sola.slice(mitad)]
	for f in filas:
		var fila: HBoxContainer = HBoxContainer.new()
		fila.size_flags_vertical = Control.SIZE_EXPAND_FILL
		fila.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
		rej.add_child(fila)
		for e in f:
			_mt_estado_baldosa(fila, e as Dictionary)
	rej.resized.connect(_mt_estado_letras.bind(rej), CONNECT_DEFERRED)
	return rej





func _mt_estado_baldosa(fila: HBoxContainer, e: Dictionary) -> void:
	if e.has("agente"):
		_mt_estado_encargo(fila, e)
		return
	var col: Color = e.get("color", CareerTheme.TEXT) as Color
	var b: Button = CareerUi.icon_tile(String(e["icono"]), String(e["nombre"]), col,
		String(e.get("valor", "")), 48.0)
	b.name = "Estado_" + String(e["id"])
	b.set_meta("mt_estado", String(e["id"]))
	b.custom_minimum_size.y = maxf(b.custom_minimum_size.y, CareerTheme.TOQUE_PRINCIPAL_TUMBADO)


	if bool(e.get("ancha", false)):
		b.size_flags_stretch_ratio = 1.5
	CareerUi.pinta_icon_tile(b, bool(e.get("on", true)), String(e.get("cifra", "")))
	var nombre: Label = b.get_meta("tile_name") as Label
	var caja: VBoxContainer = nombre.get_parent() as VBoxContainer
	caja.add_theme_constant_override("separation", 12)
	(b.get_meta("tile_value") as Label).text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING





	var aire: Control = caja.get_child(1) as Control
	var centro: CenterContainer = CenterContainer.new()
	centro.name = "Centro"
	centro.size_flags_vertical = Control.SIZE_EXPAND_FILL
	centro.mouse_filter = Control.MOUSE_FILTER_IGNORE
	caja.add_child(centro)
	caja.move_child(centro, 1)
	aire.visible = false
	b.set_meta("mt_centro", centro)

	if e.has("barra"):
		var barra: ProgressBar = ProgressBar.new()
		barra.show_percentage = false
		barra.max_value = 1.0
		barra.step = 0.0
		barra.value = float(e["barra"])
		barra.custom_minimum_size = Vector2(0, 10)
		barra.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var fondo: StyleBoxFlat = StyleBoxFlat.new()
		fondo.bg_color = CareerTheme.BG_DEEP
		fondo.set_corner_radius_all(2)
		var lleno: StyleBoxFlat = StyleBoxFlat.new()
		lleno.bg_color = col if bool(e.get("on", true)) else CareerTheme.TEXT_DIM
		lleno.set_corner_radius_all(2)
		barra.add_theme_stylebox_override("background", fondo)
		barra.add_theme_stylebox_override("fill", lleno)
		caja.add_child(barra)
	fila.add_child(b)
	var hold: Callable = e.get("hold", Callable())
	var tap: Callable = e.get("tap", Callable())
	if hold.is_valid():
		CareerUi.hold_gesture(b, HOLD_SECS, hold)
	elif tap.is_valid():
		b.pressed.connect(func() -> void: tap.call())





