func _cup_text() -> String:
	var cup: Dictionary = GameState.cup_state
	if cup.is_empty():
		return I18n.t("Aún no arranca")
	if bool(cup.get("champion", false)):
		return I18n.t("¡Campeón de Copa!")
	if not bool(cup.get("alive", true)):
		return I18n.t("Eliminado")
	var idx: int = int(cup.get("idx", 0))
	var names: Array = cup.get("names", [])
	if idx < names.size():
		return I18n.tf("En {0}", [I18n.t(String(names[idx])).to_lower()])
	return I18n.t("En juego")






func _fuera_previa_text(state: Dictionary) -> String:
	return I18n.t("Fuera en la fase de liga") if bool(state.get("league_phase", false)) \
			else I18n.t("Fuera en la fase de grupos")


func _ucl_text() -> String:
	var u: Dictionary = GameState.ucl_state
	if bool(u.get("champion", false)):
		return I18n.t(Competitions.demarca("¡Campeón de Champions!"))
	if not bool(u.get("alive", true)):
		return I18n.t("Eliminado") if bool(u.get("advanced", false)) \
				else _fuera_previa_text(u)
	if not bool(u.get("advanced", false)):
		return I18n.t("Fase de liga") if bool(u.get("league_phase", false)) \
				else I18n.t("Fase de grupos")
	var idx: int = int(u.get("ko_idx", 0))
	var names: Array = u.get("ko_names", [])
	if idx < names.size():
		return I18n.tf("En {0}", [I18n.t(String(names[idx])).to_lower()])
	return I18n.t("Fase final")






















