func _boots_effect(parent: Container) -> void:
	if Career.boots == "cantera":
		return
	var b: Dictionary = Shop.boots_by_id(Career.boots)
	var frac: float = Career.boots_life_frac()
	var cols: Array = []
	for kv in [["pot", "POTENCIA", "potencia"], ["pre", "PUNTERÍA", "precision"],
			["efe", "EFECTO", "efecto"]]:

		cols.append({"icon": String(kv[2]), "label": I18n.t(String(kv[1])), "suffix": "%",
			"value": roundi(Career._boot(String(kv[0])) * 100.0)})
	CareerUi.head(parent, I18n.t("CON TUS BOTAS"))
	var card: PanelContainer = CareerUi.plate()
	var pad: MarginContainer = MarginContainer.new()
	for side in ["left", "right", "top", "bottom"]:
		pad.add_theme_constant_override("margin_" + side, 20)
	card.add_child(pad)
	var box: VBoxContainer = VBoxContainer.new()
	box.add_theme_constant_override("separation", 10)
	pad.add_child(box)
	var nom: Label = CareerUi.plain(CareerTheme.T_CARD, CareerTheme.TEXT)
	nom.text = I18n.t(String(b.get("name", "")))
	nom.clip_text = true
	box.add_child(nom)
	box.add_child(CareerUi.stat_board(cols))


	var fill: ColorRect = CareerUi.bar(box, _skill_color(frac))
	fill.anchor_right = clampf(frac, 0.0, 1.0)
	var vida: Label = CareerUi.plain(CareerTheme.T_DIM, CareerTheme.TEXT_DIM)
	vida.text = I18n.tf("VIDA {0}%  ·  se gastan al jugar", [roundi(frac * 100.0)])
	box.add_child(vida)
	parent.add_child(card)











