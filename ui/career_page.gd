func _dejarla_confirmar() -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	box.set_meta("rel_dejarla", true)
	var casado: bool = Career.pareja_casada()
	var t: Label = CareerUi.plain(CareerTheme.T_HEAD, CareerTheme.TEXT)


	t.text = I18n.tf("¿DIVORCIARTE DE {0}?" if casado else "¿DEJAR A {0}?",
		[Career.pareja_nombre()])
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	if casado:








		var tit: String = String(Career.pareja.get("titular", ""))
		if tit == Pareja.TITULAR_MADRE:
			CareerUi.line(box, I18n.t("Las escrituras están a nombre de tu madre: no se"
				+ " lleva nada."))
		elif tit == Pareja.TITULAR_ELLA:
			CareerUi.line(box, I18n.tf("Las escrituras están a su nombre: se lleva la"
				+ " mitad de tu dinero, ${0}.",
				[CareerUi.money(int(Career.divorcio_ruina_cuenta()["mitad"]))]))
		elif Pareja.arruina(String(Career.pareja.get("id", ""))):
			CareerUi.line(box, I18n.t("Con ella no hay reparto que negociar: su abogado"
				+ " te hará elegir entre la casa y cinco temporadas de tu ficha."))
			CareerUi.dim(box, I18n.t("Eliges tú, y se elige esta semana."))
		else:
			var c: Dictionary = Career.divorcio_cuenta()
			CareerUi.line(box, I18n.tf("El reparto se paga igual que si lo pidiera ella:"
				+ " ${0}.", [CareerUi.money(int(c["total"]))]))


		if tit == "" and Career.pareja_prenup:
			CareerUi.dim(box, I18n.t("La separación de bienes que firmasteis sigue"
				+ " valiendo. Es todo lo que te protege."))
		elif tit == "":
			CareerUi.dim(box, I18n.t("No firmasteis nada, así que entra todo: el"
				+ " dinero y lo que tienes puesto."))
		CareerUi.dim(box, I18n.t("Y no te va a presentar nadie a nadie en una buena"
			+ " temporada. Estas cosas se cuentan."))
	else:



		CareerUi.line(box, I18n.t("No cuesta nada. Ni dinero ni prensa."))
	box.add_child(_option_button(
		I18n.t("SÍ, SE ACABÓ"), CareerTheme.Kind.WARN, box, _dejarla_hacer))
	box.add_child(_option_button(
		I18n.t("VOLVER"), CareerTheme.Kind.GHOST, box, Callable()))




func _dejarla_hacer() -> void:
	var r: Dictionary = Career.dejarla()
	if r.is_empty():
		return



	if bool(r.get("pendiente", false)):
		_toast(I18n.t("SU ABOGADO YA LLAMÓ"), CareerTheme.DANGER)
	elif bool(r.get("casado", false)):
		var c: Dictionary = r.get("cuenta", {})
		_toast(I18n.tf("SE LLEVA ${0}", [CareerUi.money(int(c.get("total", 0)))]),
			CareerTheme.DANGER)
	else:
		_toast(I18n.t("SE ACABÓ"), CareerTheme.DANGER)
	_rebuild()












