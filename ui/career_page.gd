		return String(Teams.free_team().get("name", ""))
	return _torn_nombre_de(id)






func _ft_ventana() -> Dictionary:
	var dia: int = GameState.season_day
	var wd: int = GameState.winter_day()
	var cal: int = GameState.calendar.size()
	if Market.window_open(dia, wd):
		var last: int = Market.window_last_day(dia, wd)
		var f: Dictionary = Market.fecha_de_jornada(last, wd, cal)
		return {"abierta": true, "dias": Market.window_days_left(dia, wd),
			"fecha": CareerUi.fecha_corta(int(f["dia"]), int(f["mes"])),
			"cual": Market.window_id(dia, wd)}
	var falta: int = Market.days_until_open(dia, wd, cal)
	var fecha: String = ""
	if falta > 0:



		var abre: int = dia + falta
		var f2: Dictionary = Market.fecha_de_jornada(abre if abre < cal else Market.SUMMER_DAY, wd, cal)
		fecha = CareerUi.fecha_corta(int(f2["dia"]), int(f2["mes"]))

	var cual: String = Market.WINDOW_WINTER if dia > Market.summer_last() \
			and dia < Market.winter_first(wd) else Market.WINDOW_SUMMER
	return {"abierta": false, "dias": falta if falta > 0 else -1, "fecha": fecha, "cual": cual}



func _ft_ventana_cifra(v: Dictionary) -> String:
	var d: int = int(v["dias"])
	if d < 0:
		return "—"
	if bool(v["abierta"]) and d == 1:
		return I18n.t("HOY")
	return I18n.tf("{0} J", [d])




func _ft_heroe_ventana() -> VBoxContainer:
	var v: Dictionary = _ft_ventana()
	var cap: String = I18n.t("CIERRA") if bool(v["abierta"]) else I18n.t("ABRE")
	var fecha: String = String(v["fecha"])
	var h: VBoxContainer = CareerUi.heroe(_ft_ventana_cifra(v),
		cap if fecha.is_empty() else "%s · %s" % [cap, fecha])
	h.set_meta("ft_ventana", v)
	return h




func _ft_baldosa_ventana() -> Button:
	var v: Dictionary = _ft_ventana()
	var b: Button = CareerUi.baldosa_avance("mercado", I18n.t("CIERRA") if bool(v["abierta"])
		else I18n.t("ABRE"), _ft_color_agente(), null, String(v["fecha"]) if not String(v["fecha"])
		.is_empty() else I18n.t("MERCADO"), _ft_ventana_cifra(v), CareerTheme.caps(I18n.t("INVIERNO"
		if String(v["cual"]) == Market.WINDOW_WINTER else "VERANO")), func() -> void: _on_tab("mercado"))
