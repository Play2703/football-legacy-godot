func _leg_apoyo_reparto(historia: Button, valor: Button, recorrido: Button) -> void:
	for b in [historia, valor, recorrido]:
		if not is_instance_valid(b) or (b as Button).size.y <= 0.0 or (b as Button).size.x <= 0.0:
			return
	var total: float = historia.size.y + valor.size.y + recorrido.size.y
	var igual: float = floorf(total / 3.0)
	var elegido: float = -1.0
	for d in int(igual):
		for h in [igual - float(d), igual + float(d)]:
			var resto: float = total - 2.0 * float(h)
			if float(h) < float(CareerTheme.TOQUE_PRINCIPAL_TUMBADO) \
					or resto - 2.0 * float(LEG_HOLGURA) < historia.get_combined_minimum_size().y:
				continue


			var holgado: bool = true
			for e in range(- LEG_HOLGURA, LEG_HOLGURA + 1):
				if not _leg_apoyo_llena(historia, valor, recorrido, float(h) + float(e),
						resto - 2.0 * float(e)):
					holgado = false
					break
			if holgado:
				elegido = float(h)
				break
		if elegido >= 0.0:
			break
	if elegido < 0.0:
		elegido = igual
	var r_h: float = total - 2.0 * elegido
	if is_equal_approx(valor.size_flags_stretch_ratio, elegido) \
			and is_equal_approx(historia.size_flags_stretch_ratio, r_h):
		return
	valor.size_flags_stretch_ratio = elegido
	recorrido.size_flags_stretch_ratio = elegido
	historia.size_flags_stretch_ratio = r_h



const LEG_TINTA: float = 0.57

const LEG_HOLGURA: int = 3



func _leg_apoyo_llena(historia: Button, valor: Button, recorrido: Button, h: float,
		h_hist: float) -> bool:
	var n: int = _leg_cal_nivel_de([valor, recorrido], h)
	if n < 0:
		return false
	for b in [valor, recorrido]:
		if _leg_cal_tinta(b as Button, CAL_BALDOSA_NIVELES[n]) < LEG_TINTA *(h - float(CareerTheme.SINK)):
			return false
	var m: Array = _leg_historia_medida(historia,
		LEG_HIST_NIVELES[_leg_historia_nivel_de(historia, h_hist)])
	return float(m[1]) <= h_hist and float(m[0]) >= LEG_TINTA *(h_hist - float(CareerTheme.SINK))





func _leg_cal_nivel_de(grupo: Array, alto: float) -> int:
	for n in range(CAL_BALDOSA_NIVELES.size() - 1, -1, -1):
		var cabe: bool = true
		for b in grupo:
			if not _leg_cal_cabe(b as Button, CAL_BALDOSA_NIVELES[n], alto):
				cabe = false
				break
		if cabe:
			return n
	return -1


func _leg_cal_cabe(b: Button, nv: Array, alto: float) -> bool:
	var pt: Dictionary = b.get_meta("cal_partes")
	var cif: Label = pt["cifra"]
	var f: Font = cif.get_theme_font("font")
	if f == null:
		return false
	var lee: int = CareerTheme.T_LEE_TUMBADO
	var ancho: float = b.size.x - 32.0
	var pila: bool = bool(nv[3])
	var w_r: float = f.get_string_size((pt["rotulo"] as Label).text, HORIZONTAL_ALIGNMENT_LEFT,
		-1, lee).x
	var w_cab: float = maxf(float(nv[0]), w_r) if pila else float(nv[0]) + 16.0 + w_r
	if w_cab > ancho or f.get_string_size(cif.text, HORIZONTAL_ALIGNMENT_LEFT, -1, int(nv[1])).x \
			> ancho:
		return false
	var h_cab: float = float(nv[0]) + 8.0 + f.get_height(lee) if pila \
			else maxf(float(nv[0]), f.get_height(lee))
	return h_cab + 8.0 + f.get_height(int(nv[1])) + 8.0 + CAL_T_BARRA \
			<= alto - float(CareerTheme.SINK) - 32.0




func _leg_cal_tinta(b: Button, nv: Array) -> float:
	var f: Font =(b.get_meta("cal_partes")["cifra"] as Label).get_theme_font("font")
	if f == null:
		return 0.0
	var lee: float = f.get_height(CareerTheme.T_LEE_TUMBADO)
	var cab: float = float(nv[0]) + lee if bool(nv[3]) else maxf(float(nv[0]), lee)
	return cab + f.get_height(int(nv[1]))





