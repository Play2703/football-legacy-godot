func _torn_nat_fila_debut(alto: float) -> Control:
	var d: Dictionary = Career.nat_debut
	if d.is_empty() or int(d.get("age", 0)) <= 0:
		return null
	var partes: PackedStringArray = [I18n.tf("CON {0} AÑOS", [int(d.get("age", 0))])]
	var rival: String = Nations.display_name(String(d.get("rival", "")))
	if not rival.is_empty():
		var vs: String = I18n.tf("VS {0}", [CareerTheme.caps(rival)])
		if int(d.get("tg", -1)) >= 0 and int(d.get("rg", -1)) >= 0:
			vs += " %d-%d" % [int(d["tg"]), int(d["rg"])]
		partes.append(vs)
	partes.append(I18n.tf("T{0}", [int(d.get("season", 1))]))
	return _torn_nat_fila(I18n.t("DEBUT"), " · ".join(partes), alto, false, 24)




