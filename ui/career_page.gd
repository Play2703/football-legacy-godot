func _pf_t_ordena(filas: Array[Button], modal: bool) -> void:
	var quiere: String = _pf_t_foco_modal if modal else _pf_t_foco
	var primera: Button = null
	for b in filas:
		if b.disabled:
			continue
		if primera == null or String(b.get_meta("pf_t_fila", "")) == quiere:
			primera = b
	if primera != null:
		primera.set_meta(Entrada.PRIMERO_META, true)
	for i in filas.size():
		var b: Button = filas[i]
		var abajo: Button = _pf_t_viva(filas, i, 1)
		var arriba: Button = _pf_t_viva(filas, i, -1)
		b.focus_neighbor_bottom = b.get_path_to(abajo if abajo != null else b)
		b.focus_neighbor_top = b.get_path_to(arriba) if arriba != null else NodePath()
		b.focus_neighbor_left = b.get_path_to(b)
		b.focus_neighbor_right = b.get_path_to(b)
		b.focus_entered.connect(func() -> void:
			if modal:
				_pf_t_foco_modal = String(b.get_meta("pf_t_fila", ""))
			else:
				_pf_t_foco = String(b.get_meta("pf_t_fila", "")))


func _pf_t_viva(filas: Array[Button], i: int, paso: int) -> Button:
	var j: int = i + paso
	while j >= 0 and j < filas.size():
		if not filas[j].disabled:
			return filas[j]
		j += paso
	return null



func _pf_t_room() -> Control:
	if _fila_banda == null or not is_instance_valid(_fila_banda):
		return null
	for c in _fila_banda.get_children():
