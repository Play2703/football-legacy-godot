func _ca_t_vender_modal() -> void:
	var datos: Array[Dictionary] = _ca_t_vendibles()
	if datos.is_empty():
		return
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	box.set_meta("ca_t_vender", datos.size())
	box.add_theme_constant_override("separation", 24)
	var t: Label = _mk_t_label(CareerTheme.T_TITULO_TUMBADO, CareerTheme.TEXT, I18n.t("VENDER MUEBLE"),
		false)
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	var cols: HBoxContainer = HBoxContainer.new()
	cols.name = "Columnas"
	cols.add_theme_constant_override("separation", 24)
	box.add_child(cols)
	var lista: VBoxContainer = null
	var ancho: float = _ca_t_venta_ancho(datos)
	for i in datos.size():
		if i % CA_T_MODAL_COL == 0:
			lista = VBoxContainer.new()
			lista.add_theme_constant_override("separation", 16)
			lista.custom_minimum_size.x = ancho
			cols.add_child(lista)
		lista.add_child(_ca_t_fila_venta(datos[i], box))





func _ca_t_venta_ancho(datos: Array) -> float:
	var ancho: float = CA_T_MODAL_COL_W
	var resto: float = CA_T_ICONO + 2.0 * 16.0 + 2.0 * 24.0 + 8.0
	for d in datos:
		var nombre: float = _wnews_ancho(String((d as Dictionary)["nombre"]), CareerTheme.T_LEE_TUMBADO)
		var cifra: float = _wnews_ancho(CareerUi.money(int((d as Dictionary)["vale"])), CareerTheme.T_LEE_TUMBADO)
		ancho = maxf(ancho, ceilf(nombre + cifra + resto))
	var cols: int = maxi(1, ceili(float(datos.size()) / float(CA_T_MODAL_COL)))
	var tope: float =(get_viewport_rect().size.x - 2.0 * 96.0 - 56.0 - 24.0 * float(cols - 1)) \
			/ float(cols)
	return minf(ancho, maxf(CA_T_MODAL_COL_W, floorf(tope)))


func _ca_t_fila_venta(d: Dictionary, box: VBoxContainer) -> Button:
	var iid: String = String(d["iid"])
	var piezas: int = int(d["piezas"])
	var b: Button = _ca_t_boton("Venta_" + iid, String(d["icono"]), String(d["nombre"]),
		CareerTheme.Kind.NEUTRAL, Callable(), "", CareerUi.money(int(d["vale"])), CareerTheme.DANGER)
	b.set_meta("ca_t_venta", iid)
	CareerUi.letra_por_peldanos(b.find_child("Rotulo", true, false) as Label,
		[CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	var sub: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.DANGER, "")
	sub.name = "Sub"
	sub.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	sub.visible = false
	(b.find_child("Texto", true, false) as VBoxContainer).add_child(sub)
	var armado: Array = [false]
	var vende: Callable = func() -> void:
		if not is_instance_valid(b) or not armado[0]:
			return
		armado[0] = false
		if Career.sell_house_item(iid) <= 0:
			return
		var quedan: int = int(box.get_meta("ca_t_vender", 1)) - 1
		box.set_meta("ca_t_vender", quedan)
		b.get_parent().remove_child(b)
		b.queue_free()
		_ca_t_cuenta_vender(quedan)
		if quedan <= 0:
			CareerUi.close_modal(box)
			return
		if Entrada.modo == Entrada.Modo.MANDO:
			var otra: Node = _ca_t_con_meta(box, "ca_t_venta")
			if otra is Control:
				(otra as Control).grab_focus()
	b.pressed.connect(func() -> void:
		if armado[0] and Entrada.modo == Entrada.Modo.TACTIL:
			vende.call()
			return
		armado[0] = true
		var mando: bool = Entrada.modo != Entrada.Modo.TACTIL
		if piezas > 1:
			sub.text = I18n.tf("MANTÉN · SE VAN {0} PIEZAS" if mando else "¿SEGURO? SE VAN {0} PIEZAS",
				[piezas])
		else:
			sub.text = I18n.t("MANTÉN PARA VENDER" if mando else "¿SEGURO? TOCA OTRA VEZ")
		sub.visible = true
		SceneFade.timer(CA_T_DESARMA_S).timeout.connect(
			_ca_t_desarma.bind(b.get_instance_id(), sub.get_instance_id(), armado)))
	CareerUi.hold_gesture(b, CA_T_VENDER_S, vende,
		func() -> bool: return bool(armado[0]) and Entrada.modo != Entrada.Modo.TACTIL)
	return b







func _ca_t_desarma(b_id: int, sub_id: int, armado: Array) -> void:
	if not is_instance_valid(instance_from_id(b_id)):
		return
	armado[0] = false
	var sub: Label = instance_from_id(sub_id) as Label
	if sub != null:
		sub.visible = false



func _ca_t_con_meta(raiz: Node, meta: String) -> Node:
	for h in raiz.find_children("*", "Button", true, false):
		if h.has_meta(meta):
			return h
	return null



func _ca_t_cuenta_vender(n: int) -> void:
	for b in _ca_t_filas:
		if String(b.get_meta("ca_t_fila", "")) != "vender":
			continue
		b.set_meta("ca_t_valor", n)
		var c: Label = b.find_child("Cifra", true, false) as Label
		if c != null:
			c.text = I18n.num(n)
		if n <= 0 and not b.disabled:
			_ca_t_apaga(b)
			_ca_t_ordena()














