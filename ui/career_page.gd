func _pl_t_nombre_fila(nombre: String, l: Label, ancho: float) -> String:
	if ancho <= 0.0:
		return nombre
	var f: Font = l.get_theme_font("font")
	var px: int = l.get_theme_font_size("font_size")
	if f == null or f.get_string_size(nombre, HORIZONTAL_ALIGNMENT_LEFT, -1.0, px).x <= ancho:
		return nombre
	var partes: PackedStringArray = nombre.split(" ", false)
	var corto: String = nombre
	if partes.size() > 1:
		corto = "%s. %s" % [String(partes[0]).left(1), String(partes[partes.size() - 1])]
	return _pl_t_nombre_cabe(corto, l, ancho)


func _pl_t_cruceta_banca(ev: InputEvent, k: int) -> void:
	if ev is InputEventMouse or Entrada.modo != Entrada.Modo.MANDO:
		return
	if k < 0 or k >= _pl_t_filas_banca.size():
		return
	var b: Button = _pl_t_filas_banca[k]
	if ev.is_action_pressed("ui_up", true):
		b.accept_event()
		_pl_t_elige_banca(_pl_t_banca_vecina(k, -1))
	elif ev.is_action_pressed("ui_down", true):
		var v: int = _pl_t_banca_vecina(k, 1)
		if v >= 0:
			b.accept_event()
			_pl_t_elige_banca(v)

	elif ev.is_action_pressed("ui_left", true):
		b.accept_event()
		if _pl_t_elegida >= 0:
			_pl_t_elige(_pl_t_elegida)
	elif ev.is_action_pressed("ui_right", true):
		b.accept_event()



func _pl_t_banca_vecina(k: int, paso: int) -> int:
	var a: int = k + paso
	while a >= 0 and a < _pl_t_filas_banca.size():
		if _pl_t_filas_banca[a].visible:
			return a
		a += paso
	return -1


func _pl_t_elige_banca(a: int, enfoca: bool = true) -> void:
	if a < 0 or a >= _pl_t_filas_banca.size():
		return
	for k in _pl_t_filas_banca.size():
		var b: Button = _pl_t_filas_banca[k]
		if is_instance_valid(b):
			b.focus_mode = Control.FOCUS_ALL if k == a else Control.FOCUS_NONE
	_pl_t_banca_elegida = a
	if enfoca:
		_pl_t_filas_banca[a].grab_focus()



