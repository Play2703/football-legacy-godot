func _pf_t_lista_mando(filas: VBoxContainer, keys: Array, cerrar: Button) -> void:
	for c in filas.get_children():
		filas.remove_child(c)
		c.queue_free()
	var lista: Array[Button] = []
	for key in keys:
		var k: String = String(key)
		var b: Button
		if _pf_t_con_mando():
			b = _pf_t_boton_mando(k, func() -> void:
				_pf_t_sube(k)
				_pf_t_lista_mando(filas, keys, cerrar))
		else:
			var fila: PanelContainer = _pf_t_fila(k, PF_T_FILA_MANDO_H)
			var toque: Node = fila.find_child("Toque", false, false)
			if toque != null:
				fila.remove_child(toque)
				toque.queue_free()
			var plus: Button = fila.find_child("Plus", true, false) as Button
			for s in plus.pressed.get_connections():
				plus.pressed.disconnect(s["callable"])
			plus.pressed.connect(func() -> void:
				_pf_t_sube(k)
				_pf_t_lista_mando(filas, keys, cerrar))
			filas.add_child(fila)
			continue
		filas.add_child(b)
		lista.append(b)
	if lista.is_empty():
		return
	_pf_t_ordena(lista, true)
	var foco: Button = null
	for b in lista:
		if b.has_meta(Entrada.PRIMERO_META):
			foco = b
	if foco == null:
		foco = cerrar
	if lista[0] != null:
		var ultima: Button = _pf_t_viva(lista, lista.size(), -1)
		if ultima != null:
			ultima.focus_neighbor_bottom = ultima.get_path_to(cerrar)
			cerrar.focus_neighbor_top = cerrar.get_path_to(ultima)
	if _pf_t_con_mando():
		foco.grab_focus.call_deferred()





func _pf_t_mas_modal() -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	box.set_meta("pf_t_mas", true)
	box.add_theme_constant_override("separation", PF_T_AIRE_MODAL)
	_pf_t_modal_titulo(box, I18n.t("MÁS"))
	var cerrar: Button = _pf_t_modal_cerrar(box)
	var parado: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_DIM, I18n.t("BALÓN PARADO"))
	parado.name = "BalonParado"
	box.add_child(parado)
	var filas: VBoxContainer = VBoxContainer.new()
	filas.name = "Lista"
	filas.add_theme_constant_override("separation", PF_T_AIRE_MODAL)
	filas.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(filas)
	_pf_t_foco_modal = ""
	_pf_t_lista_mando(filas, Career.SPECIAL_KEYS, cerrar)
	var rot: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_DIM, I18n.t("TUS PUESTOS"))
	rot.name = "TusPuestos"
	box.add_child(rot)
	var puestos: HBoxContainer = HBoxContainer.new()
	puestos.name = "Puestos"
	puestos.add_theme_constant_override("separation", PF_T_AIRE_MODAL)
	puestos.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(puestos)
	var fav: String = Career.puesto_favorito()
	for p in Career.puestos():
		var pos: String = String(p)
		puestos.add_child(_pf_t_boton_puesto(pos, pos == fav, func() -> void:
			CareerUi.close_modal(box)
			_puesto_modal(pos)))
	var en_venta: Array = _puestos_en_venta()
	if not en_venta.is_empty():
		var barato: int = 999999
		for pos in en_venta:
			barato = mini(barato, Career.coste_puesto(String(pos)))
		var plus: Button = _pf_t_mas_menos("PlusPuesto", "+",
			CareerTheme.Kind.PRIMARY if Career.skill_points >= barato else CareerTheme.Kind.NEUTRAL,
			false, func() -> void:
				CareerUi.close_modal(box)
				_puestos_venta_modal(), PF_T_FILA_MANDO_H)
		puestos.add_child(plus)
	var hist: Array = Career.season_history.filter(func(h: Dictionary) -> bool:
		return int(h.get("ovr", 0)) > 0)
	if Career.boots != "cantera":
		var botas: Button = _ca_t_boton("Botas", Shop.icon_of(Shop.boots_by_id(Career.boots), "tienda"),
			I18n.t("CON TUS BOTAS"), CareerTheme.Kind.NEUTRAL, func() -> void:
				CareerUi.close_modal(box)
				_ficha_modal(func(b: VBoxContainer) -> void: _boots_effect(b)))
		box.add_child(botas)
	if hist.size() >= 2:
		var media: Button = _ca_t_boton("Media", "media", I18n.t("TU MEDIA AÑO A AÑO"),
			CareerTheme.Kind.NEUTRAL, func() -> void:
				CareerUi.close_modal(box)
				_ficha_modal(func(b: VBoxContainer) -> void:
					CareerUi.head(b, I18n.t("TU MEDIA AÑO A AÑO"))
					CareerUi.ovr_strip(b, hist)))
		box.add_child(media)
	box.move_child(cerrar, box.get_child_count() - 1)



