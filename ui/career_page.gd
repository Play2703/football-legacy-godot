func _torn_table(race: Array, key: String, top_n: int, accent: Color,
		include_you: bool, you_val: float, show_apps: bool = false,
		you_apps: int = 0, you_team: String = "") -> void:
	var mi_equipo: String = you_team if not you_team.is_empty() \
			else GameState.player_team_id
	var rows: Array = _torn_ranking(race, key, include_you, you_val, you_apps, you_team)
	var you_idx: int = -1
	for i in rows.size():
		if bool(rows[i]["you"]):
			you_idx = i
			break


	var name_count: Dictionary = {}
	for r in rows:
		var n: String = String(r["name"])
		name_count[n] = int(name_count.get(n, 0)) + 1
	if show_apps:
		_torn_table_header(key, accent)
	for i in mini(top_n, rows.size()):
		_torn_row(i + 1, rows[i], key, int(name_count[String(rows[i]["name"])]) > 1,
			accent, show_apps)







	var extras: Array = []
	if include_you and you_idx >= top_n:
		extras.append(you_idx)
	if include_you:
		for i in rows.size():
			if not bool(rows[i]["you"]) \
					and String(rows[i]["team"]) == mi_equipo:
				if i >= top_n:
					extras.append(i)
				break
	extras.sort()
	if not extras.is_empty():
		_torn_nota("···")
		for i in extras:
			_torn_row(int(i) + 1, rows[int(i)], key,
				int(name_count[String(rows[int(i)]["name"])]) > 1, accent, show_apps)







func _torn_ranking(race: Array, key: String, include_you: bool, you_val: float,
		you_apps: int = 0, you_team: String = "") -> Array:
	var mi_equipo: String = you_team if not you_team.is_empty() \
			else GameState.player_team_id
	var rows: Array = []
	for e in race:



		rows.append({"name": String(e["name"]), "team": String(e["team"]),
			"val": float(e.get(key, 0)), "apps": int(e.get("apps", 0)), "you": false,
			"hot": bool(e.get("breakout", false))})





	if include_you and not (key == "avg" and you_apps <= 0):
		rows.append({"name": Career.player_name, "team": mi_equipo,
			"val": you_val, "apps": you_apps, "you": true, "hot": false})



	rows.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		if not is_equal_approx(float(a["val"]), float(b["val"])):
			return float(a["val"]) > float(b["val"])
		if float(a["val"]) <= 0.0:
			return false
		return bool(a["you"]) and not bool(b["you"]))
	return rows




