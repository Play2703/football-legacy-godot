		return [I18n.t("VINO A VERTE"), 2, true]
	var tier: int = _calor_tier(r)
	return [I18n.t("DE CERCA") if tier == 2 \
			else (I18n.t("SERIO") if tier == 1 else I18n.t("FLOJO")), tier, false]






