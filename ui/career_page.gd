func _mercado_tumbado() -> void:
	var sub: bool = await _mt_subficha()



	if not is_inside_tree():
		return
	if sub:
		_leyenda_pon([])
		return

	if Career.on_loan() or Career.free_agent:
		_mt_vista = ""
	if _mt_vista == "estado":
		_mt_estado()
		_leyenda_pon([[["fl_modo"], "MERCADO"]])
		return
	_mk_t_render()




func _mk_t_render() -> void:
	var k: float = _torn_ancho_plantilla() / MK_T_DISENO_W
	var caja: HBoxContainer = _mk_t_caja(k)
	var izq: VBoxContainer = VBoxContainer.new()
	izq.name = "Izquierda"
	izq.custom_minimum_size.x = floor(MK_T_IZQ_W * k)
	izq.size_flags_horizontal = Control.SIZE_FILL
	izq.size_flags_vertical = Control.SIZE_EXPAND_FILL
	izq.add_theme_constant_override("separation", MK_T_AIRE)
	izq.mouse_filter = Control.MOUSE_FILTER_IGNORE
	caja.add_child(izq)
	izq.add_child(_mk_t_heroe())
	izq.add_child(_mk_t_kpis())
	var agente: PanelContainer = _mk_t_agente()
	if agente != null:
		izq.add_child(agente)
	caja.add_child(_mk_t_derecha())


	if agente != null and Career.market_open():
		_agent_en_curso_visto = _agent_en_curso_ahora()
	_leyenda_pon([] if Career.free_agent or Career.on_loan() else [[["fl_modo"], "TU ESTADO"]])


