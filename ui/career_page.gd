func _sello_con_puntos(rotulo: String, fondo: Color, pts: Dictionary) -> Control:
	var badge: PanelContainer = PanelContainer.new()
	badge.add_theme_stylebox_override("panel", CareerTheme.tag(fondo))
	badge.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	var l: Label = CareerUi.plain(16, CareerTheme.TEXT)
	var partes: Array[String] = [rotulo]
	for k in pts:
		var d: int = int(pts[k])
		if d != 0:
			partes.append("%+d %s" % [d, I18n.t(String(DecisionUi.REL_LABEL.get(k, k)))])
	l.text = " · ".join(PackedStringArray(partes))
	badge.add_child(l)
	return badge










func _pide_salida(via: String, aviso: String, color: Color) -> void:
