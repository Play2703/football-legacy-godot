func _torn_clubes_pais(campo: Dictionary) -> Array:
	var pais: String = Teams.country_of(GameState.player_team_id)
	var groups: Array = campo.get("groups", [])
	var out: Array = []
	if pais.is_empty():
		return out
	for gi in groups.size():
		var g: Dictionary = groups[gi]
		var filas: Array = _torn_filas_grupo(g)
		for i in filas.size():
			var f: Dictionary = filas[i]
			if bool(f["tuya"]) or Teams.country_of(String(f["club"])) != pais:
				continue
			var club: String = String(f["club"])
			var jugado: bool = not _torn_sin_jugar(f)
			var cifra: String = _ordinal(i + 1) if jugado else ""
			var grupo: String = I18n.tf("GRUPO {0}", [_torn_letra_grupo(gi)]) \
					if groups.size() > 1 else ""
			var linea: String = ""
			var rival: String = ""
			var ronda: String = _torn_ronda_club(campo, club)
			if not ronda.is_empty():
				linea = ronda
			else:
				rival = _torn_rival_proyectado(g, club)
				if jugado:
					linea = I18n.tf("{0} PTS", [int(f["pts"])])
					if not grupo.is_empty():
						linea = grupo + " · " + linea
				elif not rival.is_empty():
					linea = I18n.tf("vs {0}", [_torn_nombre_de(rival)])
				else:
					linea = grupo
			out.append({"club": club, "cifra": cifra, "linea": linea, "orden": i * 100 + gi,
				"grupo": linea if jugado else grupo, "rival": rival,
				"jornada": int(g.get("played", 0)) + 1,
				"semana": _torn_semana_proyectada(g) if not rival.is_empty() else ""})
	out.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return int(a["orden"]) < int(b["orden"]))
	return out





func _torn_rival_proyectado(g: Dictionary, club: String) -> String:
	var sched: Array = g.get("schedule", [])
	var r: int = int(g.get("played", 0))
	if r < 0 or r >= sched.size():
		return ""
	for pair in sched[r]:
		var p: Array = pair
		if p.size() < 2:
			continue
		if String(p[0]) == club:
			return String(p[1])
		if String(p[1]) == club:
			return String(p[0])
	return ""





func _torn_ronda_club(campo: Dictionary, club: String) -> String:
	var br: Array = campo.get("bracket", [])
	var names: Array = campo.get("ko_names", [])
	for r in range(br.size() - 1, -1, -1):
		for tie in br[r]:
			var t: Dictionary = tie
			if String(t.get("a", "")) != club and String(t.get("b", "")) != club:
				continue
			var w: String = String(t.get("winner", ""))
			if w.is_empty():
				return CareerTheme.caps(I18n.t(String(names[r]))) if r < names.size() else ""
			if w != club:
				return CareerTheme.caps(I18n.t("ELIMINADO"))
			if r + 1 < names.size():
				return CareerTheme.caps(I18n.t(String(names[r + 1])))
			return CareerTheme.caps(I18n.t("¡CAMPEÓN!"))
	return ""











func _torn_baldosa_record(clave: String, accent: Color) -> Button:
	var clubes: Array = []
	var kind: String = ""
	match clave:
		"cup":
			kind = "copa"
			clubes = Teams.teams_of_country(Teams.country_of(GameState.player_team_id))
		"cwc":
			kind = "clubes"
			clubes = Teams.all()
		"ucl", "lib", "cca":
			kind = "champions"
			var confed: String = Continental.confed_de(clave)

			var de_pais: Dictionary = {}
			for t in Teams.all():
				var pais: String = String((t as Dictionary).get("country", ""))
