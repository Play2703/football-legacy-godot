func _torn_px_tumbado(px: int, texto: String, cabecera: bool) -> int:
	if cabecera:
		return CareerTheme.T_DATO_TUMBADO
	if px > 18 and px < 28 and _torn_es_cifra(texto):
		return CareerTheme.T_DATO_TUMBADO
	if px <= 18:
		return CareerTheme.T_CAP_TUMBADO if texto == texto.to_upper() \
				else CareerTheme.T_LEE_TUMBADO
	if px < 28:
		return CareerTheme.T_LEE_TUMBADO
	if px < 40:
		return CareerTheme.T_DATO_TUMBADO
	if px < 60:
		return CareerTheme.T_TITULO_TUMBADO
	return CareerTheme.T_HEROE_TUMBADO



func _torn_es_cifra(texto: String) -> bool:
	var s: String = texto.strip_edges().trim_suffix("ª").trim_suffix("º")
	return s == "—" or s == "-" or (not s.is_empty() and s.is_valid_float())




func _torn_liga(accent: Color) -> void:
	_torn_league_selectors(accent)
	var mine: bool = _torn_country == Teams.country_of(GameState.player_team_id) \
			and _torn_div == GameState.player_div()












	var vista: int = -1
	if Liguilla.aplica(_torn_country, _torn_div) \
			and (not mine or GameState.torneos_activos()):
		vista = _torn_vista_de(mine)
		_content.add_child(CareerUi.segmented([I18n.t("APERTURA"), I18n.t("CLAUSURA"),
			I18n.t("ANUAL")], vista, _torn_elige_vista))
	if mine:
		_torn_standings(accent, vista)
	else:
		_torn_standings_sim(accent, vista)



	if Liguilla.aplica(_torn_country, _torn_div) and vista != TORN_ANUAL:
		_torn_liguilla(accent, mine, vista)
	var raw: Array = Career.league_race() if mine \
			else Race.league(_torn_country, _torn_div, GameState.season_num)
	var race: Array = _torn_build_race(raw, mine, "league")
	_torn_race_tables(race, mine, float(Career.league_here("g")),
		float(Career.league_here("a")), Career.season_avg(), accent,
		Career.league_here("pj"))


const TORN_ANUAL: int = 2






func _torn_vista_de(mine: bool) -> int:
	if _torn_vista >= 0:
		return _torn_vista
	if mine:
		return maxi(GameState.torneo_actual(), Liguilla.APERTURA)
	var pt: Array = _torn_frac()
	return Liguilla.APERTURA if int(pt[0]) * 2 <= int(pt[1]) else Liguilla.CLAUSURA


func _torn_elige_vista(i: int) -> void:
	_torn_vista = i
	_refresh()





func _torn_frac_torneo(t: int) -> float:
	var pt: Array = _torn_frac()
	var mitad: float = float(maxi(int(pt[1]), 1)) / 2.0
	var hecho: float = float(pt[0]) -(mitad if t == Liguilla.CLAUSURA else 0.0)
	return clampf(hecho / mitad, 0.0, 1.0)




