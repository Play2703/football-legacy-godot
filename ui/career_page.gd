	CareerUi.ventana_pinta(v, plan, _hc_fila_de.bind(filas, HC_FILA_H, _hc_med_plan(med, filas,
		plan)), Callable())
	caja.resized.connect(_hc_llena.bind(caja, v, filas, tu, mundo, med))





func _hc_plan(n: int, tu: int, mundo: bool, casillas: int) -> Array:
	if not mundo:
		return CareerUi.ventana_foco(n, tu, 1, float(casillas), 1.0)
	var cabe: int = mini(casillas, n)
	if tu < cabe or cabe < 3:
		return range(cabe)
	var plan: Array = range(cabe - 2)
	plan.append(-1)
	plan.append(tu)
	return plan




func _hc_med_plan(med: Dictionary, filas: Array, plan: Array) -> Dictionary:
	var maxp: int = 1
	for i in plan:
		if int(i) >= 0:
			maxp = maxi(maxp, int((filas[int(i)] as Dictionary)["puesto"]))
	var out: Dictionary = med.duplicate()
	out["pos"] = _hc_ancho(str(maxp), CareerTheme.T_LEE_TUMBADO)
	return out


func _hc_fila_de(i: int, filas: Array, alto: float, med: Dictionary) -> Control:
	var d: Dictionary = filas[i]
	return _hc_fila(int(d["puesto"]), String(d["club"]), alto, 0.0, med)


func _hc_llena(caja: PanelContainer, v: VBoxContainer, filas: Array, tu: int, mundo: bool,
		med: Dictionary) -> void:
	var alto: float = caja.size.y
	if alto < HC_FILA_H or filas.is_empty():
		return
	var plan: Array = _hc_plan(filas.size(), tu, mundo, int(floorf(alto / HC_FILA_H)))
	if plan.is_empty():
		return
	var h: float = maxf(HC_FILA_H, floorf(alto / float(plan.size())))
	var firma: String = "%d|%s" % [roundi(h), str(plan)]
	if String(caja.get_meta("hc_firma", "")) == firma:
		return
	caja.set_meta("hc_firma", firma)
	for c in v.get_children():
		v.remove_child(c)
		c.queue_free()
	var salta: bool = plan.has(-1)
	CareerUi.ventana_pinta(v, plan, _hc_fila_de.bind(filas, h, _hc_med_plan(med, filas, plan)),
		_hc_lista_entera.bind(filas, tu, mundo) if salta else Callable())
	if not salta and caja.has_meta("fl_ventana_toque"):


		var hit: Node = SceneFade.vivo(caja.get_meta("fl_ventana_toque", null)) as Node
		caja.remove_meta("fl_ventana_toque")
		if hit != null and is_instance_valid(hit):
			hit.queue_free()

	if not caja.has_meta("hc_entrada"):
		caja.set_meta("hc_entrada", true)
		for c in v.get_children():
			if c is PanelContainer:
				CareerUi.entrada_escalonada(c as Control)








func _hc_lista_entera(filas: Array, tu: int, mundo: bool) -> void:
	var base: Array = filas
	if mundo:
		base = filas.slice(0, mini(filas.size(), maxi(tu + 1 + CareerUi.VENTANA_VECINAS, 20)))
	var plan: Array = CareerUi.ventana_foco(base.size(), tu if tu < base.size() else -1, 1,
		float(HC_ENTERA_MAX), 1.0)
	var lista: Array = []
	var clubes: int = 0
	for i in plan:
		if int(i) < 0:
			lista.append({"puntos": true})
		else:
			lista.append(base[int(i)])
			clubes += 1
	var med: Dictionary = _hc_med_plan(_hc_medidas(base), base, plan)
	var nombres: Dictionary = _hc_nombres_w(lista, "club")
	var cab: HBoxContainer = _hc_cabecera(med, _hc_hueco_cab(med, HC_FILA_H, float(nombres[false])))
	cab.name = "Cabecera"
	var titulo: String = I18n.t("LOS MÁS LAUREADOS DEL MUNDO") if mundo else I18n.t(_palm_country)
	var box: VBoxContainer = CareerUi.lista_entera_modal(self, titulo, lista, [],
		CareerTheme.NAV_LEGADO, _hc_pinta_lista.bind(nombres, med, cab))
	if box == null:
		cab.free()
		return
	_hc_pon_cabecera(box, cab)
	box.set_meta("hc_lista_mundo" if mundo else "hc_lista_pais", clubes)
	box.set_meta("hc_lista_n", base.size())




func _hc_pon_cabecera(box: VBoxContainer, cab: HBoxContainer) -> void:
	var partes: Dictionary = box.get_meta("lista_entera_partes")
