	_torn_head(I18n.t("CUADRO"), accent, true)
	_full_bracket(bracket, names, accent)

















func _torn_cuadro_baldosa(bracket: Array, names: Array, accent: Color,
		you_team: Dictionary = {}, seeds: Array = []) -> Button:
	var ronda_idx: int = _torn_ronda_en_curso(bracket, names)
	var nombre: String = ""
	var tu: String = ""
	var escudo: Control = null
	var vivos: int = -1
	var cifra: String = ""
	var campeon: String = _torn_campeon_cuadro(bracket, names)
	if not campeon.is_empty():
		nombre = _torn_nombre_de(campeon)
		escudo = _torn_escudo(campeon, 48.0)
		tu = I18n.t("¡CAMPEÓN!")
	elif ronda_idx >= 0:
		nombre = CareerTheme.caps(I18n.t(String(names[ronda_idx])))
		vivos = _torn_vivos_cuadro(bracket, seeds)



		cifra = str(vivos)
		tu = I18n.t("VIVOS")
	var b: Button = CareerUi.baldosa_avance("torneos", I18n.t("CUADRO"), accent, escudo, nombre,
		cifra, tu, _torn_cuadro_modal.bind(bracket, names, accent, you_team))
	if not campeon.is_empty():
		CareerUi.avance_corto(b, _torn_sigla_de(campeon))
	b.name = "Cuadro"
	b.set_meta("torn_cuadro", true)
	b.set_meta("torn_cuadro_vivos", vivos)


	b.set_meta("torn_cuadro_rondas", [ronda_idx, names.size(), not campeon.is_empty(),
		CareerTheme.caps(I18n.t(String(names[names.size() - 1]))) if not names.is_empty() else ""])
	return b






func _torn_ronda_en_curso(bracket: Array, names: Array) -> int:
	for r in bracket.size():
		for tie in bracket[r]:
			if String((tie as Dictionary).get("winner", "")).is_empty():
				return r if r < names.size() else -1
	if bracket.size() < names.size():
		return bracket.size()
	return -1



func _torn_campeon_cuadro(bracket: Array, names: Array) -> String:
	if names.is_empty() or bracket.size() < names.size():
		return ""
	var final: Array = bracket[names.size() - 1]
	if final.size() != 1:
		return ""
	return String((final[0] as Dictionary).get("winner", ""))









func _torn_vivos_cuadro(bracket: Array, seeds: Array = []) -> int:
	var vivos: Dictionary = {}
	var caidos: Dictionary = {}
	for ronda in bracket:
		for tie in ronda:
			var d: Dictionary = tie
			var w: String = String(d.get("winner", ""))
			for k in [String(d.get("a", "")), String(d.get("b", ""))]:
				if k.is_empty():
					continue
				vivos[k] = true
				if not w.is_empty() and w != k:
					caidos[k] = true
	for s in seeds:
		if not String(s).is_empty():
			vivos[String(s)] = true
	return vivos.size() - caidos.size()


