func _agent_pick_country(for_club: bool) -> void:



	var box: VBoxContainer = CareerUi.modal_pantalla(self) if UiKit.es_horizontal() \
			else CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(28, CareerTheme.TEXT)
	t.text = I18n.t("¿QUÉ LIGA?")
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	var seen: Dictionary = {}
	var countries: Array = []
	for club in Teams.all():
		var c: String = String(club.get("country", ""))
		if not c.is_empty() and not seen.has(c):
			seen[c] = true
			countries.append(c)
	countries.sort()
	var items: Array = []
	for c in countries:



		items.append({"label": I18n.t(String(c)), "value": String(c), "country": String(c)})
	var on_pick: Callable = func(c: String) -> void:
		if for_club:
			_agent_pick_club(c)
		else:




			_agent_confirm_commission("league", c, I18n.tf("la liga de {0}", [c]))
	box.add_child(_agent_scroll_list(items, on_pick, box))
	box.add_child(_option_button(I18n.t("VOLVER"), CareerTheme.Kind.GHOST, box,
		Callable()))











func _agent_pick_club(country: String, division: int = 1) -> void:
	var box: VBoxContainer = CareerUi.modal_pantalla(self) if UiKit.es_horizontal() \
			else CareerUi.modal(self)
	if box == null:
		return
	var t: Label = CareerUi.plain(28, CareerTheme.TEXT)
	t.text = I18n.t("¿QUÉ CLUB?")
	t.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(t)
	if UiKit.es_horizontal():
		box.add_child(CareerUi.segmented([Teams.div_short(1), Teams.div_short(2),
			Teams.div_short(3)], division - 1, _agent_cambia_division.bind(box, country), 72))
	CareerUi.dim(box, I18n.t("En NEGRITA los que hoy te ficharían si tu agente les"
		+ " entra. Los demás puedes pedirlos igual, pero te dirá que no."))
	CareerUi.dim(box, I18n.t("Volver a un club TUYO es mucho más fácil: allí ya"
		+ " saben quién eres y tu agente entra por la puerta grande."))







	var perfil: Dictionary = Career.scout_profile()
	CareerUi.dim(box, I18n.t(String(Market.scouting(perfil)["verdict"])))







	var alcanzables: Dictionary = {}
	for cand in Market.candidates(perfil,
			GameState.player_team_id, Market.MIN_INTEREST):
		alcanzables[String(cand.get("id", ""))] = true
	var items: Array = []
	for div in [1, 2, 3]:
		if UiKit.es_horizontal() and div != division:
			continue




		var clubs: Array = GameState.teams_in_div(country, div).duplicate()
		clubs.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
			return int(a.get("rating", 62)) > int(b.get("rating", 62)))
		for club in clubs:
			var cid: String = String(club["id"])











			var ex: bool = Career.is_ex_club(cid)
			items.append({"label": "%s · %s%s" % [String(club.get("name", "?")),
				Teams.div_short(div),
				(" · " + I18n.t("TU EX")) if ex else ""], "value": cid,





				"dim": not ex and not alcanzables.has(cid) and not Career.agent_pre_reach(cid),
				"club": club})
	var on_pick: Callable = func(id: String) -> void:
		var st: Dictionary = Career.agent_target_status(id)
		if not bool(st["ok"]):


			_agent_confirm_far(id, String(st["why"]))
			return


		_agent_confirm_commission("club", id,
			Competitions.demarca(String(Teams.by_id(id).get("name", "?"))))
	box.add_child(_agent_scroll_list(items, on_pick, box))
	box.add_child(_option_button(I18n.t("VOLVER"), CareerTheme.Kind.GHOST, box,
		Callable()))


