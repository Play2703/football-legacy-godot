		var cap: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_DIM, String(par[0]), false)
		cap.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cv.add_child(cap)
		var val: Label = _mk_t_label(CareerTheme.T_DATO_TUMBADO, CareerTheme.TEXT, String(par[1]), false)
		val.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		cv.add_child(val)
		celdas.add_child(c)
	var forma: Control = _torn_forma(GameState.form_of_any(club))
	if forma != null:
		var fh: HBoxContainer = HBoxContainer.new()
		fh.name = "Forma"
		fh.add_theme_constant_override("separation", 16)
		fh.alignment = BoxContainer.ALIGNMENT_CENTER
		fh.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var fl: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.TEXT_DIM, I18n.t("FORMA"), false)
		fl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		fh.add_child(fl)
		fh.add_child(forma)
		box.add_child(fh)
	var cerrar: Button = _pf_t_modal_cerrar(box)
	cerrar.set_meta(Entrada.PRIMERO_META, true)
	if Entrada.modo == Entrada.Modo.MANDO:
		cerrar.grab_focus.call_deferred()
