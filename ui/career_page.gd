		var sb: StyleBoxFlat = StyleBoxFlat.new()
		sb.bg_color = CareerTheme.TEXT_MID
		sb.set_corner_radius_all(16)
		sb.content_margin_left = 10.0
		sb.content_margin_right = 10.0
		chip.add_theme_stylebox_override("panel", sb)
		var c: Label = _mk_t_label(CareerTheme.T_CAP_TUMBADO, CareerTheme.on_color(CareerTheme.TEXT),
			str(cuenta), false)
		c.custom_minimum_size = Vector2(12.0, 32.0)
		c.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		c.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		chip.add_child(c)
		h.add_child(chip)
	return b





func _to_t_proximo() -> Dictionary:
	var j: int = 0
	for r in _cal_rows():
		var f: Dictionary = r
		if String(f.get("comp", "")) != "league":
			continue
		j += 1
		if not bool(f.get("jugado", false)):
			var out: Dictionary = f.duplicate()
			out["to_t_j"] = j
			return out
	return {}



func _to_t_puesto(club: String) -> String:
	for i in _to_t_filas.size():
		if String((_to_t_filas[i] as Dictionary)["club"]) == club:
			return _ordinal(i + 1)
	return ""




func _to_t_placa(accent: Color, w: float) -> PanelContainer:
	var p: PanelContainer = _pa_t_superficie("Placa", TO_T_PLACA_LADOS * _to_t_k)
	p.size_flags_vertical = Control.SIZE_EXPAND_FILL
	var v: VBoxContainer = VBoxContainer.new()
	v.add_theme_constant_override("separation", 16)
	v.mouse_filter = Control.MOUSE_FILTER_IGNORE
	p.add_child(v)
	var prox: Dictionary = _to_t_proximo() if _to_t_mine else {}
	var cab: HBoxContainer = HBoxContainer.new()
	cab.name = "Cab"
	cab.add_theme_constant_override("separation", 12)
	cab.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v.add_child(cab)
	cab.add_child(_pa_t_icono("Icono", "jornada" if not prox.is_empty() else "corona", TO_T_ICONO,
		accent))
	var t: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT,
		I18n.t("PRÓXIMO CRUCE") if not prox.is_empty() else I18n.t("LÍDER"))
	t.name = "Titulo"
	t.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	t.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	cab.add_child(t)
	v.add_child(_to_t_aire_v())
	var linea: String = ""
	if not prox.is_empty():
		var duelo: HBoxContainer = HBoxContainer.new()
		duelo.name = "Duelo"
		duelo.alignment = BoxContainer.ALIGNMENT_CENTER
		duelo.add_theme_constant_override("separation", roundi(TO_T_DUELO_SEP * _to_t_k))
		duelo.mouse_filter = Control.MOUSE_FILTER_IGNORE
		v.add_child(duelo)
		var local: Dictionary = prox["local"]
		var visita: Dictionary = prox["visita"]
		duelo.add_child(_to_t_lado(String(local.get("id", "")), _cal_t_sigla(local)))
		var vs: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_DIM, I18n.t("VS"), false)
		vs.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		duelo.add_child(vs)
		duelo.add_child(_to_t_lado(String(visita.get("id", "")), _cal_t_sigla(visita)))
		var partes: Array[String] = []
		var ronda: String = String(prox.get("ronda", ""))


		if ronda.contains(" · "):
			ronda = ronda.get_slice(" · ", ronda.get_slice_count(" · ") - 1)
		else:
			ronda = I18n.tf("J{0}", [int(prox["to_t_j"])])
		if not ronda.is_empty():
			partes.append(ronda)
		var fecha: String = _cal_t_fecha(prox)
		if not fecha.is_empty():
			partes.append(fecha)
		partes.append(I18n.t("EN CASA") if bool(prox["you_home"]) else I18n.t("FUERA"))
		linea = " · ".join(partes)
	elif not _to_t_filas.is_empty():
		var lider: Dictionary = _to_t_filas[0]
		var club: String = String(lider["club"])
		var centro: CenterContainer = CenterContainer.new()
		centro.mouse_filter = Control.MOUSE_FILTER_IGNORE
		v.add_child(centro)
		centro.add_child(_to_t_lado(club, _torn_sigla_de(club), _torn_nombre_corto(String(lider["nombre"]))))
		linea = I18n.tf("{0} PTS", [int(lider["pts"])])
	else:
		var sin: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_DIM,
			I18n.t("SIN EMPEZAR"))
		sin.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		v.add_child(sin)
	v.add_child(_to_t_aire_v())
	if not linea.is_empty():
		var l: Label = _mk_t_label(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_DIM, linea)
		l.name = "Linea"
		l.custom_minimum_size.x = 0.0
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		v.add_child(l)
		CareerUi.letra_por_peldanos(l, [CareerTheme.T_LEE_TUMBADO, CareerTheme.T_CAP_TUMBADO])
	p.custom_minimum_size.x = w
	return p


