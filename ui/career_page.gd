		caja.set_meta("fl_plantilla", "D")
		caja.set_meta(DragScroll.META_ORDENADA, true)
		_content.add_child(caja)
		_pr_caja = caja
		var izq: PanelContainer = _mk_t_placa("Contrato", 24.0, 20.0)
		izq.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		izq.size_flags_vertical = Control.SIZE_EXPAND_FILL
		izq.size_flags_stretch_ratio = PR_T_IZQ
		caja.add_child(izq)
		var der: PanelContainer = _mk_t_placa("Temporada", 24.0, 20.0)
		der.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		der.size_flags_vertical = Control.SIZE_EXPAND_FILL
		der.size_flags_stretch_ratio = PR_T_DER
