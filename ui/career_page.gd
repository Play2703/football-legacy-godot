		if not (por_cajon.get(cat, []) as Array).is_empty():
			cajones.append(cat)
	for cat in por_cajon:
		if not House.CATEGORIA_ORDEN.has(cat) and cat != CAJON_CONVIENE:
			cajones.append(cat)
	if cajones.is_empty():
		return



	_casa_cajon = posmod(_casa_cajon, cajones.size())
	var cajon: String = String(cajones[_casa_cajon])







	var rotulos: Array = []
