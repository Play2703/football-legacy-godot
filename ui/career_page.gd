func _season_row(grid: GridContainer, temp: String, club_id: String, apps: int,
		goals: int, assists: int, avg: float, color: Color,
		on_loan: bool = false, awards: Array = [], idx: int = -1) -> void:



	var cells: Array = []
	var tcell: Label = _num_cell(temp, color, false)
	grid.add_child(tcell)
	cells.append(tcell)

	var club_cell: HBoxContainer = HBoxContainer.new()
	club_cell.add_theme_constant_override("separation", 6)
	var team: Dictionary = Teams.by_id(club_id)
	if not team.is_empty():
		var crest: CrestView = CrestView.new()
		crest.custom_minimum_size = Vector2(30, 30)
		crest.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		crest.set_team(team)
		club_cell.add_child(crest)
	var ab: Label = CareerUi.plain(CareerTheme.T_DIM, color)
	ab.text = String(team.get("abbrev", "?"))
	ab.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	club_cell.add_child(ab)
	if on_loan:
		club_cell.add_child(_loan_chip())
	grid.add_child(club_cell)
	cells.append(club_cell)
	var apps_c: Label = _num_cell(str(apps), color, true)
	grid.add_child(apps_c)
	cells.append(apps_c)
	var goals_c: Label = _num_cell(str(goals), color, true)
	grid.add_child(goals_c)
	cells.append(goals_c)
	var ast_c: Label = _num_cell(str(assists), color, true)
	grid.add_child(ast_c)
	cells.append(ast_c)
	var avg_c: Label = _num_cell("%.1f" % avg, color, true)
	grid.add_child(avg_c)
	cells.append(avg_c)
	var troph: Control = _season_trophies_cell(awards)
	grid.add_child(troph)
	cells.append(troph)
	if idx >= 0:
		for c in cells:
			_tap_cell(c, idx)



		if not cells.is_empty():
			CareerUi.tocable_mando(cells[mini(1, cells.size() - 1)] as Control)






func _tap_cell(c: Control, idx: int) -> void:
	c.mouse_filter = Control.MOUSE_FILTER_STOP
	c.mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
	_ignore_input_deep(c)
	c.gui_input.connect(func(ev: InputEvent) -> void:
		var hit: bool =(ev is InputEventMouseButton and (ev as InputEventMouseButton).pressed \
				and (ev as InputEventMouseButton).button_index == MOUSE_BUTTON_LEFT) \
				or (ev is InputEventScreenTouch and (ev as InputEventScreenTouch).pressed)
		if hit:
			_open_season_cards(idx))






func _ignore_input_deep(c: Node) -> void:
	for child in c.get_children():
		if child is Control:
			(child as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
		_ignore_input_deep(child)



