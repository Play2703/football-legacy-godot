func _leg_curva(puntos: Array, color: Color, ancho: float) -> HBoxContainer:
	var h: HBoxContainer = HBoxContainer.new()
	h.name = "LegCurva"
	h.alignment = BoxContainer.ALIGNMENT_CENTER
	h.size_flags_vertical = Control.SIZE_EXPAND_FILL
	h.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var tope: int = 1
	var w_txt: float = 0.0
	for p in puntos:
		tope = maxi(tope, int(p["value"]))
		w_txt = maxf(w_txt, maxf(_hc_ancho(String(p["text"]), CareerTheme.T_CAP_TUMBADO),
			_hc_ancho(String(p["label"]), CareerTheme.T_CAP_TUMBADO)))
	w_txt += 2.0
	var n: int = maxi(puntos.size(), 1)
	var sep: float = 16.0 if n <= 12 else 8.0
	h.add_theme_constant_override("separation", int(sep))
	var w: float = floorf((ancho - sep * float(n - 1)) / float(n))


	if w < w_txt:
		w = floorf((ancho -(w_txt - w) - sep * float(n - 1)) / float(n))
	w = maxf(w, 8.0)
	var paso: int = maxi(1, ceili((w_txt + 16.0) /(w + sep)))
	h.set_meta("leg_curva_paso", paso)
	for i in puntos.size():
		var p: Dictionary = puntos[i]
		var con_rotulo: bool =(puntos.size() - 1 - i) % paso == 0
		var col: VBoxContainer = VBoxContainer.new()
		col.add_theme_constant_override("separation", 8)
		col.custom_minimum_size.x = w
		col.size_flags_vertical = Control.SIZE_EXPAND_FILL
		col.mouse_filter = Control.MOUSE_FILTER_IGNORE
		h.add_child(col)
		col.add_child(_leg_curva_rotulo(String(p["text"]) if con_rotulo else "", CareerTheme.TEXT))


		var pista: Control = Control.new()
		pista.name = "Pista"
		pista.size_flags_vertical = Control.SIZE_EXPAND_FILL
		pista.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(pista)
		_curve_barra(pista, p, tope, CareerTheme.TEXT if bool(p.get("tuya", false)) else color)
		for barra in pista.get_children():
			(barra as Control).mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(_leg_curva_rotulo(String(p["label"]) if con_rotulo else "", CareerTheme.TEXT_MID))
	return h





func _leg_curva_rotulo(texto: String, color: Color) -> Control:
	var celda: Control = Control.new()
	celda.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var l: Label = CareerUi.plain(CareerTheme.T_CAP_TUMBADO, color)
	celda.custom_minimum_size.y = l.get_combined_minimum_size().y
	if texto.is_empty():
		l.free()
		return celda
	l.text = texto
	l.clip_text = true
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var mitad: float = ceilf(0.5 *(_hc_ancho(texto, CareerTheme.T_CAP_TUMBADO) + 2.0))
	l.anchor_left = 0.5
	l.anchor_right = 0.5
	l.anchor_top = 0.0
	l.anchor_bottom = 1.0
	l.offset_left = - mitad
	l.offset_right = mitad
	l.set_meta("leg_curva_rotulo", true)
	celda.add_child(l)
	return celda





