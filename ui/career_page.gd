func _torn_nombre_ancho(filas: Array, compacta: bool) -> float:
	var f: Font = get_theme_font("font", "Label")
	var tam: int = CareerTheme.T_CAP_TUMBADO if compacta else CareerTheme.T_LEE_TUMBADO
	var w: float = 0.0
	if f == null:
		return 0.0
	for fi in filas:
		var nombre: String = _torn_nombre_corto(String((fi as Dictionary)["nombre"]))
		if compacta:
			nombre = CareerTheme.caps(nombre)
		w = maxf(w, f.get_string_size(nombre, HORIZONTAL_ALIGNMENT_LEFT, -1.0, tam).x)
	return ceilf(w) + 2.0





func _torn_lista_hueco_cab(nombre_w: float, escudo: float) -> float:
	return TORN_COL_POS + escudo + nombre_w + 2.0 * float(CareerUi.FILA_TUMBADA_SEP)





func _torn_lista_ancho(nombre_w: float, compacta: bool) -> float:
	return float(CareerUi.FILA_TUMBADA_CANAL) + CareerUi.FILA_TUMBADA_FRANJA \
			+ 9.0 * float(CareerUi.FILA_TUMBADA_SEP) + TORN_COL_POS \
			+(TORN_ESCUDO_COMPACTO if compacta else TORN_ESCUDO) + nombre_w \
			+ 3.0 * TORN_COL_NUM + TORN_COL_DG + TORN_COL_PTS













