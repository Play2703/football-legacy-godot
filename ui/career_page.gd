		[_torn_color_playoff(), GameState.EURO_DIRECT + 1, GameState.EURO_PLAYOFF, "PLAYOFF"]]
	if n > GameState.EURO_PLAYOFF:






		tramos.append([Color.TRANSPARENT, GameState.EURO_PLAYOFF + 1, n, "ELIMINADO"])
	var out: Array = []
	for t in tramos:
		var puestos: String = "%d-%d" % [t[1], t[2]]
		var destino: String = CareerTheme.caps(I18n.t(String(t[3])))
		out.append({"color": t[0], "texto": "%s · %s" % [puestos, destino],
