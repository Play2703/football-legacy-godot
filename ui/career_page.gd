static func ficha_fuera(host: Node, p: Dictionary, club_id: String, nat: bool,
		es_yo: bool) -> void:
	if host == null:
		return
	var pg: CareerPage = CareerPage.new()
	pg._host_ficha = host
	var antes: int = host.get_child_count()
	pg._ficha_por_fila(p, club_id, nat, es_yo)
	var capa: Node = host.get_child(host.get_child_count() - 1) \
			if host.get_child_count() > antes else null
	if capa != null and capa.is_in_group(CareerUi.MODAL_GROUP):
		capa.tree_exited.connect(pg.free)
	else:
		pg.free()



var _host_ficha: Node = null



func _ficha_por_fila(p: Dictionary, club_id: String, nat: bool, es_yo: bool) -> void:
	if es_yo:
		_ficha_mia()
		return
	var nombre: String = String(p.get("name", ""))



	if not nat:
		var squad: Array = Squad.of(club_id)
		for s in squad.size():
			if String((squad[s] as Dictionary).get("name", "")) == nombre:
				_ficha_de_asiento(club_id, s)
				return



	var de: Dictionary = _de_convocado(nombre) if nat else {}
	var team: Dictionary = Nations.as_team(club_id) if nat else Teams.by_id(club_id)
	var bandera: String = Nations.canon_id(club_id) if nat else ""
	var hacer: Callable = func() -> PlayerCard:
		return PlayerCard.build(p, team, bandera)
	_ficha_jugador(p, false, de.get("pm", {}), hacer, "", {}, de.get("tray", {}))




func _rank_valor(v: int) -> String:
	if v >= 1000000:
		return I18n.num(float(v) / 1000000.0, 1) + " M"
	if v >= 1000:
		return "%d K" % int(v / 1000)
	return str(v)


func _rank_paginador(total: int) -> void:
	var box: HBoxContainer = HBoxContainer.new()
	box.add_theme_constant_override("separation", 12)
	box.alignment = BoxContainer.ALIGNMENT_CENTER
	_content.add_child(box)
	var prev: Button = _rank_pag_btn(I18n.t("ANTERIOR"))
	prev.disabled = _rank_page <= 0
	prev.pressed.connect(func() -> void:
		_rank_page -= 1
		_refresh())
	box.add_child(prev)
	var l: Label = CareerUi.plain(CareerTheme.T_BODY, CareerTheme.TEXT_DIM)
	var desde: int = _rank_page * WorldRanking.PER_PAGE + 1
	l.text = I18n.tf("{0}-{1} DE {2}",
		[desde, mini(desde + WorldRanking.PER_PAGE - 1, total), total])
	l.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	box.add_child(l)
	var max_page: int = maxi((total - 1) / WorldRanking.PER_PAGE, 0)
	var next: Button = _rank_pag_btn(I18n.t("SIGUIENTE"))
	next.disabled = _rank_page >= max_page
	next.pressed.connect(func() -> void:
		_rank_page += 1
		_refresh())
	box.add_child(next)





	prev.focus_neighbor_right = prev.get_path_to(next)
	next.focus_neighbor_left = next.get_path_to(prev)


