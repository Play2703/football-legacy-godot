func _mt_dato(rotulo: String, valor: String, color: Color, derecha: Control = null) -> HBoxContainer:
	var h: HBoxContainer = HBoxContainer.new()
	h.name = "DetalleFila"
	h.set_meta("detalle_fila", true)
	h.add_theme_constant_override("separation", CareerUi.PLANTILLA_SEP)
	h.custom_minimum_size.y = CareerUi.LISTA_FILA_H
	var r: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.TEXT_MID if not valor
		.is_empty() else color)
	r.text = CareerTheme.caps(rotulo)
	r.clip_text = true
	r.text_overrun_behavior = TextServer.OVERRUN_NO_TRIMMING
	r.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	r.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
