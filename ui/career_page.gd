			CareerTheme.TEXT if years > 0 else CareerTheme.DANGER],
		["contrato_firma", I18n.t("SUELDO NUEVO"),
			"$ %s" % CareerUi.money(int(o["wage"])),
			CareerTheme.MONEY if delta >= 0 else CareerTheme.DANGER],
		["contrato_firma", I18n.t("PRIMA DE FIRMA"),
			"+$ %s" % CareerUi.money(
				Career.agent_signing_net(int(o.get("signing_bonus", 0)))),
			CareerTheme.MONEY],
		["contrato_firma", I18n.t("CLÁUSULA"),
			"$ %s" % CareerUi.money(int(o.get("clause", 0))),
			CareerTheme.TEXT],
	])


	if bool(o.get("clause_free", false)):
		CareerUi.dim(_content, I18n.t("Cláusula baja: si un club la paga, el tuyo no puede negarse."))


	elif bool(o.get("clause_flag", false)):
		CareerUi.dim(_content, I18n.tf("Tu grada frena tu venta: cobras más y el club te"
			+ " blinda con una cláusula un {0} % más alta.",
			[int(round((Market.CLAUSE_FLAG_MULT - 1.0) * 100.0))]))

	_why_line(_content, o.get("why", []) as Array)

	CareerUi.dim(_content, I18n.tf("Quedan {0} · al firmar tendrías {1} en total",
		[int(o["left"]), int(o["total"])]))
	if delta != 0:
		var d: Label = CareerUi.plain(21,
			CareerTheme.MONEY if delta > 0 else CareerTheme.DANGER)
		d.text = I18n.tf("Tu sueldo {0} de $ {1} a $ {2} por partido",
			[I18n.t("sube") if delta > 0 else I18n.t("baja"),
			CareerUi.money(int(o["wage_now"])), CareerUi.money(int(o["wage"]))])
		d.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(d)
	else:
		CareerUi.dim(_content, I18n.t("Te renuevan con el mismo sueldo."))


	CareerUi.dim(_content, I18n.tf("Te firman como {0}", [String(o["role_name"])]))


	var pct: int = int(o.get("perf_pct", 0))
	if pct != 0:
		var pf: Label = CareerUi.plain(21,
			CareerTheme.MONEY if pct > 0 else CareerTheme.DANGER)
		pf.text = I18n.tf("Por tu temporada: {0}{1}% sobre el sueldo",
			["+" if pct > 0 else "", pct])
		pf.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		_content.add_child(pf)




	if bool(o.get("anchored", false)):
		CareerUi.dim(_content, I18n.t("Negocian sobre tu ficha actual: nadie da más salto en una firma."))


	elif bool(o.get("capped", false)) and not bool(o.get("floored", false)):
		CareerUi.dim(_content, I18n.t("Es el techo salarial del club: no pueden pagar más."))
	_clausulas_resumen(_content, o)




func _confirm_renewal() -> void:


	var o: Dictionary = _renewal_selected(Career.renewal_packages())
	var pack: String = String(o.get("pack", "equilibrio"))
	var body: String = I18n.tf("{0} años más (tendrías {1}) y ficha de $ {2} por partido.",
		[int(o["seasons"]), int(o["total"]), CareerUi.money(int(o["wage"]))])
	var prima: int = Career.agent_signing_net(int(o.get("signing_bonus", 0)))
	if prima > 0:
		body += "\n" + I18n.tf("Cobras $ {0} de prima al firmar.",
			[CareerUi.money(prima)])


	if bool(o.get("clause_free", false)):
		body += "\n" + I18n.tf("Cláusula en $ {0}: quien la pague, te lleva.",
			[CareerUi.money(int(o.get("clause", 0)))])

	elif bool(o.get("clause_flag", false)):
		body += "\n" + I18n.tf("Cláusula en $ {0}: tu grada frena tu venta.",
			[CareerUi.money(int(o.get("clause", 0)))])
	if int(o["delta"]) < 0:
		body += "\n" + I18n.t("Es MENOS de lo que cobras ahora.")



	_confirm(I18n.t("¿RENOVAR?"), body, I18n.t("MANTÉN PARA FIRMAR"), false,
		func() -> void:
			Career.renew_contract(pack)
			_toast(I18n.t("CONTRATO RENOVADO"), CareerTheme.MONEY), true)






func _renovacion_visible() -> bool:
	return int(Career.contract["seasons_left"]) <= 1 and Career.loan.is_empty() \
			and not Career.free_agent and Career.pending_precontract.is_empty()









func _renovacion_agente() -> void:






	var reneg_viva: bool = not _reneg_oferta_viva().is_empty()
	if reneg_viva or not _renovacion_visible():
		_renegociacion_agente()
	if not _renovacion_visible():
		return
	if Career.can_renew():
		_renewal_block()



		_cta_club(I18n.t("RENOVAR CONTRATO"), func() -> void: _confirm_renewal())
		_negociar_club(_content)
	elif not reneg_viva:


		CareerUi.head(_content, I18n.t("LA OFERTA DEL CLUB"))

		CareerUi.dim(_content, I18n.t("CONTRATOS CONGELADOS") if Career.concurso_tuyo()
			else I18n.t("EL TÉCNICO NO RENUEVA"))



	if Career.descartado() or Career.is_frozen():
		return
	var no_renew: Button = Button.new()
	no_renew.text = I18n.t("NO RENOVAR")
	no_renew.custom_minimum_size = Vector2(0, 84)
	CareerTheme.apply_button(no_renew, CareerTheme.Kind.WARN, 24)
	no_renew.clip_text = true
	no_renew.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	no_renew.pressed.connect(func() -> void:
		_confirm(I18n.t("¿NO RENOVAR?"),
			I18n.t("El club te pondrá en venta para no perderte gratis. Si no sales, "
			+ "jugarás menos el resto del año. Si aguantas, quedarás libre al final."),
			I18n.t("MANTÉN PARA NO RENOVAR"), true, func() -> void:
				Career.decline_renewal()
				_toast(I18n.t("NO RENUEVAS · EL CLUB TE VENDE"), CareerTheme.DANGER),
			true))


	var racha: Dictionary = Career.no_renuevo_racha_coste()
	if not racha.is_empty():
		_content.add_child(CareerUi.coste_fila([["relaciones", int(racha["club"])],
			["aficion", int(racha["aficion"])]], I18n.t("VAS EN RACHA")))
	_content.add_child(no_renew)









func _renegociacion_agente() -> void:
	var o: Dictionary = _reneg_oferta_viva()
	if not o.is_empty():



		if Career.renegotiation_open():
			_renegotiation_block(o)




			_cta_club(I18n.t("FIRMAR LA MEJORA"), func() -> void: _confirm_renegotiation())
			_negociar_club(_content)
		else:
			_renegotiation_ask_block()
			_cta_club(I18n.t("PEDIR MESA AL CLUB"), func() -> void: _confirm_ask_table())
		return


	var reneg: Dictionary = Career.renegotiation_gate()
	var falta: Array = reneg.get("missing", []) as Array
	if int(Career.contract["seasons_left"]) > 1 and Career.loan.is_empty() \
			and not Career.free_agent and not bool(reneg["ok"]) \
			and (falta.has("cooldown") or falta.has("refused")):
		_reneg_gastada()





