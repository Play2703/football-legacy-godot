func _cal_t_barra(f: Dictionary) -> Control:
	var d: Dictionary = CAL_T_HUB._previa_data()
	if d.is_empty():
		return null
	var riv: Dictionary = f["visita"] if bool(f["you_home"]) else f["local"]
	var hoy: Dictionary = GameState.current_fixture()
	if String(hoy.get("opp", "")) != String(riv.get("id", "")):
		return null
	var fracs: Array = [d["win"], d["draw"], d["loss"]]
	var pcts: Array = CAL_T_HUB._pct_100(fracs)
	var order: Array = CAL_T_HUB._previa_order(bool(d["home"]))
	var kinds: Array = CAL_T_HUB._previa_kinds()
	var suelo: float = CAL_T_HUB.PREVIA_SEG_MIN_APAISADA



	var total: float = 0.0
	for p in pcts:
		total += maxf(float(int(p)) / 100.0, suelo)
	var track: Control = Control.new()
	track.name = "BarraVED"
	track.custom_minimum_size = Vector2(0, CAL_T_BARRA_H)
	track.mouse_filter = Control.MOUSE_FILTER_IGNORE
	track.clip_contents = true
	track.set_meta("cal_t_barra", true)
	var cum: float = 0.0
	for i in 3:
		var k: Array = kinds[int(order[i])]
		var tint: Color = k[0]
		var w: float = maxf(float(int(pcts[int(order[i])])) / 100.0, suelo) / maxf(total, 0.0001)
		var seg: ColorRect = ColorRect.new()
		seg.color = tint
		seg.mouse_filter = Control.MOUSE_FILTER_IGNORE
		seg.anchor_left = cum
		cum = 1.0 if i == 2 else clampf(cum + w, 0.0, 1.0)
		seg.anchor_right = cum
		seg.anchor_top = 0.0
		seg.anchor_bottom = 1.0
		seg.offset_left = 0.0
		seg.offset_right = 0.0
		seg.offset_top = 0.0
		seg.offset_bottom = 0.0
		seg.set_meta("cal_t_seg", int(pcts[int(order[i])]))
		track.add_child(seg)
		var l: Label = CareerUi.plain(CareerTheme.T_LEE_TUMBADO, CareerTheme.on_color(tint))
		l.text = "%s %d%%" % [CareerTheme.caps(I18n.t(str(k[2]), "ini")), int(pcts[int(order[i])])]
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		l.clip_text = true
		l.mouse_filter = Control.MOUSE_FILTER_IGNORE
		l.set_anchors_preset(Control.PRESET_FULL_RECT)
		seg.add_child(l)
	return track





