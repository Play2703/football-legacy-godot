func _ct_t_mas_modal() -> void:
	var box: VBoxContainer = CareerUi.modal(self)
	if box == null:
		return
	box.set_meta("ct_t_mas", true)
	box.add_theme_constant_override("separation", PF_T_AIRE_MODAL)
	_pf_t_modal_titulo(box, I18n.t("MÁS"))
	var cuerpo: HBoxContainer = HBoxContainer.new()
	cuerpo.name = "Cuerpo"
	cuerpo.add_theme_constant_override("separation", PF_T_AIRE_MODAL)
	cuerpo.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(cuerpo)
	var izq: VBoxContainer = _ct_t_mas_columna("Izquierda")
	cuerpo.add_child(izq)
	var der: VBoxContainer = _ct_t_mas_columna("Derecha")
	cuerpo.add_child(der)
	izq.add_child(_ct_t_mas_fortuna())
	var primas: PanelContainer = _ct_t_mas_primas()
	if primas != null:
		izq.add_child(primas)
	izq.add_child(_ct_t_mas_clausula(box))
	der.add_child(_ct_t_mas_objetivo(box))
	var club: PanelContainer = _ct_t_mas_club()
	if club != null:
		der.add_child(club)
	var guardaron: PanelContainer = _ct_t_mas_guardaron()
	if guardaron != null:
		der.add_child(guardaron)
	var pie: HBoxContainer = HBoxContainer.new()
	pie.name = "Pie"
	pie.add_theme_constant_override("separation", PF_T_AIRE_MODAL)
	pie.mouse_filter = Control.MOUSE_FILTER_IGNORE
	box.add_child(pie)
	if Career.can_retire():
		pie.add_child(_ca_t_boton("Retiro", "puerta", I18n.t("COLGAR LAS BOTAS"), -1, func() -> void:
			CareerUi.close_modal(box)
			_confirm_retire()))
	var cerrar: Button = _pf_t_modal_cerrar(box)
	box.remove_child(cerrar)
	cerrar.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	pie.add_child(cerrar)
	var foco: Button = cerrar
	for h in box.find_children("*", "Button", true, false):
		var b: Button = h as Button
		if b != cerrar and not b.disabled and b.focus_mode != Control.FOCUS_NONE:
			foco = b
			break
	foco.set_meta(Entrada.PRIMERO_META, true)
	if _ct_t_con_mando():
		foco.grab_focus.call_deferred()


